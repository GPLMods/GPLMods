<!-- Only render this HTML/JS if the user is supposed to see ads -->
<% if (typeof showAds !== 'undefined' && showAds) { %>

    <!-- 1. Include Fluid Player CDN -->
    <script src="https://cdn.fluidplayer.com/v3/current/fluidplayer.min.js"></script>

    <!-- ======== VIDEO AD MODAL ======== -->
    <div id="video-ad-modal" class="policy-modal" style="display: none; align-items: center; justify-content: center; background-color: rgba(0,0,0,0.95); z-index: 10000; pointer-events: auto;">
        
        <div class="policy-modal-content" style="background-color: var(--dark-gray); padding: 30px; text-align: center; border-radius: 15px; max-width: 800px; width: 95%; border-top: 4px solid var(--gold); box-shadow: 0 10px 40px rgba(255, 215, 0, 0.4); display: flex; flex-direction: column; gap: 15px;">
            
            <!-- INTRO SCREEN -->
            <div id="ad-intro-screen">
                <i class="fas fa-play-circle" style="font-size: 4em; color: var(--gold); margin-bottom: 20px; text-shadow: 0 0 4px var(--glow-gold);"></i>
                <h2 style="color: var(--white); margin-bottom: 15px;">Support GPL Mods</h2>
                <p style="color: var(--silver); margin-bottom: 25px; line-height: 1.6; font-size: 1.1em;">
                    Please watch a short sponsor video to help keep our servers running and our mods free for everyone.
                </p>
                
                <button id="watch-video-btn" class="btn btn-primary" style="background: var(--gold); color: var(--black); padding: 15px 30px; border-radius: 25px; font-weight: bold; font-size: 1.1em; border: none; cursor: pointer; box-shadow: 0 0 20px var(--glow-gold); width: 100%; transition: all 0.3s;">
                    Play Sponsor Video
                </button>
            </div>

            <!-- THE FLUID PLAYER CONTAINER -->
            <div id="ad-player-container" style="display: none; width: 100%; aspect-ratio: 16 / 9; margin: 0 auto; background: #000; border-radius: 8px; overflow: hidden; position: relative;">
                
                <!-- A simple silent video to hold the player open while the ad loads -->
                <video id="fluid-video-id" loop muted playsinline style="width: 100%; height: 100%;">
                    <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4" type="video/mp4" />
                </video>
                
            </div>

            <!-- HilltopAds Link (Small text with logo in white color) -->
            <a id="hilltopads-link" href="https://hilltopads.com/?ref=378819" target="_blank" rel="noopener noreferrer" style="display: none; margin-top: 8px; color: #ffffff; text-decoration: none; font-size: 0.85em; opacity: 0.85; transition: opacity 0.2s ease; text-align: center; align-items: center; justify-content: center; gap: 6px;" onmouseover="this.style.opacity='1'; this.style.textDecoration='underline';" onmouseout="this.style.opacity='0.85'; this.style.textDecoration='none';">
                <i class="fa-regular fa-flag-swallowtail fa-flag" style="color: #ffffff; font-size: 0.95em;"></i> Powered by Hilltopads
            </a>

            <!-- The Close Button -->
            <button id="manual-close-btn" class="btn btn-secondary" style="display: none; margin-top: 15px; border: 1px solid #555; background: transparent; color: var(--silver); padding: 10px 20px; border-radius: 8px; transition: all 0.3s ease;">
                Close & Continue
            </button>
            
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const videoModal = document.getElementById('video-ad-modal');
            const introScreen = document.getElementById('ad-intro-screen');
            const watchBtn = document.getElementById('watch-video-btn');
            const playerContainer = document.getElementById('ad-player-container');
            const manualCloseBtn = document.getElementById('manual-close-btn');
            const hilltopadsLink = document.getElementById('hilltopads-link');
            const backgroundAudio = document.getElementById('background-audio');
            const videoEl = document.getElementById('fluid-video-id');

            if (!videoModal || !watchBtn || !playerContainer) return;

            // --- 1. COOKIE LOGIC (30 Minute Cooldown) ---
            const adCookieName = 'gplmods_video_ad_watched';
            
            function getCookie(name) {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) return parts.pop().split(';').shift();
                return null;
            }

            function setAdCookie() {
                const date = new Date();
                date.setTime(date.getTime() + (30 * 60 * 1000)); // 30 mins
                document.cookie = `${adCookieName}=true;expires=${date.toUTCString()};path=/`;
            }

            if (getCookie(adCookieName) === 'true') {
                return; // Already watched recently
            }

            let myFP = null;

            // --- 2. SHOW MODAL (Strictly Suppressed Until Privacy Policy Accepted) ---
            const MODAL_DELAY_MS = 90000; // 1.5 Minutes
            let videoAdTimer = null;

            function startVideoAdTimer() {
                if (getCookie(adCookieName) === 'true') return;
                const hasAcceptedTOS = localStorage.getItem('gplmods_policy_accepted') === 'true';
                if (!hasAcceptedTOS) {
                    window.addEventListener('gplmods:policy-accepted', () => {
                        startVideoAdTimer();
                    }, { once: true });
                    return;
                }

                if (videoAdTimer) clearTimeout(videoAdTimer);
                videoAdTimer = setTimeout(() => { 
                    function tryShowVideoAd() {
                        if (localStorage.getItem('gplmods_policy_accepted') !== 'true') return;
                        if (getCookie(adCookieName) === 'true') return;

                        if (window.GPLPopupCoordinator && !window.GPLPopupCoordinator.canShow('video-ad')) {
                            const onPopupClosed = () => {
                                if (window.GPLPopupCoordinator && window.GPLPopupCoordinator.canShow('video-ad')) {
                                    window.removeEventListener('gplmods:popup-closed', onPopupClosed);
                                    tryShowVideoAd();
                                }
                            };
                            window.addEventListener('gplmods:popup-closed', onPopupClosed);
                            return;
                        }

                        videoModal.style.display = 'flex';
                        window._gplmodsVideoAdActive = true;
                        if (window.GPLPopupCoordinator) window.GPLPopupCoordinator.register('video-ad');
                        try { window.dispatchEvent(new CustomEvent('gplmods:video-ad-active')); } catch(e) {}
                        setTimeout(() => videoModal.classList.add('show'), 10);
                        document.body.style.overflow = 'hidden'; 
                        
                        if (backgroundAudio && !backgroundAudio.paused) {
                            backgroundAudio.dataset.adPaused = 'true';
                            backgroundAudio.pause();
                        }
                    }

                    tryShowVideoAd();
                }, MODAL_DELAY_MS);
            }

            startVideoAdTimer();

            // --- 3. CLOSE MODAL LOGIC ---
            function closeAdModal(e) {
                if (e) {
                    e.stopPropagation();
                    if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
                }
                window._gplmodsVideoAdActive = false;
                if (window.GPLPopupCoordinator) window.GPLPopupCoordinator.unregister('video-ad');
                try { window.dispatchEvent(new CustomEvent('gplmods:video-ad-closed')); } catch(e) {}
                if (myFP) {
                    try { myFP.destroy(); } catch(e) {}
                }
                if (videoEl) {
                    videoEl.pause();
                    videoEl.src = "";
                    videoEl.load();
                }
                videoModal.classList.remove('show');
                document.body.style.overflow = 'auto';

                setAdCookie(); // Set cookie when successfully closed
                
                setTimeout(() => { 
                    videoModal.style.display = 'none';
                    if (backgroundAudio && backgroundAudio.dataset.adPaused === 'true') {
                        const playPromise = backgroundAudio.play();
                        if (playPromise !== undefined) {
                            playPromise.catch(() => {});
                        }
                        backgroundAudio.dataset.adPaused = 'false';
                    }
                }, 300);
            }

            // Prevent all popunders from hijacking video modal interactions
            const modalEvents = ['click', 'mousedown', 'mouseup', 'pointerdown', 'pointerup', 'touchstart', 'touchend'];
            modalEvents.forEach(evt => {
                videoModal.addEventListener(evt, (e) => {
                    if (e.target.closest('#hilltopads-link')) {
                        return; // Let user visit Hilltopads attribution link if clicked directly
                    }
                    e.stopPropagation();
                }, false);
            });

            manualCloseBtn.addEventListener('click', closeAdModal);

            // --- 4. HANDLE "PLAY VIDEO" CLICK & SMART TIMERS ---
            watchBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                
                introScreen.style.display = 'none';
                playerContainer.style.display = 'block';
                if (hilltopadsLink) hilltopadsLink.style.display = 'inline-flex';

                let adStarted = false;
                let countdownTimer = null;
                let countdownLeft = 30; // 30 second required watch time

                // Helper function to unlock the button
                function enableCloseButton() {
                    if (countdownTimer) clearInterval(countdownTimer);
                    manualCloseBtn.style.display = 'inline-block';
                    manualCloseBtn.disabled = false;
                    manualCloseBtn.style.opacity = '1';
                    manualCloseBtn.style.cursor = 'pointer';
                    manualCloseBtn.style.borderColor = 'var(--gold)';
                    manualCloseBtn.style.color = 'var(--gold)';
                    manualCloseBtn.textContent = 'Close & Continue';
                }

                // 🟢 30-SECOND COUNTDOWN TIMER
                // Starts only when the ad video successfully begins playing
                function startCountdown() {
                    manualCloseBtn.style.display = 'inline-block';
                    manualCloseBtn.disabled = true;
                    manualCloseBtn.style.opacity = '0.4';
                    manualCloseBtn.style.cursor = 'not-allowed';
                    manualCloseBtn.textContent = `You can close in ${countdownLeft}s...`;
                    countdownTimer = setInterval(() => {
                        countdownLeft--;
                        if (countdownLeft > 0) {
                            manualCloseBtn.textContent = `You can close in ${countdownLeft}s...`;
                        } else {
                            enableCloseButton();
                        }
                    }, 1000);
                }

                function handleAdStarted() {
                    if (!adStarted) {
                        adStarted = true;
                        clearTimeout(fallbackTimer);
                        startCountdown();
                    }
                }

                // 🔴 15-SECOND FALLBACK TIMER
                // If ad network or blockers prevent ad from starting, unlock gracefully after 15s
                const fallbackTimer = setTimeout(() => {
                    if (!adStarted) {
                        console.log("[Video Ad] Ad failed to load. Fallback triggered.");
                        enableCloseButton();
                    }
                }, 15000);

                function playNativeVideoFallback() {
                    if (videoEl) {
                        videoEl.style.display = 'block';
                        videoEl.muted = true;
                        videoEl.controls = true;
                        const p = videoEl.play();
                        if (p !== undefined) {
                            p.then(() => handleAdStarted()).catch(() => {
                                enableCloseButton();
                            });
                        } else {
                            handleAdStarted();
                        }
                    } else {
                        enableCloseButton();
                    }
                }

                if (typeof fluidPlayer === 'function') {
                    try {
                        myFP = fluidPlayer('fluid-video-id', {
                            "layoutControls": {
                                "controlBar": { "autoHideTimeout": 3, "animated": true, "autoHide": true },
                                "autoPlay": true, 
                                "mute": true, // Muted autoplay ensures mobile & desktop browsers allow playback immediately
                                "allowTheatre": false,
                                "playPauseAnimation": true,
                                "playbackRateEnabled": false,
                                "allowDownload": false,
                                "playButtonShowing": true,
                                "fillToContainer": true, 
                                "primaryColor": "#FFD700" 
                            },
                            "vastOptions": {
                                "adList":[
                                    {
                                        "roll": "preRoll",
                                        "vastTag": "https://fluffy-management.com/dmmOF.zmdUG/N/vCZFGAUZ/NeWmc9Au/Z/UclMkGPATyYa5_N/jOgK5/M/jTkdtHN/jok/2/OGDzkhzrMbwZ",
                                        "adText": ""
                                    }
                                ],
                                "adCTAText": false,
                                "vastAdvanced": {
                                    "vastLoadedCallback": function() {
                                        console.log("HilltopAds VAST tag loaded");
                                    },
                                    "vastVideoStartedCallback": function() {
                                        console.log("HilltopAds VAST video started");
                                        handleAdStarted();
                                    },
                                    "vastVideoEndedCallback": function() {
                                        console.log("HilltopAds VAST video ended");
                                        enableCloseButton();
                                    },
                                    "vastVideoSkippedCallback": function() {
                                        console.log("HilltopAds VAST video skipped");
                                        enableCloseButton();
                                    },
                                    "noVastVideoCallback": function() {
                                        console.warn("HilltopAds: No VAST ad returned or ad network error");
                                        playNativeVideoFallback();
                                    }
                                }
                            }
                        });

                        // Also bind to Fluid Player instance events if available
                        if (myFP && typeof myFP.on === 'function') {
                            try {
                                myFP.on('adPlay', handleAdStarted);
                                myFP.on('adEnded', enableCloseButton);
                                myFP.on('adSkip', enableCloseButton);
                                myFP.on('adError', () => {
                                    console.warn("FluidPlayer adError: playing fallback");
                                    playNativeVideoFallback();
                                });
                            } catch(e) {}
                        }

                        if (myFP && typeof myFP.play === 'function') {
                            try { myFP.play(); } catch(e) {}
                        }
                    } catch(err) {
                        console.error("FluidPlayer init error:", err);
                        playNativeVideoFallback();
                    }
                } else {
                    playNativeVideoFallback();
                }

                // If the player video element throws an error
                if (videoEl) {
                    videoEl.addEventListener('error', () => {
                        if (!adStarted) {
                            clearTimeout(fallbackTimer);
                            enableCloseButton();
                        }
                    });
                }

                playerContainer.addEventListener('click', (e) => {
                    e.stopPropagation();
                });
            });
        });
    </script>
<% } %>