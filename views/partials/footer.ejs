    <% if (typeof showModals !== 'undefined' && showModals) { %>

        <!-- ======== ANTI-ADBLOCK MODAL ======== -->
        <% if (typeof showAds !== 'undefined' && showAds) { %>
            <div id="adblock-modal" class="policy-modal" style="display: none; align-items: center; justify-content: center; background-color: rgba(0,0,0,0.95); z-index: 100000;">
                <div class="policy-modal-content" style="background-color: var(--dark-gray); padding: 40px; text-align: center; border-radius: 15px; max-width: 500px; border-top: 4px solid var(--red); box-shadow: 0 10px 40px rgba(229, 57, 53, 0.3);">
                    <lottie-player src="<%= cdnUrl %>/animations/ad.json" background="transparent" speed="1" style="width: 120px; height: 120px; margin: 0 auto 15px auto; filter: drop-shadow(0 0 15px rgba(225, 225, 225, 0.5));" loop autoplay></lottie-player>
                    <h2 style="color: var(--white); margin-bottom: 15px;">Ad Blocker Detected</h2>
                    <p style="color: var(--silver); font-size: 1.1em; line-height: 1.6; margin-bottom: 25px;">It looks like an ad blocker or privacy shield is enabled. This can include a browser extension, an ad-blocking DNS service such as AdGuard DNS, or another privacy filter.</p>
                    <p style="color: var(--silver); margin-bottom: 30px;">Please allow ads for GPL Mods, disable the ad-blocking DNS or privacy filter for this domain, or <a href="/membership" style="color: var(--gold); font-weight: bold;">upgrade to Premium</a> for an ad-free experience.</p>
                    <button id="close-adblock-modal" class="btn btn-primary" style="width: 100%; padding: 15px; font-size: 1.1em; box-shadow: 0 0 15px var(--glow-gold); border: none; border-radius: 25px; background: var(--gold); color: var(--black); font-weight: bold; cursor: pointer;">I have disabled my Ad Blocker</button>
                </div>
            </div>

            <script src="/js/adblock-checker.min.js"></script>
            <script>
                window.GplModalCoordinator = (() => {
                    let activeModal = null;
                    const queuedModals = [];

                    function showNext() {
                        if (activeModal || queuedModals.length === 0) return;
                        const nextModal = queuedModals.shift();
                        activeModal = nextModal.type;
                        nextModal.show();
                    }

                    return {
                        show(type, show) {
                            queuedModals.push({ type, show });
                            showNext();
                        },
                        complete(type) {
                            if (activeModal === type) {
                                activeModal = null;
                                showNext();
                            }
                        }
                    };
                })();

                async function checkUserAdblockStatus() {
                    const hasAcceptedPolicy = localStorage.getItem('gplmods_policy_accepted') === 'true';
                    if (!hasAcceptedPolicy) {
                        window.addEventListener('gplmods:policy-accepted', checkUserAdblockStatus, { once: true });
                        return;
                    }

                    const currentPath = window.location.pathname;
                    const isExemptPage = ['/membership', '/login', '/register', '/signup', '/tos', '/privacy-policy'].includes(currentPath);

                    if (!isExemptPage) {
                        try {
                            if (window.GplVpnCheckPromise) {
                                await window.GplVpnCheckPromise;
                            }
                            let isEnabled = await AdBlockChecker.checkAdBlock();
                            if (isEnabled) {
                                console.log("AdBlocker detected! Springing the trap.");
                                const abModal = document.getElementById('adblock-modal');
                                if (abModal) {
                                    window.GplModalCoordinator.show('adblock', () => {
                                        abModal.style.display = 'flex';
                                        setTimeout(() => abModal.classList.add('show'), 10);
                                        document.body.style.overflow = 'hidden';
                                    });
                                }
                            }
                        } catch (err) { console.error("AdBlock checker error:", err); }
                    }
                }
                window.addEventListener('load', () => {
                    const closeButton = document.getElementById('close-adblock-modal');
                    const adblockModal = document.getElementById('adblock-modal');
                    if (closeButton && adblockModal) {
                        closeButton.addEventListener('click', () => {
                            adblockModal.classList.remove('show');
                            adblockModal.style.display = 'none';
                            document.body.style.overflow = '';
                            window.GplModalCoordinator.complete('adblock');
                        });
                    }
                });
                window.addEventListener('load', checkUserAdblockStatus);
            </script>
        <% } %> 

        <!-- ======== UNIFIED POLICY MODAL ======== -->
        <% if (typeof isOfficialDeployment !== 'undefined' && !isOfficialDeployment && !isCrawler) { %>
            <% const isTestEnv = (typeof isTestDeployment !== 'undefined' && isTestDeployment); %>
            <div id="deployment-notice-modal" style="display: none; position: fixed; inset: 0; z-index: 1000000; align-items: center; justify-content: center; padding: 20px; background: rgba(0,0,0,.82); backdrop-filter: blur(6px);">
                <div style="width: min(520px, 100%); padding: 30px; color: var(--white); background: var(--dark-gray); border: 1px solid <%= isTestEnv ? '#1e40af' : '#7d2028' %>; border-top: 4px solid <%= isTestEnv ? '#3b82f6' : '#e53935' %>; border-radius: 12px; text-align: center; box-shadow: 0 15px 50px rgba(0,0,0,.7);">
                    <i class="fas <%= isTestEnv ? 'fa-laptop-code' : 'fa-code-branch' %>" style="font-size: 3em; color: <%= isTestEnv ? '#3b82f6' : '#e53935' %>; margin-bottom: 15px;"></i>
                    <h2 style="color: <%= isTestEnv ? '#60a5fa' : '#ff6b6b' %>; margin-bottom: 12px;"><%= isTestEnv ? 'Test or Local Deployment' : 'Unofficial Deployment' %></h2>
                    <p style="color: var(--silver); line-height: 1.6; margin-bottom: 20px;">
                        <%= isTestEnv 
                            ? 'This website is running in a local test deployment of the GPLMods source code for development and debugging.' 
                            : 'This website is running from an unofficial deployment of the GPLMods source code. Verify the domain before downloading files.' %>
                    </p>
                    <% if (!isTestEnv) { %>
                        <a href="<%= officialSiteUrl %>" style="display: block; margin-bottom: 18px; color: var(--gold); font-weight: 700;">Open the official GPL Mods website</a>
                    <% } %>
                    <button id="deployment-notice-close" type="button" style="width: 100%; padding: 12px; color: #fff; background: <%= isTestEnv ? '#2563eb' : '#a51d2d' %>; border: 0; border-radius: 7px; cursor: pointer; font-weight: 700;">Continue</button>
                </div>
            </div>
            <script>
                (function() {
                    const storageKey = '<%= isTestEnv ? "gplmods_test_deployment_notice_seen" : "gplmods_deployment_notice_seen" %>';
                    if (localStorage.getItem(storageKey) !== 'true') {
                        window.gplmodsDeploymentNoticePending = true;
                    }
                })();
                window.addEventListener('load', () => {
                    const modal = document.getElementById('deployment-notice-modal');
                    const closeButton = document.getElementById('deployment-notice-close');
                    const storageKey = '<%= isTestEnv ? "gplmods_test_deployment_notice_seen" : "gplmods_deployment_notice_seen" %>';
                    if (!modal || !closeButton || localStorage.getItem(storageKey) === 'true') {
                        window.gplmodsDeploymentNoticePending = false;
                        return;
                    }
                    window.gplmodsDeploymentNoticeActive = true;
                    modal.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                    closeButton.addEventListener('click', () => {
                        localStorage.setItem(storageKey, 'true');
                        window.gplmodsDeploymentNoticeActive = false;
                        window.gplmodsDeploymentNoticePending = false;
                        modal.style.display = 'none';
                        document.body.style.overflow = '';
                        window.dispatchEvent(new CustomEvent('gplmods:deployment-notice-dismissed'));
                    });
                });
            </script>
        <% } %>

