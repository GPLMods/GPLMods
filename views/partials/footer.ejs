                justify-content: center;
                transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), background-color 0.2s ease, border-color 0.2s ease;
                user-select: none;
            }
            .gpl-chat-btn:hover { transform: scale(1.1); }
            .gpl-chat-btn img { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; transition: transform 0.25s ease, opacity 0.2s ease; }
            .gpl-chat-btn.active img { display: none; }
            .gpl-chat-btn .chat-close-icon { display: none; font-size: 1.45em; color: var(--gold); transition: transform 0.25s ease; }
            .gpl-chat-btn.active .chat-close-icon { display: block; animation: gplChatIconRotate 0.25s ease-out; }
            @keyframes gplChatIconRotate { from { transform: scale(0.6) rotate(-90deg); opacity: 0; } to { transform: scale(1) rotate(0deg); opacity: 1; } }

            /* The Pop-out Greeting Bubble */
            .gpl-chat-greeting {
                position: absolute;
                right: 80px;
                background: var(--dark-gray);
                color: var(--gold);
                padding: 6px 12px;
                border-radius: 20px 20px 0 20px;
                border: 1px solid var(--gold);
                font-size: 0.8em;
                font-weight: bold;
                white-space: nowrap;
                box-shadow: 0 5px 15px rgba(0,0,0,0.5);
                opacity: 0;
                transform: translateX(20px);
                transition: all 0.4s ease;
                pointer-events: none;
            }
            .gpl-chat-greeting.show { opacity: 1; transform: translateX(0); }

            /* The Main Chat Window - Smooth Shrink & Expand */
            .gpl-chat-window {
                position: fixed;
                bottom: 100px;
                right: 25px;
                width: 360px;
                height: 520px;
                max-height: calc(100vh - 120px);
                background-color: var(--dark-gray);
                border-radius: 15px;
                border: 1px solid #333;
                box-shadow: 0 15px 40px rgba(0,0,0,0.6);
                z-index: 9998;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                transform-origin: bottom right;
                transform: scale(0.08) translateY(50px);
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, visibility 0.32s;
            }
            .gpl-chat-window.open {
                transform: scale(1) translateY(0);
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
            }

            @media (max-width: 480px) {
                .gpl-chat-window { width: calc(100% - 40px); right: 20px; bottom: 90px; }
            }

            /* Header */
            .gpl-chat-header {
                background: var(--black);
                padding: 15px;
                border-bottom: 2px solid var(--gold);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .gpl-chat-team-info { display: flex; align-items: center; gap: 10px; }
            .gpl-chat-team-avatars { display: flex; }
            .gpl-chat-team-avatars img { width: 30px; height: 30px; border-radius: 50%; border: 2px solid var(--black); margin-left: -10px; object-fit: cover; }
            .gpl-chat-team-avatars img:first-child { margin-left: 0; }

            /* Body */
            .gpl-chat-body { flex-grow: 1; padding: 15px; overflow-y: auto; display: flex; flex-direction: column; gap: 15px; background: #111; position: relative; }
            
            .chat-bubble { max-width: 80%; padding: 10px 15px; border-radius: 15px; font-size: 0.92em; line-height: 1.4; word-wrap: break-word; animation: gplChatMessageIn .22s ease-out; }
            @keyframes gplChatMessageIn { from { opacity: 0; transform: translateY(8px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
            .bubble-user { background: var(--gold); color: var(--black); align-self: flex-end; border-bottom-right-radius: 0; }
            .bubble-bot { background: #222; color: var(--silver); align-self: flex-start; border-bottom-left-radius: 0; border: 1px solid #333; }
            .bubble-agent { background: #2196F3; color: #fff; align-self: flex-start; border-bottom-left-radius: 0; }

            /* Typing Indicator */
            .bubble-typing { background: #222; color: var(--silver); align-self: flex-start; border-bottom-left-radius: 0; border: 1px solid #333; display: flex; align-items: center; gap: 4px; padding: 10px 15px; border-radius: 15px; font-size: 0.92em; }
            .typing-dot { width: 4px; height: 4px; background: var(--silver); border-radius: 50%; animation: gplTypingDot 1.4s infinite; }
            .typing-dot:nth-child(2) { animation-delay: 0.2s; }
            .typing-dot:nth-child(3) { animation-delay: 0.4s; }
            @keyframes gplTypingDot { 0%, 100% { transform: translateY(0); opacity: 0.4; } 50% { transform: translateY(-4px); opacity: 1; } }

            /* Quick Replies */
            .gpl-chat-quick-replies {
                display: flex;
                gap: 8px;
                padding: 10px 12px;
                overflow-x: auto;
                background: #111;
                border-top: 1px solid #222;
                scrollbar-width: none;
            }
            .gpl-chat-quick-replies::-webkit-scrollbar { display: none; }
            .gpl-chat-quick-replies.closing { animation: gplChatChoicesOut 0.22s ease forwards; pointer-events: none; }
            @keyframes gplChatChoicesOut { to { opacity: 0; transform: translateY(-10px); max-height: 0; padding-top: 0; padding-bottom: 0; } }
            .quick-reply-btn {
                background: var(--dark-gray);
                color: var(--gold);
                border: 1px solid var(--gold);
                padding: 5px 12px;
                border-radius: 15px;
                font-size: 0.8em;
                white-space: nowrap;
                cursor: pointer;
                transition: all 0.2s;
            }
            .quick-reply-btn:hover { background: var(--gold); color: var(--black); }

            /* Attachment Button */
            .gpl-chat-attach {
                background: none; border: none; color: var(--silver);
                font-size: 1.1em; cursor: pointer; padding: 0 8px;
                transition: color 0.2s;
            }
            .gpl-chat-attach:hover { color: var(--gold); }

            /* Input Wrapper & Emoji Button */
            .gpl-chat-input-wrapper {
                position: relative;
                flex-grow: 1;
                display: flex;
                align-items: center;
            }
            .gpl-chat-input {
                width: 100%;
                background: #222;
                border: 1px solid #444;
                color: #fff;
                border-radius: 20px;
                padding: 10px 38px 10px 15px;
                outline: none;
                font-size: 0.9em;
                box-sizing: border-box;
            }
            .gpl-chat-input:focus { border-color: var(--gold); }
            
            .gpl-chat-emoji-btn {
                position: absolute;
                right: 8px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                cursor: pointer;
                color: var(--silver);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 4px;
                font-size: 1.15em;
                transition: color 0.2s, transform 0.2s;
            }
            .gpl-chat-emoji-btn:hover {
                color: var(--gold);
                transform: translateY(-50%) scale(1.15);
            }

            /* Emoji Picker Component */
            #gplChatEmojiPicker {
                position: absolute;
                bottom: 60px;
                right: 10px;
                left: 10px;
                height: 310px;
                max-height: 65%;
                z-index: 9999;
                display: none;
                box-shadow: 0 10px 30px rgba(0,0,0,0.8);
                border: 1px solid #333;
                border-radius: 12px;
                --background: var(--dark-gray);
                --border-color: #333;
                --indicator-color: var(--gold);
                --button-hover-background: #333;
                --search-background: var(--black);
                --search-focus-border-color: var(--gold);
                --search-icon-color: var(--silver);
                --text-color: var(--white);
            }
            #gplChatEmojiPicker.active {
                display: block;
                animation: gplEmojiPopUp 0.2s ease-out forwards;
            }
            @keyframes gplEmojiPopUp {
                from { opacity: 0; transform: translateY(10px); }
                to { opacity: 1; transform: translateY(0); }
            }

            /* Header Actions & Buttons */
            .gpl-header-actions { display: flex; align-items: center; gap: 4px; }
            .gpl-header-icon-btn {
                background: none;
                border: none;
                color: var(--silver);
                font-size: 0.95em;
                cursor: pointer;
                padding: 6px 8px;
                border-radius: 6px;
                transition: color 0.2s, background 0.2s;
                display: flex;
                align-items: center;
                justify-content: center;
            }
            .gpl-header-icon-btn:hover {
                color: var(--gold);
                background: rgba(255, 215, 0, 0.12);
            }

            /* History Drawer */
            .gpl-chat-history-drawer {
                position: absolute;
                inset: 60px 0 0 0;
                background: #111;
                z-index: 9996;
                display: flex;
                flex-direction: column;
                transform: translateX(100%);
                transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            }
            .gpl-chat-history-drawer.open {
                transform: translateX(0);
            }
            .gpl-history-header {
                padding: 10px 15px;
                background: var(--black);
                border-bottom: 1px solid #333;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }
            .gpl-history-list {
                flex-grow: 1;
                overflow-y: auto;
                padding: 12px;
                display: flex;
                flex-direction: column;
                gap: 8px;
            }
            .gpl-history-item {
                padding: 10px 12px;
                border-radius: 8px;
                border: 1px solid #292929;
                background: var(--dark-gray);
                cursor: pointer;
                transition: 0.2s;
            }
            .gpl-history-item:hover, .gpl-history-item.active {
                border-color: var(--gold);
                background: #1f1f1f;
            }
            .gpl-history-item-top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 4px;
            }
            .gpl-history-badge {
                font-size: 0.7em;
                padding: 1px 6px;
                border-radius: 8px;
                font-weight: bold;
                text-transform: uppercase;
            }
            .gpl-history-badge.bot { background: rgba(255, 215, 0, 0.15); color: var(--gold); }
            .gpl-history-badge.waiting { background: rgba(231, 76, 60, 0.15); color: #ffadad; }
            .gpl-history-badge.active { background: rgba(46, 204, 113, 0.15); color: #b0ffb0; }
            .gpl-history-snippet {
                font-size: 0.85em;
                color: #ddd;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            /* Footer/Send Button */
            .gpl-chat-footer { padding: 10px 12px; background: var(--black); border-top: 1px solid #333; display: flex; align-items: center; gap: 8px; position: relative; }
            .gpl-chat-send { background: none; border: none; color: var(--gold); font-size: 1.3em; cursor: pointer; transition: transform 0.2s; padding: 0 6px; }
            .gpl-chat-send:hover { transform: scale(1.1); }
            .gpl-chat-email-row { padding: 8px 12px; background: #111; border-top: 1px solid #222; }
            .gpl-chat-email-input { width: 100%; box-sizing: border-box; padding: 9px 12px; border-radius: 8px; border: 1px solid #444; background: #222; color: var(--white); font: inherit; font-size: .82em; }
            .gpl-chat-email-input:focus { outline: none; border-color: var(--gold); }
            .gpl-chat-confirm-modal { position: absolute; inset: 0; z-index: 10000; display: none; align-items: center; justify-content: center; padding: 20px; background: rgba(0,0,0,.7); opacity: 0; transition: opacity .2s ease; }
            .gpl-chat-confirm-modal.show { display: flex; opacity: 1; }
        </style>

        <div class="gpl-chat-btn" id="gplChatToggle" title="GPL Support Chat" role="button" aria-label="Toggle Support Chat">
            <div class="gpl-chat-greeting" id="gplChatGreeting">May I help you? 👋</div>
            <img src="/images/team-logo.png" alt="Chat" id="gplChatIconImg">
            <i class="fas fa-chevron-down chat-close-icon" id="gplChatIconClose" title="Minimize Chat"></i>
        </div>

        <div class="gpl-chat-window" id="gplChatWindow">
            <div class="gpl-chat-header">
                <div class="gpl-chat-team-info" id="gplChatTeamHeader" style="cursor: pointer; min-width: 0;" title="Minimize Chat">
                    <div class="gpl-chat-team-avatars" id="gplChatTeamAvatars">
                        <img src="/images/gemini.png" alt="AI" id="gplChatAiAvatar" title="Gemini AI">
                    </div>
                    <div style="min-width: 0;">
                        <strong style="color: var(--white); display: block; font-size: 0.92em;">Support Team</strong>
                        <div style="display: flex; align-items: center; gap: 6px; margin-top: 2px; flex-wrap: wrap;">
                            <span id="gplOnlineStatus" style="color: var(--green); font-size: 0.72em; display: flex; align-items: center; gap: 4px; line-height: 1.2;">
                                <span id="gplOnlineDot" style="display:inline-block; width:6px; height:6px; min-width: 6px; background:var(--green); border-radius:50%; box-shadow:0 0 6px var(--green); flex-shrink: 0;"></span>
                                <span id="gplOnlineText">Online</span>
                            </span>
                            <span id="gplAiStatusBadge" title="Gemini AI Health Status" style="font-size: 0.68em; padding: 1px 5px; border-radius: 10px; background: rgba(46, 204, 113, 0.15); color: var(--green); border: 1px solid rgba(46, 204, 113, 0.3); flex-shrink: 0;">AI Online</span>
                        </div>
                    </div>
                </div>
                <div class="gpl-header-actions" style="flex-shrink: 0; display: flex; align-items: center; gap: 4px;">
                    <button type="button" id="gplChatSwitchToAiBtn" class="gpl-header-icon-btn" title="Switch back to Gemini AI" style="display: none; color: #00e676; position: relative;">
                        <img src="/images/gemini.png" alt="Gemini" style="width: 17px; height: 17px; object-fit: contain; vertical-align: middle; filter: drop-shadow(0 0 5px rgba(0,230,118,0.7));">
                    </button>
                    <button type="button" id="gplChatHistoryBtn" class="gpl-header-icon-btn" title="Chat History"><i class="fas fa-history"></i></button>
                    <button type="button" id="gplChatNewBtn" class="gpl-header-icon-btn" title="Start New Conversation"><i class="fas fa-plus"></i></button>
                    <button type="button" id="gplChatDeleteBtn" class="gpl-header-icon-btn" title="Delete this conversation" style="color: var(--red);"><i class="fas fa-trash-alt"></i></button>
                    <button type="button" id="gplChatClose" class="gpl-header-icon-btn" title="Close Chat" style="font-size: 1.4em; padding: 0 6px;">&times;</button>
                </div>
            </div>
            
            <div class="gpl-chat-body" id="gplChatBody">
                <div class="chat-bubble bubble-bot">
                    Hello! 👋 I'm the GPL AI Assistant. How can I help you find the perfect mod today?
                </div>
            </div>

            <!-- History Drawer Component -->
            <div class="gpl-chat-history-drawer" id="gplChatHistoryDrawer">
                <div class="gpl-history-header">
                    <button type="button" id="gplHistoryBackBtn" class="gpl-header-icon-btn" title="Back to conversation"><i class="fas fa-arrow-left"></i></button>
                    <strong style="color: var(--gold); font-size: 0.9em;">Chat History</strong>
                    <button type="button" id="gplHistoryRefreshBtn" class="gpl-header-icon-btn" title="Refresh list"><i class="fas fa-sync-alt"></i></button>
                </div>
                <div class="gpl-history-list" id="gplHistoryList">
                    <div style="color: var(--silver); text-align: center; padding: 25px 15px; font-size: 0.85em;">Loading conversations...</div>
                </div>
                <div style="padding: 10px; background: var(--black); border-top: 1px solid #333;">
                    <button type="button" id="gplDrawerNewChatBtn" style="width: 100%; padding: 10px; background: var(--gold); color: var(--black); border: none; border-radius: 8px; font-weight: bold; font-size: 0.85em; cursor: pointer;">
                        <i class="fas fa-plus" style="margin-right: 6px;"></i> Start New Conversation
                    </button>
                </div>
            </div>

            <!-- Emoji Picker Component -->
            <emoji-picker class="dark" id="gplChatEmojiPicker"></emoji-picker>

            <!-- Quick Reply Buttons -->
            <div class="gpl-chat-quick-replies" id="gplChatQuickReplies">
                <button type="button" class="quick-reply-btn">Suggest a Mod</button>
                <button type="button" class="quick-reply-btn">Report a Bug</button>
                <button type="button" class="quick-reply-btn">Talk to Support</button>
                <button type="button" class="quick-reply-btn">Talk to Gemini AI</button>
            </div>

            <% if (!(typeof user !== 'undefined' && user)) { %>
                <div class="gpl-chat-email-row" id="gplChatEmailRow" style="display: none;">
                    <input type="email" id="gplChatEmail" class="gpl-chat-email-input" placeholder="Your email address (optional, for support replies)" autocomplete="email">
                </div>
            <% } %>
            
            <form class="gpl-chat-footer" id="gplChatForm">
                <% if (typeof user !== 'undefined' && user && (user.membership === 'premium' || user.role === 'distributor' || user.role === 'admin' || user.role === 'owner')) { %>
                    <button type="button" class="gpl-chat-attach" id="gplChatAttachBtn" title="Attach Media"><i class="fas fa-paperclip"></i></button>
                    <input type="file" id="gplChatMediaInput" accept="image/*,video/*" style="display: none;" multiple>
                <% } %>

                <div class="gpl-chat-input-wrapper">
                    <input type="text" class="gpl-chat-input" id="gplChatInput" placeholder="Type a message..." autocomplete="off">
                    <button type="button" class="gpl-chat-emoji-btn" id="gplChatEmojiBtn" title="Insert Emoji">
                        <i class="far fa-smile"></i>
                    </button>
                </div>

                <button type="submit" class="gpl-chat-send" title="Send message"><i class="fas fa-paper-plane"></i></button>
            </form>

            <div class="gpl-chat-confirm-modal" id="gplChatDeleteModal" role="dialog" aria-modal="true" aria-labelledby="gplChatDeleteTitle">
                <div style="background-color:var(--dark-gray); color:var(--white); padding:30px; text-align:center; border-radius:15px; max-width:450px; width:100%; border-top:3px solid var(--red); box-shadow:0 10px 30px rgba(0,0,0,.5);">
                    <h2 id="gplChatDeleteTitle" style="color:var(--red); margin:0 0 15px;">Delete conversation?</h2>
                    <p style="margin:0 0 20px; color:var(--silver); line-height:1.6;">This permanently removes this chat and cannot be undone.</p>
                    <div style="display:flex; gap:15px; justify-content:center;"><button type="button" id="gplChatDeleteConfirm" style="background:var(--red); color:var(--white); padding:10px 25px; border-radius:20px; font-weight:bold; border:0; cursor:pointer;">Yes, Delete</button><button type="button" id="gplChatDeleteCancel" style="background:transparent; color:var(--silver); border:2px solid var(--silver); padding:10px 25px; border-radius:20px; font-weight:bold; cursor:pointer;">Cancel</button></div>
                </div>
            </div>

            <!-- Rich Machine-Textured Gemini Confirmation Modal -->
            <div class="gpl-chat-confirm-modal" id="gplChatGeminiModal" role="dialog" aria-modal="true" aria-labelledby="gplChatGeminiTitle">
                <div style="background: linear-gradient(145deg, #1b2230 0%, #11141c 50%, #0a0c12 100%); color: var(--white); padding: 26px 22px; text-align: center; border-radius: 16px; max-width: 380px; width: 92%; border: 1.5px solid rgba(0, 230, 118, 0.45); box-shadow: 0 15px 40px rgba(0,0,0,0.85), 0 0 25px rgba(0, 176, 255, 0.25); position: relative;">
                    <div style="width: 58px; height: 58px; border-radius: 16px; background: linear-gradient(135deg, rgba(0, 176, 255, 0.2), rgba(0, 230, 118, 0.15)); border: 1.5px solid rgba(0, 230, 118, 0.5); display: flex; align-items: center; justify-content: center; margin: 0 auto 14px auto; box-shadow: 0 0 22px rgba(0, 230, 118, 0.35); position: relative;">
                        <img src="/images/gemini.png" alt="Gemini AI" style="width: 34px; height: 34px; object-fit: contain;">
                        <span style="position: absolute; bottom: -3px; right: -3px; width: 13px; height: 13px; border-radius: 50%; background: #00e676; border: 2px solid #11141c; box-shadow: 0 0 8px #00e676;"></span>
                    </div>
                    
                    <h3 id="gplChatGeminiTitle" style="color: #fff; margin: 0 0 10px; font-size: 1.2em; font-weight: 700; letter-spacing: 0.3px;">
                        Switch to Gemini AI?
                    </h3>
                    
                    <p id="gplChatGeminiMessage" style="margin: 0 0 22px; color: var(--silver); font-size: 0.88em; line-height: 1.55;">
                        Do you want to switch back to Gemini AI while waiting for a team member to join?
                    </p>

                    <div style="display: flex; gap: 10px; justify-content: center;">
                        <button type="button" id="gplChatGeminiCancel" style="background: rgba(255, 255, 255, 0.06); color: #ccc; border: 1.5px solid #3d4250; padding: 9px 18px; border-radius: 10px; font-weight: 600; font-size: 0.88em; cursor: pointer; transition: all 0.2s;">
                            Keep Waiting
                        </button>
                        <button type="button" id="gplChatGeminiConfirm" style="background: linear-gradient(135deg, #00e676 0%, #00b0ff 100%); color: #000; padding: 9px 20px; border-radius: 10px; font-weight: 700; font-size: 0.88em; border: 0; cursor: pointer; box-shadow: 0 0 16px rgba(0, 230, 118, 0.4); transition: all 0.2s;">
                            <i class="fas fa-robot" style="margin-right: 5px;"></i> Switch to Gemini
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <script>
        document.addEventListener('DOMContentLoaded', () => {
            const chatBtn = document.getElementById('gplChatToggle');
            const chatWindow = document.getElementById('gplChatWindow');
            const chatClose = document.getElementById('gplChatClose');
            const greeting = document.getElementById('gplChatGreeting');
            
            const chatBody = document.getElementById('gplChatBody');
            const chatForm = document.getElementById('gplChatForm');
            const chatInput = document.getElementById('gplChatInput');
            const quickReplyContainer = document.getElementById('gplChatQuickReplies');
            const attachBtn = document.getElementById('gplChatAttachBtn');
            const mediaInput = document.getElementById('gplChatMediaInput');
            const emojiBtn = document.getElementById('gplChatEmojiBtn');
            const emojiPicker = document.getElementById('gplChatEmojiPicker');
            const guestEmailInput = document.getElementById('gplChatEmail');
            const deleteModal = document.getElementById('gplChatDeleteModal');
            const deleteConfirmBtn = document.getElementById('gplChatDeleteConfirm');
            const deleteCancelBtn = document.getElementById('gplChatDeleteCancel');
            let pendingDeleteSessionId = null;
            let isSupportOnline = true;

            const userId = '<%= typeof user !== "undefined" && user ? user._id : "" %>';
            let guestId = localStorage.getItem('gplGuestId');
            if (!guestId) {
                guestId = 'guest_' + Math.random().toString(36).substr(2, 9);
                localStorage.setItem('gplGuestId', guestId);
            }
            let sessionId = localStorage.getItem('gplChatSessionId');

            // Gemini switch modal elements
            const switchToAiBtn = document.getElementById('gplChatSwitchToAiBtn');
            const geminiModal = document.getElementById('gplChatGeminiModal');
            const geminiConfirmBtn = document.getElementById('gplChatGeminiConfirm');
            const geminiCancelBtn = document.getElementById('gplChatGeminiCancel');
            let currentChatStatus = 'bot';

            function updateSwitchToAiBtn() {
                if (!switchToAiBtn) return;
                if (currentChatStatus === 'waiting-for-agent' || currentChatStatus === 'active-agent') {
                    switchToAiBtn.style.display = 'inline-flex';
                    switchToAiBtn.title = currentChatStatus === 'active-agent' 
                        ? 'Transfer back to Gemini AI (Issue Resolved)' 
                        : 'Switch back to Gemini AI while waiting';
                } else {
                    switchToAiBtn.style.display = 'none';
                }
            }

            function openGeminiConfirmModal() {
                if (!geminiModal) return;
                const msgEl = document.getElementById('gplChatGeminiMessage');
                if (msgEl) {
                    if (currentChatStatus === 'active-agent') {
                        msgEl.textContent = 'A support team member is currently assisting you. Do you want to mark this issue as resolved and switch back to Gemini AI Assistant?';
                    } else {
                        msgEl.textContent = 'Do you want to switch back to Gemini AI Assistant while waiting for a team member to join?';
                    }
                }
                geminiModal.style.display = 'flex';
                requestAnimationFrame(() => geminiModal.classList.add('show'));
            }

            function closeGeminiConfirmModal() {
                if (geminiModal) {
                    geminiModal.classList.remove('show');
                    setTimeout(() => geminiModal.style.display = 'none', 200);
                }
            }

            if (switchToAiBtn) switchToAiBtn.addEventListener('click', openGeminiConfirmModal);
            if (geminiCancelBtn) geminiCancelBtn.addEventListener('click', closeGeminiConfirmModal);
            if (geminiConfirmBtn) {
                geminiConfirmBtn.addEventListener('click', () => {
                    const activeSessionId = sessionId || localStorage.getItem('gplChatSessionId');
                    if (activeSessionId && typeof io !== 'undefined') {
                        const s = window.gplSupportSocket;
                        if (s) s.emit('user_transfer_to_bot', { sessionId: activeSessionId, guestId, userId });
                    }
                    closeGeminiConfirmModal();
                    currentChatStatus = 'bot';
                    updateSwitchToAiBtn();
                    appendMsg("You have switched back to Gemini AI Assistant. How can I help you today?", "system");
                });
            }

            // History & New Chat Elements
            const historyDrawer = document.getElementById('gplChatHistoryDrawer');
            const historyBtn = document.getElementById('gplChatHistoryBtn');
            const historyBackBtn = document.getElementById('gplHistoryBackBtn');
            const historyRefreshBtn = document.getElementById('gplHistoryRefreshBtn');
            const historyListEl = document.getElementById('gplHistoryList');
            const newChatBtn = document.getElementById('gplChatNewBtn');
            const drawerNewChatBtn = document.getElementById('gplDrawerNewChatBtn');
            const deleteChatBtn = document.getElementById('gplChatDeleteBtn');

            // Live indicators
            const onlineTextEl = document.getElementById('gplOnlineText');
            const onlineDotEl = document.getElementById('gplOnlineDot');
            const onlineStatusEl = document.getElementById('gplOnlineStatus');
            const aiStatusBadge = document.getElementById('gplAiStatusBadge');
            const chatTeamAvatarsEl = document.getElementById('gplChatTeamAvatars');

            if (attachBtn && mediaInput) {
                attachBtn.addEventListener('click', () => mediaInput.click());
            }

            // Emoji Picker Interaction
            if (emojiBtn && emojiPicker && chatInput) {
                emojiBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    emojiPicker.classList.toggle('active');
                });

                emojiPicker.addEventListener('emoji-click', event => {
                    const cursorPosition = chatInput.selectionStart !== null ? chatInput.selectionStart : chatInput.value.length;
                    const textBefore = chatInput.value.substring(0, cursorPosition);
                    const textAfter = chatInput.value.substring(cursorPosition);
                    chatInput.value = textBefore + event.detail.unicode + textAfter;
                    chatInput.selectionStart = chatInput.selectionEnd = cursorPosition + event.detail.unicode.length;
                    chatInput.focus();
                });

                document.addEventListener('click', (event) => {
                    if (!emojiPicker.contains(event.target) && !emojiBtn.contains(event.target)) {
                        emojiPicker.classList.remove('active');
                    }
                });
            }

            // 1. Randomized Greetings & SFX on 1st message/greeting when closed
            const greetings = [
                "May I Help You? 👋", 
                "Looking for a specific mod? 🔍", 
                "Found a bug? Let me help! 🛠️", 
                "Need mod suggestions? 💡"
            ];

            let hasPlayedGreetingSfx = sessionStorage.getItem('gpl_chat_sfx_played') === 'true';
            const chatSfxAudio = new Audio('/sfx/chat-sfx.mp3');
            chatSfxAudio.volume = 0.55;
            chatSfxAudio.preload = 'auto';

            function playChatGreetingSfx() {
                if (hasPlayedGreetingSfx) return;
                if (chatWindow && chatWindow.classList.contains('open')) return;

                const playPromise = chatSfxAudio.play();
                if (playPromise !== undefined) {
                    playPromise.then(() => {
                        hasPlayedGreetingSfx = true;
                        sessionStorage.setItem('gpl_chat_sfx_played', 'true');
                    }).catch(() => {
                        // If browser autoplay policy requires user interaction first,
                        // unlock on the first user interaction
                        const unlockHandler = () => {
                            if (!hasPlayedGreetingSfx && chatWindow && !chatWindow.classList.contains('open')) {
                                chatSfxAudio.play().then(() => {
                                    hasPlayedGreetingSfx = true;
                                    sessionStorage.setItem('gpl_chat_sfx_played', 'true');
                                }).catch(() => {});
                            }
                            window.removeEventListener('click', unlockHandler);
                            window.removeEventListener('keydown', unlockHandler);
                        };
                        window.addEventListener('click', unlockHandler, { once: true });
                        window.addEventListener('keydown', unlockHandler, { once: true });
                    });
                }
            }

            function triggerGreetingMessage() {
                if (chatWindow && !chatWindow.classList.contains('open') && greeting) {
                    greeting.textContent = greetings[Math.floor(Math.random() * greetings.length)];
                    greeting.classList.add('show');
                    playChatGreetingSfx();
                    setTimeout(() => greeting.classList.remove('show'), 6000);
                }
            }

            // Initial 1st greeting display 5 seconds after page load if chat is closed
            setTimeout(triggerGreetingMessage, 5000);
            
            // Subsequent randomized greetings every 120s
            setInterval(triggerGreetingMessage, 120000);

            // 2. Toggle Window & Shrink Handlers
            function closeChatWindow() {
                if (!chatWindow) return;
                chatWindow.classList.remove('open');
                if (chatBtn) chatBtn.classList.remove('active');
                if (historyDrawer) historyDrawer.classList.remove('open');
                if (emojiPicker) emojiPicker.classList.remove('active');
            }

            function openChatWindow() {
                if (!chatWindow) return;
                chatWindow.classList.add('open');
                if (chatBtn) chatBtn.classList.add('active');
                if (greeting) greeting.classList.remove('show');
                if (chatInput) {
                    setTimeout(() => chatInput.focus(), 120);
                }
            }

            function toggleChatWindow() {
                if (!chatWindow) return;
                if (chatWindow.classList.contains('open')) {
                    closeChatWindow();
                } else {
                    openChatWindow();
                }
            }

            if (chatBtn) {
                chatBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    toggleChatWindow();
                });
            }

            if (chatClose) {
                chatClose.addEventListener('click', (e) => {
                    e.stopPropagation();
                    closeChatWindow();
                });
            }

            const chatTeamHeader = document.getElementById('gplChatTeamHeader');
            if (chatTeamHeader) {
                chatTeamHeader.addEventListener('click', () => {
                    closeChatWindow();
                });
            }

            // Close chat when clicking anywhere outside chat window & launcher button
            document.addEventListener('click', (e) => {
                if (chatWindow && chatWindow.classList.contains('open')) {
                    if (!chatWindow.contains(e.target) && !chatBtn.contains(e.target)) {
                        closeChatWindow();
                    }
                }
            });

            // Hide floating widget on /support as it has dedicated live chat & ticket desk
            if (window.location.pathname === '/support') {
                if (chatBtn) chatBtn.style.display = 'none';
                if (chatWindow) chatWindow.style.display = 'none';
            }

            // 3. Socket.IO Logic
            if (typeof io !== 'undefined') {
                const socket = io();
                window.gplSupportSocket = socket;

                // Sync current active session
                sessionId = localStorage.getItem('gplChatSessionId');

                // Device telemetry
                const browserInfo = navigator.userAgent || '';
                let os = "Unknown OS";
                let browserName = "Unknown Browser";
                if (browserInfo.indexOf("Win") !== -1) os = "Windows";
                else if (browserInfo.indexOf("Mac") !== -1) os = "MacOS";
                else if (browserInfo.indexOf("Android") !== -1) os = "Android";
                else if (browserInfo.indexOf("iPhone") !== -1 || browserInfo.indexOf("iPad") !== -1) os = "iOS";
                else if (browserInfo.indexOf("Linux") !== -1) os = "Linux";
                
                if (browserInfo.indexOf("Chrome") !== -1) browserName = "Chrome";
                else if (browserInfo.indexOf("Safari") !== -1) browserName = "Safari";
                else if (browserInfo.indexOf("Firefox") !== -1) browserName = "Firefox";
                else if (browserInfo.indexOf("Edge") !== -1) browserName = "Edge";

                const deviceInfo = { browser: browserName, os: os };

                const currentGuestEmail = () => guestEmailInput ? guestEmailInput.value.trim() : '';
                function emitJoinChat() {
                    try {
                        if (socket && socket.connected) {
                            socket.emit('join_support_chat', { 
                                userId, 
                                guestId, 
                                sessionId, 
                                deviceInfo, 
                                guestEmail: currentGuestEmail(), 
                                currentPage: window.location.pathname,
                                avatarUrl: '<%= typeof user !== "undefined" && user && user.signedAvatarUrl ? user.signedAvatarUrl : "" %>',
                                username: '<%= typeof user !== "undefined" && user ? user.username : "" %>'
                            });
                        }
                    } catch (e) {}
                }

                // Initial connect / reconnect listener
                socket.on('connect', () => {
                    emitJoinChat();
                });
                emitJoinChat();

                if (guestEmailInput) guestEmailInput.addEventListener('change', () => {
                    if (sessionId) socket.emit('set_support_email', { sessionId, guestId, guestEmail: currentGuestEmail() });
                });

                function renderSupportAvatarsAndStatus(stats) {
                    if (!stats) return;

                    const isAiOnline = stats.aiStatus && stats.aiStatus.status === 'online';
                    const liveUsers = Array.isArray(stats.liveUsers) ? stats.liveUsers : [];
                    const userCount = liveUsers.length;
                    const staffCount = typeof stats.staffOnline === 'number' ? stats.staffOnline : liveUsers.filter(u => u.isStaff).length;
                    const isAnyoneOnline = userCount > 0 || isAiOnline;

                    // 1. DYNAMIC AVATARS:
                    // Show live users' images: if 1 user is live then 1, if 2 then 2, max 3.
                    // If AI is live, show its image (/images/gemini.png). If AI is offline, hide its image.
                    // If no one is online, hide avatars container.
                    if (chatTeamAvatarsEl) {
                        chatTeamAvatarsEl.innerHTML = '';

                        if (!isAnyoneOnline) {
                            chatTeamAvatarsEl.style.display = 'none';
                        } else {
                            chatTeamAvatarsEl.style.display = 'flex';

                            // Maximum 3 avatars total
                            const maxUserSlots = isAiOnline ? 2 : 3;
                            const usersToShow = liveUsers.slice(0, maxUserSlots);

                            usersToShow.forEach((u) => {
                                const img = document.createElement('img');
                                img.src = u.avatarUrl || '/images/default-avatar.png';
                                img.alt = u.username || 'User';
                                img.title = `${u.username || 'User'}${u.isStaff ? ' (Staff)' : ''}`;
                                img.onerror = function() { this.src = '/images/default-avatar.png'; };
                                chatTeamAvatarsEl.appendChild(img);
                            });

                            if (isAiOnline) {
                                const aiImg = document.createElement('img');
                                aiImg.src = '/images/gemini.png';
                                aiImg.alt = 'Gemini AI';
                                aiImg.title = 'Gemini AI Assistant (Online)';
                                aiImg.onerror = function() { this.style.display = 'none'; };
                                chatTeamAvatarsEl.appendChild(aiImg);
                            }
                        }
                    }

                    // 2. STATUS TEXT & INDICATORS:
                    // If no one online, say: "AI and staff members are not currently online"
                    if (onlineTextEl && onlineDotEl) {
                        if (!isAnyoneOnline) {
                            onlineTextEl.textContent = 'AI and staff members are not currently online';
                            onlineDotEl.style.background = 'var(--red)';
                            onlineDotEl.style.boxShadow = '0 0 6px var(--red)';
                            if (onlineStatusEl) onlineStatusEl.style.color = 'var(--red)';
                            if (aiStatusBadge) aiStatusBadge.style.display = 'none';
                        } else {
                            onlineDotEl.style.background = 'var(--green)';
                            onlineDotEl.style.boxShadow = '0 0 6px var(--green)';
                            if (onlineStatusEl) onlineStatusEl.style.color = 'var(--green)';

                            if (staffCount > 0) {
                                onlineTextEl.textContent = `${staffCount} Staff Online`;
                            } else if (userCount > 0) {
                                onlineTextEl.textContent = `${userCount} Online`;
                            } else if (isAiOnline) {
                                onlineTextEl.textContent = 'AI Online';
                            }

                            if (aiStatusBadge) {
                                aiStatusBadge.style.display = 'inline-block';
                                if (isAiOnline) {
                                    aiStatusBadge.textContent = 'AI Online';
                                    aiStatusBadge.style.background = 'rgba(46, 204, 113, 0.15)';
                                    aiStatusBadge.style.color = 'var(--green)';
                                    aiStatusBadge.style.borderColor = 'rgba(46, 204, 113, 0.3)';
                                    aiStatusBadge.title = `Gemini AI Online${stats.aiStatus && stats.aiStatus.latencyMs ? ' (' + stats.aiStatus.latencyMs + 'ms)' : ''}`;
                                } else {
                                    aiStatusBadge.textContent = 'AI Offline';
                                    aiStatusBadge.style.background = 'rgba(231, 76, 60, 0.15)';
                                    aiStatusBadge.style.color = 'var(--red)';
                                    aiStatusBadge.style.borderColor = 'rgba(231, 76, 60, 0.3)';
                                    aiStatusBadge.title = stats.aiStatus && stats.aiStatus.lastError ? (stats.aiStatus.lastError.message || stats.aiStatus.lastError) : 'AI offline';
                                }
                            }
                        }
                    }
                }

                // Live Online Stats & AI Health Listener
                socket.on('support_stats_update', (stats) => {
                    isSupportOnline = ((stats.staffOnline || stats.agentsOnline) > 0 || (stats.liveUsers && stats.liveUsers.length > 0));
                    renderSupportAvatarsAndStatus(stats);
                });

                // Immediate offline, disconnect, and network failure cleanup
                function handleOfflineState(reason) {
                    isSupportOnline = false;
                    renderSupportAvatarsAndStatus({
                        liveUsers: [],
                        staffOnline: 0,
                        agentsOnline: 0,
                        aiStatus: { status: 'offline', lastError: reason || 'Offline' }
                    });
                }

                socket.on('disconnect', (reason) => {
                    handleOfflineState('Disconnected from server');
                });

                socket.on('connect_error', (err) => {
                    handleOfflineState('Connection error');
                });

                window.addEventListener('offline', () => {
                    handleOfflineState('Device is offline');
                });

                window.addEventListener('online', () => {
                    if (socket && socket.disconnected) {
                        socket.connect();
                    } else {
                        emitJoinChat();
                    }
                });

                // Immediately emit leave_support_chat and disconnect when tab unloads or hides
                const handleLeave = () => {
                    try {
                        if (socket && socket.connected) {
                            socket.emit('leave_support_chat', { userId, guestId });
                            socket.disconnect();
                        }
                    } catch (e) {}
                };
                window.addEventListener('beforeunload', handleLeave);
                window.addEventListener('pagehide', handleLeave);

                socket.on('support_chat_ready', (data) => {
                    localStorage.setItem('gplChatSessionId', data.sessionId);
                    sessionId = data.sessionId;
                    currentChatStatus = data.status || 'bot';
                    updateSwitchToAiBtn();
                    
                    if (data.history && data.history.length > 0) {
                        chatBody.innerHTML = '';
                        data.history.forEach(msg => appendMsg(msg.text, msg.sender, msg.senderName));
                    } else {
                        chatBody.innerHTML = '';
                        appendMsg("Hello! 👋 I'm the GPL AI Assistant. How can I help you find the perfect mod today?", "bot");
                    }

                    if (quickReplyContainer) quickReplyContainer.style.display = (data.history && data.history.length > 2) ? 'none' : 'flex';
                });

                socket.on('support_chat_status_updated', (data) => {
                    if (data && data.status) {
                        currentChatStatus = data.status;
                        updateSwitchToAiBtn();
                    }
                });

                socket.on('new_support_message', (msg) => {
                    removeTypingIndicator();
                    appendMsg(msg.text, msg.sender, msg.senderName);
                    if (msg.text && (msg.text.includes('human support team') || msg.text.includes('Transferring you'))) {
                        currentChatStatus = 'waiting-for-agent';
                        updateSwitchToAiBtn();
                    } else if (msg.sender === 'agent') {
                        currentChatStatus = 'active-agent';
                        updateSwitchToAiBtn();
                    }
                });

                // --- NEW CHAT LOGIC ---
                function startNewChat() {
                    localStorage.removeItem('gplChatSessionId');
                    sessionId = null;
                    chatBody.innerHTML = '';
                    appendMsg("Hello! 👋 I'm the GPL AI Assistant. How can I help you find the perfect mod today?", "bot");
                    if (quickReplyContainer) quickReplyContainer.style.display = 'flex';
                    if (historyDrawer) historyDrawer.classList.remove('open');
                    socket.emit('join_support_chat', { userId, guestId, sessionId: null, deviceInfo, guestEmail: currentGuestEmail(), currentPage: window.location.pathname, forceNew: true });
                }

                if (newChatBtn) newChatBtn.addEventListener('click', startNewChat);
                if (drawerNewChatBtn) drawerNewChatBtn.addEventListener('click', startNewChat);

                function deleteCurrentChat() {
                    if (!sessionId || !deleteModal) return;
                    pendingDeleteSessionId = sessionId;
                    deleteModal.style.display = 'flex';
                    requestAnimationFrame(() => deleteModal.classList.add('show'));
                }

                if (deleteChatBtn) deleteChatBtn.addEventListener('click', deleteCurrentChat);
                function closeDeleteModal() { pendingDeleteSessionId = null; if (deleteModal) { deleteModal.classList.remove('show'); setTimeout(() => deleteModal.style.display = 'none', 200); } }
                if (deleteCancelBtn) deleteCancelBtn.addEventListener('click', closeDeleteModal);
                if (deleteConfirmBtn) deleteConfirmBtn.addEventListener('click', () => { if (!pendingDeleteSessionId) return; const targetSessionId = pendingDeleteSessionId; closeDeleteModal(); socket.emit('delete_support_chat', { sessionId: targetSessionId, userId, guestId }); });

                socket.on('support_chat_deleted', (data) => {
                    if (String(data.sessionId) !== String(sessionId)) {
                        if (historyDrawer && historyDrawer.classList.contains('open')) loadChatHistory();
                        return;
                    }
                    localStorage.removeItem('gplChatSessionId');
                    sessionId = null;
                    if (historyDrawer) historyDrawer.classList.remove('open');
                    startNewChat();
                });

                socket.on('support_chat_delete_error', (data) => {
                    alert(data.message || 'Unable to delete this conversation.');
                });

                // --- HISTORY DRAWER LOGIC ---
                function loadChatHistory() {
                    if (historyListEl) {
                        historyListEl.innerHTML = '<div style="color: var(--silver); text-align: center; padding: 25px 15px; font-size: 0.85em;">Loading conversations...</div>';
                    }
                    socket.emit('get_user_chat_history', { userId, guestId });
                }

                if (historyBtn) {
                    historyBtn.addEventListener('click', () => {
                        if (historyDrawer) {
                            historyDrawer.classList.toggle('open');
                            if (historyDrawer.classList.contains('open')) {
                                loadChatHistory();
                            }
                        }
                    });
                }

                if (historyBackBtn) {
                    historyBackBtn.addEventListener('click', () => {
                        if (historyDrawer) historyDrawer.classList.remove('open');
                    });
                }

                if (historyRefreshBtn) {
                    historyRefreshBtn.addEventListener('click', loadChatHistory);
                }

                socket.on('user_chat_history_list', (sessions) => {
                    if (!historyListEl) return;
                    historyListEl.innerHTML = '';
                    
                    if (!sessions || sessions.length === 0) {
                        historyListEl.innerHTML = '<div style="color: var(--silver); text-align: center; padding: 30px 15px; font-size: 0.85em;">No past conversations found.</div>';
                        return;
                    }

                    sessions.forEach(sess => {
                        const div = document.createElement('div');
                        div.className = `gpl-history-item ${sess._id === sessionId ? 'active' : ''}`;
                        const d = new Date(sess.updatedAt);
                        const dateStr = d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) + ' ' + d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
                        
                        let badgeClass = 'bot';
                        let badgeLabel = 'AI Bot';
                        if (sess.status === 'waiting-for-agent') { badgeClass = 'waiting'; badgeLabel = 'Waiting'; }
                        else if (sess.status === 'active-agent') { badgeClass = 'active'; badgeLabel = 'Agent'; }

                        div.innerHTML = `
                            <div class="gpl-history-item-top">
                                <span style="font-size:0.75em; color:var(--silver);">${dateStr}</span>
                                <span style="display:flex; align-items:center; gap:8px;"><span class="gpl-history-badge ${badgeClass}">${badgeLabel}</span><button type="button" class="gpl-history-delete" title="Delete conversation" style="background:none; border:0; color:var(--red); cursor:pointer; padding:2px;"><i class="fas fa-trash-alt"></i></button></span>
                            </div>
                            <div class="gpl-history-snippet">${sess.snippet || 'Empty conversation'}</div>
                        `;

                        div.addEventListener('click', () => {
                            localStorage.setItem('gplChatSessionId', sess._id);
                            sessionId = sess._id;
                            socket.emit('switch_support_chat', { sessionId: sess._id });
                            if (historyDrawer) historyDrawer.classList.remove('open');
                        });

                        div.querySelector('.gpl-history-delete').addEventListener('click', (event) => {
                            event.stopPropagation();
                            if (String(sess._id) === String(sessionId)) return deleteCurrentChat();
                            // Reuse the styled confirmation modal for history items.
                            if (!deleteModal) return;
                            pendingDeleteSessionId = sess._id;
                            deleteModal.style.display = 'flex'; requestAnimationFrame(() => deleteModal.classList.add('show'));
                        });

                        historyListEl.appendChild(div);
                    });
                });

                if (chatForm) {
                    chatForm.addEventListener('submit', (e) => {
                        e.preventDefault();
                        const text = chatInput.value.trim();
                        if (text && sessionId) {
                            const isPremium = <%= (typeof user !== 'undefined' && user && (user.membership === 'premium' || user.role === 'distributor' || user.role === 'admin' || user.role === 'owner')) ? 'true' : 'false' %>;
                            socket.emit('send_support_message', { sessionId, text, isPremium, guestId });
                            chatInput.value = '';
                            if (quickReplyContainer) { quickReplyContainer.style.display = 'none'; }
                            showTypingIndicator();
                        }
                    });
                }

                // Quick Replies
                const quickReplyBtns = document.querySelectorAll('.quick-reply-btn');
                quickReplyBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        const text = btn.textContent;
                        if (sessionId) {
                            if (text.includes('Gemini AI') && (currentChatStatus === 'waiting-for-agent' || currentChatStatus === 'active-agent')) {
                                openGeminiConfirmModal();
                                return;
                            }
                            // If clicking "Talk to Support" while offline, redirect to support page
                            if (text === 'Talk to Support' && !isSupportOnline) {
                                window.location.href = '/support';
                                return;
                            }
                            // Show email row if clicking support/ai options
                            if (text.includes('Support') || text.includes('Gemini AI')) {
                                const emailRow = document.getElementById('gplChatEmailRow');
                                if (emailRow) emailRow.style.display = 'block';
                            }
                            const isPremium = <%= (typeof user !== 'undefined' && user && (user.membership === 'premium' || user.role === 'distributor' || user.role === 'admin' || user.role === 'owner')) ? 'true' : 'false' %>;
                            socket.emit('send_support_message', { sessionId, text, isPremium, guestId });
                            if (quickReplyContainer) { quickReplyContainer.classList.add('closing'); setTimeout(() => { quickReplyContainer.style.display = 'none'; quickReplyContainer.classList.remove('closing'); }, 220); }
                        }
                    });
                });

                function showTypingIndicator() {
                    if (document.getElementById('gplChatTyping')) return;
                    const div = document.createElement('div');
                    div.id = 'gplChatTyping';
                    div.className = 'chat-bubble bubble-typing';
                    div.innerHTML = '<span style="font-size: 0.85em; opacity: 0.8; margin-right: 5px; font-style: italic; vertical-align: middle;">Writing</span><div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>';
                    chatBody.appendChild(div);
                    chatBody.scrollTop = chatBody.scrollHeight;
                }

                function removeTypingIndicator() {
                    const indicator = document.getElementById('gplChatTyping');
                    if (indicator) indicator.remove();
                }

                function appendMsg(text, sender, senderName) {
                    const div = document.createElement('div');
                    if (sender === 'system') {
                        div.className = 'chat-bubble';
                        div.style.alignSelf = 'center';
                        div.style.background = 'transparent';
                        div.style.color = 'var(--silver)';
                        div.style.border = '1px dashed #555';
                        div.style.fontSize = '0.85em';
                        div.style.textAlign = 'center';
                        div.style.maxWidth = '90%';
                    } else if (sender === 'user') {
                        div.className = 'chat-bubble bubble-user';
                    } else if (sender === 'agent') {
                        div.className = 'chat-bubble bubble-agent';
                    } else {
                        div.className = 'chat-bubble bubble-bot';
                    }
                    
                    let content = '';
                    if (senderName && (sender === 'agent' || sender === 'bot')) {
                        content += `<strong style="font-size:0.8em; opacity:0.8; display:block; margin-bottom:3px;">${senderName}</strong>`;
                    }
                    content += (text || '').replace(/\n/g, '<br>');
                    div.innerHTML = content;
                    chatBody.appendChild(div);
                    chatBody.scrollTop = chatBody.scrollHeight;
                    if (sender !== 'user' && sender !== 'system') {
                        playChatGreetingSfx();
                    }
                }
            }
        });
        </script>
        <!-- ================================================== -->
        <% } %>

    <% } %> <!-- ✅ THIS IS THE FIX: The closing tag for showModals is safely at the very bottom -->

    <!-- Global Click-to-Reveal Overlay Logic for Mod Cards on Touch/Mobile Devices -->
    <script>
        document.addEventListener('click', function (e) {
            const card = e.target.closest('.mod-card');
            if (card) {
                if (e.target.closest('.download-overlay') || e.target.closest('a.full-card-link')) {
                    return;
                }
                const allActive = document.querySelectorAll('.mod-card.active-overlay');
                allActive.forEach(function (c) {
                    if (c !== card) c.classList.remove('active-overlay');
                });
                card.classList.toggle('active-overlay');
            } else {
                document.querySelectorAll('.mod-card.active-overlay').forEach(function (c) {
                    c.classList.remove('active-overlay');
                });
            }
        });
    </script>
</body>
</html>
