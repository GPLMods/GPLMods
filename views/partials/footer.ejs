                transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            }
            .gpl-chat-btn:hover { transform: scale(1.1); }
            .gpl-chat-btn img { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; }

            /* The Pop-out Greeting Bubble */
            .gpl-chat-greeting {
                position: absolute;
                right: 80px;
                background: var(--dark-gray);
                color: var(--gold);
                padding: 10px 15px;
                border-radius: 20px 20px 0 20px;
                border: 1px solid var(--gold);
                font-size: 0.9em;
                font-weight: bold;
                white-space: nowrap;
                box-shadow: 0 5px 15px rgba(0,0,0,0.5);
                opacity: 0;
                transform: translateX(20px);
                transition: all 0.4s ease;
                pointer-events: none;
            }
            .gpl-chat-greeting.show { opacity: 1; transform: translateX(0); }

            /* The Main Chat Window */
            .gpl-chat-window {
                position: fixed;
                bottom: 100px;
                right: 25px;
                width: 360px;
                height: 520px;
                max-height: calc(100vh - 120px);
                background-color: var(--dark-gray);
                border-radius: 15px;
                border: 1px solid #333;
                box-shadow: 0 15px 40px rgba(0,0,0,0.6);
                z-index: 9998;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                transform: translateY(20px);
                opacity: 0;
                visibility: hidden;
                transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            }
            .gpl-chat-window.open {
                transform: translateY(0);
                opacity: 1;
                visibility: visible;
            }

            @media (max-width: 480px) {
                .gpl-chat-window { width: calc(100% - 40px); right: 20px; bottom: 90px; }
            }

            /* Header */
            .gpl-chat-header {
                background: var(--black);
                padding: 15px;
                border-bottom: 2px solid var(--gold);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
