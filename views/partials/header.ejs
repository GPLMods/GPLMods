<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <%
        const siteName = "GPL Mods Official";
        const defaultTitle = "GPL Mods - 100% Safe & Working Premium Unlocked Mods";
        const defaultDesc = "Download 100% safe, working Mod APKs, iOS IPAs, Windows software, and WordPress GPL themes. GPL Mods offers virus-scanned, premium unlocked apps for free.";
        const defaultKeywords = "gpl mods, GPL Mods, mod apk, apk mod, how to mod apk, mod ipa, windows software unlocked, wordpress gpl free, roblox mod apk 2026, trusted mod apk sites, ios sideloading, premium unlocked";
        const defaultImage = "https://gplmods.webredirect.org/images/logo.png";
        const defaultUrl = "https://gplmods.webredirect.org";

        const finalTitle = typeof pageTitle !== 'undefined' ? `${pageTitle} | ${siteName}` : defaultTitle;
        const finalDesc = typeof pageDescription !== 'undefined' ? pageDescription : defaultDesc;
        const finalKeywords = typeof pageKeywords !== 'undefined' ? pageKeywords : defaultKeywords;
        const finalImage = typeof pageImage !== 'undefined' ? pageImage : defaultImage;
        const finalUrl = typeof pageUrl !== 'undefined' ? pageUrl : defaultUrl;
    %>

    <title><%= finalTitle %></title>
    <meta name="description" content="<%= finalDesc %>">
    <meta name="keywords" content="<%= finalKeywords %>">
    <meta name="author" content="GPL Mods Team">
    <link rel="canonical" href="<%= finalUrl %>">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

    <meta property="og:site_name" content="<%= siteName %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= finalUrl %>">
    <meta property="og:title" content="<%= finalTitle %>">
    <meta property="og:description" content="<%= finalDesc %>">
    <meta property="og:image" content="<%= finalImage %>">

    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="<%= finalUrl %>">
    <meta property="twitter:title" content="<%= finalTitle %>">
    <meta property="twitter:description" content="<%= finalDesc %>">
    <meta property="twitter:image" content="<%= finalImage %>">

    <!-- Schema.org JSON-LD Structured Data for Search Engine Bots -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://gplmods.webredirect.org/#organization",
          "name": "GPL Mods",
          "url": "https://gplmods.webredirect.org",
          "logo": {
            "@type": "ImageObject",
            "url": "https://gplmods.webredirect.org/images/logo.png"
          },
          "sameAs": [
            "https://t.me/gplmods"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://gplmods.webredirect.org/#website",
          "url": "https://gplmods.webredirect.org",
          "name": "GPL Mods",
          "publisher": {
            "@id": "https://gplmods.webredirect.org/#organization"
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://gplmods.webredirect.org/?search={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
    </script>
    
    <link rel="icon" type="image/png" href="<%= cdnUrl %>/favicon.png">
    <link rel="apple-touch-icon" href="<%= cdnUrl %>/favicon.png">
    <!-- PWA Meta Tags -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0a0a0a">
    
    <!-- iOS Support -->
    <link rel="apple-touch-icon" href="/images/icon-192x192.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="GPL Mods">
    
    <!-- Android/Chrome Support -->
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
        <!-- ======== CDN CIRCUIT BREAKER SCRIPT ======== -->
    <script>
        function triggerCdnFallback() {
            // 1. Set the cookie to expire in exactly 12 hours (43200 seconds)
            // This tells the backend to stop sending CDN URLs for the next 12 hours.
            document.cookie = "cdn_down=true; max-age=43200; path=/";
            console.warn("CDN Failure Detected! Switched to Local Server for the next 12 hours.");
            
            // 2. Fix the assets currently on this page that have already failed
            const fixPageAssets = () => {
                const cdnUrl = "<%= rawCdnUrl %>";
                if (!cdnUrl) return; // If no CDN was configured, do nothing
                
                // Find all Lottie players, images, and audio tags
                const elements = document.querySelectorAll('lottie-player, img, audio, source');
                
                elements.forEach(el => {
                    const src = el.getAttribute('src');
                    // If the source contains the broken CDN URL, strip it out so it loads locally
                    if (src && src.startsWith(cdnUrl)) {
                        el.setAttribute('src', src.replace(cdnUrl, ''));
                    }
                });
            };

            // Run immediately for elements already loaded
            fixPageAssets();
            
            // Run again when the whole page finishes loading to catch everything at the bottom
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', fixPageAssets);
            }
        }

        // ======== SMART GO BACK CONTROLLER ========
        window.smartGoBack = function(fallbackUrl) {
            const fallback = fallbackUrl || '/';
            if (document.referrer && document.referrer !== window.location.href) {
                try {
                    const refUrl = new URL(document.referrer);
                    const currentUrl = new URL(window.location.href);
                    // Check same origin
                    if (refUrl.origin === currentUrl.origin) {
                        const trapPaths = ['/login', '/register', '/logout', '/login/2fa', '/admin'];
                        const isTrap = trapPaths.some(p => refUrl.pathname.startsWith(p));
                        if (!isTrap && refUrl.pathname !== currentUrl.pathname) {
                            window.location.href = document.referrer;
                            return;
                        }
                    }
                } catch (e) {}
            }
            if (window.history.length > 1) {
                const prevLoc = window.location.href;
                window.history.back();
                setTimeout(() => {
                    if (window.location.href === prevLoc) {
                        window.location.href = fallback;
                    }
                }, 300);
            } else {
                window.location.href = fallback;
            }
        };

        // Automatically bind to any back links across the entire page
        document.addEventListener('click', function(e) {
            const target = e.target.closest('a[href*="history.back"], .dynamic-back-btn, .btn-go-back');
            if (target) {
                e.preventDefault();
                window.smartGoBack(target.getAttribute('data-fallback') || '/');
            }
        });
    </script>
    <!-- ============================================ -->

    <!-- ✅ Apply the trigger to your CSS file -->
    <link rel="stylesheet" href="<%= cdnUrl %>/css/style.css" onerror="this.onerror=null; this.href='/css/style.css'; triggerCdnFallback();">

    <script src="<%= cdnUrl %>/js/main.js" onerror="this.onerror=null; this.src='/js/image-fallback.js'; triggerCdnFallback();"></script>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>


    <!-- ====================================================================== -->
    <!-- ✅ FIX: BULLETPROOF GRID HEADER & SEARCH BAR LAYOUT                    -->
    <!-- ====================================================================== -->
    <style>
        .main-header { padding: 15px 0; background-color: var(--black); border-bottom: 1px solid var(--dark-gray); position: sticky; top: 0; z-index: 1000; }
        
        /* 1. Base Grid Layout (Fixes Button Alignment!) */
        .header-content { 
            display: grid; 
            grid-template-columns: max-content 1fr max-content; /* Logo | Search | Actions */
            align-items: center; 
            gap: 20px; 
        }
        
        .logo { font-size: 1.8em; font-weight: 700; color: var(--gold); text-shadow: 0 0 10px var(--glow-gold); text-decoration: none; white-space: nowrap; justify-self: start; }
        .logo span { color: var(--silver); text-shadow: 0 0 10px var(--glow-silver); }
        
        /* 2. Search Bar */
        .search-bar { 
            width: 100%; 
            max-width: 600px; 
            justify-self: center; /* Centers it within the middle grid column */
            position: relative; 
            z-index: 1001; 
        }
        
        .search-form { position: relative; width: 100%; display: block; }
        
        #searchInput { 
            width: 100%; 
            padding: 12px 15px 12px 45px !important; 
            box-sizing: border-box; 
            border-radius: 25px; 
            border: 1px solid #333;
            background-color: var(--dark-gray, #1a1a1a);
            color: var(--white, #fff);
            font-size: 1em;
            outline: none;
            transition: border-color 0.3s ease;
            --placeholder-color: var(--silver); /* Default color before animation */
        }
        #searchInput:focus { border-color: var(--gold, #FFD700); box-shadow: 0 0 10px var(--glow-gold); }
        #searchInput::placeholder { color: var(--placeholder-color); opacity: 1; transition: color 0.4s ease-in-out; }
        
        /* Custom Silver Close (X) Icon for Search */
        input[type="search"]::-webkit-search-cancel-button {
            -webkit-appearance: none;
            height: 16px;
            width: 16px;
            background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23c0c0c0'><path d='M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z'/></svg>") no-repeat center center;
            background-size: contain;
            cursor: pointer;
            opacity: 0.7;
            transition: opacity 0.2s ease;
        }
        input[type="search"]::-webkit-search-cancel-button:hover { opacity: 1; }
        input[type="search"]::-webkit-search-decoration,
        input[type="search"]::-webkit-search-results-button,
        input[type="search"]::-webkit-search-results-decoration { -webkit-appearance:none; }

        /* Search Dropdown Results */
        .search-suggestions, .search-history {
            display: none; 
            position: absolute;
            top: calc(100% + 10px); 
            left: 0;
            right: 0; 
            background-color: var(--dark-gray, #1a1a1a);
            border: 1px solid #333;
            border-radius: 12px;
            max-height: 350px;
            overflow-y: auto;
            z-index: 1001; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
        }
        .search-suggestions::-webkit-scrollbar, .search-history::-webkit-scrollbar { width: 6px; }
        .search-suggestions::-webkit-scrollbar-track, .search-history::-webkit-scrollbar-track { background: transparent; }
        .search-suggestions::-webkit-scrollbar-thumb, .search-history::-webkit-scrollbar-thumb { background: #444; border-radius: 10px; }
        
        .search-suggestions ul, .search-history ul { list-style: none; padding: 0; margin: 0; }
        .search-suggestions li a, .search-history li a {
            display: block; 
            padding: 12px 20px; 
            color: var(--silver, #c0c0c0); 
            text-decoration: none;
            transition: all 0.2s ease; 
            border-bottom: 1px solid #222;
            white-space: nowrap; 
            overflow: hidden; 
            text-overflow: ellipsis;
        }
        .search-suggestions li:last-child a, .search-history li:last-child a { border-bottom: none; }
        .search-suggestions li a:hover, .search-history li a:hover { background-color: #2a2a2a; color: var(--gold, #FFD700); }
        .search-history li a::before { content: '\f017'; font-family: 'Font Awesome 6 Free'; font-weight: 400; margin-right: 10px; color: #555; }
        .search-history h4 { padding: 15px 20px 10px; margin: 0; color: var(--gold, #FFD700); font-size: 0.85em; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1px solid #222; background-color: #111; position: sticky; top: 0; z-index: 2; }

        /* 3. Right Side Actions */
        .header-right-actions { 
            display: flex; 
            align-items: center; 
            gap: 15px; 
            justify-self: end; /* Aligns this whole block to the right */
            flex-shrink: 0; 
        }
        
        .desktop-text-buttons { display: none; }
        
        /* Mobile Avatar Styling */
        .avatar-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 35px !important;  
            height: 35px !important; 
            min-width: 35px; 
            min-height: 35px; 
            border: 2px solid var(--silver, #c0c0c0);
            background-color: var(--black, #000); 
            border-radius: 50%; 
            cursor: pointer; 
            text-decoration: none;
            overflow: hidden; 
            box-sizing: border-box;
        }
        .avatar-placeholder img { width: 100% !important; height: 100% !important; object-fit: cover !important; display: block; }
        
        .hamburger-menu { 
            display: inline-flex !important; 
            align-items: center; 
            justify-content: center; 
            cursor: pointer; 
            font-size: 1.55em; 
            color: var(--silver, #c0c0c0); 
            margin: 0 !important; 
            padding: 0 !important; 
            width: auto !important; 
            height: auto !important; 
            border-radius: 0 !important; 
            background: transparent !important; 
            border: none !important; 
            outline: none !important; 
            box-shadow: none !important; 
            line-height: 1 !important; 
            -webkit-tap-highlight-color: transparent; 
            transition: color 0.2s ease; 
        }
        .hamburger-menu:hover, .hamburger-menu:focus, .hamburger-menu.open { 
            color: var(--gold, #FFD700) !important; 
            background: transparent !important; 
            border: none !important; 
            outline: none !important; 
            box-shadow: none !important; 
            transform: none !important; 
        }
        
        /* Desktop Breakpoint */
        @media (min-width: 1024px) {
            .desktop-text-buttons { display: flex; align-items: center; gap: 10px; }
            /* Keep hamburger visible on desktop as requested */
            .hamburger-menu { display: flex !important; }
            /* Show avatar on desktop too */
            .header-mobile-actions .avatar-placeholder { display: block; }
            /* Slightly reduce spacing so both avatar and desktop buttons fit */
            .header-right-actions { gap: 10px; }
        }

        /* Mobile Breakpoint (Drops Search Bar to bottom row) */
        @media (max-width: 992px) {
            .header-content {
                grid-template-columns: max-content 1fr; /* Logo takes only what it needs */
                grid-template-areas: 
                    "logo actions"
                    "search search"; 
            }
            .logo { grid-area: logo; justify-self: start; }
            .header-right-actions { grid-area: actions; justify-self: end; } /* Push to far right */
            .search-bar { 
                grid-area: search; 
                max-width: 100%; /* Full width on mobile */
                margin-top: 5px;
            }
        }

        /* ====================================================================== */
        /* ✅ MOBILE NAVIGATION DRAWER & WISHLIST BUTTON STYLES                  */
        /* ====================================================================== */
        .mobile-nav {
            z-index: 100000 !important;
            box-sizing: border-box !important;
            overflow-y: auto !important;
            -webkit-overflow-scrolling: touch;
            padding: 20px 18px 50px 18px !important;
            width: 82% !important;
            max-width: 320px !important;
            background-color: #121212 !important;
            box-shadow: 5px 0 30px rgba(0, 0, 0, 0.85) !important;
        }
        .mobile-nav > ul {
            list-style: none !important;
            padding: 10px 0 30px 0 !important;
            margin: 0 !important;
        }
        .mobile-nav li {
            margin-bottom: 10px !important;
            list-style: none !important;
        }
        .mobile-nav a,
        .mobile-nav li a,
        .mobile-nav .sub-menu a {
            text-decoration: none !important;
            font-size: 1.05em !important;
            color: var(--silver, #c0c0c0) !important;
            display: flex !important;
            align-items: center !important;
            transition: color 0.2s ease, transform 0.2s ease !important;
        }
        .mobile-nav a:hover,
        .mobile-nav li a:hover,
        .mobile-nav .sub-menu a:hover {
            color: var(--gold, #ffd700) !important;
            text-decoration: none !important;
        }
        .mobile-nav .collapsible-trigger {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            width: 100% !important;
            box-sizing: border-box !important;
            cursor: pointer !important;
            user-select: none;
        }
        .mobile-nav .has-submenu .arrow {
            display: inline-block !important;
            transition: transform 0.3s ease !important;
            font-size: 0.75em !important;
            margin-left: 8px !important;
            line-height: 1 !important;
        }
        .mobile-nav .has-submenu.open > .collapsible-trigger .arrow {
            transform: rotate(180deg) !important;
        }
        /* Reset rogue padding/margins causing phantom gap under categories and admin suite */
        .mobile-nav .sub-menu {
            list-style: none !important;
            padding: 0 !important;
            margin: 0 !important;
            max-height: 0 !important;
            overflow: hidden !important;
            opacity: 0 !important;
            transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease !important;
            box-sizing: border-box !important;
        }
        .mobile-nav .has-submenu.open > .sub-menu {
            max-height: 800px !important; /* Fully displays all 7 items without cutting off */
            opacity: 1 !important;
            padding: 8px 0 8px 12px !important;
            margin-top: 4px !important;
        }
        .mobile-nav .sub-menu li {
            margin-bottom: 8px !important;
            font-size: 0.92em !important;
        }
        .mobile-nav .sub-menu li a {
            padding: 4px 0 !important;
            gap: 10px !important;
        }
        .mobile-nav .admin-suite-box {
            background: rgba(255, 215, 0, 0.08) !important;
            border: 1px solid rgba(255, 215, 0, 0.35) !important;
            border-radius: 10px !important;
            padding: 6px 12px !important;
            margin: 8px 0 !important;
            box-sizing: border-box !important;
        }
        .mobile-nav .admin-suite-box > .collapsible-trigger {
            padding: 6px 0 !important;
        }
        .mobile-nav .admin-suite-box.open {
            background: rgba(255, 215, 0, 0.12) !important;
            border-color: rgba(255, 215, 0, 0.6) !important;
        }
        .mobile-nav .admin-suite-box .sub-menu {
            border-top: 1px solid rgba(255, 215, 0, 0.15) !important;
            margin-top: 6px !important;
        }

        .mobile-nav .owner-suite-box {
            background: rgba(244, 67, 54, 0.08) !important;
            border: 1px solid rgba(244, 67, 54, 0.35) !important;
            border-radius: 10px !important;
            padding: 6px 12px !important;
            margin: 8px 0 !important;
            box-sizing: border-box !important;
        }
        .mobile-nav .owner-suite-box > .collapsible-trigger {
            padding: 6px 0 !important;
        }
        .mobile-nav .owner-suite-box.open {
            background: rgba(244, 67, 54, 0.14) !important;
            border-color: rgba(244, 67, 54, 0.6) !important;
        }
        .mobile-nav .owner-suite-box .sub-menu {
            border-top: 1px solid rgba(244, 67, 54, 0.2) !important;
            margin-top: 6px !important;
        }

        .mobile-nav .support-suite-box {
            background: rgba(33, 150, 243, 0.08) !important;
            border: 1px solid rgba(33, 150, 243, 0.35) !important;
            border-radius: 10px !important;
            padding: 6px 12px !important;
            margin: 8px 0 !important;
            box-sizing: border-box !important;
        }
        .mobile-nav .support-suite-box > .collapsible-trigger {
            padding: 6px 0 !important;
        }
        .mobile-nav .support-suite-box.open {
            background: rgba(33, 150, 243, 0.14) !important;
            border-color: rgba(33, 150, 243, 0.6) !important;
        }
        .mobile-nav .support-suite-box .sub-menu {
            border-top: 1px solid rgba(33, 150, 243, 0.2) !important;
            margin-top: 6px !important;
        }

        /* Wishlist button micro-animations (applied to button, not whole card) */
        .wishlist-btn {
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.2s ease, border-color 0.2s ease !important;
        }
        .wishlist-btn:hover {
            transform: scale(1.04) !important;
            box-shadow: 0 4px 15px rgba(255, 215, 0, 0.25) !important;
        }
        .wishlist-btn.is-whitelisted:hover {
            box-shadow: 0 4px 15px rgba(229, 57, 53, 0.3) !important;
        }
        .wishlist-btn:active {
            transform: scale(0.96) !important;
        }
    </style>
</head>
<body>
    <% if (typeof isOfficialDeployment !== 'undefined' && !isOfficialDeployment && !isCrawler) { %>
        <% const isTestEnv = (typeof isTestDeployment !== 'undefined' && isTestDeployment); %>
        <div class="deployment-notice <%= isTestEnv ? 'test-deployment' : 'unofficial-deployment' %>" role="status">
            <strong><%= isTestEnv ? 'Test or Local Deployment' : 'Unofficial deployment' %></strong>
            <span><%= isTestEnv ? 'This copy is running in a local test development environment.' : 'This copy is not the official GPL Mods website.' %></span>
            <% if (!isTestEnv) { %>
                <a href="<%= officialSiteUrl %>">Visit the official site</a>
            <% } %>
        </div>
        <style>
            .deployment-notice { position: relative; z-index: 9999; display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; justify-content: center; padding: 8px 16px; color: #fff; font: 600 .88rem/1.4 monospace; text-align: center; }
            .deployment-notice.test-deployment { background: #1e3a5f; border-bottom: 2px solid #2b6cb0; }
            .deployment-notice.test-deployment span { color: #dbeafe; font-weight: 400; }
            .deployment-notice.unofficial-deployment { background: #a51d2d; border-bottom: 2px solid #e01b24; }
            .deployment-notice.unofficial-deployment span { color: #ffe8e8; font-weight: 400; }
            .deployment-notice.unofficial-deployment a { color: #ffe066; text-decoration: underline; }
        </style>
    <% } %>

    <header class="main-header">
        <div class="container header-content">
            
            <!-- Grid Area: Logo -->
            <a href="<%- (typeof is2FAVerification !== 'undefined' && is2FAVerification) ? '#' : (user ? '/home' : '/') %>" class="logo" <%- (typeof is2FAVerification !== 'undefined' && is2FAVerification) ? 'style="pointer-events: none;"' : '' %>><span class="logo-gold-glow">GPL</span> <span class="logo-silver-glow">Mods</span></a>
            
            <% if (typeof is2FAVerification === 'undefined' || !is2FAVerification) { %>
            <!-- Grid Area: Search Bar -->
            <div class="search-bar" id="animatedSearchBar">
                <form action="/search" method="GET" class="search-form">
                    <!-- Custom SVG Icon -->
