            <div style="width: 60px; height: 60px; margin: 0 auto 16px; border-radius: 50%; background: rgba(246, 173, 85, 0.12); border: 1px solid rgba(246, 173, 85, 0.35); display: flex; align-items: center; justify-content: center; color: #f6ad55; font-size: 1.6rem; box-shadow: 0 0 20px rgba(246, 173, 85, 0.25);">
