        <!-- ======== CDN CIRCUIT BREAKER SCRIPT ======== -->
    <script>
        function triggerCdnFallback() {
            // 1. Set the cookie to expire in exactly 12 hours (43200 seconds)
            // This tells the backend to stop sending CDN URLs for the next 12 hours.
            document.cookie = "cdn_down=true; max-age=43200; path=/";
            console.warn("CDN Failure Detected! Switched to Local Server for the next 12 hours.");
            
            // 2. Fix the assets currently on this page that have already failed
            const fixPageAssets = () => {
                const cdnUrl = "<%= rawCdnUrl %>";
                if (!cdnUrl) return; // If no CDN was configured, do nothing
                
                // Find all Lottie players, images, and audio tags
                const elements = document.querySelectorAll('lottie-player, img, audio, source');
                
                elements.forEach(el => {
                    const src = el.getAttribute('src');
                    // If the source contains the broken CDN URL, strip it out so it loads locally
                    if (src && src.startsWith(cdnUrl)) {
                        el.setAttribute('src', src.replace(cdnUrl, ''));
                    }
                });
            };

            // Run immediately for elements already loaded
            fixPageAssets();
            
            // Run again when the whole page finishes loading to catch everything at the bottom
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', fixPageAssets);
            }
        }

        // ======== DYNAMIC NAVIGATION HISTORY & SMART GO BACK CONTROLLER ========
        (function() {
            const STORAGE_KEY = 'gpl_nav_history';
            const GOING_BACK_KEY = 'gpl_nav_going_back';
            const MAX_STACK = 50;

            function getHistoryStack() {
                try {
                    const raw = sessionStorage.getItem(STORAGE_KEY);
                    const parsed = JSON.parse(raw || '[]');
                    return Array.isArray(parsed) ? parsed : [];
                } catch (e) {
                    return [];
                }
            }

            function saveHistoryStack(stack) {
                try {
                    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(stack.slice(-MAX_STACK)));
                } catch (e) {}
            }

            function getRelativePath(urlStr) {
                try {
                    const u = new URL(urlStr || window.location.href, window.location.origin);
                    return u.pathname + u.search;
                } catch(e) {
                    return window.location.pathname + window.location.search;
                }
            }

            const currentPath = getRelativePath();

            // Paths that must never be in back history (auth actions / API / external redirects)
            const ignoredPrefixes = [
                '/logout', '/login/2fa', '/api/', '/leave', '/admin-auth', '/download-file/', '/cdn-cgi/'
            ];
            const isIgnored = ignoredPrefixes.some(prefix => currentPath.startsWith(prefix));

            if (!isIgnored) {
                let stack = getHistoryStack();
                const isGoingBack = sessionStorage.getItem(GOING_BACK_KEY) === 'true';

                if (isGoingBack) {
                    // Arrived via Go Back button: clear flag and truncate forward history
                    sessionStorage.removeItem(GOING_BACK_KEY);
                    const existingIdx = stack.lastIndexOf(currentPath);
                    if (existingIdx !== -1) {
                        stack = stack.slice(0, existingIdx + 1);
                    } else {
                        stack.push(currentPath);
                    }
                } else {
                    // Normal forward navigation or refresh:
                    // "doing /settings in settings page will do nothing" ->
                    // If user reloads or navigates to the same page, do not push duplicate!
                    const lastEntry = stack.length > 0 ? stack[stack.length - 1] : null;
                    if (lastEntry !== currentPath) {
                        stack.push(currentPath);
                    }
                }
                saveHistoryStack(stack);
            }

            // Sync with browser native back button
            window.addEventListener('popstate', function() {
                try {
                    sessionStorage.setItem(GOING_BACK_KEY, 'true');
                } catch(e) {}
            });

            // Smart Go Back function:
            // Searches history backwards for the first valid prior page on the site.
            // If none exists (e.g., user directly opened /settings), routes to fallbackUrl!
            window.smartGoBack = function(fallbackUrl) {
                const fallback = (fallbackUrl && typeof fallbackUrl === 'string' && fallbackUrl.trim()) ? fallbackUrl.trim() : '/';
                const curPath = getRelativePath();
                let stack = getHistoryStack();

                // 1. Pop any trailing entries matching the current page
                while (stack.length > 0 && stack[stack.length - 1] === curPath) {
                    stack.pop();
                }

                // 2. Find the previous valid internal URL
                let destination = null;
                const trapPrefixes = ['/login', '/register', '/logout', '/login/2fa', '/leave'];

                while (stack.length > 0) {
                    const candidate = stack.pop();
                    if (!candidate) continue;

                    const isTrap = trapPrefixes.some(prefix => candidate.startsWith(prefix));
                    if (!isTrap && candidate !== curPath) {
                        destination = candidate;
                        break;
                    }
                }

                if (destination) {
                    // Keep destination on top so history remains intact
                    stack.push(destination);
                    saveHistoryStack(stack);
                    try {
                        sessionStorage.setItem(GOING_BACK_KEY, 'true');
                    } catch(e) {}

                    window.location.href = destination;
                } else {
                    // 3. Fallback connection:
                    // If stack is empty (e.g. user directly opened /settings), redirect to fallback
                    // (e.g. for /settings -> fallback is /dashboard!)
                    saveHistoryStack([fallback]);
                    window.location.href = fallback;
                }
            };

            // Global delegation listener for any back button clicks
            document.addEventListener('click', function(e) {
                const target = e.target.closest('a[href*="history.back"], .dynamic-back-btn, .btn-go-back, [data-go-back], [data-fallback]');
                if (target) {
                    e.preventDefault();
                    e.stopPropagation();
                    const fallbackAttr = target.getAttribute('data-fallback');
                    window.smartGoBack(fallbackAttr || '/');
                }
            }, true);
        })();
    </script>
