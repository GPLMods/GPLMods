            <h2>Debugger Access Restricted</h2>
            <p>
                Developer tools inspection has been detected. Enter your <strong>10–12 digit access code</strong> or <strong>Master Key</strong> to unlock developer mode.
            </p>
            <div class="gpl-debugger-input-wrap">
                <input type="text" id="debuggerAccessCodeInput" class="gpl-debugger-input" placeholder="Enter Access Code / Master Key" autocomplete="off" maxlength="25">
            </div>
            <div id="debuggerModalError" class="gpl-debugger-error"></div>
            <div class="gpl-debugger-actions">
                <button type="button" class="btn-debugger-back" onclick="handleDebuggerExit()">
                    <i class="fas fa-arrow-left"></i> Leave Page
                </button>
                <button type="button" class="btn-debugger-verify" id="btnSubmitDebuggerCode" onclick="submitDebuggerCode()">
                    <i class="fas fa-key"></i> Unlock Debugger
                </button>
            </div>
        </div>
    </div>

    <!-- CDN for DisableDevtool -->
    <script src="https://cdn.jsdelivr.net/npm/disable-devtool"></script>
    <script>
        (function() {
            if (sessionStorage.getItem('gpl_devtool_authorized') === 'true') {
                return;
            }

            var currentLogId = null;
            var isModalOpen = false;

            function clearBrowserConsole() {
                try {
                    console.clear();
                } catch(e) {}
            }

            function triggerDevtoolBlock(triggerType) {
                if (sessionStorage.getItem('gpl_devtool_authorized') === 'true') {
                    return;
                }

                clearBrowserConsole();

                var modal = document.getElementById('debuggerAccessModal');
                if (modal && !isModalOpen) {
                    isModalOpen = true;
                    modal.classList.add('show');
                    var input = document.getElementById('debuggerAccessCodeInput');
                    if (input) {
                        input.value = '';
                        setTimeout(function() { input.focus(); }, 100);
                    }
                }

                if (!currentLogId) {
                    fetch('/api/devtool/log', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            triggerType: triggerType || 'devtools-opened',
                            url: window.location.href,
                            screenDetails: {
                                width: window.screen ? window.screen.width : null,
                                height: window.screen ? window.screen.height : null,
                                innerWidth: window.innerWidth,
                                innerHeight: window.innerHeight
                            }
                        })
                    }).then(function(r) { return r.json(); }).then(function(data) {
                        if (data && data.logId) {
                            currentLogId = data.logId;
                        }
                    }).catch(function() {});
                }
            }

            window.handleDebuggerExit = function() {
                window.smartGoBack('/');
            };

            window.submitDebuggerCode = async function() {
                var input = document.getElementById('debuggerAccessCodeInput');
                var errEl = document.getElementById('debuggerModalError');
                var btn = document.getElementById('btnSubmitDebuggerCode');
                var code = (input.value || '').trim();

                if (!code) {
                    errEl.textContent = 'Please enter an access code or master key.';
                    errEl.style.display = 'block';
                    input.focus();
                    return;
                }

                errEl.style.display = 'none';
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Verifying...';

                try {
                    var res = await fetch('/api/devtool/verify-key', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ code: code, logId: currentLogId })
                    });
                    var data = await res.json();

                    if (data && data.success) {
                        sessionStorage.setItem('gpl_devtool_authorized', 'true');
                        clearBrowserConsole();

                        var modal = document.getElementById('debuggerAccessModal');
                        if (modal) {
                            modal.classList.remove('show');
                        }
                        isModalOpen = false;

                        if (window.DisableDevtool && typeof window.DisableDevtool.stop === 'function') {
                            window.DisableDevtool.stop();
                        }
                    } else {
                        clearBrowserConsole();
                        errEl.textContent = (data && data.message) ? data.message : 'Invalid 10–12 digit code or master key. Attempt logged.';
                        errEl.style.display = 'block';
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-key"></i> Unlock Debugger';
                        input.value = '';
                        input.focus();
                    }
                } catch (e) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-key"></i> Unlock Debugger';
                    errEl.textContent = 'Connection error. Please retry.';
                    errEl.style.display = 'block';
                }
            };

            document.addEventListener('keydown', function(e) {
                if (isModalOpen && e.key === 'Enter') {
                    submitDebuggerCode();
                }
            });

            function initProtection() {
                if (sessionStorage.getItem('gpl_devtool_authorized') === 'true') {
                    return;
                }

                if (window.DisableDevtool) {
                    try {
                        window.DisableDevtool({
                            ondevtoolopen: function(type) {
                                triggerDevtoolBlock(type);
                            },
                            disableMenu: false,
                            disableCopy: false,
                            disableSelect: false,
                            interval: 350
                        });
                    } catch (e) {
                        console.error("Devtool security init:", e);
                    }
                }

                window.addEventListener('keydown', function(e) {
                    if (sessionStorage.getItem('gpl_devtool_authorized') === 'true') return;
                    if (
                        e.key === 'F12' ||
                        (e.ctrlKey && e.shiftKey && (e.key === 'I' || e.key === 'i' || e.key === 'J' || e.key === 'j' || e.key === 'C' || e.key === 'c')) ||
                        (e.metaKey && e.altKey && (e.key === 'I' || e.key === 'i' || e.key === 'J' || e.key === 'j' || e.key === 'C' || e.key === 'c')) ||
                        (e.ctrlKey && (e.key === 'U' || e.key === 'u'))
                    ) {
                        e.preventDefault();
                        triggerDevtoolBlock('keyboard-shortcut');
                    }
                }, true);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initProtection);
            } else {
                initProtection();
            }
        })();
    </script>
