        <div class="gpl-action-modal-card" style="background: linear-gradient(145deg, #1c1810 0%, #0d0e12 100%); border: 1px solid rgba(246, 173, 85, 0.35); box-shadow: 0 24px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(246, 173, 85, 0.2); border-radius: 18px; padding: 30px 24px; max-width: 420px; width: 90%; text-align: center; transform: scale(0.95); transition: transform 0.25s ease;">
            <div style="width: 60px; height: 60px; margin: 0 auto 16px; border-radius: 50%; background: rgba(246, 173, 85, 0.12); border: 1px solid rgba(246, 173, 85, 0.35); display: flex; align-items: center; justify-content: center; color: #f6ad55; font-size: 1.6rem; box-shadow: 0 0 20px rgba(246, 173, 85, 0.25);">
                <i class="fas fa-broom"></i>
            </div>
            <h3 style="color: #fff; font-size: 1.35rem; font-weight: 700; margin: 0 0 10px; letter-spacing: -0.01em;">Purge Web Cache</h3>
            <p style="color: #a0aec0; font-size: 0.95rem; line-height: 1.5; margin: 0 0 24px;">
                Clear cached scripts, stylesheets, and local device assets? This refreshes your browser state without affecting your saved session or account data.
            </p>
            <div id="globalCcStatus" style="display: none; margin-bottom: 15px; font-size: 0.88rem; font-weight: 600; color: #f6ad55;"></div>
            <div style="display: flex; gap: 12px; justify-content: center;">
                <button type="button" class="btn-cancel-cc" style="flex: 1; padding: 12px 18px; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); color: #e2e8f0; border-radius: 10px; font-weight: 600; font-size: 0.95rem; cursor: pointer; transition: all 0.2s ease;">
                    Cancel
                </button>
                <button type="button" id="confirmCcBtn" style="flex: 1; padding: 12px 18px; background: linear-gradient(135deg, #d97706 0%, #b45309 100%); border: 1px solid rgba(255, 255, 255, 0.2); color: #fff; border-radius: 10px; font-weight: 600; font-size: 0.95rem; display: inline-flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 6px 18px rgba(217, 119, 6, 0.4); cursor: pointer;">
                    <i class="fas fa-broom"></i> Purge Now
                </button>
            </div>
        </div>
    </div>

    <script>
        (function() {
            function initActionModals() {
                var logoutModal = document.getElementById('globalLogoutModal');
                var ccModal = document.getElementById('globalCcModal');

                function openModal(modal) {
                    if (!modal) return;
                    modal.style.display = 'flex';
                    requestAnimationFrame(function() {
                        modal.style.opacity = '1';
                        var card = modal.querySelector('.gpl-action-modal-card');
                        if (card) card.style.transform = 'scale(1)';
                    });
                }

                function closeModal(modal) {
                    if (!modal) return;
                    modal.style.opacity = '0';
                    var card = modal.querySelector('.gpl-action-modal-card');
                    if (card) card.style.transform = 'scale(0.95)';
                    setTimeout(function() {
                        modal.style.display = 'none';
                    }, 250);
                }

                async function executeGlobalCacheClear() {
                    var btn = document.getElementById('confirmCcBtn');
                    var cancelBtn = ccModal ? ccModal.querySelector('.btn-cancel-cc') : null;
                    var statusEl = document.getElementById('globalCcStatus');

                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Cleaning Cache...';
                    }
                    if (cancelBtn) cancelBtn.disabled = true;
                    if (statusEl) {
                        statusEl.style.display = 'block';
                        statusEl.style.color = '#f6ad55';
                        statusEl.textContent = 'Clearing Service Workers & Browser Cache...';
                    }

                    try {
                        // 1. Unregister Service Workers
                        if ('serviceWorker' in navigator) {
                            var registrations = await navigator.serviceWorker.getRegistrations();
                            for (var i = 0; i < registrations.length; i++) {
                                await registrations[i].unregister();
                            }
                        }

                        // 2. Clear Cache Storage
                        if ('caches' in window) {
                            var keys = await caches.keys();
                            await Promise.all(keys.map(function(k) { return caches.delete(k); }));
                        }

                        // 3. Clear temporary storage
                        try { localStorage.clear(); } catch(e){}
                        try { sessionStorage.clear(); } catch(e){}

                        // 4. Trigger server-side header clear
                        try {
                            await fetch('/cc', { cache: 'reload' });
                        } catch(e) {}

                        if (statusEl) {
                            statusEl.style.color = '#4caf50';
                            statusEl.textContent = '✔ All caches cleared! Reloading fresh...';
                        }
                        if (btn) {
                            btn.innerHTML = '<i class="fas fa-check"></i> Reloading...';
                        }
                    } catch(err) {
                        console.error('Cache clear error:', err);
                        if (statusEl) {
                            statusEl.style.color = '#ff5252';
                            statusEl.textContent = 'Reloading fresh...';
                        }
                    } finally {
                        setTimeout(function() {
                            var currentPath = window.location.pathname;
                            var currentSearch = window.location.search || '';
                            var sep = currentSearch.indexOf('?') !== -1 ? '&' : '?';
                            window.location.replace(currentPath + currentSearch + sep + '_cc=' + Date.now() + '&cache_cleared=1');
                        }, 500);
                    }
                }

                document.addEventListener('click', function(e) {
                    var logoutTarget = e.target.closest('a[href="/logout"]');
                    if (logoutTarget && logoutTarget.id !== 'confirmLogoutBtn') {
                        e.preventDefault();
                        e.stopPropagation();
                        openModal(logoutModal);
                        return;
                    }

                    var ccTarget = e.target.closest('a[href="/cc"]');
                    if (ccTarget && ccTarget.id !== 'confirmCcBtn') {
                        e.preventDefault();
                        e.stopPropagation();
                        openModal(ccModal);
                        return;
                    }

                    var confirmCcTarget = e.target.closest('#confirmCcBtn');
                    if (confirmCcTarget) {
                        e.preventDefault();
                        e.stopPropagation();
                        executeGlobalCacheClear();
                        return;
                    }

                    if (e.target.closest('.btn-cancel-logout')) {
                        closeModal(logoutModal);
                        return;
                    }

                    if (e.target.closest('.btn-cancel-cc')) {
                        closeModal(ccModal);
                        return;
                    }

                    if (e.target === logoutModal) {
                        closeModal(logoutModal);
                        return;
                    }

                    if (e.target === ccModal) {
                        closeModal(ccModal);
                        return;
                    }
                }, true);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initActionModals);
            } else {
                initActionModals();
            }
        })();
    </script>

