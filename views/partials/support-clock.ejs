</style>

<script>
    (function initIstClockWidget() {
        const STORAGE_KEY = 'gpl_ist_clock_24h';
        let is24Hour = localStorage.getItem(STORAGE_KEY) === 'true';

        window.toggleIstClockFormat = function () {
            is24Hour = !is24Hour;
            try {
                localStorage.setItem(STORAGE_KEY, String(is24Hour));
            } catch (e) { }
            updateIstClock();
        };

        function updateIstClock() {
            try {
                const now = new Date();
                // Get IST Date string via Intl
                const istTimeStr = now.toLocaleTimeString('en-US', {
                    timeZone: 'Asia/Kolkata',
                    hour12: !is24Hour,
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                });

                const digitsEl = document.getElementById('istDigits');
                const ampmEl = document.getElementById('istAmPm');
                const dateEl = document.getElementById('istDateText');
                const opt12 = document.getElementById('istOpt12');
                const opt24 = document.getElementById('istOpt24');

                if (opt12 && opt24) {
                    opt12.classList.toggle('active', !is24Hour);
                    opt24.classList.toggle('active', is24Hour);
                }

                if (is24Hour) {
                    if (digitsEl) digitsEl.textContent = istTimeStr;
                    if (ampmEl) ampmEl.textContent = '';
                } else {
                    const parts = istTimeStr.split(' ');
                    if (digitsEl) digitsEl.textContent = parts[0] || istTimeStr;
                    if (ampmEl) ampmEl.textContent = parts[1] || '';
                }

                // Date string
                const istDateStr = now.toLocaleDateString('en-US', {
                    timeZone: 'Asia/Kolkata',
                    weekday: 'long',
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });
                if (dateEl) dateEl.textContent = istDateStr;

                // Support Status check in IST
                // Monday = 1, Friday = 5
                // Shifts: 08:00 to 10:00 AND 18:00 to 22:00
                const istDateObj = new Date(now.toLocaleString('en-US', { timeZone: 'Asia/Kolkata' }));
                const day = istDateObj.getDay(); // 0 = Sun, 1 = Mon, ..., 6 = Sat
                const hour = istDateObj.getHours();
                const minute = istDateObj.getMinutes();
                const totalMinutes = hour * 60 + minute;

                const isWeekday = day >= 1 && day <= 5;
                const inMorningShift = totalMinutes >= (8 * 60) && totalMinutes < (10 * 60);
                const inEveningShift = totalMinutes >= (18 * 60) && totalMinutes < (22 * 60);

                const isOpen = isWeekday && (inMorningShift || inEveningShift);

                const statusPill = document.getElementById('istLiveStatusPill');
                const statusText = document.getElementById('istStatusText');

                if (statusPill && statusText) {
                    if (isOpen) {
                        statusPill.className = 'ist-live-status-pill online';
                        statusText.textContent = 'Live Support Desk is Active (Agents Online)';
                    } else {
                        statusPill.className = 'ist-live-status-pill offline';
                        let nextMsg = 'Desk Closed';
                        if (!isWeekday) {
                            nextMsg += ' &bull; Resumes Monday 8:00 AM IST';
                        } else if (totalMinutes < (8 * 60)) {
                            nextMsg += ' &bull; Opens Today at 8:00 AM IST';
                        } else if (totalMinutes < (18 * 60)) {
                            nextMsg += ' &bull; Opens Today at 6:00 PM IST';
                        } else {
                            nextMsg += ' &bull; Resumes Tomorrow at 8:00 AM IST';
                        }
                        statusText.innerHTML = nextMsg;
                    }
                }
            } catch (err) {
                console.warn('IST clock tick error:', err);
            }
        }

        // Run immediately, then interval
        updateIstClock();
        setInterval(updateIstClock, 1000);
    })();
</script>
