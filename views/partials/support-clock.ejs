<!-- =================================================================== -->
<!-- GPL MODS - INDIAN STANDARD TIME (IST) DIGITAL CLOCK & SUPPORT WIDGET -->
<!-- =================================================================== -->
<div class="ist-support-widget" id="istSupportClockWidget">
    <div class="ist-widget-header">
        <div class="ist-widget-badge">
            <i class="fas fa-globe-asia" style="color: var(--gold);"></i>
            <span>Indian Standard Time (IST &bull; GMT+5:30)</span>
        </div>
        <div class="ist-format-toggle-wrap">
            <span class="ist-format-label">Format:</span>
            <button type="button" class="ist-format-btn" id="istFormatToggleBtn" onclick="toggleIstClockFormat()" aria-label="Toggle 12h and 24h format">
                <span class="ist-format-opt opt-12 active" id="istOpt12">12H</span>
                <span class="ist-format-divider">/</span>
                <span class="ist-format-opt opt-24" id="istOpt24">24H</span>
            </button>
        </div>
    </div>

    <!-- Clock Display Card -->
    <div class="ist-clock-card">
        <div class="ist-clock-display" id="istClockDisplay">
            <span class="ist-digits" id="istDigits">--:--:--</span>
            <span class="ist-ampm" id="istAmPm"></span>
        </div>
        <div class="ist-date-display" id="istDateDisplay">
            <i class="far fa-calendar-alt"></i> <span id="istDateText">Loading current date...</span>
        </div>
        <div class="ist-live-status-pill" id="istLiveStatusPill">
            <span class="ist-pulse-dot" id="istStatusDot"></span>
            <span class="ist-status-text" id="istStatusText">Calculating Support Status...</span>
        </div>
    </div>

    <!-- Contact & Operating Hours Details -->
    <div class="ist-support-details">
        <div class="ist-channels-grid">
            <div class="ist-channel-item">
                <div class="ist-channel-icon"><i class="fas fa-copyright"></i></div>
                <div class="ist-channel-content">
                    <span class="ist-channel-title">DMCA & Copyright Notices</span>
                    <a href="mailto:dmca@gplmods.webredirect.org" class="ist-channel-email">dmca@gplmods.webredirect.org</a>
                </div>
            </div>
            <div class="ist-channel-item">
                <div class="ist-channel-icon"><i class="fas fa-shield-alt"></i></div>
                <div class="ist-channel-content">
                    <span class="ist-channel-title">Privacy & Legal Inquiries</span>
                    <a href="mailto:support@gplmods.webredirect.org" class="ist-channel-email">support@gplmods.webredirect.org</a>
                </div>
            </div>
            <div class="ist-channel-item">
                <div class="ist-channel-icon"><i class="fas fa-life-ring"></i></div>
                <div class="ist-channel-content">
                    <span class="ist-channel-title">General Help & Community</span>
                    <a href="mailto:help@gplmods.webredirect.org" class="ist-channel-email">help@gplmods.webredirect.org</a>
                </div>
            </div>
        </div>

        <div class="ist-hours-block">
            <div class="ist-hours-header">
                <i class="fas fa-business-time" style="color: var(--gold);"></i>
                <strong>Support Operating Hours</strong>
                <span class="ist-tz-pill">(Timezone: GMT+5:30 / IST)</span>
            </div>
            <div class="ist-schedule-grid">
                <div class="ist-schedule-row">
                    <span class="ist-schedule-day"><i class="fas fa-calendar-week"></i> Monday to Friday</span>
                    <div class="ist-schedule-shifts">
                        <span class="ist-shift"><i class="fas fa-sun"></i> <strong>Morning:</strong> 8:00 AM to 10:00 AM</span>
                        <span class="ist-shift"><i class="fas fa-moon"></i> <strong>Evening:</strong> 6:00 PM to 10:00 PM</span>
                    </div>
                </div>
                <div class="ist-schedule-row weekend-row">
                    <span class="ist-schedule-day"><i class="fas fa-bed"></i> Saturday & Sunday</span>
                    <span class="ist-shift closed"><i class="fas fa-times-circle"></i> Closed (Self-service & Community FAQs active)</span>
                </div>
            </div>
        </div>
    </div>
</div>

