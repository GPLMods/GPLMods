<%- include('../partials/header') %>

<style>
    .sponsor-hero {
        text-align: center;
        padding: 50px 20px 40px 20px;
        background: linear-gradient(180deg, rgba(255, 215, 0, 0.08) 0%, transparent 100%);
        border-bottom: 1px solid #222;
        margin-bottom: 40px;
    }
    .sponsor-badge-top {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 51, 102, 0.12);
        color: #ff3366;
        border: 1px solid rgba(255, 51, 102, 0.3);
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.85em;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 15px;
    }
    .sponsor-hero h1 {
        font-size: clamp(1.65rem, 4vw + 0.5rem, 2.75rem);
        color: var(--white);
        margin-bottom: 12px;
        word-break: normal;
        overflow-wrap: break-word;
        line-height: 1.25;
        letter-spacing: -0.5px;
    }
    .sponsor-hero h1 span {
        color: var(--gold);
        text-shadow: 0 0 15px var(--glow-gold);
    }
    .sponsor-hero p {
        color: var(--silver);
        max-width: 720px;
        margin: 0 auto 25px auto;
        font-size: clamp(0.95em, 2vw, 1.1em);
        line-height: 1.6;
        word-break: normal;
        overflow-wrap: break-word;
    }

    /* Category Filter Pills */
    .catalog-filter-bar {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        padding-bottom: 12px;
        margin-bottom: 35px;
        scrollbar-width: thin;
    }
    .catalog-filter-btn {
        background: var(--dark-gray);
        color: var(--silver);
        border: 1px solid #333;
        padding: 10px 20px;
        border-radius: 25px;
        cursor: pointer;
        font-size: 0.9em;
        font-weight: 600;
        white-space: nowrap;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .catalog-filter-btn:hover {
        color: var(--white);
        border-color: var(--gold);
    }
    .catalog-filter-btn.active {
        background: var(--gold);
        color: var(--black);
        border-color: var(--gold);
        box-shadow: 0 0 15px var(--glow-gold);
    }

    /* Food & Coffee Section */
    .coffee-section {
        background: rgba(18, 18, 22, 0.9);
        border: 1px solid rgba(255, 215, 0, 0.3);
        border-radius: 18px;
        padding: 35px;
        margin-bottom: 50px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    }
    .coffee-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
        margin-top: 25px;
    }
    .coffee-card {
        background: var(--dark-gray);
        border: 1px solid #333;
        border-radius: 14px;
        padding: 24px 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .coffee-card:hover {
        transform: translateY(-5px);
        border-color: var(--gold);
        box-shadow: 0 10px 25px rgba(255, 215, 0, 0.15);
    }
    .coffee-icon-box {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        background: rgba(255, 215, 0, 0.1);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8em;
        margin-bottom: 15px;
    }
    .coffee-price {
        font-size: 1.6em;
        font-weight: 800;
        color: var(--white);
        margin: 8px 0;
    }
    .coffee-price span {
        color: var(--gold);
    }

    /* Infrastructure Catalog Upgraded Cards & Toolbar */
    .catalog-toolbar-wrapper {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-bottom: 25px;
    }
    .catalog-search-bar {
        position: relative;
        width: 100%;
    }
    .catalog-search-input {
        width: 100%;
        background: rgba(18, 20, 26, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: var(--white);
        padding: 12px 18px 12px 42px;
        border-radius: 30px;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.25s ease;
        box-sizing: border-box;
    }
    .catalog-search-input:focus {
        border-color: var(--gold);
        box-shadow: 0 0 15px rgba(255, 215, 0, 0.25);
    }
    .catalog-search-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--silver);
        font-size: 1rem;
        pointer-events: none;
    }
    .catalog-filter-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }
    .catalog-cycle-group {
        display: inline-flex;
        gap: 6px;
        flex-wrap: wrap;
        background: rgba(18, 20, 26, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 25px;
        padding: 4px;
    }
    .catalog-cycle-btn {
        background: transparent;
        border: none;
        color: var(--silver);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .catalog-cycle-btn:hover {
        color: var(--white);
    }
    .catalog-cycle-btn.active {
        background: var(--gold);
        color: var(--black);
        font-weight: 700;
        box-shadow: 0 0 10px rgba(255, 215, 0, 0.4);
    }
    .filter-count {
        font-size: 0.78em;
        opacity: 0.75;
        margin-left: 4px;
    }

    .catalog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
        gap: 22px;
        margin-bottom: 50px;
    }
    .catalog-item-card {
        background: rgba(18, 20, 26, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        transition: all 0.25s ease;
        position: relative;
        backdrop-filter: blur(8px);
        box-sizing: border-box;
    }
    .catalog-item-card:hover {
        transform: translateY(-5px);
        border-color: var(--gold);
        box-shadow: 0 14px 35px rgba(0,0,0,0.55);
    }
    .item-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 12px;
        gap: 10px;
    }
    .item-icon-pill {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3em;
        flex-shrink: 0;
    }
    .item-badges-wrapper {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }
    .period-badge {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 4px 10px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.08);
        color: var(--silver);
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .plan-tag-badge {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 12px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .item-title {
        color: var(--white);
        font-size: 1.22rem;
        margin-bottom: 4px;
        font-weight: 700;
        line-height: 1.3;
    }
    .item-plan-name {
        color: #aaa;
        font-size: 0.85rem;
        margin-bottom: 12px;
        font-weight: 500;
    }
    .item-limit-box {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 215, 0, 0.08);
        border: 1px solid rgba(255, 215, 0, 0.22);
        color: var(--gold);
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 700;
        margin-bottom: 14px;
        width: fit-content;
    }
    .item-pricing-container {
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 14px;
    }
    .item-primary-price {
        font-size: 1.18rem;
        font-weight: 800;
        color: var(--white);
        margin-bottom: 4px;
        display: flex;
        align-items: baseline;
        gap: 6px;
        flex-wrap: wrap;
    }
    .item-cur-convert {
        font-size: 0.78rem;
        color: var(--silver);
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .item-price-val {
        font-weight: 700;
        color: var(--gold);
    }
    .item-breakdown-box {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        padding: 10px 12px;
        margin-bottom: 14px;
        font-size: 0.82rem;
    }
    .breakdown-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 3px 0;
        color: var(--silver);
        gap: 10px;
    }
    .breakdown-row.breakdown-total {
        border-top: 1px dashed rgba(255, 255, 255, 0.15);
        margin-top: 5px;
        padding-top: 6px;
        font-weight: 700;
        color: var(--gold);
    }
    .item-desc {
        color: var(--silver);
        font-size: 0.88rem;
        line-height: 1.5;
        margin-bottom: 14px;
    }
    .catalog-features-list {
        list-style: none;
        padding: 0;
        margin: 0 0 20px 0;
        display: flex;
        flex-direction: column;
        gap: 7px;
        flex-grow: 1;
    }
    .catalog-features-list li {
        color: #d1d5db;
        font-size: 0.83rem;
        line-height: 1.4;
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }
    .catalog-features-list li i {
        color: #2ecc71;
        font-size: 0.88rem;
        margin-top: 2px;
        flex-shrink: 0;
    }
    .item-action-footer {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 15px;
        margin-top: auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }
    .sponsor-secure-tag {
        font-size: 0.75rem;
        color: #888;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .catalog-empty-notice {
        grid-column: 1 / -1;
        text-align: center;
        padding: 50px 20px;
        background: rgba(18, 20, 26, 0.5);
        border: 1px dashed #444;
        border-radius: 16px;
        color: var(--silver);
    }
    .sponsor-btn {
        background: var(--gold);
        color: var(--black);
        padding: 9px 20px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.9em;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 0 10px var(--glow-gold);
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .sponsor-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 0 18px var(--glow-gold);
    }

    /* Recent Sponsors Wall */
    .sponsors-wall {
        background: var(--dark-gray);
        border: 1px solid #333;
        border-radius: 18px;
        padding: 35px;
        margin-bottom: 50px;
    }
    .sponsor-entry {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        border-radius: 10px;
        background: #111;
        border: 1px solid #222;
        margin-bottom: 10px;
        flex-wrap: wrap;
        gap: 10px;
    }

    /* Checkout Modal */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.85);
        backdrop-filter: blur(5px);
        z-index: 99999;
        align-items: center;
        justify-content: center;
        padding: 16px;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        box-sizing: border-box;
    }
    .modal-card {
        background: var(--dark-gray);
        border: 1px solid var(--gold);
        border-radius: 16px;
        width: 100%;
        max-width: 520px;
        max-height: 90vh;
        max-height: 90dvh;
        overflow-y: auto;
        padding: 28px 24px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.6);
        position: relative;
        box-sizing: border-box;
    }
    .modal-close {
        position: absolute;
        top: 20px;
        right: 20px;
        background: none;
        border: none;
        color: var(--silver);
        font-size: 1.3em;
        cursor: pointer;
    }
    .modal-form-group {
        margin-bottom: 16px;
        text-align: left;
    }
    .modal-form-group label {
        display: block;
        color: var(--silver);
        font-size: 0.88em;
        font-weight: 600;
        margin-bottom: 6px;
    }
    .modal-form-group input, .modal-form-group textarea {
        width: 100%;
        padding: 12px 14px;
        background: var(--black);
        border: 1px solid #444;
        border-radius: 8px;
        color: var(--white);
        font-family: inherit;
        font-size: 0.95em;
        outline: none;
        transition: border-color 0.2s;
    }
    .modal-form-group input:focus, .modal-form-group textarea:focus {
        border-color: var(--gold);
    }
    .pay-btn {
        width: 100%;
        background: var(--gold);
        color: var(--black);
        padding: 14px;
        border-radius: 10px;
        border: none;
        font-size: 1.1em;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 0 15px var(--glow-gold);
        transition: all 0.2s ease;
        margin-top: 10px;
    }
    .pay-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 25px var(--glow-gold);
    }

    @media (max-width: 768px) {
        .sponsor-hero {
            padding: 35px 15px 25px 15px;
            margin-bottom: 25px;
        }
        .sponsor-hero h1 {
            font-size: 1.85rem;
        }
        .catalog-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }
        .coffee-grid {
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 12px;
        }
        .coffee-card {
            padding: 16px 12px;
        }
    }
    @media (max-width: 480px) {
        .sponsor-hero h1 {
            font-size: 1.55rem;
        }
        .modal-overlay {
            padding: 10px;
            align-items: flex-start;
        }
        .modal-card {
            padding: 20px 14px;
            max-height: 94vh;
            max-height: 94dvh;
            margin: auto 0;
            border-radius: 12px;
        }
        .modal-close {
            top: 14px;
            right: 14px;
        }
        .pay-btn {
            padding: 12px;
            font-size: 0.95rem;
        }
    }

    /* In-Page Currency Switcher Bar */
    .sponsor-currency-bar {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(18, 20, 26, 0.9);
        border: 1px solid rgba(255, 215, 0, 0.35);
        border-radius: 30px;
        padding: 6px 14px;
        margin: 22px auto 0 auto;
        box-shadow: 0 4px 15px rgba(0,0,0,0.4);
        max-width: 100%;
        flex-wrap: wrap;
        justify-content: center;
    }
    .currency-bar-label {
        font-size: 0.85em;
        font-weight: 700;
        color: var(--gold);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .currency-pill-group {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .cur-pill-btn {
        background: transparent;
        border: 1px solid transparent;
        color: var(--silver);
        padding: 4px 10px;
        border-radius: 20px;
        cursor: pointer;
        font-size: 0.8em;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.2s ease;
    }
    .cur-pill-btn:hover {
        color: var(--white);
        border-color: rgba(255, 215, 0, 0.4);
    }
    .cur-pill-btn.active {
        background: var(--gold);
        color: var(--black);
        font-weight: 700;
        box-shadow: 0 0 10px var(--glow-gold);
    }

    /* ======== 24H DAILY DONATION CAP METER ======== */
    .daily-cap-card {
        background: rgba(18, 18, 22, 0.85);
        border: 1px solid rgba(255, 215, 0, 0.25);
        border-radius: 14px;
        padding: 22px 25px;
        margin-bottom: 35px;
        text-align: left;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
        position: relative;
        overflow: hidden;
    }
    .daily-cap-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; height: 3px;
        background: linear-gradient(90deg, var(--gold), #2ecc71);
    }
    .daily-cap-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        flex-wrap: wrap;
        gap: 10px;
    }
    .cap-title-area {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .cap-icon-badge {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: rgba(255, 215, 0, 0.12);
        color: var(--gold);
        border: 1px solid rgba(255, 215, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
    .cap-card-title {
        color: var(--white);
        font-size: 1.15rem;
        font-weight: 700;
        margin: 0 0 3px 0;
    }
    .cap-rolling-note {
        color: #888;
        font-size: 0.82rem;
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .cap-status-pill {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .cap-status-ok {
        background: rgba(46, 204, 113, 0.15);
        color: #2ecc71;
        border: 1px solid rgba(46, 204, 113, 0.35);
    }
    .cap-status-limit {
        background: rgba(231, 76, 60, 0.15);
        color: #e74c3c;
        border: 1px solid rgba(231, 76, 60, 0.35);
    }
    .cap-meter-container {
        width: 100%;
        height: 10px;
        background: #252528;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 14px;
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.5);
    }
    .cap-meter-fill {
        height: 100%;
        background: linear-gradient(90deg, #2ecc71, var(--gold));
        border-radius: 10px;
        transition: width 0.5s ease;
        box-shadow: 0 0 10px rgba(46, 204, 113, 0.4);
    }
    .cap-stats-grid {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.95rem;
    }
    .cap-stat-box {
        display: flex;
        flex-direction: column;
    }
    .cap-stat-title {
        color: #999;
        font-size: 0.8rem;
        margin-bottom: 3px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .cap-stat-number {
        color: var(--gold);
        font-size: 1.35rem;
        font-weight: 800;
    }
    .cap-max-number {
        color: var(--silver);
        font-size: 1.05rem;
    }
    .cap-exhausted-banner {
        margin-top: 14px;
        background: rgba(231, 76, 60, 0.12);
        border: 1px solid rgba(231, 76, 60, 0.3);
        border-radius: 8px;
        padding: 12px 15px;
        color: #ff9999;
        font-size: 0.88rem;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        line-height: 1.5;
    }
    .cap-exhausted-banner i {
        color: #e74c3c;
        margin-top: 2px;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    /* Price Sorting Buttons */
    .catalog-sort-btn {
        background: var(--dark-gray);
        color: var(--silver);
        border: 1px solid #333;
        padding: 6px 14px;
        border-radius: 20px;
        cursor: pointer;
        font-size: 0.82rem;
        font-weight: 600;
        white-space: nowrap;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .catalog-sort-btn:hover {
        color: var(--white);
        border-color: var(--gold);
    }
    .catalog-sort-btn.active {
        background: rgba(255, 215, 0, 0.15);
        color: var(--gold);
        border-color: var(--gold);
        box-shadow: 0 0 10px rgba(255, 215, 0, 0.2);
    }

</style>

<main>
    <div class="sponsor-hero">
        <div class="container">
            <!-- ======== DYNAMIC GO BACK BUTTON ======== -->
            <%- include('../partials/go-back-button', { fallback: '/' }) %>
            <!-- ======================================== -->
            <div class="sponsor-badge-top">
                <i class="fas fa-heart"></i> Community Powered Platform
            </div>
            <h1>Sponsor <span>GPL Mods</span> Infrastructure</h1>
            <p>
                GPL Mods does not lock features behind paywalls or sell private data. We rely on open-source supporters like you to cover our monthly cloud servers, object storage, transactional email relays, AI model tokens, and dev sustenance.
            </p>
            <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
                <a href="#coffee-section" class="btn" style="background: var(--gold); color: var(--black); padding: 12px 26px; border-radius: 25px; font-weight: 700; text-decoration: none; box-shadow: 0 0 15px var(--glow-gold);">
                    <i class="fas fa-coffee" style="margin-right: 6px;"></i> Buy Food &amp; Coffee
                </a>
                <a href="#catalog-section" class="btn" style="background: transparent; color: var(--white); border: 2px solid #555; padding: 10px 24px; border-radius: 25px; font-weight: 700; text-decoration: none;">
                    <i class="fas fa-server" style="margin-right: 6px;"></i> Sponsor A Server Component
                </a>
            </div>

            <!-- Dedicated In-Page Currency Selector -->
            <div class="gpl-page-currency-bar">
                <span class="gpl-currency-bar-label"><i class="fas fa-coins"></i> Currency:</span>
                <div class="gpl-currency-pills">
                    <button type="button" class="cur-pill-btn active" data-cur="INR" onclick="setSponsorCurrency('INR')">
                        <span class="fi fi-in"></span> ₹ INR
                    </button>
                    <button type="button" class="cur-pill-btn" data-cur="USD" onclick="setSponsorCurrency('USD')">
                        <span class="fi fi-us"></span> $ USD
                    </button>
                    <button type="button" class="cur-pill-btn" data-cur="EUR" onclick="setSponsorCurrency('EUR')">
                        <span class="fi fi-eu"></span> € EUR
                    </button>
                    <button type="button" class="cur-pill-btn" data-cur="GBP" onclick="setSponsorCurrency('GBP')">
                        <span class="fi fi-gb"></span> £ GBP
                    </button>
                    <button type="button" class="cur-pill-btn" data-cur="AED" onclick="setSponsorCurrency('AED')">
                        <span class="fi fi-ae"></span> د.إ AED
                    </button>
                    <button type="button" class="cur-pill-btn" data-cur="CAD" onclick="setSponsorCurrency('CAD')">
                        <span class="fi fi-ca"></span> CA$ CAD
                    </button>
                    <button type="button" class="cur-pill-btn" data-cur="AUD" onclick="setSponsorCurrency('AUD')">
                        <span class="fi fi-au"></span> AU$ AUD
                    </button>
                    <button type="button" class="cur-pill-btn" data-cur="JPY" onclick="setSponsorCurrency('JPY')">
                        <span class="fi fi-jp"></span> ¥ JPY
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <!-- ======== 24H DAILY DONATION CAP METER (₹100,000 CAP) ======== -->
        <% 
            const capData = (typeof dailyCapStatus !== 'undefined' && dailyCapStatus) ? dailyCapStatus : { totalSpentInr: 0, remainingInr: 100000, totalCapInr: 100000 };
            const spentPercent = Math.min(100, Math.max(0, (capData.totalSpentInr / capData.totalCapInr) * 100));
            const isCapExhausted = capData.remainingInr <= 0;
        %>
        <div class="daily-cap-card">
            <div class="daily-cap-header">
                <div class="cap-title-area">
                    <span class="cap-icon-badge"><i class="fas fa-hand-holding-heart"></i></span>
                    <div>
                        <h3 class="cap-card-title">24-Hour Sponsorship &amp; Donation Cap</h3>
                        <span class="cap-rolling-note"><i class="fas fa-history"></i> Max ₹1,00,000 / day &bull; Resets rolling 24 hours</span>
                    </div>
                </div>
                <div>
                    <span class="cap-status-pill <%= isCapExhausted ? 'cap-status-limit' : 'cap-status-ok' %>">
                        <%= isCapExhausted ? 'Daily Limit Reached' : 'Allowance Available' %>
                    </span>
                </div>
            </div>

            <!-- Progress Meter -->
            <div class="cap-meter-container">
                <div class="cap-meter-fill" style="width: <%= Math.max(2, 100 - spentPercent) %>%;"></div>
            </div>

            <div class="cap-stats-grid">
                <div class="cap-stat-box">
                    <span class="cap-stat-title">Remaining Today</span>
                    <span class="cap-stat-number" id="sponsorCapRemainingDisplay">₹<%= Math.floor(capData.remainingInr).toLocaleString('en-IN') %></span>
                </div>
                <div class="cap-stat-box" style="text-align: right;">
                    <span class="cap-stat-title">Daily Cap Limit</span>
                    <span class="cap-stat-number cap-max-number">₹1,00,000 / day</span>
                </div>
            </div>

            <% if (isCapExhausted) { %>
                <div class="cap-exhausted-banner">
                    <i class="fas fa-info-circle"></i>
                    <div>
                        <strong>Daily Cap Reached:</strong> Today's ₹1,00,000 community contribution allowance has been fully reached. Thank you for your incredible support! The cap will automatically replenish within 24 hours.
                    </div>
                </div>
            <% } %>
        </div>
        <!-- ============================================================== -->

        <!-- ============================================== -->
        <!-- 1. BUY FOOD & COFFEE SECTION                   -->
        <!-- ============================================== -->
        <section id="coffee-section" class="coffee-section">
            <div style="text-align: center; max-width: 600px; margin: 0 auto 15px auto;">
                <h2 style="color: var(--white); font-size: 2em; margin-bottom: 8px;">
                    <i class="fas fa-coffee" style="color: var(--gold); margin-right: 8px;"></i>Fuel Our <span style="color: var(--gold);">Developers</span>
                </h2>
                <p style="color: var(--silver); font-size: 0.95em;">
                    Late-night reverse engineering, malware scanning, and bug fixing run on good caffeine and hot meals. Pick a treat below!
                </p>
            </div>

            <div class="coffee-grid">
                <% (coffeeFoodOptions || []).forEach(opt => { %>
                    <div class="coffee-card" onclick="openSponsorModal('<%= opt.title %>', 'coffee', <%= opt.priceINR %>)">
                        <div class="coffee-icon-box">
                            <i class="<%= opt.icon %>"></i>
                        </div>
                        <h3 style="color: var(--white); font-size: 1.15em; margin: 0;"><%= opt.title %></h3>
                        <div class="coffee-price" data-inr-price="<%= opt.priceINR %>"><span>₹</span><%= opt.priceINR %></div>
                        <p style="color: var(--silver); font-size: 0.85em; margin: 0; line-height: 1.4;"><%= opt.desc %></p>
                        <button class="sponsor-btn" style="margin-top: 15px; width: 100%;">Send Treat</button>
                    </div>
                <% }) %>

                <!-- Custom Contribution Card -->
                <div class="coffee-card" onclick="openCustomCoffeeModal()">
                    <div class="coffee-icon-box" style="background: rgba(70, 181, 232, 0.1); color: #46b5e8;">
                        <i class="fas fa-hand-holding-heart"></i>
                    </div>
                    <h3 style="color: var(--white); font-size: 1.15em; margin: 0;">Custom Amount</h3>
                    <div class="coffee-price" style="color: #46b5e8;">Custom</div>
                    <p style="color: var(--silver); font-size: 0.85em; margin: 0; line-height: 1.4;">Specify any amount you'd like to contribute directly</p>
                    <button class="sponsor-btn" style="margin-top: 15px; width: 100%; background: #46b5e8; color: var(--black); box-shadow: none;">Contribute</button>
                </div>
            </div>
        </section>

        <!-- ============================================== -->
        <!-- 2. INFRASTRUCTURE COMPONENT CATALOG            -->
        <!-- ============================================== -->
        <section id="catalog-section" style="margin-bottom: 50px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
                <div>
                    <h2 style="color: var(--white); font-size: 2em; margin-bottom: 6px;">
                        <i class="fas fa-server" style="color: var(--gold); margin-right: 8px;"></i> Buy Site <span style="color: var(--gold);">Components</span>
                    </h2>
                    <p style="color: var(--silver); margin: 0; font-size: 0.95em;">
                        Choose an exact operational component to cover for 1 month or 1 year. Your name will be featured as the official sponsor.
                    </p>
                </div>
            </div>

            <!-- Toolbar: Search + Cycle + Sort + Category Filters -->
            <div class="catalog-toolbar-wrapper">
                <!-- Search Bar -->
                <div class="catalog-search-bar">
                    <i class="fas fa-search catalog-search-icon"></i>
                    <input type="text" id="catalogSearchInput" class="catalog-search-input" placeholder="Search components, plans, and features (e.g. MongoDB, Gemini, Backblaze B2, Hosting, Cloudflare, SMTP)...">
                </div>

                <!-- Secondary Filter Controls Row -->
                <div class="catalog-filter-row">
                    <!-- Billing Cycle Filter Pills -->
                    <div class="catalog-cycle-group" id="cycleFilters">
                        <button type="button" class="catalog-cycle-btn active" data-cycle="all">All Cycles</button>
                        <button type="button" class="catalog-cycle-btn" data-cycle="monthly">Monthly Plans</button>
                        <button type="button" class="catalog-cycle-btn" data-cycle="yearly">Yearly / Annual</button>
                        <button type="button" class="catalog-cycle-btn" data-cycle="one_time">Pay-as-you-go / Tokens</button>
                    </div>

                    <!-- Price Sorting Control -->
                    <div class="price-sort-wrapper" style="display: inline-flex; align-items: center; gap: 8px;">
                        <span style="font-size: 0.85rem; font-weight: 700; color: var(--gold); text-transform: uppercase; letter-spacing: 0.5px; display: inline-flex; align-items: center; gap: 5px;">
                            <i class="fas fa-sort"></i> Price:
                        </span>
                        <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                            <button type="button" class="catalog-sort-btn active" data-sort="default">Default</button>
                            <button type="button" class="catalog-sort-btn" data-sort="asc"><i class="fas fa-sort-amount-up-alt"></i> Low to High</button>
                            <button type="button" class="catalog-sort-btn" data-sort="desc"><i class="fas fa-sort-amount-down"></i> High to Low</button>
                        </div>
                    </div>
                </div>

                <!-- Category Filter Pills -->
                <% 
                    let totalItemsCount = 0;
                    (catalog || []).forEach(cat => { totalItemsCount += (cat.items || []).length; });
                %>
                <div class="catalog-filter-bar" id="catalogFilters" style="margin-bottom: 0;">
                    <button type="button" class="catalog-filter-btn active" data-cat="all">
                        <i class="fas fa-layer-group"></i> All Components <span class="filter-count">(<%= totalItemsCount %>)</span>
                    </button>
                    <% (catalog || []).forEach(cat => { %>
                        <button type="button" class="catalog-filter-btn" data-cat="<%= cat.category %>">
                            <i class="<%= cat.icon %>" style="color: <%= cat.color %>;"></i> 
                            <%= cat.shortName || cat.categoryTitle.split(' ')[0] %> 
                            <span class="filter-count">(<%= (cat.items || []).length %>)</span>
                        </button>
                    <% }) %>
                </div>
            </div>

            <!-- Cards Grid -->
            <div class="catalog-grid" id="catalogGrid">
                <% (catalog || []).forEach(cat => { %>
                    <% (cat.items || []).forEach(item => { %>
                        <%
                            const searchTerms = [
                                item.title,
                                item.planName || '',
                                cat.categoryTitle,
                                cat.shortName || '',
                                item.limit || '',
                                item.desc || '',
                                (item.features || []).join(' ')
                            ].join(' ').toLowerCase();
                        %>
                        <div class="catalog-item-card" 
                             data-cat="<%= cat.category %>" 
                             data-cycle="<%= item.billingType || 'monthly' %>" 
                             data-sort-price="<%= item.priceINR %>" 
                             data-search="<%= searchTerms %>">
                            
                            <div class="item-header">
                                <div class="item-icon-pill" style="background: <%= cat.color %>22; color: <%= cat.color %>;">
                                    <i class="<%= cat.icon %>"></i>
                                </div>
                                <div class="item-badges-wrapper">
                                    <% if (item.badge) { %>
                                        <span class="plan-tag-badge" style="background: <%= item.badgeColor || cat.color %>25; color: <%= item.badgeColor || cat.color %>; border: 1px solid <%= item.badgeColor || cat.color %>50;">
                                            <i class="fas fa-tag"></i> <%= item.badge %>
                                        </span>
                                    <% } %>
                                    <span class="period-badge"><%= item.period %></span>
                                </div>
                            </div>

                            <h3 class="item-title"><%= item.title %></h3>
                            <% if (item.planName && item.planName !== item.title) { %>
                                <div class="item-plan-name"><%= item.planName %></div>
                            <% } %>

                            <% if (item.limit) { %>
                                <div class="item-limit-box">
                                    <i class="fas fa-bolt"></i> <%= item.limit %>
                                </div>
                            <% } %>

                            <div class="item-pricing-container">
                                <div class="item-primary-price">
                                    <%= item.priceDisplay %>
                                </div>
                                <div class="item-cur-convert">
                                    <i class="fas fa-coins" style="color: var(--gold);"></i> 
                                    <span>Live:</span> 
                                    <span class="item-price-val" data-inr-price="<%= item.priceINR %>">₹<%= item.priceINR.toLocaleString('en-IN') %></span>
                                    <% if (item.priceUSD) { %>
                                        <span class="item-usd-sub" style="margin-left: 5px; color: #888;">(~$<%= item.priceUSD %> USD)</span>
                                    <% } %>
                                </div>
                            </div>

                            <% if (item.breakdown) { %>
                                <div class="item-breakdown-box">
                                    <div class="breakdown-row">
                                        <span>Compute Plan:</span>
                                        <strong style="color: #fff;"><%= item.breakdown.compute %></strong>
                                    </div>
                                    <div class="breakdown-row">
                                        <span>Storage Add-on:</span>
                                        <strong style="color: #fff;"><%= item.breakdown.storage %></strong>
                                    </div>
                                    <div class="breakdown-row breakdown-total">
                                        <span>Total:</span>
                                        <strong><%= item.breakdown.total %></strong>
                                    </div>
                                </div>
                            <% } %>

                            <p class="item-desc"><%= item.desc %></p>

                            <% if (item.features && item.features.length > 0) { %>
                                <ul class="catalog-features-list">
                                    <% item.features.forEach(feat => { %>
                                        <li>
                                            <i class="fas fa-check-circle"></i>
                                            <span><%= feat %></span>
                                        </li>
                                    <% }) %>
                                </ul>
                            <% } %>

                            <div class="item-action-footer">
                                <span class="sponsor-secure-tag">
                                    <i class="fas fa-lock" style="color: #2ecc71;"></i> Verified
                                </span>
                                <button type="button" class="sponsor-btn" onclick="openSponsorModal('<%= item.title.replace(/'/g, "\\'") %>', '<%= cat.category %>', <%= item.priceINR %>, <%= item.priceINRMin || item.priceINR %>, <%= item.priceINRMax || item.priceINR %>, '<%= (item.priceDisplay || '').replace(/'/g, "\\'") %>')">
                                    <i class="fas fa-heart"></i> Sponsor
                                </button>
                            </div>
                        </div>
                    <% }) %>
                <% }) %>

                <!-- Empty Search Notice -->
                <div class="catalog-empty-notice" id="catalogEmptyNotice" style="display: none;">
                    <i class="fas fa-search" style="font-size: 2.2rem; color: var(--gold); opacity: 0.5; margin-bottom: 12px; display: block;"></i>
                    <h3 style="color: var(--white); margin: 0 0 6px 0;">No matching components found</h3>
                    <p style="margin: 0; font-size: 0.9rem;">Try adjusting your search terms, billing cycle, or category filter.</p>
                </div>
            </div>
        </section>

        <!-- ============================================== -->
        <!-- 3. RECENT SUPPORTERS WALL                      -->
        <!-- ============================================== -->
        <section class="sponsors-wall">
            <h2 style="color: var(--white); font-size: 1.8em; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between;">
                <span><i class="fas fa-award" style="color: var(--gold); margin-right: 8px;"></i> Recent Supporters</span>
                <span style="font-size: 0.6em; color: var(--silver); font-weight: normal;">Live Leaderboard</span>
            </h2>

            <% if (recentSponsors && recentSponsors.length > 0) { %>
                <div>
                    <% recentSponsors.forEach(s => { %>
                        <div class="sponsor-entry">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <div style="width: 38px; height: 38px; border-radius: 50%; background: rgba(255, 215, 0, 0.15); color: var(--gold); display: flex; align-items: center; justify-content: center; font-weight: bold;">
                                    <i class="fas fa-heart"></i>
                                </div>
                                <div>
                                    <strong style="color: var(--white); font-size: 0.95em;"><%= s.isAnonymous ? 'Anonymous Supporter' : (s.username || 'Generous Friend') %></strong>
                                    <div style="font-size: 0.8em; color: var(--silver);">
                                        Sponsored: <span style="color: var(--gold);"><%= s.sponsorItem || 'Platform Support' %></span>
                                        <% if (s.message) { %>
                                            &bull; <em>"<%= s.message %>"</em>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <span style="background: rgba(46, 204, 113, 0.15); color: #2ecc71; border: 1px solid rgba(46, 204, 113, 0.3); padding: 4px 10px; border-radius: 12px; font-weight: bold; font-size: 0.85em;">
                                    <%= s.currency || 'INR' %> <%= (s.amount || 0).toLocaleString('en-IN') %>
                                </span>
                                <div style="font-size: 0.75em; color: #666; margin-top: 4px;">
                                    <%= timeAgo(s.createdAt) %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div style="text-align: center; padding: 40px 0; color: var(--silver);">
                    <i class="fas fa-coffee" style="font-size: 2.5em; opacity: 0.4; margin-bottom: 12px; display: block; color: var(--gold);"></i>
                    <p>Be the very first community member to sponsor an infrastructure component or send a chai!</p>
                </div>
            <% } %>
        </section>
    </div>
</main>

<!-- ============================================== -->
<!-- 4. CHECKOUT MODAL                              -->
<!-- ============================================== -->
<div class="modal-overlay" id="sponsorModal">
    <div class="modal-card">
        <button class="modal-close" onclick="closeSponsorModal()">&times;</button>
        <div style="text-align: center; margin-bottom: 20px;">
            <div style="width: 50px; height: 50px; border-radius: 14px; background: rgba(255, 215, 0, 0.15); color: var(--gold); display: flex; align-items: center; justify-content: center; font-size: 1.5em; margin: 0 auto 10px auto;">
                <i class="fas fa-hand-holding-heart"></i>
            </div>
            <h3 style="color: var(--white); font-size: 1.4em; margin-bottom: 4px;" id="modalItemTitle">Sponsorship</h3>
            <p style="color: var(--silver); font-size: 0.85em; margin: 0;">Secured via Cashfree Payments</p>
        </div>

        <form id="sponsorForm">
            <input type="hidden" id="modalCategory" value="infrastructure">
            <input type="hidden" id="modalItem" value="">

            <div id="modalPriceSuggestion" style="background: rgba(255, 215, 0, 0.08); border: 1px solid rgba(255, 215, 0, 0.25); border-radius: 10px; padding: 10px 14px; margin-bottom: 16px; font-size: 0.88rem; color: var(--gold); display: none; line-height: 1.4;"></div>

            <div class="modal-form-group">
                <label>Amount (₹ INR)*</label>
                <input type="number" id="modalAmount" required min="1" step="any">
                <div id="modalCurrencyHint" style="font-size: 0.85em; color: var(--gold); margin-top: 5px; font-weight: 600; display: none;"></div>
            </div>

            <div class="modal-form-group">
                <label>Your Name (Optional)</label>
                <input type="text" id="modalName" placeholder="<%= (user && user.username) ? user.username : 'Your Display Name' %>" value="<%= (user && user.username) ? user.username : '' %>">
            </div>

            <div class="modal-form-group">
                <label>Email Address (For receipt)*</label>
                <input type="email" id="modalEmail" required placeholder="you@example.com" value="<%= (user && user.email) ? user.email : '' %>">
            </div>

            <div class="modal-form-group">
                <label>Supportive Message (Optional)</label>
                <textarea id="modalMessage" rows="2" placeholder="Say something nice to the team or community..."></textarea>
            </div>

            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 20px;">
                <input type="checkbox" id="modalAnonymous" style="width: auto; cursor: pointer;">
                <label for="modalAnonymous" style="color: var(--silver); font-size: 0.85em; cursor: pointer; margin: 0;">Make my sponsorship anonymous on the public leaderboard</label>
            </div>

            <div id="modalError" style="color: var(--red); font-size: 0.85em; margin-bottom: 12px; display: none;"></div>

            <button type="submit" class="pay-btn" id="modalSubmitBtn">Proceed to Payment &rarr;</button>
        </form>
    </div>
</div>

<script src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>
<script>
    let cashfreeInstance = null;
    function getSponsorCashfree() {
        if (!cashfreeInstance && typeof Cashfree !== 'undefined') {
            cashfreeInstance = Cashfree({ mode: "<%= (typeof cashfreeEnv !== 'undefined' ? cashfreeEnv : 'sandbox') %>" });
        }
        return cashfreeInstance;
    }

    // Category Filtering, Billing Cycle, Search & Price Sorting Logic
    let currentCategory = 'all';
    let currentCycle = 'all';
    let currentSort = 'default';
    let currentSearch = '';

    function applyCatalogFilterAndSort() {
        const grid = document.getElementById('catalogGrid');
        if (!grid) return;
        const cards = Array.from(grid.querySelectorAll('.catalog-item-card'));
        const emptyNotice = document.getElementById('catalogEmptyNotice');

        // Sort items by data-sort-price (never collides with currency converter)
        cards.sort((a, b) => {
            const priceA = parseFloat(a.getAttribute('data-sort-price')) || 0;
            const priceB = parseFloat(b.getAttribute('data-sort-price')) || 0;
            const indexA = parseInt(a.getAttribute('data-original-index')) || 0;
            const indexB = parseInt(b.getAttribute('data-original-index')) || 0;

            if (currentSort === 'asc') {
                return priceA - priceB;
            } else if (currentSort === 'desc') {
                return priceB - priceA;
            }
            return indexA - indexB;
        });

        let visibleCount = 0;

        // Filter and re-append in sorted order
        cards.forEach(card => {
            const cat = card.getAttribute('data-cat') || '';
            const cycle = card.getAttribute('data-cycle') || '';
            const searchData = (card.getAttribute('data-search') || '').toLowerCase();

            const matchCat = (currentCategory === 'all' || cat === currentCategory);
            const matchCycle = (currentCycle === 'all' || cycle === currentCycle);
            const matchSearch = (!currentSearch || searchData.includes(currentSearch));

            if (matchCat && matchCycle && matchSearch) {
                card.style.display = 'flex';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
            grid.appendChild(card);
        });

        if (emptyNotice) {
            emptyNotice.style.display = (visibleCount === 0) ? 'block' : 'none';
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const filterBtns = document.querySelectorAll('.catalog-filter-btn');
        const cycleBtns = document.querySelectorAll('.catalog-cycle-btn');
        const sortBtns = document.querySelectorAll('.catalog-sort-btn');
        const searchInput = document.getElementById('catalogSearchInput');
        const cards = document.querySelectorAll('.catalog-item-card');

        // Save original indices
        cards.forEach((card, idx) => {
            card.setAttribute('data-original-index', idx);
        });

        // Search Input filter
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                currentSearch = (e.target.value || '').trim().toLowerCase();
                applyCatalogFilterAndSort();
            });
        }

        // Category filter click
        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentCategory = btn.getAttribute('data-cat');
                applyCatalogFilterAndSort();
            });
        });

        // Billing cycle filter click
        cycleBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                cycleBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentCycle = btn.getAttribute('data-cycle');
                applyCatalogFilterAndSort();
            });
        });

        // Price sort click
        sortBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                sortBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentSort = btn.getAttribute('data-sort');
                applyCatalogFilterAndSort();
            });
        });
    });

    // Modal Control
    function openSponsorModal(title, category, amount, minAmount, maxAmount, priceDisplay) {
        document.getElementById('modalItemTitle').textContent = title;
        document.getElementById('modalItem').value = title;
        document.getElementById('modalCategory').value = category;
        document.getElementById('modalAmount').value = amount;
        document.getElementById('modalAmount').readOnly = false;

        const suggestionEl = document.getElementById('modalPriceSuggestion');
        if (suggestionEl) {
            if (priceDisplay) {
                suggestionEl.innerHTML = `<i class="fas fa-info-circle"></i> <strong>Plan Rate:</strong> ${priceDisplay}<br><span style="font-size: 0.8rem; color: #ccc;">You may sponsor this exact amount or customize your contribution.</span>`;
                suggestionEl.style.display = 'block';
            } else {
                suggestionEl.style.display = 'none';
            }
        }

        document.getElementById('modalError').style.display = 'none';
        document.getElementById('sponsorModal').style.display = 'flex';
        updateModalCurrencyHint();
    }

    function openCustomCoffeeModal() {
        openSponsorModal('Custom Developer Fuel', 'coffee', 100);
    }

    function closeSponsorModal() {
        document.getElementById('sponsorModal').style.display = 'none';
    }

    window.onclick = function(e) {
        const modal = document.getElementById('sponsorModal');
        if (e.target === modal) closeSponsorModal();
    };

    // Checkout Submission
    document.getElementById('sponsorForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById('modalSubmitBtn');
        const errorEl = document.getElementById('modalError');
        errorEl.style.display = 'none';
        submitBtn.disabled = true;
        submitBtn.textContent = 'Initiating Secure Checkout...';

        const payload = {
            itemTitle: document.getElementById('modalItem').value,
            category: document.getElementById('modalCategory').value,
            amount: parseFloat(document.getElementById('modalAmount').value),
            currency: 'INR',
            name: document.getElementById('modalName').value.trim(),
            email: document.getElementById('modalEmail').value.trim(),
            message: document.getElementById('modalMessage').value.trim(),
            isAnonymous: document.getElementById('modalAnonymous').checked
        };

        try {
            const res = await fetch('/create-sponsor-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();

            if (!res.ok || !data.payment_session_id) {
                throw new Error(data.error || 'Failed to start payment.');
            }

            const cf = getSponsorCashfree();
            if (cf && data.payment_session_id) {
                cf.checkout({
                    paymentSessionId: data.payment_session_id,
                    redirectTarget: "_modal"
                }).then(result => {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Proceed to Payment →';
                    if (result && result.error) {
                        errorEl.textContent = result.error.message || 'Payment cancelled by user.';
                        errorEl.style.display = 'block';

                        // Inform backend to mark cancelled_by_user
                        fetch('/api/cashfree/cancel-order', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ orderId: data.order_id, reason: result.error.message || 'User closed modal' })
                        }).catch(e => {});

                        // Show Cancellation survey modal with questions
                        if (typeof window.showCancellationSurvey === 'function') {
                            window.showCancellationSurvey({ orderId: data.order_id, type: 'sponsor' });
                        }
                    }
                }).catch(e => {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Proceed to Payment →';
                    fetch('/api/cashfree/cancel-order', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ orderId: data.order_id, reason: 'Modal closed' })
                    }).catch(err => {});

                    if (typeof window.showCancellationSurvey === 'function') {
                        window.showCancellationSurvey({ orderId: data.order_id, type: 'sponsor' });
                    }
                });
            } else {
                throw new Error('Cashfree payment gateway is unavailable.');
            }
        } catch (err) {
            console.error('Checkout error:', err);
            errorEl.textContent = err.message || 'Payment initiation failed.';
            errorEl.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Proceed to Payment →';
        }
    });

    // In-Page Currency Switcher Logic
    function setSponsorCurrency(code) {
        if (window.GPLCurrency) {
            window.GPLCurrency.setCurrency(code);
        }
        document.querySelectorAll('.cur-pill-btn').forEach(btn => {
            if (btn.getAttribute('data-cur') === code) {
                btn.classList.add('active');
            } else {
                btn.classList.remove('active');
            }
        });
        updateModalCurrencyHint();
    }

    function updateModalCurrencyHint() {
        const cur = (window.GPLCurrency && window.GPLCurrency.getCurrency()) || 'INR';
        const inr = parseFloat(document.getElementById('modalAmount').value) || 0;
        const hint = document.getElementById('modalCurrencyHint');
        if (hint) {
            if (cur !== 'INR' && window.GPLCurrency && inr > 0) {
                hint.textContent = `≈ ${window.GPLCurrency.format(inr, cur)} (${cur}) estimated`;
                hint.style.display = 'block';
            } else {
                hint.style.display = 'none';
            }
        }
    }

    document.getElementById('modalAmount').addEventListener('input', updateModalCurrencyHint);

    window.addEventListener('gplCurrencyChange', function(e) {
        if (e.detail && e.detail.currency) {
            document.querySelectorAll('.cur-pill-btn').forEach(btn => {
                if (btn.getAttribute('data-cur') === e.detail.currency) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
            updateModalCurrencyHint();
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        const cur = (window.GPLCurrency && window.GPLCurrency.getCurrency()) || 'INR';
        setSponsorCurrency(cur);
    });
</script>

<%- include('../partials/footer') %>
