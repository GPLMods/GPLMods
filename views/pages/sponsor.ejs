<%- include('../partials/header') %>

<style>
    .sponsor-hero {
        text-align: center;
        padding: 50px 20px 40px 20px;
        background: linear-gradient(180deg, rgba(255, 215, 0, 0.08) 0%, transparent 100%);
        border-bottom: 1px solid #222;
        margin-bottom: 40px;
    }
    .sponsor-badge-top {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 51, 102, 0.12);
        color: #ff3366;
        border: 1px solid rgba(255, 51, 102, 0.3);
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.85em;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 15px;
    }
    .sponsor-hero h1 {
        font-size: clamp(1.65rem, 4vw + 0.5rem, 2.75rem);
        color: var(--white);
        margin-bottom: 12px;
        word-break: normal;
        overflow-wrap: break-word;
        line-height: 1.25;
        letter-spacing: -0.5px;
    }
    .sponsor-hero h1 span {
        color: var(--gold);
        text-shadow: 0 0 15px var(--glow-gold);
    }
    .sponsor-hero p {
        color: var(--silver);
        max-width: 720px;
        margin: 0 auto 25px auto;
        font-size: clamp(0.95em, 2vw, 1.1em);
        line-height: 1.6;
        word-break: normal;
        overflow-wrap: break-word;
    }

    /* Category Filter Pills */
    .catalog-filter-bar {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        padding-bottom: 12px;
        margin-bottom: 35px;
        scrollbar-width: thin;
    }
    .catalog-filter-btn {
        background: var(--dark-gray);
        color: var(--silver);
        border: 1px solid #333;
        padding: 10px 20px;
        border-radius: 25px;
        cursor: pointer;
        font-size: 0.9em;
        font-weight: 600;
        white-space: nowrap;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .catalog-filter-btn:hover {
        color: var(--white);
        border-color: var(--gold);
    }
    .catalog-filter-btn.active {
        background: var(--gold);
        color: var(--black);
        border-color: var(--gold);
        box-shadow: 0 0 15px var(--glow-gold);
    }

    /* Food & Coffee Section */
    .coffee-section {
        background: rgba(18, 18, 22, 0.9);
        border: 1px solid rgba(255, 215, 0, 0.3);
        border-radius: 18px;
        padding: 35px;
        margin-bottom: 50px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    }
    .coffee-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
        margin-top: 25px;
    }
    .coffee-card {
        background: var(--dark-gray);
        border: 1px solid #333;
        border-radius: 14px;
        padding: 24px 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .coffee-card:hover {
        transform: translateY(-5px);
        border-color: var(--gold);
        box-shadow: 0 10px 25px rgba(255, 215, 0, 0.15);
    }
    .coffee-icon-box {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        background: rgba(255, 215, 0, 0.1);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8em;
        margin-bottom: 15px;
    }
    .coffee-price {
        font-size: 1.6em;
        font-weight: 800;
        color: var(--white);
        margin: 8px 0;
    }
    .coffee-price span {
        color: var(--gold);
    }

    /* Infrastructure Catalog Cards */
    .catalog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 50px;
    }
    .catalog-item-card {
        background: var(--dark-gray);
        border: 1px solid #333;
        border-radius: 16px;
        padding: 26px;
        display: flex;
        flex-direction: column;
        transition: all 0.3s ease;
        position: relative;
    }
    .catalog-item-card:hover {
        transform: translateY(-5px);
        border-color: var(--gold);
        box-shadow: 0 12px 30px rgba(0,0,0,0.5);
    }
    .item-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 15px;
    }
    .item-icon-pill {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3em;
    }
    .period-badge {
        font-size: 0.75em;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 4px 10px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.08);
        color: var(--silver);
        font-weight: 600;
    }
    .item-title {
        color: var(--white);
        font-size: 1.25em;
        margin-bottom: 8px;
        font-weight: 700;
    }
    .item-desc {
        color: var(--silver);
        font-size: 0.9em;
        line-height: 1.5;
        margin-bottom: 20px;
        flex-grow: 1;
    }
    .item-pricing-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #2a2a2a;
        padding-top: 15px;
        margin-top: auto;
    }
    .item-price-val {
        font-size: 1.4em;
        font-weight: 800;
        color: var(--white);
    }
    .item-usd-sub {
        font-size: 0.75em;
        color: #777;
        display: block;
    }
    .sponsor-btn {
        background: var(--gold);
        color: var(--black);
        padding: 8px 18px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.9em;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 0 10px var(--glow-gold);
    }
    .sponsor-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 0 18px var(--glow-gold);
    }

    /* Recent Sponsors Wall */
    .sponsors-wall {
        background: var(--dark-gray);
        border: 1px solid #333;
        border-radius: 18px;
        padding: 35px;
        margin-bottom: 50px;
    }
    .sponsor-entry {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        border-radius: 10px;
        background: #111;
        border: 1px solid #222;
        margin-bottom: 10px;
        flex-wrap: wrap;
        gap: 10px;
    }

    /* Checkout Modal */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.85);
        backdrop-filter: blur(5px);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }
    .modal-card {
        background: var(--dark-gray);
        border: 1px solid var(--gold);
        border-radius: 16px;
        width: 100%;
        max-width: 520px;
        padding: 30px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.6);
        position: relative;
    }
    .modal-close {
        position: absolute;
        top: 20px;
        right: 20px;
        background: none;
        border: none;
        color: var(--silver);
        font-size: 1.3em;
        cursor: pointer;
    }
    .modal-form-group {
        margin-bottom: 16px;
        text-align: left;
    }
    .modal-form-group label {
        display: block;
        color: var(--silver);
        font-size: 0.88em;
        font-weight: 600;
        margin-bottom: 6px;
    }
    .modal-form-group input, .modal-form-group textarea {
        width: 100%;
        padding: 12px 14px;
        background: var(--black);
        border: 1px solid #444;
        border-radius: 8px;
        color: var(--white);
        font-family: inherit;
        font-size: 0.95em;
        outline: none;
        transition: border-color 0.2s;
    }
    .modal-form-group input:focus, .modal-form-group textarea:focus {
        border-color: var(--gold);
    }
    .pay-btn {
        width: 100%;
        background: var(--gold);
        color: var(--black);
        padding: 14px;
        border-radius: 10px;
        border: none;
        font-size: 1.1em;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 0 15px var(--glow-gold);
        transition: all 0.2s ease;
        margin-top: 10px;
    }
    .pay-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 25px var(--glow-gold);
    }

    @media (max-width: 768px) {
        .sponsor-hero {
            padding: 35px 15px 25px 15px;
            margin-bottom: 25px;
        }
        .sponsor-hero h1 {
            font-size: 1.85rem;
        }
        .catalog-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }
        .coffee-grid {
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 12px;
        }
        .coffee-card {
            padding: 16px 12px;
        }
    }
    @media (max-width: 480px) {
        .sponsor-hero h1 {
            font-size: 1.55rem;
        }
    }

    /* In-Page Currency Switcher Bar */
    .sponsor-currency-bar {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(18, 20, 26, 0.9);
        border: 1px solid rgba(255, 215, 0, 0.35);
        border-radius: 30px;
        padding: 6px 14px;
        margin: 22px auto 0 auto;
        box-shadow: 0 4px 15px rgba(0,0,0,0.4);
        max-width: 100%;
        flex-wrap: wrap;
        justify-content: center;
    }
    .currency-bar-label {
        font-size: 0.85em;
        font-weight: 700;
        color: var(--gold);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .currency-pill-group {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .cur-pill-btn {
        background: transparent;
        border: 1px solid transparent;
        color: var(--silver);
        padding: 4px 10px;
        border-radius: 20px;
        cursor: pointer;
        font-size: 0.8em;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.2s ease;
    }
    .cur-pill-btn:hover {
        color: var(--white);
        border-color: rgba(255, 215, 0, 0.4);
    }
    .cur-pill-btn.active {
        background: var(--gold);
        color: var(--black);
        font-weight: 700;
        box-shadow: 0 0 10px var(--glow-gold);
    }
</style>

<main>
    <div class="sponsor-hero">
        <div class="container">
            <!-- ======== DYNAMIC GO BACK BUTTON ======== -->
            <%- include('../partials/go-back-button', { fallback: '/' }) %>
            <!-- ======================================== -->
            <div class="sponsor-badge-top">
                <i class="fas fa-heart"></i> Community Powered Platform
            </div>
            <h1>Sponsor <span>GPL Mods</span> Infrastructure</h1>
            <p>
                GPL Mods does not lock features behind paywalls or sell private data. We rely on open-source supporters like you to cover our monthly cloud servers, object storage, transactional email relays, AI model tokens, and dev sustenance.
            </p>
            <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
                <a href="#coffee-section" class="btn" style="background: var(--gold); color: var(--black); padding: 12px 26px; border-radius: 25px; font-weight: 700; text-decoration: none; box-shadow: 0 0 15px var(--glow-gold);">
                    <i class="fa-duotone fa-solid fa-cup-togo" style="margin-right: 6px;"></i> Buy Food &amp; Coffee
                </a>
                <a href="#catalog-section" class="btn" style="background: transparent; color: var(--white); border: 2px solid #555; padding: 10px 24px; border-radius: 25px; font-weight: 700; text-decoration: none;">
                    <i class="fas fa-server" style="margin-right: 6px;"></i> Sponsor A Server Component
                </a>
            </div>

            <!-- Dedicated In-Page Currency Selector -->
            <div class="gpl-page-currency-bar">
                <span class="gpl-currency-bar-label"><i class="fas fa-coins"></i> Currency:</span>
                <div class="gpl-currency-pills">
                    <button type="button" class="cur-pill-btn active" data-cur="INR" onclick="setSponsorCurrency('INR')">
                        <span class="fi fi-in"></span> ₹ INR
                    </button>
                    <button type="button" class="cur-pill-btn" data-cur="USD" onclick="setSponsorCurrency('USD')">
                        <span class="fi fi-us"></span> $ USD
                    </button>
                    <button type="button" class="cur-pill-btn" data-cur="EUR" onclick="setSponsorCurrency('EUR')">
                        <span class="fi fi-eu"></span> € EUR
                    </button>
                    <button type="button" class="cur-pill-btn" data-cur="GBP" onclick="setSponsorCurrency('GBP')">
                        <span class="fi fi-gb"></span> £ GBP
                    </button>
                    <button type="button" class="cur-pill-btn" data-cur="AED" onclick="setSponsorCurrency('AED')">
                        <span class="fi fi-ae"></span> د.إ AED
                    </button>
                    <button type="button" class="cur-pill-btn" data-cur="CAD" onclick="setSponsorCurrency('CAD')">
                        <span class="fi fi-ca"></span> CA$ CAD
                    </button>
                    <button type="button" class="cur-pill-btn" data-cur="AUD" onclick="setSponsorCurrency('AUD')">
                        <span class="fi fi-au"></span> AU$ AUD
                    </button>
                    <button type="button" class="cur-pill-btn" data-cur="JPY" onclick="setSponsorCurrency('JPY')">
                        <span class="fi fi-jp"></span> ¥ JPY
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <!-- ============================================== -->
        <!-- 1. BUY FOOD & COFFEE SECTION                   -->
        <!-- ============================================== -->
        <section id="coffee-section" class="coffee-section">
            <div style="text-align: center; max-width: 600px; margin: 0 auto 15px auto;">
                <h2 style="color: var(--white); font-size: 2em; margin-bottom: 8px;">
                    <i class="fa-duotone fa-solid fa-cup-togo" style="color: var(--gold); margin-right: 8px;"></i>Fuel Our <span style="color: var(--gold);">Developers</span>
                </h2>
                <p style="color: var(--silver); font-size: 0.95em;">
                    Late-night reverse engineering, malware scanning, and bug fixing run on good caffeine and hot meals. Pick a treat below!
                </p>
            </div>

            <div class="coffee-grid">
                <% (coffeeFoodOptions || []).forEach(opt => { %>
                    <div class="coffee-card" onclick="openSponsorModal('<%= opt.title %>', 'coffee', <%= opt.priceINR %>)">
                        <div class="coffee-icon-box">
                            <i class="<%= opt.icon %>"></i>
                        </div>
                        <h3 style="color: var(--white); font-size: 1.15em; margin: 0;"><%= opt.title %></h3>
                        <div class="coffee-price" data-inr-price="<%= opt.priceINR %>"><span>₹</span><%= opt.priceINR %></div>
                        <p style="color: var(--silver); font-size: 0.85em; margin: 0; line-height: 1.4;"><%= opt.desc %></p>
                        <button class="sponsor-btn" style="margin-top: 15px; width: 100%;">Send Treat</button>
                    </div>
                <% }) %>

                <!-- Custom Contribution Card -->
                <div class="coffee-card" onclick="openCustomCoffeeModal()">
                    <div class="coffee-icon-box" style="background: rgba(70, 181, 232, 0.1); color: #46b5e8;">
                        <i class="fas fa-hand-holding-heart"></i>
                    </div>
                    <h3 style="color: var(--white); font-size: 1.15em; margin: 0;">Custom Amount</h3>
                    <div class="coffee-price" style="color: #46b5e8;">Custom</div>
                    <p style="color: var(--silver); font-size: 0.85em; margin: 0; line-height: 1.4;">Specify any amount you'd like to contribute directly</p>
                    <button class="sponsor-btn" style="margin-top: 15px; width: 100%; background: #46b5e8; color: var(--black); box-shadow: none;">Contribute</button>
                </div>
            </div>
        </section>

        <!-- ============================================== -->
        <!-- 2. INFRASTRUCTURE COMPONENT CATALOG            -->
        <!-- ============================================== -->
        <section id="catalog-section" style="margin-bottom: 50px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
                <div>
                    <h2 style="color: var(--white); font-size: 2em; margin-bottom: 6px;">
                        <i class="fas fa-server" style="color: var(--gold); margin-right: 8px;"></i> Sponsor A <span style="color: var(--gold);">Component</span>
                    </h2>
                    <p style="color: var(--silver); margin: 0; font-size: 0.95em;">
                        Choose an exact operational component to cover for 1 month or 1 year. Your name will be featured as the official sponsor.
                    </p>
                </div>
            </div>

            <!-- Filter Pills -->
            <div class="catalog-filter-bar" id="catalogFilters">
                <button class="catalog-filter-btn active" data-cat="all">All Infrastructure</button>
                <% (catalog || []).forEach(cat => { %>
                    <button class="catalog-filter-btn" data-cat="<%= cat.category %>">
                        <i class="<%= cat.icon %>" style="color: <%= cat.color %>;"></i> <%= cat.categoryTitle.split(' ')[0] %>
                    </button>
                <% }) %>
            </div>

            <!-- Cards Grid -->
            <div class="catalog-grid" id="catalogGrid">
                <% (catalog || []).forEach(cat => { %>
                    <% (cat.items || []).forEach(item => { %>
                        <div class="catalog-item-card" data-cat="<%= cat.category %>">
                            <div class="item-header">
                                <div class="item-icon-pill" style="background: <%= cat.color %>22; color: <%= cat.color %>;">
                                    <i class="<%= cat.icon %>"></i>
                                </div>
                                <span class="period-badge"><%= item.period %></span>
                            </div>
                            <h3 class="item-title"><%= item.title %></h3>
                            <p class="item-desc"><%= item.desc %></p>
                            <div class="item-pricing-bar">
                                <div>
                                    <div class="item-price-val" data-inr-price="<%= item.priceINR %>">₹<%= item.priceINR.toLocaleString('en-IN') %></div>
                                    <% if (item.priceUSD) { %>
                                        <span class="item-usd-sub">~$<%= item.priceUSD %> USD</span>
                                    <% } %>
                                </div>
                                <button class="sponsor-btn" onclick="openSponsorModal('<%= item.title %>', '<%= cat.category %>', <%= item.priceINR %>)">
                                    Sponsor
                                </button>
                            </div>
                        </div>
                    <% }) %>
                <% }) %>
            </div>
        </section>

        <!-- ============================================== -->
        <!-- 3. RECENT SUPPORTERS WALL                      -->
        <!-- ============================================== -->
        <section class="sponsors-wall">
            <h2 style="color: var(--white); font-size: 1.8em; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between;">
                <span><i class="fas fa-award" style="color: var(--gold); margin-right: 8px;"></i> Recent Supporters</span>
                <span style="font-size: 0.6em; color: var(--silver); font-weight: normal;">Live Leaderboard</span>
            </h2>

            <% if (recentSponsors && recentSponsors.length > 0) { %>
                <div>
                    <% recentSponsors.forEach(s => { %>
                        <div class="sponsor-entry">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <div style="width: 38px; height: 38px; border-radius: 50%; background: rgba(255, 215, 0, 0.15); color: var(--gold); display: flex; align-items: center; justify-content: center; font-weight: bold;">
                                    <i class="fas fa-heart"></i>
                                </div>
                                <div>
                                    <strong style="color: var(--white); font-size: 0.95em;"><%= s.isAnonymous ? 'Anonymous Supporter' : (s.username || 'Generous Friend') %></strong>
                                    <div style="font-size: 0.8em; color: var(--silver);">
                                        Sponsored: <span style="color: var(--gold);"><%= s.sponsorItem || 'Platform Support' %></span>
                                        <% if (s.message) { %>
                                            &bull; <em>"<%= s.message %>"</em>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <span style="background: rgba(46, 204, 113, 0.15); color: #2ecc71; border: 1px solid rgba(46, 204, 113, 0.3); padding: 4px 10px; border-radius: 12px; font-weight: bold; font-size: 0.85em;">
                                    <%= s.currency || 'INR' %> <%= (s.amount || 0).toLocaleString('en-IN') %>
                                </span>
                                <div style="font-size: 0.75em; color: #666; margin-top: 4px;">
                                    <%= timeAgo(s.createdAt) %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div style="text-align: center; padding: 40px 0; color: var(--silver);">
                    <i class="fa-duotone fa-solid fa-cup-togo" style="font-size: 2.5em; opacity: 0.4; margin-bottom: 12px; display: block; color: var(--gold);"></i>
                    <p>Be the very first community member to sponsor an infrastructure component or send a chai!</p>
                </div>
            <% } %>
        </section>
    </div>
</main>

<!-- ============================================== -->
<!-- 4. CHECKOUT MODAL                              -->
<!-- ============================================== -->
<div class="modal-overlay" id="sponsorModal">
    <div class="modal-card">
        <button class="modal-close" onclick="closeSponsorModal()">&times;</button>
        <div style="text-align: center; margin-bottom: 20px;">
            <div style="width: 50px; height: 50px; border-radius: 14px; background: rgba(255, 215, 0, 0.15); color: var(--gold); display: flex; align-items: center; justify-content: center; font-size: 1.5em; margin: 0 auto 10px auto;">
                <i class="fas fa-hand-holding-heart"></i>
            </div>
            <h3 style="color: var(--white); font-size: 1.4em; margin-bottom: 4px;" id="modalItemTitle">Sponsorship</h3>
            <p style="color: var(--silver); font-size: 0.85em; margin: 0;">Secured via Cashfree Payments</p>
        </div>

        <form id="sponsorForm">
            <input type="hidden" id="modalCategory" value="infrastructure">
            <input type="hidden" id="modalItem" value="">

            <div class="modal-form-group">
                <label>Amount (₹ INR)*</label>
                <input type="number" id="modalAmount" required min="1" step="any">
                <div id="modalCurrencyHint" style="font-size: 0.85em; color: var(--gold); margin-top: 5px; font-weight: 600; display: none;"></div>
            </div>

            <div class="modal-form-group">
                <label>Your Name (Optional)</label>
                <input type="text" id="modalName" placeholder="<%= (user && user.username) ? user.username : 'Your Display Name' %>" value="<%= (user && user.username) ? user.username : '' %>">
            </div>

            <div class="modal-form-group">
                <label>Email Address (For receipt)*</label>
                <input type="email" id="modalEmail" required placeholder="you@example.com" value="<%= (user && user.email) ? user.email : '' %>">
            </div>

            <div class="modal-form-group">
                <label>Supportive Message (Optional)</label>
                <textarea id="modalMessage" rows="2" placeholder="Say something nice to the team or community..."></textarea>
            </div>

            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 20px;">
                <input type="checkbox" id="modalAnonymous" style="width: auto; cursor: pointer;">
                <label for="modalAnonymous" style="color: var(--silver); font-size: 0.85em; cursor: pointer; margin: 0;">Make my sponsorship anonymous on the public leaderboard</label>
            </div>

            <div id="modalError" style="color: var(--red); font-size: 0.85em; margin-bottom: 12px; display: none;"></div>

            <button type="submit" class="pay-btn" id="modalSubmitBtn">Proceed to Payment &rarr;</button>
        </form>
    </div>
</div>

<script src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>
<script>
    const cashfree = Cashfree({ mode: "sandbox" });

    // Category Filtering
    document.addEventListener('DOMContentLoaded', () => {
        const filterBtns = document.querySelectorAll('.catalog-filter-btn');
        const cards = document.querySelectorAll('.catalog-item-card');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                const cat = btn.getAttribute('data-cat');

                cards.forEach(card => {
                    if (cat === 'all' || card.getAttribute('data-cat') === cat) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });
    });

    // Modal Control
    function openSponsorModal(title, category, amount) {
        document.getElementById('modalItemTitle').textContent = title;
        document.getElementById('modalItem').value = title;
        document.getElementById('modalCategory').value = category;
        document.getElementById('modalAmount').value = amount;
        document.getElementById('modalAmount').readOnly = false;
        document.getElementById('modalError').style.display = 'none';
        document.getElementById('sponsorModal').style.display = 'flex';
        updateModalCurrencyHint();
    }

    function openCustomCoffeeModal() {
        openSponsorModal('Custom Developer Fuel', 'coffee', 100);
    }

    function closeSponsorModal() {
        document.getElementById('sponsorModal').style.display = 'none';
    }

    window.onclick = function(e) {
        const modal = document.getElementById('sponsorModal');
        if (e.target === modal) closeSponsorModal();
    };

    // Checkout Submission
    document.getElementById('sponsorForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById('modalSubmitBtn');
        const errorEl = document.getElementById('modalError');
        errorEl.style.display = 'none';
        submitBtn.disabled = true;
        submitBtn.textContent = 'Initiating Secure Checkout...';

        const payload = {
            itemTitle: document.getElementById('modalItem').value,
            category: document.getElementById('modalCategory').value,
            amount: parseFloat(document.getElementById('modalAmount').value),
            currency: 'INR',
            name: document.getElementById('modalName').value.trim(),
            email: document.getElementById('modalEmail').value.trim(),
            message: document.getElementById('modalMessage').value.trim(),
            isAnonymous: document.getElementById('modalAnonymous').checked
        };

        try {
            const res = await fetch('/create-sponsor-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();

            if (!res.ok || !data.payment_session_id) {
                throw new Error(data.error || 'Failed to start payment.');
            }

            cashfree.checkout({
                paymentSessionId: data.payment_session_id,
                redirectTarget: "_self"
            });
        } catch (err) {
            console.error('Checkout error:', err);
            errorEl.textContent = err.message || 'Payment initiation failed.';
            errorEl.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Proceed to Payment →';
        }
    });

    // In-Page Currency Switcher Logic
    function setSponsorCurrency(code) {
        if (window.GPLCurrency) {
            window.GPLCurrency.setCurrency(code);
        }
        document.querySelectorAll('.cur-pill-btn').forEach(btn => {
            if (btn.getAttribute('data-cur') === code) {
                btn.classList.add('active');
            } else {
                btn.classList.remove('active');
            }
        });
        updateModalCurrencyHint();
    }

    function updateModalCurrencyHint() {
        const cur = (window.GPLCurrency && window.GPLCurrency.getCurrency()) || 'INR';
        const inr = parseFloat(document.getElementById('modalAmount').value) || 0;
        const hint = document.getElementById('modalCurrencyHint');
        if (hint) {
            if (cur !== 'INR' && window.GPLCurrency && inr > 0) {
                hint.textContent = `≈ ${window.GPLCurrency.format(inr, cur)} (${cur}) estimated`;
                hint.style.display = 'block';
            } else {
                hint.style.display = 'none';
            }
        }
    }

    document.getElementById('modalAmount').addEventListener('input', updateModalCurrencyHint);

    window.addEventListener('gplCurrencyChange', function(e) {
        if (e.detail && e.detail.currency) {
            document.querySelectorAll('.cur-pill-btn').forEach(btn => {
                if (btn.getAttribute('data-cur') === e.detail.currency) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
            updateModalCurrencyHint();
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        const cur = (window.GPLCurrency && window.GPLCurrency.getCurrency()) || 'INR';
        setSponsorCurrency(cur);
    });
</script>

<%- include('../partials/footer') %>
