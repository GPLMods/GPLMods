<%-include('../partials/header') %>

    <style>
        /* GitBook-Inspired Layout */
        .docs-layout {
            display: flex;
            min-height: calc(100vh - 80px);
            background-color: var(--black);
            border-top: 1px solid #222;
        }

        /* --- SIDEBAR STYLES --- */
        .docs-sidebar {
            width: 300px;
            background-color: var(--dark-gray);
            border-right: 1px solid #222;
            padding: 30px 20px;
            overflow-y: auto;
            position: sticky;
            top: 80px;
            height: calc(100vh - 80px);
        }

        .category-group {
            margin-bottom: 12px;
        }

        .category-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 10px;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .category-header:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }

        .category-header.active-cat {
            background-color: rgba(255, 215, 0, 0.1);
            border-left: 3px solid var(--gold);
        }

        .category-title-link {
            color: var(--white);
            font-size: 0.88em;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-grow: 1;
        }

        .category-title-link:hover {
            color: var(--gold);
        }

        .category-count {
            font-size: 0.72em;
            background: #222;
            color: var(--silver);
            padding: 2px 7px;
            border-radius: 10px;
            margin-right: 6px;
        }

        .category-toggle {
            color: var(--silver);
            font-size: 0.75em;
            padding: 4px;
            cursor: pointer;
            transition: transform 0.2s ease;
        }

        .category-page-list {
            list-style: none;
            padding: 0 0 0 12px;
            margin: 4px 0 0 0;
            border-left: 1px solid #333;
        }

        .category-page-list.collapsed {
            display: none;
        }

        .category-page-list li a {
            display: block;
            color: #aaa;
            text-decoration: none;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 0.9em;
            transition: all 0.2s ease;
            margin-bottom: 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .category-page-list li a:hover {
            background-color: rgba(255, 215, 0, 0.05);
            color: var(--gold);
        }

        .category-page-list li a.active {
            background-color: rgba(255, 215, 0, 0.1);
            color: var(--gold);
            font-weight: 600;
            border-left: 3px solid var(--gold);
        }

        .doc-breadcrumbs {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85em;
            color: var(--silver);
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .doc-breadcrumbs a {
            color: var(--silver);
            text-decoration: none;
            transition: color 0.2s;
        }

        .doc-breadcrumbs a:hover {
            color: var(--gold);
        }

        .reading-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(255, 215, 0, 0.12);
            color: var(--gold);
            border: 1px solid var(--gold);
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 0.8em;
            font-weight: 600;
        }

        .category-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 25px;
        }

        .category-article-card {
            background: var(--dark-gray);
            border: 1px solid #333;
            border-radius: 12px;
            padding: 22px;
            display: flex;
            flex-direction: column;
            text-decoration: none;
            transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
        }

        .category-article-card:hover {
            transform: translateY(-4px);
            border-color: var(--gold);
            box-shadow: 0 10px 25px rgba(0,0,0,0.4);
        }

        /* --- MAIN CONTENT STYLES --- */
        .docs-content-area {
            flex-grow: 1;
            padding: 50px 60px;
            max-width: 900px;
            margin: 0 auto;

            /* ✅ THE MAGIC FIX: Prevents <pre> blocks from blowing out the flex layout */
            min-width: 0;
            width: 100%;
        }

        .docs-content-area h1 {
            font-size: 2.8em;
            color: var(--white);
            margin-bottom: 10px;
            line-height: 1.25;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        .docs-content-area .meta {
            color: var(--silver);
            font-size: 0.9em;
            margin-bottom: 30px;
            padding-bottom: 20px;
            line-height: 1.5;
        }

        /* ✅ NEW: Featured Image Style */
        .docs-featured-image {
            width: 100%;
            max-height: 400px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 40px;
            border: 1px solid #333;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        /* Rich Text Formatting */
        .rich-content {
            color: #ccc;
            font-size: 1.1em;
            line-height: 1.8;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        .rich-content h2 {
            color: var(--gold);
            margin-top: 40px;
            margin-bottom: 15px;
            font-size: 1.8em;
            border-bottom: 1px solid #222;
            padding-bottom: 10px;
        }

        .rich-content h3 {
            color: var(--white);
            margin-top: 30px;
            margin-bottom: 10px;
        }

        .rich-content p {
            margin-bottom: 20px;
        }

        .rich-content a {
            color: var(--gold);
            text-decoration: underline;
        }

        .rich-content ul,
        .rich-content ol {
            margin-bottom: 20px;
            padding-left: 20px;
        }

        .rich-content li {
            margin-bottom: 8px;
        }

        .rich-content img {
            max-width: 100%;
            border-radius: 8px;
            margin: 20px 0;
            border: 1px solid #333;
        }

        /* ✅ FIXED: Code Block Scrolling */
        .rich-content pre {
            background-color: #111;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #333;
            margin-bottom: 20px;

            /* Forces horizontal scrolling on mobile instead of page breaking */
            max-width: 100%;
            overflow-x: auto;
            white-space: pre;
        }

        /* Beautiful Scrollbar for Code Blocks */
        .rich-content pre::-webkit-scrollbar {
            height: 8px;
        }

        .rich-content pre::-webkit-scrollbar-track {
            background: #1a1a1a;
            border-radius: 4px;
        }

        .rich-content pre::-webkit-scrollbar-thumb {
            background: var(--gold);
            border-radius: 4px;
        }

        .rich-content code {
            background-color: #222;
            padding: 2px 6px;
            border-radius: 4px;
            font-family: monospace;
            color: var(--gold);
        }

        .rich-content pre code {
            background-color: transparent;
            padding: 0;
            color: #a5d6ff;
        }

        .rich-content blockquote {
            border-left: 4px solid var(--gold);
            margin: 0 0 20px 0;
            padding: 15px 20px;
            background-color: rgba(255, 215, 0, 0.05);
            color: var(--silver);
            font-style: italic;
            border-radius: 0 8px 8px 0;
        }

        /* Mobile Toggle */
        .mobile-docs-toggle {
            display: none;
            background: var(--dark-gray);
            color: var(--gold);
            padding: 15px 20px;
            width: 100%;
            text-align: left;
            border: none;
            border-bottom: 1px solid #333;
            font-weight: bold;
            font-size: 1.1em;
            cursor: pointer;
        }

        @media (max-width: 992px) {
            .docs-layout {
                flex-direction: column;
            }

            .mobile-docs-toggle {
                display: block;
            }

            .docs-sidebar {
                width: 100%;
                height: auto;
                position: static;
                display: none;
                border-right: none;
                border-bottom: 1px solid #222;
            }

            .docs-sidebar.show {
                display: block;
            }

            .docs-content-area {
                padding: 30px 20px;
            }
        }

        @media (max-width: 768px) {
            .docs-content-area h1 {
                font-size: 2em;
                margin-bottom: 10px;
            }

            .docs-content-area .meta {
                font-size: 0.85em;
                padding-bottom: 15px;
                margin-bottom: 20px;
            }

            .rich-content {
                font-size: 1em;
            }
        }
    </style>

    <div class="docs-layout">
        <!-- ======== DYNAMIC GO BACK BUTTON ======== -->
        <%- include('../partials/go-back-button', { fallback: '/' }) %>
        <!-- ======================================== -->

        <!-- Mobile Menu Toggle -->
        <button class="mobile-docs-toggle" id="docsMenuToggle">
            <i class="fas fa-bars" style="margin-right: 10px;"></i> Documentation Menu
        </button>

        <!-- ======== SIDEBAR NAVIGATION ======== -->
        <aside class="docs-sidebar" id="docsSidebar">
            <% if (sidebarStructure && sidebarStructure.length > 0) { %>
                <% sidebarStructure.forEach(category => { %>
                    <% const isCurrentCategoryActive = (typeof isCategoryView !== 'undefined' && isCategoryView && currentCategory && (currentCategory._id.toString() === category._id.toString() || currentCategory.slug === category.slug)) || (currentPage && currentPage.category && (currentPage.category._id.toString() === category._id.toString() || currentPage.category.slug === category.slug)); %>
                    <div class="category-group">
                        <div class="category-header <%= isCurrentCategoryActive ? 'active-cat' : '' %>">
                            <a href="/docs/category/<%= category.slug || slugify(category.name) %>" class="category-title-link">
                                <i class="fas fa-folder-open" style="color: var(--gold); font-size: 0.9em;"></i>
                                <span><%= category.name %></span>
                            </a>
                            <span class="category-count"><%= (category.pages || []).length %></span>
                            <span class="category-toggle" onclick="toggleCategory('<%= category._id %>')" title="Toggle directory">
                                <i class="fas fa-chevron-down" id="toggle-icon-<%= category._id %>"></i>
                            </span>
                        </div>
                        <ul class="category-page-list" id="cat-list-<%= category._id %>">
                            <% (category.pages || []).forEach(page => { %>
                                <li>
                                    <a href="/docs/<%= page.slug %>"
                                        class="<%= (currentPage && currentPage.slug === page.slug) ? 'active' : '' %>">
                                        <i class="far fa-file-alt" style="margin-right: 6px; font-size: 0.85em; opacity: 0.7;"></i>
                                        <%= page.title %>
                                    </a>
                                </li>
                            <% }) %>
                        </ul>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="color: #666; padding: 10px;">No documentation created yet.</p>
            <% } %>
        </aside>

        <!-- ======== MAIN CONTENT AREA ======== -->
        <div class="docs-content-area">
            <% if (typeof isCategoryView !== 'undefined' && isCategoryView && currentCategory) { %>
                <!-- ======== CATEGORY DIRECTORY LANDING VIEW ======== -->
                <div class="doc-breadcrumbs">
                    <a href="/docs"><i class="fas fa-book"></i> Documentation</a>
                    <span>/</span>
                    <span style="color: var(--gold);"><%= currentCategory.name %></span>
                </div>

                <div style="border-bottom: 1px solid #333; padding-bottom: 25px; margin-bottom: 30px;">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 10px;">
                        <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(255, 215, 0, 0.1); border: 1px solid var(--gold); display: flex; align-items: center; justify-content: center; color: var(--gold); font-size: 1.4em;">
                            <i class="fas fa-folder-open"></i>
                        </div>
                        <div>
                            <h1 style="margin: 0; font-size: 2.2em;"><%= currentCategory.name %></h1>
                            <span style="font-size: 0.85em; color: var(--silver);">
                                <%= (currentCategory.pages || []).length %> Articles in this directory
                            </span>
                        </div>
                    </div>
                    <% if (currentCategory.description) { %>
                        <p style="color: var(--silver); margin-top: 15px; font-size: 1.05em; line-height: 1.6;">
                            <%= currentCategory.description %>
                        </p>
                    <% } %>
                </div>

                <% if (currentCategory.pages && currentCategory.pages.length > 0) { %>
                    <div class="category-grid">
                        <% currentCategory.pages.forEach(p => { %>
                            <a href="/docs/<%= p.slug %>" class="category-article-card">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                    <span class="reading-badge">
                                        <i class="fas fa-clock"></i> <%= p.readingTimeMinutes || 2 %> min read
                                    </span>
                                    <span style="font-size: 0.75em; color: #777;">
                                        <%= new Date(p.updatedAt).toLocaleDateString() %>
                                    </span>
                                </div>
                                <h3 style="color: var(--white); font-size: 1.2em; margin-bottom: 10px;"><%= p.title %></h3>
                                <p style="color: var(--silver); font-size: 0.9em; line-height: 1.6; margin-bottom: 18px; flex-grow: 1;">
                                    <%= p.plainSummary || ((p.content || '').replace(/<[^>]+>/g, ' ').slice(0, 140).trim() + '...') %>
                                </p>
                                <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #222; padding-top: 12px; color: var(--gold); font-size: 0.85em; font-weight: 600;">
                                    <span>Read Article</span>
                                    <i class="fas fa-arrow-right"></i>
                                </div>
                            </a>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div style="text-align: center; padding: 60px 0; color: var(--silver);">
                        <i class="far fa-folder-open" style="font-size: 3em; margin-bottom: 15px; opacity: 0.4;"></i>
                        <p>No articles published in this category yet.</p>
                    </div>
                <% } %>

            <% } else if (currentPage) { %>
                <!-- ======== SINGLE ARTICLE VIEW ======== -->
                <div class="doc-breadcrumbs">
                    <a href="/docs"><i class="fas fa-book"></i> Documentation</a>
                    <% if (currentPage.category) { %>
                        <span>/</span>
                        <a href="/docs/category/<%= currentPage.category.slug || slugify(currentPage.category.name) %>">
                            <%= currentPage.category.name %>
                        </a>
                    <% } %>
                    <span>/</span>
                    <span style="color: var(--white);"><%= currentPage.title %></span>
                </div>

                <h1>
                    <%= currentPage.title %>
                </h1>

                <div class="meta" style="display: flex; align-items: center; gap: 15px; flex-wrap: wrap;">
                    <span>Last updated: <%= new Date(currentPage.updatedAt).toLocaleDateString() %></span>
                    <% if (currentPage.category) { %>
                        <span>| Category: 
                            <a href="/docs/category/<%= currentPage.category.slug || slugify(currentPage.category.name) %>" style="color: var(--gold); text-decoration: none;">
                                <%= currentPage.category.name %>
                            </a>
                        </span>
                    <% } %>
                    <span class="reading-badge">
                        <i class="fas fa-clock"></i> <%= currentPage.readingTimeMinutes || 2 %> min read
                    </span>
                </div>

                <!-- ======== FEATURED IMAGE ======== -->
                <% if (currentPage.featuredImageUrl) { %>
                    <img src="<%= currentPage.featuredImageUrl %>" alt="<%= currentPage.title %> Cover"
                        class="docs-featured-image">
                <% } %>

                <div class="rich-content">
                    <%- currentPage.content %>
                </div>

            <% } else { %>
                <div style="text-align: center; padding: 100px 0;">
                    <lottie-player src="<%= cdnUrl %>/animations/docs.json" background="transparent"
                        speed="1"
                        style="width: 120px; height: 120px; margin: 0 auto 15px auto; filter: drop-shadow(0 0 15px rgba(225, 225, 225, 0.5));"
                        autoplay></lottie-player>
                    <h1 style="color: #555;">Welcome to GPL Docs</h1>
                    <p style="color: #666;">Please select an article or category from the sidebar.</p>
                </div>
            <% } %>
        </div>

    </div>

    <script>
        // Simple toggle for mobile sidebar
        document.addEventListener('DOMContentLoaded', () => {
            const toggleBtn = document.getElementById('docsMenuToggle');
            const sidebar = document.getElementById('docsSidebar');
            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener('click', () => {
                    sidebar.classList.toggle('show');
                });
            }
        });

        // Category tree expand/collapse
        function toggleCategory(catId) {
            const list = document.getElementById('cat-list-' + catId);
            const icon = document.getElementById('toggle-icon-' + catId);
            if (!list) return;
            if (list.classList.contains('collapsed')) {
                list.classList.remove('collapsed');
                if (icon) icon.className = 'fas fa-chevron-down';
            } else {
                list.classList.add('collapsed');
                if (icon) icon.className = 'fas fa-chevron-right';
            }
        }
    </script>

    <%- include('../partials/video-ad-modal') %>
        <%- include('../partials/footer') %>