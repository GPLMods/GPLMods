<%-include('../partials/header') %>

<style>
    .page-header { text-align: center; padding: 60px 20px; border-bottom: 1px solid var(--dark-gray); margin-bottom: 30px; }
    .page-header h1 { font-size: 3em; color: var(--white); }
    .page-header h1 span { color: var(--gold); text-shadow: 0 0 4px var(--glow-gold); }
    
    .page-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px; }
    .upload-cta-button { display: inline-block; background: var(--gold); color: var(--black); padding: 12px 30px; border-radius: 30px; text-decoration: none; font-size: 1.1em; font-weight: 600; transition: all 0.3s ease; box-shadow: 0 0 15px var(--glow-gold); }
    .upload-cta-button:hover { transform: translateY(-3px); box-shadow: 0 0 25px var(--glow-gold); }
    
    .filter-section { display: flex; flex-direction: column; gap: 14px; margin-bottom: 30px; width: 100%; }
    .filter-row { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
    .filter-row-label { font-size: 0.85em; text-transform: uppercase; color: var(--silver); letter-spacing: 0.6px; font-weight: 700; min-width: 90px; display: inline-flex; align-items: center; gap: 6px; }
    .filter-tabs { display: flex; flex-wrap: wrap; gap: 8px; flex-grow: 1; }
    .filter-btn { background-color: var(--dark-gray); color: var(--silver); padding: 8px 18px; border: 1px solid #333; border-radius: 20px; cursor: pointer; transition: all 0.25s ease; font-size: 0.85em; font-family: inherit; font-weight: 500; }
    .filter-btn:hover, .filter-btn.active { background-color: var(--gold); color: var(--black); border-color: var(--gold); font-weight: 700; box-shadow: 0 0 10px var(--glow-gold); }

    .status-filter-btn { background-color: var(--dark-gray); color: var(--silver); padding: 8px 16px; border: 1px solid #333; border-radius: 20px; cursor: pointer; transition: all 0.25s ease; font-size: 0.85em; font-family: inherit; display: inline-flex; align-items: center; gap: 6px; font-weight: 500; }
    .status-filter-btn:hover { border-color: var(--gold); color: var(--white); }
    .status-filter-btn.active { background-color: var(--gold); color: var(--black); border-color: var(--gold); font-weight: 700; box-shadow: 0 0 10px var(--glow-gold); }
    .status-count-badge { font-size: 0.8em; padding: 2px 7px; border-radius: 10px; background: rgba(0,0,0,0.3); font-weight: 700; }
    .status-filter-btn.active .status-count-badge { background: rgba(0,0,0,0.25); color: var(--black); }

    .uploads-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 25px; }
    .upload-item { background-color: var(--dark-gray); border-radius: 15px; overflow: hidden; display: flex; flex-direction: column; border: 1px solid #333; transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .upload-item:hover { transform: translateY(-5px); border-color: var(--gold); box-shadow: 0 10px 25px rgba(255, 215, 0, 0.15); }

    .mod-card-image { width: 100%; height: 160px; background-color: #1a1a1a; display: flex; align-items: center; justify-content: center; padding: 15px; border-bottom: 1px solid #222; position: relative; }
    .mod-card-image img { max-width: 100%; max-height: 100%; object-fit: contain; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.4)); }

    .status-badge-top { position: absolute; top: 10px; left: 10px; padding: 5px 12px; border-radius: 20px; font-size: 0.75em; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; z-index: 2; }
    .status-live { background-color: var(--green); color: var(--white); box-shadow: 0 0 10px rgba(67,160,71,0.5); }
    .status-pending, .status-processing { background-color: var(--gold); color: var(--black); box-shadow: 0 0 10px rgba(255,215,0,0.5); }
    .status-draft { background-color: #666; color: var(--white); box-shadow: 0 0 10px rgba(102,102,102,0.5); }
    .status-rejected { background-color: var(--red); color: var(--white); box-shadow: 0 0 10px rgba(229,57,53,0.5); }

    .platform-tag { position: absolute; top: 10px; right: 10px; font-size: 0.75em; font-weight: 700; padding: 5px 12px; border-radius: 20px; color: var(--black); z-index: 2; }

    .mod-card-content { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
    .mod-card-content h3 { font-size: 1.4em; margin-bottom: 15px; color: var(--white); word-break: break-word; }

    .item-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 15px 10px; margin-bottom: 20px; background: #111; padding: 15px; border-radius: 8px; border: 1px solid #222; }
    .stat-row { display: flex; flex-direction: column; }
    .stat-label { color: var(--silver); font-size: 0.8em; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 3px; }
    .stat-value { color: var(--white); font-weight: 600; font-size: 1em; }
    .stat-value.gold { color: var(--gold); }
    .stat-value.green { color: var(--green); }
    
    .rejection-reason { background: rgba(229, 57, 53, 0.1); border: 1px solid var(--red); color: #ffadad; padding: 10px; border-radius: 8px; font-size: 0.85em; margin-bottom: 20px; }

    .item-actions { display: flex; gap: 10px; margin-top: auto; flex-wrap: wrap; }
    .action-btn { flex: 1; text-align: center; padding: 10px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 1px solid transparent; transition: all 0.3s ease; font-size: 0.9em; cursor: pointer; font-family: inherit; display: flex; justify-content: center; align-items: center; gap: 5px; }
    
    .btn-view { background: rgba(33, 150, 243, 0.1); color: var(--blue); border-color: var(--blue); }
    .btn-view:hover { background-color: var(--blue); color: var(--white); }
    .btn-preview { background: var(--gold); color: var(--black); border-color: var(--gold); box-shadow: 0 0 15px var(--glow-gold); }
    .btn-preview:hover { background: var(--white); color: var(--black); border-color: var(--white); box-shadow: 0 0 25px var(--glow-gold); transform: translateY(-3px); }
    .btn-edit { background: rgba(255, 215, 0, 0.1); color: var(--gold); border-color: var(--gold); }
    .btn-edit:hover { background-color: var(--gold); color: var(--black); }
    .btn-delete { background: rgba(229, 57, 53, 0.1); color: var(--red); border-color: var(--red); }
    .btn-delete:hover { background-color: var(--red); color: var(--white); }
    .btn-draft { background: var(--gold); color: var(--black); box-shadow: 0 0 15px var(--glow-gold); }
    .btn-draft:hover { transform: scale(1.05); }

    /* DMCA Restricted Content Section */
    .dmca-restricted-section {
        background: rgba(255, 51, 102, 0.05);
        border: 1px solid rgba(255, 51, 102, 0.3);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 35px;
    }
    .dmca-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 20px;
        border-bottom: 1px solid rgba(255, 51, 102, 0.2);
        padding-bottom: 15px;
    }
    .dmca-section-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .dmca-header-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: rgba(255, 51, 102, 0.15);
        color: #ff3366;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3em;
    }
    .dmca-card-item {
        background-color: var(--dark-gray);
        border-radius: 15px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(255, 51, 102, 0.4);
        position: relative;
    }

    @media (max-width: 768px) {
        .page-actions { flex-direction: column; align-items: flex-start; }
        .filter-tabs { width: 100%; }
    }
</style>

<main>
    <div class="container" style="padding-top: 2rem;">
        <%- include('../partials/go-back-button', { fallback: '/dashboard' }) %>
    </div>

    <div class="page-header" style="padding-top: 20px;">
        <div class="container">
            <h1>My <span>Uploads</span></h1>
        </div>
    </div>
    
    <div class="container">
        <div class="page-actions" style="margin-bottom: 25px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
            <div>
                <% if (typeof quota !== 'undefined' && quota && !quota.canUpload) { %>
                    <button class="upload-cta-button" disabled style="opacity: 0.6; cursor: not-allowed; background: #555; color: #ccc; box-shadow: none;" title="All <%= quota.totalSlots %> upload slots are currently in use by pending submissions">
                        <i class="fas fa-lock" style="margin-right: 6px;"></i> Upload Slots Full (<%= quota.usedSlots %>/<%= quota.totalSlots %>)
                    </button>
                    <a href="/membership" class="btn btn-primary" style="margin-left: 10px; display: inline-block; padding: 10px 18px; border-radius: 20px; background: var(--gold); color: var(--black); font-weight: bold; text-decoration: none;">
                        <i class="fas fa-arrow-up" style="margin-right: 5px;"></i> Upgrade Slots
                    </a>
                <% } else { %>
                    <a href="/upload" class="upload-cta-button"><i class="fas fa-plus-circle" style="margin-right: 6px;"></i> Upload a New Mod</a>
                <% } %>
            </div>

            <% if (typeof quota !== 'undefined' && quota) { %>
                <div style="display: flex; align-items: center; gap: 15px; background: rgba(0,0,0,0.35); padding: 8px 16px; border-radius: 25px; border: 1px solid #333; font-size: 0.88em;">
                    <span><strong style="color: var(--gold);"><i class="fas fa-crown" style="margin-right: 4px;"></i><%= quota.label %></strong></span>
                    <span style="color: #444;">|</span>
                    <span>Slots: <strong style="color: <%= quota.canUpload ? 'var(--white)' : 'var(--red)' %>;"><%= quota.usedSlots %> / <%= quota.totalSlots %></strong></span>
                    <span style="color: #444;">|</span>
                    <span>Max Size: <strong style="color: var(--silver);"><%= quota.maxFileSizeMb >= 1024 ? (quota.maxFileSizeMb / 1024).toFixed(1) + ' GB' : quota.maxFileSizeMb + ' MB' %></strong></span>
                </div>
            <% } %>
        </div>

        <!-- DUAL-AXIS FILTERS: PLATFORM & STATUS -->
        <div class="filter-section">
            <div class="filter-row">
                <span class="filter-row-label"><i class="fas fa-layer-group" style="color: var(--gold);"></i> Platform:</span>
                <div class="filter-tabs" id="platformFilterTabs">
                    <button type="button" class="filter-btn active" data-category="all">All Platforms</button>
                    <button type="button" class="filter-btn" data-category="android">Android</button>
                    <button type="button" class="filter-btn" data-category="ios-jailed">Jailed (IPA)</button>
                    <button type="button" class="filter-btn" data-category="ios-jailbroken">Jailbroken (DEB)</button>
                    <button type="button" class="filter-btn" data-category="windows">Windows</button>
                    <button type="button" class="filter-btn" data-category="wordpress">WordPress</button>
                </div>
            </div>
            <div class="filter-row">
                <span class="filter-row-label"><i class="fas fa-filter" style="color: var(--gold);"></i> Status:</span>
                <div class="filter-tabs" id="statusFilterTabs">
                    <button type="button" class="status-filter-btn active" data-status="all">
                        All Statuses <span class="status-count-badge"><%= (uploads ? uploads.length : 0) + (typeof dmcaUploads !== 'undefined' && dmcaUploads ? dmcaUploads.length : 0) %></span>
                    </button>
                    <button type="button" class="status-filter-btn" data-status="live">
                        <i class="fas fa-check-circle" style="color: var(--green);"></i> Live 
                        <span class="status-count-badge"><%= uploads ? uploads.filter(u => u.status === 'live').length : 0 %></span>
                    </button>
                    <button type="button" class="status-filter-btn" data-status="pending">
                        <i class="fas fa-hourglass-half" style="color: var(--gold);"></i> Pending / Processing 
                        <span class="status-count-badge"><%= uploads ? uploads.filter(u => u.status === 'pending' || u.status === 'processing').length : 0 %></span>
                    </button>
                    <button type="button" class="status-filter-btn" data-status="draft">
                        <i class="fas fa-edit" style="color: #aaa;"></i> Drafts 
                        <span class="status-count-badge"><%= uploads ? uploads.filter(u => u.status === 'draft').length : 0 %></span>
                    </button>
                    <button type="button" class="status-filter-btn" data-status="rejected">
                        <i class="fas fa-times-circle" style="color: var(--red);"></i> Rejected 
                        <span class="status-count-badge"><%= uploads ? uploads.filter(u => u.status === 'rejected').length : 0 %></span>
                    </button>
                    <button type="button" class="status-filter-btn" data-status="dmca">
                        <i class="fas fa-shield-alt" style="color: #ff3366;"></i> DMCA Restricted 
                        <span class="status-count-badge"><%= typeof dmcaUploads !== 'undefined' && dmcaUploads ? dmcaUploads.length : 0 %></span>
                    </button>
                </div>
            </div>
        </div>

        <!-- DMCA Inquiries & Restricted Files Section -->
        <% if (typeof dmcaUploads !== 'undefined' && dmcaUploads && dmcaUploads.length > 0) { %>
            <div class="dmca-restricted-section" id="dmcaRestrictedSection">
                <div class="dmca-section-header">
                    <div class="dmca-section-header-left">
                        <div class="dmca-header-icon">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <div>
                            <h2 style="margin: 0; color: var(--white); font-size: 1.4em;">
                                DMCA Inquiries & <span style="color: #ff3366;">Restricted Files</span>
                            </h2>
                            <p style="margin: 3px 0 0 0; color: var(--silver); font-size: 0.9em;">
                                Files temporarily restricted from public download pending administrative verification.
                            </p>
                        </div>
                    </div>
                    <span style="background: rgba(255, 51, 102, 0.2); color: #ff6688; border: 1px solid #ff3366; padding: 6px 16px; border-radius: 20px; font-weight: 700; font-size: 0.85em; text-transform: uppercase;">
                        <%= dmcaUploads.length %> <%= dmcaUploads.length === 1 ? 'File Under Review' : 'Files Under Review' %>
                    </span>
                </div>

                <div class="uploads-list" style="margin-bottom: 10px;">
                    <% dmcaUploads.forEach(file => { %>
                        <div class="dmca-card-item" data-category="<%= file.category %>" data-status="dmca">
                            <div class="mod-card-image" style="background-color: #120a0d;">
                                <span class="status-badge-top" style="background: #ff3366; color: #fff; box-shadow: 0 0 10px rgba(255, 51, 102, 0.4);">
                                    <i class="fas fa-lock"></i> Restricted (DMCA)
                                </span>
                                <span class="platform-tag <%= file.category.replace('-jailed', '-ipa').replace('-jailbroken', '-deb') %>">
                                    <%= file.category.toUpperCase().replace('-', ' ') %>
                                </span>
                                <img src="<%= file.iconUrl %>" alt="<%= file.name %> Icon">
                            </div>

                            <div class="mod-card-content">
                                <h3><%= file.name %></h3>
                                <div class="item-stats">
                                    <div class="stat-row">
                                        <span class="stat-label">Version</span>
                                        <span class="stat-value"><%= file.version %></span>
                                    </div>
                                    <div class="stat-row">
                                        <span class="stat-label">Status</span>
                                        <span class="stat-value" style="color: #ff6688; font-weight: 700;">Under Review</span>
                                    </div>
                                    <div class="stat-row">
                                        <span class="stat-label">Restricted Since</span>
                                        <span class="stat-value"><%= timeAgo(file.dmcaHiddenAt || file.updatedAt) %></span>
                                    </div>
                                    <div class="stat-row">
                                        <span class="stat-label">Category</span>
                                        <span class="stat-value"><%= file.category %></span>
                                    </div>
                                </div>

                                <div style="background: rgba(255, 51, 102, 0.08); border: 1px solid rgba(255, 51, 102, 0.25); border-radius: 8px; padding: 12px; margin-bottom: 15px; font-size: 0.85em; color: var(--silver); line-height: 1.5;">
                                    <strong style="color: #ff88a3; display: block; margin-bottom: 4px;">
                                        <i class="fas fa-info-circle"></i> Verification In Progress
                                    </strong>
                                    A DMCA copyright claim has been filed regarding this file. Public download links have been temporarily restricted while administrators review the claim. If dismissed as a False Claim, the file will be automatically restored.
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>

        <div class="uploads-list">
            <% if(uploads && uploads.length > 0) { %>
                <% uploads.forEach(file => { %>
                    <div class="upload-item" data-category="<%= file.category %>" data-status="<%= file.status %>">
                        
                        <div class="mod-card-image">
                            <!-- Absolute Status Badge -->
                            <span class="status-badge-top status-<%= file.status === 'processing' ? 'pending' : file.status %>">
                                    <%= file.status === 'processing' ? 'Processing...' : (file.status === 'draft' ? 'Draft' : file.status) %>
                            </span>
                            
                            <!-- Absolute Platform Tag -->
                            <span class="platform-tag <%= file.category.replace('-jailed', '-ipa').replace('-jailbroken', '-deb') %>">
                                <%= file.category.toUpperCase().replace('-', ' ') %>
                            </span>

                            <img src="<%= file.iconUrl %>" alt="<%= file.name %> Icon">
                        </div>
                        
                        <div class="mod-card-content">
                            <h3><%= file.name %></h3>
                            
                            <div class="item-stats">
                                <div class="stat-row">
                                    <span class="stat-label">Downloads</span>
                                    <span class="stat-value"><%= file.downloads.toLocaleString() %></span>
                                </div>
                                <div class="stat-row">
                                    <span class="stat-label">Rating</span>
                                    <span class="stat-value gold"><%= file.averageRating.toFixed(1) %> ★</span>
                                </div>
                                
                                <% const totalVotes = file.workingVoteCount + file.notWorkingVoteCount; %>
                                <% const workingPercentage = totalVotes > 0 ? Math.round((file.workingVoteCount / totalVotes) * 100) + '%' : 'N/A'; %>
                                <div class="stat-row">
                                    <span class="stat-label">Working Vote</span>
                                    <span class="stat-value green"><%= workingPercentage %></span>
                                </div>
                                <div class="stat-row">
                                    <span class="stat-label">Uploaded</span>
                                    <span class="stat-value"><%= new Date(file.createdAt).toLocaleDateString() %></span>
                                </div>
                            </div>

                            <% if (file.status === 'rejected' && file.rejectionReason) { %>
                                <div class="rejection-reason">
                                    <strong>Reason for Rejection:</strong><br>
                                    <%= file.rejectionReason %>
                                </div>
                            <% } %>

                            <div class="item-actions">
                                <% if (file.status === 'processing') { %>
                                    <a href="/mods/<%= file._id %>/preview" target="_blank" class="action-btn btn-preview" style="width: 100%;">
                                        <i class="fas fa-eye"></i> Preview Draft
                                    </a>
                                    <a href="/upload-details/<%= file._id %>" class="action-btn btn-draft" style="width: 100%;">
                                        <i class="fas fa-edit"></i> Finish Draft
                                    </a>
                                    <button class="action-btn btn-delete delete-btn" data-id="<%= file._id %>" data-status="<%= file.status %>" title="Discard Draft">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                <% } else { %>
                                    <% if (file.status === 'draft') { %>
                                        <a href="/mods/<%= file._id %>/preview" target="_blank" class="action-btn btn-preview">
                                            <i class="fas fa-eye"></i> Preview
                                        </a>
                                    <% } %>
                                    <% if (file.status === 'live') { %>
                                        <a href="/mods/<%= file._id %>" class="action-btn btn-view">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                        <!-- ✅ FIX: Restored the Add New Version (Update) Button -->
                                        <a href="/mods/<%= file._id %>/add-version" class="action-btn btn-draft">
                                            <i class="fas fa-arrow-up"></i> Update Mod
                                        </a>
                                    <% } %>
                                    
                                    <a href="/mods/<%= file._id %>/edit" class="action-btn btn-edit">
                                        <i class="fas fa-pen"></i> <%= file.status === 'rejected' ? 'Fix' : (file.status === 'draft' ? 'Resume Draft' : 'Edit Info') %>
                                    </a>

                                    <% if (file.olderVersions && file.olderVersions.length > 0) { %>
                                        <button type="button" class="action-btn btn-secondary manage-versions-btn" data-id="<%= file._id %>" data-versions="<%= JSON.stringify(file.olderVersions) %>">
                                            <i class="fas fa-history"></i> Versions (<%= file.olderVersions.length %>)
                                        </button>
                                    <% } %>
                                    
                                    <button class="action-btn btn-delete delete-btn" data-id="<%= file._id %>" data-status="<%= file.status %>" title="<%= file.status === 'draft' ? 'Discard Draft' : 'Delete Mod' %>">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                <% } %>
                            </div>
                            
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background-color: var(--dark-gray); border-radius: 15px; border: 1px solid #333;">
                    <i class="fas fa-folder-open" style="font-size: 4em; color: #444; margin-bottom: 20px;"></i>
                    <h2 style="color: var(--white); margin-bottom: 10px;">No Uploads Yet</h2>
                    <p style="color: var(--silver); font-size: 1.1em;">You haven't contributed any mods to the platform yet.</p>
                </div>
            <% } %>
        </div> 

        <!-- NO UPLOADS FOUND MATCHING FILTER STATE -->
        <div id="noUploadsFoundBanner" style="display: none; text-align: center; padding: 60px 20px; background: rgba(0,0,0,0.3); border: 1px dashed #444; border-radius: 16px; margin: 30px 0;">
            <i class="fas fa-search" style="font-size: 2.5em; color: var(--silver); margin-bottom: 15px; display: block;"></i>
            <h3 style="color: #fff; margin-bottom: 8px;">No Uploads Found</h3>
            <p style="color: var(--silver); margin-bottom: 20px; font-size: 0.95em;">No uploads match your selected platform and status filter combination.</p>
            <button type="button" id="resetFiltersBtn" class="btn btn-secondary" style="padding: 8px 22px; border-radius: 20px; border: 1px solid var(--gold); color: var(--gold); background: transparent; cursor: pointer; font-weight: 700;">
                <i class="fas fa-undo"></i> Reset Filters
            </button>
        </div>
    </div> 
</main>

<!-- ======== CUSTOM DELETE MODAL ======== -->
<div id="delete-modal-container" class="policy-modal">
    <div class="policy-modal-content" style="background-color: var(--dark-gray); color: var(--white); padding: 30px; text-align: center; border-radius: 15px; max-width: 450px; width: 90%; border-top: 3px solid var(--red); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        <h2 id="delete-modal-title" style="color: var(--red); margin-bottom: 15px;">Delete Mod?</h2>
        <p id="delete-modal-text" style="margin-bottom: 20px; color: var(--silver); line-height: 1.6;">
            Are you absolutely sure you want to delete this mod? This is a permanent action and cannot be undone.
        </p>
        <div class="policy-buttons" style="display: flex; gap: 15px; justify-content: center;">
            <button type="button" class="policy-button" id="confirmDeleteBtn" style="background-color: var(--red); color: var(--white); padding: 10px 25px; border-radius: 20px; font-weight: bold; border: none; cursor: pointer; font-size: 1em; box-shadow: 0 0 15px var(--glow-red);">Yes, Delete</button>
            <button type="button" class="policy-button decline" id="cancelDeleteBtn" style="background-color: transparent; color: var(--silver); border: 2px solid var(--silver); padding: 10px 25px; border-radius: 20px; font-weight: bold; cursor: pointer; font-size: 1em;">Cancel</button>
        </div>
    </div>
</div>

<!-- ======== CUSTOM MANAGE VERSIONS MODAL ======== -->
<div id="versions-modal-container" class="policy-modal">
    <div class="policy-modal-content" style="background-color: var(--dark-gray); color: var(--white); padding: 30px; border-radius: 15px; max-width: 600px; width: 90%; border-top: 3px solid var(--blue); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 style="color: var(--blue); margin: 0;">Manage Old Versions</h2>
            <span class="close-versions-modal" style="color: var(--silver); font-size: 28px; font-weight: bold; cursor: pointer;">&times;</span>
        </div>
        <p style="color: var(--silver); font-size: 0.9em; margin-bottom: 20px;">
            Deleting old versions frees up server space. The current, active version will <strong style="color:var(--white);">not</strong> be affected.
        </p>
        <div id="versions-list-container" style="max-height: 300px; overflow-y: auto; margin-bottom: 20px;">
            <!-- JS will populate this list -->
        </div>
        <div style="border-top: 1px solid #333; padding-top: 20px; text-align: center;">
            <button type="button" id="deleteAllVersionsBtn" class="btn btn-secondary" style="background-color: transparent; color: var(--red); border: 2px solid var(--red); padding: 10px 20px; font-weight: bold; cursor: pointer; transition: all 0.3s ease;">
                <i class="fas fa-trash-alt"></i> Delete ALL Old Versions
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        
        // --- 1. DUAL-AXIS (PLATFORM + STATUS) FILTER LOGIC ---
        const platformButtons = document.querySelectorAll('#platformFilterTabs .filter-btn');
        const statusButtons = document.querySelectorAll('#statusFilterTabs .status-filter-btn');
        const uploadItems = document.querySelectorAll('.upload-item');
        const dmcaCards = document.querySelectorAll('.dmca-card-item');
        const dmcaSection = document.getElementById('dmcaRestrictedSection');
        const noUploadsBanner = document.getElementById('noUploadsFoundBanner');
        const resetFiltersBtn = document.getElementById('resetFiltersBtn');

        let selectedPlatform = 'all';
        let selectedStatus = 'all';

        function applyCombinedFilters() {
            let visibleRegularCount = 0;
            let visibleDmcaCount = 0;

            uploadItems.forEach(item => {
                const itemPlatform = item.dataset.category || '';
                const itemStatus = item.dataset.status || '';

                const platformMatch = (selectedPlatform === 'all' || itemPlatform === selectedPlatform);
                
                let statusMatch = false;
                if (selectedStatus === 'all') {
                    statusMatch = true;
                } else if (selectedStatus === 'live') {
                    statusMatch = (itemStatus === 'live');
                } else if (selectedStatus === 'pending') {
                    statusMatch = (itemStatus === 'pending' || itemStatus === 'processing');
                } else if (selectedStatus === 'draft') {
                    statusMatch = (itemStatus === 'draft');
                } else if (selectedStatus === 'rejected') {
                    statusMatch = (itemStatus === 'rejected');
                } else if (selectedStatus === 'dmca') {
                    statusMatch = false; // DMCA items are in dmcaSection
                }

                if (platformMatch && statusMatch) {
                    item.style.display = 'flex';
                    visibleRegularCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            // Handle DMCA Section
            dmcaCards.forEach(card => {
                const cardPlatform = card.dataset.category || '';
                const platformMatch = (selectedPlatform === 'all' || cardPlatform === selectedPlatform);
                const statusMatch = (selectedStatus === 'all' || selectedStatus === 'dmca');

                if (platformMatch && statusMatch) {
                    card.style.display = 'flex';
                    visibleDmcaCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            if (dmcaSection) {
                if (selectedStatus === 'live' || selectedStatus === 'pending' || selectedStatus === 'draft' || selectedStatus === 'rejected') {
                    dmcaSection.style.display = 'none';
                } else {
                    dmcaSection.style.display = visibleDmcaCount > 0 ? 'block' : 'none';
                }
            }

            const totalVisible = visibleRegularCount + (selectedStatus === 'all' || selectedStatus === 'dmca' ? visibleDmcaCount : 0);
            if (noUploadsBanner) {
                noUploadsBanner.style.display = totalVisible === 0 ? 'block' : 'none';
            }
        }

        platformButtons.forEach(button => {
            button.addEventListener('click', function() {
                platformButtons.forEach(btn => btn.classList.remove('active'));
                this.classList.add('active');
                selectedPlatform = this.dataset.category;
                applyCombinedFilters();
            });
        });

        statusButtons.forEach(button => {
            button.addEventListener('click', function() {
                statusButtons.forEach(btn => btn.classList.remove('active'));
                this.classList.add('active');
                selectedStatus = this.dataset.status;
                applyCombinedFilters();
            });
        });

        if (resetFiltersBtn) {
            resetFiltersBtn.addEventListener('click', () => {
                selectedPlatform = 'all';
                selectedStatus = 'all';
                platformButtons.forEach(btn => btn.classList.toggle('active', btn.dataset.category === 'all'));
                statusButtons.forEach(btn => btn.classList.toggle('active', btn.dataset.status === 'all'));
                applyCombinedFilters();
            });
        }

        // --- 2. MODAL ELEMENTS ---
        const deleteModal = document.getElementById('delete-modal-container');
        const deleteModalTitle = document.getElementById('delete-modal-title');
        const deleteModalText = document.getElementById('delete-modal-text');
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
        const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
        
        const versionsModal = document.getElementById('versions-modal-container');
        const closeVersionsBtn = document.querySelector('.close-versions-modal');
        const versionsListContainer = document.getElementById('versions-list-container');
        
        let deleteActionType = null; 
        let targetModId = null;
        let targetVersionId = null;
        let elementToAnimate = null;

        // --- 3. HELPER FUNCTIONS ---
        function showDeleteModal(title, text) {
            deleteModalTitle.textContent = title;
            deleteModalText.textContent = text;
            deleteModal.style.display = 'flex';
            setTimeout(() => deleteModal.classList.add('show'), 10);
        }

        function closeDeleteModal() {
            deleteModal.classList.remove('show');
            setTimeout(() => {
                deleteModal.style.display = 'none';
                deleteActionType = null;
                targetModId = null;
                targetVersionId = null;
                elementToAnimate = null;
                confirmDeleteBtn.textContent = 'Yes, Delete';
                confirmDeleteBtn.disabled = false;
            }, 200);
        }

        function animateAndRemove(element, onComplete) {
            if (!element) return onComplete && onComplete();
            const currentHeight = element.offsetHeight;
            element.style.height = currentHeight + 'px';
            element.style.transition = 'opacity 0.3s ease, transform 0.3s ease, height 0.5s ease 0.2s, padding 0.5s ease 0.2s, margin 0.5s ease 0.2s, border 0.5s ease 0.2s';
            element.style.opacity = '0';
            element.style.transform = 'scale(0.9)';
            element.style.height = '0px';
            element.style.paddingTop = '0px';
            element.style.paddingBottom = '0px';
            element.style.marginTop = '0px';
            element.style.marginBottom = '0px';
            element.style.borderWidth = '0px';
            element.style.overflow = 'hidden';
            setTimeout(() => {
                element.remove();
                if (onComplete) onComplete();
            }, 700);
        }

        // --- 4. ATTACH LISTENERS ---
        document.querySelectorAll('.delete-btn').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                deleteActionType = 'full-mod';
                targetModId = this.dataset.id;
                const modStatus = this.dataset.status;
                elementToAnimate = this.closest('.upload-item');
                
                if (modStatus === 'processing') {
                    showDeleteModal('Discard Draft?', 'Are you sure you want to delete this draft? The uploaded file will be permanently removed from the server.');
                } else {
                    showDeleteModal('Delete Mod?', 'Are you absolutely sure you want to delete this entire mod? This includes all files, images, and reviews. This is permanent.');
                }
            });
        });

        cancelDeleteBtn.addEventListener('click', closeDeleteModal);

        document.querySelectorAll('.manage-versions-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const modId = this.dataset.id;
                const versions = JSON.parse(this.dataset.versions || '[]');
                
                versionsListContainer.innerHTML = '';
                versions.forEach(v => {
                    const div = document.createElement('div');
                    div.style.cssText = 'display: flex; justify-content: space-between; align-items: center; background: var(--black); padding: 15px; border-radius: 8px; border: 1px solid #333; margin-bottom: 10px;';
                    div.innerHTML = `
                        <div>
                            <strong style="color: var(--gold); display: block;">v${v.version || 'Unknown'}</strong>
                            <span style="color: var(--silver); font-size: 0.85em;">Uploaded: ${new Date(v.createdAt).toLocaleDateString()}</span>
                        </div>
                        <button class="btn btn-secondary delete-single-version-btn" data-mod-id="${modId}" data-version-id="${v._id || v}" style="padding: 5px 15px; font-size: 0.85em; border-color: var(--red); color: var(--red);">Delete</button>
                    `;
                    versionsListContainer.appendChild(div);
                });

                const deleteAllBtn = document.getElementById('deleteAllVersionsBtn');
                const newDeleteAllBtn = deleteAllBtn.cloneNode(true);
                deleteAllBtn.parentNode.replaceChild(newDeleteAllBtn, deleteAllBtn);
                
                newDeleteAllBtn.addEventListener('click', () => {
                    deleteActionType = 'all-versions';
                    targetModId = modId;
                    versionsModal.classList.remove('show');
                    setTimeout(() => {
                        versionsModal.style.display = 'none';
                        showDeleteModal('Delete ALL Old Versions?', 'This will permanently delete all historical files to save space. The current LIVE version will remain safe. Proceed?');
                    }, 200);
                });

                document.querySelectorAll('.delete-single-version-btn').forEach(delBtn => {
                    delBtn.addEventListener('click', function() {
                        deleteActionType = 'single-version';
                        targetModId = this.dataset.modId;
                        targetVersionId = this.dataset.versionId;
                        versionsModal.classList.remove('show');
                        setTimeout(() => {
                            versionsModal.style.display = 'none';
                            showDeleteModal('Delete This Version?', 'Are you sure you want to permanently delete this specific older version of the mod?');
                        }, 200);
                    });
                });

                versionsModal.style.display = 'flex';
                setTimeout(() => versionsModal.classList.add('show'), 10);
            });
        });

        if(closeVersionsBtn) {
            closeVersionsBtn.addEventListener('click', () => {
                versionsModal.classList.remove('show');
                setTimeout(() => { versionsModal.style.display = 'none'; }, 200); 
            });
        }

        // --- 5. MASTER CONFIRMATION HANDLER ---
        confirmDeleteBtn.addEventListener('click', async function() {
            if (!deleteActionType || !targetModId) return;

            confirmDeleteBtn.textContent = 'Deleting...';
            confirmDeleteBtn.disabled = true;

            let apiUrl = '';
            if (deleteActionType === 'full-mod') {
                apiUrl = `/mods/${targetModId}/delete`;
            } else if (deleteActionType === 'single-version') {
                apiUrl = `/mods/${targetModId}/delete-version/${targetVersionId}`;
            } else if (deleteActionType === 'all-versions') {
                apiUrl = `/mods/${targetModId}/delete-all-versions`;
            }

            try {
                const response = await fetch(apiUrl, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                const result = await response.json();
                
                if (result.success) {
                    closeDeleteModal(); 
                    if (deleteActionType === 'full-mod') {
                        animateAndRemove(elementToAnimate);
                    } else {
                        setTimeout(() => window.location.reload(), 300);
                    }
                } else {
                    alert(result.message || 'Failed to delete. Please try again later.');
                    closeDeleteModal();
                }
            } catch (error) {
                console.error('Error:', error);
                alert('A network error occurred.');
                closeDeleteModal();
            }
        });
    });
</script>
