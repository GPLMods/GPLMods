<%- include('../partials/header') %>

<style>
    .payment-status-wrapper {
        max-width: 680px;
        margin: 50px auto 80px auto;
        background: linear-gradient(145deg, rgba(26, 26, 26, 0.95), rgba(18, 18, 18, 0.98));
        padding: 50px 35px;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 15px 45px rgba(0,0,0,0.65);
        border: 1px solid #333;
        position: relative;
        overflow: hidden;
    }

    .payment-status-wrapper::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(90deg, var(--gold, #FFD700), #f39c12, #e67e22);
    }

    .payment-status-wrapper.is-success::before {
        background: linear-gradient(90deg, #2ecc71, #27ae60);
    }
    .payment-status-wrapper.is-error::before {
        background: linear-gradient(90deg, #e74c3c, #c0392b);
    }

    .status-icon-box {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        margin: 0 auto 25px auto;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        position: relative;
    }
    .status-success {
        background: rgba(46, 204, 113, 0.15);
        color: #2ecc71;
        border: 2px solid #2ecc71;
        box-shadow: 0 0 25px rgba(46, 204, 113, 0.35);
    }
    .status-pending {
        background: rgba(241, 196, 15, 0.15);
        color: #f1c40f;
        border: 2px solid #f1c40f;
        box-shadow: 0 0 30px rgba(241, 196, 15, 0.35);
        animation: pulsePending 2s infinite ease-in-out;
    }
    .status-error {
        background: rgba(231, 76, 60, 0.15);
        color: #e74c3c;
        border: 2px solid #e74c3c;
        box-shadow: 0 0 25px rgba(231, 76, 60, 0.35);
    }

    @keyframes pulsePending {
        0% { transform: scale(1); box-shadow: 0 0 15px rgba(241, 196, 15, 0.3); }
        50% { transform: scale(1.05); box-shadow: 0 0 35px rgba(241, 196, 15, 0.55); }
        100% { transform: scale(1); box-shadow: 0 0 15px rgba(241, 196, 15, 0.3); }
    }

    .spinner-ring {
        position: absolute;
        width: 116px;
        height: 116px;
        border: 3px solid transparent;
        border-top-color: #f1c40f;
        border-right-color: #f39c12;
        border-radius: 50%;
        animation: spinRing 1.5s linear infinite;
    }
    @keyframes spinRing {
        to { transform: rotate(360deg); }
    }

    .payment-status-wrapper h1 {
        color: var(--white);
        font-size: 2.1em;
        margin-bottom: 12px;
        font-weight: 700;
        letter-spacing: -0.5px;
    }
    .payment-status-wrapper p.desc {
        color: var(--silver);
        font-size: 1.05em;
        line-height: 1.6;
        margin-bottom: 25px;
        max-width: 560px;
        margin-left: auto;
        margin-right: auto;
    }

    /* Pending Notice Box */
    .pending-notice-box {
        background: rgba(241, 196, 15, 0.08);
        border: 1px solid rgba(241, 196, 15, 0.35);
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 25px;
        text-align: left;
        display: flex;
        align-items: flex-start;
        gap: 14px;
        font-size: 0.93em;
        color: #f1c40f;
        line-height: 1.55;
    }
    .pending-notice-box i {
        font-size: 1.4rem;
        margin-top: 2px;
        flex-shrink: 0;
    }

    /* Step Timeline */
    .pending-timeline {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin: 25px auto 30px auto;
        max-width: 500px;
    }
    .pending-timeline::before {
        content: '';
        position: absolute;
        top: 18px;
        left: 30px;
        right: 30px;
        height: 2px;
        background: #333;
        z-index: 1;
    }
    .timeline-step {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 90px;
        text-align: center;
    }
    .step-circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #222;
        border: 2px solid #444;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #888;
        font-size: 0.85em;
        margin-bottom: 8px;
        transition: all 0.3s;
    }
    .timeline-step.completed .step-circle {
        background: rgba(46, 204, 113, 0.2);
        border-color: #2ecc71;
        color: #2ecc71;
    }
    .timeline-step.active .step-circle {
        background: rgba(241, 196, 15, 0.25);
        border-color: #f1c40f;
        color: #f1c40f;
        box-shadow: 0 0 15px rgba(241, 196, 15, 0.4);
    }
    .step-label {
        font-size: 0.78em;
        color: var(--silver);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .timeline-step.active .step-label {
        color: #f1c40f;
    }

    /* Details Card */
    .details-card {
        background: rgba(0,0,0,0.45);
        border-radius: 14px;
        border: 1px solid #333;
        padding: 22px 25px;
        margin-bottom: 30px;
        text-align: left;
    }
    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px dashed rgba(255, 255, 255, 0.08);
        font-size: 0.95em;
    }
    .detail-row:last-child {
        border-bottom: none;
    }
    .detail-label {
        color: var(--silver);
    }
    .detail-value {
        color: var(--white);
        font-weight: 600;
        word-break: break-all;
        text-align: right;
    }

    .status-badge-live {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.82em;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        letter-spacing: 0.5px;
    }
    .status-badge-live.pending {
        background: rgba(241, 196, 15, 0.2);
        color: #f1c40f;
        border: 1px solid rgba(241, 196, 15, 0.4);
    }
    .status-badge-live.success {
        background: rgba(46, 204, 113, 0.2);
        color: #2ecc71;
        border: 1px solid rgba(46, 204, 113, 0.4);
    }
    .status-badge-live.error {
        background: rgba(231, 76, 60, 0.2);
        color: #e74c3c;
        border: 1px solid rgba(231, 76, 60, 0.4);
    }

    /* Polling timer box */
    .polling-timer-box {
        margin-bottom: 25px;
        font-size: 0.9em;
        color: var(--silver);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    .polling-timer-box span.seconds {
        color: var(--gold);
        font-weight: 700;
    }

    .btn-action-group {
        display: flex;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
    }
    .btn-action {
        padding: 13px 26px;
        border-radius: 10px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s ease;
        font-size: 0.98em;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        cursor: pointer;
        border: none;
    }
    .btn-primary-action {
        background: var(--gold);
        color: var(--black);
        box-shadow: 0 0 18px var(--glow-gold);
    }
    .btn-primary-action:hover {
        background: var(--white);
        transform: translateY(-2px);
    }
    .btn-secondary-action {
        background: rgba(255, 255, 255, 0.07);
        color: var(--silver);
        border: 1px solid #444;
    }
    .btn-secondary-action:hover {
        border-color: var(--gold);
        color: var(--gold);
        background: rgba(255, 255, 255, 0.12);
        transform: translateY(-2px);
    }
    .btn-status-check {
        background: #f1c40f;
        color: #000;
        box-shadow: 0 0 15px rgba(241, 196, 15, 0.3);
    }
    .btn-status-check:hover {
        background: #f39c12;
        transform: translateY(-2px);
    }
</style>

<main class="container">
    <div class="payment-status-wrapper <%= (status === 'success' || status === 'paid') ? 'is-success' : ((status === 'pending' || status === 'active' || status === 'processing') ? 'is-pending' : 'is-error') %>">
        <% if (status === 'success' || status === 'paid') { %>
            <div class="status-icon-box status-success">
                <i class="fas fa-check"></i>
            </div>
        <% } else if (status === 'pending' || status === 'active' || status === 'processing') { %>
            <div class="status-icon-box status-pending">
                <div class="spinner-ring"></div>
                <i class="fas fa-clock"></i>
            </div>
        <% } else { %>
            <div class="status-icon-box status-error">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
        <% } %>

        <h1><%= (status === 'pending' || status === 'active' || status === 'processing') ? 'Payment Pending / Processing' : (title || 'Transaction Status') %></h1>
        
        <p class="desc">
            <% if (status === 'pending' || status === 'active' || status === 'processing') { %>
                Your payment has been initiated and is currently awaiting clearance from your bank or UPI app. Most transactions are confirmed within 2 to 10 minutes.
            <% } else { %>
                <%= message || 'Here is the current status of your transaction.' %>
            <% } %>
        </p>

        <% if (status === 'pending' || status === 'active' || status === 'processing') { %>
            <!-- Timeline Steps for Pending Status -->
            <div class="pending-timeline">
                <div class="timeline-step completed">
                    <div class="step-circle"><i class="fas fa-check"></i></div>
                    <span class="step-label">Initiated</span>
                </div>
                <div class="timeline-step active">
                    <div class="step-circle"><i class="fas fa-sync-alt fa-spin"></i></div>
                    <span class="step-label">Processing</span>
                </div>
                <div class="timeline-step">
                    <div class="step-circle"><i class="fas fa-bolt"></i></div>
                    <span class="step-label">Active</span>
                </div>
            </div>

            <!-- Caution Note -->
            <div class="pending-notice-box">
                <i class="fas fa-info-circle"></i>
                <div>
                    <strong>Please Note:</strong> Do not submit a duplicate payment while this transaction is processing. If your bank debited funds, your membership or donation will be activated automatically as soon as clearance is received.
                </div>
            </div>
        <% } %>

        <% if (orderId || amount) { %>
            <div class="details-card">
                <% if (orderId) { %>
                    <div class="detail-row">
                        <span class="detail-label">Order Reference ID:</span>
                        <span class="detail-value"><code><%= orderId %></code></span>
                    </div>
                <% } %>
                <% if (amount) { %>
                    <div class="detail-row">
                        <span class="detail-label">Amount:</span>
                        <span class="detail-value"><%= currency || 'INR' %> <%= amount %></span>
                    </div>
                <% } %>
                <div class="detail-row">
                    <span class="detail-label">Payment Status:</span>
                    <span class="detail-value">
                        <% if (status === 'success' || status === 'paid') { %>
                            <span class="status-badge-live success"><i class="fas fa-check-circle"></i> COMPLETED / PAID</span>
                        <% } else if (status === 'pending' || status === 'active' || status === 'processing') { %>
                            <span class="status-badge-live pending"><i class="fas fa-clock"></i> PENDING VERIFICATION</span>
                        <% } else { %>
                            <span class="status-badge-live error"><i class="fas fa-times-circle"></i> <%= String(status).toUpperCase() %></span>
                        <% } %>
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Payment Gateway:</span>
                    <span class="detail-value">Cashfree Payments (Instant Settlement)</span>
                </div>
            </div>
        <% } %>

        <% if (status === 'pending' || status === 'active' || status === 'processing') { %>
            <!-- 10-Minute Strict Timeout Tracker Card -->
            <div class="timeout-timer-card" style="background: rgba(231, 76, 60, 0.08); border: 1px solid rgba(231, 76, 60, 0.3); border-radius: 12px; padding: 14px 18px; margin-bottom: 25px; text-align: left; display: flex; align-items: center; justify-content: space-between; gap: 15px; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <i class="fas fa-hourglass-half" style="font-size: 1.5rem; color: #e74c3c;"></i>
                    <div>
                        <div style="font-weight: 700; color: #fff; font-size: 0.95rem;">Confirmation Expiration Window</div>
                        <div style="color: var(--silver); font-size: 0.82rem;">Transactions pending clearance for over 10 minutes are automatically marked as failed.</div>
                    </div>
                </div>
                <div style="background: rgba(0,0,0,0.6); border: 1.5px solid #e74c3c; border-radius: 8px; padding: 6px 14px; text-align: center;">
                    <div style="font-size: 0.7rem; color: #bbb; text-transform: uppercase; letter-spacing: 0.5px;">Auto-Closes In</div>
                    <div id="session-timeout-clock" style="font-family: monospace; font-size: 1.3rem; font-weight: 700; color: #e74c3c;">09:59</div>
                </div>
            </div>

            <div class="polling-timer-box" id="polling-box">
                <i class="fas fa-spinner fa-spin" style="color: var(--gold);"></i>
                <span>Auto-refreshing bank clearance in <span class="seconds" id="countdown-sec">10</span>s...</span>
            </div>
        <% } %>

        <div class="btn-action-group">
            <% if (status === 'pending' || status === 'active' || status === 'processing') { %>
                <button type="button" class="btn-action btn-status-check" id="btn-check-now" onclick="checkCurrentStatus(true);">
                    <i class="fas fa-sync-alt" id="check-icon"></i> Check Status Now
                </button>
                <button type="button" class="btn-action" style="background: rgba(231, 76, 60, 0.2); color: #e74c3c; border: 1px solid rgba(231, 76, 60, 0.4);" onclick="handleSelfCancel();">
                    <i class="fas fa-times-circle"></i> Cancel Payment
                </button>
            <% } %>

            <% if (type === 'membership') { %>
                <a href="/my-membership" class="btn-action btn-secondary-action">
                    <i class="fas fa-id-card"></i> My Membership
                </a>
                <a href="/membership" class="btn-action btn-secondary-action">
                    <i class="fas fa-crown"></i> Membership Plans
                </a>
            <% } else { %>
                <a href="/donate" class="btn-action btn-secondary-action">
                    <i class="fas fa-heart"></i> Donate Page
                </a>
            <% } %>

            <a href="/support" class="btn-action btn-secondary-action">
                <i class="fas fa-headset"></i> Need Help?
            </a>

            <a href="/" class="btn-action btn-primary-action">
                <i class="fas fa-home"></i> Return Home
            </a>
        </div>
    </div>
</main>

<% if (status === 'pending' || status === 'active' || status === 'processing') { %>
<script>
    let pollIntervalSeconds = 10;
    const countdownEl = document.getElementById('countdown-sec');
    const timeoutClockEl = document.getElementById('session-timeout-clock');
    const orderId = "<%= orderId || '' %>";
    const orderType = "<%= type || '' %>";
    let isChecking = false;
    let isCancelled = false;

    // Remaining seconds before strict 10-minute timeout auto-fails transaction
    let remainingTimeoutSec = <%= typeof remainingTimeoutSeconds !== 'undefined' ? remainingTimeoutSeconds : 600 %>;

    function formatTime(totalSeconds) {
        if (totalSeconds <= 0) return "00:00";
        const mins = Math.floor(totalSeconds / 60);
        const secs = totalSeconds % 60;
        return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    if (timeoutClockEl) {
        timeoutClockEl.textContent = formatTime(remainingTimeoutSec);
    }

    async function checkCurrentStatus(manual = false) {
        if (!orderId || isChecking || isCancelled) return;
        isChecking = true;
        const icon = document.getElementById('check-icon');
        if (icon) icon.classList.add('fa-spin');

        try {
            const resp = await fetch(`/api/payment-status?order_id=${encodeURIComponent(orderId)}&type=${encodeURIComponent(orderType)}`);
            const data = await resp.json();
            
            if (data.status === 'paid' || data.status === 'successful' || data.isPaid) {
                window.location.href = `/payment/success?order_id=${encodeURIComponent(orderId)}&type=${encodeURIComponent(orderType)}`;
                return;
            } else if (data.status === 'failed' || data.status === 'expired' || data.status === 'cancelled' || data.timedOut) {
                const failReason = data.reason || 'Payment timed out after 10 minutes.';
                window.location.href = `/payment/failure?order_id=${encodeURIComponent(orderId)}&type=${encodeURIComponent(orderType)}&status=${encodeURIComponent(data.status)}&reason=${encodeURIComponent(failReason)}`;
                return;
            } else if (manual) {
                alert('Payment is still awaiting bank clearance. Transactions taking longer than 10 minutes are automatically marked as failed.');
            }
        } catch (e) {
            console.warn('[Status Poll Error]:', e);
            if (manual) {
                window.location.reload();
            }
        } finally {
            isChecking = false;
            if (icon) icon.classList.remove('fa-spin');
        }
    }

    // 1-second interval loop handling both 10-second polling and 10-minute timeout
    const countdownTimer = setInterval(() => {
        // Decrement 10-minute overall window
        remainingTimeoutSec--;
        if (timeoutClockEl) {
            timeoutClockEl.textContent = formatTime(Math.max(0, remainingTimeoutSec));
        }

        // STRICT 10-MINUTE EXPIRATION:
        if (remainingTimeoutSec <= 0) {
            clearInterval(countdownTimer);
            if (timeoutClockEl) timeoutClockEl.textContent = "EXPIRED";
            window.location.href = `/payment/failure?order_id=${encodeURIComponent(orderId)}&type=${encodeURIComponent(orderType)}&status=timeout&reason=${encodeURIComponent('Payment timed out after 10 minutes.')}`;
            return;
        }

        // Decrement 10-second poll interval
        pollIntervalSeconds--;
        if (countdownEl) countdownEl.textContent = pollIntervalSeconds;
        if (pollIntervalSeconds <= 0) {
            pollIntervalSeconds = 10;
            checkCurrentStatus(false);
        }
    }, 1000);

    function handleSelfCancel() {
        if (typeof window.showCancellationSurvey === 'function') {
            window.showCancellationSurvey({
                orderId: orderId,
                type: orderType,
                onSubmitted: function() {
                    window.location.href = `/payment/failure?order_id=${encodeURIComponent(orderId)}&type=${encodeURIComponent(orderType)}&status=cancelled`;
                }
            });
        } else {
            if (confirm('Are you sure you want to cancel this payment?')) {
                window.location.href = `/payment/failure?order_id=${encodeURIComponent(orderId)}&type=${encodeURIComponent(orderType)}&status=cancelled`;
            }
        }
    }
</script>
<% } %>

<%- include('../partials/footer') %>
