<%- include('../partials/header') %>

<!-- External Libraries for Markdown & Syntax Highlighting -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/line-numbers/prism-line-numbers.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/line-numbers/prism-line-numbers.min.js"></script>

<%
    // Safe lowercase normalization for repository URL and identifiers
    const safeSlug = (source.slug || '').toLowerCase();
    const safeOwner = (cleanOwner || source.githubOwner || '').toLowerCase().replace(/[^a-z0-9_.-]/g, '');
    const safeRepo = (cleanRepo || source.githubRepo || '').toLowerCase().replace(/[^a-z0-9_.-]/g, '');
    const canonicalRepoUrl = (repoUrl || repoData.html_url || ('https://github.com/' + safeOwner + '/' + safeRepo)).toLowerCase();
    const safeFullName = (repoData.full_name || (safeOwner + '/' + safeRepo)).toLowerCase();
    const activeBranchQuery = requestedRef ? ('&ref=' + encodeURIComponent(requestedRef)) : '';
    const activeBranchParam = requestedRef ? ('?ref=' + encodeURIComponent(requestedRef)) : '';
%>

<style>
    :root {
        --gh-border: #30363d;
        --gh-bg-secondary: #161b22;
        --gh-bg-primary: #0d1117;
        --gh-text-muted: #8b949e;
        --gh-text-main: #c9d1d9;
        --gh-btn-bg: #21262d;
        --gh-btn-border: #363b42;
        --gh-btn-hover: #30363d;
        --safe-green: #2ecc71;
        --safe-green-bg: rgba(46, 204, 113, 0.12);
        --safe-green-border: rgba(46, 204, 113, 0.4);
    }

    .source-container {
        max-width: 1200px;
        margin: 2.5rem auto;
        padding: 0 20px;
        box-sizing: border-box;
    }

    /* Repo Header Banner */
    .repo-banner {
        background: linear-gradient(145deg, #141414, #1b1b1b);
        border: 1px solid #333;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

    .repo-top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 12px;
    }

    .repo-title-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        max-width: 100%;
    }

    .repo-icon {
        font-size: 1.8em;
        color: var(--gold);
        flex-shrink: 0;
    }

    .repo-title {
        font-size: 1.6em;
        color: var(--white);
        margin: 0;
        font-weight: 700;
        letter-spacing: -0.5px;
        word-break: break-word;
        overflow-wrap: anywhere;
    }

    .repo-title a {
        color: var(--white);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .repo-title a:hover {
        color: var(--gold);
    }

    .repo-badges-wrap {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .repo-badge {
        font-size: 0.75rem;
        padding: 4px 10px;
        border-radius: 20px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
    }

    .repo-badge.public {
        background: var(--safe-green-bg);
        color: var(--safe-green);
        border: 1px solid var(--safe-green-border);
    }

    .repo-badge.private {
        background: rgba(255, 215, 0, 0.12);
        color: var(--gold);
        border: 1px solid rgba(255, 215, 0, 0.4);
    }

    .repo-badge.safety-verified {
        background: rgba(46, 204, 113, 0.16);
        color: #2ecc71;
        border: 1px solid rgba(46, 204, 113, 0.5);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .repo-badge.safety-verified:hover {
        background: rgba(46, 204, 113, 0.25);
        box-shadow: 0 0 10px rgba(46, 204, 113, 0.3);
    }

    .repo-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-gh {
        background: var(--gh-btn-bg);
        border: 1px solid var(--gh-btn-border);
        color: var(--white);
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    .btn-gh:hover {
        background: var(--gh-btn-hover);
        border-color: #8b949e;
        color: var(--gold);
        text-decoration: none;
    }

    .btn-gh-primary {
        background: var(--gold);
        color: var(--black);
        border: 1px solid var(--gold);
        font-weight: 700;
    }

    .btn-gh-primary:hover {
        background: #ffe033;
        color: var(--black);
        box-shadow: 0 0 15px var(--glow-gold);
    }

    .repo-desc {
        color: var(--silver);
        font-size: 0.96rem;
        line-height: 1.6;
        margin: 10px 0 16px;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .repo-meta-bar {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        font-size: 0.88rem;
        color: var(--gh-text-muted);
        border-top: 1px solid rgba(255, 255, 255, 0.07);
        padding-top: 14px;
    }

    .repo-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .repo-meta-item strong {
        color: var(--white);
    }

    /* Alerts */
    .source-alert {
        padding: 14px 18px;
        border-radius: 8px;
        margin-bottom: 22px;
        font-size: 0.92rem;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .source-alert.warning {
        background: rgba(243, 156, 18, 0.12);
        color: #f39c12;
        border: 1px solid rgba(243, 156, 18, 0.4);
    }

    .source-alert.info {
        background: rgba(52, 152, 219, 0.12);
        color: #3498db;
        border: 1px solid rgba(52, 152, 219, 0.4);
    }

    .source-alert.success {
        background: var(--safe-green-bg);
        color: var(--safe-green);
        border: 1px solid var(--safe-green-border);
    }

    /* Tab Navigation */
    .source-tabs {
        display: flex;
        gap: 6px;
        border-bottom: 1px solid var(--gh-border);
        margin-bottom: 20px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 4px;
        scrollbar-width: none;
    }

    .source-tabs::-webkit-scrollbar {
        display: none;
    }

    .tab-btn {
        background: transparent;
        border: none;
        color: var(--gh-text-muted);
        padding: 10px 16px;
        font-size: 0.92rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-bottom: 3px solid transparent;
        text-decoration: none;
        transition: color 0.15s ease, border-color 0.15s ease;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .tab-btn:hover {
        color: var(--white);
        text-decoration: none;
    }

    .tab-btn.active {
        color: var(--gold);
        border-bottom-color: var(--gold);
    }

    .tab-count {
        background: rgba(255, 255, 255, 0.1);
        color: var(--white);
        border-radius: 12px;
        padding: 2px 7px;
        font-size: 0.75rem;
    }

    /* Breadcrumbs Toolbar */
    .source-subbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 16px;
    }

    .breadcrumbs {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.92rem;
        background: var(--gh-bg-secondary);
        padding: 8px 14px;
        border-radius: 8px;
        border: 1px solid var(--gh-border);
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        white-space: nowrap;
        max-width: 100%;
        scrollbar-width: none;
    }

    .breadcrumbs::-webkit-scrollbar {
        display: none;
    }

    .breadcrumb-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .breadcrumb-item a {
        color: var(--gold);
        text-decoration: none;
        font-weight: 500;
    }

    .breadcrumb-item a:hover {
        text-decoration: underline;
    }

    .breadcrumb-item.active {
        color: var(--white);
        font-weight: 600;
    }

    .breadcrumb-separator {
        color: var(--gh-text-muted);
    }

    .branch-indicator {
        background: var(--gh-bg-secondary);
        border: 1px solid var(--gh-border);
        color: var(--white);
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    /* Directory Table */
    .file-box {
        background: var(--gh-bg-primary);
        border: 1px solid var(--gh-border);
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 26px;
    }

    .file-box-header {
        background: var(--gh-bg-secondary);
        border-bottom: 1px solid var(--gh-border);
        padding: 12px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.88rem;
        color: var(--gh-text-muted);
        flex-wrap: wrap;
        gap: 8px;
    }

    .file-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.92rem;
    }

    .file-table tr {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        transition: background-color 0.15s ease;
    }

    .file-table tr:hover {
        background-color: rgba(255, 255, 255, 0.03);
    }

    .file-table td {
        padding: 11px 16px;
        vertical-align: middle;
    }

    .file-table .col-icon {
        width: 32px;
        text-align: center;
        color: var(--gh-text-muted);
        padding-right: 0;
    }

    .file-table .col-name {
        font-weight: 500;
    }

    .file-table .col-name a {
        color: var(--gh-text-main);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        word-break: break-word;
    }

    .file-table .col-name a:hover {
        color: var(--gold);
        text-decoration: underline;
    }

    .file-table .col-size {
        text-align: right;
        color: var(--gh-text-muted);
        font-family: monospace;
        font-size: 0.85rem;
        white-space: nowrap;
        width: 110px;
    }

    .file-table .col-action {
        text-align: right;
        width: 80px;
    }

    .file-link-dir {
        font-weight: 600 !important;
        color: var(--white) !important;
    }

    .icon-folder {
        color: var(--gold);
    }

    .icon-file {
        color: var(--silver);
    }

    .empty-folder {
        padding: 40px 20px;
        text-align: center;
        color: var(--gh-text-muted);
    }

    /* Single File Code & Media Viewer */
    .code-viewer-box {
        background: var(--gh-bg-primary);
        border: 1px solid var(--gh-border);
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 26px;
    }

    .code-viewer-header {
        background: var(--gh-bg-secondary);
        border-bottom: 1px solid var(--gh-border);
        padding: 12px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .file-info-badge {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.88rem;
        color: var(--silver);
        flex-wrap: wrap;
    }

    .file-info-badge strong {
        color: var(--white);
        word-break: break-all;
    }

    .code-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn-code-tool {
        background: var(--gh-btn-bg);
        border: 1px solid var(--gh-btn-border);
        color: var(--white);
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.15s ease;
        box-sizing: border-box;
    }

    .btn-code-tool:hover {
        background: var(--gh-btn-hover);
        color: var(--gold);
        border-color: #8b949e;
        text-decoration: none;
    }

    .btn-code-tool.copied {
        background: rgba(46, 204, 113, 0.2);
        color: #2ecc71;
        border-color: #2ecc71;
    }

    .code-viewport {
        margin: 0;
        background: #0b0e14 !important;
        border-radius: 0;
        font-family: 'JetBrains Mono', 'Fira Code', Consolas, 'Courier New', monospace;
        font-size: 0.88rem;
        line-height: 1.55;
        padding: 16px 0 !important;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-width: 100%;
        box-sizing: border-box;
    }

    .image-preview-container {
        padding: 30px 20px;
        text-align: center;
        background: #090c10;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .image-preview-container img {
        max-width: 100%;
        max-height: 520px;
        object-fit: contain;
        border-radius: 6px;
        border: 1px solid var(--gh-border);
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }

    /* README & License Markdown Boxes */
    .readme-card, .license-card-box {
        background: var(--gh-bg-primary);
        border: 1px solid var(--gh-border);
        border-radius: 10px;
        margin-bottom: 30px;
        overflow: hidden;
    }

    .readme-header, .license-header-box {
        background: var(--gh-bg-secondary);
        border-bottom: 1px solid var(--gh-border);
        padding: 12px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 600;
        color: var(--white);
        font-size: 0.92rem;
        flex-wrap: wrap;
        gap: 8px;
    }

    .readme-body, .license-body-box {
        padding: 24px;
        color: var(--gh-text-main);
        line-height: 1.7;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .readme-body h1, .readme-body h2, .readme-body h3, .readme-body h4 {
        color: var(--white);
        margin: 20px 0 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--gh-border);
        word-break: break-word;
    }

    .readme-body h1 { font-size: 1.7em; }
    .readme-body h2 { font-size: 1.35em; }
    .readme-body h3 { font-size: 1.15em; }

    .readme-body p { margin-bottom: 14px; }

    .readme-body ul, .readme-body ol {
        padding-left: 24px;
        margin-bottom: 14px;
    }

    .readme-body li { margin-bottom: 5px; }

    .readme-body a {
        color: var(--gold);
        text-decoration: underline;
    }

    .readme-body pre {
        background: #000;
        padding: 14px;
        border-radius: 8px;
        border: 1px solid var(--gh-border);
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        margin: 14px 0;
        max-width: 100%;
        box-sizing: border-box;
    }

    .readme-body code {
        background: rgba(255, 255, 255, 0.1);
        padding: 2px 6px;
        border-radius: 4px;
        font-family: monospace;
        color: #ffadad;
        font-size: 0.9em;
    }

    .readme-body pre code {
        background: transparent;
        padding: 0;
        color: #e6edf3;
    }

    .readme-body blockquote {
        border-left: 4px solid var(--gold);
        padding-left: 14px;
        margin: 14px 0;
        color: var(--gh-text-muted);
    }

    .readme-body table {
        width: 100%;
        border-collapse: collapse;
        margin: 14px 0;
        display: block;
        max-width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .readme-body th, .readme-body td {
        border: 1px solid var(--gh-border);
        padding: 8px 12px;
    }

    .readme-body th {
        background: var(--gh-bg-secondary);
        color: var(--white);
    }

    .readme-body img {
        max-width: 100% !important;
        height: auto !important;
        border-radius: 6px;
    }

    /* License Tab Specifics */
    .license-meta-overview {
        background: var(--gh-bg-secondary);
        border: 1px solid var(--gh-border);
        border-radius: 10px;
        padding: 22px;
        margin-bottom: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .license-meta-title {
        font-size: 1.3em;
        color: var(--white);
        margin: 0 0 6px;
        display: flex;
        align-items: center;
        gap: 10px;
        word-break: break-word;
    }

    .license-meta-spdx {
        font-size: 0.85rem;
        background: rgba(255, 215, 0, 0.15);
        color: var(--gold);
        border: 1px solid var(--gold);
        padding: 3px 8px;
        border-radius: 6px;
        font-weight: 700;
        font-family: monospace;
    }

    .license-raw-container {
        background: #080808;
        border: 1px solid var(--gh-border);
        border-radius: 8px;
        padding: 18px;
        font-family: monospace;
        font-size: 0.88rem;
        line-height: 1.6;
        color: var(--silver);
        white-space: pre-wrap;
        word-break: break-all;
        max-height: 600px;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    /* Releases Timeline */
    .release-timeline {
        border-left: 2px solid var(--gh-border);
        padding-left: 26px;
        margin-left: 8px;
    }

    .release-card {
        background: var(--gh-bg-primary);
        border: 1px solid var(--gh-border);
        border-radius: 10px;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

    .release-card::before {
        content: '';
        position: absolute;
        left: -35px;
        top: 20px;
        width: 16px;
        height: 16px;
        background: var(--gh-bg-secondary);
        border: 2px solid var(--silver);
        border-radius: 50%;
    }

    .release-card.latest::before {
        border-color: var(--gold);
        background: var(--gold);
        box-shadow: 0 0 10px var(--glow-gold);
    }

    .release-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--gh-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        background: var(--gh-bg-secondary);
    }

    .release-name {
        font-size: 1.3em;
        color: var(--gold);
        margin: 0 0 4px;
        word-break: break-word;
    }

    .release-tag {
        background: #333;
        color: var(--white);
        padding: 4px 10px;
        border-radius: 6px;
        font-family: monospace;
        font-size: 0.85em;
        white-space: nowrap;
    }

    .release-date {
        color: var(--gh-text-muted);
        font-size: 0.85em;
    }

    .release-body {
        padding: 20px;
        color: var(--silver);
        line-height: 1.6;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .release-footer {
        padding: 14px 20px;
        background: var(--gh-bg-secondary);
        border-top: 1px solid var(--gh-border);
    }

    .tab-pane {
        display: none;
    }

    .tab-pane.active {
        display: block;
    }

    /* URL Safety Verification Modal */
    .url-safety-modal {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(6px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 999999;
        padding: 16px;
        box-sizing: border-box;
    }

    .url-safety-modal.show {
        display: flex;
    }

    .url-safety-card {
        background: #161b22;
        border: 1px solid var(--gh-border);
        border-radius: 12px;
        max-width: 480px;
        width: 100%;
        padding: 22px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7);
        color: var(--gh-text-main);
        animation: safetyFadeIn 0.2s ease-out;
    }

    @keyframes safetyFadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }

    /* ============================================================ */
    /* RESPONSIVE MOBILE OPTIMIZATION (down to 320px)               */
    /* ============================================================ */
    @media (max-width: 768px) {
        .source-container {
            margin: 1rem auto;
            padding: 0 12px;
            width: 100%;
        }

        .repo-banner {
            padding: 16px 14px;
            border-radius: 10px;
            margin-bottom: 16px;
        }

        .repo-top-row {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }

        .repo-title-wrap {
            align-items: flex-start;
            gap: 8px;
            width: 100%;
        }

        .repo-icon {
            font-size: 1.4em;
            margin-top: 2px;
        }

        .repo-title {
            font-size: 1.22em;
            line-height: 1.35;
        }

        .repo-badges-wrap {
            width: 100%;
            margin-top: 4px;
        }

        .repo-actions {
            width: 100%;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .repo-actions .btn-gh {
            flex: 1 1 calc(50% - 4px);
            min-width: 130px;
            padding: 10px 12px;
            font-size: 0.85rem;
            text-align: center;
        }

        .repo-desc {
            font-size: 0.88rem;
            margin: 8px 0 12px;
            line-height: 1.5;
        }

        .repo-meta-bar {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            font-size: 0.8rem;
            padding-top: 12px;
        }

        .source-tabs {
            gap: 4px;
            margin-bottom: 16px;
        }

        .tab-btn {
            padding: 9px 12px;
            font-size: 0.85rem;
            min-height: 42px;
        }

        .source-subbar {
            flex-direction: column;
            align-items: stretch;
            gap: 8px;
            margin-bottom: 12px;
        }

        .breadcrumbs {
            padding: 8px 10px;
            font-size: 0.82rem;
            width: 100%;
            box-sizing: border-box;
        }

        .branch-indicator {
            align-self: flex-start;
            font-size: 0.78rem;
            padding: 4px 10px;
        }

        .file-box {
            margin-bottom: 20px;
            border-radius: 8px;
        }

        .file-box-header {
            padding: 10px 12px;
            font-size: 0.82rem;
        }

        .file-table {
            table-layout: fixed;
            width: 100%;
        }

        .file-table td {
            padding: 9px 8px;
            font-size: 0.84rem;
        }

        .file-table .col-icon {
            width: 26px;
        }

        .file-table .col-name {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 0;
            width: 100%;
        }

        .file-table .col-name a {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 100%;
            display: inline-block;
        }

        .file-table .col-size {
            display: none;
        }

        .file-table .col-action {
            width: 54px;
            padding-left: 0;
        }

        .code-viewer-box {
            margin-bottom: 20px;
            border-radius: 8px;
        }

        .code-viewer-header {
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
            padding: 12px;
        }

        .file-info-badge {
            font-size: 0.8rem;
            gap: 6px;
        }

        .code-actions {
            width: 100%;
            display: flex;
            gap: 6px;
        }

        .code-actions .btn-code-tool {
            flex: 1;
            padding: 8px 6px;
            font-size: 0.76rem;
            justify-content: center;
        }

        .code-viewport {
            font-size: 0.78rem;
            padding: 10px 0 !important;
        }

        .readme-body, .license-body-box {
            padding: 16px 12px;
            font-size: 0.88rem;
        }

        .readme-body h1 { font-size: 1.35em; }
        .readme-body h2 { font-size: 1.18em; }
        .readme-body h3 { font-size: 1.05em; }

        .readme-body pre {
            padding: 10px;
            font-size: 0.78rem;
        }

        .license-meta-overview {
            flex-direction: column;
            align-items: stretch;
            padding: 14px 12px;
            gap: 10px;
        }

        .license-raw-container {
            padding: 12px 10px;
            font-size: 0.76rem;
            max-height: 380px;
        }

        .release-timeline {
            padding-left: 18px;
            margin-left: 4px;
        }

        .release-card::before {
            left: -25px;
            width: 13px;
            height: 13px;
            top: 16px;
        }

        .release-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
            padding: 12px 14px;
        }

        .release-name {
            font-size: 1.15em;
        }

        .release-body {
            padding: 12px 14px;
            font-size: 0.86rem;
        }

        .release-footer {
            padding: 10px 14px;
        }

        .release-footer .btn-gh {
            width: 100%;
            justify-content: center;
        }
    }

    @media (max-width: 480px) {
        .repo-meta-bar {
            grid-template-columns: 1fr;
            gap: 6px;
        }

        .repo-actions .btn-gh {
            flex: 1 1 100%;
        }

        .file-info-badge {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<main class="container">
    <div class="source-container">

        <!-- Top Repo Banner -->
        <section class="repo-banner">
            <div class="repo-top-row">
                <div class="repo-title-wrap">
                    <i class="fab fa-github repo-icon" aria-hidden="true"></i>
                    <h1 class="repo-title">
                        <a href="/source/<%= encodeURIComponent(safeSlug) %>"><%= safeFullName %></a>
                    </h1>
                    <div class="repo-badges-wrap">
                        <span class="repo-badge <%= source.isPrivate ? 'private' : 'public' %>">
                            <i class="fas <%= source.isPrivate ? 'fa-lock' : 'fa-globe' %>"></i>
                            <%= source.isPrivate ? 'Private' : 'Public' %>
                        </span>
                        <span class="repo-badge safety-verified" id="repoSafetyBadge" title="URL Safety: Verified Official GitHub Repository with HTTPS">
                            <i class="fas fa-shield-halved"></i>
                            <span>Verified GitHub</span>
                        </span>
                    </div>
                </div>

                <div class="repo-actions">
                    <% if (hasAccess) { %>
                        <a href="/source/<%= encodeURIComponent(safeSlug) %>/download/<%= encodeURIComponent(currentRef) %>" class="btn-gh btn-gh-primary">
                            <i class="fas fa-file-archive"></i> Download ZIP
                        </a>
                    <% } %>
                    <a href="<%= canonicalRepoUrl %>" target="_blank" rel="noopener noreferrer nofollow" class="btn-gh external-github-link" data-safe-url="<%= canonicalRepoUrl %>">
                        <i class="fab fa-github"></i> GitHub <i class="fas fa-external-link-alt" style="font-size: 0.75em;"></i>
                    </a>
                </div>
            </div>

            <p class="repo-desc"><%= repoData.description || source.description || 'Source code repository for GPL Mods.' %></p>

            <div class="repo-meta-bar">
                <div class="repo-meta-item">
                    <i class="fas fa-code-branch"></i>
                    Branch: <strong><%= currentRef %></strong>
                </div>
                <div class="repo-meta-item">
                    <i class="fas fa-star text-gold"></i>
                    Stars: <strong><%= (repoData.stargazers_count || 0).toLocaleString() %></strong>
                </div>
                <div class="repo-meta-item">
                    <i class="fas fa-code-fork"></i>
                    Forks: <strong><%= (repoData.forks_count || 0).toLocaleString() %></strong>
                </div>
                <% if (license && license.name) { %>
                    <div class="repo-meta-item">
                        <i class="fas fa-scale-balanced text-gold"></i>
                        License: <strong><%= license.spdxId || license.name %></strong>
                    </div>
                <% } %>
            </div>
        </section>

        <!-- Access or API Warnings -->
        <% if (!hasAccess) { %>
            <div class="source-alert warning">
                <i class="fas fa-lock" style="font-size: 1.3em;"></i>
                <div>
                    <strong>Restricted Access Repository:</strong>
                    Your account does not have permission to download full source archives for this repository. Contact an administrator for access.
                </div>
            </div>
        <% } %>

        <% if (apiError) { %>
            <div class="source-alert info">
                <i class="fas fa-info-circle" style="font-size: 1.3em;"></i>
                <div>
                    <strong>Repository Notice:</strong> <%= apiError %>
                </div>
            </div>
        <% } %>

        <!-- Navigation Tabs -->
        <nav class="source-tabs" aria-label="Source navigation tabs">
            <a href="?tab=code<%= currentPath ? '&path=' + encodeURIComponent(currentPath) : '' %><%= activeBranchQuery %>" 
               class="tab-btn <%= (activeTab === 'code' || !activeTab) ? 'active' : '' %>" data-tab="tab-code">
                <i class="fas fa-code"></i> Code
            </a>
            <% if (readme) { %>
                <a href="?tab=readme<%= activeBranchQuery %>" 
                   class="tab-btn <%= activeTab === 'readme' ? 'active' : '' %>" data-tab="tab-readme">
                    <i class="fas fa-book-open"></i> README
                    <span class="tab-count">Doc</span>
                </a>
            <% } %>
            <% if (license) { %>
                <a href="?tab=license<%= activeBranchQuery %>" 
                   class="tab-btn <%= activeTab === 'license' ? 'active' : '' %>" data-tab="tab-license">
                    <i class="fas fa-scale-balanced"></i> License
                    <% if (license.spdxId && license.spdxId !== 'Custom') { %>
                        <span class="tab-count"><%= license.spdxId %></span>
                    <% } %>
                </a>
            <% } %>
            <a href="?tab=releases<%= activeBranchQuery %>" 
               class="tab-btn <%= activeTab === 'releases' ? 'active' : '' %>" data-tab="tab-releases">
                <i class="fas fa-tag"></i> Releases
                <span class="tab-count"><%= releases.length %></span>
            </a>
        </nav>

        <!-- ============================================== -->
        <!-- TAB 1: CODE (Explorer or Single File Code View) -->
        <!-- ============================================== -->
        <div id="tab-code" class="tab-pane <%= (activeTab === 'code' || !activeTab) ? 'active' : '' %>">
            
            <!-- Breadcrumbs Toolbar -->
            <div class="source-subbar">
                <div class="breadcrumbs">
                    <span class="breadcrumb-item">
                        <i class="fas fa-folder-open icon-folder"></i>
                        <a href="/source/<%= encodeURIComponent(safeSlug) %><%= activeBranchParam %>"><%= safeSlug %></a>
                    </span>

                    <% if (breadcrumbs && breadcrumbs.length) { %>
                        <% breadcrumbs.forEach(crumb => { %>
                            <span class="breadcrumb-separator">/</span>
                            <span class="breadcrumb-item <%= crumb.isLast ? 'active' : '' %>">
                                <% if (crumb.isLast) { %>
                                    <%= crumb.name %>
                                <% } else { %>
                                    <a href="/source/<%= encodeURIComponent(safeSlug) %>?path=<%= encodeURIComponent(crumb.path) %><%= activeBranchQuery %>"><%= crumb.name %></a>
                                <% } %>
                            </span>
                        <% }) %>
                    <% } %>
                </div>

                <div class="branch-indicator">
                    <i class="fas fa-code-branch text-gold"></i>
                    <span><%= currentRef %></span>
                </div>
            </div>

            <% if (isViewingFile && fileData) { %>
                <% 
                    const lowerFileName = (fileData.name || '').toLowerCase();
                    const isImageFile = /\.(png|jpg|jpeg|gif|svg|webp|ico|bmp)$/i.test(lowerFileName);
                    const rawFileEndpoint = `/source/${encodeURIComponent(safeSlug)}/raw?path=${encodeURIComponent(fileData.path)}${activeBranchQuery}`;
                %>

                <!-- SINGLE FILE CODE / MEDIA VIEWER -->
                <div class="code-viewer-box">
                    <div class="code-viewer-header">
                        <div class="file-info-badge">
                            <i class="far <%= isImageFile ? 'fa-image' : 'fa-file-code' %> icon-file"></i>
                            <strong><%= fileData.name %></strong>
                            <% if (!isImageFile && fileData.lines) { %>
                                <span>&bull;</span>
                                <span><%= fileData.lines %> lines</span>
                            <% } %>
                            <% if (fileData.sizeFormatted) { %>
                                <span>&bull;</span>
                                <span><%= fileData.sizeFormatted %></span>
                            <% } %>
                        </div>

                        <div class="code-actions">
                            <% if (!isImageFile && fileData.content) { %>
                                <button type="button" class="btn-code-tool" id="copyRawBtn" onclick="copySourceCode()" title="Copy raw file content to clipboard">
                                    <i class="far fa-copy"></i> Copy
                                </button>
                            <% } %>
                            <a href="<%= rawFileEndpoint %>" 
                               target="_blank" rel="noopener noreferrer nofollow" class="btn-code-tool" title="View raw text in browser">
                                <i class="fas fa-external-link-alt"></i> Raw
                            </a>
                            <a href="<%= rawFileEndpoint %>" 
                               download="<%= fileData.name %>" class="btn-code-tool" title="Download this file">
                                <i class="fas fa-download"></i> Download
                            </a>
                        </div>
                    </div>

                    <% if (isImageFile) { %>
                        <div class="image-preview-container">
                            <img src="<%= rawFileEndpoint %>" alt="<%= fileData.name %>" loading="lazy" />
                        </div>
                    <% } else if (fileData.content) { %>
                        <pre class="code-viewport line-numbers"><code id="sourceCodeBlock" class="language-<%= fileData.language %>"><%= fileData.content %></code></pre>
                        <textarea id="hiddenRawCode" style="position: absolute; left: -9999px;" aria-hidden="true"><%= fileData.content %></textarea>
                    <% } else { %>
                        <div class="empty-folder">
                            <i class="fas fa-file-alt" style="font-size: 2.8rem; margin-bottom: 12px; color: #555;"></i>
                            <p>File content could not be previewed directly (file may be binary or exceeds display size limit).</p>
                            <div style="margin-top: 12px; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
                                <a href="<%= rawFileEndpoint %>" target="_blank" class="btn-gh" style="font-size: 0.85rem;">
                                    <i class="fas fa-external-link-alt"></i> Open Raw View
                                </a>
                                <a href="<%= canonicalRepoUrl %>/blob/<%= encodeURIComponent(currentRef) %>/<%= encodeURIComponent(fileData.path) %>" target="_blank" rel="noopener noreferrer nofollow" class="btn-gh external-github-link" data-safe-url="<%= canonicalRepoUrl %>/blob/<%= encodeURIComponent(currentRef) %>/<%= encodeURIComponent(fileData.path) %>" style="font-size: 0.85rem;">
                                    <i class="fab fa-github"></i> View on GitHub
                                </a>
                            </div>
                        </div>
                    <% } %>
                </div>

            <% } else { %>

                <!-- DIRECTORY TREE EXPLORER -->
                <div class="file-box">
                    <div class="file-box-header">
                        <div>
                            <i class="fas fa-folder-tree text-gold"></i>
                            <span><%= currentPath ? currentPath : 'Repository Root' %></span>
                        </div>
                        <div>
                            <span><%= directoryItems ? directoryItems.length : 0 %> items</span>
                        </div>
                    </div>

                    <% if (directoryItems && directoryItems.length) { %>
                        <table class="file-table">
                            <tbody>
                                <% if (parentPath !== null) { %>
                                    <tr>
                                        <td class="col-icon"><i class="fas fa-level-up-alt text-gold"></i></td>
                                        <td class="col-name" colspan="3">
                                            <a href="/source/<%= encodeURIComponent(safeSlug) %><%= parentPath ? '?path=' + encodeURIComponent(parentPath) : '' %><%= activeBranchQuery %>" class="file-link-dir">
                                                .. (Go up one directory)
                                            </a>
                                        </td>
                                    </tr>
                                <% } %>

                                <% directoryItems.forEach(item => { %>
                                    <tr>
                                        <td class="col-icon">
                                            <% if (item.type === 'dir') { %>
                                                <i class="fas fa-folder icon-folder"></i>
                                            <% } else { %>
                                                <i class="far fa-file-code icon-file"></i>
                                            <% } %>
                                        </td>
                                        <td class="col-name">
                                            <a href="/source/<%= encodeURIComponent(safeSlug) %>?path=<%= encodeURIComponent(item.path) %><%= activeBranchQuery %>" class="<%= item.type === 'dir' ? 'file-link-dir' : '' %>" title="<%= item.name %>">
                                                <%= item.name %>
                                            </a>
                                        </td>
                                        <td class="col-size"><%= item.sizeFormatted %></td>
                                        <td class="col-action">
                                            <% if (item.type === 'file') { %>
                                                <a href="/source/<%= encodeURIComponent(safeSlug) %>/raw?path=<%= encodeURIComponent(item.path) %><%= activeBranchQuery %>" 
                                                   target="_blank" rel="noopener noreferrer nofollow" class="btn-code-tool" style="padding: 3px 8px; font-size: 0.75rem;" title="View raw file">
                                                    Raw
                                                </a>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="empty-folder">
                            <i class="fas fa-folder-open" style="font-size: 3rem; margin-bottom: 12px; color: #444;"></i>
                            <p>This directory is empty, or source code contents could not be loaded from GitHub.</p>
                            <div style="margin-top: 14px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
                                <a href="/source/<%= encodeURIComponent(safeSlug) %>" class="btn-gh" style="font-size: 0.85rem;">
                                    <i class="fas fa-redo"></i> Reload Root
                                </a>
                                <a href="<%= canonicalRepoUrl %>" target="_blank" rel="noopener noreferrer nofollow" class="btn-gh external-github-link" data-safe-url="<%= canonicalRepoUrl %>" style="font-size: 0.85rem;">
                                    <i class="fab fa-github"></i> Open on GitHub
                                </a>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- INLINE README (GitHub Style: shown below directory tree when at root) -->
                <% if (!currentPath && readme && readme.content) { %>
                    <div class="readme-card">
                        <div class="readme-header">
                            <div>
                                <i class="fas fa-book-open text-gold"></i>
                                <span><%= readme.name %></span>
                            </div>
                            <div class="code-actions">
                                <button type="button" class="btn-code-tool" onclick="copyReadmeText()">
                                    <i class="far fa-copy"></i> Copy
                                </button>
                                <a href="/source/<%= encodeURIComponent(safeSlug) %>/raw?path=<%= encodeURIComponent(readme.path) %><%= activeBranchQuery %>" 
                                   target="_blank" rel="noopener noreferrer nofollow" class="btn-code-tool">
                                    <i class="fas fa-external-link-alt"></i> Raw
                                </a>
                            </div>
                        </div>
                        <div class="readme-body" id="inline-readme-body"></div>
                        <textarea id="raw-inline-readme" hidden><%= readme.content %></textarea>
                    </div>
                <% } %>

            <% } %>

        </div>

        <!-- ============================================== -->
        <!-- TAB 2: README (Dedicated Tab)                  -->
        <!-- ============================================== -->
        <% if (readme) { %>
            <div id="tab-readme" class="tab-pane <%= activeTab === 'readme' ? 'active' : '' %>">
                <div class="readme-card">
                    <div class="readme-header">
                        <div>
                            <i class="fas fa-book-open text-gold"></i>
                            <span><%= readme.name %></span>
                        </div>
                        <div class="code-actions">
                            <button type="button" class="btn-code-tool" onclick="copyReadmeText()">
                                <i class="far fa-copy"></i> Copy Markdown
                            </button>
                            <a href="/source/<%= encodeURIComponent(safeSlug) %>/raw?path=<%= encodeURIComponent(readme.path) %><%= activeBranchQuery %>" 
                               target="_blank" rel="noopener noreferrer nofollow" class="btn-code-tool">
                                <i class="fas fa-external-link-alt"></i> Raw
                            </a>
                        </div>
                    </div>
                    <div class="readme-body" id="full-readme-body"></div>
                    <textarea id="raw-full-readme" hidden><%= readme.content %></textarea>
                </div>
            </div>
        <% } %>

        <!-- ============================================== -->
        <!-- TAB 3: LICENSE                                 -->
        <!-- ============================================== -->
        <% if (license) { %>
            <div id="tab-license" class="tab-pane <%= activeTab === 'license' ? 'active' : '' %>">
                <div class="license-meta-overview">
                    <div>
                        <h2 class="license-meta-title">
                            <i class="fas fa-scale-balanced text-gold"></i>
                            <%= license.name %>
                        </h2>
                        <span class="license-meta-spdx">SPDX: <%= license.spdxId || 'Custom' %></span>
                    </div>
                    <div>
                        <% if (license.url) { %>
                            <a href="<%= license.url.toLowerCase() %>" target="_blank" rel="noopener noreferrer nofollow" class="btn-gh external-github-link" data-safe-url="<%= license.url.toLowerCase() %>">
                                <i class="fas fa-info-circle"></i> License Details <i class="fas fa-external-link-alt" style="font-size: 0.75em;"></i>
                            </a>
                        <% } %>
                    </div>
                </div>

                <% if (license.content) { %>
                    <div class="license-card-box">
                        <div class="license-header-box">
                            <div>
                                <i class="fas fa-file-contract text-gold"></i>
                                <span><%= license.path || 'LICENSE' %></span>
                            </div>
                            <button type="button" class="btn-code-tool" id="copyLicenseBtn" onclick="copyLicenseText()">
                                <i class="far fa-copy"></i> Copy License Text
                            </button>
                        </div>
                        <div class="license-body-box">
                            <div class="license-raw-container" id="licenseRawBox"><%= license.content %></div>
                        </div>
                    </div>
                <% } else { %>
                    <div class="source-alert info">
                        <i class="fas fa-info-circle" style="font-size: 1.3em;"></i>
                        <div>
                            This repository operates under the <strong><%= license.name %></strong> (<%= license.spdxId %>). A separate raw license file was not detected in the repository root.
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>

        <!-- ============================================== -->
        <!-- TAB 4: RELEASES TIMELINE                       -->
        <!-- ============================================== -->
        <div id="tab-releases" class="tab-pane <%= activeTab === 'releases' ? 'active' : '' %>">
            <% if (releases && releases.length) { %>
                <div class="release-timeline">
                    <% releases.forEach((release, index) => { %>
                        <article class="release-card <%= index === 0 ? 'latest' : '' %>">
                            <header class="release-header">
                                <div>
                                    <h2 class="release-name"><%= release.name || release.tag_name %></h2>
                                    <span class="release-date">Released on <%= release.published_at ? new Date(release.published_at).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : 'Unpublished' %></span>
                                </div>
                                <span class="release-tag"><i class="fas fa-tag"></i> <%= release.tag_name %></span>
                            </header>

                            <div class="release-body" id="release-body-<%= release.id %>"></div>
                            <textarea id="raw-release-<%= release.id %>" hidden><%= release.body || '' %></textarea>

                            <footer class="release-footer">
                                <% if (hasAccess) { %>
                                    <a href="/source/<%= encodeURIComponent(safeSlug) %>/download/<%= encodeURIComponent(release.tag_name) %>" class="btn-gh btn-gh-primary">
                                        <i class="fas fa-file-archive"></i> Download Source (.zip)
                                    </a>
                                <% } else { %>
                                    <span class="btn-gh disabled" style="opacity: 0.5; cursor: not-allowed;"><i class="fas fa-lock"></i> Locked</span>
                                <% } %>
                            </footer>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="file-box" style="text-align: center; padding: 50px 20px;">
                    <i class="fas fa-tag" style="font-size: 3rem; color: #444; margin-bottom: 14px;"></i>
                    <h2 style="color: var(--white); margin-bottom: 8px;">No Published Releases Found</h2>
                    <p style="color: var(--silver); max-width: 500px; margin: 0 auto 18px; font-size: 0.92rem;">
                        This repository currently has no release tags published on GitHub, but you can browse and download the live source code using the Code tab.
                    </p>
                    <% if (hasAccess) { %>
                        <a href="/source/<%= encodeURIComponent(safeSlug) %>/download/<%= encodeURIComponent(currentRef) %>" class="btn-gh btn-gh-primary">
                            <i class="fas fa-file-archive"></i> Download Current Source (.zip)
                        </a>
                    <% } %>
                </div>
            <% } %>
        </div>

    </div>
</main>

<!-- URL Safety Verification Modal -->
<div class="url-safety-modal" id="urlSafetyModal" role="dialog" aria-modal="true" aria-labelledby="urlSafetyModalTitle">
    <div class="url-safety-card">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-shield-halved" style="color: #2ecc71; font-size: 1.3rem;"></i>
                <h3 id="urlSafetyModalTitle" style="color: var(--white); margin: 0; font-size: 1.1rem; font-weight: 700;">GitHub URL Safety Verification</h3>
            </div>
            <button type="button" class="btn-code-tool" id="closeSafetyModalBtn" style="padding: 4px 8px; border-radius: 4px;">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <p style="font-size: 0.88rem; color: var(--silver); margin-bottom: 12px; line-height: 1.5;">
            You are about to navigate to an external GitHub link. GPL Mods URL Safety verified this destination:
        </p>
        <div style="background: #0d1117; border: 1px solid var(--gh-border); border-radius: 6px; padding: 10px 12px; margin-bottom: 14px; word-break: break-all; font-family: monospace; font-size: 0.82rem; color: var(--gold);" id="urlSafetyTargetUrl">
            <%= canonicalRepoUrl %>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 18px; font-size: 0.82rem; color: #8b949e;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-check-circle" style="color: #2ecc71;"></i>
                <span>Protocol: <strong>HTTPS Encrypted (SSL/TLS)</strong></span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-check-circle" style="color: #2ecc71;"></i>
                <span>Verified Domain: <strong>github.com (Official)</strong></span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-check-circle" style="color: #2ecc71;"></i>
                <span>URL Normalization: <strong>Strict lowercase repository link</strong></span>
            </div>
        </div>
        <div style="display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap;">
            <button type="button" class="btn-gh" id="cancelSafetyModalBtn" style="font-size: 0.85rem; padding: 8px 14px;">Cancel</button>
            <a href="<%= canonicalRepoUrl %>" id="confirmSafetyProceedBtn" target="_blank" rel="noopener noreferrer nofollow" class="btn-gh btn-gh-primary" style="font-size: 0.85rem; padding: 8px 16px;">
                <i class="fas fa-external-link-alt"></i> Proceed to GitHub
            </a>
        </div>
    </div>
</div>

<script>
    // URL Safety Validator (client-side)
    function isSafeGitHubUrl(urlStr) {
        try {
            if (!urlStr) return false;
            const parsed = new URL(urlStr.startsWith('http') ? urlStr : `https://${urlStr}`);
            if (parsed.protocol !== 'https:') return false;
            const host = parsed.hostname.toLowerCase();
            const allowed = ['github.com', 'www.github.com', 'raw.githubusercontent.com', 'gist.github.com'];
            return allowed.includes(host);
        } catch (e) {
            return false;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        // Configure DOMPurify safety hooks for markdown content
        if (typeof DOMPurify !== 'undefined') {
            DOMPurify.addHook('afterSanitizeAttributes', function (node) {
                if (node.tagName === 'A' && node.hasAttribute('href')) {
                    const href = node.getAttribute('href');
                    // Force external links to open in a new tab with security attributes
                    node.setAttribute('target', '_blank');
                    node.setAttribute('rel', 'noopener noreferrer nofollow');
                    // Normalize GitHub links to lowercase where applicable
                    if (isSafeGitHubUrl(href)) {
                        node.setAttribute('href', href.toLowerCase());
                        node.classList.add('safe-gh-link');
                    }
                }
            });
        }

        // 1. Render Markdown for inline README
        const rawInlineReadme = document.getElementById('raw-inline-readme');
        const inlineReadmeContainer = document.getElementById('inline-readme-body');
        if (rawInlineReadme && inlineReadmeContainer && typeof marked !== 'undefined') {
            inlineReadmeContainer.innerHTML = DOMPurify.sanitize(marked.parse(rawInlineReadme.value));
        }

        // 2. Render Markdown for full README tab
        const rawFullReadme = document.getElementById('raw-full-readme');
        const fullReadmeContainer = document.getElementById('full-readme-body');
        if (rawFullReadme && fullReadmeContainer && typeof marked !== 'undefined') {
            fullReadmeContainer.innerHTML = DOMPurify.sanitize(marked.parse(rawFullReadme.value));
        }

        // 3. Render Markdown for Releases
        document.querySelectorAll('textarea[id^="raw-release-"]').forEach(rawElement => {
            const releaseId = rawElement.id.replace('raw-release-', '');
            const bodyContainer = document.getElementById(`release-body-${releaseId}`);
            if (bodyContainer && typeof marked !== 'undefined') {
                bodyContainer.innerHTML = DOMPurify.sanitize(marked.parse(rawElement.value || '*No release description provided.*'));
            }
        });

        // 4. Trigger Prism syntax highlighting if code viewer exists
        if (typeof Prism !== 'undefined') {
            Prism.highlightAll();
        }

        // 5. URL Safety Verification Modal handlers
        const safetyModal = document.getElementById('urlSafetyModal');
        const safetyTargetEl = document.getElementById('urlSafetyTargetUrl');
        const confirmBtn = document.getElementById('confirmSafetyProceedBtn');
        const closeBtn = document.getElementById('closeSafetyModalBtn');
        const cancelBtn = document.getElementById('cancelSafetyModalBtn');
        const repoSafetyBadge = document.getElementById('repoSafetyBadge');

        function openSafetyModal(url) {
            if (!safetyModal) return;
            const safeUrl = (url || '').toLowerCase();
            if (safetyTargetEl) safetyTargetEl.textContent = safeUrl;
            if (confirmBtn) confirmBtn.href = safeUrl;
            safetyModal.classList.add('show');
        }

        function closeSafetyModal() {
            if (safetyModal) safetyModal.classList.remove('show');
        }

        if (closeBtn) closeBtn.addEventListener('click', closeSafetyModal);
        if (cancelBtn) cancelBtn.addEventListener('click', closeSafetyModal);
        if (safetyModal) {
            safetyModal.addEventListener('click', (e) => {
                if (e.target === safetyModal) closeSafetyModal();
            });
        }

        if (repoSafetyBadge) {
            repoSafetyBadge.addEventListener('click', () => {
                openSafetyModal('<%= canonicalRepoUrl %>');
            });
        }

        // Intercept external GitHub buttons to show verified safety verification
        document.querySelectorAll('.external-github-link').forEach(link => {
            link.addEventListener('click', (e) => {
                const targetUrl = link.getAttribute('data-safe-url') || link.href;
                if (!isSafeGitHubUrl(targetUrl)) {
                    e.preventDefault();
                    alert('Warning: The selected link does not point to a verified GitHub destination.');
                }
            });
        });

        // 6. Tab navigation preserving URL parameters
        const tabButtons = document.querySelectorAll('.source-tabs .tab-btn');
        tabButtons.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const href = btn.getAttribute('href');
                if (href && href.startsWith('?tab=')) {
                    return; // Normal navigation maintains state
                }
            });
        });
    });

    // Copy source code functionality
    function copySourceCode() {
        const rawBox = document.getElementById('hiddenRawCode');
        const copyBtn = document.getElementById('copyRawBtn');
        if (!rawBox) return;

        navigator.clipboard.writeText(rawBox.value).then(() => {
            if (copyBtn) {
                const originalHtml = copyBtn.innerHTML;
                copyBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                copyBtn.classList.add('copied');
                setTimeout(() => {
                    copyBtn.innerHTML = originalHtml;
                    copyBtn.classList.remove('copied');
                }, 2000);
            }
        }).catch(err => {
            console.error('Clipboard copy failed:', err);
        });
    }

    // Copy README Markdown functionality
    function copyReadmeText() {
        const rawFullReadme = document.getElementById('raw-full-readme') || document.getElementById('raw-inline-readme');
        if (!rawFullReadme) return;

        navigator.clipboard.writeText(rawFullReadme.value).then(() => {
            alert('README markdown copied to clipboard!');
        }).catch(err => {
            console.error('Clipboard copy failed:', err);
        });
    }

    // Copy License text functionality
    function copyLicenseText() {
        const licBox = document.getElementById('licenseRawBox');
        const licBtn = document.getElementById('copyLicenseBtn');
        if (!licBox) return;

        navigator.clipboard.writeText(licBox.innerText).then(() => {
            if (licBtn) {
                const orig = licBtn.innerHTML;
                licBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                setTimeout(() => { licBtn.innerHTML = orig; }, 2000);
            }
        }).catch(err => {
            console.error('License copy failed:', err);
        });
    }
</script>

