<%- include('../partials/header') %>

<style>
    .my-membership-container {
        max-width: 1200px;
        margin: 40px auto 80px auto;
        padding: 0 20px;
    }

    .membership-hero-card {
        background: linear-gradient(135deg, rgba(26, 26, 26, 0.95), rgba(15, 15, 15, 0.98));
        border: 1px solid #333;
        border-radius: 20px;
        padding: 40px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.6);
        margin-bottom: 35px;
    }

    .membership-hero-card.tier-plus {
        border-color: rgba(255, 215, 0, 0.4);
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.6), 0 0 30px rgba(255, 215, 0, 0.12);
    }
    .membership-hero-card.tier-lite {
        border-color: rgba(0, 188, 212, 0.4);
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.6), 0 0 30px rgba(0, 188, 212, 0.12);
    }

    .hero-top-strip {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(90deg, var(--gold, #FFD700), #f39c12);
    }
    .tier-lite .hero-top-strip {
        background: linear-gradient(90deg, #00bcd4, #0097a7);
    }
    .tier-free .hero-top-strip {
        background: linear-gradient(90deg, #666, #999);
    }

    .membership-header-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 25px;
        flex-wrap: wrap;
        margin-bottom: 30px;
    }

    .plan-badge-group {
        display: flex;
        align-items: center;
        gap: 15px;
    }
    .plan-icon-avatar {
        width: 70px;
        height: 70px;
        border-radius: 18px;
        background: rgba(255, 215, 0, 0.15);
        color: var(--gold);
        border: 2px solid var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
    }
    .tier-lite .plan-icon-avatar {
        background: rgba(0, 188, 212, 0.15);
        color: #00bcd4;
        border-color: #00bcd4;
    }
    .tier-free .plan-icon-avatar {
        background: rgba(255, 255, 255, 0.08);
        color: var(--silver);
        border-color: #555;
    }

    .plan-title-box h1 {
        font-size: 2.2rem;
        color: var(--white);
        margin: 0 0 6px 0;
        font-weight: 800;
        letter-spacing: -0.5px;
    }
    .plan-title-box p {
        margin: 0;
        color: var(--silver);
        font-size: 1rem;
    }

    .plan-status-pills {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .badge-status {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .badge-active {
        background: rgba(46, 204, 113, 0.15);
        color: #2ecc71;
        border: 1px solid rgba(46, 204, 113, 0.4);
    }
    .badge-lifetime {
        background: rgba(255, 215, 0, 0.18);
        color: var(--gold);
        border: 1px solid var(--gold);
        box-shadow: 0 0 12px var(--glow-gold);
    }
    .badge-renew-off {
        background: rgba(241, 196, 15, 0.15);
        color: #f1c40f;
        border: 1px solid rgba(241, 196, 15, 0.35);
    }
    .badge-expired {
        background: rgba(231, 76, 60, 0.15);
        color: #e74c3c;
        border: 1px solid rgba(231, 76, 60, 0.35);
    }

    /* Hero Stats Grid */
    .hero-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
        background: rgba(0, 0, 0, 0.35);
        padding: 22px;
        border-radius: 14px;
        border: 1px solid #282828;
    }
    .hero-stat-card {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
    .hero-stat-label {
        font-size: 0.82rem;
        color: var(--silver);
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .hero-stat-val {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--white);
    }
    .hero-stat-val.gold { color: var(--gold); }
    .hero-stat-val.cyan { color: #00bcd4; }
    .hero-stat-val.green { color: #2ecc71; }

    /* Action Buttons Row */
    .hero-actions-row {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }
    .btn-membership {
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.25s ease;
        border: none;
    }
    .btn-upgrade {
        background: var(--gold);
        color: var(--black);
        box-shadow: 0 0 15px var(--glow-gold);
    }
    .btn-upgrade:hover {
        background: var(--white);
        transform: translateY(-2px);
    }
    .btn-cancel-sub {
        background: rgba(231, 76, 60, 0.15);
        color: #e74c3c;
        border: 1px solid rgba(231, 76, 60, 0.35);
    }
    .btn-cancel-sub:hover {
        background: #e74c3c;
        color: var(--white);
        transform: translateY(-2px);
    }
    .btn-refund-req {
        background: rgba(255, 255, 255, 0.08);
        color: var(--silver);
        border: 1px solid #444;
    }
    .btn-refund-req:hover {
        background: rgba(255, 255, 255, 0.14);
        border-color: var(--gold);
        color: var(--gold);
        transform: translateY(-2px);
    }

    /* Active Perks Checklist */
    .perks-section {
        background: #181818;
        border: 1px solid #333;
        border-radius: 18px;
        padding: 30px;
        margin-bottom: 35px;
    }
    .perks-header {
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .perks-header h3 {
        margin: 0;
        color: var(--white);
        font-size: 1.3rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .perks-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 16px;
    }
    .perk-card {
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid #2a2a2a;
        border-radius: 12px;
        padding: 18px 20px;
        display: flex;
        align-items: flex-start;
        gap: 14px;
        transition: border-color 0.2s;
    }
    .perk-card.enabled { border-color: rgba(46, 204, 113, 0.3); }
    .perk-card.disabled { opacity: 0.55; }
    .perk-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }
    .perk-card.enabled .perk-icon { background: rgba(46, 204, 113, 0.15); color: #2ecc71; }
    .perk-card.disabled .perk-icon { background: rgba(255, 255, 255, 0.05); color: #777; }
    .perk-info h4 { margin: 0 0 4px 0; color: var(--white); font-size: 0.98rem; }
    .perk-info p { margin: 0; color: var(--silver); font-size: 0.85rem; line-height: 1.4; }

    /* Modals */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(5px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 20px;
    }
    .modal-box {
        background: #1c1c1c;
        border: 1px solid #444;
        border-radius: 18px;
        max-width: 550px;
        width: 100%;
        padding: 35px 30px;
        position: relative;
        box-shadow: 0 20px 60px rgba(0,0,0,0.8);
        animation: modalScaleIn 0.3s ease-out;
    }
    @keyframes modalScaleIn {
        from { transform: scale(0.95); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
    .modal-close-btn {
        position: absolute;
        top: 20px;
        right: 20px;
        background: transparent;
        border: none;
        color: #888;
        font-size: 1.4rem;
        cursor: pointer;
        transition: color 0.2s;
    }
    .modal-close-btn:hover { color: var(--white); }
    .modal-box h2 {
        color: var(--white);
        margin: 0 0 14px 0;
        font-size: 1.5rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .modal-box p {
        color: var(--silver);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    /* Refund Breakdown Card */
    .refund-calc-card {
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid #333;
        border-radius: 12px;
        padding: 18px;
        margin-bottom: 20px;
    }
    .calc-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 0.92rem;
    }
    .calc-row:last-child {
        margin-bottom: 0;
        border-top: 1px solid #333;
        padding-top: 10px;
        font-weight: 700;
    }

    .form-group-custom {
        margin-bottom: 20px;
        text-align: left;
    }
    .form-group-custom label {
        display: block;
        color: var(--silver);
        font-size: 0.88rem;
        margin-bottom: 8px;
        font-weight: 600;
    }
    .form-control-custom {
        width: 100%;
        background: #121212;
        border: 1px solid #444;
        border-radius: 8px;
        padding: 12px 14px;
        color: var(--white);
        font-size: 0.95rem;
        font-family: inherit;
    }
    .form-control-custom:focus {
        outline: none;
        border-color: var(--gold);
    }

    /* Lifetime Downgrade Warning Banner */
    .lifetime-notice-banner {
        background: rgba(255, 215, 0, 0.1);
        border: 1px solid rgba(255, 215, 0, 0.35);
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 20px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        font-size: 0.9rem;
        color: var(--gold);
        text-align: left;
    }
</style>

<main class="my-membership-container">
    <!-- Back Button -->
    <div style="margin-bottom: 25px; text-align: left;">
        <a href="/membership" class="dynamic-back-btn" style="color: var(--silver); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; font-weight: 600;">
            <i class="fas fa-arrow-left"></i> View All Membership Plans
        </a>
    </div>

    <!-- Active Membership Hero Card -->
    <div class="membership-hero-card <%= user.membership === 'plus' ? 'tier-plus' : (user.membership === 'lite' ? 'tier-lite' : 'tier-free') %>">
        <div class="hero-top-strip"></div>

        <div class="membership-header-row">
            <div class="plan-badge-group">
                <div class="plan-icon-avatar">
                    <i class="fas <%= user.membership === 'plus' ? 'fa-crown' : (user.membership === 'lite' ? 'fa-bolt' : 'fa-user') %>"></i>
                </div>
                <div class="plan-title-box">
                    <h1><%= currentPlan.name %></h1>
                    <p>
                        <% if (isLifetime) { %>
                            Permanent Lifetime Access &bull; No Recurring Charges
                        <% } else if (user.membershipExpiresAt) { %>
                            Current billing cycle ends on <%= new Date(user.membershipExpiresAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
                        <% } else { %>
                            Basic Free Member &bull; Ad-Supported
                        <% } %>
                    </p>
                </div>
            </div>

            <div class="plan-status-pills">
                <% if (isLifetime) { %>
                    <span class="badge-status badge-lifetime"><i class="fas fa-infinity"></i> Lifetime VIP</span>
                <% } else if (user.membership !== 'free') { %>
                    <% if (isExpired) { %>
                        <span class="badge-status badge-expired"><i class="fas fa-exclamation-circle"></i> Cycle Expired</span>
                    <% } else if (autoRenew) { %>
                        <span class="badge-status badge-active"><i class="fas fa-check-circle"></i> Active &bull; Auto-Renew On</span>
                    <% } else { %>
                        <span class="badge-status badge-renew-off"><i class="fas fa-clock"></i> Active &bull; Cancels at Expiry</span>
                    <% } %>
                <% } else { %>
                    <span class="badge-status" style="background: rgba(255,255,255,0.08); color: var(--silver); border: 1px solid #444;"><i class="fas fa-user"></i> Free Member</span>
                <% } %>
            </div>
        </div>

        <!-- Hero Stats Grid -->
        <div class="hero-stats-grid">
            <div class="hero-stat-card">
                <span class="hero-stat-label">Membership Tier</span>
                <span class="hero-stat-val <%= user.membership === 'plus' ? 'gold' : (user.membership === 'lite' ? 'cyan' : '') %>">
                    <%= user.membership === 'plus' ? 'GPL Plus' : (user.membership === 'lite' ? 'GPL Lite' : 'Free Member') %>
                </span>
            </div>
            <div class="hero-stat-card">
                <span class="hero-stat-label">Time Remaining</span>
                <span class="hero-stat-val <%= isLifetime ? 'gold' : 'green' %>">
                    <%= isLifetime ? 'Permanent' : (typeof daysRemaining === 'number' ? daysRemaining + ' Days' : daysRemaining) %>
                </span>
            </div>
            <div class="hero-stat-card">
                <span class="hero-stat-label">Upload Cap Slot</span>
                <span class="hero-stat-val">
                    <%= user.membership === 'plus' ? '10 Slots' : (user.membership === 'lite' ? '5 Slots' : '3 Slots') %>
                </span>
            </div>
            <div class="hero-stat-card">
                <span class="hero-stat-label">Max File Size</span>
                <span class="hero-stat-val">
                    <%= user.membership === 'plus' ? '2.0 GB' : (user.membership === 'lite' ? '600 MB' : '300 MB') %>
                </span>
            </div>
        </div>

        <% if (scheduledChange) { %>
            <div style="background: rgba(0, 188, 212, 0.12); border: 1px solid rgba(0, 188, 212, 0.35); border-radius: 10px; padding: 14px 18px; margin-bottom: 25px; text-align: left; display: flex; align-items: center; gap: 12px; color: #00bcd4;">
                <i class="fas fa-calendar-check" style="font-size: 1.4rem;"></i>
                <div>
                    <strong>Scheduled Plan Change:</strong> Your membership is scheduled to switch to 
                    <strong><%= scheduledChange.targetPlan %></strong> on 
                    <%= scheduledChange.effectiveDate ? new Date(scheduledChange.effectiveDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'renewal' %>.
                </div>
            </div>
        <% } %>

        <!-- Action Buttons -->
        <div class="hero-actions-row">
            <% if (user.membership === 'free') { %>
                <a href="/membership" class="btn-membership btn-upgrade">
                    <i class="fas fa-crown"></i> Upgrade to GPL Lite or Plus
                </a>
            <% } else { %>
                <button type="button" class="btn-membership btn-upgrade" onclick="openPlanChangeModal();">
                    <i class="fas fa-exchange-alt"></i> Switch / Upgrade Plan
                </button>

                <% if (!isLifetime && autoRenew) { %>
                    <button type="button" class="btn-membership btn-cancel-sub" onclick="openCancelModal();">
                        <i class="fas fa-ban"></i> Cancel Subscription
                    </button>
                <% } %>

                <% if (activeOrder && activeOrder.refundStatus === 'none' && refundEligibility.eligible) { %>
                    <button type="button" class="btn-membership btn-refund-req" onclick="openRefundModal();">
                        <i class="fas fa-undo-alt"></i> Request Refund
                    </button>
                <% } else if (activeOrder && activeOrder.refundStatus === 'pending') { %>
                    <span style="color: #f1c40f; font-size: 0.9em; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-hourglass-half"></i> Refund Request Pending Under Review
                    </span>
                <% } %>
            <% } %>

            <a href="/support" class="btn-membership btn-refund-req">
                <i class="fas fa-headset"></i> Support Desk
            </a>
        </div>
    </div>

    <!-- Active Tier Perks Breakdown -->
    <div class="perks-section">
        <div class="perks-header">
            <h3><i class="fas fa-shield-alt" style="color: var(--gold);"></i> Unlocked Perks with Current Plan</h3>
            <span style="color: var(--silver); font-size: 0.9rem;">Features active on your account right now</span>
        </div>

        <div class="perks-grid">
            <div class="perk-card enabled">
                <div class="perk-icon"><i class="fas fa-upload"></i></div>
                <div class="perk-info">
                    <h4>Upload Capacity Slots</h4>
                    <p>You have <strong><%= user.membership === 'plus' ? '10' : (user.membership === 'lite' ? '5' : '3') %> upload slots</strong> with automatic slot restoration once files go live.</p>
                </div>
            </div>

            <div class="perk-card enabled">
                <div class="perk-icon"><i class="fas fa-file-archive"></i></div>
                <div class="perk-info">
                    <h4>Max Upload File Limit</h4>
                    <p>Upload large mod releases up to <strong><%= user.membership === 'plus' ? '2.0 GB' : (user.membership === 'lite' ? '600 MB' : '300 MB') %></strong> directly.</p>
                </div>
            </div>

            <div class="perk-card <%= (user.membership === 'plus' || user.membership === 'lite') ? 'enabled' : 'disabled' %>">
                <div class="perk-icon"><i class="fas fa-ban"></i></div>
                <div class="perk-info">
                    <h4>Popunder Ad Blocker</h4>
                    <p><%= (user.membership === 'plus' || user.membership === 'lite') ? 'Popunder and intrusive redirect ads are permanently eliminated.' : 'Popunder ads enabled (upgrade to Lite/Plus to disable).' %></p>
                </div>
            </div>

            <div class="perk-card <%= user.membership === 'plus' ? 'enabled' : 'disabled' %>">
                <div class="perk-icon"><i class="fas fa-video-slash"></i></div>
                <div class="perk-info">
                    <h4>100% Ad-Free Video Downloads</h4>
                    <p><%= user.membership === 'plus' ? 'All video ads and interruptions removed entirely for instant downloads.' : 'Video ads play before download links. Included in GPL Plus.' %></p>
                </div>
            </div>

            <div class="perk-card <%= user.membership === 'plus' ? 'enabled' : 'disabled' %>">
                <div class="perk-icon"><i class="fas fa-music"></i></div>
                <div class="perk-info">
                    <h4>Dynamic Background Music Player</h4>
                    <p><%= user.membership === 'plus' ? 'Stream ad-free background music directly from YouTube & YTMusic while browsing.' : 'Exclusive to GPL Plus members.' %></p>
                </div>
            </div>

            <div class="perk-card <%= user.membership === 'plus' ? 'enabled' : 'disabled' %>">
                <div class="perk-icon"><i class="fas fa-mobile-alt"></i></div>
                <div class="perk-info">
                    <h4>1-Click IPA / DEB Installs</h4>
                    <p><%= user.membership === 'plus' ? 'Direct one-tap installation links for AltStore, Sileo, TrollStore, and Zebra.' : 'Exclusive to GPL Plus members.' %></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Purchase & Invoice History -->
    <div class="perks-section">
        <div class="perks-header">
            <h3><i class="fas fa-receipt" style="color: var(--gold);"></i> Membership Invoices & Orders</h3>
            <span style="color: var(--silver); font-size: 0.9rem;"><%= orders ? orders.length : 0 %> Total Transactions</span>
        </div>

        <% if (orders && orders.length > 0) { %>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.92rem;">
                    <thead>
                        <tr style="border-bottom: 1px solid #333; color: #888;">
                            <th style="padding: 12px 10px;">Date</th>
                            <th style="padding: 12px 10px;">Reference ID</th>
                            <th style="padding: 12px 10px;">Plan</th>
                            <th style="padding: 12px 10px;">Amount</th>
                            <th style="padding: 12px 10px;">Status</th>
                            <th style="padding: 12px 10px;">Action / Receipt</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(function(item) { %>
                            <tr style="border-bottom: 1px solid #242424; color: var(--silver);">
                                <td style="padding: 14px 10px;"><%= new Date(item.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
                                <td style="padding: 14px 10px;"><code><%= item.orderId %></code></td>
                                <td style="padding: 14px 10px;">
                                    <strong style="color: var(--white);"><%= item.duration %></strong>
                                    <span style="font-size: 0.8em; color: #888; display: block; text-transform: uppercase;"><%= item.tier %> tier</span>
                                </td>
                                <td style="padding: 14px 10px; font-weight: 700; color: var(--white);"><%= item.currency || 'INR' %> <%= item.amount %></td>
                                <td style="padding: 14px 10px;">
                                    <% if (item.refundStatus === 'approved' || item.status === 'refunded') { %>
                                        <span class="badge-status" style="background: rgba(155, 89, 182, 0.2); color: #9b59b6; border: 1px solid rgba(155, 89, 182, 0.4);"><i class="fas fa-undo"></i> Refunded</span>
                                    <% } else if (item.refundStatus === 'pending' || item.status === 'refund_requested') { %>
                                        <span class="badge-status" style="background: rgba(241, 196, 15, 0.2); color: #f1c40f; border: 1px solid rgba(241, 196, 15, 0.4);"><i class="fas fa-hourglass-half"></i> Refund Requested</span>
                                    <% } else if (item.status === 'paid') { %>
                                        <span class="badge-status badge-active"><i class="fas fa-check"></i> Paid</span>
                                    <% } else if (item.status === 'pending') { %>
                                        <span class="badge-status" style="background: rgba(241, 196, 15, 0.2); color: #f1c40f; border: 1px solid rgba(241, 196, 15, 0.4);"><i class="fas fa-clock fa-spin"></i> Processing</span>
                                    <% } else { %>
                                        <span class="badge-status badge-expired"><i class="fas fa-times"></i> Failed</span>
                                    <% } %>
                                </td>
                                <td style="padding: 14px 10px;">
                                    <% if (item.status === 'paid') { %>
                                        <a href="/payment/success?order_id=<%= encodeURIComponent(item.orderId) %>&type=membership" style="color: var(--gold); text-decoration: underline; font-weight: 600;" target="_blank">
                                            <i class="fas fa-receipt"></i> View Receipt
                                        </a>
                                    <% } else if (item.status === 'pending') { %>
                                        <a href="/payment/status?order_id=<%= encodeURIComponent(item.orderId) %>&type=membership" style="color: #f1c40f; text-decoration: underline; font-weight: 600;">
                                            <i class="fas fa-sync-alt"></i> Check Status
                                        </a>
                                    <% } else { %>
                                        <span style="color: #666;">-</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p style="color: var(--silver); margin: 0; padding: 20px 0;">No previous orders found.</p>
        <% } %>
    </div>
</main>

<!-- ======================================================================== -->
<!-- MODAL 1: CANCEL SUBSCRIPTION -->
<!-- ======================================================================== -->
<div class="modal-overlay" id="cancelModal">
    <div class="modal-box">
        <button type="button" class="modal-close-btn" onclick="closeModal('cancelModal');">&times;</button>
        <h2><i class="fas fa-ban" style="color: #e74c3c;"></i> Cancel Subscription Auto-Renew</h2>
        
        <p>
            Are you sure you want to cancel automatic subscription renewals? 
        </p>

        <div style="background: rgba(46, 204, 113, 0.1); border: 1px solid rgba(46, 204, 113, 0.3); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px; color: #2ecc71; text-align: left; font-size: 0.92rem;">
            <i class="fas fa-shield-alt"></i>
            <strong>Active Guarantee:</strong> Your membership benefits will remain <strong>100% active until <%= user.membershipExpiresAt ? new Date(user.membershipExpiresAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'the end of your period' %></strong>. You will NOT be billed again.
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button type="button" class="btn-membership btn-refund-req" onclick="closeModal('cancelModal');">Keep Subscription</button>
            <button type="button" class="btn-membership btn-cancel-sub" id="confirmCancelBtn" onclick="confirmSubscriptionCancel();">
                Yes, Turn Off Auto-Renew
            </button>
        </div>
    </div>
</div>

<!-- ======================================================================== -->
<!-- MODAL 2: SWITCH / UPGRADE PLAN -->
<!-- ======================================================================== -->
<div class="modal-overlay" id="planModal">
    <div class="modal-box" style="max-width: 650px;">
        <button type="button" class="modal-close-btn" onclick="closeModal('planModal');">&times;</button>
        <h2><i class="fas fa-exchange-alt" style="color: var(--gold);"></i> Switch Membership Plan</h2>

        <% if (isLifetime) { %>
            <!-- STRICT CONSTRAINT: Lifetime members cannot downgrade -->
            <div class="lifetime-notice-banner">
                <i class="fas fa-lock" style="font-size: 1.4rem;"></i>
                <div>
                    <strong>Permanent Lifetime Membership:</strong> Your account has active Lifetime VIP privileges. Under the GPLMods Policy, <strong>downgrades from Lifetime Membership are not permitted</strong> because no recurring charges apply to your account.
                </div>
            </div>
            <div style="text-align: right;">
                <button type="button" class="btn-membership btn-refund-req" onclick="closeModal('planModal');">Close</button>
            </div>
        <% } else { %>
            <p>
                Select your desired plan. Upgrades take effect immediately, while plan downgrades are scheduled for your next billing renewal so you don't lose any active benefits.
            </p>

            <div class="form-group-custom">
                <label for="targetPlanSelect">Choose Target Plan:</label>
                <select id="targetPlanSelect" class="form-control-custom">
                    <optgroup label="GPL Plus (VIP 100% Ad-Free)">
                        <option value="plus_lifetime">GPL Plus - Lifetime (₹1,499 one-time)</option>
                        <option value="plus_yearly">GPL Plus - Yearly (₹499 / yr)</option>
                        <option value="plus_6months">GPL Plus - 6 Months (₹299 / 6mo)</option>
                        <option value="plus_monthly">GPL Plus - Monthly (₹59 / mo)</option>
                    </optgroup>
                    <optgroup label="GPL Lite (Fast & Popunder-Free)">
                        <option value="lite_yearly">GPL Lite - Yearly (₹449 / yr)</option>
                        <option value="lite_6months">GPL Lite - 6 Months (₹199 / 6mo)</option>
                        <option value="lite_monthly">GPL Lite - Monthly (₹49 / mo)</option>
                    </optgroup>
                </select>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button type="button" class="btn-membership btn-refund-req" onclick="closeModal('planModal');">Cancel</button>
                <button type="button" class="btn-membership btn-upgrade" id="confirmPlanChangeBtn" onclick="confirmPlanChange();">
                    Confirm Plan Selection
                </button>
            </div>
        <% } %>
    </div>
</div>

<!-- ======================================================================== -->
<!-- MODAL 3: SELF-SERVICE REFUND REQUEST (REFUND POLICY) -->
<!-- ======================================================================== -->
<div class="modal-overlay" id="refundModal">
    <div class="modal-box">
        <button type="button" class="modal-close-btn" onclick="closeModal('refundModal');">&times;</button>
        <h2><i class="fas fa-undo-alt" style="color: var(--gold);"></i> Request Refund</h2>
        
        <p>
            Your refund is calculated strictly in accordance with our 
            <a href="/refund-policy" target="_blank" style="color: var(--gold); text-decoration: underline;">Refund Policy</a>.
        </p>

        <% if (activeOrder) { %>
            <div class="refund-calc-card">
                <div class="calc-row">
                    <span style="color: #999;">Order Reference:</span>
                    <code><%= activeOrder.orderId %></code>
                </div>
                <div class="calc-row">
                    <span style="color: #999;">Purchased Plan:</span>
                    <span><%= activeOrder.duration %></span>
                </div>
                <div class="calc-row">
                    <span style="color: #999;">Original Amount:</span>
                    <span><%= activeOrder.currency || 'INR' %> <%= activeOrder.amount %></span>
                </div>
                <div class="calc-row">
                    <span style="color: #999;">Policy Refund Rate:</span>
                    <span style="color: #2ecc71;"><%= refundEligibility.percent %>%</span>
                </div>
                <div class="calc-row">
                    <span style="color: var(--white);">Eligible Refund Amount:</span>
                    <span style="color: var(--gold); font-size: 1.15rem;"><%= activeOrder.currency || 'INR' %> <%= refundEligibility.amount %></span>
                </div>
            </div>

            <div class="form-group-custom">
                <label for="refundReasonInput">Reason for Refund (Optional):</label>
                <textarea id="refundReasonInput" class="form-control-custom" rows="3" placeholder="Tell us why you would like a refund..."></textarea>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button type="button" class="btn-membership btn-refund-req" onclick="closeModal('refundModal');">Cancel</button>
                <button type="button" class="btn-membership btn-upgrade" id="submitRefundBtn" onclick="submitRefundRequest('<%= activeOrder.orderId %>');">
                    Submit Refund Request
                </button>
            </div>
        <% } %>
    </div>
</div>

<script>
    function closeModal(id) {
        const modal = document.getElementById(id);
        if (modal) modal.style.display = 'none';
    }

    function openCancelModal() {
        document.getElementById('cancelModal').style.display = 'flex';
    }

    function openPlanChangeModal() {
        document.getElementById('planModal').style.display = 'flex';
    }

    function openRefundModal() {
        document.getElementById('refundModal').style.display = 'flex';
    }

    async function confirmSubscriptionCancel() {
        const btn = document.getElementById('confirmCancelBtn');
        btn.disabled = true;
        btn.textContent = 'Processing...';

        try {
            const resp = await fetch('/membership/cancel-subscription', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await resp.json();
            if (data.success) {
                alert(data.message);
                window.location.reload();
            } else {
                alert(data.error || 'Failed to cancel subscription.');
                btn.disabled = false;
                btn.textContent = 'Yes, Turn Off Auto-Renew';
            }
        } catch (e) {
            alert('Network error. Please try again.');
            btn.disabled = false;
            btn.textContent = 'Yes, Turn Off Auto-Renew';
        }
    }

    async function confirmPlanChange() {
        const select = document.getElementById('targetPlanSelect');
        const targetPlan = select.value;
        const btn = document.getElementById('confirmPlanChangeBtn');
        btn.disabled = true;
        btn.textContent = 'Updating...';

        try {
            const resp = await fetch('/membership/change-plan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ targetPlan })
            });
            const data = await resp.json();
            if (data.requirePayment) {
                window.location.href = `/membership?highlight=${encodeURIComponent(targetPlan)}`;
            } else if (data.success) {
                alert(data.message);
                window.location.reload();
            } else {
                alert(data.error || 'Could not change plan.');
                btn.disabled = false;
                btn.textContent = 'Confirm Plan Selection';
            }
        } catch (e) {
            alert('Network error. Please try again.');
            btn.disabled = false;
            btn.textContent = 'Confirm Plan Selection';
        }
    }

    async function submitRefundRequest(orderId) {
        const reason = document.getElementById('refundReasonInput').value;
        const btn = document.getElementById('submitRefundBtn');
        btn.disabled = true;
        btn.textContent = 'Submitting...';

        try {
            const resp = await fetch('/membership/request-refund', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderId, reason })
            });
            const data = await resp.json();
            if (data.success) {
                alert(data.message);
                window.location.reload();
            } else {
                alert(data.error || 'Failed to submit refund request.');
                btn.disabled = false;
                btn.textContent = 'Submit Refund Request';
            }
        } catch (e) {
            alert('Network error. Please try again.');
            btn.disabled = false;
            btn.textContent = 'Submit Refund Request';
        }
    }
</script>

<%- include('../partials/footer') %>
