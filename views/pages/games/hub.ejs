<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title><%= title %></title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="Play classic retro and 2-player multiplayer games on Pocket Classics at GPLMods Arcade. Featuring 2048, Chess, Air Hockey, Checkers, Othello, Snake, and Tic-Tac-Toe.">
    <meta name="keywords" content="Pocket Classics, GPLMods Arcade, 2048, Chess, Checkers, Snake, TicTacToe, Online Multiplayer, Retro Games">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="Play classic retro and 2-player multiplayer board games online for free with real-time room chat and leaderboards.">
    <meta property="og:image" content="/games/pocketclassics/assets/logo.png">
    <meta property="og:type" content="website">

    <link rel="manifest" href="/games/pocketclassics/manifest.json">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Nunito:wght@700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/games/pocketclassics/css/arcade.css">

    <script>
        window.__ARCADE_USER__ = {
            username: '<%= user ? user.username : "Guest" %>',
            country: '<%= user && user.country ? user.country : "India" %>',
            avatar: '<%= user && (user.cardAvatarUrl || user.avatarUrl || user.profileImage) ? (user.cardAvatarUrl || user.avatarUrl || user.profileImage) : "/images/default-avatar.png" %>'
        };
        (function() {
            var savedTheme = localStorage.getItem('arc_theme') || 'classic';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body class="arcade-body arcade-body-hub">

    <!-- Collapse-Open Shutter Doors (Starts closed at center, header goes up & footer goes down simultaneously) -->
    <div class="arcade-vault-shutter" id="arcadeVaultShutter">
        <div class="vault-door vault-door-top">
            <div class="vault-edge-glow"></div>
            <div class="vault-peek-brand">
                <img src="/games/pocketclassics/assets/logo.png" alt="Pocket Classics" style="width: 38px; height: 38px; object-fit: contain; filter: drop-shadow(0 0 10px var(--arc-accent));">
                <span>POCKET CLASSICS</span>
            </div>
        </div>
        <div class="vault-door vault-door-bottom">
            <div class="vault-edge-glow"></div>
            <div class="vault-peek-footer">
                <span class="vault-gni">gaming net india</span>
                <span class="vault-love">coded with <i class="fas fa-heart"></i></span>
            </div>
        </div>
    </div>

    <div class="arcade-wrapper">
        <!-- Arcade Header Partial -->
        <%- include('./partials/header') %>

        <!-- PWA Banner Partial -->
        <%- include('./partials/pwa-banner') %>

        <!-- Hero Arcade Banner (Requirement: Improve UI of Main Menu) -->
        <section class="arcade-hero-banner">
            <div class="hero-badge-pill">
                <span class="live-dot"></span>
                <span>POCKET CLASSICS ARCADE REMASTERED</span>
            </div>
            <h2 class="hero-neon-headline">RETRO <span>BATTLEGROUND</span></h2>
            <p class="hero-subtitle">10 legendary classics upgraded with high-fps physics, responsive mobile &amp; PC layouts, full controller navigation &amp; real-time dual-track soundtracks.</p>
        </section>

        <!-- Controls & Category Filters (Requirement 8) -->
        <div class="arcade-controls-bar">
            <div class="arcade-filters">
                <button type="button" class="filter-btn active" data-filter="all">
                    <i class="fas fa-th-large"></i> All Games (<%= Object.keys(catalog).length %>)
                </button>
                <button type="button" class="filter-btn" data-filter="1P">
                    <i class="fas fa-user"></i> Single Player
                </button>
                <button type="button" class="filter-btn" data-filter="2P">
                    <i class="fas fa-user-friends"></i> 2 Players Online
                </button>
            </div>

            <div style="display: flex; gap: 8px;">
                <button type="button" class="arc-btn" id="hubRandomGameBtn" title="Launch Random Game">
                    <i class="fas fa-dice" style="color: var(--arc-accent);"></i>
                    <span>Surprise Me</span>
                </button>
            </div>
        </div>

        <!-- Games Grid -->
        <main class="arcade-game-grid" id="arcadeGameGrid">
            <% Object.values(catalog).forEach(game => { %>
                <div class="arcade-game-card" 
                     data-game-id="<%= game.id %>"
                     data-category="<%= game.category %>"
                     data-title="<%= game.name %>"
                     data-desc="<%= game.description %>"
                     data-icon="<%= game.icon %>"
                     data-type-label="<%= game.typeLabel %>"
                     data-screenshots='<%- JSON.stringify(game.screenshots) %>'
                     data-url="/games/<%= game.id %><%= typeof clubId !== 'undefined' && clubId ? ('?clubId=' + clubId) : '' %>">
                    
                    <!-- Cover Screenshot Preview Banner (Requirement: update game screenshot & icons representation) -->
                    <div class="card-banner-wrap">
                        <img src="<%= (game.screenshots && game.screenshots[0]) ? game.screenshots[0] : game.icon %>" 
                             alt="<%= game.name %> Gameplay" 
                             class="card-banner-img protect-asset" 
                             loading="lazy">
                        <div class="card-banner-gradient"></div>
                        <span class="card-badge <%= game.category === '2P' ? 'badge-2p' : 'badge-1p' %>">
                            <i class="fas <%= game.category === '2P' ? 'fa-user-friends' : 'fa-user' %>"></i> <%= game.category === '2P' ? '2P Online' : '1P Solo' %>
                        </span>
                    </div>

                    <div class="card-body-content">
                        <div class="card-title-row" style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                            <img src="<%= game.icon %>" alt="<%= game.name %> Icon" class="card-inline-icon protect-asset" loading="lazy">
                            <h3 class="card-title" style="margin-bottom: 0; flex: 1;">
                                <%= game.name %>
                            </h3>
                        </div>

                        <p class="card-desc">
                            <%= game.tagline %>
                        </p>

                        <div class="card-footer">
                            <span class="card-genre"><i class="fas fa-gamepad"></i> <%= game.typeLabel %></span>
                            <div class="card-actions-group">
                                <button type="button" class="card-preview-btn" data-action="details" title="Screenshots & Rules">
                                    <i class="fas fa-images"></i> Details
                                </button>
                                <span class="card-play-hint" data-action="play">
                                    Play <i class="fas fa-arrow-right"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>

            <!-- Coming Soon Card -->
            <div class="arcade-game-card coming-soon-card" style="opacity: 0.7; border-style: dashed; cursor: default;">
                <div class="card-banner-wrap" style="display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.03);">
                    <i class="fas fa-plus" style="font-size: 2.2rem; color: var(--arc-accent);"></i>
                </div>
                <div class="card-body-content">
                    <h3 class="card-title" style="color: var(--arc-text-muted);">More Games</h3>
                    <p class="card-desc">Additional retro and community multi-player board games arriving soon in GPLMods Arcade!</p>
                    <div class="card-footer">
                        <span style="font-size: 0.78rem; color: var(--arc-text-muted);">Stay tuned</span>
                    </div>
                </div>
            </div>
        </main>

        <!-- Arcade Footer Partial -->
        <%- include('./partials/footer') %>
    </div>

    <!-- Game Details & Screenshot Gallery Modal (Requirement 7) -->
    <div class="arc-modal-overlay" id="gameDetailsModalOverlay">
        <div class="arc-modal-card" style="max-width: 640px;">
            <div class="arc-modal-header">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <img id="detailModalIcon" src="" style="width: 38px; height: 38px; border-radius: 8px; object-fit: cover;" class="protect-asset">
                    <div>
                        <h3 id="detailModalTitle" style="margin: 0;">Game Title</h3>
                        <span id="detailModalBadge" class="card-badge badge-1p" style="position: static; font-size: 0.7rem; margin-top: 2px;"></span>
                    </div>
                </div>
                <button type="button" class="arc-btn arc-btn-icon" id="closeDetailModalBtn">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="arc-modal-body">
                <!-- Screenshots Gallery (Requirement 7) -->
                <div style="margin-bottom: 20px;">
                    <div style="font-size: 0.85rem; font-weight: 700; color: var(--arc-accent); margin-bottom: 8px; text-transform: uppercase;">
                        <i class="fas fa-images"></i> Gameplay Screenshots
                    </div>
                    <div id="detailScreenshotsContainer" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;"></div>
                </div>

                <!-- Description -->
                <div>
                    <div style="font-size: 0.85rem; font-weight: 700; color: var(--arc-accent); margin-bottom: 8px; text-transform: uppercase;">
                        <i class="fas fa-info-circle"></i> About This Game
                    </div>
                    <p id="detailModalDesc" style="font-size: 0.92rem; color: var(--arc-text-muted); line-height: 1.6;"></p>
                </div>
            </div>
            <div class="arc-modal-footer">
                <a href="#" id="detailPlayNowBtn" class="arc-btn arc-btn-accent" style="width: 100%; justify-content: center; padding: 12px; font-size: 1rem;">
                    <i class="fas fa-play"></i>
                    <span>PLAY GAME</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Settings Modal Partial -->
    <%- include('./partials/settings-modal') %>

    <!-- Policy Modal Partial -->
    <%- include('./partials/policy-modal') %>

    <!-- Leaderboard Modal Partial -->
    <%- include('./partials/leaderboard-modal') %>

    <!-- Scripts -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="/games/pocketclassics/js/audio-manager.js"></script>
    <script src="/games/pocketclassics/js/theme-manager.js"></script>
    <script src="/games/pocketclassics/js/protection.js"></script>
    <script src="/games/pocketclassics/js/multiplayer-client.js"></script>
    <script src="/games/pocketclassics/js/arcade-helper.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // 1. Category Filter Logic
            const filterBtns = document.querySelectorAll('.filter-btn');
            const gameCards = Array.from(document.querySelectorAll('.arcade-game-card[data-category]'));
            let activeFilterIndex = 0;

            function applyFilter(index) {
                activeFilterIndex = (index + filterBtns.length) % filterBtns.length;
                filterBtns.forEach((b, i) => b.classList.toggle('active', i === activeFilterIndex));
                const category = filterBtns[activeFilterIndex].dataset.filter;

                gameCards.forEach(card => {
                    if (category === 'all' || card.dataset.category === category) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                });
                updateCardFocus(0);
            }

            filterBtns.forEach((btn, idx) => {
                btn.addEventListener('click', function() {
                    applyFilter(idx);
                });
            });

            // 2. Interactive Game Details Modal with Screenshot Gallery
            const detailsOverlay = document.getElementById('gameDetailsModalOverlay');
            const detailTitle = document.getElementById('detailModalTitle');
            const detailDesc = document.getElementById('detailModalDesc');
            const detailIcon = document.getElementById('detailModalIcon');
            const detailBadge = document.getElementById('detailModalBadge');
            const detailScreenshots = document.getElementById('detailScreenshotsContainer');
            const detailPlayBtn = document.getElementById('detailPlayNowBtn');
            const closeDetailBtn = document.getElementById('closeDetailModalBtn');

            function openCardDetails(card) {
                const title = card.dataset.title;
                const desc = card.dataset.desc;
                const icon = card.dataset.icon;
                const typeLabel = card.dataset.typeLabel;
                const category = card.dataset.category;
                const url = card.dataset.url;
                let screenshots = [];
                try {
                    screenshots = JSON.parse(card.dataset.screenshots || '[]');
                } catch (err) {}

                detailTitle.textContent = title;
                detailDesc.textContent = desc;
                detailIcon.src = icon;
                detailBadge.textContent = typeLabel;
                detailBadge.className = `card-badge ${category === '2P' ? 'badge-2p' : 'badge-1p'}`;
                detailPlayBtn.href = url;

                detailScreenshots.innerHTML = screenshots.map((ss, idx) => `
                    <div style="border-radius: 10px; overflow: hidden; border: 1px solid var(--arc-border); background: #000; aspect-ratio: 16/9;">
                        <img src="${ss}" alt="${title} Screenshot ${idx + 1}" style="width: 100%; height: 100%; object-fit: cover;" class="protect-asset">
                    </div>
                `).join('');

                detailsOverlay.classList.add('open');
            }

            gameCards.forEach(card => {
                card.addEventListener('click', (e) => {
                    const detailsBtn = e.target.closest('[data-action="details"]');
                    if (detailsBtn) {
                        e.preventDefault();
                        e.stopPropagation();
                        openCardDetails(card);
                        return;
                    }
                    const playHint = e.target.closest('[data-action="play"]');
                    if (playHint) {
                        e.preventDefault();
                        window.location.href = card.dataset.url;
                        return;
                    }
                    // Clicking elsewhere on card opens details modal
                    openCardDetails(card);
                });
            });

            closeDetailBtn?.addEventListener('click', () => {
                detailsOverlay.classList.remove('open');
            });

            // 3. Gamepad & Keyboard Navigation for Hub
            let focusedCardIndex = 0;
            function getVisibleCards() {
                return gameCards.filter(c => c.style.display !== 'none');
            }

            function updateCardFocus(newIdx) {
                const visible = getVisibleCards();
                if (visible.length === 0) return;
                visible.forEach(c => c.classList.remove('card-focused'));
                focusedCardIndex = Math.max(0, Math.min(visible.length - 1, newIdx));
                if (visible[focusedCardIndex]) {
                    visible[focusedCardIndex].classList.add('card-focused');
                    visible[focusedCardIndex].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            }

            function getGridColumns() {
                const grid = document.getElementById('arcadeGameGrid');
                if (!grid) return 1;
                const gridWidth = grid.clientWidth;
                if (gridWidth >= 1000) return 4;
                if (gridWidth >= 700) return 3;
                if (gridWidth >= 500) return 2;
                return 1;
            }

            // Keyboard navigation
            window.addEventListener('keydown', (e) => {
                if (detailsOverlay.classList.contains('open')) {
                    if (e.key === 'Escape') {
                        detailsOverlay.classList.remove('open');
                    } else if (e.code === 'Space' || e.key === 'Enter') {
                        e.preventDefault();
                        detailPlayBtn.click();
                    }
                    return;
                }

                const visible = getVisibleCards();
                const cols = getGridColumns();

                if (e.code === 'ArrowRight' || e.code === 'KeyD') {
                    e.preventDefault();
                    updateCardFocus(focusedCardIndex + 1);
                } else if (e.code === 'ArrowLeft' || e.code === 'KeyA') {
                    e.preventDefault();
                    updateCardFocus(focusedCardIndex - 1);
                } else if (e.code === 'ArrowDown' || e.code === 'KeyS') {
                    e.preventDefault();
                    updateCardFocus(focusedCardIndex + cols);
                } else if (e.code === 'ArrowUp' || e.code === 'KeyW') {
                    e.preventDefault();
                    updateCardFocus(focusedCardIndex - cols);
                } else if (e.code === 'Space' || e.key === 'Enter') {
                    e.preventDefault();
                    if (visible[focusedCardIndex]) {
                        openCardDetails(visible[focusedCardIndex]);
                    }
                } else if (e.code === 'Tab') {
                    e.preventDefault();
                    applyFilter(activeFilterIndex + (e.shiftKey ? -1 : 1));
                }
            });

            // Gamepad Controller integration for Hub
            if (window.ArcadeGamepadController) {
                new ArcadeGamepadController({
                    onDirectionDown: (dir) => {
                        if (detailsOverlay.classList.contains('open')) return;
                        const cols = getGridColumns();
                        if (dir === 'right') updateCardFocus(focusedCardIndex + 1);
                        else if (dir === 'left') updateCardFocus(focusedCardIndex - 1);
                        else if (dir === 'down') updateCardFocus(focusedCardIndex + cols);
                        else if (dir === 'up') updateCardFocus(focusedCardIndex - cols);
                    },
                    onActionDown: (action) => {
                        if (action === 'a' || action === 'start') {
                            if (detailsOverlay.classList.contains('open')) {
                                detailPlayBtn.click();
                            } else {
                                const visible = getVisibleCards();
                                if (visible[focusedCardIndex]) {
                                    openCardDetails(visible[focusedCardIndex]);
                                }
                            }
                        } else if (action === 'b') {
                            if (detailsOverlay.classList.contains('open')) {
                                detailsOverlay.classList.remove('open');
                            }
                        }
                    }
                });
            }

            // 4. Settings Modal Toggle
            const openSettingsBtn = document.getElementById('openSettingsBtn');
            const settingsOverlay = document.getElementById('settingsModalOverlay');
            openSettingsBtn?.addEventListener('click', () => {
                settingsOverlay.classList.add('open');
            });

            // Theme switchers in settings modal
            document.querySelectorAll('.theme-option-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    window.ArcadeTheme?.setTheme(this.dataset.theme);
                });
            });

            // Music toggle button in header
            document.getElementById('musicToggleBtn')?.addEventListener('click', () => {
                const state = window.ArcadeAudio?.toggleMusic();
                const icon = document.querySelector('#musicToggleBtn i');
                if (icon) icon.className = state ? 'fas fa-music' : 'fas fa-volume-mute';
            });

            // Policy Modal
            document.getElementById('openPrivacyBtn')?.addEventListener('click', () => {
                document.getElementById('policyModalOverlay').classList.add('open');
            });

            // Surprise Me / Random Game
            document.getElementById('hubRandomGameBtn')?.addEventListener('click', () => {
                const visibleCards = getVisibleCards();
                if (visibleCards.length > 0) {
                    const picked = visibleCards[Math.floor(Math.random() * visibleCards.length)];
                    openCardDetails(picked);
                }
            });
        });
    </script>
</body>
</html>
