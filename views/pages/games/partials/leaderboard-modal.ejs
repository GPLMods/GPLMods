<div class="arc-modal-overlay" id="leaderboardModalOverlay">
    <div class="arc-modal-card" style="max-width: 680px;">
        <div class="arc-modal-header">
            <h3><i class="fas fa-trophy" style="color: var(--arc-accent);"></i> Arcade Live Leaderboards</h3>
            <button type="button" class="arc-btn arc-btn-icon" onclick="document.getElementById('leaderboardModalOverlay').classList.remove('open')">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="arc-modal-body">
            <!-- Filter Bar -->
            <div style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                    <!-- Game Filter Dropdown (Requirement: Game filter dropdown in each game & distinct playtime) -->
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <select id="lbGameSelect" class="arc-btn" style="background: rgba(255,255,255,0.06); border: 1px solid var(--arc-border); border-radius: 8px; color: var(--arc-text-main); padding: 7px 12px; font-weight: 600; cursor: pointer; outline: none;">
                            <option value="all">🎮 All Games (Distinct)</option>
                            <option value="2048">2048 Classic</option>
                            <option value="air-hockey">Air Hockey Showdown</option>
                            <option value="checkers">Checkers (Draughts)</option>
                            <option value="chess">Classic Chess Master</option>
                            <option value="minesweeper">Minesweeper Retro</option>
                            <option value="othello">Othello (Reversi)</option>
                            <option value="rock-paper-scissors">Rock Paper Scissors</option>
                            <option value="snake">Snake Classic Arcade</option>
                            <option value="snakes-ladders">Snakes & Ladders</option>
                            <option value="tictactoe">Tic Tac Toe</option>
                        </select>
                    </div>

                    <div style="display: flex; gap: 4px;">
                        <button type="button" class="arc-btn arc-btn-accent lb-metric-btn active" data-metric="score">
                            <i class="fas fa-star"></i> High Score
                        </button>
                        <button type="button" class="arc-btn lb-metric-btn" data-metric="wins">
                            <i class="fas fa-crown"></i> Most Wins
                        </button>
                        <button type="button" class="arc-btn lb-metric-btn" data-metric="playtime">
                            <i class="fas fa-clock"></i> Playtime
                        </button>
                    </div>
                </div>

                <div style="display: flex; gap: 6px;">
                    <button type="button" class="arc-btn arc-btn-accent lb-filter-btn active" data-filter="global">
                        <i class="fas fa-globe"></i> Global
                    </button>
                    <button type="button" class="arc-btn lb-filter-btn" data-filter="country" id="lbCountryBtn">
                        <i class="fas fa-flag"></i> My Country
                    </button>
                </div>
            </div>

            <!-- List of Rankings -->
            <div id="leaderboardListContainer" style="display: flex; flex-direction: column; gap: 8px; min-height: 200px;">
                <div style="padding: 20px; text-align: center; color: var(--arc-text-muted);">
                    <i class="fas fa-spinner fa-spin" style="margin-right: 8px;"></i> Loading live leaderboard...
                </div>
            </div>
        </div>
        <div class="arc-modal-footer">
            <span style="font-size: 0.8rem; color: var(--arc-text-muted); margin-right: auto;">
                <i class="fas fa-shield-alt" style="color: var(--arc-accent);"></i> Registered players only. Guest data is not stored.
            </span>
            <button type="button" class="arc-btn arc-btn-accent" onclick="document.getElementById('leaderboardModalOverlay').classList.remove('open')">
                Close
            </button>
        </div>
    </div>
</div>

<script>
    (function() {
        let activeMetric = 'score';
        let activeFilter = 'global';
        const userCountry = window.__ARCADE_USER__?.country || 'India';
        const gameSelect = document.getElementById('lbGameSelect');

        // Automatically preselect current game if inside an individual game room
        if (window.__GAME_ID__ && gameSelect) {
            const hasOption = Array.from(gameSelect.options).some(o => o.value === window.__GAME_ID__);
            if (hasOption) {
                gameSelect.value = window.__GAME_ID__;
            }
        }

        async function fetchLeaderboard() {
            const container = document.getElementById('leaderboardListContainer');
            if (!container) return;
            container.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--arc-text-muted);"><i class="fas fa-spinner fa-spin"></i> Loading...</div>';

            try {
                const selectedGame = gameSelect ? gameSelect.value : (window.__GAME_ID__ || 'all');
                const url = `/games/api/leaderboard?gameId=${encodeURIComponent(selectedGame)}&metric=${activeMetric}&filter=${activeFilter}&country=${encodeURIComponent(userCountry)}`;
                const res = await fetch(url);
                const data = await res.json();

                if (!data.leaderboard || data.leaderboard.length === 0) {
                    container.innerHTML = '<div style="padding: 30px; text-align: center; color: var(--arc-text-muted);"><i class="fas fa-trophy" style="font-size: 2rem; color: #555; display: block; margin-bottom: 10px;"></i>No recorded games in this bracket yet. Play now to claim #1!</div>';
                    return;
                }

                container.innerHTML = data.leaderboard.map((item, idx) => {
                    let medal = `<span style="font-weight: 700; color: var(--arc-text-muted); width: 22px; text-align: center;">#${idx + 1}</span>`;
                    if (idx === 0) medal = `<span style="color: #ffd700; font-size: 1.15rem; width: 22px; text-align: center;"><i class="fas fa-trophy"></i></span>`;
                    else if (idx === 1) medal = `<span style="color: #c0c0c0; font-size: 1.15rem; width: 22px; text-align: center;"><i class="fas fa-medal"></i></span>`;
                    else if (idx === 2) medal = `<span style="color: #cd7f32; font-size: 1.15rem; width: 22px; text-align: center;"><i class="fas fa-medal"></i></span>`;

                    let valueDisplay = `${(item.score || 0).toLocaleString()} pts`;
                    if (activeMetric === 'wins') valueDisplay = `${item.wins || 0} Wins`;
                    else if (activeMetric === 'playtime') {
                        // Playtime shown distinctly for this specific game
                        const totalSecs = item.playtime || 0;
                        const hours = Math.floor(totalSecs / 3600);
                        const mins = Math.floor((totalSecs % 3600) / 60);
                        const secs = totalSecs % 60;
                        if (hours > 0) {
                            valueDisplay = `${hours}h ${mins}m`;
                        } else {
                            valueDisplay = `${mins}m ${secs}s`;
                        }
                    }

                    const gameLabel = (item.gameId || 'game').replace(/-/g, ' ');

                    return `
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: rgba(255,255,255,0.03); border: 1px solid var(--arc-border); border-radius: 10px; gap: 10px;">
                            <div style="display: flex; align-items: center; gap: 12px; min-width: 0;">
                                ${medal}
                                <img src="${item.avatar || '/images/default-avatar.png'}" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid var(--arc-border);" onerror="this.src='/images/default-avatar.png'">
                                <div style="min-width: 0;">
                                    <strong style="display: block; font-size: 0.92rem; color: var(--arc-text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${item.username}</strong>
                                    <span style="font-size: 0.75rem; color: var(--arc-text-muted);"><i class="fas fa-globe-americas"></i> ${item.country || 'Global'} &bull; <span style="text-transform: capitalize; color: var(--arc-accent);">${gameLabel}</span></span>
                                </div>
                            </div>
                            <div style="text-align: right; flex-shrink: 0;">
                                <strong style="color: var(--arc-accent); font-size: 0.95rem;">${valueDisplay}</strong>
                            </div>
                        </div>
                    `;
                }).join('');
            } catch (err) {
                container.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--arc-danger);">Failed to load leaderboard data.</div>';
            }
        }

        if (gameSelect) {
            gameSelect.addEventListener('change', fetchLeaderboard);
        }

        document.querySelectorAll('.lb-metric-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.lb-metric-btn').forEach(b => b.classList.remove('arc-btn-accent'));
                this.classList.add('arc-btn-accent');
                activeMetric = this.dataset.metric;
                fetchLeaderboard();
            });
        });

        document.querySelectorAll('.lb-filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.lb-filter-btn').forEach(b => b.classList.remove('arc-btn-accent'));
                this.classList.add('arc-btn-accent');
                activeFilter = this.dataset.filter;
                fetchLeaderboard();
            });
        });

        window.openLeaderboard = function() {
            if (window.__GAME_ID__ && gameSelect) {
                gameSelect.value = window.__GAME_ID__;
            }
            document.getElementById('leaderboardModalOverlay').classList.add('open');
            fetchLeaderboard();
        };

        const triggerBtn = document.getElementById('openLeaderboardBtn');
        if (triggerBtn) triggerBtn.addEventListener('click', window.openLeaderboard);
    })();
</script>
