<div class="arc-modal-overlay" id="leaderboardModalOverlay">
    <div class="arc-modal-card" style="max-width: 680px;">
        <div class="arc-modal-header">
            <h3><i class="fas fa-trophy" style="color: var(--arc-accent);"></i> Arcade Live Leaderboards</h3>
            <button type="button" class="arc-btn arc-btn-icon" onclick="document.getElementById('leaderboardModalOverlay').classList.remove('open')">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="arc-modal-body">
            <!-- Filter Bar -->
            <div style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                    <!-- Game Filter Dropdown (Requirement: Game filter dropdown in each game & distinct playtime) -->
                    <!-- Custom Game Filter Dropdown UI -->
                    <div class="arc-custom-dropdown" id="lbGameCustomDropdown" style="position: relative; min-width: 190px;">
                        <input type="hidden" id="lbGameSelect" value="all">
                        <button type="button" class="arc-dropdown-trigger arc-btn" id="lbDropdownTrigger" style="width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px; background: rgba(255,255,255,0.06); border: 1px solid var(--arc-border); border-radius: 8px; color: var(--arc-text-main); padding: 7px 12px; font-weight: 600; font-size: 0.85rem; cursor: pointer; outline: none;">
                            <span id="lbDropdownLabel" style="display: flex; align-items: center; gap: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                🎮 All Games (Distinct)
                            </span>
                            <i class="fas fa-chevron-down" id="lbDropdownChevron" style="font-size: 0.72rem; color: var(--arc-accent); transition: transform 0.2s;"></i>
                        </button>
                        <div class="arc-dropdown-menu" id="lbDropdownMenu" style="display: none; position: absolute; top: calc(100% + 4px); left: 0; width: 100%; max-height: 240px; overflow-y: auto; background: #0f172a; border: 1px solid var(--arc-border); border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.6); z-index: 1000; padding: 4px 0;">
                            <div class="arc-dropdown-item active" data-value="all" style="padding: 7px 12px; font-size: 0.84rem; color: var(--arc-text-main); cursor: pointer;">🎮 All Games (Distinct)</div>
                            <div class="arc-dropdown-item" data-value="2048" style="padding: 7px 12px; font-size: 0.84rem; color: var(--arc-text-main); cursor: pointer;">2048 Classic</div>
                            <div class="arc-dropdown-item" data-value="air-hockey" style="padding: 7px 12px; font-size: 0.84rem; color: var(--arc-text-main); cursor: pointer;">Air Hockey Showdown</div>
                            <div class="arc-dropdown-item" data-value="checkers" style="padding: 7px 12px; font-size: 0.84rem; color: var(--arc-text-main); cursor: pointer;">Checkers (Draughts)</div>
                            <div class="arc-dropdown-item" data-value="chess" style="padding: 7px 12px; font-size: 0.84rem; color: var(--arc-text-main); cursor: pointer;">Classic Chess Master</div>
                            <div class="arc-dropdown-item" data-value="minesweeper" style="padding: 7px 12px; font-size: 0.84rem; color: var(--arc-text-main); cursor: pointer;">Minesweeper Retro</div>
                            <div class="arc-dropdown-item" data-value="othello" style="padding: 7px 12px; font-size: 0.84rem; color: var(--arc-text-main); cursor: pointer;">Othello (Reversi)</div>
                            <div class="arc-dropdown-item" data-value="rock-paper-scissors" style="padding: 7px 12px; font-size: 0.84rem; color: var(--arc-text-main); cursor: pointer;">Rock Paper Scissors</div>
                            <div class="arc-dropdown-item" data-value="snake" style="padding: 7px 12px; font-size: 0.84rem; color: var(--arc-text-main); cursor: pointer;">Snake Classic Arcade</div>
                            <div class="arc-dropdown-item" data-value="snakes-ladders" style="padding: 7px 12px; font-size: 0.84rem; color: var(--arc-text-main); cursor: pointer;">Snakes & Ladders</div>
                            <div class="arc-dropdown-item" data-value="tictactoe" style="padding: 7px 12px; font-size: 0.84rem; color: var(--arc-text-main); cursor: pointer;">Tic Tac Toe</div>
                        </div>
                    </div>

                    <div style="display: flex; gap: 4px;">
                        <button type="button" class="arc-btn arc-btn-accent lb-metric-btn active" data-metric="score">
                            <i class="fas fa-star"></i> High Score
                        </button>
                        <button type="button" class="arc-btn lb-metric-btn" data-metric="wins">
                            <i class="fas fa-crown"></i> Most Wins
                        </button>
                        <button type="button" class="arc-btn lb-metric-btn" data-metric="playtime">
                            <i class="fas fa-clock"></i> Playtime
                        </button>
                    </div>
                </div>

                <div style="display: flex; gap: 6px;">
                    <button type="button" class="arc-btn arc-btn-accent lb-filter-btn active" data-filter="global">
                        <i class="fas fa-globe"></i> Global
                    </button>
                    <button type="button" class="arc-btn lb-filter-btn" data-filter="country" id="lbCountryBtn">
                        <i class="fas fa-flag"></i> My Country
                    </button>
                </div>
            </div>

            <!-- List of Rankings -->
            <div id="leaderboardListContainer" style="display: flex; flex-direction: column; gap: 8px; min-height: 200px;">
                <div style="padding: 20px; text-align: center; color: var(--arc-text-muted);">
                    <i class="fas fa-spinner fa-spin" style="margin-right: 8px;"></i> Loading live leaderboard...
                </div>
            </div>
        </div>
        <div class="arc-modal-footer">
            <span style="font-size: 0.8rem; color: var(--arc-text-muted); margin-right: auto;">
                <i class="fas fa-shield-alt" style="color: var(--arc-accent);"></i> Registered players only. Guest data is not stored.
            </span>
            <button type="button" class="arc-btn arc-btn-accent" onclick="document.getElementById('leaderboardModalOverlay').classList.remove('open')">
                Close
            </button>
        </div>
    </div>
</div>

<style>
    .arc-custom-dropdown .arc-dropdown-item:hover {
        background: rgba(99, 102, 241, 0.2);
        color: var(--arc-accent) !important;
    }
    .arc-custom-dropdown .arc-dropdown-item.active {
        background: rgba(99, 102, 241, 0.35);
        color: var(--arc-accent) !important;
        font-weight: 700;
    }
</style>

<script>
    (function() {
        let activeMetric = 'score';
        let activeFilter = 'global';
        const userCountry = window.__ARCADE_USER__?.country || 'India';
        const gameSelect = document.getElementById('lbGameSelect');
        const dropdownTrigger = document.getElementById('lbDropdownTrigger');
        const dropdownLabel = document.getElementById('lbDropdownLabel');
        const dropdownMenu = document.getElementById('lbDropdownMenu');
        const dropdownChevron = document.getElementById('lbDropdownChevron');
        const dropdownItems = document.querySelectorAll('.arc-dropdown-item');

        function toggleDropdown(show) {
            const isOpen = show !== undefined ? show : (dropdownMenu.style.display === 'block');
            if (isOpen) {
                dropdownMenu.style.display = 'none';
                if (dropdownChevron) dropdownChevron.style.transform = 'rotate(0deg)';
            } else {
                dropdownMenu.style.display = 'block';
                if (dropdownChevron) dropdownChevron.style.transform = 'rotate(180deg)';
            }
        }

        dropdownTrigger?.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleDropdown();
        });

        document.addEventListener('click', (e) => {
            if (!document.getElementById('lbGameCustomDropdown')?.contains(e.target)) {
                toggleDropdown(true);
            }
        });

        function selectGameOption(val, text) {
            if (gameSelect) gameSelect.value = val;
            if (dropdownLabel) dropdownLabel.innerHTML = text;
            dropdownItems.forEach(item => {
                item.classList.toggle('active', item.dataset.value === val);
            });
            toggleDropdown(true);
            fetchLeaderboard();
        }

        dropdownItems.forEach(item => {
            item.addEventListener('click', () => {
                selectGameOption(item.dataset.value, item.innerHTML);
            });
        });

        // Automatically preselect current game if inside an individual game room
        if (window.__GAME_ID__) {
            const matchingItem = Array.from(dropdownItems).find(i => i.dataset.value === window.__GAME_ID__);
            if (matchingItem) {
                if (gameSelect) gameSelect.value = window.__GAME_ID__;
                if (dropdownLabel) dropdownLabel.innerHTML = matchingItem.innerHTML;
                dropdownItems.forEach(item => item.classList.toggle('active', item.dataset.value === window.__GAME_ID__));
            }
        }

        async function fetchLeaderboard() {
            const container = document.getElementById('leaderboardListContainer');
            if (!container) return;
            container.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--arc-text-muted);"><i class="fas fa-spinner fa-spin"></i> Loading...</div>';

            try {
                const selectedGame = gameSelect ? gameSelect.value : (window.__GAME_ID__ || 'all');
                const url = `/games/api/leaderboard?gameId=${encodeURIComponent(selectedGame)}&metric=${activeMetric}&filter=${activeFilter}&country=${encodeURIComponent(userCountry)}`;
                const res = await fetch(url);
                const data = await res.json();

                if (!data.leaderboard || data.leaderboard.length === 0) {
                    container.innerHTML = '<div style="padding: 30px; text-align: center; color: var(--arc-text-muted);"><i class="fas fa-trophy" style="font-size: 2rem; color: #555; display: block; margin-bottom: 10px;"></i>No recorded games in this bracket yet. Play now to claim #1!</div>';
                    return;
                }

                container.innerHTML = data.leaderboard.map((item, idx) => {
                    let medal = `<span style="font-weight: 700; color: var(--arc-text-muted); width: 22px; text-align: center;">#${idx + 1}</span>`;
                    if (idx === 0) medal = `<span style="color: #ffd700; font-size: 1.15rem; width: 22px; text-align: center;"><i class="fas fa-trophy"></i></span>`;
                    else if (idx === 1) medal = `<span style="color: #c0c0c0; font-size: 1.15rem; width: 22px; text-align: center;"><i class="fas fa-medal"></i></span>`;
                    else if (idx === 2) medal = `<span style="color: #cd7f32; font-size: 1.15rem; width: 22px; text-align: center;"><i class="fas fa-medal"></i></span>`;

                    let valueDisplay = `${(item.score || 0).toLocaleString()} pts`;
                    if (activeMetric === 'wins') valueDisplay = `${item.wins || 0} Wins`;
                    else if (activeMetric === 'playtime') {
                        // Playtime shown distinctly for this specific game
                        const totalSecs = item.playtime || 0;
                        const hours = Math.floor(totalSecs / 3600);
                        const mins = Math.floor((totalSecs % 3600) / 60);
                        const secs = totalSecs % 60;
                        if (hours > 0) {
                            valueDisplay = `${hours}h ${mins}m`;
                        } else {
                            valueDisplay = `${mins}m ${secs}s`;
                        }
                    }

                    const gameLabel = (item.gameId || 'game').replace(/-/g, ' ');

                    return `
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: rgba(255,255,255,0.03); border: 1px solid var(--arc-border); border-radius: 10px; gap: 10px;">
                            <div style="display: flex; align-items: center; gap: 12px; min-width: 0;">
                                ${medal}
                                <a href="/users/${encodeURIComponent(item.username)}" target="_blank" title="View ${item.username}'s Profile" style="display: inline-flex; border-radius: 50%; text-decoration: none;">
                                    <img src="${item.avatar || '/images/default-avatar.png'}" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid var(--arc-border); cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.12)'" onmouseout="this.style.transform='scale(1)'" onerror="this.src='/images/default-avatar.png'">
                                </a>
                                <div style="min-width: 0;">
                                    <a href="/users/${encodeURIComponent(item.username)}" target="_blank" style="text-decoration: none; color: inherit;" title="View Profile">
                                        <strong style="display: block; font-size: 0.92rem; color: var(--arc-text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer;">${item.username}</strong>
                                    </a>
                                    <span style="font-size: 0.75rem; color: var(--arc-text-muted);"><i class="fas fa-globe-americas"></i> ${item.country || 'Global'} &bull; <span style="text-transform: capitalize; color: var(--arc-accent);">${gameLabel}</span></span>
                                </div>
                            </div>
                            <div style="text-align: right; flex-shrink: 0;">
                                <strong style="color: var(--arc-accent); font-size: 0.95rem;">${valueDisplay}</strong>
                            </div>
                        </div>
                    `;
                }).join('');
            } catch (err) {
                container.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--arc-danger);">Failed to load leaderboard data.</div>';
            }
        }

        document.querySelectorAll('.lb-metric-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.lb-metric-btn').forEach(b => b.classList.remove('arc-btn-accent'));
                this.classList.add('arc-btn-accent');
                activeMetric = this.dataset.metric;
                fetchLeaderboard();
            });
        });

        document.querySelectorAll('.lb-filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.lb-filter-btn').forEach(b => b.classList.remove('arc-btn-accent'));
                this.classList.add('arc-btn-accent');
                activeFilter = this.dataset.filter;
                fetchLeaderboard();
            });
        });

        window.openLeaderboard = function() {
            if (window.__GAME_ID__) {
                const matchingItem = Array.from(dropdownItems).find(i => i.dataset.value === window.__GAME_ID__);
                if (matchingItem) {
                    if (gameSelect) gameSelect.value = window.__GAME_ID__;
                    if (dropdownLabel) dropdownLabel.innerHTML = matchingItem.innerHTML;
                    dropdownItems.forEach(item => item.classList.toggle('active', item.dataset.value === window.__GAME_ID__));
                }
            }
            document.getElementById('leaderboardModalOverlay').classList.add('open');
            fetchLeaderboard();
        };

        const triggerBtn = document.getElementById('openLeaderboardBtn');
        if (triggerBtn) triggerBtn.addEventListener('click', window.openLeaderboard);
    })();
</script>
