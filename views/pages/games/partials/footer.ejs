<footer style="margin-top: auto; padding: 25px 0; border-top: 1px solid var(--arc-border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 15px; font-size: 0.86rem; color: var(--arc-text-muted);">
    <div style="display: flex; align-items: center; gap: 8px;">
        <i class="fas fa-gamepad" style="color: var(--arc-accent);"></i>
        <span>Pocket Classics &copy; <%= new Date().getFullYear() %> GPLMods Arcade</span>
    </div>

    <div style="display: flex; align-items: center; gap: 16px;">
        <button type="button" id="openPrivacyBtn" style="background: none; border: none; color: var(--arc-text-muted); cursor: pointer; text-decoration: underline; font-size: 0.85rem;">
            Privacy Policy
        </button>
        <a href="https://youtube.com/@gamingnetindia" target="_blank" rel="noopener noreferrer" style="color: var(--arc-text-muted); font-size: 1.1rem;" title="YouTube">
            <i class="fab fa-youtube"></i>
        </a>
        <a href="https://discord.gg" target="_blank" rel="noopener noreferrer" style="color: var(--arc-text-muted); font-size: 1.1rem;" title="Discord">
            <i class="fab fa-discord"></i>
        </a>
        <a href="/" style="color: var(--arc-text-muted); font-size: 1.1rem;" title="GPLMods Home">
            <i class="fas fa-home"></i>
        </a>
    </div>
</footer>
