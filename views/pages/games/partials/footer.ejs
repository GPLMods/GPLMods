<footer class="arcade-footer" style="margin-top: auto; padding: 25px 0; border-top: 1px solid var(--arc-border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 15px; font-size: 0.86rem; color: var(--arc-text-muted);">
    <div style="display: flex; align-items: center; gap: 8px;">
        <i class="fas fa-gamepad" style="color: var(--arc-accent);"></i>
        <span>Pocket Classics &copy; <%= new Date().getFullYear() %> GPLMods Arcade</span>
    </div>

    <!-- Developer Branding -->
    <div style="display: flex; flex-direction: column; align-items: center; gap: 3px;">
        <div style="display: flex; align-items: center; gap: 6px; font-weight: 700; font-size: 0.92rem; letter-spacing: 0.3px;">
            <span style="color: #ff9800;">Gaming</span>
            <span style="background: linear-gradient(135deg, #ffffff, #60a5fa); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Net</span>
            <span style="color: #22c55e;">India</span>
            <span style="margin-left: 6px; font-size: 0.8rem; font-weight: 600; background: linear-gradient(135deg, #f472b6, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-flex; align-items: center; gap: 4px;">
                #coded with <i class="fas fa-heart" style="color: #ec4899; -webkit-text-fill-color: #ec4899;"></i>
            </span>
        </div>
        <div style="font-size: 0.74rem; color: var(--arc-text-muted); font-weight: 600; letter-spacing: 0.8px;">
            Gaming Net India X GPL Mods
        </div>
    </div>

    <div style="display: flex; align-items: center; gap: 16px;">
        <button type="button" id="openPrivacyBtn" style="background: none; border: none; color: var(--arc-text-muted); cursor: pointer; text-decoration: underline; font-size: 0.85rem;">
            Privacy Policy
        </button>
        <a href="https://youtube.com/@gamingnetindia" target="_blank" rel="noopener noreferrer" style="color: var(--arc-text-muted); font-size: 1.1rem;" title="YouTube">
            <i class="fab fa-youtube"></i>
        </a>
        <a href="https://discord.gg" target="_blank" rel="noopener noreferrer" style="color: var(--arc-text-muted); font-size: 1.1rem;" title="Discord">
            <i class="fab fa-discord"></i>
        </a>
        <a href="/" style="color: var(--arc-text-muted); font-size: 1.1rem;" title="GPLMods Home">
            <i class="fas fa-home"></i>
        </a>
    </div>
</footer>
