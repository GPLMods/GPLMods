<div class="arc-modal-overlay" id="multiplayerRoomOverlay">
    <div class="arc-modal-card" style="max-width: 540px;">
        <div class="arc-modal-header">
            <h3><i class="fas fa-users" style="color: var(--arc-accent);"></i> Online Multiplayer Room</h3>
            <button type="button" class="arc-btn arc-btn-icon" onclick="document.getElementById('multiplayerRoomOverlay').classList.remove('open')">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="arc-modal-body">
            <!-- Setup Pane (Before Match) -->
            <div id="mpSetupPane">
                <div style="display: flex; gap: 10px; margin-bottom: 20px;">
                    <button type="button" class="arc-btn arc-btn-accent" id="mpQuickMatchBtn" style="flex: 1; padding: 14px; justify-content: center;">
                        <i class="fas fa-bolt"></i>
                        <span>Quick Match (Random)</span>
                    </button>
                    <button type="button" class="arc-btn" id="mpCreateRoomBtn" style="flex: 1; padding: 14px; justify-content: center;">
                        <i class="fas fa-plus-circle"></i>
                        <span>Create Private Room</span>
                    </button>
                </div>

                <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--arc-border); border-radius: 12px; padding: 16px; margin-bottom: 20px;">
                    <label style="display: block; font-size: 0.85rem; color: var(--arc-text-muted); margin-bottom: 8px; font-weight: 600;">Have an invite room code?</label>
                    <div style="display: flex; gap: 8px;">
                        <input type="text" id="mpJoinCodeInput" placeholder="Enter 6-char Room Code (e.g. ARC942)" maxlength="8" style="flex: 1; background: #000; border: 1px solid var(--arc-border); color: #fff; padding: 10px 14px; border-radius: 8px; font-family: monospace; font-size: 1.1rem; text-transform: uppercase; outline: none;">
                        <button type="button" class="arc-btn arc-btn-accent" id="mpJoinRoomBtn">
                            <i class="fas fa-sign-in-alt"></i> Join
                        </button>
                    </div>
                </div>

                <!-- Waiting Lobby Status (Hidden until code generated or matching) -->
                <div id="mpWaitingLobby" style="display: none; background: rgba(255, 215, 0, 0.08); border: 1px solid var(--arc-accent); border-radius: 12px; padding: 20px; text-align: center;">
                    <i class="fas fa-spinner fa-spin" style="font-size: 2.2rem; color: var(--arc-accent); margin-bottom: 12px; display: block;"></i>
                    <h4 id="mpWaitingTitle" style="color: var(--arc-text-main); margin-bottom: 6px;">Searching for Opponent...</h4>
                    <p id="mpWaitingSub" style="font-size: 0.85rem; color: var(--arc-text-muted); margin-bottom: 15px;">Waiting for a challenger to join your room.</p>
                    
                    <div id="mpRoomCodeBox" style="display: none; margin-bottom: 15px;">
                        <div style="font-size: 0.8rem; color: var(--arc-text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">Invite Code</div>
                        <div style="display: inline-flex; align-items: center; gap: 10px; background: #000; border: 1px dashed var(--arc-accent); padding: 8px 18px; border-radius: 8px;">
                            <strong id="mpDisplayCode" style="font-size: 1.6rem; letter-spacing: 3px; color: var(--arc-accent); font-family: monospace;">------</strong>
                            <button type="button" class="arc-btn" id="mpCopyCodeBtn" style="padding: 6px 12px; font-size: 0.8rem;">
                                <i class="fas fa-copy"></i> Copy
                            </button>
                        </div>
                    </div>

                    <button type="button" class="arc-btn" id="mpCancelMatchBtn" style="color: var(--arc-danger); border-color: rgba(239, 68, 68, 0.4);">
                        Cancel Search
                    </button>
                </div>
            </div>

            <!-- Active Match & Live Chat Pane (Shown when playing) -->
            <div id="mpActiveMatchPane" style="display: none;">
                <div style="display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.04); border: 1px solid var(--arc-border); border-radius: 12px; padding: 12px 16px; margin-bottom: 16px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <img id="mpP1Avatar" src="/images/default-avatar.png" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 2px solid var(--arc-accent);">
                        <div>
                            <strong id="mpP1Name" style="font-size: 0.88rem; display: block; color: var(--arc-accent);">Player 1</strong>
                            <span id="mpP1Country" style="font-size: 0.75rem; color: var(--arc-text-muted);">Global</span>
                        </div>
                    </div>
                    <span style="font-weight: 800; color: var(--arc-text-muted); font-size: 0.9rem;">VS</span>
                    <div style="display: flex; align-items: center; gap: 8px; text-align: right;">
                        <div>
                            <strong id="mpP2Name" style="font-size: 0.88rem; display: block; color: #60a5fa;">Player 2</strong>
                            <span id="mpP2Country" style="font-size: 0.75rem; color: var(--arc-text-muted);">Global</span>
                        </div>
                        <img id="mpP2Avatar" src="/images/default-avatar.png" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 2px solid #60a5fa;">
                    </div>
                </div>

                <!-- Turn indicator -->
                <div id="mpTurnNotice" style="background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; border-radius: 8px; padding: 8px; text-align: center; color: #34d399; font-weight: 700; font-size: 0.88rem; margin-bottom: 16px;">
                    Match Live &bull; Playing Turn
                </div>

                <!-- In-Room Live Chat -->
                <div style="border: 1px solid var(--arc-border); border-radius: 12px; overflow: hidden; background: #000;">
                    <div style="padding: 8px 12px; background: rgba(255,255,255,0.03); border-bottom: 1px solid var(--arc-border); font-size: 0.8rem; font-weight: 700; color: var(--arc-text-muted); display: flex; align-items: center; justify-content: space-between;">
                        <span><i class="fas fa-comment-dots" style="color: var(--arc-accent); margin-right: 6px;"></i> Live In-Room Chat</span>
                        <span id="mpRoomCodeTag" style="font-family: monospace; color: var(--arc-accent);"></span>
                    </div>
                    <div id="roomChatMessages" style="height: 130px; overflow-y: auto; padding: 10px; display: flex; flex-direction: column;"></div>

                    <!-- Quick Emoji Bar -->
                    <div style="display: flex; gap: 6px; padding: 6px 10px; border-top: 1px solid var(--arc-border); background: rgba(255,255,255,0.02); overflow-x: auto;">
                        <button type="button" class="quick-emoji-btn" data-emoji="🔥" style="background: none; border: none; cursor: pointer; font-size: 1.15rem;">🔥</button>
                        <button type="button" class="quick-emoji-btn" data-emoji="👏" style="background: none; border: none; cursor: pointer; font-size: 1.15rem;">👏</button>
                        <button type="button" class="quick-emoji-btn" data-emoji="🏆" style="background: none; border: none; cursor: pointer; font-size: 1.15rem;">🏆</button>
                        <button type="button" class="quick-emoji-btn" data-emoji="😎" style="background: none; border: none; cursor: pointer; font-size: 1.15rem;">😎</button>
                        <button type="button" class="quick-emoji-btn" data-emoji="😂" style="background: none; border: none; cursor: pointer; font-size: 1.15rem;">😂</button>
                        <button type="button" class="quick-emoji-btn" data-emoji="⚡" style="background: none; border: none; cursor: pointer; font-size: 1.15rem;">⚡</button>
                        <button type="button" class="quick-msg-chip" data-text="Good Luck!" style="background: rgba(255,255,255,0.08); border: 1px solid var(--arc-border); color: #fff; padding: 2px 8px; border-radius: 6px; font-size: 0.74rem; cursor: pointer;">Good Luck!</button>
                        <button type="button" class="quick-msg-chip" data-text="Nice Move!" style="background: rgba(255,255,255,0.08); border: 1px solid var(--arc-border); color: #fff; padding: 2px 8px; border-radius: 6px; font-size: 0.74rem; cursor: pointer;">Nice Move!</button>
                        <button type="button" class="quick-msg-chip" data-text="Rematch?" style="background: rgba(255,255,255,0.08); border: 1px solid var(--arc-border); color: #fff; padding: 2px 8px; border-radius: 6px; font-size: 0.74rem; cursor: pointer;">Rematch?</button>
                        <button type="button" class="quick-msg-chip" data-text="GG!" style="background: rgba(255,255,255,0.08); border: 1px solid var(--arc-border); color: #fff; padding: 2px 8px; border-radius: 6px; font-size: 0.74rem; cursor: pointer;">GG!</button>
                    </div>

                    <!-- Custom Chat Input -->
                    <div style="display: flex; padding: 6px 10px; border-top: 1px solid var(--arc-border); gap: 6px;">
                        <input type="text" id="mpCustomChatInput" placeholder="Type a message..." maxlength="80" style="flex: 1; background: transparent; border: none; color: #fff; font-size: 0.85rem; outline: none;">
                        <button type="button" class="arc-btn arc-btn-accent" id="mpSendChatBtn" style="padding: 4px 12px; font-size: 0.8rem;">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="arc-modal-footer">
            <button type="button" class="arc-btn" onclick="document.getElementById('multiplayerRoomOverlay').classList.remove('open')">
                Minimize
            </button>
        </div>
    </div>
</div>

<script>
    (function() {
        const overlay = document.getElementById('multiplayerRoomOverlay');
        const setupPane = document.getElementById('mpSetupPane');
        const waitingLobby = document.getElementById('mpWaitingLobby');
        const activeMatchPane = document.getElementById('mpActiveMatchPane');
        const displayCode = document.getElementById('mpDisplayCode');
        const roomCodeBox = document.getElementById('mpRoomCodeBox');
        const waitingTitle = document.getElementById('mpWaitingTitle');
        const waitingSub = document.getElementById('mpWaitingSub');

        const currentGameId = window.__GAME_ID__ || '';

        // Quick Match
        document.getElementById('mpQuickMatchBtn')?.addEventListener('click', () => {
            waitingLobby.style.display = 'block';
            roomCodeBox.style.display = 'none';
            waitingTitle.textContent = 'Searching for Opponent...';
            waitingSub.textContent = 'Matching with another active player worldwide.';
            window.ArcadeMP?.quickMatch(currentGameId);
        });

        // Create Private Room
        document.getElementById('mpCreateRoomBtn')?.addEventListener('click', () => {
            window.ArcadeMP?.createPrivateRoom(currentGameId);
        });

        // Socket response for created room
        if (window.ArcadeMP?.socket) {
            window.ArcadeMP.socket.on('arcade_private_room_created', (data) => {
                waitingLobby.style.display = 'block';
                roomCodeBox.style.display = 'block';
                displayCode.textContent = data.roomCode;
                waitingTitle.textContent = 'Room Created!';
                waitingSub.textContent = 'Share this code with your friend or Club members.';
            });
        }

        // Join Room
        document.getElementById('mpJoinRoomBtn')?.addEventListener('click', () => {
            const code = document.getElementById('mpJoinCodeInput').value.trim();
            if (!code) {
                if (window.ArcadeToast) window.ArcadeToast.show('Please enter a room code.', 'warning');
                else alert('Please enter a room code.');
                return;
            }
            window.ArcadeMP?.joinPrivateRoom(code);
        });

        // Copy Code
        document.getElementById('mpCopyCodeBtn')?.addEventListener('click', () => {
            const code = displayCode.textContent;
            navigator.clipboard.writeText(code).then(() => {
                if (window.ArcadeToast) window.ArcadeToast.show(`Room code "${code}" copied to clipboard!`, 'success');
                else alert(`Room code "${code}" copied to clipboard!`);
            });
        });

        // Cancel
        document.getElementById('mpCancelMatchBtn')?.addEventListener('click', () => {
            waitingLobby.style.display = 'none';
        });

        // Match found callback
        if (window.ArcadeMP) {
            window.ArcadeMP.callbacks.onMatchFound = function(data) {
                setupPane.style.display = 'none';
                activeMatchPane.style.display = 'block';
                document.getElementById('mpRoomCodeTag').textContent = `Room #${data.roomCode}`;

                document.getElementById('mpP1Name').textContent = data.host.username;
                document.getElementById('mpP1Country').textContent = data.host.country || 'Global';
                document.getElementById('mpP1Avatar').src = data.host.avatar || '/images/default-avatar.png';

                document.getElementById('mpP2Name').textContent = data.guest.username;
                document.getElementById('mpP2Country').textContent = data.guest.country || 'Global';
                document.getElementById('mpP2Avatar').src = data.guest.avatar || '/images/default-avatar.png';

                // Forward event to embedded game iframe if present
                const iframe = document.getElementById('gameIframe');
                if (iframe && iframe.contentWindow) {
                    iframe.contentWindow.postMessage({
                        type: 'ARCADE_MATCH_READY',
                        roomCode: data.roomCode,
                        isHost: window.ArcadeMP.isHost,
                        host: data.host,
                        guest: data.guest
                    }, '*');
                }
            };

            window.ArcadeMP.callbacks.onOpponentLeft = function(data) {
                const msg = data?.message || 'Opponent disconnected.';
                if (window.ArcadeToast) window.ArcadeToast.show(msg, 'warning');
                else alert(msg);
                setupPane.style.display = 'block';
                waitingLobby.style.display = 'none';
                activeMatchPane.style.display = 'none';
            };
        }

        // Quick chat message
        document.querySelectorAll('.quick-msg-chip').forEach(chip => {
            chip.addEventListener('click', () => {
                window.ArcadeMP?.sendChatMessage(chip.dataset.text, '');
            });
        });

        // Quick emoji
        document.querySelectorAll('.quick-emoji-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                window.ArcadeMP?.sendChatMessage('', btn.dataset.emoji);
            });
        });

        // Custom chat
        const customInput = document.getElementById('mpCustomChatInput');
        const sendBtn = document.getElementById('mpSendChatBtn');
        function sendCustom() {
            const txt = (customInput.value || '').trim();
            if (!txt) return;
            window.ArcadeMP?.sendChatMessage(txt, '');
            customInput.value = '';
        }
        sendBtn?.addEventListener('click', sendCustom);
        customInput?.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') sendCustom();
        });
    })();
</script>
