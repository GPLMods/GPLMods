<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Pocket Classics | GPLMods Arcade</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="Pocket Classics - A premium retro and multiplayer arcade collection with 2048, Chess, Checkers, Air Hockey, Snake, and Tic-Tac-Toe on GPLMods.">
    <meta name="keywords" content="Pocket Classics, GPLMods Arcade, 2048, Chess, Checkers, Snake, TicTacToe, Online Multiplayer, Retro Games">
    <meta property="og:title" content="Pocket Classics | GPLMods Arcade">
    <meta property="og:description" content="Play classic retro and 2-player multiplayer board games online for free with real-time room chat and leaderboards.">
    <meta property="og:image" content="/games/pocketclassics/assets/logo.png">
    <meta property="og:type" content="website">

    <link rel="manifest" href="/games/pocketclassics/manifest.json">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Nunito:wght@700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/games/pocketclassics/css/arcade.css">

    <style>
        .splash-stage {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at center, #111422 0%, #06070b 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 99999;
            padding: 20px;
            transition: opacity 0.5s ease;
        }

        .video-box, .static-logo-box {
            width: 100%;
            max-width: 300px;
            aspect-ratio: 1 / 1;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 0 50px rgba(255, 215, 0, 0.35), 0 20px 60px rgba(0,0,0,0.9);
            border: 2.5px solid var(--arc-accent);
            background: #000;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        @media (max-width: 480px) {
            .video-box, .static-logo-box {
                max-width: 250px;
            }
        }

        .video-box video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .static-logo-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            border-radius: 21px;
        }

        .progress-box {
            width: 100%;
            max-width: 360px;
            margin-top: 25px;
            text-align: center;
        }

        .bar-outer {
            width: 100%;
            height: 10px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid var(--arc-border);
            margin-bottom: 12px;
        }

        .bar-inner {
            width: 0%;
            height: 100%;
            background: linear-gradient(90deg, #ff9800, var(--arc-accent), #34d399);
            border-radius: 8px;
            transition: width 0.06s linear;
            box-shadow: 0 0 12px var(--arc-accent-glow);
        }

        .status-txt {
            font-size: 0.88rem;
            color: var(--arc-text-muted);
            font-weight: 600;
            margin-bottom: 12px;
            min-height: 22px;
        }

        /* Developer Branding Reveal */
        .dev-branding-reveal {
            opacity: 0;
            transform: translateY(14px) scale(0.94);
            transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
            pointer-events: none;
            margin-bottom: 16px;
        }

        .dev-branding-reveal.visible {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        .dev-brand-title {
            font-size: 1.55rem;
            font-weight: 800;
            letter-spacing: 0.8px;
            display: inline-flex;
            gap: 5px;
            align-items: center;
            justify-content: center;
            line-height: 1.2;
        }

        .brand-gaming {
            color: #ff9800;
            text-shadow: 0 0 16px rgba(255, 152, 0, 0.5);
        }

        .brand-net {
            background: linear-gradient(135deg, #ffffff, #60a5fa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 16px rgba(96, 165, 250, 0.5);
        }

        .brand-india {
            color: #22c55e;
            text-shadow: 0 0 16px rgba(34, 197, 94, 0.5);
        }

        .dev-brand-tagline {
            font-size: 0.88rem;
            font-weight: 700;
            margin-top: 4px;
            background: linear-gradient(135deg, #f472b6, #ec4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            justify-content: center;
            text-shadow: 0 0 12px rgba(236, 72, 153, 0.35);
        }

        .dev-brand-tagline i {
            color: #ec4899;
            -webkit-text-fill-color: #ec4899;
            animation: heartBeat 1.2s infinite;
        }

        @keyframes heartBeat {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.3); }
        }
    </style>
</head>
<body class="arcade-body" data-theme="classic">

    <div class="splash-stage" id="splashScreen">
        <!-- 1:1 Video Animation (Shown only on first visit, unskippable) -->
        <div class="video-box" id="splashVideoBox" style="display: none;">
            <video id="splashVideo" playsinline webkit-playsinline autoplay preload="auto">
                <source src="/games/pocketclassics/assets/logo.mp4" type="video/mp4">
            </video>
        </div>

        <!-- Static Logo Screen with Developer Logo (Shown on 2nd and subsequent visits) -->
        <div class="static-logo-box" id="splashStaticBox" style="display: none; background: #000; overflow: hidden; border-radius: 24px; padding: 0;">
            <!-- Developer Logo ONLY inside container: Fits perfectly edge-to-edge without any text inside the box -->
            <img src="/games/pocketclassics/assets/developer-logo.png" alt="Developer Logo" class="protect-asset" style="width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 21px;">
        </div>

        <div class="progress-box">
            <div class="bar-outer">
                <div class="bar-inner" id="splashProgressBar"></div>
            </div>
            <div class="status-txt" id="splashStatusText">
                <i class="fas fa-gamepad" style="color: var(--arc-accent); margin-right: 6px;"></i> Loading Pocket Classics...
            </div>

            <!-- Developer Branding Reveal -->
            <div class="dev-branding-reveal" id="devBranding">
                <div class="dev-brand-title">
                    <span class="brand-gaming">Gaming</span>
                    <span class="brand-net">Net</span>
                    <span class="brand-india">India</span>
                </div>
                <div>
                    <span class="dev-brand-tagline">
                        #coded with <i class="fas fa-heart"></i>
                    </span>
                </div>
                <div style="font-size: 0.76rem; color: var(--arc-text-muted); margin-top: 5px; font-weight: 600; letter-spacing: 1px;">
                    Gaming Net India X GPL Mods
                </div>
            </div>

            <!-- Optional sound toggle during video -->
            <div id="videoControlsRow" style="display: none; justify-content: center; margin-top: 10px;">
                <button type="button" class="arc-btn" id="muteSplashBtn" title="Toggle Sound">
                    <i class="fas fa-volume-up" id="muteIcon"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Background Audio Engine -->
    <script src="/games/pocketclassics/js/audio-manager.js"></script>
    <script src="/games/pocketclassics/js/theme-manager.js"></script>
    <script src="/games/pocketclassics/js/protection.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const videoBox = document.getElementById('splashVideoBox');
            const staticBox = document.getElementById('splashStaticBox');
            const video = document.getElementById('splashVideo');
            const pBar = document.getElementById('splashProgressBar');
            const statusTxt = document.getElementById('splashStatusText');
            const muteBtn = document.getElementById('muteSplashBtn');
            const muteIcon = document.getElementById('muteIcon');
            const devBranding = document.getElementById('devBranding');
            const videoControlsRow = document.getElementById('videoControlsRow');

            const hasSeenIntro = localStorage.getItem('arc_intro_seen') === 'true';

            function showDeveloperBranding() {
                if (devBranding) {
                    devBranding.classList.add('visible');
                }
            }

            if (!hasSeenIntro) {
                // ============================================================
                // 1ST VISIT: UN-SKIPPABLE INTRO ANIMATION VIDEO
                // No main menu music plays until video intro ends!
                // ============================================================
                videoBox.style.display = 'block';
                videoControlsRow.style.display = 'flex';

                if (window.ArcadeAudio) {
                    window.ArcadeAudio.pauseMusic();
                }

                let introCompleted = false;
                function finishIntro() {
                    if (introCompleted) return;
                    introCompleted = true;
                    localStorage.setItem('arc_intro_seen', 'true');
                    if (pBar) pBar.style.width = '100%';
                    if (statusTxt) {
                        statusTxt.innerHTML = '<span style="color: #34d399;"><i class="fas fa-check-circle"></i> Welcome to Pocket Classics!</span>';
                    }
                    setTimeout(() => {
                        window.location.href = '/games/hub';
                    }, 400);
                }

                if (video) {
                    video.muted = false;
                    video.volume = 1.0;

                    video.addEventListener('timeupdate', () => {
                        if (video.duration && !isNaN(video.duration) && video.duration > 0) {
                            const progress = Math.min(100, Math.floor((video.currentTime / video.duration) * 100));
                            if (pBar) pBar.style.width = progress + '%';
                            if (video.currentTime >= (video.duration * 0.75)) {
                                showDeveloperBranding();
                            }
                        }
                    });

                    video.addEventListener('ended', finishIntro);
                    
                    video.addEventListener('error', () => {
                        console.warn('[Splash Video] Playback error, using fallback timer');
                        startFallbackTimer();
                    });

                    const playPromise = video.play();
                    if (playPromise !== undefined) {
                        playPromise.catch(() => {
                            video.muted = true;
                            video.play().catch(() => {
                                startFallbackTimer();
                            });
                            if (muteIcon) muteIcon.className = 'fas fa-volume-mute';

                            const unlockAudio = () => {
                                video.muted = false;
                                video.volume = 1.0;
                                if (muteIcon) muteIcon.className = 'fas fa-volume-up';
                                window.removeEventListener('pointerdown', unlockAudio);
                                window.removeEventListener('keydown', unlockAudio);
                            };
                            window.addEventListener('pointerdown', unlockAudio, { once: true });
                            window.addEventListener('keydown', unlockAudio, { once: true });
                        });
                    }

                    // Fallback timer: only kicks in if video fails or is blocked
                    function startFallbackTimer() {
                        const FALLBACK_TOTAL = 8000;
                        const startTime = Date.now();
                        const fallbackInterval = setInterval(() => {
                            if (introCompleted) {
                                clearInterval(fallbackInterval);
                                return;
                            }
                            const elapsed = Date.now() - startTime;
                            const progress = Math.min(100, Math.floor((elapsed / FALLBACK_TOTAL) * 100));
                            if (pBar) pBar.style.width = progress + '%';
                            if (elapsed >= 6000) showDeveloperBranding();
                            if (elapsed >= FALLBACK_TOTAL) {
                                clearInterval(fallbackInterval);
                                finishIntro();
                            }
                        }, 80);
                    }
                }

                muteBtn?.addEventListener('click', () => {
                    if (video) {
                        video.muted = !video.muted;
                        muteIcon.className = video.muted ? 'fas fa-volume-mute' : 'fas fa-volume-up';
                    }
                });

            } else {
                // ============================================================
                // 2ND+ VISIT: STATIC SCREEN WITH DEVELOPER LOGO ONLY (NO TEXT)
                // Fast 1.8s progress bar, automatically switch to next theme on revisit
                // ============================================================
                if (window.ArcadeTheme) {
                    window.ArcadeTheme.nextTheme();
                }
                staticBox.style.display = 'flex';

                if (statusTxt) {
                    statusTxt.innerHTML = '<i class="fas fa-gamepad" style="color: var(--arc-accent); margin-right: 6px;"></i> Launching Pocket Classics...';
                }

                // Play assigned theme music during 2nd loading screen
                if (window.ArcadeAudio) {
                    window.ArcadeAudio.playMusic();
                }

                const STATIC_DURATION_MS = 2500;
                const startTime = Date.now();
                const staticInterval = setInterval(() => {
                    const elapsed = Date.now() - startTime;
                    const progress = Math.min(100, Math.floor((elapsed / STATIC_DURATION_MS) * 100));
                    if (pBar) pBar.style.width = progress + '%';

                    // Reveal page developer branding during/after loading
                    if (elapsed >= 1100) {
                        showDeveloperBranding();
                    }

                    if (elapsed >= STATIC_DURATION_MS) {
                        clearInterval(staticInterval);
                        if (pBar) pBar.style.width = '100%';
                        showDeveloperBranding();
                        if (statusTxt) {
                            statusTxt.innerHTML = '<span style="color: #34d399;"><i class="fas fa-check-circle"></i> Ready to Play!</span>';
                        }
                        setTimeout(() => {
                            window.location.href = '/games/hub';
                        }, 500);
                    }
                }, 40);
            }
        });
    </script>
</body>
</html>
