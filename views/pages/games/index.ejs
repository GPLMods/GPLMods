<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Pocket Classics | GPLMods Arcade</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="Pocket Classics - A premium retro and multiplayer arcade collection with 2048, Chess, Checkers, Air Hockey, Snake, and Tic-Tac-Toe on GPLMods.">
    <meta name="keywords" content="Pocket Classics, GPLMods Arcade, 2048, Chess, Checkers, Snake, TicTacToe, Online Multiplayer, Retro Games">
    <meta property="og:title" content="Pocket Classics | GPLMods Arcade">
    <meta property="og:description" content="Play classic retro and 2-player multiplayer board games online for free with real-time room chat and leaderboards.">
    <meta property="og:image" content="/games/pocketclassics/assets/logo.png">
    <meta property="og:type" content="website">

    <link rel="manifest" href="/games/pocketclassics/manifest.json">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Nunito:wght@700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/games/pocketclassics/css/arcade.css">

    <style>
        .splash-stage {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at center, #111422 0%, #06070b 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 99999;
            padding: 20px;
            transition: opacity 0.5s ease;
        }

        .video-box {
            width: 100%;
            max-width: 320px;
            aspect-ratio: 1 / 1;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 0 50px rgba(255, 215, 0, 0.35), 0 20px 60px rgba(0,0,0,0.9);
            border: 2.5px solid var(--arc-accent);
            background: #000;
            position: relative;
        }

        @media (max-width: 480px) {
            .video-box {
                max-width: 270px;
            }
        }

        .video-box video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .progress-box {
            width: 100%;
            max-width: 360px;
            margin-top: 25px;
            text-align: center;
        }

        .bar-outer {
            width: 100%;
            height: 10px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid var(--arc-border);
            margin-bottom: 12px;
        }

        .bar-inner {
            width: 0%;
            height: 100%;
            background: linear-gradient(90deg, #ff9800, var(--arc-accent), #34d399);
            border-radius: 8px;
            transition: width 0.08s linear;
            box-shadow: 0 0 12px var(--arc-accent-glow);
        }

        .status-txt {
            font-size: 0.88rem;
            color: var(--arc-text-muted);
            font-weight: 600;
            margin-bottom: 12px;
            min-height: 22px;
        }

        /* Developer Branding Reveal */
        .dev-branding-reveal {
            opacity: 0;
            transform: translateY(14px) scale(0.94);
            transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
            pointer-events: none;
            margin-bottom: 16px;
        }

        .dev-branding-reveal.visible {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        .dev-brand-title {
            font-size: 1.55rem;
            font-weight: 800;
            letter-spacing: 0.8px;
            display: inline-flex;
            gap: 5px;
            align-items: center;
            justify-content: center;
            line-height: 1.2;
        }

        .brand-gaming {
            color: #ff9800;
            text-shadow: 0 0 16px rgba(255, 152, 0, 0.5);
        }

        .brand-net {
            background: linear-gradient(135deg, #ffffff, #60a5fa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 16px rgba(96, 165, 250, 0.5);
        }

        .brand-india {
            color: #22c55e;
            text-shadow: 0 0 16px rgba(34, 197, 94, 0.5);
        }

        .dev-brand-tagline {
            font-size: 0.88rem;
            font-weight: 700;
            margin-top: 4px;
            background: linear-gradient(135deg, #f472b6, #ec4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            justify-content: center;
            text-shadow: 0 0 12px rgba(236, 72, 153, 0.35);
        }

        .dev-brand-tagline i {
            color: #ec4899;
            -webkit-text-fill-color: #ec4899;
            animation: heartBeat 1.2s infinite;
        }

        @keyframes heartBeat {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.3); }
        }
    </style>
</head>
<body class="arcade-body" data-theme="classic">

    <div class="splash-stage" id="splashScreen">
        <!-- 1:1 Video Animation of Developer Intro Logo -->
        <div class="video-box">
            <video id="splashVideo" playsinline preload="metadata" poster="/games/pocketclassics/assets/logo.png">
                <source src="/games/pocketclassics/assets/logo.mp4" type="video/mp4">
            </video>
        </div>

        <div class="progress-box">
            <div class="bar-outer">
                <div class="bar-inner" id="splashProgressBar"></div>
            </div>
            <div class="status-txt" id="splashStatusText">
                <i class="fas fa-gamepad" style="color: var(--arc-accent); margin-right: 6px;"></i> Loading Pocket Classics...
            </div>

            <!-- Developer Branding Reveal at 8.0s mark -->
            <div class="dev-branding-reveal" id="devBranding">
                <div class="dev-brand-title">
                    <span class="brand-gaming">Gaming</span>
                    <span class="brand-net">Net</span>
                    <span class="brand-india">India</span>
                </div>
                <div>
                    <span class="dev-brand-tagline">
                        #coded with <i class="fas fa-heart"></i>
                    </span>
                </div>
            </div>

            <div style="display: flex; gap: 12px; justify-content: center;">
                <button type="button" class="arc-btn arc-btn-accent" id="enterArcadeBtn" style="padding: 10px 24px;">
                    <span>Enter Arcade</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
                <button type="button" class="arc-btn" id="muteSplashBtn" title="Toggle Sound">
                    <i class="fas fa-volume-up" id="muteIcon"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Background Audio Engine -->
    <script src="/games/pocketclassics/js/audio-manager.js"></script>
    <script src="/games/pocketclassics/js/theme-manager.js"></script>
    <script src="/games/pocketclassics/js/protection.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const video = document.getElementById('splashVideo');
            const pBar = document.getElementById('splashProgressBar');
            const statusTxt = document.getElementById('splashStatusText');
            const enterBtn = document.getElementById('enterArcadeBtn');
            const muteBtn = document.getElementById('muteSplashBtn');
            const muteIcon = document.getElementById('muteIcon');
            const devBranding = document.getElementById('devBranding');

            let brandingShown = false;
            function showDeveloperBranding() {
                if (brandingShown) return;
                brandingShown = true;
                if (devBranding) {
                    devBranding.classList.add('visible');
                }
            }

            // Attempt video playback with sound effects
            if (video) {
                video.muted = false;
                video.volume = 1.0;
                const playPromise = video.play();
                if (playPromise !== undefined) {
                    playPromise.catch(() => {
                        // Browser autoplay policy restricted unmuted playback until interaction
                        video.muted = true;
                        video.play().catch(() => {});
                        if (muteIcon) muteIcon.className = 'fas fa-volume-mute';

                        const unlockAudio = () => {
                            video.muted = false;
                            video.volume = 1.0;
                            if (muteIcon) muteIcon.className = 'fas fa-volume-up';
                            window.removeEventListener('pointerdown', unlockAudio);
                            window.removeEventListener('keydown', unlockAudio);
                        };
                        window.addEventListener('pointerdown', unlockAudio, { once: true });
                        window.addEventListener('keydown', unlockAudio, { once: true });
                    });
                }

                video.addEventListener('timeupdate', () => {
                    if (video.currentTime >= 8.0) {
                        showDeveloperBranding();
                    }
                });
            }

            // 10-Second Loading Screen Timer
            const TOTAL_DURATION_MS = 10000;
            const startTime = Date.now();
            const progressInterval = setInterval(() => {
                const elapsed = Date.now() - startTime;
                const progress = Math.min(100, Math.floor((elapsed / TOTAL_DURATION_MS) * 100));
                if (pBar) pBar.style.width = progress + '%';

                if (elapsed >= 8000) {
                    showDeveloperBranding();
                }

                if (elapsed >= TOTAL_DURATION_MS) {
                    clearInterval(progressInterval);
                    if (pBar) pBar.style.width = '100%';
                    if (statusTxt) {
                        statusTxt.innerHTML = '<span style="color: #34d399;"><i class="fas fa-check-circle"></i> Welcome to Pocket Classics!</span>';
                    }
                    setTimeout(() => {
                        window.location.href = '/games/hub';
                    }, 500);
                }
            }, 60);

            // Enter button
            enterBtn?.addEventListener('click', () => {
                clearInterval(progressInterval);
                window.location.href = '/games/hub';
            });

            // Mute / Unmute button
            muteBtn?.addEventListener('click', () => {
                if (video) {
                    video.muted = !video.muted;
                    muteIcon.className = video.muted ? 'fas fa-volume-mute' : 'fas fa-volume-up';
                }
            });
        });
    </script>
</body>
</html>
