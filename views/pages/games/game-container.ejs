<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title><%= title %></title>
    
    <!-- SEO Meta Tags (Requirement 5) -->
    <meta name="description" content="<%= game.description %>">
    <meta name="keywords" content="<%= game.name %>, Pocket Classics, GPLMods, Online Retro Game, <%= game.category === '2P' ? '2 Player Multiplayer' : 'Single Player Puzzle' %>">
    <meta property="og:title" content="<%= game.name %> - Pocket Classics | GPLMods">
    <meta property="og:description" content="<%= game.tagline %>">
    <meta property="og:image" content="<%= game.icon %>">
    <meta property="og:type" content="game">

    <link rel="manifest" href="/games/pocketclassics/manifest.json">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Nunito:wght@700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/games/pocketclassics/css/arcade.css">

    <script>
        window.__GAME_ID__ = '<%= game.id %>';
        window.__GAME_ROOM__ = '<%= typeof roomCode !== "undefined" ? roomCode : "" %>';
        window.__ARCADE_USER__ = {
            username: '<%= user ? user.username : "Guest" %>',
            country: '<%= user && user.country ? user.country : "India" %>',
            avatar: '<%= user && (user.cardAvatarUrl || user.avatarUrl || user.profileImage) ? (user.cardAvatarUrl || user.avatarUrl || user.profileImage) : "/images/default-avatar.png" %>'
        };
        (function() {
            var savedTheme = localStorage.getItem('arc_theme') || 'classic';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <style>
        .fs-floating-toggle-btn {
            display: none;
            position: absolute;
            top: 14px;
            right: 14px;
            z-index: 9999;
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: #fff;
            backdrop-filter: blur(8px);
            border-radius: 20px;
            padding: 6px 14px;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
            transition: all 0.2s ease;
        }
        .fs-floating-toggle-btn:hover {
            background: rgba(30, 41, 59, 0.95);
            transform: scale(1.05);
            border-color: var(--arc-accent, #ffd700);
        }
        .game-viewport-card.controls-hidden .game-viewport-header {
            display: none !important;
        }
        .game-viewport-card.controls-hidden #showControlsFloatingBtn {
            display: inline-flex !important;
            align-items: center;
            gap: 6px;
        }
        /* Native and Pseudo-Fullscreen for mobile & desktop */
        .game-viewport-card.arcade-fullscreen-active,
        .game-viewport-card:fullscreen,
        .game-viewport-card:-webkit-full-screen {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            width: 100vw !important;
            height: 100dvh !important;
            max-width: 100vw !important;
            max-height: 100dvh !important;
            margin: 0 !important;
            border-radius: 0 !important;
            border: none !important;
            display: flex;
            flex-direction: column;
            background: #000 !important;
            z-index: 999999 !important;
        }
        .game-viewport-card.arcade-fullscreen-active .game-iframe-wrapper,
        .game-viewport-card:fullscreen .game-iframe-wrapper,
        .game-viewport-card:-webkit-full-screen .game-iframe-wrapper {
            flex: 1 1 100%;
            height: calc(100dvh - 50px) !important;
            border-radius: 0 !important;
            min-height: 0 !important;
        }
        .game-viewport-card.arcade-fullscreen-active.controls-hidden .game-iframe-wrapper,
        .game-viewport-card:fullscreen.controls-hidden .game-iframe-wrapper,
        .game-viewport-card:-webkit-full-screen.controls-hidden .game-iframe-wrapper {
            height: 100dvh !important;
        }
        @media (max-width: 600px) {
            .btn-text-full {
                display: none !important;
            }
            .arcade-wrapper {
                padding-top: 4px !important;
                padding-left: 4px !important;
                padding-right: 4px !important;
            }
            .game-viewport-card {
                border-radius: 12px;
                margin-bottom: 12px;
            }
            .game-viewport-header {
                padding: 6px 8px;
                gap: 6px;
                flex-wrap: nowrap;
            }
            .game-viewport-header-left {
                gap: 6px;
            }
            .game-viewport-header-left a.arc-btn {
                padding: 5px 8px !important;
            }
            .game-viewport-header-actions {
                gap: 4px;
            }
            .game-viewport-header-actions .arc-btn {
                padding: 6px;
                min-width: 32px;
                height: 32px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }
            .game-iframe-wrapper {
                min-height: 0 !important;
                height: calc(100dvh - 65px) !important;
            }
        }
    </style>
</head>
<body class="arcade-body">

    <div class="arcade-wrapper" style="padding-top: 14px;">
        <!-- Top Game Header Bar -->
        <div class="game-viewport-card">
            <div class="game-viewport-header">
                <div class="game-viewport-header-left">
                    <a href="/games/hub<%= typeof clubId !== 'undefined' && clubId ? ('?clubId=' + clubId) : '' %>" class="arc-btn" title="Back to Arcade Hub" style="padding: 6px 12px;">
                        <i class="fas fa-arrow-left"></i>
                        <span>Hub</span>
                    </a>

                    <div style="display: flex; align-items: center; gap: 8px; min-width: 0;">
                        <img src="<%= game.icon %>" alt="<%= game.name %>" style="width: 30px; height: 30px; border-radius: 8px; object-fit: cover; flex-shrink: 0;" class="protect-asset">
                        <div style="min-width: 0;">
                            <strong style="font-size: 0.96rem; display: block; color: var(--arc-text-main); line-height: 1.1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= game.name %></strong>
                            <span style="font-size: 0.72rem; color: var(--arc-accent); font-weight: 600;"><%= game.typeLabel %></span>
                        </div>
                    </div>

                    <!-- PC Mode Indicator (Hidden on Touch/Mobile) -->
                    <div id="pcControlsBadge" class="pc-controls-badge" style="display: none; align-items: center; gap: 5px; font-size: 0.74rem; color: #38bdf8; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 6px; padding: 4px 8px;" title="PC Mode Optimized: WASD & Arrow Keys Enabled">
                        <i class="fas fa-keyboard"></i>
                        <span class="btn-text-full">PC Keyboard</span>
                    </div>
                </div>

                <div class="game-viewport-header-actions">
                    <!-- Hide Container Controls in Fullscreen Mode -->
                    <button type="button" class="arc-btn arc-btn-icon" id="hideControlsBtn" title="Hide Top Controls (Fullscreen)">
                        <i class="fas fa-eye-slash"></i>
                    </button>

                    <!-- Rules Modal Button -->
                    <button type="button" class="arc-btn" id="openRulesBtn" title="How to Play / Game Rules">
                        <i class="fas fa-book-open" style="color: var(--arc-accent);"></i>
                        <span class="btn-text-full">Rules</span>
                    </button>

                    <!-- Multiplayer Button -->
                    <% if (game.category === '2P') { %>
                        <button type="button" class="arc-btn arc-btn-accent" id="openMultiplayerBtn" title="Multiplayer Rooms & Chat">
                            <i class="fas fa-users"></i>
                            <span class="btn-text-full">Multiplayer</span>
                        </button>
                    <% } %>

                    <!-- Leaderboards Button -->
                    <button type="button" class="arc-btn arc-btn-icon" id="openLeaderboardBtn" title="Leaderboards">
                        <i class="fas fa-trophy" style="color: var(--arc-accent);"></i>
                    </button>

                    <!-- Quick Theme Toggle -->
                    <button type="button" class="arc-btn arc-btn-icon" id="quickThemeBtn" title="Switch Theme (Classic / Cyber / India)">
                        <i class="fas fa-palette" style="color: var(--arc-accent);"></i>
                    </button>

                    <!-- In-Game Music Toggle -->
                    <button type="button" class="arc-btn arc-btn-icon" id="gameMusicToggleBtn" title="Toggle Music">
                        <i class="fas fa-music"></i>
                    </button>

                    <!-- Settings Button -->
                    <button type="button" class="arc-btn arc-btn-icon" id="openSettingsBtn" title="Settings">
                        <i class="fas fa-sliders-h"></i>
                    </button>

                    <!-- Fullscreen Toggle -->
                    <button type="button" class="arc-btn arc-btn-icon" id="fullscreenToggleBtn" title="Fullscreen">
                        <i class="fas fa-expand"></i>
                    </button>
                </div>
            </div>

            <!-- Floating reveal button when controls are hidden -->
            <button type="button" id="showControlsFloatingBtn" class="fs-floating-toggle-btn" title="Show Controls Bar">
                <i class="fas fa-eye"></i>
                <span>Show Controls</span>
            </button>

            <!-- Sandboxed Game Iframe -->
            <iframe id="gameIframe" 
                    src="/games/pocketclassics/games/<%= game.id %>/index.html" 
                    class="game-iframe-wrapper" 
                    allow="autoplay; fullscreen"
                    sandbox="allow-scripts allow-same-origin allow-popups">
            </iframe>
        </div>

        <!-- Arcade Footer Partial -->
        <%- include('./partials/footer') %>
    </div>

    <!-- Rules Modal Partial (Requirement 7) -->
    <%- include('./partials/rules-modal', { game }) %>

    <!-- Multiplayer Room Modal Partial (Requirement 9) -->
    <% if (game.category === '2P') { %>
        <%- include('./partials/multiplayer-room-modal') %>
    <% } %>

    <!-- Settings Modal Partial -->
    <%- include('./partials/settings-modal') %>

    <!-- Policy Modal Partial -->
    <%- include('./partials/policy-modal') %>

    <!-- Leaderboard Modal Partial -->
    <%- include('./partials/leaderboard-modal') %>

    <!-- Scripts -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="/games/pocketclassics/js/audio-manager.js"></script>
    <script src="/games/pocketclassics/js/theme-manager.js"></script>
    <script src="/games/pocketclassics/js/protection.js"></script>
    <script src="/games/pocketclassics/js/multiplayer-client.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            let sessionStartTime = Date.now();

            function ensureHubAudioMuted() {
                if (window.ArcadeAudio) {
                    window.ArcadeAudio.pauseMusic();
                }
            }
            ensureHubAudioMuted();

            // 1. Rules Modal
            const rulesModal = document.getElementById('rulesModalOverlay');
            document.getElementById('openRulesBtn')?.addEventListener('click', () => {
                ensureHubAudioMuted();
                rulesModal.classList.add('open');
            });

            // 2. Multiplayer Modal
            const mpModal = document.getElementById('multiplayerRoomOverlay');
            document.getElementById('openMultiplayerBtn')?.addEventListener('click', () => {
                ensureHubAudioMuted();
                mpModal.classList.add('open');
            });

            // Auto-join room if roomCode param is present in URL
            if (window.__GAME_ROOM__ && window.ArcadeMP) {
                setTimeout(() => {
                    mpModal.classList.add('open');
                    const joinInput = document.getElementById('mpJoinCodeInput');
                    if (joinInput) joinInput.value = window.__GAME_ROOM__;
                    window.ArcadeMP.joinPrivateRoom(window.__GAME_ROOM__);
                }, 800);
            }

            // 3. Settings Modal
            const settingsModal = document.getElementById('settingsModalOverlay');
            document.getElementById('openSettingsBtn')?.addEventListener('click', () => {
                ensureHubAudioMuted();
                settingsModal.classList.add('open');
            });

            // Leaderboard button also ensures Hub music is muted
            document.getElementById('openLeaderboardBtn')?.addEventListener('click', () => {
                ensureHubAudioMuted();
            });

            // 4. In-Game Music Management
            const musicBtn = document.getElementById('gameMusicToggleBtn');
            const iframe = document.getElementById('gameIframe');
            let isGameMusicOn = localStorage.getItem('arc_music_enabled') !== 'false';

            ensureHubAudioMuted();

            function syncIframeMusic(enable) {
                ensureHubAudioMuted();
                try {
                    const idoc = iframe?.contentDocument || iframe?.contentWindow?.document;
                    if (idoc) {
                        idoc.querySelectorAll('audio').forEach(a => {
                            if (a.hasAttribute('loop') || a.id.includes('music') || a.id.includes('bg')) {
                                a.muted = !enable;
                                if (!enable) {
                                    a.pause();
                                }
                            }
                        });
                    }
                    iframe?.contentWindow?.postMessage({ type: 'ARCADE_TOGGLE_MUSIC', enabled: enable }, '*');
                } catch (e) {}

                const icon = musicBtn?.querySelector('i');
                if (icon) icon.className = enable ? 'fas fa-music' : 'fas fa-volume-mute';
            }

            musicBtn?.addEventListener('click', () => {
                isGameMusicOn = !isGameMusicOn;
                localStorage.setItem('arc_music_enabled', isGameMusicOn ? 'true' : 'false');
                ensureHubAudioMuted();
                syncIframeMusic(isGameMusicOn);
            });

            // 5. Fullscreen Toggle on Every Game
            const fsBtn = document.getElementById('fullscreenToggleBtn');
            const fsIcon = fsBtn?.querySelector('i');
            const gameCard = document.querySelector('.game-viewport-card');
            const hideControlsBtn = document.getElementById('hideControlsBtn');
            const showControlsFloatingBtn = document.getElementById('showControlsFloatingBtn');

            function toggleControls(hide) {
                if (typeof hide === 'boolean') {
                    gameCard?.classList.toggle('controls-hidden', hide);
                } else {
                    gameCard?.classList.toggle('controls-hidden');
                }
            }

            hideControlsBtn?.addEventListener('click', () => toggleControls(true));
            showControlsFloatingBtn?.addEventListener('click', () => toggleControls(false));

            let isPseudoFs = false;

            function updateFsIcon() {
                const isFs = Boolean(document.fullscreenElement || document.webkitFullscreenElement || isPseudoFs);
                if (fsIcon) {
                    fsIcon.className = isFs ? 'fas fa-compress' : 'fas fa-expand';
                }
                if (!isFs) {
                    gameCard?.classList.remove('controls-hidden');
                }
            }
            document.addEventListener('fullscreenchange', updateFsIcon);
            document.addEventListener('webkitfullscreenchange', updateFsIcon);

            function enablePseudoFs() {
                isPseudoFs = true;
                gameCard?.classList.add('arcade-fullscreen-active');
                document.body.style.overflow = 'hidden';
                updateFsIcon();
            }

            function disablePseudoFs() {
                isPseudoFs = false;
                gameCard?.classList.remove('arcade-fullscreen-active');
                document.body.style.overflow = '';
                updateFsIcon();
            }

            function toggleGameFullscreen() {
                const isNativeFs = Boolean(document.fullscreenElement || document.webkitFullscreenElement);
                if (!isNativeFs && !isPseudoFs) {
                    const target = gameCard || document.documentElement;
                    const req = target.requestFullscreen || target.webkitRequestFullscreen;
                    if (req) {
                        try {
                            const res = req.call(target);
                            if (res && res.catch) {
                                res.catch(() => enablePseudoFs());
                            }
                        } catch (e) {
                            enablePseudoFs();
                        }
                    } else {
                        enablePseudoFs();
                    }
                } else {
                    if (isNativeFs) {
                        if (document.exitFullscreen) document.exitFullscreen().catch(() => {});
                        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
                    }
                    if (isPseudoFs) {
                        disablePseudoFs();
                    }
                }
            }

            fsBtn?.addEventListener('click', toggleGameFullscreen);

            window.addEventListener('message', (e) => {
                if (e.data && e.data.type === 'ARCADE_REQUEST_FULLSCREEN') {
                    toggleGameFullscreen();
                }
            });

            // Forward user interaction to game iframe to unlock audio autoplay seamlessly
            ['pointerdown', 'click', 'keydown', 'touchstart'].forEach(evt => {
                window.addEventListener(evt, () => {
                    try {
                        iframe?.contentWindow?.postMessage({ type: 'ARCADE_PARENT_INTERACTION' }, '*');
                    } catch (_) {}
                }, { passive: true });
            });

            if (iframe) {
                iframe.addEventListener('load', () => {
                    ensureHubAudioMuted();
                    setTimeout(() => {
                        syncIframeMusic(isGameMusicOn);
                    }, 400);
                });
            }

            // 6. Record Playtime on Unload / Leave
            window.addEventListener('beforeunload', () => {
                const playtimeSec = Math.floor((Date.now() - sessionStartTime) / 1000);
                if (playtimeSec > 5) {
                    const data = JSON.stringify({
                        gameId: window.__GAME_ID__,
                        playtime: playtimeSec,
                        score: 0
                    });
                    if (navigator.sendBeacon) {
                        navigator.sendBeacon('/games/api/record-session', new Blob([data], { type: 'application/json' }));
                    }
                }
            });

            // 7. Communication bridge between parent shell and embedded game iframe
            window.addEventListener('message', (event) => {
                const data = event.data;
                if (!data || typeof data !== 'object') return;

                if (data.type === 'ARCADE_GAME_MOVE' && window.ArcadeMP) {
                    window.ArcadeMP.sendAction('MOVE', data.payload);
                } else if (data.type === 'ARCADE_GAME_OVER' && window.ArcadeMP) {
                    const playtimeSec = Math.floor((Date.now() - sessionStartTime) / 1000);
                    window.ArcadeMP.recordGameOver(data.winner, data.score, playtimeSec);
                }
            });

            // Relay incoming opponent action to iframe
            if (window.ArcadeMP) {
                window.ArcadeMP.callbacks.onOpponentAction = (actionData) => {
                    if (iframe && iframe.contentWindow) {
                        iframe.contentWindow.postMessage({
                            type: 'ARCADE_OPPONENT_MOVE',
                            payload: actionData.payload
                        }, '*');
                    }
                };
            }

            // 8. PC Optimization & Mobile Controls Hiding (Requirement: Optimise each game for PC & hide mobile controls on PC)
            const isPc = !('ontouchstart' in window || navigator.maxTouchPoints > 0) || window.matchMedia('(hover: hover) and (pointer: fine)').matches;
            if (isPc) {
                document.body.classList.add('is-pc');
                const pcBadge = document.getElementById('pcControlsBadge');
                if (pcBadge) pcBadge.style.display = 'inline-flex';

                // Prevent arrow keys and spacebar from scrolling browser window during gameplay
                window.addEventListener('keydown', (e) => {
                    if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', ' '].includes(e.key)) {
                        const targetTag = e.target?.tagName;
                        if (targetTag && ['INPUT', 'TEXTAREA', 'SELECT'].includes(targetTag)) return;
                        e.preventDefault();
                    }
                }, { passive: false });

                // Inject CSS into game iframe to hide on-screen mobile/touch controls on PC
                function hideMobileControlsInIframe() {
                    try {
                        const idoc = iframe?.contentDocument || iframe?.contentWindow?.document;
                        if (idoc && !idoc.getElementById('pc-optimization-css')) {
                            const styleEl = idoc.createElement('style');
                            styleEl.id = 'pc-optimization-css';
                            styleEl.textContent = `
                                /* PC Optimization: Hide on-screen mobile / touch buttons and d-pads on desktop */
                                .mobile-controls, .touch-controls, .virtual-dpad, #touch-controls,
                                .touch-only, .mobile-only, .mobile-touch-bar, .dpad-container,
                                .virtual-controls, [data-mobile-control="true"], .on-screen-controls {
                                    display: none !important;
                                    visibility: hidden !important;
                                    pointer-events: none !important;
                                }
                                canvas, #gameCanvas, .game-board {
                                    image-rendering: -webkit-optimize-contrast;
                                    image-rendering: crisp-edges;
                                }
                            `;
                            idoc.head.appendChild(styleEl);
                        }
                    } catch (_) {}
                }

                if (iframe) {
                    iframe.addEventListener('load', hideMobileControlsInIframe);
                    setTimeout(hideMobileControlsInIframe, 600);
                }
            }
        });
    </script>
</body>
</html>
