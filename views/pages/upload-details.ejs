            const mode = this.value;
            if (!cachedMasterFile) return;

            const devInput = document.getElementById('developerName');
            const minOsInput = document.getElementById('minOsVersion');

            if (mode === 'all-default' || mode === 'custom-features') {
                if (devInput && !devInput.value.trim() && cachedMasterFile.developer && cachedMasterFile.developer !== 'N/A') {
                    devInput.value = cachedMasterFile.developer;
                }
                if (minOsInput && !minOsInput.value.trim() && cachedMasterFile.minOsVersion) {
