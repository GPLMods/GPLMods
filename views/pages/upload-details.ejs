    // Platform Flags UI Logic Helper
    function updatePlatformFlagsUI(platform) {
        const selectedPlatform = (platform || '').toLowerCase().trim();
        const platformFlagsContainer = document.getElementById('platform-flags-container');
        const flagsAndroid = document.getElementById('flags-android');
        const flagsIosJailbroken = document.getElementById('flags-ios-jailbroken');
        const flagsWindows = document.getElementById('flags-windows');
        const reqDevAndroid = document.getElementById('requiresDevModeAndroid');
        const reqDevWindows = document.getElementById('requiresDevModeWindows');

        if (!platformFlagsContainer) return;

        if (selectedPlatform === 'android') {
            platformFlagsContainer.style.display = 'block';
            if (flagsAndroid) flagsAndroid.style.display = 'block';
            if (flagsIosJailbroken) flagsIosJailbroken.style.display = 'none';
            if (flagsWindows) flagsWindows.style.display = 'none';
            if (reqDevAndroid) reqDevAndroid.disabled = false;
            if (reqDevWindows) reqDevWindows.disabled = true;
        } else if (selectedPlatform === 'ios-jailbroken') {
            platformFlagsContainer.style.display = 'block';
            if (flagsAndroid) flagsAndroid.style.display = 'none';
            if (flagsIosJailbroken) flagsIosJailbroken.style.display = 'block';
            if (flagsWindows) flagsWindows.style.display = 'none';
            if (reqDevAndroid) reqDevAndroid.disabled = true;
            if (reqDevWindows) reqDevWindows.disabled = true;
        } else if (selectedPlatform === 'windows') {
            platformFlagsContainer.style.display = 'block';
            if (flagsAndroid) flagsAndroid.style.display = 'none';
            if (flagsIosJailbroken) flagsIosJailbroken.style.display = 'none';
            if (flagsWindows) flagsWindows.style.display = 'block';
            if (reqDevAndroid) reqDevAndroid.disabled = true;
            if (reqDevWindows) reqDevWindows.disabled = false;
        } else {
            platformFlagsContainer.style.display = 'none';
            if (flagsAndroid) flagsAndroid.style.display = 'none';
            if (flagsIosJailbroken) flagsIosJailbroken.style.display = 'none';
            if (flagsWindows) flagsWindows.style.display = 'none';
            if (reqDevAndroid) reqDevAndroid.disabled = true;
            if (reqDevWindows) reqDevWindows.disabled = true;
        }
    }

    // Variant Master Inheritance Preset Listener
