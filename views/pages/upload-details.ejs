<%-include('../partials/header') %>

<!-- ✅ DOWNGRADED TO QUILL V1.3.7 FOR STABILITY -->
<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.7/quill.js"></script>

<style>
    /* Your custom theme styles are now integrated */
    :root {
        --black: #0a0a0a;
        --dark-gray: #1a1a1a;
        --white: #ffffff;
        --gold: #FFD700;
        --silver: #c0c0c0;
        --glow-gold: rgba(255, 215, 0, 0.5);
        --red: #e53935;
    }
    /* General body and container styles */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Poppins', sans-serif; background-color: var(--black); color: var(--white); line-height: 1.6; }
    .container { width: 90%; max-width: 1200px; margin: auto; padding: 20px 0; }

    /* Main form container */
    .upload-form-container {
        background-color: var(--dark-gray);
        padding: 30px;
        border-radius: 15px;
        width: 100%;
        max-width: 800px;
        margin: 2rem auto;
        border: 1px solid #333;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        box-sizing: border-box;
    }

    /* Form Header Text */
    .upload-form-container h2 {
        text-align: center;
        font-size: 2.5em;
        margin-bottom: 1rem;
    }
    .upload-form-container h2 span {
        color: var(--gold);
        text-shadow: 0 0 4px var(--glow-gold);
    }
    .upload-form-container > p {
        text-align: center;
        font-size: 1.1em;
        color: var(--silver);
        margin-bottom: 2rem;
    }
    
    /* Fieldset and Legend for Structure */
    .form-section {
        border: 1px solid #333;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 30px;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        min-inline-size: 0;
        box-sizing: border-box;
        margin-left: 0;
        margin-right: 0;
    }
    .form-section legend {
        padding: 0 10px;
        margin-left: 15px;
        font-size: 1.3em;
        font-weight: 600;
        color: var(--gold);
    }

    /* Form Groups and Inputs */
    .form-group {
        margin-bottom: 25px;
        position: relative; /* Essential for custom dropdowns */
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: var(--silver);
    }
    .form-group input[type="text"],
    .form-group input[type="url"],
    .form-group select,
    .form-group textarea {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
        padding: 12px 15px;
        border-radius: 8px;
        border: 1px solid #333;
        background-color: var(--black);
        color: var(--white);
        font-size: 1em;
        font-family: 'Poppins', sans-serif;
        transition: all 0.3s ease;
    }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
        outline: none;
        border-color: var(--gold);
        box-shadow: 0 0 10px var(--glow-gold);
    }
    .form-group textarea {
        min-height: 120px;
        resize: vertical;
    }

    /* --- CUSTOM SELECT DROPDOWN CSS --- */
    .custom-select-wrapper {
        position: relative;
        user-select: none;
        width: 100%;
    }
    .custom-select {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px;
        background-color: var(--black);
        border: 1px solid #333;
        border-radius: 8px;
        cursor: pointer;
        color: var(--silver);
        font-size: 1em;
        transition: all 0.3s ease;
    }
    /* When the dropdown is open */
    .custom-select-wrapper.open .custom-select {
        border-color: var(--gold);
        box-shadow: 0 0 10px var(--glow-gold);
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
    }
    .custom-select-arrow {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        line-height: 1;
        transform-origin: 50% 50%;
        color: var(--silver);
        transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), color 0.3s ease;
        font-size: 0.85em;
        flex-shrink: 0;
    }
    .custom-select-wrapper.open .custom-select-arrow {
        transform: rotate(180deg);
        color: var(--gold);
    }
    /* The dropdown menu */
    .custom-options {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: var(--dark-gray);
        border: 1px solid var(--gold);
        border-top: none;
        border-radius: 0 0 8px 8px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.5);
        z-index: 100;
        display: none; /* Hidden by default */
        max-height: 250px;
        overflow-y: auto;
    }
    .custom-select-wrapper.open .custom-options {
        display: block; /* Shown when open */
    }
    .custom-option {
        padding: 12px 15px;
        cursor: pointer;
        color: var(--white);
        transition: background-color 0.2s;
        border-bottom: 1px solid #2a2a2a;
    }
    .custom-option:last-child { border-bottom: none; }
    .custom-option:hover { background-color: var(--black); color: var(--gold); }
    .custom-option.selected { background-color: var(--black); color: var(--gold); font-weight: bold; }
    /* Disabled state for custom select */
    .custom-select-wrapper.disabled .custom-select {
        opacity: 0.5;
        cursor: not-allowed;
        background-color: #111;
    }
    .custom-select-wrapper.disabled .custom-options {
        display: none !important;
    }
    /* ------------------------------------------- */

    /* Icon Preview Section */
    .icon-upload-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        margin-bottom: 30px;
        padding: 20px;
        border: 2px dashed #333;
        border-radius: 15px;
        background-color: rgba(0,0,0,0.2);
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    .icon-upload-container label:first-child {
        display: block;
        width: 100%;
        text-align: center;
        margin-bottom: 12px;
        font-weight: 600;
        color: var(--silver);
    }
    .icon-preview {
        width: 100px;
        height: 100px;
        background-color: var(--black);
        border-radius: 20px;
        margin: 0 auto 15px auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--gold);
        overflow: hidden;
    }
    .auto-fetch-box { width: 100%; max-width: 100%; box-sizing: border-box; }
    #arch-group { width: 100%; max-width: 100%; box-sizing: border-box; }
    #platform-flags-container { width: 100%; max-width: 100%; box-sizing: border-box; }
    .platform-flags-box { width: 100%; max-width: 100%; box-sizing: border-box; }
    .platform-flags-box label { display: flex !important; align-items: flex-start !important; gap: 10px !important; width: 100% !important; box-sizing: border-box !important; }
    .platform-flags-box label span { flex: 1; word-break: break-word; overflow-wrap: break-word; }
    .icon-preview img {
        width: 100%;
        height: 100%;
        object-fit: contain; 
        display: none;
    }
    .icon-preview span {
        color: #444;
        font-size: 0.8em;
        text-align: center;
    }

    /* Custom File Input Styles */
    .file-input-wrapper {
        position: relative;
        display: block;
        width: 100%;
    }
    input[type="file"] {
        display: none;
    }
    .file-input-label {
        display: block;
        padding: 12px 20px;
        background: transparent;
        color: var(--gold);
        border: 2px solid var(--gold);
        border-radius: 8px;
        cursor: pointer;
        text-align: center;
        font-size: 1em;
        transition: all 0.3s ease;
    }
    .file-input-label:hover {
        background: var(--gold);
        color: var(--black);
        box-shadow: 0 0 15px var(--glow-gold);
    }
    .file-name {
        display: block;
        margin-top: 10px;
        color: var(--silver);
        font-size: 0.9em;
        text-align: center;
    }

    /* Screenshot & Video Previews */
    .preview-container {
        margin-top: 15px;
        background-color: var(--black);
        padding: 15px;
        border: 1px solid #333;
        border-radius: 8px;
        display: none; 
    }
    .draft-preview-button {
        background-color: rgba(255, 215, 0, 0.08);
        border-color: var(--gold);
        color: var(--gold);
    }
    .draft-preview-button:hover { background-color: var(--gold); color: var(--black); }
    #screenshotPreviewContainer {
        column-count: 2;
        column-gap: 15px;
    }
    #screenshotPreviewContainer img {
        width: 100%;
        height: auto;
        border-radius: 8px;
        margin-bottom: 15px;
        break-inside: avoid; 
        display: block;
        box-shadow: 0 4px 6px rgba(0,0,0,0.3);
    }
    .video-preview-wrapper {
        position: relative;
        padding-bottom: 56.25%; /* 16:9 */
        height: 0;
        overflow: hidden;
        border-radius: 4px;
        width: 100%;
    }
    .video-preview-wrapper iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .button-group {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }
    
    .draft-button {
        background: transparent;
        color: var(--silver);
        border: 2px solid #555;
        padding: 15px 20px;
        border-radius: 8px;
        font-size: 1.1em;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        flex: 1; 
    }
    .draft-button:hover {
        border-color: var(--gold);
        color: var(--gold);
    }
    /* Submit Button */
    .submit-button {
        display: block;
        width: 100%;
        background: var(--gold);
        color: var(--black);
        padding: 15px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 1.2em;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 0 15px var(--glow-gold);
        margin-top: 0;
        flex: 2;
    }
    .submit-button:hover {
        opacity: 0.9;
        transform: translateY(-2px);
    }

    /* Force Quill Editors to be responsive and left-aligned */
    .ql-toolbar, .ql-container {
        max-width: 100% !important;
        box-sizing: border-box !important;
    }
    .ql-editor {
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
        word-break: break-word !important;
        max-width: 100% !important;
        padding: 12px 15px !important; 
        text-align: left !important;
    }
    .ql-editor p, .form-group textarea, .form-group input {
        text-align: left !important;
    }
    .ql-editor p {
        margin-bottom: 0.5em !important;
        color: var(--white) !important;
    }
    .upload-form-container {
        width: 100%;
        max-width: 800px;
        margin: 2rem auto;
        overflow-x: hidden;
        box-sizing: border-box;
    }

    /* Auto-Fetch Responsive Layout */
    .fetch-input-group {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    .fetch-platform-col {
        flex: 0 0 170px;
        min-width: 140px;
        max-width: 100%;
        box-sizing: border-box;
        z-index: 10;
    }
    .fetch-url-input {
        flex: 1 1 200px;
        min-width: 0 !important;
        max-width: 100%;
        box-sizing: border-box;
        padding: 10px 14px;
        height: 45px;
        border-radius: 8px;
        background: var(--black);
        color: white;
        border: 1px solid #333;
        outline: none;
        font-size: 0.95em;
        text-align: left !important;
        font-family: 'Poppins', sans-serif;
    }
    .fetch-btn {
        background: var(--blue);
        color: white;
        border: none;
        border-radius: 8px;
        height: 45px;
        padding: 0 20px;
        font-weight: bold;
        cursor: pointer;
        white-space: nowrap;
        font-size: 0.95em;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: transform 0.2s, opacity 0.2s;
        box-sizing: border-box;
    }
    .fetch-btn:hover {
        opacity: 0.9;
        transform: translateY(-1px);
    }
    @media (max-width: 768px) {
        .container {
            width: 100% !important;
            max-width: 100% !important;
            padding-left: 12px !important;
            padding-right: 12px !important;
            box-sizing: border-box !important;
        }
        .upload-form-container {
            width: 100% !important;
            max-width: 100% !important;
            padding: 18px 14px !important;
            margin: 1rem auto !important;
            border-radius: 12px !important;
            box-sizing: border-box !important;
        }
        .upload-form-container h2 {
            font-size: 1.8em !important;
        }
        .form-section {
            padding: 16px 12px !important;
            margin-bottom: 20px !important;
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            min-inline-size: 0 !important;
            box-sizing: border-box !important;
        }
        .form-section legend {
            margin-left: 8px !important;
            font-size: 1.15em !important;
            padding: 0 6px !important;
        }
        .icon-upload-container {
            padding: 16px 12px !important;
            margin-bottom: 20px !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }
        .auto-fetch-box {
            padding: 16px 12px !important;
            margin-bottom: 20px !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }
        #arch-group {
            padding: 16px 12px !important;
            margin-top: 15px !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }
        .platform-flags-box {
            padding: 16px 12px !important;
            margin-bottom: 12px !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }
        .fetch-input-group {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 12px !important;
            width: 100% !important;
        }
        .fetch-platform-col,
        .fetch-platform-col .custom-select-wrapper,
        .fetch-url-input,
        .fetch-btn {
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            flex: 1 1 100% !important;
            box-sizing: border-box !important;
        }
        .fetch-url-input {
            font-size: 0.9em !important;
            padding: 10px 12px !important;
        }
        .custom-select {
            padding: 12px 14px !important;
        }
        .form-group {
            margin-bottom: 18px !important;
        }
        .button-group {
            flex-direction: column !important;
            gap: 10px !important;
        }
        .submit-button, .draft-button {
            width: 100% !important;
            padding: 13px 18px !important;
            font-size: 1.1em !important;
        }
    }

    /* ✅ UPDATED: Custom styles for Quill v1.3.7 */
    .ql-toolbar.ql-snow {
        background-color: #333;
        border-color: #444;
        border-radius: 8px 8px 0 0;
    }
    .ql-container.ql-snow {
        background-color: var(--black);
        border-color: #444;
        border-radius: 0 0 8px 8px;
        color: var(--white);
        font-family: 'Poppins', sans-serif;
        font-size: 1em;
        min-height: 250px; 
    }
    .ql-editor.ql-blank::before { color: #888; font-style: normal; }
    /* Fix toolbar icons colors */
    .ql-snow .ql-stroke { stroke: var(--silver) !important; }
    .ql-snow .ql-fill { fill: var(--silver) !important; }
    .ql-snow .ql-picker { color: var(--silver) !important; }
    .ql-snow .ql-picker-options { background-color: var(--dark-gray); border-color: #444; }
    .ql-snow .ql-picker-item { color: var(--white); }
    .ql-snow .ql-picker-item:hover { color: var(--gold); }
    .ql-snow.ql-toolbar button:hover .ql-stroke, 
    .ql-snow .ql-toolbar button:hover .ql-stroke, 
    .ql-snow.ql-toolbar button.ql-active .ql-stroke, 
    .ql-snow .ql-toolbar button.ql-active .ql-stroke { stroke: var(--gold) !important; }
    .ql-snow.ql-toolbar button:hover .ql-fill, 
    .ql-snow .ql-toolbar button:hover .ql-fill, 
    .ql-snow.ql-toolbar button.ql-active .ql-fill, 
    .ql-snow .ql-toolbar button.ql-active .ql-fill { fill: var(--gold) !important; }

    /* --- NEW: Smart Template Dropdown Styles --- */
    .template-dropdown {
        position: relative;
        background: #18181b;
        border: 1px solid var(--gold);
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.6);
        z-index: 100;
        display: none; /* Hidden by default */
        overflow-y: auto;
        max-height: 280px;
        margin: 8px 0 12px 0;
    }
    .template-option {
        padding: 12px 15px;
        cursor: pointer;
        border-bottom: 1px solid #333;
        transition: background 0.2s;
    }
    .template-option:last-child { border-bottom: none; }
    .template-option:hover { background: #222; }
    .template-option-title { color: var(--gold); font-weight: bold; display: block; margin-bottom: 4px; }
    .template-option-preview { color: var(--silver); font-size: 0.85em; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    
    .template-helper-btn {
        margin-left: auto;
        background: rgba(255, 215, 0, 0.1);
        color: var(--gold);
        border: 1px solid var(--gold);
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 0.8em;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        user-select: none;
    }
    .template-helper-btn:hover { background: var(--gold); color: var(--black); }

    .docs-dropdown {
        position: relative;
        background: #15181e;
        border: 1px solid #00e676;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.6);
        z-index: 105;
        display: none;
        overflow-y: auto;
        max-height: 280px;
        margin: 8px 0 12px 0;
    }
    .doc-option {
        padding: 12px 15px;
        cursor: pointer;
        border-bottom: 1px solid #282d38;
        transition: background 0.2s;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .doc-option:last-child { border-bottom: none; }
    .doc-option:hover { background: rgba(0, 230, 118, 0.12); }
    .doc-option-title { color: #00e676; font-weight: 600; font-size: 0.9em; display: flex; align-items: center; gap: 6px; }
    .doc-option-slug { color: #8892b0; font-size: 0.78em; font-family: monospace; }
    .doc-helper-btn {
        background: rgba(0, 230, 118, 0.1);
        color: #00e676;
        border: 1px solid rgba(0, 230, 118, 0.4);
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 0.8em;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        user-select: none;
    }
    .doc-helper-btn:hover { background: #00e676; color: var(--black); }

    /* Dynamic Screenshot Editor Styles */
    .screenshot-editor-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 15px;
        margin-top: 10px;
    }
    .screenshot-card {
        background: #111;
        border: 1px solid #333;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: all 0.2s ease;
        position: relative;
    }
    .screenshot-card.excess {
        border: 2px solid var(--red);
        background: rgba(229, 57, 53, 0.05);
    }
    .screenshot-thumb-box {
        position: relative;
        width: 100%;
        padding-top: 60%;
        background: #000;
        overflow: hidden;
    }
    .screenshot-thumb-box img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .screenshot-badge {
        position: absolute;
        top: 6px;
        left: 6px;
        background: rgba(0, 0, 0, 0.75);
        color: var(--white);
        font-size: 0.75em;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 4px;
        z-index: 2;
        border: 1px solid #444;
    }
    .screenshot-badge.cover {
        background: var(--gold);
        color: var(--black);
        border: 1px solid var(--gold);
    }
    .screenshot-badge.excess-badge {
        background: var(--red);
        color: var(--white);
        border: 1px solid var(--red);
    }
    .screenshot-card-actions {
        display: flex;
        justify-content: space-around;
        padding: 8px 4px;
        background: #181818;
        border-top: 1px solid #282828;
    }
    .screenshot-action-btn {
        background: transparent;
        border: none;
        color: var(--silver);
        font-size: 0.9em;
        cursor: pointer;
        padding: 4px 6px;
        border-radius: 4px;
        transition: color 0.2s, background 0.2s;
    }
    .screenshot-action-btn:hover {
        color: var(--gold);
        background: rgba(255, 215, 0, 0.1);
    }
    .screenshot-action-btn.btn-remove:hover {
        color: var(--red);
        background: rgba(229, 57, 53, 0.1);
    }
    .screenshot-add-card {
        border: 2px dashed #444;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 25px 15px;
        cursor: pointer;
        transition: all 0.3s ease;
        background: rgba(255, 255, 255, 0.02);
        min-height: 140px;
    }
    .screenshot-add-card:hover {
        border-color: var(--gold);
        background: rgba(255, 215, 0, 0.05);
        box-shadow: 0 0 12px rgba(255, 215, 0, 0.2);
    }
    .name-detector-msg {
        transition: all 0.3s ease;
    }
</style>

<div class="container">
    <!-- ======== DYNAMIC GO BACK BUTTON ======== -->
    <%- include('../partials/go-back-button', { fallback: '/upload', wrapperStyle: 'max-width: 800px; margin: 2rem auto 0 auto; display: flex; justify-content: flex-start;' }) %>
    <!-- ======================================== -->
    <div class="upload-form-container" style="margin-top: 1rem;">
        <h2>Upload Your Mod <span>- Details</span></h2>
        <p>Step 2 of 2: Your file <strong><%= filename %></strong> is ready. Please provide the details below.</p>
        <div style="display:flex; justify-content:flex-end; gap:10px; margin:15px 0; flex-wrap:wrap;">
            <a href="/mods/<%= fileId %>/preview" target="_blank" class="btn btn-secondary draft-preview-button"><i class="fas fa-eye"></i> Preview Draft</a>
            <button type="button" id="show-snapshots" class="btn btn-secondary"><i class="fas fa-history"></i> Saved Versions</button>
            <span id="autosave-status" style="color:var(--silver); align-self:center; font-size:0.9em;"></span>
        </div>
        <div id="snapshot-list" style="display:none; margin-bottom:15px; padding:12px; background:var(--black); border:1px solid #333; border-radius:8px;"></div>

        <div id="status-alert-box" class="alert-msg" style="display: none; width: 100%; max-width: 800px; margin: 0 auto 20px auto;"></div>

        <form action="/upload-finalize/<%= fileId %>" method="POST" enctype="multipart/form-data" id="mainUploadForm">
            <!-- HIDDEN INPUTS -->
            <input type="hidden" name="fileKey" value="<%= fileKey %>">
            <input type="hidden" name="originalFilename" value="<%= filename %>">
            <input type="hidden" name="fileSize" value="<%= filesize %>">

            <fieldset class="form-section">
                <legend>Core Details</legend>

                <div class="icon-upload-container">
                    <label style="display: block; width: 100%; text-align: center; margin-bottom: 12px;">Mod Icon*</label>
                    <div class="icon-preview" id="iconPreviewBox" style="margin: 0 auto 15px auto;">
                        <img id="iconImage" src="<%= file.iconUrl || '' %>" alt="Icon Preview" <%- `style="display:${file.iconUrl ? 'block' : 'none'};"` %>>
                        <span id="iconPlaceholder" <%- `style="display:${file.iconUrl ? 'none' : 'block'};"` %>>Preview</span>
                    </div>
                    <div style="width: 100%; max-width: 250px; margin: 0 auto; text-align: center;">
                        <input type="file" id="modIcon" name="softwareIcon" accept="image/*">
                        <label for="modIcon" class="file-input-label">Choose Icon</label>
                    </div>
                </div>

                <div class="auto-fetch-box" style="background-color: #0b1a2a; border: 1px solid var(--blue); padding: 20px; border-radius: 8px; margin-bottom: 25px; width: 100%; box-sizing: border-box;">
                    <h4 style="color: var(--blue); margin-bottom: 12px; font-size: 1.1em; display: flex; align-items: center; gap: 8px; text-align: left;"><i class="fas fa-magic"></i> Auto-Fetch App Details</h4>
                    <p style="color: var(--silver); font-size: 0.9em; margin-bottom: 15px; text-align: left;">Paste the official store link to automatically fill the description, developer, OS, and Age requirements below!</p>
                    <div class="fetch-input-group">
                        <div class="fetch-platform-col">
                            <select id="fetchPlatform" style="display: none;">
                                <option value="auto" selected>Auto Detect</option>
                                <option value="playstore">Play Store</option>
                                <option value="appstore">App Store</option>
                                <option value="steam">Steam</option>
                                <option value="epic">Epic Games</option>
                                <option value="wordpress">WordPress</option>
                            </select>
                            <div class="custom-select-wrapper" id="fetchPlatformWrapper">
                                <div class="custom-select" style="padding: 10px 14px; height: 45px; display: flex; align-items: center; justify-content: space-between;">
                                    <span class="selected-text" style="color: var(--white); font-size: 0.95em;">Auto Detect</span>
                                    <i class="fas fa-chevron-down custom-select-arrow" style="font-size: 0.8em;"></i>
                                </div>
                                <div class="custom-options">
                                    <div class="custom-option selected" data-value="auto">Auto Detect</div>
                                    <div class="custom-option" data-value="playstore">Play Store</div>
                                    <div class="custom-option" data-value="appstore">App Store</div>
                                    <div class="custom-option" data-value="steam">Steam</div>
                                    <div class="custom-option" data-value="epic">Epic Games</div>
                                    <div class="custom-option" data-value="wordpress">WordPress</div>
                                </div>
                            </div>
                        </div>
                        <input type="url" id="fetchUrl" class="fetch-url-input" placeholder="Paste store link (Google Play, App Store, Steam, Epic, WordPress)...">
                        <button type="button" id="fetchBtn" class="btn btn-primary fetch-btn"><i class="fas fa-magic"></i> Fetch Data</button>
                    </div>
                    <span id="fetchStatus" style="display: block; margin-top: 10px; font-size: 0.85em; font-weight: bold; text-align: left;"></span>
                </div>

                <div class="form-group">
                    <label for="modName">Mod Name*</label>
                    <input type="text" id="modName" name="modName" value="<%= defaultName %>" placeholder="e.g., Roblox or Minecraft" required autocomplete="off">
                    <div id="modNameLiveStatus" class="name-detector-msg" style="display: none; margin-top: 8px; font-size: 0.85em; font-weight: 600; padding: 8px 12px; border-radius: 8px;"></div>
                </div>

                <div class="form-group">
                    <label for="ageRating">Age Rating*</label>
                    <select id="ageRating" name="ageRating" required style="display: none;">
                        <option value="NA" <%= (typeof file !== 'undefined' && file.ageRating === 'NA') ? 'selected' : '' %>>Not Rated (N/A)</option>
                        <option value="3+" <%= (typeof file !== 'undefined' && file.ageRating === '3+') ? 'selected' : '' %>>3+ (Everyone)</option>
                        <option value="7+" <%= (typeof file !== 'undefined' && file.ageRating === '7+') ? 'selected' : '' %>>7+ (Low Violence)</option>
                        <option value="12+" <%= (typeof file !== 'undefined' && file.ageRating === '12+') ? 'selected' : '' %>>12+ (Moderate Violence)</option>
                        <option value="16+" <%= (typeof file !== 'undefined' && file.ageRating === '16+') ? 'selected' : '' %>>16+ (Strong Violence)</option>
                        <option value="18+" <%= (typeof file !== 'undefined' && file.ageRating === '18+') ? 'selected' : '' %>>18+ (Adults Only)</option>
                    </select>
                    <div class="custom-select-wrapper" id="ageRatingWrapper">
                        <div class="custom-select">
                            <span class="selected-text">
                                <% if (typeof file !== 'undefined' && file && file.ageRating) { %>
                                    <% if (file.ageRating === '3+') { %> 3+ (Everyone)
                                    <% } else if (file.ageRating === '7+') { %> 7+ (Low Violence)
                                    <% } else if (file.ageRating === '12+') { %> 12+ (Moderate Violence)
                                    <% } else if (file.ageRating === '16+') { %> 16+ (Strong Violence)
                                    <% } else if (file.ageRating === '18+') { %> 18+ (Adults Only)
                                    <% } else { %> Not Rated (N/A) <% } %>
                                <% } else { %>
                                    Not Rated (N/A)
                                <% } %>
                            </span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options">
                            <div class="custom-option <%= (!file || !file.ageRating || file.ageRating === 'NA') ? 'selected' : '' %>" data-value="NA">Not Rated (N/A)</div>
                            <div class="custom-option <%= (file && file.ageRating === '3+') ? 'selected' : '' %>" data-value="3+">3+ (Everyone)</div>
                            <div class="custom-option <%= (file && file.ageRating === '7+') ? 'selected' : '' %>" data-value="7+">7+ (Low Violence)</div>
                            <div class="custom-option <%= (file && file.ageRating === '12+') ? 'selected' : '' %>" data-value="12+">12+ (Moderate Violence)</div>
                            <div class="custom-option <%= (file && file.ageRating === '16+') ? 'selected' : '' %>" data-value="16+">16+ (Strong Violence)</div>
                            <div class="custom-option <%= (file && file.ageRating === '18+') ? 'selected' : '' %>" data-value="18+">18+ (Adults Only)</div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="modVersion">Mod Version*</label>
                    <input type="text" id="modVersion" name="modVersion" value="<%= defaultVersion %>" placeholder="e.g., 1.26.1.1" autocomplete="off">
                </div>

                <div class="form-group">
                    <label for="developerName">Official Developer / Company*</label>
                    <input type="text" id="developerName" name="developerName" value="<%= file && file.developer && file.developer !== 'N/A' ? file.developer : '' %>" placeholder="e.g., Supercell or Mojang" autocomplete="off" required>
                </div>

                <div class="form-group">
                    <label>Platform*</label>
                    <select id="modPlatform" name="modPlatform" style="display: none;">
                        <option value="" disabled <%= !defaultPlatform ? 'selected' : '' %>>Select a platform...</option>
                        <option value="android" <%= defaultPlatform === 'android' ? 'selected' : '' %>>Android</option>
                        <option value="ios-jailed" <%= defaultPlatform === 'ios-jailed' ? 'selected' : '' %>>iOS - Jailed (IPA)</option>
                        <option value="ios-jailbroken" <%= defaultPlatform === 'ios-jailbroken' ? 'selected' : '' %>>iOS - Jailbroken (DEB)</option>
                        <option value="windows" <%= defaultPlatform === 'windows' ? 'selected' : '' %>>Windows</option>
                        <option value="wordpress" <%= defaultPlatform === 'wordpress' ? 'selected' : '' %>>WordPress</option>
                    </select>
                    <div class="custom-select-wrapper" id="platformWrapper">
                        <div class="custom-select">
                            <span class="selected-text">
                                <% if (typeof defaultPlatform !== 'undefined' && defaultPlatform) { %>
                                    <% if (defaultPlatform === 'android') { %> Android
                                    <% } else if (defaultPlatform === 'ios-jailed') { %> iOS - Jailed (IPA)
                                    <% } else if (defaultPlatform === 'ios-jailbroken') { %> iOS - Jailbroken (DEB)
                                    <% } else if (defaultPlatform === 'windows') { %> Windows
                                    <% } else if (defaultPlatform === 'wordpress') { %> WordPress
                                    <% } else { %> <%= defaultPlatform %> <% } %>
                                <% } else { %>
                                    Select a platform...
                                <% } %>
                            </span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options">
                            <div class="custom-option <%= (typeof defaultPlatform !== 'undefined' && defaultPlatform === 'android') ? 'selected' : '' %>" data-value="android">Android</div>
                            <div class="custom-option <%= (typeof defaultPlatform !== 'undefined' && defaultPlatform === 'ios-jailed') ? 'selected' : '' %>" data-value="ios-jailed">iOS - Jailed (IPA)</div>
                            <div class="custom-option <%= (typeof defaultPlatform !== 'undefined' && defaultPlatform === 'ios-jailbroken') ? 'selected' : '' %>" data-value="ios-jailbroken">iOS - Jailbroken (DEB)</div>
                            <div class="custom-option <%= (typeof defaultPlatform !== 'undefined' && defaultPlatform === 'windows') ? 'selected' : '' %>" data-value="windows">Windows</div>
                            <div class="custom-option <%= (typeof defaultPlatform !== 'undefined' && defaultPlatform === 'wordpress') ? 'selected' : '' %>" data-value="wordpress">WordPress</div>
                        </div>
                    </div>
                </div>

                <!-- ======== VARIANT DETECTION & MANUAL CHECKBOX BLOCK ======== -->
                <div id="variant-group" style="display: none; background: rgba(168, 85, 247, 0.08); border: 1px solid rgba(168, 85, 247, 0.4); border-radius: 10px; padding: 16px 20px; margin-bottom: 25px; transition: all 0.3s ease;">
                    <div style="display: flex; align-items: flex-start; gap: 14px;">
                        <div style="background: rgba(168, 85, 247, 0.2); color: #c084fc; width: 38px; height: 38px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.25em;">
                            <i class="fas fa-code-branch"></i>
                        </div>
                        <div style="flex-grow: 1;">
                            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                                <h4 style="margin: 0; color: #c084fc; font-size: 1.05em; display: flex; align-items: center; gap: 8px;">
                                    Existing Mod Detected
                                    <span style="background: rgba(168, 85, 247, 0.25); color: #e9d5ff; border: 1px solid rgba(168, 85, 247, 0.5); font-size: 0.72em; padding: 2px 8px; border-radius: 6px; text-transform: uppercase; font-weight: 700;">Variant</span>
                                </h4>
                            </div>
                            <p id="variant-info-text" style="color: var(--silver); font-size: 0.9em; margin: 6px 0 12px 0; line-height: 1.5;">
                                A main file with this mod name and platform already exists.
                            </p>
                            
                            <label style="display: inline-flex; align-items: center; gap: 10px; cursor: pointer; user-select: none; background: rgba(0,0,0,0.3); padding: 8px 14px; border-radius: 8px; border: 1px solid rgba(168, 85, 247, 0.35);">
                                <input type="checkbox" id="isVariantCheckbox" name="isVariant" value="true" checked style="width: 18px; height: 18px; accent-color: #a855f7; cursor: pointer;">
                                <span style="color: #fff; font-size: 0.92em; font-weight: 600;">
                                    Upload as a Variant of this existing mod
                                </span>
                            </label>

                            <!-- Variant Locked Fields & Master Default Inheritance Preset -->
                            <div id="variant-inheritance-panel" style="margin-top: 14px; background: rgba(0,0,0,0.35); border: 1px solid rgba(168, 85, 247, 0.4); border-radius: 8px; padding: 14px 16px;">
                                <div style="font-weight: 700; color: #e9d5ff; font-size: 0.88rem; display: flex; align-items: center; gap: 6px; margin-bottom: 6px;">
                                    <i class="fas fa-lock" style="color: #c084fc;"></i> Managed by Original Uploader (Locked for Variants):
                                </div>
                                <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px;">
                                    <span style="background: rgba(168,85,247,0.25); color: #f3e8ff; border: 1px solid rgba(168,85,247,0.45); padding: 3px 9px; border-radius: 4px; font-size: 0.8rem; font-weight: 600;"><i class="fas fa-image"></i> App Icon</span>
                                    <span style="background: rgba(168,85,247,0.25); color: #f3e8ff; border: 1px solid rgba(168,85,247,0.45); padding: 3px 9px; border-radius: 4px; font-size: 0.8rem; font-weight: 600;"><i class="fas fa-align-left"></i> Official Description</span>
                                    <span style="background: rgba(168,85,247,0.25); color: #f3e8ff; border: 1px solid rgba(168,85,247,0.45); padding: 3px 9px; border-radius: 4px; font-size: 0.8rem; font-weight: 600;"><i class="fas fa-tags"></i> Core Tags</span>
                                </div>
                                <div style="font-size: 0.8rem; color: #94a3b8; line-height: 1.4; margin-bottom: 12px;">
                                    These branding assets are strictly managed by the original mod uploader. All variants inherit them to preserve consistency. You can customize description, mod features, screenshots, version, and architecture flags below.
                                </div>

                                <div>
                                    <label for="variantInheritDropdown" style="color: #e9d5ff; font-weight: 600; font-size: 0.88rem; display: flex; align-items: center; gap: 6px; margin-bottom: 6px;">
                                        <i class="fas fa-sliders" style="color: #c084fc;"></i> Master Default Inheritance Preset:
                                    </label>
                                    <select id="variantInheritDropdown" name="variantInheritanceMode" style="width: 100%; background: #121212; border: 1px solid rgba(168,85,247,0.5); color: #fff; padding: 10px 12px; border-radius: 8px; font-size: 0.88rem; cursor: pointer;">
                                        <option value="all-default" selected>Inherit All Master Defaults (Quick Variant - Uses Master Description, Features &amp; Screenshots)</option>
                                        <option value="custom-features">Custom Features &amp; Description (Enter custom mod description &amp; features, inherit screenshots)</option>
                                        <option value="custom-all">Full Custom Variant (Custom description, features, screenshots, and requirements)</option>
                                    </select>
                                    <div style="font-size: 0.78rem; color: #94a3b8; margin-top: 5px;">
                                        <i class="fas fa-info-circle"></i> If left empty, fields automatically use the master mod's defaults. Direct cloud link &amp; files are always unique to this variant.
                                    </div>
                                </div>
                            </div>

                            <input type="hidden" id="detectedMasterId" name="masterFileId" value="">
                            <input type="hidden" id="variantDetectionSubmitted" name="variantDetectionSubmitted" value="0">
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="minOsVersion">Minimum Required OS Version <span id="os-req-star" style="color: var(--red); display: none;">*</span></label>
                    <input type="text" id="minOsVersion" name="minOsVersion" value="<%= file && file.minOsVersion ? file.minOsVersion : '' %>" placeholder="e.g., iOS 14.0, Android 8.0, Windows 10">
                    <div style="font-size: 0.82em; color: var(--silver); margin-top: 6px;">This field is required for submission on supported platforms, especially iOS and Android releases.</div>
                </div>

                <div class="form-group">
                    <label for="modLicense">Software License (Optional)</label>
                    <select id="modLicense" name="modLicense" style="display: none;">
                        <option value="" <%= !file.license ? 'selected' : '' %>>None / Proprietary</option>
                        <% if (typeof licenses !== 'undefined') { licenses.forEach(license => { %>
                            <option value="<%= license._id %>" <%= file.license && file.license.toString() === license._id.toString() ? 'selected' : '' %>><%= license.name %></option>
                        <% }) } %>
                    </select>
                    <div class="custom-select-wrapper" id="licenseWrapper">
                        <div class="custom-select">
                            <span class="selected-text">
                                <% if (file && file.license && typeof licenses !== 'undefined') { %>
                                    <% const selectedLicense = licenses.find(license => license._id.toString() === file.license.toString()); %>
                                    <%= selectedLicense ? selectedLicense.name : 'None / Proprietary' %>
                                <% } else { %>
                                    None / Proprietary
                                <% } %>
                            </span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options">
                            <div class="custom-option <%= !file.license ? 'selected' : '' %>" data-value="">None / Proprietary</div>
                            <% if (typeof licenses !== 'undefined') { licenses.forEach(license => { %>
                                <div class="custom-option <%= file.license && file.license.toString() === license._id.toString() ? 'selected' : '' %>" data-value="<%= license._id %>"><%= license.name %></div>
                            <% }) } %>
                        </div>
                    </div>

                    <!-- License Active Status Banner -->
                    <div id="licenseStatusBanner" style="<%= file && file.license ? 'display: flex;' : 'display: none;' %> margin-top: 10px; background: rgba(46, 204, 113, 0.1); border: 1px solid rgba(46, 204, 113, 0.35); border-radius: 8px; padding: 10px 14px; align-items: center; justify-content: space-between; gap: 10px;">
                        <div style="display: flex; align-items: center; gap: 8px; color: #2ecc71; font-size: 0.88rem; font-weight: 600;">
                            <i class="fas fa-shield-check" style="font-size: 1.15rem; flex-shrink: 0;"></i>
                            <span>License Active: <strong id="selectedLicenseNameText" style="color: #fff;"><%= (file && file.license && typeof licenses !== 'undefined') ? ((licenses.find(l => l._id.toString() === file.license.toString()) || {}).name || 'Selected') : '' %></strong> <span style="font-size: 0.78rem; color: #a5d6a7; margin-left: 4px; font-weight: normal;">(DMCA Protected &amp; Legal Attribution Active)</span></span>
                        </div>
                        <button type="button" id="btnToggleLicenseGuide" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.2); color: var(--silver); padding: 5px 12px; border-radius: 6px; font-size: 0.78rem; cursor: pointer; transition: all 0.2s; white-space: nowrap; flex-shrink: 0;">
                            Show Guide
                        </button>
                    </div>

                    <!-- DMCA & Licensing Recommendation Guide Callout -->
                    <div id="licenseRecommendationGuide" style="<%= file && file.license ? 'display: none;' : 'display: block;' %> margin-top: 10px; background: rgba(255, 215, 0, 0.05); border: 1px solid rgba(255, 215, 0, 0.22); border-left: 3px solid var(--gold); border-radius: 8px; padding: 12px 14px; font-size: 0.84em; line-height: 1.5;">
                        <div style="font-weight: 700; color: var(--gold); margin-bottom: 4px; display: flex; align-items: center; justify-content: space-between;">
                            <span><i class="fas fa-scale-balanced" style="margin-right: 6px;"></i> Licensing &amp; DMCA Protection Guide</span>
                            <a href="/licenses" target="_blank" style="color: var(--gold); text-decoration: underline; font-size: 0.9em; font-weight: normal;">View Full Hub <i class="fas fa-external-link-alt" style="font-size: 0.8em;"></i></a>
                        </div>
                        <div style="color: var(--silver); margin-bottom: 8px;">
                            Attaching the proper license legally defines distribution rights, safeguards creator attribution, and provides safe-harbor DMCA protection for your uploads.
                        </div>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 8px;">
                            <div style="background: rgba(0,0,0,0.3); padding: 6px 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.06);">
                                <strong style="color: var(--white); display: block;"><i class="fas fa-shield-alt" style="color: #4caf50;"></i> OCOM License</strong>
                                <span style="color: #bbb; font-size: 0.92em;">Recommended for general mods, modified games &amp; Android/iOS/Windows/WP releases.</span>
                            </div>
                            <div style="background: rgba(0,0,0,0.3); padding: 6px 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.06);">
                                <strong style="color: var(--white); display: block;"><i class="fab fa-wordpress" style="color: #2196f3;"></i> WordPress GPL</strong>
                                <span style="color: #bbb; font-size: 0.92em;">For WP plugins &amp; themes inheriting GNU 100% freedom to modify &amp; share.</span>
                            </div>
                            <div style="background: rgba(0,0,0,0.3); padding: 6px 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.06);">
                                <strong style="color: var(--white); display: block;"><i class="fas fa-apple-whole" style="color: #ff9800;"></i> Jailbreak Tweaks (MIT/BSD)</strong>
                                <span style="color: #bbb; font-size: 0.92em;">Best for iOS tweaks, hooks &amp; Cydia/Sileo packages allowing open modifications.</span>
                            </div>
                            <div style="background: rgba(0,0,0,0.3); padding: 6px 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.06);">
                                <strong style="color: var(--white); display: block;"><i class="fas fa-code-branch" style="color: #ab47bc;"></i> Developer's OSS License</strong>
                                <span style="color: #bbb; font-size: 0.92em;">Match original developer upstream repository license (Apache, MIT, AGPL).</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Sub-Category*</label>
                    <select id="modCategory" name="modCategory" required disabled style="display: none;">
                        <option value="" disabled selected>Select a platform first...</option>
                    </select>
                    <div class="custom-select-wrapper disabled" id="categoryWrapper">
                        <div class="custom-select">
                            <span class="selected-text"><%= (file && file.platforms && file.platforms[0]) ? file.platforms[0] : 'Select a platform first...' %></span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options" id="categoryOptionsContainer"></div>
                    </div>
                </div>

                <div class="form-group" id="arch-group" style="display: none; background: rgba(255, 215, 0, 0.05); padding: 20px; border-radius: 8px; border: 1px solid #333; margin-top: 15px; width: 100%; box-sizing: border-box;">
                    <label style="color: var(--gold);"><i class="fas fa-microchip"></i> Architecture Support <span id="arch-req-star" style="color: var(--red); display: none;">*</span></label>
                    <p style="font-size: 0.85em; color: var(--silver); margin-bottom: 10px;">Select all hardware architectures this file supports.</p>
                    <div class="custom-select-wrapper" id="archWrapper">
                        <div class="custom-select" id="archCustomSelect">
                            <span class="selected-text" id="archSelectedText">Select architectures...</span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options" id="archOptionsContainer" style="max-height: 250px; overflow-y: auto;">
                            <!-- Multi-select checkboxes will be dynamically populated here -->
                        </div>
                    </div>
                </div>

                <!-- Platform-Specific Compatibility Flags -->
                <% 
                    const initialHasFlagsPlatform = file && ['android', 'ios-jailbroken', 'windows'].includes(file.category);
                %>
                <div id="platform-flags-container" style="display: <%= initialHasFlagsPlatform ? 'block' : 'none' %>; margin-top: 15px; width: 100%; box-sizing: border-box;">
                    <!-- Android Flags -->
                    <div id="flags-android" class="platform-flags-box" style="display: <%= (file && file.category === 'android') ? 'block' : 'none' %>; background: rgba(0, 230, 118, 0.06); padding: 18px; border-radius: 8px; border: 1px solid rgba(0, 230, 118, 0.25); margin-bottom: 15px;">
                        <h4 style="color: #00e676; font-size: 0.95em; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                            <i class="fab fa-android"></i> Android Compatibility Flags
                        </h4>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; color: var(--white); font-weight: normal; margin-bottom: 0;">
                                <input type="checkbox" name="requiresRoot" id="requiresRoot" value="true" <%= (file && file.requiresRoot) ? 'checked' : '' %> style="accent-color: var(--gold); width: 18px; height: 18px; cursor: pointer;">
                                <span><strong>Requires Root</strong> <span style="color: var(--silver); font-size: 0.88em;">(App requires root permissions like Magisk, KernelSU, or APatch to work)</span></span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; color: var(--white); font-weight: normal; margin-bottom: 0;">
                                <input type="checkbox" name="requiresDevMode" id="requiresDevModeAndroid" value="true" <%= (file && file.requiresDevMode && file.category === 'android') ? 'checked' : '' %> <%= (file && file.category !== 'android') ? 'disabled' : '' %> style="accent-color: var(--gold); width: 18px; height: 18px; cursor: pointer;">
                                <span><strong>Requires Developer Mode</strong> <span style="color: var(--silver); font-size: 0.88em;">(App needs Developer Options or USB Debugging enabled, but does not require root)</span></span>
                            </label>
                        </div>
                    </div>

                    <!-- iOS Jailbroken Flags -->
                    <div id="flags-ios-jailbroken" class="platform-flags-box" style="display: <%= (file && file.category === 'ios-jailbroken') ? 'block' : 'none' %>; background: rgba(255, 152, 0, 0.06); padding: 18px; border-radius: 8px; border: 1px solid rgba(255, 152, 0, 0.25); margin-bottom: 15px;">
                        <h4 style="color: #ff9800; font-size: 0.95em; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                            <i class="fas fa-terminal"></i> Jailbreak Compatibility & Dependencies
                        </h4>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; color: var(--white); font-weight: normal; margin-bottom: 0;">
                                <input type="checkbox" name="isTweakConvertible" id="isTweakConvertible" value="true" <%= (file && file.isTweakConvertible) ? 'checked' : '' %> style="accent-color: var(--gold); width: 18px; height: 18px; cursor: pointer;">
                                <span><strong>Convertible Tweak</strong> <span style="color: var(--silver); font-size: 0.88em;">(Can be converted between rootful & rootless via Derootifier, RootHidePatcher, or Xinam1neAIO)</span></span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; color: var(--white); font-weight: normal; margin-bottom: 0;">
                                <input type="checkbox" name="requiresDependencies" id="requiresDependencies" value="true" <%= (file && file.requiresDependencies) ? 'checked' : '' %> style="accent-color: var(--gold); width: 18px; height: 18px; cursor: pointer;">
                                <span><strong>Requires Dependencies</strong> <span style="color: var(--silver); font-size: 0.88em;">(Requires external tweak dependencies/libraries like Cephei, preferenceloader, etc. to be installed first)</span></span>
                            </label>
                        </div>
                    </div>

                    <!-- Windows Flags -->
                    <div id="flags-windows" class="platform-flags-box" style="display: <%= (file && file.category === 'windows') ? 'block' : 'none' %>; background: rgba(33, 150, 243, 0.06); padding: 18px; border-radius: 8px; border: 1px solid rgba(33, 150, 243, 0.25); margin-bottom: 15px;">
                        <h4 style="color: #2196f3; font-size: 0.95em; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                            <i class="fab fa-windows"></i> Windows Compatibility Flags
                        </h4>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; color: var(--white); font-weight: normal; margin-bottom: 0;">
                                <input type="checkbox" name="requiresDisableAntivirus" id="requiresDisableAntivirus" value="true" <%= (file && file.requiresDisableAntivirus) ? 'checked' : '' %> style="accent-color: var(--gold); width: 18px; height: 18px; cursor: pointer;">
                                <span><strong>Requires Disabling Antivirus</strong> <span style="color: var(--silver); font-size: 0.88em;">(May be flagged as false positive; user must disable Windows Defender or add an exclusion)</span></span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; color: var(--white); font-weight: normal; margin-bottom: 0;">
                                <input type="checkbox" name="requiresDevMode" id="requiresDevModeWindows" value="true" <%= (file && file.requiresDevMode && file.category === 'windows') ? 'checked' : '' %> <%= (file && file.category !== 'windows') ? 'disabled' : '' %> style="accent-color: var(--gold); width: 18px; height: 18px; cursor: pointer;">
                                <span><strong>Requires Developer Mode</strong> <span style="color: var(--silver); font-size: 0.88em;">(Requires Windows Developer Mode enabled to install/run unsigned packages)</span></span>
                            </label>
                        </div>
                    </div>
                </div>
            </fieldset>
            
            <fieldset class="form-section">
                <legend>Descriptions</legend>


                <div class="form-group" style="position: relative;">
                    <label for="modDescription" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                        Mod Description* 
                        <span class="template-helper-btn" data-target="modDescription"><i class="fa-solid fa-lightbulb"></i> Use Template</span>
                    </label>
                    <div id="dropdown-modDescription" class="template-dropdown"></div>
                    <textarea id="modDescription" name="modDescription" style="display:none;"><%- file && file.modDescription ? file.modDescription : '' %></textarea>
                    <div id="editor-modDescription"><%- file && file.modDescription ? file.modDescription : '' %></div>
                </div>

                <div class="form-group" style="position: relative;">
                    <label for="modFeatures" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                        Mod Features* (One per line)
                        <span class="template-helper-btn" data-target="modFeatures"><i class="fa-solid fa-lightbulb"></i> Use Template</span>
                    </label>
                    <div id="dropdown-modFeatures" class="template-dropdown"></div>
                    <textarea id="modFeatures" name="modFeatures" style="display:none;"><%- file && file.modFeatures ? file.modFeatures : '' %></textarea>
                    <div id="editor-modFeatures"><%- file && file.modFeatures ? file.modFeatures : '' %></div>
                </div>

                <div class="form-group">
                    <label for="officialDescription">Official Description*</label>
                    <textarea id="officialDescription" name="officialDescription" style="display:none;"><%- file && file.officialDescription ? file.officialDescription : '' %></textarea>
                    <div id="editor-officialDescription"><%- file && file.officialDescription ? file.officialDescription : '' %></div>
                </div>

                 <div class="form-group" style="position: relative;">
                    <label for="importantNote" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                        <span>Important Note / Installation Instructions (Optional)</span>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            <span class="doc-helper-btn" id="btn-attach-docs" data-target="importantNote" title="Attach an official doc link (/docs)"><i class="fas fa-book"></i> Attach Docs (/docs)</span>
                            <span class="template-helper-btn" data-target="importantNote"><i class="fa-solid fa-lightbulb"></i> Use Template</span>
                        </div>
                    </label>
                    <div id="dropdown-importantNote" class="template-dropdown"></div>
                    <div id="dropdown-docs-importantNote" class="docs-dropdown"></div>
                    <textarea id="importantNote" name="importantNote" style="display:none;"><%- file && file.importantNote ? file.importantNote : '' %></textarea>
                    <div id="editor-importantNote"><%- file && file.importantNote ? file.importantNote : '' %></div>
                </div>
                
                <div class="form-group" style="position: relative;">
                    <label for="whatsNew" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                        What's New (Optional)
                        <span class="template-helper-btn" data-target="whatsNew"><i class="fa-solid fa-lightbulb"></i> Use Template</span>
                    </label>
                    <div id="dropdown-whatsNew" class="template-dropdown"></div>
                    <textarea id="whatsNew" name="whatsNew" style="display:none;"><%- file && file.whatsNew ? file.whatsNew : '' %></textarea>
                    <div id="editor-whatsNew"><%- file && file.whatsNew ? file.whatsNew : '' %></div>
                </div>
            </fieldset>

                <!-- ======== DIRECT CLOUD LINK ======== -->
                <div class="form-group" id="direct-link-group" style="background: rgba(0, 122, 255, 0.1); padding: 20px; border-radius: 8px; border: 1px solid #007AFF; margin-bottom: 25px;">
                    <label for="directDownloadUrl" style="color: var(--white);"><i class="fas fa-link"></i> Direct Cloud Link (Dropbox, etc.) <span style="color: var(--gold); font-size: 0.8em; font-weight: normal;">Optional</span></label>
                    <input type="url" id="directDownloadUrl" name="directDownloadUrl" placeholder="e.g., https://www.dropbox.com/s/.../app.zip?dl=1" value="<%= typeof file !== 'undefined' ? file.directDownloadUrl : '' %>">
                    <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px;">
                        <span style="font-size: 0.75em; background: rgba(0, 122, 255, 0.2); color: #60a5fa; border: 1px solid rgba(0, 122, 255, 0.4); padding: 2px 7px; border-radius: 10px;"><i class="fab fa-dropbox"></i> Dropbox</span>
                        <span style="font-size: 0.75em; background: rgba(52, 168, 83, 0.2); color: #6ee7b7; border: 1px solid rgba(52, 168, 83, 0.4); padding: 2px 7px; border-radius: 10px;"><i class="fab fa-google-drive"></i> Google Drive</span>
                        <span style="font-size: 0.75em; background: rgba(0, 120, 212, 0.2); color: #93c5fd; border: 1px solid rgba(0, 120, 212, 0.4); padding: 2px 7px; border-radius: 10px;"><i class="fab fa-microsoft"></i> OneDrive</span>
                        <span style="font-size: 0.75em; background: rgba(220, 38, 38, 0.2); color: #fca5a5; border: 1px solid rgba(220, 38, 38, 0.4); padding: 2px 7px; border-radius: 10px;"><i class="fas fa-cloud"></i> Mega</span>
                        <span style="font-size: 0.75em; background: rgba(245, 158, 11, 0.2); color: #fde68a; border: 1px solid rgba(245, 158, 11, 0.4); padding: 2px 7px; border-radius: 10px;"><i class="fas fa-fire"></i> MediaFire</span>
                        <span style="font-size: 0.75em; background: rgba(99, 102, 241, 0.2); color: #c7d2fe; border: 1px solid rgba(99, 102, 241, 0.4); padding: 2px 7px; border-radius: 10px;"><i class="fas fa-archive"></i> Box</span>
                        <span style="font-size: 0.75em; background: rgba(139, 92, 246, 0.2); color: #ddd6fe; border: 1px solid rgba(139, 92, 246, 0.4); padding: 2px 7px; border-radius: 10px;"><i class="fas fa-shield-alt"></i> Proton Drive</span>
                    </div>
                    <span style="font-size: 0.82em; color: var(--gold); display: block; margin-top: 6px;"><i class="fas fa-bolt"></i> Auto-Conversion: Cloud links from Dropbox, Drive, OneDrive, Mega, Box, etc. are automatically converted to direct download streams and appended as instant alternative download mirrors.</span>
                </div>
                <!-- ======================================================== -->
                <!-- ======== JAILBREAK PACKAGE ID ======== -->
                <div class="form-group" id="pkg-id-group" style="display: none; background: rgba(255, 149, 0, 0.1); padding: 20px; border-radius: 8px; border: 1px solid #FF9500; margin-bottom: 25px;">
                    <label for="iosPackageId" style="color: var(--white);"><i class="fas fa-box-open"></i> Jailbreak Package ID <span style="color: var(--gold); font-size: 0.8em; font-weight: normal;">Optional</span></label>
                    <input type="text" id="iosPackageId" name="iosPackageId" placeholder="e.g., com.spark.snowboard" value="<%= (typeof file !== 'undefined' && file.iosPackageId) ? file.iosPackageId : '' %>">
                    <span style="font-size: 0.85em; color: var(--silver); display: block; margin-top: 5px;">Required to enable direct Sileo/Zebra package installation buttons. Must exactly match the ID in your control file.</span>
                </div>
                <!-- =========================================== -->

            <!-- LINKS & PARTS MANAGEMENT (Appears ONLY for Link-based uploads, never for Cloud storage uploads) -->
            <% const isLinkBasedUpload = Boolean(typeof file !== 'undefined' && file && (file.fileKey === 'external-link' || file.externalDownloadUrl || file.isMultiPart)); %>
            <% const canManageLinks = Boolean(user && (user.role === 'distributor' || user.role === 'admin' || user.role === 'owner') && isLinkBasedUpload); %>
            <% if (canManageLinks) { %>
                <fieldset class="form-section">
                    <legend>Links & Parts Management</legend>

                    <div style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:15px;">
                        <button type="button" id="btn-single-link" class="btn btn-primary" style="flex:1; padding:10px;">Single External Link</button>
                        <button type="button" id="btn-multi-part" class="btn btn-secondary" style="flex:1; padding:10px;">Multi-Part Download</button>
                    </div>

                    <input type="hidden" id="isMultiPartHidden" name="isMultiPart" value="<%= file.isMultiPart ? 'true' : 'false' %>">

                    <div id="single-link-container" <%- `style="display: ${file.isMultiPart ? 'none' : 'block'}"` %>>
                        <div class="form-group">
                            <label for="externalDownloadUrl">Main External URL*</label>
                            <input type="url" id="externalDownloadUrl" name="externalDownloadUrl" value="<%= file.externalDownloadUrl || '' %>" class="link-req-single" placeholder="https://linkvertise.com/...">
                        </div>

                        <div style="margin-top:10px; border-top:1px solid #333; padding-top:10px;">
                            <p style="color:var(--silver); margin-bottom:8px; font-weight:600;">Admin & Safety Overrides</p>
                            <div class="form-group" id="manualFileScanGroup" <%- `style="display: ${(typeof file !== 'undefined' && file.fileSize && file.fileSize > 640 * 1024 * 1024) ? 'block' : 'none'};"` %>>
                                <label for="manualFileScanUrl">Manual File Scan URL <span style="color: var(--gold); font-size: 0.8em; font-weight: normal;">Required for files over 640MB</span></label>
                                <input type="url" id="manualFileScanUrl" name="manualFileScanUrl" value="<%= file.manualFileScanUrl || '' %>" placeholder="Manual File Scan URL">
                            </div>
                            <div class="form-group" id="manualSiteScanGroup" <%- `style="display: ${(typeof file !== 'undefined' && file.directDownloadUrl) ? 'block' : 'none'};"` %>>
                                <label for="manualSiteScanUrl">Manual Site Scan URL <span style="color: var(--gold); font-size: 0.8em; font-weight: normal;">Only shown when a direct link is provided</span></label>
                                <input type="url" id="manualSiteScanUrl" name="manualSiteScanUrl" value="<%= file.manualSiteScanUrl || '' %>" placeholder="Manual Site Scan URL">
                            </div>
                        </div>
                    </div>

                    <div id="multi-part-container" <%- `style="display: ${file.isMultiPart ? 'block' : 'none'}"` %>>
                        <div id="parts-wrapper">
                            <!-- Parts will be injected by JS -->
                        </div>
                        <div style="display:flex; gap:8px;">
                            <button type="button" id="add-part-btn" class="btn btn-secondary" style="padding:8px 12px;">+ Add New Part</button>
                        </div>
                    </div>
                </fieldset>
            <% } %>

            <fieldset class="form-section">
                <legend>Media & Metadata</legend>
                <div class="form-group">
                    <label for="tags">Tags (Optional, comma-separated)</label>
                    <input type="text" id="tags" name="tags" value="<%= file && file.tags ? file.tags.join(', ') : '' %>" placeholder="strategy, multiplayer, offline" autocomplete="off">
                </div>

                <div class="form-group" id="screenshotEditorSection">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <label style="margin-bottom: 0;">Mod Screenshots* (1-4 images) <span id="screenshotCountBadge" style="font-size: 0.85em; color: var(--gold); font-weight: normal;">(0/4)</span></label>
                    </div>

                    <!-- Screenshot Error Banner -->
                    <div id="screenshotErrorBanner" class="status-banner rejected" style="display: none; margin-bottom: 15px; padding: 12px 15px; border-radius: 8px; font-size: 0.9em; text-align: left;">
                        <i class="fas fa-exclamation-triangle" style="margin-right: 8px;"></i>
                        <span id="screenshotErrorText"></span>
                    </div>

                    <!-- Dynamic Screenshot Grid -->
                    <div class="screenshot-editor-grid" id="screenshotEditorGrid">
                        <!-- Cards dynamically rendered here -->
                    </div>

                    <!-- Hidden inputs for form sync & submission -->
                    <input type="hidden" name="screenshotOrder" id="screenshotOrderInput" value="[]">
                    <input type="file" id="screenshots" name="screenshots" accept="image/png, image/jpeg, image/webp" multiple style="display: none;">
                    
                    <!-- Single-slot file replacer/adder input -->
                    <input type="file" id="screenshotReplacerInput" accept="image/png, image/jpeg, image/webp" style="display: none;">
                    <input type="file" id="screenshotAdderInput" accept="image/png, image/jpeg, image/webp" multiple style="display: none;">
                </div>

                <div class="form-group">
                    <label for="videoUrl">Video URL (Optional)</label>
                    <input type="url" id="videoUrl" name="videoUrl" value="<%= file.videoUrl || '' %>" placeholder="https://www.youtube.com/watch?v=..." autocomplete="off">
                    <div class="preview-container" id="videoPreviewContainer"></div>
                </div>
            </fieldset>
            
            <input type="hidden" name="actionType" id="actionType" value="submit">

            <div class="button-group">
                <button type="button" class="draft-button" id="saveDraftBtn">Save Draft</button>
                <button type="button" class="submit-button" id="submitModBtn">Submit Mod for Review</button>
            </div>
        </form>
    </div>
</div>

<!-- ======== CONFIRMATION MODALS ======== -->

<!-- Submit Confirmation Modal -->
<div id="submit-confirm-modal" class="policy-modal">
    <div class="policy-modal-content" style="background-color: var(--dark-gray); padding: 30px; text-align: center; border-radius: 15px; max-width: 450px; width: 90%; border-top: 3px solid var(--gold); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        <i class="fas fa-paper-plane" style="font-size: 3em; color: var(--gold); margin-bottom: 15px;"></i>
        <h2 style="color: var(--white); margin-bottom: 15px;">Submit Mod?</h2>
        <p style="margin-bottom: 25px; color: var(--silver); line-height: 1.6;">
            Are you sure you want to submit this mod for review? You will not be able to edit the core details again until an admin approves or rejects it.
        </p>
        <div style="display: flex; gap: 15px; justify-content: center;">
            <button type="button" class="btn btn-primary" id="confirmSubmitBtn" style="width: 100%; padding: 12px; border-radius: 8px; font-weight: bold; background-color: var(--gold); color: var(--black); border: none; cursor: pointer;">Yes, Submit</button>
            <button type="button" class="btn btn-secondary" onclick="closeConfirmModal('submit-confirm-modal')" style="width: 100%; padding: 12px; border-radius: 8px; font-weight: bold; background-color: transparent; border: 2px solid var(--silver); color: var(--silver); cursor: pointer;">Cancel</button>
        </div>
    </div>
</div>

<!-- Draft Confirmation Modal -->
<div id="draft-confirm-modal" class="policy-modal">
    <div class="policy-modal-content" style="background-color: var(--dark-gray); padding: 30px; text-align: center; border-radius: 15px; max-width: 450px; width: 90%; border-top: 3px solid var(--silver); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        <i class="fas fa-save" style="font-size: 3em; color: var(--silver); margin-bottom: 15px;"></i>
        <h2 style="color: var(--white); margin-bottom: 15px;">Save Draft?</h2>
        <p style="margin-bottom: 25px; color: var(--silver); line-height: 1.6;">
            Your progress will be saved. You can return to this page later from your "My Uploads" dashboard to finish and submit the mod.
        </p>
        <div style="display: flex; gap: 15px; justify-content: center;">
            <button type="button" class="btn btn-primary" id="confirmDraftBtn" style="width: 100%; padding: 12px; border-radius: 8px; font-weight: bold; background-color: var(--silver); color: var(--black); border: none; cursor: pointer;">Save Draft</button>
            <button type="button" class="btn btn-secondary" onclick="closeConfirmModal('draft-confirm-modal')" style="width: 100%; padding: 12px; border-radius: 8px; font-weight: bold; background-color: transparent; border: 2px solid #555; color: var(--silver); cursor: pointer;">Cancel</button>
        </div>
    </div>
</div>

<script type="application/json" id="server-custom-templates-data"><%- JSON.stringify(typeof customTemplates !== 'undefined' ? customTemplates : []).replace(/</g, '\\u003c') %></script>
<script type="application/json" id="server-official-docs-data"><%- JSON.stringify(typeof officialDocs !== 'undefined' ? officialDocs : []).replace(/</g, '\\u003c') %></script>

<script>
// Helper to control the Error/Success Alert Box (Globally available)
function showStatusAlert(message, type) {
    const alertBox = document.getElementById('status-alert-box');
    if (!alertBox) return;

    alertBox.textContent = message;
    if (type === 'error') {
        alertBox.className = 'status-banner rejected'; 
        alertBox.style.backgroundColor = 'rgba(229, 57, 53, 0.1)';
        alertBox.style.color = 'var(--red)';
        alertBox.style.border = '1px solid var(--red)';
    } else {
        alertBox.className = 'status-banner'; 
        alertBox.style.backgroundColor = 'rgba(46, 204, 113, 0.1)';
        alertBox.style.color = '#2ecc71';
        alertBox.style.border = '1px solid #2ecc71';
    }
    alertBox.style.display = 'block';
    alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

// Global modal closer
window.closeConfirmModal = function(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
        modal.classList.remove('show');
        setTimeout(() => { modal.style.display = 'none'; }, 200);
    }
}

// ==========================================
// MAIN INITIALIZATION
// ==========================================
document.addEventListener('DOMContentLoaded', () => {

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('error')) showStatusAlert(urlParams.get('error'), 'error'); 
    if (urlParams.has('success')) showStatusAlert(urlParams.get('success'), 'success'); 

    // ==========================================
    // 1. UI ELEMENTS & BASIC LOGIC
    // ==========================================
    const modIcon = document.getElementById('modIcon');
    const iconImage = document.getElementById('iconImage');
    const iconPlaceholder = document.getElementById('iconPlaceholder');
    const screenshotsInput = document.getElementById('screenshots');
    const screenshotFileNameSpan = document.getElementById('screenshotFileName');
    const screenshotPreviewContainer = document.getElementById('screenshotPreviewContainer');
    const videoUrlInput = document.getElementById('videoUrl');
    const videoPreviewContainer = document.getElementById('videoPreviewContainer');

    // Live icon preview
    if (modIcon) {
        modIcon.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    iconImage.src = e.target.result;
                    iconImage.style.display = 'block';
                    if(iconPlaceholder) iconPlaceholder.style.display = 'none';
                }
                reader.readAsDataURL(file);
            }
        });
    }

    // ==========================================
    // DYNAMIC SCREENSHOT EDITOR SYSTEM
    // ==========================================
    let screenshotList = [];
    const screenshotEditorGrid = document.getElementById('screenshotEditorGrid');
    const screenshotCountBadge = document.getElementById('screenshotCountBadge');
    const screenshotErrorBanner = document.getElementById('screenshotErrorBanner');
    const screenshotErrorText = document.getElementById('screenshotErrorText');
    const screenshotOrderInput = document.getElementById('screenshotOrderInput');
    const dynamicScreenshotsInput = document.getElementById('screenshots');
    const screenshotReplacerInput = document.getElementById('screenshotReplacerInput');
    const screenshotAdderInput = document.getElementById('screenshotAdderInput');

    let replaceSlotIndex = -1;
    let draggedSlotIndex = -1;

    // Load initial screenshots from server if this is a draft
    const initialScreenshotKeys = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(file.screenshotKeys || [])) %>'));
    const initialScreenshotUrls = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(file.screenshotUrls || [])) %>'));
    if (Array.isArray(initialScreenshotKeys) && Array.isArray(initialScreenshotUrls)) {
        initialScreenshotKeys.forEach((key, idx) => {
            if (key && initialScreenshotUrls[idx]) {
                screenshotList.push({
                    id: 'existing_' + idx + '_' + Math.random(),
                    type: 'existing',
                    key: key,
                    url: initialScreenshotUrls[idx],
                    file: null
                });
            }
        });
    }

    function renderScreenshotGallery() {
        if (!screenshotEditorGrid) return;
        screenshotEditorGrid.innerHTML = '';
        const total = screenshotList.length;

        if (screenshotCountBadge) {
            screenshotCountBadge.textContent = `(${total}/4)`;
            screenshotCountBadge.style.color = total > 4 ? 'var(--red)' : 'var(--gold)';
        }

        // Check 4-screenshot limit and display error
        if (total > 4) {
            const diff = total - 4;
            const errorMsg = `You have uploaded more then 4 Screenshot of the app/game. There are only 4 maximum screenshot are allowed for an app or game please remove unnecessary ${diff} of Screenshot`;
            if (screenshotErrorBanner && screenshotErrorText) {
                screenshotErrorText.textContent = errorMsg;
                screenshotErrorBanner.style.display = 'block';
            }
        } else {
            if (screenshotErrorBanner) {
                screenshotErrorBanner.style.display = 'none';
            }
        }

        // Render each screenshot card
        screenshotList.forEach((item, index) => {
            const card = document.createElement('div');
            card.className = `screenshot-card ${index >= 4 ? 'excess' : ''}`;
            card.draggable = true;
            card.dataset.index = index;

            // Drag and drop event listeners
            card.addEventListener('dragstart', (e) => {
                draggedSlotIndex = index;
                card.style.opacity = '0.5';
            });
            card.addEventListener('dragend', () => {
                draggedSlotIndex = -1;
                card.style.opacity = '1';
            });
            card.addEventListener('dragover', (e) => {
                e.preventDefault();
                card.style.borderColor = 'var(--gold)';
            });
            card.addEventListener('dragleave', () => {
                card.style.borderColor = index >= 4 ? 'var(--red)' : '#333';
            });
            card.addEventListener('drop', (e) => {
                e.preventDefault();
                card.style.borderColor = index >= 4 ? 'var(--red)' : '#333';
                if (draggedSlotIndex !== -1 && draggedSlotIndex !== index) {
                    const movedItem = screenshotList.splice(draggedSlotIndex, 1)[0];
                    screenshotList.splice(index, 0, movedItem);
                    renderScreenshotGallery();
                }
            });

            // Badge text
            let badgeHtml = '';
            if (index >= 4) {
                badgeHtml = `<span class="screenshot-badge excess-badge">#${index + 1} (Excess - Remove)</span>`;
            } else if (index === 0) {
                badgeHtml = `<span class="screenshot-badge cover">#1 (Cover)</span>`;
            } else {
                badgeHtml = `<span class="screenshot-badge">#${index + 1}</span>`;
            }

            card.innerHTML = `
                <div class="screenshot-thumb-box">
                    ${badgeHtml}
                    <img src="${item.url}" alt="Screenshot ${index + 1}">
                </div>
                <div class="screenshot-card-actions">
                    <button type="button" class="screenshot-action-btn btn-move-left" title="Move Left" ${index === 0 ? 'disabled' : ''}>
                        <i class="fas fa-arrow-left"></i>
                    </button>
                    <button type="button" class="screenshot-action-btn btn-move-right" title="Move Right" ${index === total - 1 ? 'disabled' : ''}>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                    <button type="button" class="screenshot-action-btn btn-replace" title="Replace this image">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                    <button type="button" class="screenshot-action-btn btn-remove" title="Remove image">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            `;

            // Card Action Buttons
            card.querySelector('.btn-move-left')?.addEventListener('click', (e) => {
                e.preventDefault();
                if (index > 0) {
                    const temp = screenshotList[index];
                    screenshotList[index] = screenshotList[index - 1];
                    screenshotList[index - 1] = temp;
                    renderScreenshotGallery();
                }
            });

            card.querySelector('.btn-move-right')?.addEventListener('click', (e) => {
                e.preventDefault();
                if (index < screenshotList.length - 1) {
                    const temp = screenshotList[index];
                    screenshotList[index] = screenshotList[index + 1];
                    screenshotList[index + 1] = temp;
                    renderScreenshotGallery();
                }
            });

            card.querySelector('.btn-replace')?.addEventListener('click', (e) => {
                e.preventDefault();
                replaceSlotIndex = index;
                if (screenshotReplacerInput) {
                    screenshotReplacerInput.value = '';
                    screenshotReplacerInput.click();
                }
            });

            card.querySelector('.btn-remove')?.addEventListener('click', (e) => {
                e.preventDefault();
                screenshotList.splice(index, 1);
                renderScreenshotGallery();
            });

            screenshotEditorGrid.appendChild(card);
        });

        // "+ Add Screenshot" card (shown if < 4)
        if (total < 4) {
            const addCard = document.createElement('div');
            addCard.className = 'screenshot-add-card';
            addCard.innerHTML = `
                <i class="fas fa-plus-circle" style="font-size: 2.2em; color: var(--gold); margin-bottom: 10px;"></i>
                <span style="font-weight: 600; color: var(--white); font-size: 0.95em;">Add Screenshot</span>
                <span style="font-size: 0.8em; color: var(--silver); margin-top: 4px;">${4 - total} slot${4 - total > 1 ? 's' : ''} remaining</span>
            `;
            addCard.addEventListener('click', () => {
                if (screenshotAdderInput) {
                    screenshotAdderInput.value = '';
                    screenshotAdderInput.click();
                }
            });
            screenshotEditorGrid.appendChild(addCard);
        }
    }

    // Handle adding new screenshots
    if (screenshotAdderInput) {
        screenshotAdderInput.addEventListener('change', function() {
            const files = Array.from(this.files || []);
            if (files.length === 0) return;

            let loaded = 0;
            files.forEach(file => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    screenshotList.push({
                        id: 'new_' + Date.now() + '_' + Math.random(),
                        type: 'new',
                        key: null,
                        url: e.target.result,
                        file: file
                    });
                    loaded++;
                    if (loaded === files.length) {
                        renderScreenshotGallery();
                    }
                };
                reader.readAsDataURL(file);
            });
        });
    }

    // Handle replacing a specific screenshot
    if (screenshotReplacerInput) {
        screenshotReplacerInput.addEventListener('change', function() {
            const file = this.files && this.files[0];
            if (!file || replaceSlotIndex < 0 || replaceSlotIndex >= screenshotList.length) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                screenshotList[replaceSlotIndex] = {
                    id: 'new_' + Date.now() + '_' + Math.random(),
                    type: 'new',
                    key: null,
                    url: e.target.result,
                    file: file
                };
                replaceSlotIndex = -1;
                renderScreenshotGallery();
            };
            reader.readAsDataURL(file);
        });
    }

    // Function to sync screenshotList into hidden form input before submission
    function syncScreenshotsToForm() {
        const total = screenshotList.length;
        if (total > 4) {
            const diff = total - 4;
            return {
                valid: false,
                error: `You have uploaded more then 4 Screenshot of the app/game. There are only 4 maximum screenshot are allowed for an app or game please remove unnecessary ${diff} of Screenshot`
            };
        }

        const order = [];
        const dt = new DataTransfer();

        screenshotList.forEach(item => {
            if (item.type === 'existing') {
                order.push({ type: 'existing', key: item.key });
            } else if (item.type === 'new' && item.file) {
                const fileIndex = dt.files.length;
                dt.items.add(item.file);
                order.push({ type: 'new', fileIndex: fileIndex });
            }
        });

        if (screenshotOrderInput) screenshotOrderInput.value = JSON.stringify(order);
        if (dynamicScreenshotsInput) dynamicScreenshotsInput.files = dt.files;

        return { valid: true, count: total };
    }

    // Initial render of gallery
    renderScreenshotGallery();

    // ==========================================
    // MOD NAME LIVE ILLEGAL CHARACTER & EMOJI DETECTOR
    // ==========================================
    const modNameInput = document.getElementById('modName');
    const modNameLiveStatus = document.getElementById('modNameLiveStatus');

    function validateModNameInput(val) {
        if (!val || typeof val !== 'string' || !val.trim()) {
            return { valid: false, error: 'Mod Name is required.' };
        }
        const trimmed = val.trim();
        if (!/[a-zA-Z0-9]/.test(trimmed)) {
            return { valid: false, error: 'Mod Name must contain at least one letter or number.' };
        }
        const emojiRegex = /\p{Extended_Pictographic}|\p{Emoji_Presentation}/u;
        if (emojiRegex.test(trimmed)) {
            return { valid: false, error: 'Emojis are not allowed in Mod Name.' };
        }
        const validModNameRegex = /^[a-zA-Z0-9 :\-&.,+()_\[\]'!/\\%#~;@|?=*"'`]+$/;
        if (!validModNameRegex.test(trimmed)) {
            const illegalChars = Array.from(new Set(trimmed.split('').filter(c => !/[a-zA-Z0-9 :\-&.,+()_\[\]'!/\\%#~;@|?=*"'`]/i.test(c)))).join(' ');
            return { valid: false, error: `Mod Name contains illegal character(s): ${illegalChars}. Emojis and unsupported symbols are not allowed.` };
        }
        return { valid: true };
    }

    function updateModNameLiveFeedback() {
        if (!modNameInput || !modNameLiveStatus) return;
        if (modNameInput.readOnly) {
            modNameLiveStatus.style.display = 'none';
            return;
        }

        const val = modNameInput.value;
        if (!val || !val.trim()) {
            modNameLiveStatus.style.display = 'none';
            modNameInput.style.borderColor = '';
            modNameInput.style.boxShadow = '';
            return;
        }

        const res = validateModNameInput(val);
        if (!res.valid) {
            modNameLiveStatus.style.display = 'block';
            modNameLiveStatus.style.backgroundColor = 'rgba(229, 57, 53, 0.12)';
            modNameLiveStatus.style.border = '1px solid var(--red)';
            modNameLiveStatus.style.color = '#ff6b6b';
            modNameLiveStatus.innerHTML = `<i class="fas fa-exclamation-triangle" style="margin-right: 6px;"></i> ${res.error}`;
            modNameInput.style.borderColor = 'var(--red)';
            modNameInput.style.boxShadow = '0 0 10px rgba(229, 57, 53, 0.4)';
        } else {
            modNameLiveStatus.style.display = 'block';
            modNameLiveStatus.style.backgroundColor = 'rgba(46, 204, 113, 0.1)';
            modNameLiveStatus.style.border = '1px solid #2ecc71';
            modNameLiveStatus.style.color = '#2ecc71';
            modNameLiveStatus.innerHTML = `<i class="fas fa-check-circle" style="margin-right: 6px;"></i> Valid Mod Name`;
            modNameInput.style.borderColor = '#2ecc71';
            modNameInput.style.boxShadow = '0 0 8px rgba(46, 204, 113, 0.3)';
        }
    }

    if (modNameInput) {
        modNameInput.addEventListener('input', updateModNameLiveFeedback);
        if (modNameInput.value) {
            updateModNameLiveFeedback();
        }
    }

    // Video Preview Logic
    function getYouTubeId(url) {
        const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
        const match = url.match(regExp);
        return (match && match[2].length === 11) ? match[2] : null;
    }

    if (videoUrlInput && videoPreviewContainer) {
        const renderVideoPreview = function() {
            const videoId = getYouTubeId(this.value);
            if (videoId) {
                videoPreviewContainer.style.display = 'block'; 
                videoPreviewContainer.innerHTML = `<div class="video-preview-wrapper"><iframe src="https://www.youtube.com/embed/${videoId}" frameborder="0" allowfullscreen></iframe></div>`;
            } else {
                videoPreviewContainer.style.display = 'none'; 
                videoPreviewContainer.innerHTML = '';
            }
        };
        videoUrlInput.addEventListener('input', renderVideoPreview);
        renderVideoPreview.call(videoUrlInput);
    }

    // ==========================================
    // 2. CUSTOM SELECT LOGIC (DYNAMIC)
    // ==========================================
    
    const platformWrapper = document.getElementById('platformWrapper');
    const nativePlatformSelect = document.getElementById('modPlatform');
    const categoryWrapper = document.getElementById('categoryWrapper');
    const nativeCategorySelect = document.getElementById('modCategory');
    const categoryOptionsContainer = document.getElementById('categoryOptionsContainer');
    const ageRatingWrapper = document.getElementById('ageRatingWrapper');
    const nativeAgeRatingSelect = document.getElementById('ageRating');
    const licenseWrapper = document.getElementById('licenseWrapper');
    const nativeLicenseSelect = document.getElementById('modLicense');
    const archWrapper = document.getElementById('archWrapper');
    const archCustomSelect = document.getElementById('archCustomSelect');
    // --- ✅ ADDED FOR FETCH SELECT ---
    const fetchPlatformWrapper = document.getElementById('fetchPlatformWrapper');
    const nativeFetchPlatformSelect = document.getElementById('fetchPlatform');

    function setupCustomSelect(wrapper, nativeSelect) {
        if (!wrapper || !nativeSelect) return;
        
        const customSelect = wrapper.querySelector('.custom-select');
        const selectedText = wrapper.querySelector('.selected-text');
        
        customSelect.addEventListener('click', function(e) {
            if (wrapper.classList.contains('disabled')) return;
            e.stopPropagation();
            
            document.querySelectorAll('.custom-select-wrapper').forEach(w => {
                if (w !== wrapper) w.classList.remove('open');
            });
            
            wrapper.classList.toggle('open');
            this.style.borderColor = '';
            this.style.boxShadow = '';
        });

        const optionsContainer = wrapper.querySelector('.custom-options');
        if (optionsContainer) {
            optionsContainer.addEventListener('click', function(e) {
                if (e.target.classList.contains('custom-option')) {
                    e.stopPropagation();
                    const value = e.target.getAttribute('data-value');
                    const text = e.target.textContent;

                    selectedText.textContent = text;
                    selectedText.style.color = 'var(--white)';
                    nativeSelect.value = value;
                    nativeSelect.dispatchEvent(new Event('change'));

                    wrapper.querySelectorAll('.custom-option').forEach(opt => opt.classList.remove('selected'));
                    e.target.classList.add('selected');
                    wrapper.classList.remove('open');
                }
            });
        }
    }

    if (archCustomSelect && archWrapper) {
        archCustomSelect.addEventListener('click', function(e) {
            e.stopPropagation();
            document.querySelectorAll('.custom-select-wrapper').forEach(w => {
                if (w !== archWrapper) w.classList.remove('open');
            });
            archWrapper.classList.toggle('open');
            this.style.borderColor = '';
            this.style.boxShadow = '';
        });
    }

    setupCustomSelect(platformWrapper, nativePlatformSelect);
    setupCustomSelect(categoryWrapper, nativeCategorySelect);
    setupCustomSelect(ageRatingWrapper, nativeAgeRatingSelect);
    setupCustomSelect(licenseWrapper, nativeLicenseSelect);
    setupCustomSelect(fetchPlatformWrapper, nativeFetchPlatformSelect); // ✅ INIT FETCH DROPDOWN

    if (nativeAgeRatingSelect && ageRatingWrapper) {
        const currentValue = nativeAgeRatingSelect.value;
        if (currentValue) {
            const optionToSelect = ageRatingWrapper.querySelector(`.custom-option[data-value="${currentValue}"]`);
            if (optionToSelect) {
                optionToSelect.classList.add('selected');
                ageRatingWrapper.querySelector('.selected-text').textContent = optionToSelect.textContent;
            }
        }
    }
    if (nativeLicenseSelect && licenseWrapper && nativeLicenseSelect.value) {
        const optionToSelect = licenseWrapper.querySelector(`.custom-option[data-value="${nativeLicenseSelect.value}"]`);
        if (optionToSelect) {
            optionToSelect.classList.add('selected');
            licenseWrapper.querySelector('.selected-text').textContent = optionToSelect.textContent;
        }
    }

    // --- License Dynamic Status & Guide Toggle Logic ---
    function updateLicenseUI() {
        const banner = document.getElementById('licenseStatusBanner');
        const guide = document.getElementById('licenseRecommendationGuide');
        const activeName = document.getElementById('selectedLicenseNameText');
        const toggleBtn = document.getElementById('btnToggleLicenseGuide');
        if (!nativeLicenseSelect || !banner || !guide) return;

        const val = nativeLicenseSelect.value;
        const selectedOption = nativeLicenseSelect.options[nativeLicenseSelect.selectedIndex];
        const text = selectedOption ? selectedOption.text.trim() : '';

        if (val && text && text !== 'None / Proprietary') {
            if (activeName) activeName.textContent = text;
            banner.style.display = 'flex';
            guide.style.display = 'none';
            if (toggleBtn) toggleBtn.textContent = 'Show Guide';
        } else {
            banner.style.display = 'none';
            guide.style.display = 'block';
            if (toggleBtn) toggleBtn.textContent = 'Hide Guide';
        }
    }

    if (nativeLicenseSelect) {
        nativeLicenseSelect.addEventListener('change', updateLicenseUI);
        updateLicenseUI();
    }

    const toggleLicenseGuideBtn = document.getElementById('btnToggleLicenseGuide');
    if (toggleLicenseGuideBtn) {
        toggleLicenseGuideBtn.addEventListener('click', function() {
            const guide = document.getElementById('licenseRecommendationGuide');
            if (!guide) return;
            if (guide.style.display === 'none') {
                guide.style.display = 'block';
                this.textContent = 'Hide Guide';
            } else {
                guide.style.display = 'none';
                this.textContent = 'Show Guide';
            }
        });
    }

    document.addEventListener('click', function() {
        document.querySelectorAll('.custom-select-wrapper').forEach(wrapper => {
            wrapper.classList.remove('open');
        });
    });

    // --- Live Variant Detection & Manual Checkbox Handling ---
    const variantGroup = document.getElementById('variant-group');
    const variantInfoText = document.getElementById('variant-info-text');
    const isVariantCheckbox = document.getElementById('isVariantCheckbox');
    const detectedMasterId = document.getElementById('detectedMasterId');
    const variantDetectionSubmitted = document.getElementById('variantDetectionSubmitted');
    let variantCheckTimer = null;
    let cachedMasterFile = null;
    let cachedCurrentUpload = null;

    function getVariantLiveUploadType(currentUpload) {
        const isMultiPartActive = isMultiPartHidden && isMultiPartHidden.value === 'true';
        const extInput = document.getElementById('externalDownloadUrl');
        if (isMultiPartActive) return 'multipart';
        if (extInput && extInput.value.trim()) return 'external';
        if (currentUpload && currentUpload.uploadType) return currentUpload.uploadType;
        return '<%= (file.fileKey === "external-link") ? "external" : (file.isMultiPart ? "multipart" : "cloud") %>';
    }

    function updateVariantFieldRequirements(isVariantActive) {
        const devInput = document.getElementById('developerName');
        const catSelect = document.getElementById('modCategory');
        const ageSelect = document.getElementById('ageRating');
        if (devInput) {
            if (isVariantActive) devInput.removeAttribute('required');
            else devInput.setAttribute('required', 'required');
        }
        if (catSelect) {
            if (isVariantActive) catSelect.removeAttribute('required');
            else catSelect.setAttribute('required', 'required');
        }
        if (ageSelect) {
            if (isVariantActive) ageSelect.removeAttribute('required');
            else ageSelect.setAttribute('required', 'required');
        }
    }

    function renderVariantBanner(master, currentUpload) {
        if (!variantInfoText || !master) return;
        const statusColor = master.status === 'live' ? '#2ecc71' : (master.status === 'pending' ? '#f59e0b' : '#38bdf8');
        const uploadTypeBadge = (type) => {
            if (type === 'multipart') return '<span style="background: rgba(236,72,153,0.2); color: #f472b6; border: 1px solid rgba(236,72,153,0.4); padding: 2px 7px; border-radius: 4px; font-size: 0.8em; font-weight: 600;"><i class="fas fa-layer-group"></i> Multi-Part Download</span>';
            if (type === 'external') return '<span style="background: rgba(14,165,233,0.2); color: #38bdf8; border: 1px solid rgba(14,165,233,0.4); padding: 2px 7px; border-radius: 4px; font-size: 0.8em; font-weight: 600;"><i class="fas fa-external-link-alt"></i> External Link</span>';
            return '<span style="background: rgba(34,197,94,0.2); color: #4ade80; border: 1px solid rgba(34,197,94,0.4); padding: 2px 7px; border-radius: 4px; font-size: 0.8em; font-weight: 600;"><i class="fas fa-cloud"></i> Direct Cloud Storage</span>';
        };

        const variantUploadType = getVariantLiveUploadType(currentUpload);
        const currentPlatform = nativePlatformSelect && nativePlatformSelect.value ? nativePlatformSelect.value : '';
        const isCrossPlatform = currentPlatform && master.category && currentPlatform !== master.category;

        variantInfoText.innerHTML = `
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
                    <span>Found existing master mod: <strong>"${master.name}"</strong></span>
                    <span style="background: rgba(255,215,0,0.15); color: #ffd700; border: 1px solid rgba(255,215,0,0.4); font-size: 0.78em; padding: 2px 7px; border-radius: 4px; text-transform: uppercase; font-weight: bold;">
                        ${master.category || 'all'}
                    </span>
                    <span style="background: rgba(255,255,255,0.08); color: ${statusColor}; border: 1px solid ${statusColor}; font-size: 0.78em; padding: 2px 7px; border-radius: 4px; text-transform: uppercase; font-weight: 700;">
                        Master Status: ${master.status}
                    </span>
                    <span style="color: var(--silver); font-size: 0.85em;">(v${master.version}, by @${master.uploader})</span>
                </div>
                <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 12px; font-size: 0.88em; color: #cbd5e1;">
                    <span>Master File: ${uploadTypeBadge(master.uploadType)}</span>
                    <span>Variant File: ${uploadTypeBadge(variantUploadType)}</span>
                    ${currentUpload && currentUpload.status ? `<span style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.35); font-size: 0.78em; padding: 1px 6px; border-radius: 4px;">Variant Status: ${currentUpload.status}</span>` : ''}
                </div>
                ${isCrossPlatform ? `<div style="font-size: 0.82em; color: #fde68a;"><i class="fas fa-arrows-split-up-and-left"></i> <strong>Cross-Platform Variant:</strong> Master platform is <strong>${master.category}</strong>; this variant is being published for <strong>${currentPlatform}</strong>.</div>` : ''}
                <div style="background: rgba(168, 85, 247, 0.12); border: 1px dashed rgba(168, 85, 247, 0.45); padding: 8px 12px; border-radius: 6px; font-size: 0.85em; color: #e9d5ff; line-height: 1.5;">
                    <i class="fas fa-magic" style="color: #c084fc; margin-right: 6px;"></i>
                    <strong>Variant Mode Active:</strong> All metadata fields below (description, features, screenshots, age rating, developer) are <strong>optional</strong>. If left empty, they will automatically inherit from the master mod!
                </div>
            </div>
        `;
        updateVariantFieldRequirements(true);
    }

    async function checkVariantMatch() {
        if (!variantGroup || !modNameInput) return;
        const name = (modNameInput.value || '').trim();
        const platform = (nativePlatformSelect && nativePlatformSelect.value ? nativePlatformSelect.value : '').trim();

        if (!name || name.length < 2) {
            variantGroup.style.display = 'none';
            if (variantDetectionSubmitted) variantDetectionSubmitted.value = '0';
            if (detectedMasterId) detectedMasterId.value = '';
            cachedMasterFile = null;
            cachedCurrentUpload = null;
            updateVariantFieldRequirements(false);
            return;
        }

        try {
            const currentFileId = '<%= fileId %>';
            const url = `/api/check-mod-exists?name=${encodeURIComponent(name)}&platform=${encodeURIComponent(platform)}&currentId=${encodeURIComponent(currentFileId)}`;
            const res = await fetch(url);
            if (!res.ok) return;
            const data = await res.json();

            if (data.exists && data.masterFile) {
                cachedMasterFile = data.masterFile;
                cachedCurrentUpload = data.currentUpload;
                variantGroup.style.display = 'block';
                if (variantDetectionSubmitted) variantDetectionSubmitted.value = '1';
                if (detectedMasterId) detectedMasterId.value = data.masterFile._id;
                if (isVariantCheckbox) isVariantCheckbox.checked = true;
                renderVariantBanner(data.masterFile, data.currentUpload);
            } else {
                cachedMasterFile = null;
                cachedCurrentUpload = null;
                variantGroup.style.display = 'none';
                if (variantDetectionSubmitted) variantDetectionSubmitted.value = '0';
                if (detectedMasterId) detectedMasterId.value = '';
                if (isVariantCheckbox) isVariantCheckbox.checked = false;
                updateVariantFieldRequirements(false);
            }
        } catch (err) {
            console.error('Error checking variant match:', err);
        }
    }

    function scheduleVariantCheck() {
        clearTimeout(variantCheckTimer);
        variantCheckTimer = setTimeout(checkVariantMatch, 350);
    }

    if (modNameInput) {
        modNameInput.addEventListener('input', scheduleVariantCheck);
    }
    if (nativePlatformSelect) {
        nativePlatformSelect.addEventListener('change', scheduleVariantCheck);
    }
    if (isVariantCheckbox) {
        isVariantCheckbox.addEventListener('change', function() {
