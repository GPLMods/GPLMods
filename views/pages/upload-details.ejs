<%- include('../partials/header') %>

<!-- ✅ DOWNGRADED TO QUILL V1.3.7 FOR STABILITY -->
<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.7/quill.js"></script>

<style>
    /* Your custom theme styles are now integrated */
    :root {
        --black: #0a0a0a;
        --dark-gray: #1a1a1a;
        --white: #ffffff;
        --gold: #FFD700;
        --silver: #c0c0c0;
        --glow-gold: rgba(255, 215, 0, 0.5);
        --red: #e53935;
    }
    /* General body and container styles */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Poppins', sans-serif; background-color: var(--black); color: var(--white); line-height: 1.6; }
    .container { width: 90%; max-width: 1200px; margin: auto; padding: 20px 0; }

    /* Main form container */
    .upload-form-container {
        background-color: var(--dark-gray);
        padding: 30px;
        border-radius: 15px;
        max-width: 800px;
        margin: 2rem auto;
        border: 1px solid #333;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    /* Form Header Text */
    .upload-form-container h2 {
        text-align: center;
        font-size: 2.5em;
        margin-bottom: 1rem;
    }
    .upload-form-container h2 span {
        color: var(--gold);
        text-shadow: 0 0 15px var(--glow-gold);
    }
    .upload-form-container p {
        text-align: center;
        font-size: 1.1em;
        color: var(--silver);
        margin-bottom: 2rem;
    }
    
    /* Fieldset and Legend for Structure */
    .form-section {
        border: 1px solid #333;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 30px;
    }
    .form-section legend {
        padding: 0 10px;
        margin-left: 15px;
        font-size: 1.3em;
        font-weight: 600;
        color: var(--gold);
    }

    /* Form Groups and Inputs */
    .form-group {
        margin-bottom: 25px;
        position: relative; /* Essential for custom dropdowns */
    }
    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: var(--silver);
    }
    .form-group input[type="text"],
    .form-group input[type="url"],
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 12px 15px;
        border-radius: 8px;
        border: 1px solid #333;
        background-color: var(--black);
        color: var(--white);
        font-size: 1em;
        font-family: 'Poppins', sans-serif;
        transition: all 0.3s ease;
    }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
        outline: none;
        border-color: var(--gold);
        box-shadow: 0 0 10px var(--glow-gold);
    }
    .form-group textarea {
        min-height: 120px;
        resize: vertical;
    }

    /* --- CUSTOM SELECT DROPDOWN CSS --- */
    .custom-select-wrapper {
        position: relative;
        user-select: none;
        width: 100%;
    }
    .custom-select {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px;
        background-color: var(--black);
        border: 1px solid #333;
        border-radius: 8px;
        cursor: pointer;
        color: var(--silver);
        font-size: 1em;
        transition: all 0.3s ease;
    }
    /* When the dropdown is open */
    .custom-select-wrapper.open .custom-select {
        border-color: var(--gold);
        box-shadow: 0 0 10px var(--glow-gold);
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
    }
    .custom-select-wrapper.open .custom-select-arrow {
        transform: rotate(180deg);
        color: var(--gold);
    }
    /* The dropdown menu */
    .custom-options {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: var(--dark-gray);
        border: 1px solid var(--gold);
        border-top: none;
        border-radius: 0 0 8px 8px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.5);
        z-index: 100;
        display: none; /* Hidden by default */
        max-height: 250px;
        overflow-y: auto;
    }
    .custom-select-wrapper.open .custom-options {
        display: block; /* Shown when open */
    }
    .custom-option {
        padding: 12px 15px;
        cursor: pointer;
        color: var(--white);
        transition: background-color 0.2s;
        border-bottom: 1px solid #2a2a2a;
    }
    .custom-option:last-child { border-bottom: none; }
    .custom-option:hover { background-color: var(--black); color: var(--gold); }
    .custom-option.selected { background-color: var(--black); color: var(--gold); font-weight: bold; }
    /* Disabled state for custom select */
    .custom-select-wrapper.disabled .custom-select {
        opacity: 0.5;
        cursor: not-allowed;
        background-color: #111;
    }
    .custom-select-wrapper.disabled .custom-options {
        display: none !important;
    }
    /* ------------------------------------------- */

    /* Icon Preview Section */
    .icon-upload-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 30px;
        padding: 20px;
        border: 2px dashed #333;
        border-radius: 15px;
        background-color: rgba(0,0,0,0.2);
    }
    .icon-preview {
        width: 100px;
        height: 100px;
        background-color: var(--black);
        border-radius: 20px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--gold);
        overflow: hidden;
    }
    .icon-preview img {
        width: 100%;
        height: 100%;
        object-fit: contain; 
        display: none;
    }
    .icon-preview span {
        color: #444;
        font-size: 0.8em;
        text-align: center;
    }

    /* Custom File Input Styles */
    .file-input-wrapper {
        position: relative;
        display: block;
        width: 100%;
    }
    input[type="file"] {
        display: none;
    }
    .file-input-label {
        display: block;
        padding: 12px 20px;
        background: transparent;
        color: var(--gold);
        border: 2px solid var(--gold);
        border-radius: 8px;
        cursor: pointer;
        text-align: center;
        font-size: 1em;
        transition: all 0.3s ease;
    }
    .file-input-label:hover {
        background: var(--gold);
        color: var(--black);
        box-shadow: 0 0 15px var(--glow-gold);
    }
    .file-name {
        display: block;
        margin-top: 10px;
        color: var(--silver);
        font-size: 0.9em;
        text-align: center;
    }

    /* Screenshot & Video Previews */
    .preview-container {
        margin-top: 15px;
        background-color: var(--black);
        padding: 15px;
        border: 1px solid #333;
        border-radius: 8px;
        display: none; 
    }
    #screenshotPreviewContainer {
        column-count: 2;
        column-gap: 15px;
    }
    #screenshotPreviewContainer img {
        width: 100%;
        height: auto;
        border-radius: 8px;
        margin-bottom: 15px;
        break-inside: avoid; 
        display: block;
        box-shadow: 0 4px 6px rgba(0,0,0,0.3);
    }
    .video-preview-wrapper {
        position: relative;
        padding-bottom: 56.25%; /* 16:9 */
        height: 0;
        overflow: hidden;
        border-radius: 4px;
        width: 100%;
    }
    .video-preview-wrapper iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .button-group {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }
    
    .draft-button {
        background: transparent;
        color: var(--silver);
        border: 2px solid #555;
        padding: 15px 20px;
        border-radius: 8px;
        font-size: 1.1em;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        flex: 1; 
    }
    .draft-button:hover {
        border-color: var(--gold);
        color: var(--gold);
    }
    /* Submit Button */
    .submit-button {
        display: block;
        width: 100%;
        background: var(--gold);
        color: var(--black);
        padding: 15px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 1.2em;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 0 15px var(--glow-gold);
        margin-top: 0;
        flex: 2;
    }
    .submit-button:hover {
        opacity: 0.9;
        transform: translateY(-2px);
    }

    /* Force Quill Editors to be responsive */
    .ql-toolbar, .ql-container {
        max-width: 100% !important;
        box-sizing: border-box !important;
    }
    .ql-editor {
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
        word-break: break-word !important;
        max-width: 100% !important;
        padding: 12px 10px !important; 
    }
    .upload-form-container {
        max-width: 100%;
        overflow-x: hidden;
    }

    /* ✅ UPDATED: Custom styles for Quill v1.3.7 */
    .ql-toolbar.ql-snow {
        background-color: #333;
        border-color: #444;
        border-radius: 8px 8px 0 0;
    }
    .ql-container.ql-snow {
        background-color: var(--black);
        border-color: #444;
        border-radius: 0 0 8px 8px;
        color: var(--white);
        font-family: 'Poppins', sans-serif;
        font-size: 1em;
        min-height: 250px; 
    }
    .ql-editor.ql-blank::before { color: #888; font-style: normal; }
    /* Fix toolbar icons colors */
    .ql-snow .ql-stroke { stroke: var(--silver) !important; }
    .ql-snow .ql-fill { fill: var(--silver) !important; }
    .ql-snow .ql-picker { color: var(--silver) !important; }
    .ql-snow .ql-picker-options { background-color: var(--dark-gray); border-color: #444; }
    .ql-snow .ql-picker-item { color: var(--white); }
    .ql-snow .ql-picker-item:hover { color: var(--gold); }
    .ql-snow.ql-toolbar button:hover .ql-stroke, 
    .ql-snow .ql-toolbar button:hover .ql-stroke, 
    .ql-snow.ql-toolbar button.ql-active .ql-stroke, 
    .ql-snow .ql-toolbar button.ql-active .ql-stroke { stroke: var(--gold) !important; }
    .ql-snow.ql-toolbar button:hover .ql-fill, 
    .ql-snow .ql-toolbar button:hover .ql-fill, 
    .ql-snow.ql-toolbar button.ql-active .ql-fill, 
    .ql-snow .ql-toolbar button.ql-active .ql-fill { fill: var(--gold) !important; }

    /* --- NEW: Smart Template Dropdown Styles --- */
    .template-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--dark-gray);
        border: 1px solid var(--gold);
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        z-index: 100;
        display: none; /* Hidden by default */
        overflow: hidden;
        margin-top: 5px;
    }
    .template-option {
        padding: 12px 15px;
        cursor: pointer;
        border-bottom: 1px solid #333;
        transition: background 0.2s;
    }
    .template-option:last-child { border-bottom: none; }
    .template-option:hover { background: #222; }
    .template-option-title { color: var(--gold); font-weight: bold; display: block; margin-bottom: 4px; }
    .template-option-preview { color: var(--silver); font-size: 0.85em; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    
    .template-helper-btn {
        float: right;
        background: rgba(255, 215, 0, 0.1);
        color: var(--gold);
        border: 1px solid var(--gold);
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 0.8em;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        user-select: none;
    }
    .template-helper-btn:hover { background: var(--gold); color: var(--black); }
</style>

<div class="container">
    <div class="upload-form-container">
        <h2>Upload Your Mod <span>- Details</span></h2>
        <p>Step 2 of 2: Your file <strong><%= filename %></strong> is ready. Please provide the details below.</p>

        <div id="status-alert-box" class="alert-msg" style="display: none; width: 100%; max-width: 800px; margin: 0 auto 20px auto;"></div>

        <form action="/upload-finalize/<%= fileId %>" method="POST" enctype="multipart/form-data" id="mainUploadForm">
            <!-- HIDDEN INPUTS -->
            <input type="hidden" name="fileKey" value="<%= fileKey %>">
            <input type="hidden" name="originalFilename" value="<%= filename %>">
            <input type="hidden" name="fileSize" value="<%= filesize %>">

            <fieldset class="form-section">
                <legend>Core Details</legend>

                <div class="icon-upload-container">
                    <label>Mod Icon*</label>
                    <div class="icon-preview" id="iconPreviewBox">
                        <img id="iconImage" src="" alt="Icon Preview" style="display:none;">
                        <span id="iconPlaceholder">Preview</span>
                    </div>
                    <div style="max-width: 250px;">
                        <input type="file" id="modIcon" name="softwareIcon" accept="image/*">
                        <label for="modIcon" class="file-input-label">Choose Icon</label>
                    </div>
                </div>

                <div style="background: rgba(33, 150, 243, 0.1); border: 1px solid var(--blue); padding: 20px; border-radius: 8px; margin-bottom: 25px;">
                    <h4 style="color: var(--blue); margin-bottom: 15px;"><i class="fas fa-magic"></i> Auto-Fetch App Details</h4>
                    <p style="color: var(--silver); font-size: 0.9em; margin-bottom: 15px;">Paste the official store link to automatically fill the description, developer, OS, and Age requirements below!</p>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <div style="width: 160px; z-index: 10;">
                            <select id="fetchPlatform" style="display: none;">
                                <option value="playstore" selected>Play Store</option>
                                <option value="appstore">App Store</option>
                                <option value="steam">Steam</option>
                                <option value="epic">Epic Games</option>
                                <option value="wordpress">WordPress</option>
                            </select>
                            <div class="custom-select-wrapper" id="fetchPlatformWrapper">
                                <div class="custom-select" style="padding: 10px; height: 45px;">
                                    <span class="selected-text" style="color: var(--white);">Play Store</span>
                                    <i class="fas fa-chevron-down custom-select-arrow" style="font-size: 0.8em;"></i>
                                </div>
                                <div class="custom-options">
                                    <div class="custom-option selected" data-value="playstore">Play Store</div>
                                    <div class="custom-option" data-value="appstore">App Store</div>
                                    <div class="custom-option" data-value="steam">Steam</div>
                                    <div class="custom-option" data-value="epic">Epic Games</div>
                                    <div class="custom-option" data-value="wordpress">WordPress</div>
                                </div>
                            </div>
                        </div>
                        <input type="url" id="fetchUrl" placeholder="https://play.google.com/store/apps/details?id=..." style="flex-grow: 1; padding: 10px; height: 45px; border-radius: 8px; background: var(--black); color: white; border: 1px solid #333; outline: none;">
                        <button type="button" id="fetchBtn" class="btn btn-primary" style="background: var(--blue); color: white; border: none; border-radius: 8px; height: 45px; padding: 0 20px; font-weight: bold; cursor: pointer;">Fetch Data</button>
                    </div>
                    <span id="fetchStatus" style="display: block; margin-top: 10px; font-size: 0.85em; font-weight: bold;"></span>
                </div>

                <div class="form-group">
                    <label for="modName">Mod Name*</label>
                    <input type="text" id="modName" name="modName" value="<%= defaultName %>" placeholder="e.g., Roblox or Minecraft" required autocomplete="off">
                </div>

                <div class="form-group">
                    <label for="ageRating">Age Rating*</label>
                    <select id="ageRating" name="ageRating" required style="display: none;">
                        <option value="NA" <%= (typeof file !== 'undefined' && file.ageRating === 'NA') ? 'selected' : '' %>>Not Rated (N/A)</option>
                        <option value="3+" <%= (typeof file !== 'undefined' && file.ageRating === '3+') ? 'selected' : '' %>>3+ (Everyone)</option>
                        <option value="7+" <%= (typeof file !== 'undefined' && file.ageRating === '7+') ? 'selected' : '' %>>7+ (Low Violence)</option>
                        <option value="12+" <%= (typeof file !== 'undefined' && file.ageRating === '12+') ? 'selected' : '' %>>12+ (Moderate Violence)</option>
                        <option value="16+" <%= (typeof file !== 'undefined' && file.ageRating === '16+') ? 'selected' : '' %>>16+ (Strong Violence)</option>
                        <option value="18+" <%= (typeof file !== 'undefined' && file.ageRating === '18+') ? 'selected' : '' %>>18+ (Adults Only)</option>
                    </select>
                    <div class="custom-select-wrapper" id="ageRatingWrapper">
                        <div class="custom-select">
                            <span class="selected-text">Not Rated (N/A)</span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options">
                            <div class="custom-option" data-value="NA">Not Rated (N/A)</div>
                            <div class="custom-option" data-value="3+">3+ (Everyone)</div>
                            <div class="custom-option" data-value="7+">7+ (Low Violence)</div>
                            <div class="custom-option" data-value="12+">12+ (Moderate Violence)</div>
                            <div class="custom-option" data-value="16+">16+ (Strong Violence)</div>
                            <div class="custom-option" data-value="18+">18+ (Adults Only)</div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="modVersion">Mod Version*</label>
                    <input type="text" id="modVersion" name="modVersion" value="<%= defaultVersion %>" placeholder="e.g., 1.26.1.1" autocomplete="off">
                </div>

                <div class="form-group">
                    <label for="developerName">Official Developer / Company*</label>
                    <input type="text" id="developerName" name="developerName" value="<%= file && file.developer && file.developer !== 'N/A' ? file.developer : '' %>" placeholder="e.g., Supercell or Mojang" autocomplete="off" required>
                </div>

                <div class="form-group">
                    <label>Platform*</label>
                    <select id="modPlatform" name="modPlatform" style="display: none;">
                        <option value="" disabled selected>Select a platform...</option>
                        <option value="android">Android</option>
                        <option value="ios-jailed">iOS - Jailed (IPA)</option>
                        <option value="ios-jailbroken">iOS - Jailbroken (DEB)</option>
                        <option value="windows">Windows</option>
                        <option value="wordpress">WordPress</option>
                    </select>
                    <div class="custom-select-wrapper" id="platformWrapper">
                        <div class="custom-select">
                            <span class="selected-text">Select a platform...</span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options">
                            <div class="custom-option" data-value="android">Android</div>
                            <div class="custom-option" data-value="ios-jailed">iOS - Jailed (IPA)</div>
                            <div class="custom-option" data-value="ios-jailbroken">iOS - Jailbroken (DEB)</div>
                            <div class="custom-option" data-value="windows">Windows</div>
                            <div class="custom-option" data-value="wordpress">WordPress</div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="minOsVersion">Minimum Required OS Version <span id="os-req-star" style="color: var(--red); display: none;">*</span></label>
                    <input type="text" id="minOsVersion" name="minOsVersion" value="<%= file && file.minOsVersion ? file.minOsVersion : '' %>" placeholder="e.g., iOS 14.0, Android 8.0, Windows 10">
                    <div style="font-size: 0.82em; color: var(--silver); margin-top: 6px;">This field is required for submission on supported platforms, especially iOS and Android releases.</div>
                </div>

                <div class="form-group">
                    <label for="modLicense">Software License (Optional)</label>
                    <select id="modLicense" name="modLicense" style="display: none;">
                        <option value="">None / Proprietary</option>
                        <% if (typeof licenses !== 'undefined') { licenses.forEach(license => { %>
                            <option value="<%= license._id %>"><%= license.name %></option>
                        <% }) } %>
                    </select>
                    <div class="custom-select-wrapper" id="licenseWrapper">
                        <div class="custom-select">
                            <span class="selected-text">None / Proprietary</span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options">
                            <div class="custom-option selected" data-value="">None / Proprietary</div>
                            <% if (typeof licenses !== 'undefined') { licenses.forEach(license => { %>
                                <div class="custom-option" data-value="<%= license._id %>"><%= license.name %></div>
                            <% }) } %>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Category*</label>
                    <select id="modCategory" name="modCategory" required disabled style="display: none;">
                        <option value="" disabled selected>Select a platform first...</option>
                    </select>
                    <div class="custom-select-wrapper disabled" id="categoryWrapper">
                        <div class="custom-select">
                            <span class="selected-text">Select a platform first...</span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options" id="categoryOptionsContainer"></div>
                    </div>
                </div>

                <div class="form-group" id="arch-group" style="display: none; background: rgba(255, 215, 0, 0.05); padding: 20px; border-radius: 8px; border: 1px solid #333; margin-top: 15px;">
                    <label style="color: var(--gold);"><i class="fas fa-microchip"></i> Architecture Support <span id="arch-req-star" style="color: var(--red); display: none;">*</span></label>
                    <p style="font-size: 0.85em; color: var(--silver); margin-bottom: 10px;">Select all hardware architectures this file supports.</p>
                    <div class="custom-select-wrapper" id="archWrapper">
                        <div class="custom-select" id="archCustomSelect">
                            <span class="selected-text" id="archSelectedText">Select architectures...</span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options" id="archOptionsContainer">
                            <!-- Multi-select checkboxes will be dynamically populated here -->
                        </div>
                    </div>
                </div>
            </fieldset>
            
            <fieldset class="form-section">
                <legend>Descriptions</legend>

                <!-- ======== AUTO-FETCH METADATA UI ======== -->
                <div style="background: rgba(33, 150, 243, 0.1); border: 1px solid var(--blue); padding: 20px; border-radius: 8px; margin-bottom: 25px;">
                    <h4 style="color: var(--blue); margin-bottom: 15px;"><i class="fas fa-magic"></i> Auto-Fetch App Details</h4>
                    <p style="color: var(--silver); font-size: 0.9em; margin-bottom: 15px;">Paste the official store link to automatically fill the description, developer, OS, and Age requirements below!</p>
                    
                    <!-- ✅ UPDATED: Fetch Platform now uses custom-select -->
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <div style="width: 160px; z-index: 10;">
                            <select id="fetchPlatform" style="display: none;">
                                <option value="playstore" selected>Play Store</option>
                                <option value="appstore">App Store</option>
                                <option value="steam">Steam</option>
                                <option value="epic">Epic Games</option>
                                <option value="wordpress">WordPress</option>
                            </select>
                            <div class="custom-select-wrapper" id="fetchPlatformWrapper">
                                <div class="custom-select" style="padding: 10px; height: 45px;">
                                    <span class="selected-text" style="color: var(--white);">Play Store</span>
                                    <i class="fas fa-chevron-down custom-select-arrow" style="font-size: 0.8em;"></i>
                                </div>
                                <div class="custom-options">
                                    <div class="custom-option selected" data-value="playstore">Play Store</div>
                                    <div class="custom-option" data-value="appstore">App Store</div>
                                    <div class="custom-option" data-value="steam">Steam</div>
                                    <div class="custom-option" data-value="epic">Epic Games</div>
                                    <div class="custom-option" data-value="wordpress">WordPress</div>
                                </div>
                            </div>
                        </div>

                        <input type="url" id="fetchUrl" placeholder="https://play.google.com/store/apps/details?id=..." style="flex-grow: 1; padding: 10px; height: 45px; border-radius: 8px; background: var(--black); color: white; border: 1px solid #333; outline: none;">
                        <button type="button" id="fetchBtn" class="btn btn-primary" style="background: var(--blue); color: white; border: none; border-radius: 8px; height: 45px; padding: 0 20px; font-weight: bold; cursor: pointer;">Fetch Data</button>
                    </div>
                    <span id="fetchStatus" style="display: block; margin-top: 10px; font-size: 0.85em; font-weight: bold;"></span>
                </div>
                <!-- ============================================= -->

                <div class="form-group" style="position: relative;">
                    <label for="modDescription">
                        Mod Description* 
                        <span class="template-helper-btn" data-target="modDescription">💡 Use Template</span>
                    </label>
                    <textarea id="modDescription" name="modDescription" style="display:none;"><%- file && file.modDescription ? file.modDescription : '' %></textarea>
                    <div id="editor-modDescription"><%- file && file.modDescription ? file.modDescription : '' %></div>
                    <div id="dropdown-modDescription" class="template-dropdown"></div>
                </div>

                <div class="form-group" style="position: relative;">
                    <label for="modFeatures">
                        Mod Features* (One per line)
                        <span class="template-helper-btn" data-target="modFeatures">💡 Use Template</span>
                    </label>
                    <textarea id="modFeatures" name="modFeatures" style="display:none;"><%- file && file.modFeatures ? file.modFeatures : '' %></textarea>
                    <div id="editor-modFeatures"><%- file && file.modFeatures ? file.modFeatures : '' %></div>
                    <div id="dropdown-modFeatures" class="template-dropdown"></div>
                </div>

                <div class="form-group">
                    <label for="officialDescription">Official Description*</label>
                    <textarea id="officialDescription" name="officialDescription" style="display:none;"><%- file && file.officialDescription ? file.officialDescription : '' %></textarea>
                    <div id="editor-officialDescription"><%- file && file.officialDescription ? file.officialDescription : '' %></div>
                </div>

                 <div class="form-group" style="position: relative;">
                    <label for="importantNote">
                        Important Note / Installation Instructions (Optional)
                        <span class="template-helper-btn" data-target="importantNote">💡 Use Template</span>
                    </label>
                    <textarea id="importantNote" name="importantNote" style="display:none;"><%- file && file.importantNote ? file.importantNote : '' %></textarea>
                    <div id="editor-importantNote"><%- file && file.importantNote ? file.importantNote : '' %></div>
                    <div id="dropdown-importantNote" class="template-dropdown"></div>
                </div>
                
                <div class="form-group">
                    <label for="whatsNew">What's New (Optional)</label>
                    <textarea id="whatsNew" name="whatsNew" style="display:none;"><%- file && file.whatsNew ? file.whatsNew : '' %></textarea>
                    <div id="editor-whatsNew"><%- file && file.whatsNew ? file.whatsNew : '' %></div>
                </div>
            </fieldset>

                <!-- ======== DIRECT CLOUD LINK ======== -->
                <div class="form-group" id="direct-link-group" style="background: rgba(0, 122, 255, 0.1); padding: 20px; border-radius: 8px; border: 1px solid #007AFF; margin-bottom: 25px;">
                    <label for="directDownloadUrl" style="color: var(--white);"><i class="fas fa-link"></i> Direct Cloud Link (Dropbox, etc.) <span style="color: var(--gold); font-size: 0.8em; font-weight: normal;">Optional</span></label>
                    <input type="url" id="directDownloadUrl" name="directDownloadUrl" placeholder="e.g., https://www.dropbox.com/s/.../app.zip?dl=1" value="<%= typeof file !== 'undefined' ? file.directDownloadUrl : '' %>">
                    <span style="font-size: 0.85em; color: var(--silver); display: block; margin-top: 5px;">A direct streamable link. Enables 1-Click repo installs for iOS/Android, and acts as a fast mirror for all platforms.</span>
                </div>
                <!-- ======================================================== -->
                <!-- ======== JAILBREAK PACKAGE ID ======== -->
                <div class="form-group" id="pkg-id-group" style="display: none; background: rgba(255, 149, 0, 0.1); padding: 20px; border-radius: 8px; border: 1px solid #FF9500; margin-bottom: 25px;">
                    <label for="iosPackageId" style="color: var(--white);"><i class="fas fa-box-open"></i> Jailbreak Package ID <span style="color: var(--gold); font-size: 0.8em; font-weight: normal;">Optional</span></label>
                    <input type="text" id="iosPackageId" name="iosPackageId" placeholder="e.g., com.spark.snowboard">
                    <span style="font-size: 0.85em; color: var(--silver); display: block; margin-top: 5px;">Required to enable direct Sileo/Zebra package installation buttons. Must exactly match the ID in your control file.</span>
                </div>
                <!-- =========================================== -->

            <!-- LINKS & PARTS MANAGEMENT (DISTRIBUTORS/ADMINS - Only for External Link/Multi-part uploads) -->
            <% if (user && (user.role === 'distributor' || user.role === 'admin') && (file.fileKey === 'external-link' || file.externalDownloadUrl || file.isMultiPart)) { %>
                <fieldset class="form-section">
                    <legend>Links & Parts Management</legend>

                    <div style="display:flex; gap:10px; margin-bottom:15px;">
                        <button type="button" id="btn-single-link" class="btn btn-primary" style="flex:1; padding:10px;">Single External Link</button>
                        <button type="button" id="btn-multi-part" class="btn btn-secondary" style="flex:1; padding:10px;">Multi-Part Download</button>
                    </div>

                    <input type="hidden" id="isMultiPartHidden" name="isMultiPart" value="<%= file.isMultiPart ? 'true' : 'false' %>">

                    <div id="single-link-container" style="display: <%= file.isMultiPart ? 'none' : 'block' %>">
                        <div class="form-group">
                            <label for="externalDownloadUrl">Main External URL*</label>
                            <input type="url" id="externalDownloadUrl" name="externalDownloadUrl" value="<%= file.externalDownloadUrl || '' %>" class="link-req-single" placeholder="https://linkvertise.com/...">
                        </div>

                        <div style="margin-top:10px; border-top:1px solid #333; padding-top:10px;">
                            <p style="color:var(--silver); margin-bottom:8px; font-weight:600;">Admin & Safety Overrides</p>
                            <div class="form-group" id="manualFileScanGroup" style="display: <%= (typeof file !== 'undefined' && file.fileSize && file.fileSize > 640 * 1024 * 1024) ? 'block' : 'none' %>;">
                                <label for="manualFileScanUrl">Manual File Scan URL <span style="color: var(--gold); font-size: 0.8em; font-weight: normal;">Required for files over 640MB</span></label>
                                <input type="url" id="manualFileScanUrl" name="manualFileScanUrl" value="<%= file.manualFileScanUrl || '' %>" placeholder="Manual File Scan URL">
                            </div>
                            <div class="form-group" id="manualSiteScanGroup" style="display: <%= (typeof file !== 'undefined' && file.directDownloadUrl) ? 'block' : 'none' %>;">
                                <label for="manualSiteScanUrl">Manual Site Scan URL <span style="color: var(--gold); font-size: 0.8em; font-weight: normal;">Only shown when a direct link is provided</span></label>
                                <input type="url" id="manualSiteScanUrl" name="manualSiteScanUrl" value="<%= file.manualSiteScanUrl || '' %>" placeholder="Manual Site Scan URL">
                            </div>
                        </div>
                    </div>

                    <div id="multi-part-container" style="display: <%= file.isMultiPart ? 'block' : 'none' %>">
                        <div id="parts-wrapper">
                            <!-- Parts will be injected by JS -->
                        </div>
                        <div style="display:flex; gap:8px;">
                            <button type="button" id="add-part-btn" class="btn btn-secondary" style="padding:8px 12px;">+ Add New Part</button>
                        </div>
                    </div>
                </fieldset>
            <% } %>

            <fieldset class="form-section">
                <legend>Media & Metadata</legend>
                <div class="form-group">
                    <label for="tags">Tags (Optional, comma-separated)</label>
                    <input type="text" id="tags" name="tags" value="<%= file && file.tags ? file.tags.join(', ') : '' %>" placeholder="strategy, multiplayer, offline" autocomplete="off">
                </div>

                <div class="form-group">
                    <label>Mod Screenshots* (1-4 images)</label>
                    <div class="file-input-wrapper">
                        <input type="file" id="screenshots" name="screenshots" accept="image/png, image/jpeg" multiple>
                        <label for="screenshots" class="file-input-label">Choose Screenshots</label>
                        <span class="file-name" id="screenshotFileName">No files selected</span>
                    </div>
                    <div class="preview-container" id="screenshotPreviewContainer"></div>
                </div>

                <div class="form-group">
                    <label for="videoUrl">Video URL (Optional)</label>
                    <input type="url" id="videoUrl" name="videoUrl" placeholder="https://www.youtube.com/watch?v=..." autocomplete="off">
                    <div class="preview-container" id="videoPreviewContainer"></div>
                </div>
            </fieldset>
            
            <input type="hidden" name="actionType" id="actionType" value="submit">

            <div class="button-group">
                <button type="button" class="draft-button" id="saveDraftBtn">Save Draft</button>
                <button type="button" class="submit-button" id="submitModBtn">Submit Mod for Review</button>
            </div>
        </form>
    </div>
</div>

<!-- ======== CONFIRMATION MODALS ======== -->

<!-- Submit Confirmation Modal -->
<div id="submit-confirm-modal" class="policy-modal">
    <div class="policy-modal-content" style="background-color: var(--dark-gray); padding: 30px; text-align: center; border-radius: 15px; max-width: 450px; width: 90%; border-top: 3px solid var(--gold); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        <i class="fas fa-paper-plane" style="font-size: 3em; color: var(--gold); margin-bottom: 15px;"></i>
        <h2 style="color: var(--white); margin-bottom: 15px;">Submit Mod?</h2>
        <p style="margin-bottom: 25px; color: var(--silver); line-height: 1.6;">
            Are you sure you want to submit this mod for review? You will not be able to edit the core details again until an admin approves or rejects it.
        </p>
        <div style="display: flex; gap: 15px; justify-content: center;">
            <button type="button" class="btn btn-primary" id="confirmSubmitBtn" style="width: 100%; padding: 12px; border-radius: 8px; font-weight: bold; background-color: var(--gold); color: var(--black); border: none; cursor: pointer;">Yes, Submit</button>
            <button type="button" class="btn btn-secondary" onclick="closeConfirmModal('submit-confirm-modal')" style="width: 100%; padding: 12px; border-radius: 8px; font-weight: bold; background-color: transparent; border: 2px solid var(--silver); color: var(--silver); cursor: pointer;">Cancel</button>
        </div>
    </div>
</div>

<!-- Draft Confirmation Modal -->
<div id="draft-confirm-modal" class="policy-modal">
    <div class="policy-modal-content" style="background-color: var(--dark-gray); padding: 30px; text-align: center; border-radius: 15px; max-width: 450px; width: 90%; border-top: 3px solid var(--silver); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        <i class="fas fa-save" style="font-size: 3em; color: var(--silver); margin-bottom: 15px;"></i>
        <h2 style="color: var(--white); margin-bottom: 15px;">Save Draft?</h2>
        <p style="margin-bottom: 25px; color: var(--silver); line-height: 1.6;">
            Your progress will be saved. You can return to this page later from your "My Uploads" dashboard to finish and submit the mod.
        </p>
        <div style="display: flex; gap: 15px; justify-content: center;">
            <button type="button" class="btn btn-primary" id="confirmDraftBtn" style="width: 100%; padding: 12px; border-radius: 8px; font-weight: bold; background-color: var(--silver); color: var(--black); border: none; cursor: pointer;">Save Draft</button>
            <button type="button" class="btn btn-secondary" onclick="closeConfirmModal('draft-confirm-modal')" style="width: 100%; padding: 12px; border-radius: 8px; font-weight: bold; background-color: transparent; border: 2px solid #555; color: var(--silver); cursor: pointer;">Cancel</button>
        </div>
    </div>
</div>

<script>
// Helper to control the Error/Success Alert Box (Globally available)
function showStatusAlert(message, type) {
    const alertBox = document.getElementById('status-alert-box');
    if (!alertBox) return;

    alertBox.textContent = message;
    if (type === 'error') {
        alertBox.className = 'status-banner rejected'; 
        alertBox.style.backgroundColor = 'rgba(229, 57, 53, 0.1)';
        alertBox.style.color = 'var(--red)';
        alertBox.style.border = '1px solid var(--red)';
    } else {
        alertBox.className = 'status-banner'; 
        alertBox.style.backgroundColor = 'rgba(46, 204, 113, 0.1)';
        alertBox.style.color = '#2ecc71';
        alertBox.style.border = '1px solid #2ecc71';
    }
    alertBox.style.display = 'block';
    alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

// Global modal closer
window.closeConfirmModal = function(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
        modal.classList.remove('show');
        setTimeout(() => { modal.style.display = 'none'; }, 200);
    }
}

// ==========================================
// MAIN INITIALIZATION
// ==========================================
document.addEventListener('DOMContentLoaded', () => {

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('error')) showStatusAlert(urlParams.get('error'), 'error'); 
    if (urlParams.has('success')) showStatusAlert(urlParams.get('success'), 'success'); 

    // ==========================================
    // 1. UI ELEMENTS & BASIC LOGIC
    // ==========================================
    const modIcon = document.getElementById('modIcon');
    const iconImage = document.getElementById('iconImage');
    const iconPlaceholder = document.getElementById('iconPlaceholder');
    const screenshotsInput = document.getElementById('screenshots');
    const screenshotFileNameSpan = document.getElementById('screenshotFileName');
    const screenshotPreviewContainer = document.getElementById('screenshotPreviewContainer');
    const videoUrlInput = document.getElementById('videoUrl');
    const videoPreviewContainer = document.getElementById('videoPreviewContainer');

    // Live icon preview
    if (modIcon) {
        modIcon.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    iconImage.src = e.target.result;
                    iconImage.style.display = 'block';
                    if(iconPlaceholder) iconPlaceholder.style.display = 'none';
                }
                reader.readAsDataURL(file);
            }
        });
    }

    // Screenshot Preview Logic (Masonry)
    if (screenshotsInput) {
        screenshotsInput.addEventListener('change', function() {
            const files = this.files;
            if (screenshotPreviewContainer) screenshotPreviewContainer.innerHTML = '';
            
            if (files.length > 0) {
                if (screenshotPreviewContainer) screenshotPreviewContainer.style.display = 'block'; 
                if (screenshotFileNameSpan) screenshotFileNameSpan.textContent = files.length + ' file(s) selected';
                
                Array.from(files).slice(0, 4).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        if (screenshotPreviewContainer) screenshotPreviewContainer.appendChild(img);
                    }
                    reader.readAsDataURL(file);
                });
            } else {
                if (screenshotPreviewContainer) screenshotPreviewContainer.style.display = 'none'; 
                if (screenshotFileNameSpan) screenshotFileNameSpan.textContent = 'No files selected';
            }
        });
    }

    // Video Preview Logic
    function getYouTubeId(url) {
        const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
        const match = url.match(regExp);
        return (match && match[2].length === 11) ? match[2] : null;
    }

    if (videoUrlInput && videoPreviewContainer) {
        videoUrlInput.addEventListener('input', function() {
            const videoId = getYouTubeId(this.value);
            if (videoId) {
                videoPreviewContainer.style.display = 'block'; 
                videoPreviewContainer.innerHTML = `<div class="video-preview-wrapper"><iframe src="https://www.youtube.com/embed/${videoId}" frameborder="0" allowfullscreen></iframe></div>`;
            } else {
                videoPreviewContainer.style.display = 'none'; 
                videoPreviewContainer.innerHTML = '';
            }
        });
    }

    // ==========================================
    // 2. CUSTOM SELECT LOGIC (DYNAMIC)
    // ==========================================
    
    const platformWrapper = document.getElementById('platformWrapper');
    const nativePlatformSelect = document.getElementById('modPlatform');
    const categoryWrapper = document.getElementById('categoryWrapper');
    const nativeCategorySelect = document.getElementById('modCategory');
    const categoryOptionsContainer = document.getElementById('categoryOptionsContainer');
    const ageRatingWrapper = document.getElementById('ageRatingWrapper');
    const nativeAgeRatingSelect = document.getElementById('ageRating');
    const licenseWrapper = document.getElementById('licenseWrapper');
    const nativeLicenseSelect = document.getElementById('modLicense');
    const archWrapper = document.getElementById('archWrapper');
    const archCustomSelect = document.getElementById('archCustomSelect');
    // --- ✅ ADDED FOR FETCH SELECT ---
    const fetchPlatformWrapper = document.getElementById('fetchPlatformWrapper');
    const nativeFetchPlatformSelect = document.getElementById('fetchPlatform');

    function setupCustomSelect(wrapper, nativeSelect) {
        if (!wrapper || !nativeSelect) return;
        
        const customSelect = wrapper.querySelector('.custom-select');
        const selectedText = wrapper.querySelector('.selected-text');
        
        customSelect.addEventListener('click', function(e) {
            if (wrapper.classList.contains('disabled')) return;
            e.stopPropagation();
            
            document.querySelectorAll('.custom-select-wrapper').forEach(w => {
                if (w !== wrapper) w.classList.remove('open');
            });
            
            wrapper.classList.toggle('open');
            this.style.borderColor = '';
            this.style.boxShadow = '';
        });

        const optionsContainer = wrapper.querySelector('.custom-options');
        if (optionsContainer) {
            optionsContainer.addEventListener('click', function(e) {
                if (e.target.classList.contains('custom-option')) {
                    e.stopPropagation();
                    const value = e.target.getAttribute('data-value');
                    const text = e.target.textContent;

                    selectedText.textContent = text;
                    selectedText.style.color = 'var(--white)';
                    nativeSelect.value = value;
                    nativeSelect.dispatchEvent(new Event('change'));

                    wrapper.querySelectorAll('.custom-option').forEach(opt => opt.classList.remove('selected'));
                    e.target.classList.add('selected');
                    wrapper.classList.remove('open');
                }
            });
        }
    }

    if (archCustomSelect && archWrapper) {
        archCustomSelect.addEventListener('click', function(e) {
            e.stopPropagation();
            document.querySelectorAll('.custom-select-wrapper').forEach(w => {
                if (w !== archWrapper) w.classList.remove('open');
            });
            archWrapper.classList.toggle('open');
            this.style.borderColor = '';
            this.style.boxShadow = '';
        });
    }

    setupCustomSelect(platformWrapper, nativePlatformSelect);
    setupCustomSelect(categoryWrapper, nativeCategorySelect);
    setupCustomSelect(ageRatingWrapper, nativeAgeRatingSelect);
    setupCustomSelect(licenseWrapper, nativeLicenseSelect);
    setupCustomSelect(fetchPlatformWrapper, nativeFetchPlatformSelect); // ✅ INIT FETCH DROPDOWN

    if (nativeAgeRatingSelect && ageRatingWrapper) {
        const currentValue = nativeAgeRatingSelect.value;
        if (currentValue) {
            const optionToSelect = ageRatingWrapper.querySelector(`.custom-option[data-value="${currentValue}"]`);
            if (optionToSelect) optionToSelect.classList.add('selected');
        }
    }

    document.addEventListener('click', function() {
        document.querySelectorAll('.custom-select-wrapper').forEach(wrapper => {
            wrapper.classList.remove('open');
        });
    });

    const manualFileScanGroup = document.getElementById('manualFileScanGroup');
    const manualSiteScanGroup = document.getElementById('manualSiteScanGroup');
    const directDownloadInput = document.getElementById('directDownloadUrl');

    const updateScanFieldVisibility = () => {
        const hasLargeFile = parsedFileSize > 640 * 1024 * 1024;
        if (manualFileScanGroup) {
            manualFileScanGroup.style.display = hasLargeFile ? 'block' : 'none';
        }
        if (manualSiteScanGroup) {
            manualSiteScanGroup.style.display = directDownloadInput && directDownloadInput.value.trim() ? 'block' : 'none';
        }
    };

    const categoriesByPlatform = {
        android:['Game - Action', 'Game - Adventure', 'Game - Arcade', 'Game - Board', 'Game - Casual', 'Game - Educational', 'Game - Fighting', 'Game - Music', 'Game - Puzzle', 'Game - Racing', 'Game - RPG', 'Game - Simulation', 'Game - Sports', 'Game - Strategy', 'Game - Survival', 'App - Audio', 'App - Books', 'App - Business', 'App - Communication', 'App - Education', 'App - Entertainment', 'App - Finance', 'App - Food and Drink', 'App - Health and Fitness', 'App - Lifestyle', 'App - Maps and Navigation', 'App - Medical', 'App - Music and Audio', 'App - News', 'App - Photography', 'App - Productivity', 'App - Shopping', 'App - Social', 'App - Tools', 'App - Travel', 'App - Utilities', 'App - Video Players', 'App - Weather', 'Other'],
        'ios-jailed':['Game - Action', 'Game - Adventure', 'Game - Arcade', 'Game - Board', 'Game - Casual', 'Game - Educational', 'Game - Fighting', 'Game - Music', 'Game - Puzzle', 'Game - Racing', 'Game - RPG', 'Game - Simulation', 'Game - Sports', 'Game - Strategy', 'Game - Survival', 'App - Audio', 'App - Books', 'App - Business', 'App - Communication', 'App - Education', 'App - Entertainment', 'App - Finance', 'App - Food and Drink', 'App - Health and Fitness', 'App - Lifestyle', 'App - Maps and Navigation', 'App - Medical', 'App - Music and Audio', 'App - News', 'App - Photography', 'App - Productivity', 'App - Shopping', 'App - Social', 'App - Tools', 'App - Travel', 'App - Utilities', 'App - Video Players', 'App - Weather', 'Other'],
        'ios-jailbroken':['Tweak - Accessibility', 'Tweak - Audio', 'Tweak - Battery', 'Tweak - File Management', 'Tweak - Lock Screen', 'Tweak - Messaging', 'Tweak - Notifications', 'Tweak - Security', 'Tweak - Settings', 'Tweak - UI', 'Tweak - Utilities', 'Theme - Icon', 'Theme - Lock Screen', 'Theme - SpringBoard', 'Theme - Widget', 'Utility - System', 'Utility - Scripting', 'Utility - Development', 'Widget - Clock', 'Widget - Music', 'Widget - Productivity', 'Widget - Weather', 'Other'],
        windows:['Software - Utility', 'Software - Multimedia', 'Software - Security', 'Software - Development', 'Software - Business', 'Software - Design', 'Software - Education', 'Software - Office', 'Software - Productivity', 'Game - Action', 'Game - Adventure', 'Game - Arcade', 'Game - Board', 'Game - Casual', 'Game - Puzzle', 'Game - Racing', 'Game - RPG', 'Game - Simulation', 'Game - Sports', 'Game - Strategy', 'Other'],
        wordpress:['Plugin - Analytics', 'Plugin - Backup', 'Plugin - Contact Form', 'Plugin - E-commerce', 'Plugin - Email Marketing', 'Plugin - Membership', 'Plugin - Multilingual', 'Plugin - Performance', 'Plugin - Page Builder', 'Plugin - SEO', 'Plugin - Security', 'Plugin - Social', 'Plugin - WooCommerce', 'Plugin - Utilities', 'Theme - Agency', 'Theme - Blog', 'Theme - Business', 'Theme - Corporate', 'Theme - Education', 'Theme - E-commerce', 'Theme - Landing Page', 'Theme - Magazine', 'Theme - Minimal', 'Theme - Multipurpose', 'Theme - Portfolio', 'Theme - Restaurant', 'Theme - WooCommerce', 'Theme - Personal', 'Other']
    };

    function populateCategories() {
        if (!nativePlatformSelect || !nativeCategorySelect || !categoryOptionsContainer || !categoryWrapper) return;
        
        const selectedPlatform = nativePlatformSelect.value;
        const categories = categoriesByPlatform[selectedPlatform] ||[];
        
        nativeCategorySelect.innerHTML = '';
        categoryOptionsContainer.innerHTML = '';
        const customSelectedText = categoryWrapper.querySelector('.selected-text');

        if (categories.length > 0) {
            nativeCategorySelect.disabled = false;
            categoryWrapper.classList.remove('disabled');
            customSelectedText.textContent = 'Select a category...';
            customSelectedText.style.color = 'var(--silver)';
            
            let nativeDefault = document.createElement('option');
            nativeDefault.text = 'Select a category...';
            nativeDefault.value = '';
            nativeDefault.disabled = true;
            nativeDefault.selected = true;
            nativeCategorySelect.add(nativeDefault);

            categories.forEach(function(category) {
                const catValue = category.toLowerCase().replace(/ /g, '-');
                let option = document.createElement('option');
                option.text = category;
                option.value = catValue;
                nativeCategorySelect.add(option);
                
                let customOpt = document.createElement('div');
                customOpt.className = 'custom-option';
                customOpt.setAttribute('data-value', catValue);
                customOpt.textContent = category;
                categoryOptionsContainer.appendChild(customOpt);
            });
        } else {
            nativeCategorySelect.disabled = true;
            categoryWrapper.classList.add('disabled');
            customSelectedText.textContent = 'Select a platform first...';
            customSelectedText.style.color = 'var(--silver)';
        }
    }

    if (directDownloadInput) {
        directDownloadInput.addEventListener('input', updateScanFieldVisibility);
    }

    if (nativePlatformSelect) {
        nativePlatformSelect.addEventListener('change', function() {
            populateCategories();
            const selectedPlatform = this.value;

            // Architecture Logic
            const archMap = {
                'android':['arm64-v8a', 'armeabi-v7a', 'x86_64', 'x86'],
                'windows':['x86-64', 'x64', 'x86'],
                'ios-jailed':['arm64', 'arm64e', 'armv7 / armv7s', 'Apple Silicon Mac (arm64)', 'Intel Mac (x86-64)'],
                'ios-jailbroken':['arm64', 'arm64e', 'armv7 / armv7s', 'Apple Silicon Mac (arm64)', 'Intel Mac (x86-64)']
            };

            const archGroup = document.getElementById('arch-group');
            const archOptionsContainer = document.getElementById('archOptionsContainer');
            const archSelectedText = document.getElementById('archSelectedText');
            const archReqStar = document.getElementById('arch-req-star');
            const osReqStar = document.getElementById('os-req-star');
            const minOsInput = document.getElementById('minOsVersion');
            const pkgIdGroup = document.getElementById('pkg-id-group');

            if (archMap[selectedPlatform]) {
                if(archGroup) archGroup.style.display = 'block';
                if(archOptionsContainer) {
                    archOptionsContainer.innerHTML = '';
                    if(archSelectedText) {
                        archSelectedText.textContent = 'Select architectures...';
                        archSelectedText.style.color = 'var(--silver)';
                    }
                    
                    archMap[selectedPlatform].forEach(arch => {
                        const label = document.createElement('label');
                        label.className = 'custom-option';
                        label.style.display = 'flex';
                        label.style.alignItems = 'center';
                        label.style.gap = '10px';
                        label.style.cursor = 'pointer';
                        
                        const checkbox = document.createElement('input');
                        checkbox.type = 'checkbox';
                        checkbox.name = 'architectures';
                        checkbox.value = arch;
                        checkbox.style.accentColor = 'var(--gold)';
                        checkbox.style.width = '16px';
                        checkbox.style.height = '16px';
                        checkbox.style.cursor = 'pointer';
                        
                        label.addEventListener('click', function(e) { e.stopPropagation(); });
                        
                        checkbox.addEventListener('change', function() {
                            const checkedBoxes = archOptionsContainer.querySelectorAll('input[type="checkbox"]:checked');
                            if (checkedBoxes.length === 0) {
                                archSelectedText.textContent = 'Select architectures...';
                                archSelectedText.style.color = 'var(--silver)';
                            } else if (checkedBoxes.length === 1) {
                                archSelectedText.textContent = checkedBoxes[0].value;
                                archSelectedText.style.color = 'var(--white)';
                            } else {
                                archSelectedText.textContent = `${checkedBoxes.length} architectures selected`;
                                archSelectedText.style.color = 'var(--white)';
                            }
                        });

                        label.appendChild(checkbox);
                        label.appendChild(document.createTextNode(arch));
                        archOptionsContainer.appendChild(label);
                    });
                }
            } else {
                if(archGroup) archGroup.style.display = 'none';
            }

            // Jailbreak Logic
            if (selectedPlatform === 'ios-jailbroken') {
                if(archReqStar) archReqStar.style.display = 'inline';
                if(osReqStar) osReqStar.style.display = 'inline';
                if(minOsInput) minOsInput.required = true;
            } else {
                if(archReqStar) archReqStar.style.display = 'none';
                if(osReqStar) osReqStar.style.display = 'none';
                if(minOsInput) minOsInput.required = false;
            }

            if (pkgIdGroup) pkgIdGroup.style.display = (selectedPlatform === 'ios-jailbroken') ? 'block' : 'none';
        });

        // Initial trigger
        const preSelectedPlatform = "<%= typeof defaultPlatform !== 'undefined' ? defaultPlatform : '' %>";
        if (preSelectedPlatform) {
            const optionToSelect = platformWrapper.querySelector(`.custom-option[data-value="${preSelectedPlatform}"]`);
            if(optionToSelect) optionToSelect.click();
        }
    }

    const parsedFileSize = Number(document.getElementById('fileSize')?.value || 0);
    updateScanFieldVisibility();

    // ==========================================
    // 3. QUILL & SUBMISSION
    // ==========================================
    const toolbarOptions = [['bold', 'italic', 'underline', 'strike'],[{ 'list': 'ordered'}, { 'list': 'bullet' }],['clean']];
    let quillDesc, quillFeat, quillOff, quillNew, quillNote;

    if (document.getElementById('editor-modDescription')) quillDesc = new Quill('#editor-modDescription', { theme: 'snow', modules: { toolbar: toolbarOptions } });
    if (document.getElementById('editor-modFeatures')) quillFeat = new Quill('#editor-modFeatures', { theme: 'snow', modules: { toolbar: toolbarOptions } });
    if (document.getElementById('editor-officialDescription')) quillOff = new Quill('#editor-officialDescription', { theme: 'snow', modules: { toolbar: toolbarOptions } });
    if (document.getElementById('editor-whatsNew')) quillNew = new Quill('#editor-whatsNew', { theme: 'snow', modules: { toolbar: toolbarOptions } });
    if (document.getElementById('editor-importantNote')) quillNote = new Quill('#editor-importantNote', { theme: 'snow', modules: { toolbar: toolbarOptions } });

    function syncQuillData() {
        if(quillDesc) document.getElementById('modDescription').value = quillDesc.root.innerHTML === '<p><br></p>' ? '' : quillDesc.root.innerHTML;
        if(quillFeat) document.getElementById('modFeatures').value = quillFeat.root.innerHTML === '<p><br></p>' ? '' : quillFeat.root.innerHTML;
        if(quillOff) document.getElementById('officialDescription').value = quillOff.root.innerHTML === '<p><br></p>' ? '' : quillOff.root.innerHTML;
        if(quillNew) document.getElementById('whatsNew').value = quillNew.root.innerHTML === '<p><br></p>' ? '' : quillNew.root.innerHTML;
        if(quillNote) document.getElementById('importantNote').value = quillNote.root.innerHTML === '<p><br></p>' ? '' : quillNote.root.innerHTML;
    }

    // =======================================================
    // --- SMART TEMPLATE SYSTEM LOGIC ---
    // =======================================================
    const smartTemplates = {
        modDescription: [
            { title: "Standard Game Mod", text: "This is a modified version of the game that provides a significant advantage. Explore the world with unlocked features and unlimited resources.\n\nEnjoy a seamless gaming experience without any annoying interruptions!" },
            { title: "Premium App Unlocked", text: "Get full access to all premium features of this application completely for free. This mod unlocks all VIP tools, removes watermarks, and provides a clean, ad-free experience." }
        ],
        modFeatures: [
            { title: "Standard Game Features", text: "Unlimited Coins & Gems\nAll Characters Unlocked\nGod Mode / High Damage\nNo Ads" },
            { title: "Premium App Features", text: "Pro Features Unlocked\nExport in HD/4K\nNo Watermark\nAnalytics & Trackers Disabled" }
        ],
        importantNote: [
            { title: "Standard Install Guide", text: "1. Uninstall any previous or official versions of this app.\n2. Download the APK file from the link below.\n3. Allow installation from 'Unknown Sources' in your device settings.\n4. Install the app and enjoy!" },
            { title: "Login Fix Guide", text: "⚠️ IMPORTANT: If you are unable to login using Google or Facebook, please use a Guest Account or register using a generic email/password inside the app." }
        ]
    };

    function getQuillForField(fieldId) {
        if (fieldId === 'modDescription') return quillDesc;
        if (fieldId === 'modFeatures') return quillFeat;
        if (fieldId === 'importantNote') return quillNote;
        return null;
    }

    function formatTemplateHtml(text) {
        return text.split('\n\n').map(p => `<p>${p.split('\n').join('<br>')}</p>`).join('');
    }

    function setupTemplateSystem(textareaId) {
        const textarea = document.getElementById(textareaId);
        const dropdown = document.getElementById(`dropdown-${textareaId}`);
        if (!dropdown) return;

        const templates = smartTemplates[textareaId];
        if (!templates) return;

        // Build the Dropdown HTML
        dropdown.innerHTML = templates.map((tmpl, index) => `
            <div class="template-option" data-index="${index}">
                <span class="template-option-title">${tmpl.title}</span>
                <span class="template-option-preview">${tmpl.text.replace(/\n/g, ' ')}</span>
            </div>
        `).join('');

        // Handle clicking an option
        dropdown.querySelectorAll('.template-option').forEach(opt => {
            opt.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const selectedTemplate = templates[this.getAttribute('data-index')].text;
                const quill = getQuillForField(textareaId);

                if (quill) {
                    const rawText = quill.getText();
                    const match = rawText.match(/\/?TEMPLATE\s*$/i);
                    if (match && match.index !== undefined) {
                        quill.deleteText(match.index, match[0].length);
                        if (quill.clipboard && typeof quill.clipboard.dangerouslyPasteHTML === 'function') {
                            quill.clipboard.dangerouslyPasteHTML(match.index, formatTemplateHtml(selectedTemplate));
                        } else {
                            quill.insertText(match.index, selectedTemplate);
                        }
                    } else {
                        const currentHtml = quill.root.innerHTML;
                        if (!currentHtml || currentHtml === '<p><br></p>') {
                            if (quill.clipboard && typeof quill.clipboard.dangerouslyPasteHTML === 'function') {
                                quill.clipboard.dangerouslyPasteHTML(formatTemplateHtml(selectedTemplate));
                            } else {
                                quill.setText(selectedTemplate + '\n');
                            }
                        } else {
                            const length = quill.getLength();
                            if (quill.clipboard && typeof quill.clipboard.dangerouslyPasteHTML === 'function') {
                                quill.clipboard.dangerouslyPasteHTML(length, formatTemplateHtml(selectedTemplate));
                            } else {
                                quill.insertText(length, '\n\n' + selectedTemplate);
                            }
                        }
                    }
                    syncQuillData();
                    quill.focus();
                } else if (textarea) {
                    textarea.value = textarea.value.replace(/\/?TEMPLATE$/i, selectedTemplate);
                    if (!textarea.value.includes(selectedTemplate)) {
                        textarea.value = textarea.value ? textarea.value + '\n\n' + selectedTemplate : selectedTemplate;
                    }
                    textarea.focus();
                }

                dropdown.style.display = 'none';
            });
        });

        // Listen for keyword in Quill if attached
        const quill = getQuillForField(textareaId);
        if (quill) {
            quill.on('text-change', function() {
                const txt = quill.getText().trim().toUpperCase();
                if (txt.endsWith('/TEMPLATE') || txt.endsWith('TEMPLATE')) {
                    dropdown.style.display = 'block';
                } else if (!dropdown.contains(document.activeElement)) {
                    if (!txt.includes('TEMPLATE')) {
                        dropdown.style.display = 'none';
                    }
                }
            });
        } else if (textarea) {
            textarea.addEventListener('input', function() {
                const val = this.value.toUpperCase().trim();
                if (val.endsWith('/TEMPLATE') || val.endsWith('TEMPLATE')) {
                    dropdown.style.display = 'block';
                } else {
                    dropdown.style.display = 'none';
                }
            });
        }
    }

    // Initialize for the 3 fields
    setupTemplateSystem('modDescription');
    setupTemplateSystem('modFeatures');
    setupTemplateSystem('importantNote');

    // Handle the "💡 Use Template" buttons
    document.querySelectorAll('.template-helper-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const targetId = btn.getAttribute('data-target');
            const dropdown = document.getElementById(`dropdown-${targetId}`);
            if (!dropdown) return;

            const isCurrentlyOpen = dropdown.style.display === 'block';
            document.querySelectorAll('.template-dropdown').forEach(d => d.style.display = 'none');
            dropdown.style.display = isCurrentlyOpen ? 'none' : 'block';

            const quill = getQuillForField(targetId);
            if (quill) {
                quill.focus();
            } else {
                const textarea = document.getElementById(targetId);
                if (textarea) textarea.focus();
            }
        });
    });

    // Hide dropdown if clicked outside
    document.addEventListener('click', (e) => {
        if (!e.target.closest('.template-dropdown') && !e.target.closest('.template-helper-btn')) {
            document.querySelectorAll('.template-dropdown').forEach(d => d.style.display = 'none');
        }
    });

    const saveDraftBtn = document.getElementById('saveDraftBtn');
    const submitModBtn = document.getElementById('submitModBtn');
    const actionTypeInput = document.getElementById('actionType');
    const mainForm = document.getElementById('mainUploadForm');
    const draftModal = document.getElementById('draft-confirm-modal');
    const submitModal = document.getElementById('submit-confirm-modal');
    const fileSizeInput = document.getElementById('fileSize');
    const userIsDistributor = <%= user && user.role === 'distributor' ? 'true' : 'false' %> === 'true';

    const getFirstTruthyValue = (selector) => {
        const fields = document.querySelectorAll(selector);
        for (const field of fields) {
            if (field && field.value && field.value.trim()) {
                return field.value.trim();
            }
        }
        return '';
    };

    if (saveDraftBtn && draftModal) {
        saveDraftBtn.addEventListener('click', (e) => {
            e.preventDefault();
            syncQuillData(); 
            draftModal.style.display = 'flex';
            setTimeout(() => draftModal.classList.add('show'), 10);
        });
    }

    if (submitModBtn && mainForm && submitModal) {
        submitModBtn.addEventListener('click', (e) => {
            e.preventDefault();
            syncQuillData();
            mainForm.noValidate = false;
            
            let hasError = false;

            if (nativePlatformSelect && !nativePlatformSelect.value) {
                if (platformWrapper) {
                    platformWrapper.querySelector('.custom-select').style.borderColor = 'var(--red)';
                    platformWrapper.querySelector('.custom-select').style.boxShadow = '0 0 10px rgba(229, 57, 53, 0.5)';
                }
                hasError = true;
            }
            
            if (nativeCategorySelect && (!nativeCategorySelect.value || nativeCategorySelect.disabled)) {
                if (categoryWrapper) {
                    categoryWrapper.querySelector('.custom-select').style.borderColor = 'var(--red)';
                    categoryWrapper.querySelector('.custom-select').style.boxShadow = '0 0 10px rgba(229, 57, 53, 0.5)';
                }
                hasError = true;
            }

            if (nativePlatformSelect && nativePlatformSelect.value === 'ios-jailbroken') {
                const checkedArchs = document.querySelectorAll('input[name="architectures"]:checked');
                if (checkedArchs.length === 0) {
                    if (archWrapper) {
                        archWrapper.querySelector('.custom-select').style.borderColor = 'var(--red)';
                        archWrapper.querySelector('.custom-select').style.boxShadow = '0 0 10px rgba(229, 57, 53, 0.5)';
                    }
                    hasError = true;
                }
            }

            if (!mainForm.checkValidity() || hasError) {
                mainForm.reportValidity();
                if(hasError) showStatusAlert('Please fill out all required custom dropdowns.', 'error');
                return;
            }
            
            if (document.getElementById('modDescription') && !document.getElementById('modDescription').value.trim()) {
                showStatusAlert('Error: Mod Description is required.', 'error'); return;
            }
            if (document.getElementById('modFeatures') && !document.getElementById('modFeatures').value.trim()) {
                showStatusAlert('Error: Mod Features are required.', 'error'); return;
            }
            if (document.getElementById('officialDescription') && !document.getElementById('officialDescription').value.trim()) {
                showStatusAlert('Error: Official Description is required.', 'error'); return;
            }
            if (document.getElementById('modVersion') && !document.getElementById('modVersion').value.trim()) {
                showStatusAlert('Error: Mod Version is required.', 'error'); return;
            }
            const parsedFileSize = fileSizeInput ? parseInt(fileSizeInput.value, 10) : 0;
            if (parsedFileSize > 640 * 1024 * 1024) {
                const hasScan = getFirstTruthyValue('input[name="manualFileScanUrl"]') || getFirstTruthyValue('input[name="manualSiteScanUrl"]');
                if (!hasScan) {
                    showStatusAlert('Files larger than 640MB require a manual scan URL before publishing.', 'error');
                    return;
                }
            }
            if (document.getElementById('ageRating') && !document.getElementById('ageRating').value) {
                showStatusAlert('Error: Age Rating is required.', 'error'); return;
            }
            if (document.getElementById('developerName') && !document.getElementById('developerName').value.trim()) {
                showStatusAlert('Error: Developer name is required.', 'error'); return;
            }
            if (document.getElementById('modIcon') && document.getElementById('modIcon').files.length === 0) {
                showStatusAlert('Error: An icon is required to publish this mod.', 'error'); return;
            }
            if (document.getElementById('screenshots') && document.getElementById('screenshots').files.length === 0) {
                showStatusAlert('Error: Screenshots are required to publish this mod.', 'error'); return;
            }

            actionTypeInput.value = 'submit';
            submitModal.style.display = 'flex';
            setTimeout(() => submitModal.classList.add('show'), 10);
        });
    }

    const confirmSubmitBtn = document.getElementById('confirmSubmitBtn');
    if(confirmSubmitBtn) {
        confirmSubmitBtn.addEventListener('click', () => {
            if(actionTypeInput && mainForm) {
                actionTypeInput.value = 'submit';
                mainForm.noValidate = false;
                mainForm.submit();
            }
        });
    }

    const confirmDraftBtn = document.getElementById('confirmDraftBtn');
    if(confirmDraftBtn) {
        confirmDraftBtn.addEventListener('click', () => {
            if(actionTypeInput && mainForm) {
                actionTypeInput.value = 'draft';
                mainForm.noValidate = true;
                mainForm.submit();
            }
        });
    }

    // ==========================================
    // 4. AUTO-FETCH STORE METADATA WITH SELECTION GUI
    // ==========================================
    const fetchBtn = document.getElementById('fetchBtn');
    const fetchUrlInput = document.getElementById('fetchUrl');
    const fetchPlatformSelect = document.getElementById('fetchPlatform');
    const statusSpan = document.getElementById('fetchStatus');

    const fetchMetadataModal = document.getElementById('fetchMetadataModal');
    const closeFetchModalBtn = document.getElementById('closeFetchModalBtn');
    const cancelFetchModalBtn = document.getElementById('cancelFetchModalBtn');
    const applyFetchModalBtn = document.getElementById('applyFetchModalBtn');
    const selectAllFetchFieldsBtn = document.getElementById('selectAllFetchFieldsBtn');
    const deselectAllFetchFieldsBtn = document.getElementById('deselectAllFetchFieldsBtn');
    const fetchModalSourceBadge = document.getElementById('fetchModalSourceBadge');

    const storePlaceholders = {
        playstore: 'https://play.google.com/store/apps/details?id=...',
        appstore: 'https://apps.apple.com/app/.../id...',
        steam: 'https://store.steampowered.com/app/...',
        epic: 'https://store.epicgames.com/p/...',
        wordpress: 'https://wordpress.org/plugins/...'
    };

    const storeNames = {
        playstore: 'Google Play Store',
        appstore: 'Apple App Store',
        steam: 'Steam Store',
        epic: 'Epic Games Store',
        wordpress: 'WordPress.org'
    };

    let lastFetchedMetadata = null;

    const updateFetchPlaceholder = () => {
        if (!fetchPlatformSelect || !fetchUrlInput) return;
        const currentPlatform = fetchPlatformSelect.value || 'playstore';
        if (storePlaceholders[currentPlatform]) {
            fetchUrlInput.placeholder = storePlaceholders[currentPlatform];
        }
    };

    if (fetchPlatformSelect) {
        fetchPlatformSelect.addEventListener('change', updateFetchPlaceholder);
        updateFetchPlaceholder();
    }

    document.querySelectorAll('#fetchPlatformWrapper .custom-option').forEach(option => {
        option.addEventListener('click', () => {
            setTimeout(updateFetchPlaceholder, 50);
        });
    });

    const closeMetadataModal = () => {
        if (fetchMetadataModal) {
            fetchMetadataModal.classList.remove('show');
            fetchMetadataModal.style.display = 'none';
            document.body.style.overflow = '';
        }
    };

    if (closeFetchModalBtn) closeFetchModalBtn.addEventListener('click', closeMetadataModal);
    if (cancelFetchModalBtn) cancelFetchModalBtn.addEventListener('click', closeMetadataModal);

    if (selectAllFetchFieldsBtn) {
        selectAllFetchFieldsBtn.addEventListener('click', () => {
            ['appName', 'developer', 'officialDescription', 'tags', 'whatsNew'].forEach(key => {
                const chk = document.getElementById(`fetch_opt_${key}`);
                if (chk && !chk.disabled) chk.checked = true;
            });
        });
    }

    if (deselectAllFetchFieldsBtn) {
        deselectAllFetchFieldsBtn.addEventListener('click', () => {
            ['appName', 'developer', 'officialDescription', 'tags', 'whatsNew'].forEach(key => {
                const chk = document.getElementById(`fetch_opt_${key}`);
                if (chk) chk.checked = false;
            });
        });
    }

    if (fetchBtn) {
        fetchBtn.addEventListener('click', async function() {
            const platform = fetchPlatformSelect ? fetchPlatformSelect.value : 'playstore';
            const url = fetchUrlInput ? fetchUrlInput.value.trim() : '';

            if (!url) {
                if (statusSpan) {
                    statusSpan.textContent = 'Please enter a valid store URL first.';
                    statusSpan.style.color = 'var(--red, #ff4d4d)';
                }
                return;
            }

            fetchBtn.disabled = true;
            fetchBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Fetching Store Data...';
            if (statusSpan) statusSpan.textContent = '';

            try {
                const response = await fetch('/api/fetch-metadata', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url, platform })
                });

                const result = await response.json();

                if (result.success && result.data) {
                    lastFetchedMetadata = result.data;
                    if (statusSpan) {
                        statusSpan.textContent = 'Store data fetched! Select fields in modal to apply.';
                        statusSpan.style.color = 'var(--green, #2ecc71)';
                    }

                    if (fetchModalSourceBadge) {
                        fetchModalSourceBadge.textContent = `${storeNames[platform] || platform} Data`;
                    }

                    const fieldMappings = [
                        { key: 'appName', val: result.data.title || result.data.appName || '' },
                        { key: 'developer', val: result.data.developer || '' },
                        { key: 'officialDescription', val: result.data.officialDescription || result.data.description || '' },
                        { key: 'tags', val: result.data.tags || '' },
                        { key: 'whatsNew', val: result.data.whatsNew || '' }
                    ];

                    fieldMappings.forEach(item => {
                        const valEl = document.getElementById(`fetch_val_${item.key}`);
                        const chkEl = document.getElementById(`fetch_opt_${item.key}`);
                        if (valEl) {
                            valEl.innerHTML = item.val ? (item.val.length > 250 ? item.val.substring(0, 250) + '...' : item.val) : '<em style="color:#777;">Not found in store page</em>';
                        }
                        if (chkEl) {
                            if (item.val) {
                                chkEl.checked = true;
                                chkEl.disabled = false;
                            } else {
                                chkEl.checked = false;
                                chkEl.disabled = true;
                            }
                        }
                    });

                    if (fetchMetadataModal) {
                        fetchMetadataModal.style.display = 'flex';
                        fetchMetadataModal.classList.add('show');
                        document.body.style.overflow = 'hidden';
                    }

                } else {
                    if (statusSpan) {
                        statusSpan.textContent = result.error || 'Failed to fetch store data.';
                        statusSpan.style.color = 'var(--red, #ff4d4d)';
                    }
                }
            } catch (err) {
                if (statusSpan) {
                    statusSpan.textContent = 'Server error. Could not connect to API.';
                    statusSpan.style.color = 'var(--red, #ff4d4d)';
                }
            } finally {
                fetchBtn.disabled = false;
                fetchBtn.innerHTML = '<i class="fas fa-magic"></i> Fetch Data';
            }
        });
    }

    if (applyFetchModalBtn) {
        applyFetchModalBtn.addEventListener('click', () => {
            if (!lastFetchedMetadata) return;

            let appliedCount = 0;

            // 1. App Name
            if (document.getElementById('fetch_opt_appName')?.checked) {
                const appNameVal = lastFetchedMetadata.title || lastFetchedMetadata.appName;
                const modNameInput = document.getElementById('modName') || document.getElementById('name');
                if (modNameInput && appNameVal) {
                    modNameInput.value = appNameVal;
                    appliedCount++;
                }
            }

            // 2. Developer Name
            if (document.getElementById('fetch_opt_developer')?.checked && lastFetchedMetadata.developer) {
                const devInput = document.getElementById('developerName');
                if (devInput) {
                    devInput.value = lastFetchedMetadata.developer;
                    appliedCount++;
                }
            }

            // 3. Official Description
            if (document.getElementById('fetch_opt_officialDescription')?.checked) {
                const descVal = lastFetchedMetadata.officialDescription || lastFetchedMetadata.description;
                if (descVal) {
                    if (typeof quillOff !== 'undefined' && quillOff) {
                        if (quillOff.clipboard && typeof quillOff.clipboard.dangerouslyPasteHTML === 'function') {
                            quillOff.clipboard.dangerouslyPasteHTML(descVal);
                        } else {
                            quillOff.root.innerHTML = descVal;
                        }
                    }
                    const offDescInput = document.getElementById('officialDescription');
                    if (offDescInput) offDescInput.value = descVal;
                    appliedCount++;
                }
            }

            // 4. Tags
            if (document.getElementById('fetch_opt_tags')?.checked && lastFetchedMetadata.tags) {
                const tagsInput = document.getElementById('tags');
                if (tagsInput) {
                    tagsInput.value = lastFetchedMetadata.tags;
                    appliedCount++;
                }
            }

            // 5. What's New
            if (document.getElementById('fetch_opt_whatsNew')?.checked && lastFetchedMetadata.whatsNew) {
                if (typeof quillNew !== 'undefined' && quillNew) {
                    if (quillNew.clipboard && typeof quillNew.clipboard.dangerouslyPasteHTML === 'function') {
                        quillNew.clipboard.dangerouslyPasteHTML(lastFetchedMetadata.whatsNew);
                    } else {
                        quillNew.root.innerHTML = lastFetchedMetadata.whatsNew;
                    }
                }
                const whatsNewInput = document.getElementById('whatsNew');
                if (whatsNewInput) whatsNewInput.value = lastFetchedMetadata.whatsNew;
                appliedCount++;
            }

            // Auto-populate min OS & age rating if present
            if (lastFetchedMetadata.minOsVersion) {
                const minOsInput = document.getElementById('minOsVersion');
                if (minOsInput) minOsInput.value = lastFetchedMetadata.minOsVersion;
            }
            if (lastFetchedMetadata.ageRating) {
                const ageInput = document.getElementById('ageRating');
                const ageWrapper = document.getElementById('ageRatingWrapper');
                if (ageInput && ageWrapper) {
                    ageInput.value = lastFetchedMetadata.ageRating;
                    const optionToSelect = ageWrapper.querySelector(`.custom-option[data-value="${lastFetchedMetadata.ageRating}"]`);
                    if (optionToSelect) optionToSelect.click();
                }
            }

            closeMetadataModal();

            if (statusSpan) {
                statusSpan.textContent = `✓ Successfully applied ${appliedCount} selected fields!`;
                statusSpan.style.color = 'var(--green, #2ecc71)';
            }
        });
    }
});
</script>

<script>
// --- ADVANCED LINK & PARTS MANAGEMENT LOGIC ---
document.addEventListener('DOMContentLoaded', () => {
    const btnSingleLink = document.getElementById('btn-single-link');
    const btnMultiPart = document.getElementById('btn-multi-part');
    const singleLinkContainer = document.getElementById('single-link-container');
    const multiPartContainer = document.getElementById('multi-part-container');
    const isMultiPartHidden = document.getElementById('isMultiPartHidden');
    const partsWrapper = document.getElementById('parts-wrapper');
    const addPartBtn = document.getElementById('add-part-btn');

    function createPartCard(part = {}, index = 0) {
        const div = document.createElement('div');
        div.className = 'part-card';
        div.style.cssText = 'background: rgba(255,255,255,0.03); border:1px solid #333; padding:12px; border-radius:8px; margin-bottom:12px;';
        div.innerHTML = `
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <strong>Part <span class="part-index">${index + 1}</span></strong>
                <button type="button" class="remove-part-btn btn btn-danger" style="padding:6px 10px;">Remove</button>
            </div>
            <div class="form-group">
                <label>Part Name</label>
                <input type="text" name="partNames[]" class="link-req-multi" value="${part.partName || ''}" placeholder="e.g., main, split-1">
            </div>
            <div class="form-group">
                <label>Main URL*</label>
                <input type="url" name="partUrls[]" class="link-req-multi" value="${part.partUrl || ''}" placeholder="https://...">
            </div>
            <div style="display:flex; gap:8px;">
                <div style="flex:1;">
                    <label>Mirror 1 Provider</label>
                    <input type="text" name="mirror1Providers[]" value="${part.mirror1Provider || ''}" placeholder="Google Drive">
                </div>
                <div style="flex:2;">
                    <label>Mirror 1 URL</label>
                    <input type="url" name="mirror1Urls[]" value="${part.mirror1Url || ''}" placeholder="https://...">
                </div>
            </div>
            <div style="display:flex; gap:8px; margin-top:8px;">
                <div style="flex:1;">
                    <label>Mirror 2 Provider</label>
                    <input type="text" name="mirror2Providers[]" value="${part.mirror2Provider || ''}" placeholder="Mega">
                </div>
                <div style="flex:2;">
                    <label>Mirror 2 URL</label>
                    <input type="url" name="mirror2Urls[]" value="${part.mirror2Url || ''}" placeholder="https://...">
                </div>
            </div>
            <div class="form-group" style="margin-top:8px;">
                <label>Direct Admin Link</label>
                <input type="url" name="directAdminLinks[]" value="${part.directAdminLink || ''}" placeholder="https://admin.example.com/direct/...">
            </div>
            <div style="display:flex; gap:8px;">
                <div style="flex:1;">
                    <label>Manual File Scan URL</label>
                    <input type="url" name="manualFileScanUrls[]" value="${part.manualFileScanUrl || ''}" placeholder="https://virustotal.com/...">
                </div>
                <div style="flex:1;">
                    <label>Manual Site Scan URL</label>
                    <input type="url" name="manualSiteScanUrls[]" value="${part.manualSiteScanUrl || ''}" placeholder="https://sitecheck.sucuri.net/...">
                </div>
            </div>
        `;

        div.querySelector('.remove-part-btn').addEventListener('click', () => { div.remove(); updatePartIndices(); });
        return div;
    }

    function updatePartIndices() {
        partsWrapper.querySelectorAll('.part-card').forEach((card, idx) => card.querySelector('.part-index').textContent = idx + 1);
    }

    if (!btnSingleLink || !btnMultiPart || !partsWrapper) return;

    btnSingleLink.addEventListener('click', () => {
        btnSingleLink.classList.replace('btn-secondary','btn-primary');
        btnMultiPart.classList.replace('btn-primary','btn-secondary');
        singleLinkContainer.style.display = 'block';
        multiPartContainer.style.display = 'none';
        isMultiPartHidden.value = 'false';
        document.querySelectorAll('.link-req-single').forEach(el => el.required = true);
        document.querySelectorAll('.link-req-multi').forEach(el => el.required = false);
    });

    btnMultiPart.addEventListener('click', () => {
        btnMultiPart.classList.replace('btn-secondary','btn-primary');
        btnSingleLink.classList.replace('btn-primary','btn-secondary');
        multiPartContainer.style.display = 'block';
        singleLinkContainer.style.display = 'none';
        isMultiPartHidden.value = 'true';
        document.querySelectorAll('.link-req-single').forEach(el => el.required = false);
        document.querySelectorAll('.link-req-multi').forEach(el => el.required = true);
    });

    // Load existing parts from server-side data
    const existingParts = <%- JSON.stringify(file.downloadParts || []) %>;
    if (existingParts && existingParts.length > 0) {
        existingParts.forEach((p, idx) => partsWrapper.appendChild(createPartCard(p, idx)));
    } else {
        // two default parts
        partsWrapper.appendChild(createPartCard({}, 0));
        partsWrapper.appendChild(createPartCard({}, 1));
    }

    addPartBtn.addEventListener('click', () => {
        const count = partsWrapper.querySelectorAll('.part-card').length;
        partsWrapper.appendChild(createPartCard({}, count));
        if (isMultiPartHidden.value === 'true') partsWrapper.lastElementChild.querySelectorAll('.link-req-multi').forEach(el => el.required = true);
    });

    // Set initial required states
    if (isMultiPartHidden.value === 'true') {
        document.querySelectorAll('.link-req-single').forEach(el => el.required = false);
        document.querySelectorAll('.link-req-multi').forEach(el => el.required = true);
    } else {
        document.querySelectorAll('.link-req-single').forEach(el => el.required = true);
        document.querySelectorAll('.link-req-multi').forEach(el => el.required = false);
    }
});
</script>
