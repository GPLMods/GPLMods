                        label.appendChild(checkbox);
                        label.appendChild(document.createTextNode(arch));
                        archOptionsContainer.appendChild(label);
                    });
                    const savedChecks = archOptionsContainer.querySelectorAll('input:checked');
                    if (savedChecks.length === 1) { archSelectedText.textContent = savedChecks[0].value; archSelectedText.style.color = 'var(--white)'; }
                    else if (savedChecks.length > 1) { archSelectedText.textContent = `${savedChecks.length} architectures selected`; archSelectedText.style.color = 'var(--white)'; }
