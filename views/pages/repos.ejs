<%-include('../partials/header') %>

    <style>
        .repo-page-header {
            text-align: center;
            padding: 60px 20px;
            border-bottom: 1px solid var(--dark-gray);
            margin-bottom: 40px;
        }

        .repo-page-header h1 {
            font-size: 3em;
            color: var(--white);
        }

        .repo-page-header h1 span {
            color: var(--blue);
            text-shadow: 0 0 4px rgba(33, 150, 243, 0.5);
        }

        .platform-section {
            margin-bottom: 50px;
            background: var(--dark-gray);
            padding: 30px;
            border-radius: 15px;
            border: 1px solid #333;
            max-width: 100%;
            box-sizing: border-box;
        }

        .platform-title {
            display: flex;
            align-items: center;
            gap: 15px;
            font-size: 2em;
            color: var(--white);
            margin-bottom: 20px;
            border-bottom: 1px solid #444;
            padding-bottom: 15px;
            flex-wrap: wrap;
            word-break: break-word;
        }

        /* Repo Box */
        .repo-box {
            background: var(--black);
            border: 1px solid var(--gold);
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 30px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(255, 215, 0, 0.05);
            max-width: 100%;
            box-sizing: border-box;
        }

        .repo-box h3 {
            color: var(--gold);
            margin-bottom: 10px;
            font-size: 1.3em;
        }

        /* Perfect scaling for custom SVG icons inside buttons */
        .repo-icon {
            width: 24px;
            height: 24px;
            min-width: 24px;
            max-width: 24px;
            object-fit: contain;
            display: block;
            filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.5));
        }

        .repo-url-display {
            display: inline-block;
            background: #111;
            border: 1px dashed #555;
            color: var(--silver);
            padding: 10px 20px;
            border-radius: 8px;
            font-family: monospace;
            font-size: 1.1em;
            letter-spacing: 1px;
            user-select: all;
            margin-bottom: 20px;
            word-break: break-all;
            max-width: 100%;
            box-sizing: border-box;
        }

        .repo-buttons-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
            gap: 15px;
        }

        .repo-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: #1a1a1a;
            color: var(--silver);
            border: 1px solid #444;
            padding: 12px 15px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }

        .repo-btn:hover {
            background: var(--gold);
            color: var(--black);
            border-color: var(--gold);
            transform: translateY(-3px);
            box-shadow: 0 5px 15px var(--glow-gold);
        }

        .repo-btn i {
            font-size: 1.2em;
        }

        @media (max-width: 768px) {
            .repo-page-header {
                padding: 40px 15px;
                margin-bottom: 25px;
            }
            .repo-page-header h1 {
                font-size: 2.2em;
            }
            .platform-section {
                padding: 18px 14px;
                margin-bottom: 35px;
                border-radius: 12px;
            }
            .platform-title {
                font-size: 1.4em;
                gap: 10px;
            }
            .repo-box {
                padding: 18px 12px;
            }
            .repo-buttons-grid {
                grid-template-columns: 1fr;
                gap: 10px;
            }
            .repo-btn {
                width: 100%;
                justify-content: center;
            }
            .ipa-archive-card {
                padding: 16px 14px !important;
                flex-direction: column !important;
                align-items: stretch !important;
                text-align: center !important;
            }
            .ipa-archive-card > div {
                flex-direction: column !important;
                text-align: center !important;
            }
            .ipa-archive-card .repo-btn {
                width: 100% !important;
                justify-content: center !important;
            }
        }
    </style>

    <main class="container">
        <%- include('../partials/go-back-button', { fallback: '/' }) %>
        <!-- ======================================== -->
        <div class="repo-page-header">
            <h1>Source <span>Repositories</span></h1>
            <p style="color: var(--silver); font-size: 1.1em; margin-top: 10px;">Add GPL Mods directly to your favorite
                package managers for seamless updates and 1-click installs.</p>
            <div style="display: flex; justify-content: center; gap: 12px; margin-top: 22px; flex-wrap: wrap;">
                <a href="/jailbreak-repos" class="repo-btn" style="background: rgba(255, 152, 0, 0.15); border-color: rgba(255, 152, 0, 0.4); color: #FF9800; font-size: 0.9em; padding: 8px 18px;">
                    <i class="fas fa-unlock-alt"></i> View Jailbreak Repos (DEB Tweaks)
                </a>
                <a href="https://gplmods.freeddns.org/" target="_blank" rel="noopener noreferrer" class="repo-btn" style="background: rgba(33, 150, 243, 0.15); border-color: rgba(33, 150, 243, 0.4); color: #60a5fa; font-size: 0.9em; padding: 8px 18px;">
                    <i class="fas fa-archive"></i> iOS IPA Archive Mirror
                </a>
            </div>
        </div>

        <% 
            // Use the dynamically passed baseUrl!
            const fullRepoUrl = baseUrl;
            // Strip http:// or https:// for F-Droid schemes if necessary
            const rawDomain = baseUrl.replace(/^https?:\/\//, ''); 
            const fp = (typeof fdroidFingerprint !== 'undefined' && fdroidFingerprint) ? fdroidFingerprint : '';
            const formattedFp = (typeof fdroidFormattedFingerprint !== 'undefined' && fdroidFormattedFingerprint) ? fdroidFormattedFingerprint : fp;
            const cleanFp = fp.toLowerCase().replace(/[^a-f0-9]/g, '');
            const fullRepoUrlWithFp = cleanFp ? (fullRepoUrl + '/fdroid/repo?fingerprint=' + cleanFp) : (fullRepoUrl + '/fdroid/repo');
            const clientIntentUrl = cleanFp ? ('fdroidrepos://' + rawDomain + '/fdroid/repo?fingerprint=' + cleanFp) : ('fdroidrepos://' + rawDomain + '/fdroid/repo');
        %>


            <!-- ============================================== -->
            <!-- iOS SIDELOADING REPOS (AltStore, Scarlet, etc) -->
            <!-- ============================================== -->
            <!-- ============================================== -->
            <!-- iOS SIDELOADING REPOS (AltStore, Scarlet, etc) -->
            <!-- ============================================== -->
            <section class="platform-section" style="border-top: 4px solid var(--blue);">
                <h2 class="platform-title"><i class="fab fa-apple" style="color: var(--white);"></i> iOS Sideloading
                    Sources</h2>
                <p style="color: var(--silver); margin-bottom: 20px; font-size: 1.05em;">Add our source to your signing
                    app to automatically fetch all IPA mods available on GPL Mods.</p>

                <!-- ✅ iOS IPA Archive Direct Mirror Link -->
                <div class="ipa-archive-card" style="background: linear-gradient(135deg, rgba(33, 150, 243, 0.15) 0%, rgba(10, 10, 15, 0.9) 100%); border: 1px solid rgba(33, 150, 243, 0.35); border-radius: 14px; padding: 18px 24px; margin-bottom: 25px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);">
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(33, 150, 243, 0.2); border: 1px solid rgba(33, 150, 243, 0.5); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: #60a5fa; flex-shrink: 0;">
                            <i class="fas fa-archive"></i>
                        </div>
                        <div>
                            <h4 style="margin: 0 0 4px 0; color: #ffffff; font-size: 1.1rem; font-weight: 700;">iOS IPA Archive & Direct Repo Mirror</h4>
                            <p style="margin: 0; color: var(--silver); font-size: 0.88rem; line-height: 1.4;">Browse and download complete iOS IPA mod archives and direct packages directly from our archive mirror.</p>
                        </div>
                    </div>
                    <a href="https://gplmods.freeddns.org/" target="_blank" rel="noopener noreferrer" class="repo-btn" style="background: var(--blue); color: #fff; border: 1px solid rgba(255, 255, 255, 0.25); padding: 10px 22px; border-radius: 8px; font-weight: 700; font-size: 0.88rem; box-shadow: 0 4px 15px rgba(33, 150, 243, 0.4); text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                        <i class="fas fa-external-link-alt"></i> Open iOS IPA Archive
                    </a>
                </div>

                <div class="repo-box">
                    <h3>Add iOS Source</h3>

                    <!-- ✅ FIX: Pointing exactly to the new apps.json file -->
                    <div class="repo-url-display">
                        <%= fullRepoUrl %>/ios-repo/apps.json
                    </div>

                    <div class="repo-buttons-grid">
                        <!-- ✅ FIX: Using local SVGs with the .repo-icon class -->
                        <a href="altstore://source?url=<%= fullRepoUrl %>/ios-repo/apps.json" class="repo-btn">
                            <img src="<%= cdnUrl %>/images/icons/altstore.png" alt="AltStore" class="repo-icon"> Add to
                            AltStore
                        </a>

                        <a href="sidestore://source?url=<%= fullRepoUrl %>/ios-repo/apps.json" class="repo-btn">
                            <img src="<%= cdnUrl %>/images/icons/sidestore.png" alt="SideStore" class="repo-icon"> Add
                            to SideStore
                        </a>

                        <a href="scarlet://repo=<%= fullRepoUrl %>/ios-repo/apps.json" class="repo-btn">
                            <img src="<%= cdnUrl %>/images/icons/scarlet.png" alt="Scarlet" class="repo-icon"> Add to
                            Scarlet
                        </a>

                        <a href="esign://import?url=<%= fullRepoUrl %>/ios-repo/apps.json" class="repo-btn">
                            <img src="<%= cdnUrl %>/images/icons/esign.png" alt="E-Sign" class="repo-icon"> Add to
                            E-Sign
                        </a>

                        <a href="feather://import/<%= fullRepoUrl %>/ios-repo/apps.json" class="repo-btn">
                            <img src="<%= cdnUrl %>/images/icons/feather.png" alt="Feather" class="repo-icon"> Add to
                            Feather
                        </a>

                        <!-- If you don't have SVGs for some, you can leave FontAwesome or use a generic icon -->
                        <a href="livecontainer://source?url=<%= fullRepoUrl %>/ios-repo/apps.json" class="repo-btn">
                            <img src="<%= cdnUrl %>/images/icons/livecontainer.png" alt="LiveContainer"
                                class="repo-icon"> Add to LiveContainer
                        </a>

                        <a href="ksign://import?url=<%= fullRepoUrl %>/ios-repo/apps.json" class="repo-btn">
                            <img src="<%= cdnUrl %>/images/icons/ksign.png" alt="Ksign" class="repo-icon"> Add to Ksign
                        </a>
                    </div>
                </div>

                <h3
                    style="color: var(--white); margin-bottom: 15px; border-bottom: 1px solid #333; padding-bottom: 10px;">
                    Available in this Source:</h3>
                <div class="mod-grid">
                    <% if (iosFiles.length> 0) { %>
                        <% iosFiles.forEach(file=> { %>
                            <!-- REPLACE WITH YOUR UNIVERSAL MOD CARD CODE OR INCLUDE -->
                            <%- include('../partials/mod-card', { file: file }) %>
                                <% }) %>
                                    <% } else { %>
                                        <p style="color: var(--silver); grid-column: 1/-1; text-align: center;">No IPA
                                            files are currently configured for direct download.</p>
                                        <% } %>
                </div>
            </section>

            <!-- ============================================== -->
            <!-- ANDROID F-DROID REPO                           -->
            <!-- ============================================== -->
            <section class="platform-section" style="border-top: 4px solid var(--android-color);">
                <h2 class="platform-title"><i class="fab fa-android" style="color: var(--android-color);"></i> Android
                    Mod Repository</h2>

                <!-- Updated Explanation -->
                <p style="color: var(--silver); margin-bottom: 15px; font-size: 1.05em;">
                    Manage your Android mods just like native apps! Add our custom repository to your favorite F-Droid client
                    to receive automatic updates and 1-click installations.
                </p>

                <!-- Information Note -->
                <div
                    style="background-color: rgba(33, 150, 243, 0.1); border-left: 4px solid var(--android-color); padding: 15px; border-radius: 8px; margin-bottom: 25px; text-align: left;">
                    <p style="margin: 0; color: var(--silver); font-size: 0.9em;">
                        <strong style="color: var(--white);"><i class="fas fa-check-circle" style="color: var(--android-color);"></i> Universal F-Droid Protocol Support:</strong><br>
                        Our repository fully implements the official <strong style="color: var(--white);">F-Droid Index V2</strong> standard (with automatic Index-V1 and classic XML fallbacks).
                        Works seamlessly with <strong style="color: var(--white);"><a href="https://droidify.app/" target="_blank" rel="noopener noreferrer" style="color: var(--android-color);">Droid-ify</a></strong>, 
                        <strong style="color: var(--white);"><a href="https://github.com/NeoApplications/Neo-Store" target="_blank" rel="noopener noreferrer" style="color: var(--android-color);">Neo Store</a></strong>, 
                        and the official <strong style="color: var(--white);"><a href="https://f-droid.org/en/" target="_blank" rel="noopener noreferrer" style="color: var(--android-color);">F-Droid</a></strong> app.
                    </p>
                </div>

                <!-- ✅ Client App Installation Shortcuts Grid -->
                <div style="background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(76, 175, 80, 0.3); border-radius: 12px; padding: 20px; margin-bottom: 25px;">
                    <h3 style="color: var(--android-color); font-size: 1.15em; margin: 0 0 14px 0; display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-download"></i> Package Manager Client Apps (Installation Shortcuts)
                    </h3>
                    <p style="color: var(--silver); font-size: 0.88rem; margin: 0 0 16px 0;">
                        Don't have an F-Droid client installed on your device yet? Install one of these recommended open-source package managers:
                    </p>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px;">
                        <!-- Droid-ify -->
                        <div style="background: #151518; border: 1px solid #333; border-radius: 10px; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; gap: 10px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <img src="<%= cdnUrl %>/images/icons/droidify.png" alt="Droid-ify" style="width: 32px; height: 32px; object-fit: contain;" onerror="this.style.display='none'">
                                <div>
                                    <h4 style="margin: 0; color: #fff; font-size: 0.95rem;">Droid-ify</h4>
                                    <span style="color: var(--silver); font-size: 0.75rem;">Material You F-Droid Client</span>
                                </div>
                            </div>
                            <a href="https://droidify.app/" target="_blank" rel="noopener noreferrer" class="repo-btn" style="padding: 8px 12px; font-size: 0.82rem; border-color: var(--android-color); color: var(--android-color); background: rgba(164, 198, 57, 0.1);">
                                <i class="fas fa-external-link-alt"></i> Install Droid-ify (droidify.app)
                            </a>
                        </div>

                        <!-- Neo Store -->
                        <div style="background: #151518; border: 1px solid #333; border-radius: 10px; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; gap: 10px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <img src="<%= cdnUrl %>/images/icons/neostore.png" alt="Neo Store" style="width: 32px; height: 32px; object-fit: contain;" onerror="this.style.display='none'">
                                <div>
                                    <h4 style="margin: 0; color: #fff; font-size: 0.95rem;">Neo Store</h4>
                                    <span style="color: var(--silver); font-size: 0.75rem;">Feature-Packed F-Droid Client</span>
                                </div>
                            </div>
                            <a href="https://github.com/NeoApplications/Neo-Store" target="_blank" rel="noopener noreferrer" class="repo-btn" style="padding: 8px 12px; font-size: 0.82rem; border-color: #60a5fa; color: #60a5fa; background: rgba(96, 165, 250, 0.1);">
                                <i class="fab fa-github"></i> Get Neo Store (GitHub)
                            </a>
                        </div>

                        <!-- F-Droid Official -->
                        <div style="background: #151518; border: 1px solid #333; border-radius: 10px; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; gap: 10px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <img src="<%= cdnUrl %>/images/icons/f-droid.png" alt="F-Droid" style="width: 32px; height: 32px; object-fit: contain;" onerror="this.style.display='none'">
                                <div>
                                    <h4 style="margin: 0; color: #fff; font-size: 0.95rem;">F-Droid</h4>
                                    <span style="color: var(--silver); font-size: 0.75rem;">Official FOSS Store</span>
                                </div>
                            </div>
                            <a href="https://f-droid.org/en/" target="_blank" rel="noopener noreferrer" class="repo-btn" style="padding: 8px 12px; font-size: 0.82rem; border-color: var(--silver); color: #fff; background: rgba(255, 255, 255, 0.08);">
                                <i class="fas fa-download"></i> Download F-Droid APK (f-droid.org)
                            </a>
                        </div>
                    </div>
                </div>

                <div class="repo-box" style="border-color: var(--android-color);">
                    <h3 style="color: var(--android-color);">Add Android Source</h3>

                    <div class="repo-url-display" id="android-repo-url">
                        <%= fullRepoUrl %>/fdroid/repo
                    </div>

                    <% if (fp) { %>
                    <div style="margin: 15px auto 20px auto; max-width: 650px; background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(76, 175, 80, 0.3); border-radius: 8px; padding: 12px 16px; text-align: left;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">
                            <span style="color: var(--android-color); font-size: 0.85em; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;">
                                <i class="fas fa-fingerprint"></i> SHA-256 Signing Fingerprint
                            </span>
                            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                <button type="button" onclick="copyRepoUrl('<%= cleanFp %>', this)" style="background: rgba(76, 175, 80, 0.15); border: 1px solid var(--android-color); color: var(--android-color); padding: 3px 10px; border-radius: 4px; font-size: 0.75em; cursor: pointer; font-weight: bold;">
                                    <i class="fas fa-copy"></i> Copy Clean Hex (Neo Store / Droid-ify)
                                </button>
                                <button type="button" onclick="copyRepoUrl('<%= formattedFp %>', this)" style="background: none; border: 1px solid #444; color: var(--silver); padding: 3px 10px; border-radius: 4px; font-size: 0.75em; cursor: pointer;">
                                    <i class="fas fa-copy"></i> Copy Formatted
                                </button>
                            </div>
                        </div>
                        <div style="font-family: monospace; font-size: 0.85em; color: #a0aec0; word-break: break-all; line-height: 1.4;">
                            <%= formattedFp %>
                        </div>
                        <div style="font-family: monospace; font-size: 0.78em; color: #718096; word-break: break-all; margin-top: 5px;">
                            Raw Hex (No colons): <%= cleanFp %>
                        </div>
                    </div>
                    <% } %>

                    <!-- ✅ Buttons Grid with Direct Client Integration & Copy -->
                    <div class="repo-buttons-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">

                        <a href="https://fdroid.link/#<%= fullRepoUrlWithFp %>" target="_blank" rel="noopener noreferrer" class="repo-btn"
                            style="border-color: #60a5fa; color: #60a5fa; background: rgba(96, 165, 250, 0.1);">
                            <i class="fas fa-external-link-alt"></i> Open in fdroid.link
                        </a>

                        <a href="<%= clientIntentUrl %>" class="repo-btn"
                            style="border-color: var(--android-color);">
                            <img src="<%= cdnUrl %>/images/icons/droidify.png" alt="Droid-ify" class="repo-icon"> Add to
                            Droid-ify
                        </a>

                        <a href="<%= clientIntentUrl %>" class="repo-btn"
                            style="border-color: var(--android-color);">
                            <img src="<%= cdnUrl %>/images/icons/neostore.png" alt="Neo Store" class="repo-icon"> Add to
                            Neo Store
                        </a>

                        <a href="<%= clientIntentUrl %>" class="repo-btn"
                            style="border-color: var(--android-color);">
                            <img src="<%= cdnUrl %>/images/icons/f-droid.png" alt="F-Droid" class="repo-icon"> Add to
                            F-Droid
                        </a>

                        <button type="button" class="repo-btn" id="copy-android-repo-btn" onclick="copyRepoUrl('<%= fullRepoUrlWithFp %>', this)"
                            style="border-color: #555; background: #222; cursor: pointer;">
                            <i class="fas fa-copy" style="color: var(--silver);"></i> <span id="copy-btn-text">Copy Repo URL</span>
                        </button>

                    </div>
                </div>

                <script>
                    function copyRepoUrl(url, btn) {
                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            navigator.clipboard.writeText(url).then(function() {
                                showCopiedState(btn);
                            }).catch(function() {
                                fallbackCopy(url, btn);
                            });
                        } else {
                            fallbackCopy(url, btn);
                        }
                    }
                    function showCopiedState(btn) {
                        var textSpan = btn.querySelector('#copy-btn-text') || btn;
                        var orig = textSpan.innerText;
                        textSpan.innerText = 'Copied!';
                        btn.style.borderColor = 'var(--android-color)';
                        btn.style.color = 'var(--android-color)';
                        setTimeout(function() {
                            textSpan.innerText = orig;
                            btn.style.borderColor = '#555';
                            btn.style.color = 'var(--silver)';
                        }, 2500);
                    }
                    function fallbackCopy(text, btn) {
                        var t = document.createElement("textarea");
                        t.value = text;
                        t.style.position = "fixed";
                        t.style.opacity = "0";
                        document.body.appendChild(t);
                        t.select();
                        try { document.execCommand('copy'); showCopiedState(btn); } catch (e) {}
                        document.body.removeChild(t);
                    }
                </script>

                <h3
                    style="color: var(--white); margin-bottom: 15px; border-bottom: 1px solid #333; padding-bottom: 10px;">
                    Available in this Repository:</h3>
                <div class="mod-grid">
                    <% if (androidFiles.length> 0) { %>
                        <% androidFiles.forEach(file=> { %>
                            <%- include('../partials/mod-card', { file: file }) %>
                                <% }) %>
                                    <% } else { %>
                                        <p style="color: var(--silver); grid-column: 1/-1; text-align: center;">No APK
                                            files are currently configured for the repository.</p>
                                        <% } %>
                </div>
            </section>

    </main>
    <%- include('../partials/popunder-ads') %>
        <%- include('../partials/video-ad-modal') %>
            <%- include('../partials/footer') %>