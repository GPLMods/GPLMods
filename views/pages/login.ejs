<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - GPL Mods</title>
    
    <!-- Fonts and Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="apple-touch-icon" href="/favicon.png">
    
    <!-- ✅ ADDED: Global Stylesheet for Footer & Common Styles -->
    <link rel="stylesheet" href="/css/style.css">
<!-- ✅ FIX 6: Ensure FontAwesome is included so footer icons render! -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />


    <!-- Add reCAPTCHA script -->
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <!-- jsQR for GPL Card Login Scanner -->
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
    
    <style>
        /* Local overrides for the Auth Page */
        :root {
            --error: #ff4d4d;
            --success: #2ecc71;
        }

        /* ✅ FIXED: Changed body layout so the footer stays at the bottom */
        body { 
            font-family: 'Poppins', sans-serif; 
            background-color: var(--black); 
            color: var(--white); 
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        /* ✅ FIXED: Created a wrapper to center the form without breaking the footer */
        .auth-page-wrapper {
            flex-grow: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        /* Form Container - Matches Sign Up */
        .auth-container { 
            width: 100%;
            max-width: 450px; 
            background-color: var(--dark-gray); 
            padding: 40px; 
            border-radius: 15px; 
            border: 1px solid #2a2a2a;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .logo-area {
            text-align: center;
            margin-bottom: 20px;
            font-size: 1.8em;
            font-weight: 700;
            color: var(--gold);
            text-shadow: 0 0 4px rgba(255, 215, 0, 0.32);
            text-decoration: none;
            display: block;
        }
        .logo-area span { 
            color: var(--silver); 
            text-shadow: 0 0 3px rgba(255, 255, 255, 0.15); 
        }
        .logo { font-size: 1.8em; font-weight: 700; color: var(--gold); text-shadow: 0 0 4px rgba(255, 215, 0, 0.32); text-decoration: none; }
        .logo span { color: var(--silver); text-shadow: 0 0 3px rgba(255, 255, 255, 0.15); }
        .form-container h2 { text-align: center; font-size: 1.8em; margin-bottom: 25px; }
        
        .form-group { margin-bottom: 20px; position: relative; }
        .form-group label { display: block; margin-bottom: 8px; font-weight: 600; color: var(--silver); font-size: 0.9em; }
        .form-group input { width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid #333; background-color: var(--black); color: var(--white); font-size: 1em; }
        .form-group input:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 10px var(--glow-gold); }

        .submit-button { 
            display: block; 
            width: 100%; 
            background: var(--gold); 
            color: var(--black); 
            padding: 14px 20px; 
            border-radius: 8px; 
            font-size: 1.1em; 
            font-weight: 700; 
            border: none; 
            cursor: pointer; 
            transition: all 0.3s ease; 
            margin-top: 10px;
        }
        .submit-button:hover { transform: translateY(-2px); box-shadow: 0 0 20px var(--glow-gold); }

        /* Divider - Matches Sign Up */
        .divider {
            text-align: center;
            margin: 20px 0;
            position: relative;
            color: #666;
            font-size: 0.9em;
        }
        .divider::before, .divider::after {
            content: "";
            position: absolute;
            top: 50%;
            width: 40%;
            height: 1px;
            background: #333;
        }
        .divider::before { left: 0; }
        .divider::after { right: 0; }

        /* Custom Social Sign-In Buttons (Ghost Style) */
        .social-signin-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%;
            padding: 12px;
            margin-bottom: 12px; /* Reduced slightly to fit 3 buttons nicely */
            background-color: transparent; 
            border: 2px solid var(--silver); 
            color: var(--silver);           
            border-radius: 8px;
            font-size: 1.1em;
            font-weight: 600;
            font-family: 'Poppins', sans-serif;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .social-signin-btn:hover {
            background-color: var(--gold);
            border-color: var(--gold);
            color: var(--black); 
            box-shadow: 0 0 15px var(--glow-gold);
        }

        .social-signin-btn .social-icon {
            width: 24px;
            height: 24px;
            fill: currentColor; /* This makes the SVG inherit the text color! */
        }

        .form-switch { text-align: center; margin-top: 25px; color: var(--silver); font-size: 0.9em; }
        .form-switch a { color: var(--gold); text-decoration: none; font-weight: 600; }
        .form-switch a:hover { text-decoration: underline; }

        @media (max-width: 480px) {
            .auth-container { padding: 25px; border-radius: 0; border: none; box-shadow: none; }
            .auth-page-wrapper { padding: 0; align-items: flex-start; }
        }

        .form-switch { text-align: center; margin-top: 25px; color: var(--silver); font-size: 0.9em; }
        .form-switch a { color: var(--gold); text-decoration: none; font-weight: 600; }
        .form-switch a:hover { text-decoration: underline; }

        /* Adjust reCAPTCHA alignment if needed */
        .g-recaptcha {
            display: flex;
            justify-content: center;
            margin-bottom: 15px;
        }

        /* GPL Card Login Modal & Dropzone */
        .gpl-card-modal {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 999999;
            padding: 20px;
            box-sizing: border-box;
        }
        .gpl-card-modal-backdrop {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(8px);
        }
        .gpl-card-modal-dialog {
            position: relative;
            background: #16161a;
            border: 1.5px solid rgba(255, 215, 0, 0.45);
            border-radius: 16px;
            width: 100%;
            max-width: 480px;
            padding: 26px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9), 0 0 30px rgba(255, 215, 0, 0.15);
            z-index: 2;
            box-sizing: border-box;
            animation: gplModalPop 0.25s ease-out;
        }
        @keyframes gplModalPop {
            from { opacity: 0; transform: scale(0.95) translateY(10px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }
        .gpl-card-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 215, 0, 0.2);
            padding-bottom: 14px;
            margin-bottom: 18px;
        }
        .gpl-card-close-btn {
            background: transparent;
            border: none;
            color: var(--silver);
            font-size: 1.8em;
            cursor: pointer;
            line-height: 1;
            padding: 0 4px;
            transition: color 0.2s;
        }
        .gpl-card-close-btn:hover { color: var(--gold); }
        .gpl-card-dropzone {
            border: 2px dashed rgba(255, 215, 0, 0.45);
            border-radius: 12px;
            padding: 30px 20px;
            text-align: center;
            background: rgba(0, 0, 0, 0.35);
            cursor: pointer;
            transition: all 0.25s ease;
        }
        .gpl-card-dropzone:hover, .gpl-card-dropzone.dragover {
            border-color: var(--gold);
            background: rgba(255, 215, 0, 0.08);
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.2);
        }
        .dropzone-icon {
            font-size: 2.8em;
            color: var(--gold);
            margin-bottom: 12px;
        }
        .dropzone-title {
            font-size: 1em;
            font-weight: 600;
            color: var(--white);
            margin: 0 0 6px 0;
        }
        .dropzone-sub {
            font-size: 0.82em;
            color: var(--silver);
            margin: 0;
        }
        .scanning-spinner {
            font-size: 2.4em;
            color: var(--gold);
        }

        /* GPL Card Scanner Mode Tabs */
        .gpl-card-tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 16px;
            background: rgba(0, 0, 0, 0.45);
            padding: 4px;
            border-radius: 10px;
            border: 1px solid rgba(255, 215, 0, 0.25);
        }
        .gpl-card-tab-btn {
            flex: 1;
            padding: 9px 12px;
            background: transparent;
            border: none;
            color: var(--silver);
            font-size: 0.88em;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.25s ease;
        }
        .gpl-card-tab-btn.active {
            background: var(--gold);
            color: var(--black);
            box-shadow: 0 0 12px rgba(255, 215, 0, 0.35);
        }

        /* Camera Viewport & Cyber Viewfinder */
        .gpl-camera-container {
            position: relative;
            width: 100%;
            height: 270px;
            background: #000;
            border-radius: 12px;
            overflow: hidden;
            border: 1.5px solid rgba(255, 215, 0, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: border-color 0.3s;
        }
        .gpl-camera-container.scan-success {
            border-color: #2ecc71;
            box-shadow: 0 0 25px rgba(46, 204, 113, 0.6);
        }
        #gplCameraVideo {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .gpl-camera-overlay {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            pointer-events: none;
        }
        .viewfinder-frame {
            position: relative;
            width: 185px;
            height: 185px;
            border: 1.5px dashed rgba(255, 215, 0, 0.4);
            border-radius: 16px;
            box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.52);
        }
        .viewfinder-frame::before {
            content: '';
            position: absolute;
            top: -2px; left: -2px; right: -2px; bottom: -2px;
            border-radius: 16px;
            background: 
                linear-gradient(to right, var(--gold) 16px, transparent 16px) top left,
                linear-gradient(to bottom, var(--gold) 16px, transparent 16px) top left,
                linear-gradient(to left, var(--gold) 16px, transparent 16px) top right,
                linear-gradient(to bottom, var(--gold) 16px, transparent 16px) top right,
                linear-gradient(to right, var(--gold) 16px, transparent 16px) bottom left,
                linear-gradient(to top, var(--gold) 16px, transparent 16px) bottom left,
                linear-gradient(to left, var(--gold) 16px, transparent 16px) bottom right,
                linear-gradient(to top, var(--gold) 16px, transparent 16px) bottom right;
            background-repeat: no-repeat;
            background-size: 18px 18px;
            pointer-events: none;
        }
        /* Sweeping laser line */
        .laser-scan-line {
            position: absolute;
            left: 5%;
            right: 5%;
            height: 2.5px;
            background: linear-gradient(90deg, transparent 0%, var(--gold) 50%, transparent 100%);
            box-shadow: 0 0 10px var(--gold), 0 0 18px rgba(255, 215, 0, 0.6);
            animation: sweepLaser 2s ease-in-out infinite alternate;
        }
        @keyframes sweepLaser {
            0% { top: 10px; opacity: 0.2; }
            50% { opacity: 1; }
            100% { top: 165px; opacity: 0.2; }
        }
        .camera-hint-badge {
            margin-top: 14px;
            padding: 4px 12px;
            border-radius: 20px;
            background: rgba(0, 0, 0, 0.75);
            border: 1px solid rgba(255, 215, 0, 0.35);
            color: #f1f5f9;
            font-size: 0.74em;
            letter-spacing: 0.5px;
            text-align: center;
        }
        .camera-controls-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 12px;
            gap: 10px;
        }
        .camera-action-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: var(--silver);
            padding: 8px 14px;
            border-radius: 8px;
            font-size: 0.85em;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }
        .camera-action-btn:hover {
            border-color: var(--gold);
            color: var(--gold);
            background: rgba(255, 215, 0, 0.1);
        }

        @media (max-width: 480px) {
            .auth-container { padding: 25px; border-radius: 0; border: none; box-shadow: none; }
            .auth-page-wrapper { padding: 0; align-items: flex-start; }
            .gpl-card-modal-dialog { padding: 20px; }
            .gpl-camera-container { height: 230px; }
            .viewfinder-frame { width: 160px; height: 160px; }
        }
    </style>
    <!-- jsQR Library for scanning QR code directly from uploaded ID card -->
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
</head>
<body>

    <!-- ✅ ADDED: Wrapper that pushes the footer to the bottom -->
    <main class="auth-page-wrapper">
        <div class="auth-container">
    <!-- ======== GO BACK BUTTON ======== -->
    <div class="back-btn-wrapper">
        <a href="/" class="dynamic-back-btn" onclick="event.preventDefault(); smartGoBack('/');">
            <i class="fas fa-arrow-left"></i> Go Back
        </a>
    </div>
    <!-- ======================================== -->
            <a href="/" class="logo-area">GPL <span>Mods</span></a>
            
            <section class="form-container">
                <h2>Welcome Back</h2>

                  <!-- ======== ADD THIS NEW ERROR BLOCK ======== -->
                <% if (typeof error !== 'undefined' && error) { %>
                    <p style="padding: 10px; background-color: rgba(229, 57, 53, 0.1); border: 1px solid var(--red); text-align: center; margin-bottom: 1rem; border-radius: 8px; font-size: 0.9em; color: var(--red); font-weight: bold;">
                        <%= error %>
                    </p>
                <% } %>
                <!-- ========================================== -->

                <!-- Updated Form Attributes -->
                <form id="login-form" action="/login" method="POST">
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="e.g. youremail@example.com" required>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="********" required>
                        <!-- Forgot Password Link -->
                        <div style="text-align: right; margin-top: 8px;">
                            <a href="/forgot-password" style="color: var(--silver); font-size: 0.85em; text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='var(--gold)'" onmouseout="this.style.color='var(--silver)'">Forgot Password?</a>
                        </div>
                    </div>

                    <!-- reCAPTCHA integration -->
                    <div class="form-group">
                        <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>"></div>
                    </div>

                    <button type="submit" class="submit-button">Login</button>
                </form>

                <div class="divider">or</div>

                <!-- Google Login -->
                <a href="/auth/google" class="social-signin-btn">
                    <svg class="social-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M21.35,11.1H12.18V13.83H18.69C18.36,17.64 15.19,19.27 12.19,19.27C8.36,19.27 5,16.25 5,12C5,7.9 8.2,4.73 12,4.73C15.29,4.73 17.1,6.7 17.1,6.7L19,4.72C19,4.72 16.56,2 12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,11.63 21.95,11.36 21.89,11.1H21.35Z"/>
                    </svg>
                    <span>Continue with Google</span>
                </a>

                <!-- GitHub Login -->
                <a href="/auth/github" class="social-signin-btn">
                    <svg class="social-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.379.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
                    </svg>
                    <span>Continue with GitHub</span>
                </a>

                <!-- Microsoft Login -->
                <a href="/auth/microsoft" class="social-signin-btn">
                    <svg class="social-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M11.4 24H0V12.6h11.4V24zM24 24H12.6V12.6H24V24zM11.4 11.4H0V0h11.4v11.4zm12.6 0H12.6V0H24v11.4z"/>
                    </svg>
                    <span>Continue with Microsoft</span>
                </a>

                <!-- GPL Card Login -->
                <button type="button" id="btn-open-gpl-card-modal" class="social-signin-btn" style="border-color: var(--gold); color: var(--gold); background: rgba(255, 215, 0, 0.05);">
                    <i class="fas fa-id-card" style="font-size: 1.25em;"></i>
                    <span>Login with GPL Card</span>
                </button>

                <p class="form-switch">Need an account? <a href="/register">Sign Up</a></p>
            </section>
        </div>
    </main>

    <!-- ======== GPL CARD LOGIN MODAL ======== -->
    <div id="gpl-card-modal" class="gpl-card-modal" style="display: none;">
        <div class="gpl-card-modal-backdrop" id="gpl-card-backdrop"></div>
        <div class="gpl-card-modal-dialog">
            <div class="gpl-card-modal-header">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <i class="fas fa-id-card" style="color: var(--gold); font-size: 1.4em;"></i>
                    <div>
                        <h3 style="margin: 0; color: var(--gold); font-size: 1.2em;">Login with GPL Card</h3>
                        <p style="margin: 2px 0 0 0; color: var(--silver); font-size: 0.8em;">Scan via Camera or Upload your ID Card</p>
                    </div>
                </div>
                <button type="button" id="btn-close-gpl-card-modal" class="gpl-card-close-btn" aria-label="Close">&times;</button>
            </div>

            <div class="gpl-card-modal-body">
                <!-- Mode Tabs: Camera Scan vs Upload File -->
                <div class="gpl-card-tabs">
                    <button type="button" class="gpl-card-tab-btn active" id="tabBtnCamera">
                        <i class="fas fa-camera"></i> Scan with Camera
                    </button>
                    <button type="button" class="gpl-card-tab-btn" id="tabBtnUpload">
                        <i class="fas fa-file-upload"></i> Upload Card File
                    </button>
                </div>

                <!-- Status / Alert Message -->
                <div id="card-scan-alert" style="display: none; padding: 12px; border-radius: 8px; font-size: 0.88em; margin-bottom: 15px; text-align: center; font-weight: 600;"></div>

                <!-- VIEW 1: Live Camera Scanner -->
                <div id="camera-scanner-view" style="display: block;">
                    <div class="gpl-camera-container" id="gplCameraContainer">
                        <video id="gplCameraVideo" playsinline autoplay muted></video>
                        <canvas id="gplCameraCanvas" style="display: none;"></canvas>
                        <div class="gpl-camera-overlay">
                            <div class="viewfinder-frame">
                                <div class="laser-scan-line"></div>
                            </div>
                            <span class="camera-hint-badge">
                                <i class="fas fa-qrcode" style="color: var(--gold); margin-right: 4px;"></i> Align Private Mode QR in frame
                            </span>
                        </div>
                    </div>
                    <div class="camera-controls-bar">
                        <button type="button" class="camera-action-btn" id="btnFlipCamera" title="Switch Front/Back Camera">
                            <i class="fas fa-sync-alt"></i> <span>Flip Camera</span>
                        </button>
                        <button type="button" class="camera-action-btn" id="btnToggleScanner" style="border-color: var(--gold); color: var(--gold);">
                            <i class="fas fa-pause"></i> <span>Pause Scanner</span>
                        </button>
                    </div>
                </div>

                <!-- VIEW 2: Dropzone for Card Upload -->
                <div id="upload-file-view" style="display: none;">
                    <div id="gpl-card-dropzone" class="gpl-card-dropzone">
                        <input type="file" id="gplCardFileInput" accept="image/png, image/jpeg, image/webp" style="display: none;">
                        <div class="dropzone-content" id="dropzone-default-view">
                            <i class="fas fa-cloud-upload-alt dropzone-icon"></i>
                            <p class="dropzone-title">Drag &amp; drop your GPL ID Card here, or <span style="color: var(--gold); text-decoration: underline;">Browse</span></p>
                            <p class="dropzone-sub">Supports PNG, JPG or WebP exported in <strong>Private Mode (Quick Login)</strong></p>
                        </div>
                        <!-- Live Scanning State -->
                        <div class="dropzone-scanning" id="dropzone-scanning-view" style="display: none;">
                            <i class="fas fa-spinner fa-spin scanning-spinner"></i>
                            <p style="color: var(--white); font-weight: 600; margin-top: 10px;">Scanning card credentials &amp; QR code...</p>
                            <p style="color: var(--silver); font-size: 0.82em;">Verifying digital credential</p>
                        </div>
                    </div>

                    <!-- Preview thumbnail if loaded -->
                    <div id="card-preview-wrapper" style="display: none; margin-top: 15px; text-align: center;">
                        <img id="card-preview-thumb" src="" alt="Card Preview" style="max-width: 130px; max-height: 180px; border-radius: 8px; border: 1px solid var(--gold); box-shadow: 0 4px 15px rgba(0,0,0,0.5);">
                    </div>
                </div>

                <div style="margin-top: 18px; text-align: center;">
                    <p style="font-size: 0.8em; color: var(--silver); margin: 0; line-height: 1.5;">
                        <i class="fas fa-shield-alt" style="color: var(--gold);"></i> 
                        Cards skip entering login email &amp; password. If 2FA is active, you will proceed to 2-Factor Authentication.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ ADDED: Footer properly included at the bottom -->
    <%- include('../partials/footer') %>

    <script>
        function smartGoBack(fallbackUrl) {
            const fallback = fallbackUrl || '/';
            if (document.referrer && document.referrer !== window.location.href) {
                try {
                    const refUrl = new URL(document.referrer);
                    const currentUrl = new URL(window.location.href);
                    if (refUrl.origin === currentUrl.origin) {
                        const trapPaths = ['/login', '/register', '/logout', '/login/2fa', '/admin'];
                        const isTrap = trapPaths.some(p => refUrl.pathname.startsWith(p));
                        if (!isTrap && refUrl.pathname !== currentUrl.pathname) {
                            window.location.href = document.referrer;
                            return;
                        }
                    }
                } catch (e) {}
            }
            if (window.history.length > 1) {
                const prevLoc = window.location.href;
                window.history.back();
                setTimeout(() => {
                    if (window.location.href === prevLoc) {
                        window.location.href = fallback;
                    }
                }, 300);
            } else {
                window.location.href = fallback;
            }
        }

        // ======== GPL CARD LOGIN CONTROLLER ========
        (function() {
            const openBtn = document.getElementById('btn-open-gpl-card-modal');
            const closeBtn = document.getElementById('btn-close-gpl-card-modal');
            const backdrop = document.getElementById('gpl-card-backdrop');
            const modal = document.getElementById('gpl-card-modal');
            const alertBox = document.getElementById('card-scan-alert');

            // Tabs
            const tabBtnCamera = document.getElementById('tabBtnCamera');
            const tabBtnUpload = document.getElementById('tabBtnUpload');
            const cameraScannerView = document.getElementById('camera-scanner-view');
            const uploadFileView = document.getElementById('upload-file-view');

            // Camera elements
            const video = document.getElementById('gplCameraVideo');
            const canvas = document.getElementById('gplCameraCanvas');
            const cameraContainer = document.getElementById('gplCameraContainer');
            const btnFlipCamera = document.getElementById('btnFlipCamera');
            const btnToggleScanner = document.getElementById('btnToggleScanner');

            // Dropzone elements
            const dropzone = document.getElementById('gpl-card-dropzone');
            const fileInput = document.getElementById('gplCardFileInput');
            const defaultView = document.getElementById('dropzone-default-view');
            const scanningView = document.getElementById('dropzone-scanning-view');
            const previewWrapper = document.getElementById('card-preview-wrapper');
            const previewThumb = document.getElementById('card-preview-thumb');

            // State
            let cameraStream = null;
            let isScanning = false;
            let isPaused = false;
            let currentFacingMode = 'environment'; // 'environment' (back) or 'user' (selfie/webcam)
            let scanAnimFrame = null;
            let activeTab = 'camera'; // 'camera' or 'upload'

            if (!openBtn || !modal) return;

            function showAlert(msg, isError) {
                if (!alertBox) return;
                alertBox.style.display = 'block';
                alertBox.style.backgroundColor = isError ? 'rgba(255, 77, 77, 0.15)' : 'rgba(46, 204, 113, 0.15)';
                alertBox.style.border = isError ? '1px solid #ff4d4d' : '1px solid #2ecc71';
                alertBox.style.color = isError ? '#ff4d4d' : '#2ecc71';
                alertBox.innerHTML = msg;
            }

            function hideAlert() {
                if (alertBox) alertBox.style.display = 'none';
            }

            function setScanningState(isScann) {
                if (isScann) {
                    if (defaultView) defaultView.style.display = 'none';
                    if (scanningView) scanningView.style.display = 'block';
                    if (dropzone) dropzone.style.pointerEvents = 'none';
                } else {
                    if (defaultView) defaultView.style.display = 'block';
                    if (scanningView) scanningView.style.display = 'none';
                    if (dropzone) dropzone.style.pointerEvents = 'auto';
                }
            }

            // Tab Switching
            function switchTab(tab) {
                activeTab = tab;
                hideAlert();
                if (tab === 'camera') {
                    if (tabBtnCamera) tabBtnCamera.classList.add('active');
                    if (tabBtnUpload) tabBtnUpload.classList.remove('active');
                    if (cameraScannerView) cameraScannerView.style.display = 'block';
                    if (uploadFileView) uploadFileView.style.display = 'none';
                    startCameraScanner();
                } else {
                    if (tabBtnUpload) tabBtnUpload.classList.add('active');
                    if (tabBtnCamera) tabBtnCamera.classList.remove('active');
                    if (uploadFileView) uploadFileView.style.display = 'block';
                    if (cameraScannerView) cameraScannerView.style.display = 'none';
                    stopCameraScanner();
                }
            }

            if (tabBtnCamera) tabBtnCamera.addEventListener('click', () => switchTab('camera'));
            if (tabBtnUpload) tabBtnUpload.addEventListener('click', () => switchTab('upload'));

            // Camera Engine
            async function startCameraScanner() {
                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                    showAlert('Camera access is not supported by your browser or environment. Please upload your card image instead.', true);
                    switchTab('upload');
                    return;
                }

                stopCameraScanner();
                isPaused = false;
                if (btnToggleScanner) {
                    btnToggleScanner.innerHTML = '<i class="fas fa-pause"></i> <span>Pause Scanner</span>';
                }

                try {
                    const constraints = {
                        video: {
                            facingMode: { ideal: currentFacingMode },
                            width: { ideal: 1280 },
                            height: { ideal: 720 }
                        }
                    };
                    const stream = await navigator.mediaDevices.getUserMedia(constraints);
                    cameraStream = stream;
                    if (video) {
                        video.srcObject = stream;
                        video.setAttribute('playsinline', 'true');
                        await video.play();
                    }
                    isScanning = true;
                    if (cameraContainer) cameraContainer.classList.remove('scan-success');
                    scanCameraLoop();
                } catch (err) {
                    console.warn('Camera access error:', err);
                    if (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
                        showAlert('Camera permission was denied. Please allow camera access in your browser or switch to "Upload Card File".', true);
                    } else if (err.name === 'NotFoundError' || err.name === 'DevicesNotFoundError') {
                        showAlert('No camera device detected on your system. Please upload your card file instead.', true);
                        switchTab('upload');
                    } else {
                        showAlert('Unable to open camera stream (' + (err.message || 'Error') + '). Please upload your card file instead.', true);
                    }
                }
            }

            function stopCameraScanner() {
                isScanning = false;
                if (scanAnimFrame) {
                    cancelAnimationFrame(scanAnimFrame);
                    scanAnimFrame = null;
                }
                if (cameraStream) {
                    try {
                        cameraStream.getTracks().forEach(track => track.stop());
                    } catch (e) {}
                    cameraStream = null;
                }
                if (video) {
                    video.srcObject = null;
                }
                if (cameraContainer) cameraContainer.classList.remove('scan-success');
            }

            function scanCameraLoop() {
                if (!isScanning) return;

                if (!isPaused && video && video.readyState === video.HAVE_ENOUGH_DATA && canvas) {
                    const ctx = canvas.getContext('2d', { willReadFrequently: true });
                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;
                    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

                    const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                    if (typeof jsQR !== 'undefined') {
                        const code = jsQR(imageData.data, imageData.width, imageData.height, {
                            inversionAttempts: 'attemptBoth'
                        });

                        if (code && code.data) {
                            handleDetectedQr(code.data);
                            return; // Stop animation loop until verification finishes
                        }
                    }
                }

                scanAnimFrame = requestAnimationFrame(scanCameraLoop);
            }

            function handleDetectedQr(qrData) {
                // Check if user scanned public profile link by accident
                if (qrData.includes('?ref=card') || (qrData.includes('/users/') && !qrData.includes('/qr-login/'))) {
                    showAlert('<strong>Notice:</strong> This is a Public Profile QR code.<br>Please scan the <strong>Private Mode (Quick Login)</strong> QR code to sign in.', true);
                    // Pause for 3.5 seconds to let user read
                    isPaused = true;
                    setTimeout(() => {
                        isPaused = false;
                        if (isScanning) scanCameraLoop();
                    }, 3500);
                    return;
                }

                // QR Detected! Provide feedback
                if (cameraContainer) cameraContainer.classList.add('scan-success');
                if (navigator.vibrate) {
                    try { navigator.vibrate([70, 40, 70]); } catch (e) {}
                }

                stopCameraScanner();
                submitCardToken(qrData);
            }

            // Flip camera button
            if (btnFlipCamera) {
                btnFlipCamera.addEventListener('click', () => {
                    currentFacingMode = (currentFacingMode === 'environment' ? 'user' : 'environment');
                    if (video) {
                        video.style.transform = currentFacingMode === 'user' ? 'scaleX(-1)' : 'scaleX(1)';
                    }
                    startCameraScanner();
                });
            }

            // Pause / Resume camera scanner button
            if (btnToggleScanner) {
                btnToggleScanner.addEventListener('click', () => {
                    isPaused = !isPaused;
                    if (isPaused) {
                        btnToggleScanner.innerHTML = '<i class="fas fa-play"></i> <span>Resume Scanner</span>';
                        btnToggleScanner.style.color = '#2ecc71';
                        btnToggleScanner.style.borderColor = '#2ecc71';
                    } else {
                        btnToggleScanner.innerHTML = '<i class="fas fa-pause"></i> <span>Pause Scanner</span>';
                        btnToggleScanner.style.color = 'var(--gold)';
                        btnToggleScanner.style.borderColor = 'var(--gold)';
                        if (isScanning) scanCameraLoop();
                    }
                });
            }

            function resetModal() {
                hideAlert();
                setScanningState(false);
                stopCameraScanner();
                if (previewWrapper) previewWrapper.style.display = 'none';
                if (previewThumb) previewThumb.src = '';
                if (fileInput) fileInput.value = '';
            }

            function openModal() {
                resetModal();
                modal.style.display = 'flex';
                // Start with Camera view by default
                switchTab('camera');
            }

            function closeModal() {
                modal.style.display = 'none';
                resetModal();
            }

            openBtn.addEventListener('click', openModal);
            if (closeBtn) closeBtn.addEventListener('click', closeModal);
            if (backdrop) backdrop.addEventListener('click', closeModal);

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && modal.style.display === 'flex') {
                    closeModal();
                }
            });

            // Stop camera if page is navigated away or unloaded
            window.addEventListener('beforeunload', stopCameraScanner);

            // Dropzone click & drag-and-drop
            if (dropzone && fileInput) {
                dropzone.addEventListener('click', () => fileInput.click());

                ['dragenter', 'dragover'].forEach(eventName => {
                    dropzone.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.add('dragover');
                    }, false);
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    dropzone.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.remove('dragover');
                    }, false);
                });

                dropzone.addEventListener('drop', (e) => {
                    const dt = e.dataTransfer;
                    if (dt && dt.files && dt.files.length > 0) {
                        processCardFile(dt.files[0]);
                    }
                });

                fileInput.addEventListener('change', (e) => {
                    if (fileInput.files && fileInput.files.length > 0) {
                        processCardFile(fileInput.files[0]);
                    }
                });
            }

            function processCardFile(file) {
                if (!file || !file.type.startsWith('image/')) {
                    showAlert('Please select a valid image file (PNG, JPG, or WebP).', true);
                    return;
                }

                hideAlert();
                setScanningState(true);

                const reader = new FileReader();
                reader.onerror = () => {
                    setScanningState(false);
                    showAlert('Failed to read image file. Please try again.', true);
                };

                reader.onload = (e) => {
                    const img = new Image();
                    img.onload = () => {
                        if (previewWrapper && previewThumb) {
                            previewThumb.src = e.target.result;
                            previewWrapper.style.display = 'block';
                        }
                        scanImageForQr(img);
                    };
                    img.onerror = () => {
                        setScanningState(false);
                        showAlert('Invalid image content.', true);
                    };
                    img.src = e.target.result;
                };

                reader.readAsDataURL(file);
            }

            function scanImageForQr(img) {
                if (typeof jsQR === 'undefined') {
                    setScanningState(false);
                    showAlert('Scanner library not loaded. Please check your internet connection.', true);
                    return;
                }

                try {
                    const c = document.createElement('canvas');
                    const ctx = c.getContext('2d', { willReadFrequently: true });
                    c.width = img.naturalWidth || img.width;
                    c.height = img.naturalHeight || img.height;
                    ctx.drawImage(img, 0, 0, c.width, c.height);

                    const imageData = ctx.getImageData(0, 0, c.width, c.height);
                    let code = jsQR(imageData.data, imageData.width, imageData.height, {
                        inversionAttempts: 'attemptBoth'
                    });

                    // If not found and image is high resolution, try downscaling
                    if (!code && (c.width > 1200 || c.height > 1200)) {
                        const scale = Math.min(1000 / c.width, 1000 / c.height);
                        const scaledCanvas = document.createElement('canvas');
                        scaledCanvas.width = Math.round(c.width * scale);
                        scaledCanvas.height = Math.round(c.height * scale);
                        const sCtx = scaledCanvas.getContext('2d', { willReadFrequently: true });
                        sCtx.drawImage(img, 0, 0, scaledCanvas.width, scaledCanvas.height);
                        const sData = sCtx.getImageData(0, 0, scaledCanvas.width, scaledCanvas.height);
                        code = jsQR(sData.data, sData.width, sData.height, {
                            inversionAttempts: 'attemptBoth'
                        });
                    }

                    if (code && code.data) {
                        if (code.data.includes('?ref=card') || (code.data.includes('/users/') && !code.data.includes('/qr-login/'))) {
                            setScanningState(false);
                            showAlert('<strong>Notice:</strong> This is a Public Profile QR code.<br>Please scan or upload a card exported in <strong>Private Mode (Quick Login)</strong> to sign in.', true);
                            return;
                        }
                        submitCardToken(code.data);
                    } else {
                        setScanningState(false);
                        showAlert('No valid GPL ID card QR code found.<br><span style="font-weight: normal; font-size: 0.85em;">Ensure your ID card was exported in <strong>Private Mode (Quick Login)</strong>.</span>', true);
                    }
                } catch (err) {
                    console.error('Error scanning card QR:', err);
                    setScanningState(false);
                    showAlert('Error analyzing card image. Please try again.', true);
                }
            }

            async function submitCardToken(qrData) {
                showAlert('<i class="fas fa-spinner fa-spin"></i> Card credential detected. Authenticating...', false);
                try {
                    const res = await fetch('/auth/card-login', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({ cardLoginToken: qrData })
                    });

                    const data = await res.json();
                    if (res.ok && data.success) {
                        showAlert('<i class="fas fa-check-circle"></i> Verification successful! Logging in...', false);
                        setTimeout(() => {
                            window.location.href = data.redirect || '/home';
                        }, 500);
                    } else {
                        setScanningState(false);
                        showAlert(data.error || 'Authentication failed for this ID card.', true);
                    }
                } catch (err) {
                    console.error('Network error submitting card login:', err);
                    setScanningState(false);
                    showAlert('Network error while validating card. Please try again.', true);
                }
            }
        })();
    </script>
</body>
</html>