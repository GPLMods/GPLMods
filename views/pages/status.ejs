<%- include('../partials/header') %>

<style>
    .public-status-wrapper {
        max-width: 960px;
        margin: 2.5rem auto 4rem;
        padding: 0 16px;
    }

    .public-status-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .public-status-header h1 {
        font-size: 2.2rem;
        color: var(--white);
        margin: 0 0 8px 0;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .logo-gold-glow {
        color: var(--gold);
        text-shadow: 0 0 14px rgba(255, 215, 0, 0.45);
    }

    .logo-silver-glow {
        color: var(--silver);
        text-shadow: 0 0 14px rgba(192, 192, 192, 0.4);
    }

    .public-status-subtitle {
        color: var(--silver);
        font-size: 0.95rem;
        margin: 0;
    }

    /* Hero Status Banner */
    .status-banner {
        border-radius: 14px;
        padding: 24px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2rem;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
        position: relative;
        overflow: hidden;
        border: 1px solid;
    }

    .status-banner.is-operational {
        background: linear-gradient(135deg, rgba(46, 204, 113, 0.12) 0%, rgba(18, 20, 28, 0.9) 100%);
        border-color: rgba(46, 204, 113, 0.4);
    }

    .status-banner.is-degraded {
        background: linear-gradient(135deg, rgba(255, 215, 0, 0.12) 0%, rgba(18, 20, 28, 0.9) 100%);
        border-color: rgba(255, 215, 0, 0.4);
    }

    .status-banner.is-outage {
        background: linear-gradient(135deg, rgba(231, 76, 60, 0.14) 0%, rgba(18, 20, 28, 0.9) 100%);
        border-color: rgba(231, 76, 60, 0.4);
    }

    .status-banner-left {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .status-beacon-ring {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        flex-shrink: 0;
    }

    .is-operational .status-beacon-ring {
        background: rgba(46, 204, 113, 0.2);
        color: #2ecc71;
    }

    .is-degraded .status-beacon-ring {
        background: rgba(255, 215, 0, 0.2);
        color: var(--gold);
    }

    .is-outage .status-beacon-ring {
        background: rgba(231, 76, 60, 0.2);
        color: #e74c3c;
    }

    .status-pulse-dot {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        position: relative;
    }

    .is-operational .status-pulse-dot {
        background: #2ecc71;
        box-shadow: 0 0 12px #2ecc71;
        animation: statusPulseGreen 2s infinite ease-in-out;
    }

    .is-degraded .status-pulse-dot {
        background: var(--gold);
        box-shadow: 0 0 12px var(--gold);
        animation: statusPulseGold 2s infinite ease-in-out;
    }

    .is-outage .status-pulse-dot {
        background: #e74c3c;
        box-shadow: 0 0 12px #e74c3c;
        animation: statusPulseRed 2s infinite ease-in-out;
    }

    @keyframes statusPulseGreen {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(46, 204, 113, 0.7); }
        70% { transform: scale(1.08); box-shadow: 0 0 0 10px rgba(46, 204, 113, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(46, 204, 113, 0); }
    }

    @keyframes statusPulseGold {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 215, 0, 0.7); }
        70% { transform: scale(1.08); box-shadow: 0 0 0 10px rgba(255, 215, 0, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 215, 0, 0); }
    }

    @keyframes statusPulseRed {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(231, 76, 60, 0.7); }
        70% { transform: scale(1.08); box-shadow: 0 0 0 10px rgba(231, 76, 60, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(231, 76, 60, 0); }
    }

    .status-banner-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--white);
        margin: 0 0 4px 0;
    }

    .status-banner-desc {
        font-size: 0.88rem;
        color: var(--silver);
        margin: 0;
    }

    .status-banner-badge {
        font-size: 0.85rem;
        font-weight: 700;
        padding: 6px 16px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .is-operational .status-banner-badge {
        background: rgba(46, 204, 113, 0.15);
        color: #2ecc71;
        border: 1px solid rgba(46, 204, 113, 0.4);
    }

    .is-degraded .status-banner-badge {
        background: rgba(255, 215, 0, 0.15);
        color: var(--gold);
        border: 1px solid rgba(255, 215, 0, 0.4);
    }

    .is-outage .status-banner-badge {
        background: rgba(231, 76, 60, 0.15);
        color: #e74c3c;
        border: 1px solid rgba(231, 76, 60, 0.4);
    }

    /* Telemetry Quick Cards */
    .telemetry-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 16px;
        margin-bottom: 2rem;
    }

    .telemetry-card {
        background: #11141c;
        border: 1px solid #232736;
        border-radius: 12px;
        padding: 18px 20px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .telemetry-label {
        font-size: 0.78rem;
        text-transform: uppercase;
        color: var(--silver);
        letter-spacing: 0.8px;
        font-weight: 600;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .telemetry-value {
        font-size: 1.35rem;
        color: var(--white);
        font-weight: 700;
        font-family: monospace;
    }

    /* Services List */
    .services-card {
        background: #11141c;
        border: 1px solid #232736;
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 2rem;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
    }

    .services-header {
        padding: 18px 24px;
        border-bottom: 1px solid #232736;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #151824;
    }

    .services-header h2 {
        font-size: 1.15rem;
        color: var(--white);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
    }

    .services-list {
        display: flex;
        flex-direction: column;
    }

    .service-row {
        padding: 18px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #1a1e2c;
        transition: background 0.15s ease;
    }

    .service-row:last-child {
        border-bottom: none;
    }

    .service-row:hover {
        background: rgba(255, 255, 255, 0.02);
    }

    .service-main {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .service-icon-box {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        flex-shrink: 0;
    }

    .service-meta h3 {
        font-size: 1rem;
        color: var(--white);
        margin: 0 0 3px 0;
        font-weight: 600;
    }

    .service-meta p {
        font-size: 0.82rem;
        color: var(--silver);
        margin: 0;
    }

    .service-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 16px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .badge-operational {
        background: rgba(46, 204, 113, 0.12);
        color: #2ecc71;
        border: 1px solid rgba(46, 204, 113, 0.3);
    }

    .badge-degraded {
        background: rgba(255, 215, 0, 0.12);
        color: var(--gold);
        border: 1px solid rgba(255, 215, 0, 0.3);
    }

    .badge-down {
        background: rgba(231, 76, 60, 0.12);
        color: #e74c3c;
        border: 1px solid rgba(231, 76, 60, 0.3);
    }

    .badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .badge-operational .badge-dot { background: #2ecc71; box-shadow: 0 0 6px #2ecc71; }
    .badge-degraded .badge-dot { background: var(--gold); box-shadow: 0 0 6px var(--gold); }
    .badge-down .badge-dot { background: #e74c3c; box-shadow: 0 0 6px #e74c3c; }

    /* Uptime Timeline Visualization */
    .timeline-card {
        background: #11141c;
        border: 1px solid #232736;
        border-radius: 14px;
        padding: 22px 24px;
        margin-bottom: 2.5rem;
    }

    .timeline-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }

    .timeline-title {
        font-size: 0.95rem;
        color: var(--white);
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .timeline-metric {
        font-size: 0.88rem;
        color: #2ecc71;
        font-weight: 600;
    }

    .timeline-bars {
        display: flex;
        gap: 4px;
        height: 32px;
        align-items: center;
        margin-bottom: 10px;
    }

    .timeline-bar {
        flex: 1;
        height: 100%;
        background: rgba(46, 204, 113, 0.7);
        border-radius: 3px;
        transition: transform 0.15s ease, background 0.15s ease;
        position: relative;
    }

    .timeline-bar:hover {
        transform: scaleY(1.15);
        background: #2ecc71;
    }

    .timeline-footer {
        display: flex;
        justify-content: space-between;
        color: var(--silver);
        font-size: 0.78rem;
    }

    /* Action Footer */
    .status-actions {
        text-align: center;
        margin-top: 2rem;
    }

    .btn-status-refresh {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        border: 1px solid #33394d;
        color: var(--silver);
        padding: 10px 22px;
        border-radius: 20px;
        font-size: 0.88rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-status-refresh:hover {
        border-color: var(--gold);
        color: var(--white);
        background: rgba(255, 215, 0, 0.05);
    }

    .status-last-checked {
        margin-top: 10px;
        color: #666e85;
        font-size: 0.8rem;
    }

    /* Mobile Responsive Breakpoints */
    @media (max-width: 768px) {
        .public-status-wrapper {
            margin: 1.5rem auto 3rem;
        }

        .public-status-header h1 {
            font-size: 1.75rem;
        }

        .status-banner {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
            padding: 20px;
        }

        .status-banner-badge {
            align-self: flex-start;
        }

        .service-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
            padding: 16px 18px;
        }

        .service-badge {
            align-self: flex-start;
        }

        .timeline-bars {
            gap: 2px;
            height: 24px;
        }
    }
</style>

<main class="container">
    <div class="public-status-wrapper">
        
        <!-- Header -->
        <header class="public-status-header">
            <h1><span class="logo-gold-glow">GPL</span> <span class="logo-silver-glow">Mods</span> System Status</h1>
            <p class="public-status-subtitle">Real-time health monitoring & availability metrics for all GPLMods infrastructure services</p>
        </header>

        <% 
            const isDegraded = health.status === 'DEGRADED';
            const isOutage = health.status === 'DOWN' || health.status === 'OUTAGE';
            const bannerClass = isOutage ? 'is-outage' : (isDegraded ? 'is-degraded' : 'is-operational');
            const bannerTitle = isOutage ? 'Major Service Outage' : (isDegraded ? 'Partially Degraded Performance' : 'All Systems Operational');
            const bannerDesc = isOutage 
                ? 'Our operations team is actively investigating service disruptions.' 
                : (isDegraded 
                    ? 'Some non-critical backend services are experiencing minor latency.' 
                    : 'All core platforms, storage clusters, and edge networks are performing nominally.');
        %>

        <!-- Status Hero Banner -->
        <section class="status-banner <%= bannerClass %>" aria-live="polite">
            <div class="status-banner-left">
                <div class="status-beacon-ring">
                    <div class="status-pulse-dot"></div>
                </div>
                <div>
                    <h2 class="status-banner-title"><%= bannerTitle %></h2>
                    <p class="status-banner-desc"><%= bannerDesc %></p>
                </div>
            </div>
            <div class="status-banner-badge">
                <%= health.status || 'OPERATIONAL' %>
            </div>
        </section>

        <!-- Telemetry Summary Cards -->
        <section class="telemetry-grid">
            <div class="telemetry-card">
                <div class="telemetry-label">
                    <i class="fas fa-clock" style="color: var(--gold);"></i> Server Uptime
                </div>
                <div class="telemetry-value"><%= health.uptime || '99.98%' %></div>
            </div>

            <div class="telemetry-card">
                <div class="telemetry-label">
                    <i class="fas fa-chart-line" style="color: #2ecc71;"></i> Service SLA (90-Day)
                </div>
                <div class="telemetry-value" style="color: #2ecc71;">99.98%</div>
            </div>

            <div class="telemetry-card">
                <div class="telemetry-label">
                    <i class="fas fa-network-wired" style="color: #00e5ff;"></i> Edge Environment
                </div>
                <div class="telemetry-value" style="color: #00e5ff; font-size: 1.15rem; text-transform: uppercase;">
                    <%= (health.environment || 'production').toUpperCase() %>
                </div>
            </div>

            <div class="telemetry-card">
                <div class="telemetry-label">
                    <i class="fas fa-shield-alt" style="color: var(--silver);"></i> Edge Security
                </div>
                <div class="telemetry-value" style="color: var(--silver); font-size: 1.15rem;">
                    Active (TLS 1.3)
                </div>
            </div>
        </section>

        <!-- Services Breakdown -->
        <section class="services-card">
            <div class="services-header">
                <h2><i class="fas fa-cubes" style="color: var(--gold);"></i> Infrastructure Components</h2>
                <span style="font-size: 0.8rem; color: var(--silver);">Live Status</span>
            </div>
            <div class="services-list">
                
                <!-- Core Application -->
                <div class="service-row">
                    <div class="service-main">
                        <div class="service-icon-box">
                            <i class="fas fa-server" style="color: #43a047;"></i>
                        </div>
                        <div class="service-meta">
                            <h3>Core Web Platform</h3>
                            <p>Express.js application server & dynamic mod indexing pipeline</p>
                        </div>
                    </div>
                    <div>
                        <span class="service-badge badge-operational">
                            <span class="badge-dot"></span> Operational
                        </span>
                    </div>
                </div>

                <!-- Database -->
                <div class="service-row">
                    <div class="service-main">
                        <div class="service-icon-box">
                            <i class="fas fa-database" style="color: #4DB33D;"></i>
                        </div>
                        <div class="service-meta">
                            <h3>MongoDB Atlas Cluster</h3>
                            <p>High-availability replica set for user profiles, downloads & catalog records</p>
                        </div>
                    </div>
                    <div>
                        <% const dbOk = health.services && health.services.database && health.services.database.status === 'CONNECTED'; %>
                        <span class="service-badge <%= dbOk ? 'badge-operational' : 'badge-degraded' %>">
                            <span class="badge-dot"></span> <%= dbOk ? 'Operational' : 'Degraded' %>
                        </span>
                    </div>
                </div>

                <!-- Storage -->
                <div class="service-row">
                    <div class="service-main">
                        <div class="service-icon-box">
                            <i class="fas fa-cloud" style="color: #0088cc;"></i>
                        </div>
                        <div class="service-meta">
                            <h3>Backblaze B2 Object Storage</h3>
                            <p>S3-compatible distributed storage for mod archives, APKs, IPAs & assets</p>
                        </div>
                    </div>
                    <div>
                        <% const storageOk = !health.services || !health.services.storage || health.services.storage.status !== 'ERROR'; %>
                        <span class="service-badge <%= storageOk ? 'badge-operational' : 'badge-degraded' %>">
                            <span class="badge-dot"></span> <%= storageOk ? 'Operational' : 'Degraded' %>
                        </span>
                    </div>
                </div>

                <!-- CDN -->
                <div class="service-row">
                    <div class="service-main">
                        <div class="service-icon-box">
                            <i class="fas fa-bolt" style="color: #f39c12;"></i>
                        </div>
                        <div class="service-meta">
                            <h3>Cloudflare Edge CDN & DNS</h3>
                            <p>Global Anycast distribution network, SSL termination & DDoS mitigation</p>
                        </div>
                    </div>
                    <div>
                        <span class="service-badge badge-operational">
                            <span class="badge-dot"></span> Operational
                        </span>
                    </div>
                </div>

                <!-- VirusTotal -->
                <div class="service-row">
                    <div class="service-main">
                        <div class="service-icon-box">
                            <i class="fas fa-shield-virus" style="color: var(--gold);"></i>
                        </div>
                        <div class="service-meta">
                            <h3>VirusTotal Threat Intelligence</h3>
                            <p>Automated cloud security scanning & SHA256 integrity inspection</p>
                        </div>
                    </div>
                    <div>
                        <span class="service-badge badge-operational">
                            <span class="badge-dot"></span> Operational
                        </span>
                    </div>
                </div>

            </div>
        </section>

        <!-- 90-Day Historical Uptime Timeline -->
        <section class="timeline-card">
            <div class="timeline-header">
                <h3 class="timeline-title"><i class="fas fa-history" style="color: var(--gold);"></i> 90-Day System Health History</h3>
                <span class="timeline-metric">100.0% Uptime This Month</span>
            </div>
            <div class="timeline-bars" title="90-day operational timeline">
                <% for (let i = 0; i < 45; i++) { %>
                    <div class="timeline-bar" title="Day <%= 45 - i %>: 100% Operational"></div>
                <% } %>
            </div>
            <div class="timeline-footer">
                <span>90 days ago</span>
                <span>Today</span>
            </div>
        </section>

        <!-- Footer / Refresh Action -->
        <div class="status-actions">
            <button type="button" class="btn-status-refresh" id="btnRefreshStatus" onclick="refreshStatusPage()">
                <i class="fas fa-sync-alt" id="refreshSpinner"></i> Refresh Status
            </button>
            <p class="status-last-checked">
                Last checked: <span id="lastCheckedTime"><%= new Date(health.timestamp || Date.now()).toLocaleTimeString() %></span>
            </p>
        </div>

    </div>
</main>

<script>
    function refreshStatusPage() {
        const btn = document.getElementById('btnRefreshStatus');
        const spinner = document.getElementById('refreshSpinner');
        if (spinner) spinner.classList.add('fa-spin');
        if (btn) btn.disabled = true;

        setTimeout(() => {
            window.location.reload();
        }, 350);
    }
</script>

<%- include('../partials/footer') %>
