        <div id="confirmSummaryBox" style="text-align: left; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 14px 16px; margin-bottom: 22px; font-size: 0.88em; color: #d0d0d0; line-height: 1.6;">
