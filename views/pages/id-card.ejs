                </p>

                <div id="socialInputsContainer" style="display: <%= showSocials ? 'block' : 'none' %>;">
                    <% 
                        const socialOptions = [
                            { val: 'telegram', label: 'Telegram (fab fa-telegram)', cleanLabel: 'Telegram' },
                            { val: 'discord', label: 'Discord (fab fa-discord)', cleanLabel: 'Discord' },
                            { val: 'youtube', label: 'YouTube (fab fa-youtube)', cleanLabel: 'YouTube' },
                            { val: 'github', label: 'GitHub (fab fa-github)', cleanLabel: 'GitHub' },
                            { val: 'twitter', label: 'X / Twitter (fab fa-x-twitter)', cleanLabel: 'X / Twitter' },
                            { val: 'instagram', label: 'Instagram (fab fa-instagram)', cleanLabel: 'Instagram' },
                            { val: 'website', label: 'Website / Globe (fas fa-globe)', cleanLabel: 'Website' },
