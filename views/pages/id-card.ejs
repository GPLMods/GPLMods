</div>

<script>
    const publicQr = "<%= publicQrUrl %>";
    const privateQr = "<%= privateQrUrl %>";

    function setMode(mode) {
        const qrDisplay = document.getElementById('qr-display');
        const warning = document.getElementById('qr-warning');
        const btnSafe = document.getElementById('btn-safe');
        const btnPrivate = document.getElementById('btn-private');
        
        if (mode === 'safe') {
            qrDisplay.src = publicQr;
            warning.innerHTML = '<i class="fas fa-qrcode" style="color: var(--gold); margin-right: 6px;"></i> SCAN TO VIEW PUBLIC PROFILE';
            warning.style.color = "var(--silver)";
            btnSafe.classList.add('active');
            btnPrivate.classList.remove('active');
        } else {
            qrDisplay.src = privateQr;
            warning.innerHTML = '<i class="fas fa-exclamation-triangle" style="color: #ff3333; margin-right: 6px; filter: drop-shadow(0 0 6px rgba(255, 51, 51, 0.6));"></i> SECRET LOGIN QR - DO NOT SHARE <i class="fas fa-exclamation-triangle" style="color: #ff3333; margin-left: 6px; filter: drop-shadow(0 0 6px rgba(255, 51, 51, 0.6));"></i>';
            warning.style.color = "#ff4444";
            warning.style.fontWeight = "bold";
            btnPrivate.classList.add('active');
            btnSafe.classList.remove('active');
        }
    }

    // --- DOWNLOAD CARD WITH GUARANTEED BASE64 AVATAR ---
    async function downloadCard(format = 'png') {
        const card = document.getElementById('exportable-card');
        const triggerBtn = document.getElementById('cardActionsDropdownTrigger');
        const avatarImg = document.getElementById('rendered-card-avatar');
        
        // Close dropdown
        const actionsDrop = document.getElementById('cardActionsDropdownWrap');
        if (actionsDrop) actionsDrop.classList.remove('open');

        // UI Feedback
        const origBtnHtml = triggerBtn ? triggerBtn.innerHTML : '';
        if (triggerBtn) {
            triggerBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
            triggerBtn.disabled = true;
        }

        // Hide warning text momentarily for clean export output
        const warningEl = document.getElementById('qr-warning');
        if (warningEl) warningEl.style.opacity = '0';

        try {
            // Guarantee avatar is loaded as a local Data URL if not already
            if (avatarImg && avatarImg.src && !avatarImg.src.startsWith('data:image/')) {
                try {
                    const proxyRes = await fetch(`/api/id-card/avatar-data-url?url=${encodeURIComponent(avatarImg.src)}`);
                    const pData = await proxyRes.json();
                    if (pData && pData.success && pData.dataUrl) {
                        avatarImg.src = pData.dataUrl;
                        await new Promise((resolve) => {
                            if (avatarImg.complete) resolve();
                            else avatarImg.onload = resolve;
                        });
                    }
                } catch (e) {
                    console.warn("Avatar proxy fetch warning:", e);
                }
            }

            // Small delay for DOM layout repaint
            await new Promise(r => setTimeout(r, 120));

            const canvas = await html2canvas(card, { 
                scale: 3,           // High resolution
                useCORS: true,      // Handle any remaining CORS assets
                allowTaint: false,
                backgroundColor: null, 
                logging: false 
            });

            const link = document.createElement('a');
            const ext = format === 'jpeg' ? 'jpg' : 'png';
            const mime = format === 'jpeg' ? 'image/jpeg' : 'image/png';
            link.download = `GPLMods-ID-${'<%= cardUser.cardId %>'}.${ext}`;
            link.href = canvas.toDataURL(mime, 0.95);
            link.click();
            
            if (triggerBtn) triggerBtn.innerHTML = '<i class="fas fa-check"></i> Downloaded!';
            setTimeout(() => {
                if (triggerBtn) {
                    triggerBtn.innerHTML = origBtnHtml;
                    triggerBtn.disabled = false;
                }
            }, 2000);
        } catch (err) {
            console.error("html2canvas error:", err);
            alert("Could not generate image. Please make sure all images are accessible.");
            if (triggerBtn) {
                triggerBtn.innerHTML = origBtnHtml;
                triggerBtn.disabled = false;
            }
        } finally {
            if (warningEl) warningEl.style.opacity = '1';
        }
    }

    // Copy Verified ID Number
    function copyCardId() {
        const idVal = '<%= cardUser.cardId %>';
        navigator.clipboard.writeText(idVal).then(() => {
            alert('Verified ID ' + idVal + ' copied to clipboard!');
        }).catch(() => {
            prompt('Copy your Verified ID:', idVal);
        });
        const actionsDrop = document.getElementById('cardActionsDropdownWrap');
        if (actionsDrop) actionsDrop.classList.remove('open');
    }

    // Copy Public Profile URL
    function copyPublicProfileLink() {
        const link = window.location.origin + '/users/' + encodeURIComponent('<%= cardUser.username %>') + '?ref=card';
        navigator.clipboard.writeText(link).then(() => {
            alert('Public ID Card link copied to clipboard:\n' + link);
        }).catch(() => {
            prompt('Copy public card link:', link);
        });
        const actionsDrop = document.getElementById('cardActionsDropdownWrap');
        if (actionsDrop) actionsDrop.classList.remove('open');
    }

    // Share Card using Web Share API if supported
    async function shareCardNative() {
        const link = window.location.origin + '/users/' + encodeURIComponent('<%= cardUser.username %>') + '?ref=card';
        const actionsDrop = document.getElementById('cardActionsDropdownWrap');
        if (actionsDrop) actionsDrop.classList.remove('open');

        if (navigator.share) {
            try {
                await navigator.share({
                    title: '<%= cardUser.username %> - GPLMods ID Card',
                    text: 'Check out my verified GPLMods digital credential!',
                    url: link
                });
            } catch (err) {
                if (err.name !== 'AbortError') copyPublicProfileLink();
            }
        } else {
            copyPublicProfileLink();
        }
    }

    // --- CUSTOM SELECT DROPDOWN LOGIC ---
    function setupCustomSelect(wrapperId, selectId, onChangeCallback) {
        const wrapper = document.getElementById(wrapperId);
        const nativeSelect = document.getElementById(selectId);
        if (!wrapper || !nativeSelect) return;

        const trigger = wrapper.querySelector('.custom-select');
        const selectedText = wrapper.querySelector('.selected-text');
        const options = wrapper.querySelectorAll('.custom-option');

        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            document.querySelectorAll('.custom-select-wrapper.open').forEach(w => {
                if (w !== wrapper) w.classList.remove('open');
            });
            const actionsDrop = document.getElementById('cardActionsDropdownWrap');
            if (actionsDrop) actionsDrop.classList.remove('open');
            wrapper.classList.toggle('open');
        });

        options.forEach(opt => {
            opt.addEventListener('click', (e) => {
                e.stopPropagation();
                const val = opt.getAttribute('data-value');
                nativeSelect.value = val;
                
                options.forEach(o => o.classList.remove('selected'));
                opt.classList.add('selected');
                
                selectedText.innerHTML = opt.innerHTML;
                wrapper.classList.remove('open');

                nativeSelect.dispatchEvent(new Event('change'));
                if (onChangeCallback) onChangeCallback(val);
            });
        });
    }

    // Initialize all custom selects on ID Card page
    setupCustomSelect('platformSelectWrapper', 'platformSelect', (val) => {
        const collabPlatformPreview = document.getElementById('collabPlatformPreview');
        if (collabPlatformPreview) collabPlatformPreview.textContent = val;
    });
    setupCustomSelect('social1PlatWrapper', 'social1Plat', () => updateSocialsPreview());
    setupCustomSelect('social2PlatWrapper', 'social2Plat', () => updateSocialsPreview());
    setupCustomSelect('social3PlatWrapper', 'social3Plat', () => updateSocialsPreview());

    // Actions dropdown menu toggle & close on outside click
    const cardActionsTrigger = document.getElementById('cardActionsDropdownTrigger');
    const cardActionsWrap = document.getElementById('cardActionsDropdownWrap');
    if (cardActionsTrigger && cardActionsWrap) {
        cardActionsTrigger.addEventListener('click', (e) => {
            e.stopPropagation();
            document.querySelectorAll('.custom-select-wrapper.open').forEach(w => w.classList.remove('open'));
            cardActionsWrap.classList.toggle('open');
        });
    }

    document.addEventListener('click', () => {
        document.querySelectorAll('.custom-select-wrapper.open').forEach(w => w.classList.remove('open'));
        if (cardActionsWrap) cardActionsWrap.classList.remove('open');
    });

    // --- LIVE PREVIEWS & CUSTOMIZATION INTERACTION ---
    const cardBgEl = document.querySelector('.id-card-bg');
    const cardAvatarEl = document.getElementById('rendered-card-avatar');
    const bgPreviewImg = document.getElementById('bgPreviewImg');
    const avatarPreviewImg = document.getElementById('avatarPreviewImg');
    const cardBgFile = document.getElementById('cardBgFile');
    const cardAvatarFile = document.getElementById('cardAvatarFile');
    const cardBgUrl = document.getElementById('cardBgUrl');
    const cardAvatarUrl = document.getElementById('cardAvatarUrl');
    const bgFileName = document.getElementById('bgFileName');
    const avatarFileName = document.getElementById('avatarFileName');
    const resetBgToDefault = document.getElementById('resetBgToDefault');
    const resetAvatarToAccount = document.getElementById('resetAvatarToAccount');
    const btnResetBg = document.getElementById('btnResetBg');
    const btnResetAvatar = document.getElementById('btnResetAvatar');
    const btnFetchCardGravatar = document.getElementById('btnFetchCardGravatar');
    const cardGravatarLoading = document.getElementById('cardGravatarLoading');

    // Live preview elements on card
    const brandNameInput = document.getElementById('brandNameInput');
    const platformSelect = document.getElementById('platformSelect');
    const collabBrandPreview = document.getElementById('collabBrandPreview');
    const collabPlatformPreview = document.getElementById('collabPlatformPreview');
    const collabOwnerTextPreview = document.getElementById('collabOwnerTextPreview');
    const ownerTaglineInput = document.getElementById('ownerTaglineInput');
    const cardBrandContainer = document.getElementById('cardBrandContainer');
    const cardBrandBadgeText = document.getElementById('cardBrandBadgeText');
    const collabBrandOwner = document.getElementById('collabBrandOwner');
    const collabBrandAdmin = document.getElementById('collabBrandAdmin');
    const collabBrandSupport = document.getElementById('collabBrandSupport');

    const showEmailToggle = document.getElementById('showEmailToggle');
    const emailOptionsBox = document.getElementById('emailOptionsBox');
    const emailTypeAccount = document.getElementById('emailTypeAccount');
    const emailTypeCustom = document.getElementById('emailTypeCustom');
    const customEmailInputWrap = document.getElementById('customEmailInputWrap');
    const customEmailInput = document.getElementById('customEmailInput');
    const cardMetaRow = document.getElementById('cardMetaRow');
    const cardMetaEmailPill = document.getElementById('cardMetaEmailPill');
    const cardMetaEmailText = document.getElementById('cardMetaEmailText');

    const showPhoneToggle = document.getElementById('showPhoneToggle');
    const phoneInputWrap = document.getElementById('phoneInputWrap');
    const phoneInput = document.getElementById('phoneInput');
    const cardMetaPhonePill = document.getElementById('cardMetaPhonePill');
    const cardMetaPhoneText = document.getElementById('cardMetaPhoneText');

    const showAgeToggle = document.getElementById('showAgeToggle');
    const ageInputWrap = document.getElementById('ageInputWrap');
    const ageInput = document.getElementById('ageInput');
    const cardMetaAgePill = document.getElementById('cardMetaAgePill');
    const cardMetaAgeText = document.getElementById('cardMetaAgeText');

    const showSocialsToggle = document.getElementById('showSocialsToggle');
    const socialInputsContainer = document.getElementById('socialInputsContainer');
    const cardSocialsRow = document.getElementById('cardSocialsRow');

    function refreshMetaRowVisibility() {
        if (cardMetaRow) {
            const hasAny = (showEmailToggle && showEmailToggle.checked) || 
                           (showPhoneToggle && showPhoneToggle.checked) || 
                           (showAgeToggle && showAgeToggle.checked);
            cardMetaRow.style.display = hasAny ? 'flex' : 'none';
        }
    }

    // Brand Name Live Update (Updates card badge AND footer collaboration line)
    if (brandNameInput) {
        brandNameInput.addEventListener('input', function() {
            const val = this.value.trim();
            if (cardBrandBadgeText && cardBrandContainer) {
                cardBrandBadgeText.textContent = val;
                cardBrandContainer.style.display = val ? 'flex' : 'none';
            }
            if (collabBrandPreview) {
                collabBrandPreview.textContent = val || "<%= cardUser.username %>";
            }
            if (collabBrandOwner) {
                collabBrandOwner.textContent = val ? val + ' • ' : '';
                collabBrandOwner.style.display = val ? 'inline' : 'none';
            }
            if (collabBrandAdmin) {
                collabBrandAdmin.textContent = val ? val + ' • ' : '';
                collabBrandAdmin.style.display = val ? 'inline' : 'none';
            }
            if (collabBrandSupport) {
                collabBrandSupport.textContent = val ? val + ' • ' : '';
                collabBrandSupport.style.display = val ? 'inline' : 'none';
            }
        });
    }

    // Platform Live Update
    if (platformSelect && collabPlatformPreview) {
        platformSelect.addEventListener('change', function() {
            collabPlatformPreview.textContent = this.value;
        });
    }

    // Owner Custom Tagline Live Update
    if (ownerTaglineInput && collabOwnerTextPreview) {
        ownerTaglineInput.addEventListener('input', function() {
            collabOwnerTextPreview.textContent = this.value.trim() || 'Official Founder & Head of GPLMods Ecosystem';
        });
    }

    // Socials Live Update helper functions
    const iconMapDict = {
        telegram: 'fab fa-telegram',
        discord: 'fab fa-discord',
        youtube: 'fab fa-youtube',
        github: 'fab fa-github',
        twitter: 'fab fa-x-twitter',
        instagram: 'fab fa-instagram',
        website: 'fas fa-globe',
        whatsapp: 'fab fa-whatsapp'
    };

    function liveFormatSocialDisplay(plat, handle) {
        if (!handle) return plat.charAt(0).toUpperCase() + plat.slice(1);
        const h = String(handle).trim();
        if (h.startsWith('http://') || h.startsWith('https://')) {
            try {
                const u = new URL(h);
                const path = u.pathname.replace(/^\/+|\/+$/g, '');
                if (path) return path.startsWith('@') ? path : `@${path}`;
                return u.hostname.replace(/^www\./, '');
            } catch(e) {
                return h;
            }
        }
        return h.startsWith('@') ? h : `@${h}`;
    }

    function liveBuildSocialHref(plat, handle) {
        if (!handle) return '#';
        const h = String(handle).trim();
        if (h.startsWith('http://') || h.startsWith('https://')) return h;
        const clean = h.replace(/^@/, '');
        if (plat === 'telegram') return `https://t.me/${clean}`;
        if (plat === 'discord') return clean.startsWith('discord.gg') ? `https://${clean}` : `https://discord.com`;
        if (plat === 'youtube') return `https://youtube.com/@${clean}`;
        if (plat === 'github') return `https://github.com/${clean}`;
        if (plat === 'twitter') return `https://x.com/${clean}`;
        if (plat === 'instagram') return `https://instagram.com/${clean}`;
        if (plat === 'whatsapp') return `https://wa.me/${clean.replace(/[^\d]/g, '')}`;
        return `https://${clean}`;
    }

    function updateSocialsPreview() {
        if (!cardSocialsRow) return;
        const sList = [
            { plat: document.getElementById('social1Plat')?.value || 'telegram', handle: document.getElementById('social1Handle')?.value || '' },
            { plat: document.getElementById('social2Plat')?.value || 'discord', handle: document.getElementById('social2Handle')?.value || '' },
            { plat: document.getElementById('social3Plat')?.value || 'youtube', handle: document.getElementById('social3Handle')?.value || '' }
        ];

        const activeSocials = sList.filter(s => s.handle && s.handle.trim());
        if (activeSocials.length === 0 || (showSocialsToggle && !showSocialsToggle.checked)) {
            cardSocialsRow.style.display = 'none';
        } else {
            cardSocialsRow.style.display = 'flex';
        }

        cardSocialsRow.innerHTML = activeSocials.slice(0, 3).map((s, idx) => `
            <a href="${liveBuildSocialHref(s.plat, s.handle)}" target="_blank" rel="noopener noreferrer" class="card-social-pill" id="cardSocialBadge${idx}" title="${s.plat}: ${s.handle}">
                <i class="${iconMapDict[s.plat] || 'fas fa-link'}"></i>
                <span class="card-social-text">${liveFormatSocialDisplay(s.plat, s.handle)}</span>
            </a>
        `).join('');
    }

    // Attach input listeners for live social handle updates
    ['social1Handle', 'social2Handle', 'social3Handle'].forEach(id => {
        const inp = document.getElementById(id);
        if (inp) inp.addEventListener('input', updateSocialsPreview);
    });

    // Email Toggles & Live Update
    if (showEmailToggle) {
        showEmailToggle.addEventListener('change', function() {
            emailOptionsBox.style.display = this.checked ? 'block' : 'none';
            cardMetaEmailPill.style.display = this.checked ? 'inline-flex' : 'none';
            refreshMetaRowVisibility();
        });
    }
    if (emailTypeAccount && emailTypeCustom) {
        const updateEmailText = () => {
            if (emailTypeCustom.checked) {
                customEmailInputWrap.style.display = 'block';
                cardMetaEmailText.textContent = customEmailInput.value.trim() || "<%= cardUser.email %>";
            } else {
                customEmailInputWrap.style.display = 'none';
                cardMetaEmailText.textContent = "<%= cardUser.email %>";
            }
        };
        emailTypeAccount.addEventListener('change', updateEmailText);
        emailTypeCustom.addEventListener('change', updateEmailText);
        if (customEmailInput) {
            customEmailInput.addEventListener('input', function() {
                if (emailTypeCustom.checked) {
                    cardMetaEmailText.textContent = this.value.trim() || "<%= cardUser.email %>";
                }
            });
        }
    }

    // Phone Live Update
    if (showPhoneToggle && phoneInputWrap && cardMetaPhonePill && cardMetaPhoneText) {
        showPhoneToggle.addEventListener('change', function() {
            phoneInputWrap.style.display = this.checked ? 'block' : 'none';
            cardMetaPhonePill.style.display = this.checked ? 'inline-flex' : 'none';
            refreshMetaRowVisibility();
        });
        phoneInput.addEventListener('input', function() {
            cardMetaPhoneText.textContent = this.value.trim() || "No phone";
        });
    }

    // Age Live Update
    if (showAgeToggle && ageInputWrap && cardMetaAgePill && cardMetaAgeText) {
        showAgeToggle.addEventListener('change', function() {
            ageInputWrap.style.display = this.checked ? 'block' : 'none';
            cardMetaAgePill.style.display = this.checked ? 'inline-flex' : 'none';
            refreshMetaRowVisibility();
        });
        ageInput.addEventListener('input', function() {
            cardMetaAgeText.textContent = (this.value ? this.value.trim() + ' yrs' : '');
        });
    }

    // Socials Toggle
    if (showSocialsToggle && socialInputsContainer && cardSocialsRow) {
        showSocialsToggle.addEventListener('change', function() {
            socialInputsContainer.style.display = this.checked ? 'block' : 'none';
            cardSocialsRow.style.display = this.checked ? 'flex' : 'none';
        });
    }

    // Live preview background file
    if (cardBgFile) {
        cardBgFile.addEventListener('change', function() {
            if (this.files && this.files[0]) {
                const file = this.files[0];
                bgFileName.textContent = file.name;
                resetBgToDefault.value = 'false';
                const reader = new FileReader();
                reader.onload = (e) => {
                    bgPreviewImg.src = e.target.result;
                    if (cardBgEl) cardBgEl.style.backgroundImage = `url('${e.target.result}')`;
                };
                reader.readAsDataURL(file);
            }
        });
    }

    // Live preview background URL
    if (cardBgUrl) {
        cardBgUrl.addEventListener('input', function() {
            const val = this.value.trim();
            if (val) {
                resetBgToDefault.value = 'false';
                bgPreviewImg.src = val;
                if (cardBgEl) cardBgEl.style.backgroundImage = `url('${val}')`;
            }
        });
    }

    // Reset background to default
    if (btnResetBg) {
        btnResetBg.addEventListener('click', function() {
            resetBgToDefault.value = 'true';
            if (cardBgFile) cardBgFile.value = '';
            if (cardBgUrl) cardBgUrl.value = '';
            bgFileName.textContent = 'Will reset to default on save';
            bgPreviewImg.src = '/images/card-bg.png';
            if (cardBgEl) cardBgEl.style.backgroundImage = "url('/images/card-bg.png')";
        });
    }

    // Live preview avatar file
    if (cardAvatarFile) {
        cardAvatarFile.addEventListener('change', function() {
            if (this.files && this.files[0]) {
                const file = this.files[0];
                avatarFileName.textContent = file.name;
                resetAvatarToAccount.value = 'false';
                const reader = new FileReader();
                reader.onload = (e) => {
                    avatarPreviewImg.src = e.target.result;
                    if (cardAvatarEl) cardAvatarEl.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    }

    // Live preview avatar URL
    if (cardAvatarUrl) {
        cardAvatarUrl.addEventListener('input', function() {
            const val = this.value.trim();
            if (val) {
                resetAvatarToAccount.value = 'false';
                avatarPreviewImg.src = val;
                if (cardAvatarEl) cardAvatarEl.src = val;
            }
        });
    }

    // Reset avatar to account avatar
    if (btnResetAvatar) {
        btnResetAvatar.addEventListener('click', function() {
            resetAvatarToAccount.value = 'true';
            if (cardAvatarFile) cardAvatarFile.value = '';
            if (cardAvatarUrl) cardAvatarUrl.value = '';
            avatarFileName.textContent = 'Will reset to account avatar on save';
            const accountAvatar = "<%= cardUser.signedAvatarUrl || '/images/default-avatar.png' %>";
            avatarPreviewImg.src = accountAvatar;
            if (cardAvatarEl) cardAvatarEl.src = accountAvatar;
        });
    }

    // Fetch avatar from Gravatar for Card
    if (btnFetchCardGravatar) {
        btnFetchCardGravatar.addEventListener('click', async function() {
            if (cardGravatarLoading) cardGravatarLoading.style.display = 'block';
            btnFetchCardGravatar.disabled = true;

            try {
                const res = await fetch('/id-card/fetch-gravatar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    resetAvatarToAccount.value = 'false';
                    if (cardAvatarFile) cardAvatarFile.value = '';
                    if (cardAvatarUrl) cardAvatarUrl.value = data.imageKey || data.avatarUrl;
                    avatarPreviewImg.src = data.avatarUrl;
                    if (cardAvatarEl) cardAvatarEl.src = data.avatarUrl;
                    avatarFileName.textContent = 'Gravatar synced!';
                    if (cardGravatarLoading) {
                        cardGravatarLoading.innerHTML = '<i class="fas fa-check-circle" style="color: #2ecc71;"></i> ' + (data.message || 'Gravatar synced successfully!');
                        setTimeout(() => { cardGravatarLoading.style.display = 'none'; cardGravatarLoading.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Syncing avatar from Gravatar...'; }, 3000);
                    }
                } else {
                    alert(data.error || 'Could not fetch Gravatar. Please verify your email is registered at Gravatar.com.');
                    if (cardGravatarLoading) cardGravatarLoading.style.display = 'none';
                }
            } catch (err) {
                console.error('Gravatar fetch error:', err);
                alert('Network error while fetching Gravatar.');
                if (cardGravatarLoading) cardGravatarLoading.style.display = 'none';
            } finally {
                btnFetchCardGravatar.disabled = false;
            }
        });
    }

    // --- CONFIRMATION POPUP MODAL LOGIC ---
    const cardConfirmModal = document.getElementById('cardConfirmModal');
    const btnOpenSaveConfirm = document.getElementById('btnOpenSaveConfirm');
    const btnCancelConfirm = document.getElementById('btnCancelConfirm');
    const btnExecuteSave = document.getElementById('btnExecuteSave');
    const confirmSummaryBox = document.getElementById('confirmSummaryBox');
    const cardCustomForm = document.getElementById('cardCustomForm');

    if (btnOpenSaveConfirm && cardConfirmModal && confirmSummaryBox) {
        btnOpenSaveConfirm.addEventListener('click', function() {
            // Build summary
            const bName = brandNameInput ? (brandNameInput.value.trim() || '<%= cardUser.username %> (Default)') : 'N/A';
            const plat = platformSelect ? platformSelect.value : 'Multiplatform';
            const hasEmail = showEmailToggle && showEmailToggle.checked;
            const chosenEmail = (emailTypeCustom && emailTypeCustom.checked && customEmailInput.value.trim()) ? customEmailInput.value.trim() : '<%= cardUser.email %>';
            const hasPhone = showPhoneToggle && showPhoneToggle.checked;
            const phoneVal = (phoneInput && phoneInput.value.trim()) || 'Not set';
            const hasAge = showAgeToggle && showAgeToggle.checked;
            const ageVal = (ageInput && ageInput.value.trim()) || 'Not set';
            const hasSocials = showSocialsToggle && showSocialsToggle.checked;

            let summaryHtml = `
                <div style="margin-bottom: 6px;"><strong>Brand Name:</strong> <span style="color: var(--gold);">${bName}</span></div>
                <div style="margin-bottom: 6px;"><strong>Mod Platform:</strong> <span style="color: var(--gold);">${plat}</span></div>
                <div style="margin-bottom: 6px;"><strong>Email on Card:</strong> ${hasEmail ? '<span style="color:#2ecc71;">Enabled (' + chosenEmail + ')</span>' : '<span style="color:#a0aec0;">Hidden</span>'}</div>
                <div style="margin-bottom: 6px;"><strong>Phone on Card:</strong> ${hasPhone ? '<span style="color:#2ecc71;">Enabled (' + phoneVal + ')</span>' : '<span style="color:#a0aec0;">Hidden</span>'}</div>
                <div style="margin-bottom: 6px;"><strong>Age on Card:</strong> ${hasAge ? '<span style="color:#2ecc71;">Enabled (' + ageVal + ' yrs)</span>' : '<span style="color:#a0aec0;">Hidden</span>'}</div>
                <div><strong>Social Icons:</strong> ${hasSocials ? '<span style="color:#2ecc71;">Enabled</span>' : '<span style="color:#a0aec0;">Hidden</span>'}</div>
            `;
            confirmSummaryBox.innerHTML = summaryHtml;

            // Open Modal with smooth transition
            cardConfirmModal.style.display = 'flex';
            setTimeout(() => {
                cardConfirmModal.style.opacity = '1';
                cardConfirmModal.querySelector('.gpl-confirm-modal-card').style.transform = 'scale(1)';
            }, 10);
        });

        const closeModal = () => {
            cardConfirmModal.style.opacity = '0';
            cardConfirmModal.querySelector('.gpl-confirm-modal-card').style.transform = 'scale(0.95)';
            setTimeout(() => { cardConfirmModal.style.display = 'none'; }, 250);
        };

        btnCancelConfirm.addEventListener('click', closeModal);

        btnExecuteSave.addEventListener('click', function() {
            btnExecuteSave.disabled = true;
            btnExecuteSave.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
            cardCustomForm.submit();
        });
    }
</script>
<%- include('../partials/footer') %>
