<%- include('../../partials/header') %>

<style>
    .club-notifs-wrapper {
        max-width: 860px;
        margin: 40px auto 70px;
    }
    .club-notifs-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        border-bottom: 1px solid #282a36;
        padding-bottom: 16px;
        flex-wrap: wrap;
        gap: 16px;
    }
    .club-notifs-title h1 {
        font-size: 2rem;
        font-weight: 800;
        color: #fff;
        margin: 0 0 6px 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .club-notifs-title p {
        color: var(--silver);
        margin: 0;
        font-size: 0.92rem;
    }

    .notifs-dropdown-select {
        background: #14151b;
        border: 1px solid var(--gold);
        color: #fff;
        border-radius: 10px;
        padding: 10px 18px;
        font-size: 0.95rem;
        outline: none;
        cursor: pointer;
    }

    .notifs-list-container {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .club-notif-card {
        background: #14151b;
        border: 1px solid #282a36;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        transition: transform 0.2s, border-color 0.2s;
    }
    .club-notif-card:hover {
        border-color: rgba(255, 215, 0, 0.4);
        transform: translateY(-2px);
    }
    .notif-left-col {
        display: flex;
        gap: 16px;
        align-items: flex-start;
    }
    .notif-icon-badge {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: rgba(255, 215, 0, 0.12);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }
    .notif-content-info h3 {
        margin: 0 0 6px 0;
        font-size: 1.05rem;
        color: #fff;
    }
    .notif-content-info p {
        margin: 0 0 8px 0;
        color: var(--silver);
        font-size: 0.9rem;
        line-height: 1.5;
    }
    .notif-time-tag {
        font-size: 0.78rem;
        color: #72767d;
    }

    .notif-actions-col {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-shrink: 0;
    }
    .btn-approve-req {
        background: #43b581;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-approve-req:hover {
        background: #3ca374;
        transform: scale(1.04);
    }
    .btn-reject-req {
        background: rgba(244, 67, 54, 0.2);
        color: #ff6b6b;
        border: 1px solid #f44336;
        border-radius: 8px;
        padding: 8px 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-reject-req:hover {
        background: #f44336;
        color: #fff;
    }
    .empty-notifs-box {
        background: #14151b;
        border: 1px dashed #282a36;
        border-radius: 16px;
        padding: 60px 20px;
        text-align: center;
        color: var(--silver);
    }
</style>

<div class="container club-notifs-wrapper">
    <!-- ======== DYNAMIC GO BACK BUTTON ======== -->
    <%- include('../../partials/go-back-button', { fallback: '/notifications' }) %>
    <!-- ======================================== -->

    <div class="club-notifs-header" style="margin-top: 1rem;">
        <div class="club-notifs-title">
            <h1><i class="fas fa-users" style="color: var(--gold);"></i> Club Alerts &amp; Requests</h1>
            <p>Manage community join requests, invitations, and alerts for your clubs.</p>
        </div>

        <div>
            <select class="notifs-dropdown-select" id="notifTypeFilter" onchange="filterNotifications(this.value)">
                <option value="all">All Alerts</option>
                <option value="requests">Join Requests</option>
                <option value="invites">Club Invites</option>
                <option value="updates">Community Updates</option>
            </select>
        </div>
    </div>

    <div class="notifs-list-container" id="notifsList">
        <% if (joinRequests && joinRequests.length > 0) { %>
            <% joinRequests.forEach(req => { %>
                <div class="club-notif-card notif-item-requests" id="req-card-<%= req._id %>">
                    <div class="notif-left-col">
                        <div class="notif-icon-badge">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <div class="notif-content-info">
                            <h3>
                                Join Request for <a href="/clubs/<%= req.club.slug %>" style="color: var(--gold); text-decoration: none;"><%= req.club.name %></a>
                            </h3>
                            <p>
                                <strong><%= req.user ? req.user.username : 'A user' %></strong> has requested to join your private community.
                                <% if (req.message) { %>
                                    <br><em style="color: #bbb;">"<%= req.message %>"</em>
                                <% } %>
                            </p>
                            <span class="notif-time-tag"><i class="far fa-clock"></i> <%= new Date(req.createdAt).toLocaleString() %></span>
                        </div>
                    </div>

                    <div class="notif-actions-col">
                        <button type="button" class="btn-approve-req" onclick="handleJoinRequest('<%= req.club.slug %>', '<%= req._id %>', 'approve')">
                            <i class="fas fa-check"></i> Approve
                        </button>
                        <button type="button" class="btn-reject-req" onclick="handleJoinRequest('<%= req.club.slug %>', '<%= req._id %>', 'reject')">
                            <i class="fas fa-times"></i> Reject
                        </button>
                        <a href="/users/<%= req.user ? req.user.username : '' %>" target="_blank" style="color: var(--silver); padding: 8px;" title="View User Profile">
                            <i class="fas fa-external-link-alt"></i>
                        </a>
                    </div>
                </div>
            <% }) %>
        <% } %>

        <% if (clubAlerts && clubAlerts.length > 0) { %>
            <% clubAlerts.forEach(alert => { %>
                <div class="club-notif-card notif-item-updates">
                    <div class="notif-left-col">
                        <div class="notif-icon-badge" style="background: rgba(33, 150, 243, 0.12); color: #64b5f6;">
                            <i class="fas fa-bell"></i>
                        </div>
                        <div class="notif-content-info">
                            <h3><%= alert.title %></h3>
                            <p><%= alert.message %></p>
                            <span class="notif-time-tag"><i class="far fa-clock"></i> <%= new Date(alert.createdAt).toLocaleString() %></span>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>

        <% if ((!joinRequests || joinRequests.length === 0) && (!clubAlerts || clubAlerts.length === 0)) { %>
            <div class="empty-notifs-box">
                <i class="fas fa-inbox" style="font-size: 3rem; margin-bottom: 14px; color: #444;"></i>
                <h3 style="color: #fff; margin-bottom: 6px;">No Pending Club Alerts</h3>
                <p>You have no pending join requests or club notifications at this time.</p>
            </div>
        <% } %>
    </div>
</div>

<script>
    function filterNotifications(filterValue) {
        const cards = document.querySelectorAll('.club-notif-card');
        cards.forEach(card => {
            if (filterValue === 'all') {
                card.style.display = 'flex';
            } else if (filterValue === 'requests' && card.classList.contains('notif-item-requests')) {
                card.style.display = 'flex';
            } else if (filterValue === 'updates' && card.classList.contains('notif-item-updates')) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }

    async function handleJoinRequest(clubSlug, requestId, action) {
        try {
            const res = await fetch(`/clubs/${clubSlug}/requests/${requestId}/${action}`, {
                method: 'POST',
                headers: { 'Accept': 'application/json' }
            });
            const data = await res.json();
            if (data.success) {
                const card = document.getElementById(`req-card-${requestId}`);
                if (card) {
                    card.style.opacity = '0.5';
                    card.innerHTML = `<div style="padding: 10px; color: ${action === 'approve' ? '#43b581' : '#ff6b6b'}; font-weight: 700;">Request successfully ${action}d.</div>`;
                }
            } else {
                alert(data.error || 'Failed to process request.');
            }
        } catch (e) {
            console.error('Request processing error:', e);
        }
    }
</script>

<%- include('../../partials/footer') %>
