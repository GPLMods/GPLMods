        .platform-tag-ios { background: rgba(0, 122, 255, 0.15); color: #60a5fa; border: 1px solid rgba(0, 122, 255, 0.35); }
        .platform-tag-wordpress { background: rgba(33, 117, 155, 0.18); color: #38bdf8; border: 1px solid rgba(33, 117, 155, 0.4); }
