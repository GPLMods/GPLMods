<%-include('../partials/header') %>

    <!-- ✅ CDN & AUTH BYPASS SCRIPT -->
    <!-- Ensures logged-in users are always routed to /home and prevents stale cached logout state -->
    <script>
        (function() {
            // Handle back-forward cache (bfcache)
            window.addEventListener('pageshow', function(event) {
                if (event.persisted) {
                    window.location.reload();
                }
            });

            const hasLogoutParam = window.location.search.includes('logout=true');
            const hasLoginCookie = document.cookie.split(';').some(function(item) {
                return item.trim().startsWith('is_logged_in=true');
            });

            if (hasLogoutParam) {
                // Force clear any client-side cookie leftovers
                document.cookie = 'is_logged_in=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT; Max-Age=0;';
                try {
                    localStorage.removeItem('user');
                    sessionStorage.removeItem('user');
                } catch (e) {}
            } else if (hasLoginCookie <% if (typeof user !== 'undefined' && user) { %> || true <% } %>) {
                // Confirmed logged-in user: always redirect from / to /home
                if (window.location.pathname === '/') {
                    window.location.replace('/home' + window.location.search);
                }
            }
        })();
    </script>
    <section class="hero"></section>

    <!-- ======== STYLES FOR COUNCIL MOD-CARD UI & PLATFORM TAGS ======== -->
    <style>
        .council-featured-section .featured-card {
            transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s ease, border-color 0.35s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
            background-color: rgba(18, 18, 18, 0.85);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            padding: 28px;
            gap: 32px;
            display: flex;
            align-items: center;
        }
        .council-featured-section .featured-card:hover {
            transform: translateY(-4px);
            border-color: rgba(255, 215, 0, 0.4);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.7), 0 0 15px rgba(255, 215, 0, 0.15);
        }
        .council-featured-section .featured-card:active {
            transform: scale(0.99);
        }
        .council-featured-section .featured-icon-wrapper {
            width: 240px;
            height: 240px;
            min-width: 240px;
            border-radius: 18px;
            background: rgba(10, 10, 10, 0.75);
            border: 1px solid rgba(255, 255, 255, 0.12);
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            box-shadow: inset 0 2px 8px rgba(0,0,0,0.6), 0 8px 24px rgba(0,0,0,0.5);
            transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
