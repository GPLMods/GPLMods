            max-height: 100%;
            object-fit: contain;
            border-radius: 12px;
        }
        .council-meta-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 8px 0 12px 0;
            flex-wrap: wrap;
        }
        .mod-stat-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
