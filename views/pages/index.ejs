            ios: typeof editorsChoiceMods !== 'undefined' ? editorsChoiceMods.filter(m => m.category && m.category.startsWith('ios')) : [],
            wordpress: typeof editorsChoiceMods !== 'undefined' ? editorsChoiceMods.filter(m => m.category === 'wordpress') : [],
            windows: typeof editorsChoiceMods !== 'undefined' ? editorsChoiceMods.filter(m => m.category === 'windows') : []
        };
