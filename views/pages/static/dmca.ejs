<%- include('../../partials/header') %>

<style>
    /* Specific styles for the DMCA Page to prevent conflicts */
    .dmca-page-header { text-align: center; padding: 60px 20px 40px; }
    .dmca-page-header h1 { font-size: 3em; color: var(--white); }
    .dmca-page-header h1 span { color: var(--gold); text-shadow: 0 0 4px var(--glow-gold); }

    .dmca-content-section { background-color: var(--dark-gray); padding: 40px; border-radius: 15px; max-width: 900px; margin: 0 auto 50px auto; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    .dmca-content-section h2 { font-size: 1.8em; color: var(--gold); margin-bottom: 20px; border-bottom: 1px solid #333; padding-bottom: 10px; margin-top: 30px; }
    .dmca-content-section h2:first-child { margin-top: 0; }
    .dmca-content-section p, .dmca-content-section ul { color: var(--silver); margin-bottom: 15px; font-size: 1.05em; line-height: 1.7; }
    .dmca-content-section ul { list-style-position: inside; padding-left: 10px; }
    .dmca-content-section li { margin-bottom: 10px; }
    .dmca-content-section a { color: var(--gold); text-decoration: none; font-weight: 600; }
    .dmca-content-section a:hover { text-decoration: underline; }

    .dmca-form-container { margin-top: 40px; padding-top: 30px; border-top: 1px solid #333; }
    .dmca-form-container h2 { border-bottom: none; margin-bottom: 15px; margin-top: 0;}
    .dmca-form { display: flex; flex-direction: column; gap: 20px; }
    
    .dmca-form-group { display: flex; flex-direction: column; gap: 8px; text-align: left; }
    .dmca-form-group label { color: var(--silver); font-weight: 600; font-size: 0.95em; }
    .dmca-form-group input, .dmca-form-group textarea { 
        width: 100%; 
        padding: 14px 15px; 
        border-radius: 8px; 
        border: 1px solid #333; 
        background-color: var(--black); 
        color: var(--white); 
        font-family: 'Poppins', sans-serif;
        font-size: 1em; 
        outline: none; 
        transition: all 0.3s ease; 
    }
    .dmca-form-group input:focus, .dmca-form-group textarea:focus { 
        border-color: var(--gold); 
        box-shadow: 0 0 8px var(--glow-gold); 
    }

    /* Multi-Link Reporting Suite Styles */
    .link-mode-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 12px;
    }
    .link-mode-btn {
        padding: 8px 16px;
        border-radius: 6px;
        background: #111;
        border: 1px solid #333;
        color: var(--silver);
        font-size: 0.9em;
        cursor: pointer;
        transition: all 0.2s ease;
        font-family: inherit;
    }
    .link-mode-btn.active {
        background: var(--gold);
        color: #000;
        font-weight: 700;
        border-color: var(--gold);
    }

    .link-rows-wrapper {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .link-input-row {
        background: #111;
        border: 1px solid #282828;
        border-radius: 8px;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        transition: border-color 0.2s;
    }
    .link-input-row:hover {
        border-color: #444;
    }
    .link-input-field-wrap {
        display: flex;
        gap: 8px;
        align-items: center;
    }
    .link-input-field-wrap input {
        flex: 1;
        padding: 10px 14px;
        font-size: 0.95em;
    }
    .remove-link-btn {
        background: rgba(255, 77, 77, 0.1);
        border: 1px solid rgba(255, 77, 77, 0.3);
        color: #ff4d4d;
        width: 38px;
        height: 38px;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        flex-shrink: 0;
    }
    .remove-link-btn:hover {
        background: #ff4d4d;
        color: #fff;
    }
    .add-link-btn {
        background: transparent;
        border: 1px dashed var(--gold);
        color: var(--gold);
        padding: 10px 16px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.95em;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        align-self: flex-start;
        transition: all 0.2s;
        font-family: inherit;
        margin-top: 4px;
    }
    .add-link-btn:hover {
        background: rgba(255, 215, 0, 0.1);
    }

    /* Live Link Inspection Card */
    .link-inspect-preview {
        display: none;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        background: #181818;
        border-radius: 6px;
        border: 1px solid #333;
    }
    .link-inspect-preview.show {
        display: flex;
    }
    .link-preview-icon {
        width: 38px;
        height: 38px;
        border-radius: 6px;
        object-fit: cover;
        background: #000;
    }
    .link-preview-text {
        flex: 1;
        min-width: 0;
    }
    .link-preview-title {
        color: var(--white);
        font-weight: 600;
        font-size: 0.95em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .link-preview-meta {
        font-size: 0.8em;
        color: var(--silver);
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .link-preview-badge {
        font-size: 0.75em;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 4px;
        text-transform: uppercase;
    }
    .badge-main { background: #332200; color: var(--gold); border: 1px solid #664400; }
    .badge-variant { background: #002233; color: var(--blue); border: 1px solid #004466; }
    .badge-external { background: #222; color: #888; border: 1px solid #444; }
    .link-checking-spinner {
        font-size: 0.85em;
        color: var(--gold);
        display: flex;
        align-items: center;
        gap: 6px;
    }
    
    .dmca-submit-btn { 
        background-color: var(--gold); 
        color: var(--black); 
        border: none; 
        padding: 15px 20px; 
        font-size: 1.1em; 
        font-weight: 700; 
        border-radius: 8px; 
        cursor: pointer; 
        transition: all 0.3s ease; 
        text-transform: uppercase;
        margin-top: 10px;
        box-shadow: 0 0 15px var(--glow-gold);
    }
    .dmca-submit-btn:hover { 
        transform: translateY(-3px);
        box-shadow: 0 0 25px var(--glow-gold); 
    }
    
    /* Alert Box Styling */
    .dmca-alert {
        display: none;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 25px;
        font-weight: bold;
        text-align: center;
        font-size: 1.1em;
    }
    .dmca-alert.success { background-color: rgba(46, 204, 113, 0.1); border: 1px solid #2ecc71; color: #2ecc71; }
    .dmca-alert.error { background-color: rgba(255, 77, 77, 0.1); border: 1px solid #ff4d4d; color: #ff4d4d; }

    /* Highlight box for policy */
    .policy-highlight {
        background-color: rgba(255, 215, 0, 0.05);
        border-left: 4px solid var(--gold);
        padding: 20px;
        border-radius: 0 8px 8px 0;
        margin-bottom: 25px;
    }

    /* Automated Protection Notice */
    .automated-protection-box {
        background: rgba(255, 51, 102, 0.08);
        border: 1px solid rgba(255, 51, 102, 0.3);
        border-radius: 10px;
        padding: 18px 20px;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 15px;
    }
    .protection-icon {
        font-size: 2em;
        color: #ff3366;
        flex-shrink: 0;
    }
    .protection-text h4 {
        margin: 0 0 4px 0;
        color: var(--white);
        font-size: 1.1em;
    }
    .protection-text p {
        margin: 0;
        font-size: 0.9em;
        color: var(--silver);
        line-height: 1.5;
    }

    /* Contact Box Styles */
    .contact-box { background: var(--black); border: 1px solid #333; padding: 20px; border-radius: 10px; margin-top: 30px; text-align: center; }
    .contact-box p { margin-bottom: 5px; font-size: 1em; }
    .contact-box a {
        word-wrap: break-word;
        overflow-wrap: break-word;
        word-break: break-all;
        display: inline-block;
        max-width: 100%;
    }

    @media (max-width: 768px) {
        .dmca-page-header h1 { font-size: 2.2em; }
        .dmca-content-section { padding: 25px; }
    }
</style>

<main>
    <div class="dmca-page-header">
        <div class="container" style="padding-top: 10px;">
            <%- include('../../partials/go-back-button', { fallback: '/' }) %>
        </div>
        <div class="container">
            <h1>DMCA & <span>Copyright Policy</span></h1>
        </div>
    </div>
    
    <div class="container">
        <div class="dmca-content-section">
            
            <!-- Dynamic Success/Error Message Container -->
            <div id="dmca-alert-box" class="dmca-alert"></div>

            <div class="automated-protection-box">
                <div class="protection-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <div class="protection-text">
                    <h4>Automated Safe Harbor Protection System</h4>
                    <p>Upon submitting a takedown notice, our automated compliance engine logs the claim and schedules file link restrictions within <strong>24 to 48 hours</strong>. The files are isolated for administrative verification to ensure prompt resolution while protecting intellectual property rights.</p>
                </div>
            </div>

            <div class="policy-highlight">
                <p style="color: var(--white); font-weight: bold; margin-bottom: 10px;">Our Platform's Purpose & Safe Harbor</p>
                <p>GPL Mods is a community-driven directory. <strong>We do not create or host modifications ourselves.</strong> All files and links found on this website are uploaded and shared by our community members.</p>
                <p>Furthermore, content shared on this platform is distributed under the spirit of the GNU/GPL license for <strong>testing, evaluation, and educational purposes only.</strong> Because many developers do not provide trial versions, this platform allows users to evaluate software features. If you are satisfied with a product, we strongly encourage you to purchase the premium version directly from the official developer to support their work.</p>
            </div>

            <h2>Notification of Copyright Infringement</h2>
            <p>If you are the official copyright owner (or an authorized agent) and wish to request the removal of content submitted by a community member, you may submit a takedown request. <strong>We take false claims very seriously.</strong></p>
            
            <p>To process your request, you must provide proof that the content strictly belongs to you or the entity you represent. Our administration team may contact you via email to request additional information to verify your identity. This may include:</p>
            <ul>
                <li>Official company registration documents.</li>
                <li>Proof of domain ownership or software licensing rights.</li>
                <li>A short KYC (Know Your Customer) or verification process to ensure no unauthorized third party is filing a fraudulent complaint against your intellectual property.</li>
            </ul>

            <h2>How to Submit a Notice & Contact Us</h2>
            <p>Upon receipt of a valid and verified infringement notification, we take immediate action, including the prompt restriction or removal of the challenged material from our platform.</p>
            <p>You may submit your verified takedown request using the interactive form below, or by contacting our Designated Copyright Agent directly via email.</p>

            <div class="contact-box">
                <p>
                    <strong style="display: block; margin-bottom: 5px;">For DMCA & Takedown Notices:</strong> 
                    <a href="mailto:dmca@gplmods.webredirect.org">dmca@gplmods.webredirect.org</a>
                </p>
                <p>
                    <strong style="display: block; margin-bottom: 5px;">For Privacy & Legal inquiries:</strong> 
                    <a href="mailto:support@gplmods.webredirect.org">support@gplmods.webredirect.org</a>
                </p>
                <p>
                    <strong style="display: block; margin-bottom: 5px;">For General Help:</strong> 
                    <a href="mailto:help@gplmods.webredirect.org">help@gplmods.webredirect.org</a>
                </p>
                
                <hr style="border: none; border-top: 1px solid #333; margin: 15px 0;">
                
                <p style="color: var(--gold); font-weight: bold; margin-bottom: 5px;">Support & Processing Hours</p>
                <p style="font-size: 0.9em; color: var(--silver);">(Timezone: GMT+5:30 / IST)</p>
                <p style="margin-top: 10px;">Monday to Friday</p>
                <p><strong>Morning:</strong> 8:00 AM to 10:00 AM</p>
                <p><strong>Evening:</strong> 6:00 PM to 10:00 PM</p>
            </div>

            <div class="dmca-form-container">
                <h2>Submit a DMCA Notice</h2>
                <p style="margin-bottom: 20px;">Use the form below to submit your takedown request directly to our automated compliance queue. You can report single or multiple GPLMods links with live file verification.</p>
                
                <form class="dmca-form" id="dmca-main-form" action="/dmca-request" method="POST" onsubmit="return handleDmcaSubmit(event)">
                    <div class="dmca-form-group">
                        <label for="fullName">Your Full Name*</label>
                        <input type="text" id="fullName" name="fullName" required>
                    </div>
                    <div class="dmca-form-group">
                        <label for="email">Official Company Email*</label>
                        <input type="email" id="email" name="email" required placeholder="name@yourcompany.com">
                    </div>
                    <div class="dmca-form-group">
                        <label for="copyrightHolder">Name of Copyright Holder you represent*</label>
                        <input type="text" id="copyrightHolder" name="copyrightHolder" required>
                    </div>
                    <div class="dmca-form-group">
                        <label for="originalWorkUrl">URL to the original copyrighted work*</label>
                        <input type="url" id="originalWorkUrl" name="originalWorkUrl" required placeholder="https://yourcompany.com/official-software">
                    </div>

                    <!-- Multi-Link Reporting Suite -->
                    <div class="dmca-form-group">
                        <label>URL(s) on GPL Mods you claim are infringing*</label>
                        
                        <div class="link-mode-tabs">
                            <button type="button" class="link-mode-btn active" id="tab-interactive" onclick="switchLinkMode('interactive')">
                                <i class="fas fa-list-ul"></i> Interactive Link Builder
                            </button>
                            <button type="button" class="link-mode-btn" id="tab-bulk" onclick="switchLinkMode('bulk')">
                                <i class="fas fa-align-left"></i> Bulk Paste
                            </button>
                        </div>

                        <!-- Interactive Mode Container -->
                        <div id="interactive-links-container">
                            <div class="link-rows-wrapper" id="link-rows-list">
                                <!-- Dynamic Link Input Row 1 -->
                                <div class="link-input-row" data-row-id="1">
                                    <div class="link-input-field-wrap">
                                        <input type="url" class="interactive-link-input" placeholder="Paste GPLMods URL (e.g. https://gplmods.webredirect.org/mods/...)" oninput="handleUrlInput(this)" required>
                                        <button type="button" class="remove-link-btn" onclick="removeLinkRow(this)" title="Remove URL" style="display: none;">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                    <div class="link-inspect-preview"></div>
                                </div>
                            </div>

                            <button type="button" class="add-link-btn" onclick="addLinkRow()">
                                <i class="fas fa-plus-circle"></i> Add Another Infringing URL
                            </button>
                        </div>

                        <!-- Bulk Mode Container -->
                        <div id="bulk-links-container" style="display: none;">
                            <textarea id="infringingUrlBulk" rows="5" placeholder="Enter one URL per line:&#10;https://gplmods.webredirect.org/mods/android/example-app&#10;https://gplmods.webredirect.org/mods/windows/another-app" oninput="updateBulkCount()"></textarea>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px;">
                                <span style="font-size: 0.85em; color: var(--silver);" id="bulk-links-counter">0 URLs detected</span>
                                <button type="button" class="link-mode-btn" style="padding: 4px 10px; font-size: 0.8em;" onclick="convertBulkToInteractive()">
                                    <i class="fas fa-magic"></i> Convert to Interactive Preview
                                </button>
                            </div>
                        </div>

                        <!-- Hidden Payload Inputs (submitted to server) -->
                        <div id="hidden-urls-payload"></div>
                    </div>

                    <div class="dmca-form-group">
                        <label for="signature">Electronic Signature (type your full legal name again)*</label>
                        <input type="text" id="signature" name="signature" required>
                    </div>

                    <button type="submit" class="dmca-submit-btn">
                        <i class="fas fa-paper-plane" style="margin-right: 8px;"></i> Submit Request for Verification
                    </button>
                </form>
            </div>
        </div>
    </div>
</main>

<script>
    let currentMode = 'interactive';
    let nextRowId = 2;
    const inspectCache = {};

    function switchLinkMode(mode) {
        currentMode = mode;
        const interactiveTab = document.getElementById('tab-interactive');
        const bulkTab = document.getElementById('tab-bulk');
        const interactiveContainer = document.getElementById('interactive-links-container');
        const bulkContainer = document.getElementById('bulk-links-container');

        if (mode === 'interactive') {
            interactiveTab.classList.add('active');
            bulkTab.classList.remove('active');
            interactiveContainer.style.display = 'block';
            bulkContainer.style.display = 'none';
        } else {
            bulkTab.classList.add('active');
            interactiveTab.classList.remove('active');
            bulkContainer.style.display = 'block';
            interactiveContainer.style.display = 'none';
            syncInteractiveToBulk();
        }
    }

    function addLinkRow(initialVal = '') {
        const rowsList = document.getElementById('link-rows-list');
        const newRow = document.createElement('div');
        newRow.className = 'link-input-row';
        newRow.dataset.rowId = nextRowId++;
        newRow.innerHTML = `
            <div class="link-input-field-wrap">
                <input type="url" class="interactive-link-input" placeholder="Paste GPLMods URL..." value="${initialVal}" oninput="handleUrlInput(this)" required>
                <button type="button" class="remove-link-btn" onclick="removeLinkRow(this)" title="Remove URL">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="link-inspect-preview"></div>
        `;
        rowsList.appendChild(newRow);
        updateRemoveButtons();
        if (initialVal) {
            const input = newRow.querySelector('.interactive-link-input');
            handleUrlInput(input);
        }
    }

    function removeLinkRow(btn) {
        const row = btn.closest('.link-input-row');
        row.remove();
        updateRemoveButtons();
    }

    function updateRemoveButtons() {
        const rows = document.querySelectorAll('.link-input-row');
        rows.forEach(r => {
            const btn = r.querySelector('.remove-link-btn');
            if (rows.length > 1) {
                btn.style.display = 'flex';
            } else {
                btn.style.display = 'none';
            }
        });
    }

    // Debounced URL inspector
    const debounceTimers = {};
    function handleUrlInput(inputElement) {
        const row = inputElement.closest('.link-input-row');
        const previewBox = row.querySelector('.link-inspect-preview');
        const url = (inputElement.value || '').trim();

        const rowId = row.dataset.rowId;
        if (debounceTimers[rowId]) clearTimeout(debounceTimers[rowId]);

        if (!url || (!url.startsWith('http://') && !url.startsWith('https://') && !url.startsWith('/'))) {
            previewBox.className = 'link-inspect-preview';
            previewBox.innerHTML = '';
            return;
        }

        previewBox.className = 'link-inspect-preview show';
        previewBox.innerHTML = '<span class="link-checking-spinner"><i class="fas fa-spinner fa-spin"></i> Checking link on GPLMods...</span>';

        debounceTimers[rowId] = setTimeout(async () => {
            try {
                if (inspectCache[url]) {
                    renderInspectResult(previewBox, inspectCache[url]);
                    return;
                }

                const res = await fetch(`/api/dmca/inspect-link?url=${encodeURIComponent(url)}`);
                const data = await res.json();
                inspectCache[url] = data;
                renderInspectResult(previewBox, data);
            } catch (err) {
                previewBox.innerHTML = '<span style="font-size: 0.8em; color: #888;">(Link saved - will be verified by staff)</span>';
            }
        }, 500);
    }

    function renderInspectResult(previewBox, data) {
        if (!data || !data.found) {
            previewBox.innerHTML = `
                <i class="fas fa-globe" style="color: #666; font-size: 1.2em;"></i>
                <div class="link-preview-text">
                    <span style="font-size: 0.85em; color: var(--silver);">Unindexed or External Link</span>
                    <div style="font-size: 0.75em; color: #777;">Will be investigated manually by staff upon submission.</div>
                </div>
                <span class="link-preview-badge badge-external">External</span>
            `;
            return;
        }

        const isVariant = data.targetType === 'variant';
        previewBox.innerHTML = `
            <img src="${data.iconUrl || '/images/default-app-icon.png'}" class="link-preview-icon" alt="icon">
            <div class="link-preview-text">
                <div class="link-preview-title">${data.name}</div>
                <div class="link-preview-meta">
                    <span>v${data.version || '1.0'}</span>
                    <span>&bull;</span>
                    <span>Uploader: <strong>${data.uploader}</strong></span>
                    <span>&bull;</span>
                    <span>${data.category}</span>
                </div>
            </div>
            <span class="link-preview-badge ${isVariant ? 'badge-variant' : 'badge-main'}">
                ${isVariant ? 'Variant' : 'Main Mod'}
            </span>
        `;
    }

    function syncInteractiveToBulk() {
        const inputs = document.querySelectorAll('.interactive-link-input');
        const urls = Array.from(inputs).map(i => i.value.trim()).filter(Boolean);
        document.getElementById('infringingUrlBulk').value = urls.join('\n');
        updateBulkCount();
    }

    function convertBulkToInteractive() {
        const bulkText = document.getElementById('infringingUrlBulk').value || '';
        const urls = bulkText.split(/[\r\n,]+/).map(u => u.trim()).filter(Boolean);
        if (urls.length === 0) return switchLinkMode('interactive');

        const rowsList = document.getElementById('link-rows-list');
        rowsList.innerHTML = '';
        nextRowId = 1;

        urls.forEach(u => addLinkRow(u));
        switchLinkMode('interactive');
    }

    function updateBulkCount() {
        const bulkText = document.getElementById('infringingUrlBulk').value || '';
        const urls = bulkText.split(/[\r\n,]+/).map(u => u.trim()).filter(Boolean);
        document.getElementById('bulk-links-counter').textContent = `${urls.length} URL${urls.length === 1 ? '' : 's'} detected`;
    }

    function handleDmcaSubmit(event) {
        const payloadContainer = document.getElementById('hidden-urls-payload');
        payloadContainer.innerHTML = '';

        let urlsToSubmit = [];
        if (currentMode === 'interactive') {
            const inputs = document.querySelectorAll('.interactive-link-input');
            urlsToSubmit = Array.from(inputs).map(i => i.value.trim()).filter(Boolean);
        } else {
            const bulkText = document.getElementById('infringingUrlBulk').value || '';
            urlsToSubmit = bulkText.split(/[\r\n,]+/).map(u => u.trim()).filter(Boolean);
        }

        if (urlsToSubmit.length === 0) {
            alert('Please provide at least one infringing GPLMods URL.');
            event.preventDefault();
            return false;
        }

        urlsToSubmit.forEach(url => {
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'infringingUrls[]';
            hiddenInput.value = url;
            payloadContainer.appendChild(hiddenInput);
        });

        return true;
    }

    // URL parameter alert handling
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const alertBox = document.getElementById('dmca-alert-box');
        
        if (urlParams.has('error')) { 
            alertBox.textContent = urlParams.get('error');
            alertBox.className = 'dmca-alert error';
            alertBox.style.display = 'block';
            alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        if (urlParams.has('success')) { 
            alertBox.textContent = urlParams.get('success');
            alertBox.className = 'dmca-alert success';
            alertBox.style.display = 'block';
            alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    });
</script>

<%- include('../../partials/footer') %>