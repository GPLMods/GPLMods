<%- include('../../partials/header') %>

<style>
    .explainer-hero { 
        text-align: center; 
        padding: 50px 20px 30px 20px; 
    }
    
    .hero-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 16px;
        background: rgba(255, 215, 0, 0.12);
        border: 1px solid rgba(255, 215, 0, 0.35);
        color: var(--gold);
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        margin-bottom: 20px;
        box-shadow: 0 0 15px rgba(255, 215, 0, 0.15);
    }

    .explainer-hero h1 { 
        font-size: 3.2em; 
        color: var(--white); 
        margin-bottom: 12px; 
        line-height: 1.2; 
        font-weight: 800;
    }
    .explainer-hero h1 span { 
        color: var(--gold); 
        text-shadow: 0 0 15px rgba(255, 215, 0, 0.5); 
    }
    .explainer-hero p { 
        color: var(--silver); 
        font-size: 1.15em; 
        max-width: 820px; 
        margin: 0 auto; 
        line-height: 1.6; 
    }

    .content-wrapper { 
        max-width: 1050px; 
        margin: 40px auto 70px auto; 
        padding: 0 20px; 
    }
    
    /* Explainer Glass Cards */
    .explainer-card { 
        background: linear-gradient(155deg, rgba(22, 22, 28, 0.88) 0%, rgba(12, 12, 16, 0.96) 100%); 
        border: 1px solid rgba(255, 255, 255, 0.09); 
        border-radius: 18px; 
        padding: 40px; 
        margin-bottom: 45px; 
        box-shadow: 0 15px 35px rgba(0,0,0,0.5); 
        position: relative;
        overflow: hidden;
    }
    .explainer-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, var(--gold), transparent);
    }

    .card-title-row {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .card-title-row i {
        color: var(--gold);
        font-size: 1.6em;
        filter: drop-shadow(0 0 8px rgba(255, 215, 0, 0.4));
    }
    .card-title-row h2 {
        color: #ffffff;
        font-size: 1.8em;
        font-weight: 700;
        margin: 0;
    }

    .explainer-card p { 
        color: #b0bec5; 
        line-height: 1.75; 
        font-size: 1.05em; 
        margin-bottom: 20px; 
    }
    .explainer-card p strong {
        color: #fff;
    }

    /* Layout for Text + Visual */
    .text-image-split { 
        display: grid; 
        grid-template-columns: 1fr 280px; 
        gap: 40px; 
        align-items: center; 
    }
    .virus-anim-card { 
        display: flex; 
        flex-direction: column;
        justify-content: center; 
        align-items: center; 
        background: rgba(10, 10, 14, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 20px;
    }
    
    /* Code Highlights Grid */
    .code-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
        gap: 22px; 
        margin-top: 30px; 
    }
    .code-card { 
        background: linear-gradient(155deg, rgba(18, 18, 22, 0.95) 0%, rgba(10, 10, 14, 0.98) 100%); 
        border: 1px solid rgba(255, 255, 255, 0.08); 
        border-left: 4px solid #f44336; 
        padding: 24px; 
        border-radius: 14px; 
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease; 
        display: flex; 
        flex-direction: column; 
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    }
    .code-card:hover { 
        transform: translateY(-4px); 
        border-left-color: var(--gold); 
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6), 0 0 18px rgba(255, 215, 0, 0.15); 
    }
    
    .code-card-header { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        margin-bottom: 14px; 
    }
    .code-card-header h4 { 
        color: #ffffff; 
        margin: 0; 
        font-size: 1.15em; 
        font-weight: 700;
    }
    .code-platform { 
        font-size: 0.75em; 
        font-weight: 700; 
        padding: 3px 10px; 
        border-radius: 12px; 
        letter-spacing: 0.4px;
        text-transform: uppercase;
    }
    .code-platform.android { background: rgba(76, 175, 80, 0.18); color: #4caf50; border: 1px solid rgba(76, 175, 80, 0.35); }
    .code-platform.ios { background: rgba(255, 255, 255, 0.15); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.3); }
    .code-platform.windows { background: rgba(33, 150, 243, 0.18); color: #60a5fa; border: 1px solid rgba(33, 150, 243, 0.35); }

    .code-badge-safe {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.72rem;
        font-weight: 700;
        color: #4caf50;
        background: rgba(76, 175, 80, 0.1);
        border: 1px solid rgba(76, 175, 80, 0.25);
        padding: 2px 8px;
        border-radius: 6px;
        margin-bottom: 12px;
        width: fit-content;
    }

    .code-card code { 
        display: block; 
        background: #0d0e12; 
        color: #ff8a80; 
        padding: 12px 14px; 
        border-radius: 8px; 
        font-family: 'Consolas', 'Courier New', monospace; 
        font-size: 0.88em; 
        margin-bottom: 14px; 
        border: 1px solid rgba(255, 255, 255, 0.08); 
        word-break: break-all; 
        line-height: 1.5;
    }
    .code-card p { 
        color: #a0aec0; 
        font-size: 0.92em; 
        margin: 0; 
        line-height: 1.6; 
        flex-grow: 1; 
    }

    /* Sandbox Grid Styles */
    .sandbox-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); 
        gap: 20px; 
        margin-top: 25px; 
    }
    .sandbox-card { 
        background: linear-gradient(155deg, rgba(16, 16, 20, 0.95) 0%, rgba(10, 10, 14, 0.98) 100%); 
        border: 1px solid rgba(255, 255, 255, 0.08); 
        border-radius: 14px; 
        padding: 22px; 
        transition: transform 0.25s ease, border-color 0.25s ease; 
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
    }
    .sandbox-card:hover { 
        transform: translateY(-4px); 
        border-color: rgba(255, 215, 0, 0.4); 
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), 0 0 15px rgba(255, 215, 0, 0.1); 
    }
    .sandbox-card h4 { 
        color: var(--white); 
        margin: 0 0 16px 0; 
        font-size: 1.15em; 
        display: flex; 
        align-items: center; 
        gap: 10px; 
        border-bottom: 1px solid rgba(255, 255, 255, 0.08); 
        padding-bottom: 12px; 
    }
    .sandbox-links { list-style: none; padding: 0; margin: 0; }
    .sandbox-links li { margin-bottom: 10px; }
    .sandbox-links li:last-child { margin-bottom: 0; }
    .sandbox-links a { 
        color: var(--silver); 
        text-decoration: none; 
        display: flex; 
        align-items: center; 
        justify-content: space-between; 
        transition: all 0.2s ease; 
        font-size: 0.92em; 
        padding: 8px 10px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid transparent;
    }
    .sandbox-links a:hover { 
        color: var(--gold); 
        background: rgba(255, 215, 0, 0.08);
        border-color: rgba(255, 215, 0, 0.25);
        transform: translateX(3px);
    }
    .sandbox-links a i { font-size: 0.8em; color: #718096; transition: color 0.2s; }
    .sandbox-links a:hover i { color: var(--gold); }
    
    /* Disclaimer Banner */
    .disclaimer-banner { 
        background: rgba(255, 215, 0, 0.08); 
        border-left: 4px solid var(--gold); 
        border: 1px solid rgba(255, 215, 0, 0.25);
        border-left-width: 4px;
        padding: 20px 24px; 
        border-radius: 12px; 
        margin-bottom: 25px; 
        font-size: 0.95em; 
        color: #d1d5db; 
        line-height: 1.6; 
    }
    .disclaimer-banner strong { color: var(--gold); display: flex; align-items: center; gap: 8px; margin-bottom: 6px; font-size: 1.05em; }

    /* Guarantee Banner */
    .trust-guarantee-banner { 
        background: linear-gradient(155deg, rgba(18, 28, 20, 0.95) 0%, rgba(10, 16, 12, 0.98) 100%); 
        border: 1px solid rgba(76, 175, 80, 0.4); 
        padding: 38px 30px; 
        border-radius: 18px; 
        margin-top: 50px; 
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.7), 0 0 25px rgba(76, 175, 80, 0.15); 
    }
    .trust-guarantee-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 18px;
    }
    .trust-guarantee-header i {
        font-size: 2.2rem;
        color: #4caf50;
        filter: drop-shadow(0 0 12px rgba(76, 175, 80, 0.5));
    }
    .trust-guarantee-header h3 {
        color: #ffffff;
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0;
    }
    
    .guarantee-pillars {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 18px;
        margin-top: 24px;
    }
    .pillar-card {
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(76, 175, 80, 0.25);
        border-radius: 12px;
        padding: 16px 18px;
    }
    .pillar-card h5 {
        color: #4caf50;
        margin: 0 0 6px 0;
        font-size: 1rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .pillar-card p {
        color: #a0aec0;
        font-size: 0.88rem;
        line-height: 1.5;
        margin: 0;
    }

    @media (max-width: 820px) {
        .text-image-split { grid-template-columns: 1fr; text-align: center; }
        .explainer-hero h1 { font-size: 2.3em; }
        .explainer-card { padding: 25px 20px; }
        .code-grid { grid-template-columns: 1fr; }
        .sandbox-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 520px) {
        .sandbox-grid { grid-template-columns: 1fr; }
    }
</style>

<main>
    <div class="explainer-hero">
        <%- include('../../partials/go-back-button', { fallback: '/' }) %>
        <div class="container">
            <div class="hero-badge-pill">
                <i class="fas fa-shield-virus"></i> Cybersecurity &amp; Heuristic Engine Analysis
            </div>
            <h1>Understanding <span>Antivirus Detections</span></h1>
            <p>Why do safe mods sometimes trigger heuristic warnings on VirusTotal? Understand the exact reverse-engineering mechanics behind "False Positives" and learn how to audit scan reports with confidence.</p>
        </div>
    </div>

    <div class="content-wrapper">
        
        <!-- Section 1: What is a False Positive? -->
        <div class="explainer-card">
            <div class="card-title-row">
                <i class="fa-solid fa-shield-virus"></i>
                <h2>What is a "False Positive"?</h2>
            </div>
            <div class="text-image-split">
                <div>
                    <p>When official software vendors publish an app, they lock the archive with an encrypted <strong>Digital Cryptographic Signature</strong> (e.g., Google Play Sign, Apple Developer Certificate). To create a functional mod—such as unlocking premium subscriptions, eliminating ads, or inserting custom tweak menus—reverse engineers must disassemble the package, patch the bytecode, and repackage it.</p>
                    <p>Because the original corporate signature key is destroyed in this process, the developer must re-sign the app using a public testing key. Commercial Antivirus (AV) scanners are hard-coded to trigger on <strong>any modified binary whose original corporate certificate has been broken</strong>. The scanner flags the package purely for being altered, not because malicious payload exists.</p>
                </div>
                <div class="virus-anim-card">
                    <lottie-player src="<%= cdnUrl %>/animations/scan.json" background="transparent" speed="1" style="width: 220px; height: 220px; filter: drop-shadow(0 0 15px rgba(255, 82, 82, 0.4)); display: block; margin: 0 auto;" loop autoplay></lottie-player>
                    <span style="color: #ff8a80; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 8px;">Signature Hash Mismatch Detected</span>
                </div>
            </div>
        </div>

        <!-- Section 2: Common Scary Codes -->
        <div class="explainer-card">
            <div class="card-title-row">
                <i class="fas fa-bug"></i>
                <h2>Common "Scary" Detection Codes Demystified</h2>
            </div>
            <p>If a mod exhibits 2 to 4 flags out of 70+ engines on VirusTotal, inspect the <strong>exact detection string</strong>. If you recognize the signature patterns below, they are harmless flags caused entirely by normal modding techniques.</p>
            
            <div class="code-grid">
                
                <div class="code-card">
                    <div class="code-card-header">
                        <h4>Public TestKey Flag</h4>
                        <span class="code-platform android">Android</span>
                    </div>
                    <div class="code-badge-safe"><i class="fas fa-check-circle"></i> False Positive (Safe)</div>
                    <code>Android.Riskware.TestKey.rA<br>PUA.AndroidOS.ApkSignatureKiller</code>
                    <p><strong>Mechanics:</strong> The original developer signature was removed. To allow installation on non-rooted devices, the modder re-signed with a public test key. Scanners flag this to inform you that Google Play didn't sign it.</p>
                </div>

                <div class="code-card">
                    <div class="code-card-header">
                        <h4>Unwanted Program (PUP)</h4>
                        <span class="code-platform android">Android</span>
                    </div>
                    <div class="code-badge-safe"><i class="fas fa-check-circle"></i> False Positive (Safe)</div>
                    <code>PUP/Android.Malct.1151236<br>PUP/Android.Moda.1297228</code>
                    <p><strong>Mechanics:</strong> "PUP" stands for Potentially Unwanted Program. This is a low-severity heuristic flag triggered whenever an app contains ad-blocking routines or bypasses billing gateways.</p>
                </div>

                <div class="code-card">
                    <div class="code-card-header">
                        <h4>Dylib Memory Injection</h4>
                        <span class="code-platform ios">iOS / macOS</span>
                    </div>
                    <div class="code-badge-safe"><i class="fas fa-check-circle"></i> False Positive (Safe)</div>
                    <code>OSX/GM.Stealer.KK<br>OSX.Trojan.Agent.ELJ669<br>MacOS:Agent-BDU [Susp]</code>
                    <p><strong>Mechanics:</strong> iOS sideloaded mods hook dynamic libraries (<code>.dylib</code>) into memory to unlock features. Because the tweak hooks runtime classes, rigid engines mistakenly identify it as an intrusive agent.</p>
                </div>

                <div class="code-card">
                    <div class="code-card-header">
                        <h4>License Verification Bypass</h4>
                        <span class="code-platform windows">Windows</span>
                    </div>
                    <div class="code-badge-safe"><i class="fas fa-check-circle"></i> False Positive (Safe)</div>
                    <code>HackTool:Win32/Patch<br>Crack.Activator</code>
                    <p><strong>Mechanics:</strong> Triggered by binaries engineered to bypass DRM checks or software serial licensing. Windows Defender flags "HackTool" to protect proprietary copyrights, not due to computer viruses.</p>
                </div>

            </div>
        </div>

        <!-- Section 3: Sandbox Testing -->
        <div class="explainer-card">
            <div class="card-title-row">
                <i class="fas fa-laptop-code"></i>
                <h2>Isolated Cloud Sandbox &amp; Virtual Testing</h2>
            </div>
            <p>Want 100% peace of mind before installing files onto your personal device? Run them within an isolated, virtual cloud container. These platforms execute applications in sandboxed environments without touching your hardware.</p>
            
            <div class="disclaimer-banner">
                <strong><i class="fas fa-exclamation-triangle"></i> Independent Third-Party Directory</strong>
                The services below are independent tools not hosted by GPL Mods. Free or trial tiers may apply. Virtual environments may restrict certain heavy games requiring hardware-level GPU virtualization.
            </div>

            <div class="sandbox-grid">
                
                <!-- Android Sandbox Links -->
                <div class="sandbox-card">
                    <h4><i class="fab fa-android" style="color: var(--android-color);"></i> Android Sandboxes</h4>
                    <ul class="sandbox-links">
                        <li><a href="https://firebase.google.com/docs/test-lab" target="_blank" rel="noopener noreferrer">Firebase Test Lab <i class="fas fa-external-link-alt"></i></a></li>
                        <li><a href="https://developer.samsung.com/remote-test-lab" target="_blank" rel="noopener noreferrer">Samsung Remote Lab <i class="fas fa-external-link-alt"></i></a></li>
                        <li><a href="https://www.myandroid.org/" target="_blank" rel="noopener noreferrer">MyAndroid Online <i class="fas fa-external-link-alt"></i></a></li>
                    </ul>
                </div>

                <!-- Multi-Platform Links -->
                <div class="sandbox-card">
                    <h4><i class="fas fa-mobile-alt" style="color: #60a5fa;"></i> Multi-Device / Web</h4>
                    <ul class="sandbox-links">
                        <li><a href="https://www.onworks.net/" target="_blank" rel="noopener noreferrer">OnWorks OS <i class="fas fa-external-link-alt"></i></a></li>
                        <li><a href="https://www.browserstack.com/" target="_blank" rel="noopener noreferrer">BrowserStack <i class="fas fa-external-link-alt"></i></a></li>
                        <li><a href="https://saucelabs.com/" target="_blank" rel="noopener noreferrer">SauceLabs <i class="fas fa-external-link-alt"></i></a></li>
                        <li><a href="https://www.lambdatest.com/" target="_blank" rel="noopener noreferrer">LambdaTest <i class="fas fa-external-link-alt"></i></a></li>
                    </ul>
                </div>

                <!-- Windows Sandbox Links -->
                <div class="sandbox-card">
                    <h4><i class="fab fa-windows" style="color: var(--windows-color);"></i> Windows Sandboxes</h4>
                    <ul class="sandbox-links">
                        <li><a href="https://www.apponfly.com/" target="_blank" rel="noopener noreferrer">AppOnFly VPS <i class="fas fa-external-link-alt"></i></a></li>
                        <li><a href="https://puter.com/" target="_blank" rel="noopener noreferrer">Puter Cloud OS <i class="fas fa-external-link-alt"></i></a></li>
                        <li><a href="https://github.com/microsoft/Windows-Sandbox" target="_blank" rel="noopener noreferrer">MS Sandbox Guide <i class="fas fa-external-link-alt"></i></a></li>
                    </ul>
                </div>

                <!-- WordPress Links -->
                <div class="sandbox-card">
                    <h4><i class="fab fa-wordpress" style="color: var(--wordpress-color);"></i> WordPress Sandboxes</h4>
                    <ul class="sandbox-links">
                        <li><a href="https://tastewp.com/" target="_blank" rel="noopener noreferrer">TasteWP Instant <i class="fas fa-external-link-alt"></i></a></li>
                        <li><a href="https://instawp.com/" target="_blank" rel="noopener noreferrer">InstaWP Cloud <i class="fas fa-external-link-alt"></i></a></li>
                        <li><a href="https://wpsandbox.net/" target="_blank" rel="noopener noreferrer">WPSandbox <i class="fas fa-external-link-alt"></i></a></li>
                        <li><a href="https://playground.wordpress.net/" target="_blank" rel="noopener noreferrer">WP Playground (WASM) <i class="fas fa-external-link-alt"></i></a></li>
                    </ul>
                </div>

            </div>
        </div>

        <!-- Section 4: How GPL Mods Protects You -->
        <div class="trust-guarantee-banner">
            <div class="trust-guarantee-header">
                <i class="fas fa-shield-alt"></i>
                <div>
                    <h3>The GPL Mods Triple-Shield Guarantee</h3>
                    <p style="color: #b0bec5; margin: 4px 0 0 0; font-size: 0.95rem;">Automated scanners are only step one. Here is how our multi-layered defense model protects you.</p>
                </div>
            </div>
            
            <div class="guarantee-pillars">
                <div class="pillar-card">
                    <h5><i class="fas fa-robot"></i> 1. Live VirusTotal API</h5>
                    <p>Every single uploaded file is dynamically sent to 70+ commercial antivirus engines via the VirusTotal v3 API before publication.</p>
                </div>
                <div class="pillar-card">
                    <h5><i class="fas fa-user-check"></i> 2. 14-Day Staff Auditing</h5>
                    <p>Uploads undergo a mandatory 14-day quarantine period and manual administrator testing before earning the gold "Certified" badge.</p>
                </div>
                <div class="pillar-card">
                    <h5><i class="fas fa-users"></i> 3. Community Working Vote</h5>
                    <p>Real registered members vote on mod functionality. If an update breaks or exhibits suspicious activity, it is quarantined immediately.</p>
                </div>
            </div>
        </div>

    </div>
</main>

<%- include('../../partials/footer') %>