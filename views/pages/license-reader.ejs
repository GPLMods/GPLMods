<%-include('../partials/header') %>

<style>
    .license-reader { max-width: 980px; margin: 0 auto; padding: 35px 20px 70px; }
    .license-header { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; padding: 25px 0; border-bottom: 1px solid #333; }
    .license-kicker { color: var(--gold); text-transform: uppercase; letter-spacing: 2px; font-size: 0.8em; font-weight: 700; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
    .license-header h1 { color: var(--white); margin: 0; font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; }
    .license-badges-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
    .license-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 215, 0, 0.1);
        border: 1px solid rgba(255, 215, 0, 0.25);
        color: var(--gold);
        font-size: 0.76rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 14px;
        letter-spacing: 0.3px;
    }
    .license-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    .license-actions .btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border-radius: 8px;
        color: var(--white);
        font-weight: 600;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
        text-decoration: none;
        border: 1px solid rgba(255, 215, 0, 0.28);
        background-color: #181818;
        cursor: pointer;
        transition: all 0.25s ease;
    }
    .license-actions .btn i {
        color: var(--gold);
        font-size: 0.95rem;
    }
    .license-actions .btn:hover {
        color: var(--gold);
        border-color: var(--gold);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(255, 215, 0, 0.25);
    }
    .license-document { margin-top: 28px; padding: clamp(20px, 4vw, 36px); background: linear-gradient(145deg, #16171d 0%, #0e0f14 100%); border: 1px solid #333; border-top: 3px solid var(--gold); border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.45); }
    .license-summary { color: #cbd5e1; font-size: 1.02rem; line-height: 1.7; padding-bottom: 20px; margin-bottom: 22px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
    .license-content { 
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
        font-size: 0.92rem;
        line-height: 1.75;
        white-space: pre-wrap; 
        overflow-wrap: anywhere;
        color: #f1f5f9;
        background: #090a0f;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        padding: 24px;
        margin: 0;
        user-select: text;
        -webkit-user-select: text;
        max-height: 72vh;
        overflow-y: auto;
    }
    @media (max-width: 600px) { 
        .license-header { align-items: flex-start; flex-direction: column; } 
        .license-actions { width: 100%; } 
        .license-actions .btn { flex: 1; justify-content: center; } 
    }
</style>

<main class="license-reader">
    <div class="back-btn-wrapper" style="margin-bottom: 1.5rem;">
        <%- include('../partials/go-back-button', { fallback: '/licenses', label: 'Back to Licenses' }) %>
    </div>

    <header class="license-header">
        <div>
            <div class="license-kicker"><i class="fas fa-file-contract"></i> Official Legal Document</div>
            <h1><%= license.name %></h1>
            <div class="license-badges-row">
                <span class="license-pill"><i class="fas fa-shield-alt"></i> Verified License</span>
                <span class="license-pill"><i class="fas fa-balance-scale"></i> Open Source</span>
                <span class="license-pill"><i class="fas fa-code"></i> GPL Compatible</span>
            </div>
        </div>
        <div class="license-actions">
            <button type="button" class="btn btn-secondary" id="btnCopyLicense" onclick="copyLicenseText()" title="Copy entire license text">
                <i class="fas fa-copy"></i> <span id="copyLicenseLabel">Copy Text</span>
            </button>
            <a class="btn btn-secondary" href="/licenses/<%= license.slug %>/download?format=txt" title="Download as text"><i class="fas fa-file-lines"></i> TXT</a>
            <a class="btn btn-secondary" href="/licenses/<%= license.slug %>/download?format=md" title="Download as Markdown"><i class="fab fa-markdown"></i> MD</a>
        </div>
    </header>

    <article class="license-document">
        <% if (license.shortDescription) { %><p class="license-summary"><%= license.shortDescription %></p><% } %>
        <pre class="license-content" id="licenseRawContent"><%= license.content %></pre>
    </article>
</main>

<script>
    function copyLicenseText() {
        const pre = document.getElementById('licenseRawContent');
        if (!pre) return;
        const text = pre.innerText || pre.textContent;
        navigator.clipboard.writeText(text).then(() => {
            const label = document.getElementById('copyLicenseLabel');
            const btn = document.getElementById('btnCopyLicense');
            if (label) label.textContent = 'Copied!';
            if (btn) btn.style.borderColor = 'var(--green)';
            if (window.showGplToast) {
                window.showGplToast({ title: 'License Copied', body: 'License text copied to your clipboard.' });
            }
            setTimeout(() => {
                if (label) label.textContent = 'Copy Text';
                if (btn) btn.style.borderColor = '';
            }, 2500);
        }).catch(err => {
            console.error('Failed to copy license:', err);
        });
    }
</script>

<%- include('../partials/footer') %>
