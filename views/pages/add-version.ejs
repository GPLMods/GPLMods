<%- include('../partials/header') %>
<!-- Quill.js Theme (Snow) -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<style>
    .upload-container { max-width: 700px; margin: 4rem auto; padding: 3rem 2rem; background-color: var(--dark-gray); border-radius: 12px; text-align: center; border: 1px solid #333; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    .form-group { text-align: left; margin-bottom: 20px; position: relative; }
    .form-group label { display: block; margin-bottom: 8px; font-weight: 600; color: var(--silver); }
    .form-group input[type="text"], .form-group input[type="url"], .form-group textarea { width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid #333; background-color: var(--black); color: var(--white); font-size: 1.1em; font-family: 'Poppins', sans-serif; transition: all 0.3s ease; outline: none; }
    .form-group input:focus, .form-group textarea:focus { border-color: var(--gold); box-shadow: 0 0 10px var(--glow-gold); }
    .file-input-label { display: inline-block; padding: 15px 30px; background: transparent; color: var(--gold); border: 2px dashed var(--gold); border-radius: 8px; cursor: pointer; transition: all 0.3s ease; font-size: 1.2em; margin-bottom: 1rem; width: 100%; text-align: center; }
    .file-input-label:hover { background: rgba(255, 215, 0, 0.1); }
    .submit-button { display: block; width: 100%; background: var(--gold); color: var(--black); padding: 15px 20px; border-radius: 8px; font-weight: 700; font-size: 1.2em; border: none; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 0 15px var(--glow-gold); margin-top: 2rem; }
    .submit-button:hover { transform: translateY(-2px); box-shadow: 0 0 25px var(--glow-gold); }
    .submit-button:disabled { background-color: #555; color: #aaa; cursor: not-allowed; box-shadow: none; transform: none; }
    #file-name-display { margin-top: 15px; color: var(--white); font-weight: 600; font-size: 1.1em; text-align: center; }
    
    /* Live Progress Bar */
    .progress-wrapper { display: none; margin-top: 25px; text-align: left; }
    .progress-container { width: 100%; background-color: var(--black); border: 1px solid #444; border-radius: 8px; height: 25px; overflow: hidden; position: relative; }
    .progress-bar { height: 100%; width: 0%; background-color: var(--gold); transition: width 0.2s ease; display: flex; align-items: center; justify-content: center; color: var(--black); font-weight: bold; font-size: 0.85em; white-space: nowrap; }
    .status-text { color: var(--silver); margin-top: 10px; font-size: 0.95em; text-align: center; }
    @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.6; } 100% { opacity: 1; } }
    .processing-pulse { animation: pulse 1.5s infinite; }

    /* Custom Dropdown Styles */
    .custom-select-wrapper { position: relative; user-select: none; width: 100%; }
    .filter-group .custom-select-wrapper { width: 150px; }
    .custom-select { position: relative; display: flex; flex-direction: column; background: var(--black); border: 1px solid #333; border-radius: 8px; cursor: pointer; padding: 12px 15px; color: var(--white); transition: border-color 0.3s; }
    .custom-select-wrapper.open .custom-select { border-color: var(--blue); border-bottom-left-radius: 0; border-bottom-right-radius: 0; box-shadow: 0 0 10px rgba(33, 150, 243, 0.3); }
    .custom-select-arrow { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); transition: transform 0.3s; color: var(--silver); }
    .custom-select-wrapper.open .custom-select-arrow { transform: translateY(-50%) rotate(180deg); color: var(--blue); }
    .custom-options { position: absolute; display: none; top: 100%; left: 0; right: 0; background: var(--black); border: 1px solid var(--blue); border-top: none; border-radius: 0 0 8px 8px; z-index: 10; max-height: 200px; overflow-y: auto; box-shadow: 0 10px 20px rgba(0,0,0,0.5); }
    .custom-select-wrapper.open .custom-options { display: block; }
    .custom-option { padding: 12px 15px; color: var(--silver); cursor: pointer; transition: all 0.2s; }
    .custom-option:hover { background-color: rgba(33, 150, 243, 0.2); color: var(--white); }
    .custom-option.selected { color: var(--blue); font-weight: bold; }

    /* Method Selection Pill Buttons */
    .method-btn-group { display: flex; gap: 12px; justify-content: center; margin-bottom: 25px; }
    .btn-method { flex: 1; padding: 12px 20px; border-radius: 30px; font-weight: 700; font-size: 1.05em; cursor: pointer; transition: all 0.3s ease; border: none; outline: none; text-align: center; }
    .btn-method.active-method { background: #ffffff; color: #111111; box-shadow: 0 4px 15px rgba(255, 255, 255, 0.2); }
    .btn-method.inactive-method { background: rgba(255, 255, 255, 0.08); color: var(--silver); border: 1px solid rgba(255, 255, 255, 0.15); }
    .btn-method.inactive-method:hover { background: rgba(255, 255, 255, 0.15); color: #ffffff; }

    /* Action buttons */
    .btn-action { display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; font-weight: 600; cursor: pointer; transition: all 0.2s ease; border: none; }
    .btn-action-secondary { background: #2a2a2a; color: var(--silver); border: 1px solid #444; }
    .btn-action-secondary:hover { background: #3a3a3a; color: var(--white); border-color: #666; }
    .btn-action-danger { background: #d32f2f; color: #fff; }
    .btn-action-danger:hover { background: #b71c1c; }

    /* Template Helper & Dropdown Styles */
    .template-dropdown {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #111;
        border: 1px solid var(--gold);
        border-radius: 8px;
        z-index: 100;
        max-height: 250px;
        overflow-y: auto;
        box-shadow: 0 10px 25px rgba(0,0,0,0.8);
    }
    .template-option {
        padding: 12px 15px;
        border-bottom: 1px solid #222;
        cursor: pointer;
        transition: background 0.2s ease;
    }
    .template-option:last-child { border-bottom: none; }
    .template-option:hover { background: #222; }
    .template-option-title { color: var(--gold); font-weight: bold; display: block; margin-bottom: 4px; }
    .template-option-preview { color: var(--silver); font-size: 0.85em; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .template-helper-btn {
        background: rgba(255, 215, 0, 0.1);
        color: var(--gold);
        border: 1px solid rgba(255, 215, 0, 0.3);
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.8em;
        cursor: pointer;
        margin-left: 10px;
        transition: all 0.2s ease;
        display: inline-block;
        vertical-align: middle;
    }
    .template-helper-btn:hover { background: var(--gold); color: var(--black); }
</style>

<div class="container">
    <!-- ======== DYNAMIC GO BACK BUTTON ======== -->
    <div style="margin-bottom: 20px;">
        <a href="javascript:history.back()" style="color: var(--silver); text-decoration: none; display: inline-flex; align-items: center; font-weight: 600; font-size: 1.05em; transition: color 0.3s ease;" onmouseover="this.style.color='var(--white)'" onmouseout="this.style.color='var(--silver)'">
            <i class="fas fa-arrow-left" style="margin-right: 8px;"></i> Go Back
        </a>
    </div>
    <!-- ======================================== -->
    <div class="upload-container">
        <h2 style="color: var(--white); margin-bottom: 10px; font-size: 2.2em;">Update <span style="color: var(--gold); text-shadow: 0 0 4px var(--glow-gold);"><%= parentFile.name %></span></h2>
        <p style="color: var(--silver); margin-bottom: 2.5rem;">Uploading a new version will make this file the primary download.</p>

        <!-- ONE UNIFIED FORM -->
        <form action="/mods/<%= parentFile._id %>/add-version" method="POST" enctype="multipart/form-data" id="unifiedAddVersionForm">
            <input type="hidden" name="uploadId" id="uploadId" value="">
            
            <!-- a. AUTO-FETCH TOGGLE -->
            <div class="form-group" style="display: flex; align-items: center; gap: 10px; background: rgba(255, 215, 0, 0.05); padding: 15px; border-radius: 8px; border: 1px solid #333;">
                <label class="switch" style="margin-bottom: 0;">
                    <input type="checkbox" id="toggleAutoFetch">
                    <span class="slider round"></span>
                </label>
                <label for="toggleAutoFetch" style="margin: 0; color: var(--gold); cursor: pointer; font-size: 1.1em;">Auto-Fetch Latest App Data from Store</label>
            </div>

            <!-- AUTO-FETCH CONTAINER -->
            <div id="autoFetchContainer" style="display: none; background: rgba(33, 150, 243, 0.1); border: 1px solid var(--blue); padding: 20px; border-radius: 8px; margin-bottom: 25px;">
                <p style="color: var(--silver); font-size: 0.9em; margin-bottom: 15px;">Paste the store link to automatically grab the latest "What's New" notes and requirements.</p>
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <div class="filter-group">
                        <select id="fetchPlatform" style="display: none;">
                            <option value="auto" selected>Auto Detect</option>
                            <option value="playstore">Play Store</option>
                            <option value="appstore">App Store</option>
                            <option value="steam">Steam</option>
                            <option value="epic">Epic Games</option>
                            <option value="wordpress">WordPress</option>
                        </select>
                        <div class="custom-select-wrapper" id="wrapper-fetchPlatform">
                            <div class="custom-select"><span class="selected-text">Auto Detect</span><i class="fas fa-chevron-down custom-select-arrow"></i></div>
                            <div class="custom-options">
                                <div class="custom-option selected" data-value="auto">Auto Detect</div>
                                <div class="custom-option" data-value="playstore">Play Store</div>
                                <div class="custom-option" data-value="appstore">App Store</div>
                                <div class="custom-option" data-value="steam">Steam</div>
                                <div class="custom-option" data-value="epic">Epic Games</div>
                                <div class="custom-option" data-value="wordpress">WordPress</div>
                            </div>
                        </div>
                    </div>
                    <input type="url" id="fetchUrl" placeholder="Paste store link (Google Play, App Store, Steam, Epic, WordPress)..." style="flex-grow: 1;">
                    <button type="button" id="fetchBtn" class="btn btn-primary" style="background: var(--blue); color: white; border: none; border-radius: 8px; padding: 0 20px; font-weight: bold; cursor: pointer;">Fetch</button>
                </div>
                <span id="fetchStatus" style="display: block; margin-top: 10px; font-size: 0.85em; font-weight: bold;"></span>
            </div>

            <!-- b. NEW VERSION NUMBER -->
            <div class="form-group">
                <label for="softwareVersion">New Version Number*</label>
                <input type="text" id="softwareVersion" name="softwareVersion" placeholder="e.g., 2.2.0" required autocomplete="off">
            </div>

            <!-- c. AGE RATING -->
            <div class="form-group">
                <label for="ageRating">Age Rating</label>
                <select id="ageRating" name="ageRating" style="display: none;">
                    <option value="NA" <%= (!parentFile.ageRating || parentFile.ageRating === 'NA') ? 'selected' : '' %>>Not Rated (N/A)</option>
                    <option value="3+" <%= parentFile.ageRating === '3+' ? 'selected' : '' %>>3+ (Everyone)</option>
                    <option value="7+" <%= parentFile.ageRating === '7+' ? 'selected' : '' %>>7+ (Low Violence)</option>
                    <option value="12+" <%= parentFile.ageRating === '12+' ? 'selected' : '' %>>12+ (Moderate Violence)</option>
                    <option value="16+" <%= parentFile.ageRating === '16+' ? 'selected' : '' %>>16+ (Strong Violence)</option>
                    <option value="18+" <%= parentFile.ageRating === '18+' ? 'selected' : '' %>>18+ (Adults Only)</option>
                </select>
                <div class="custom-select-wrapper" id="ageRatingWrapper">
                    <div class="custom-select"><span class="selected-text"><%= parentFile.ageRating ? (parentFile.ageRating === 'NA' ? 'Not Rated (N/A)' : parentFile.ageRating) : 'Not Rated (N/A)' %></span><i class="fas fa-chevron-down custom-select-arrow"></i></div>
                    <div class="custom-options">
                        <div class="custom-option <%= (!parentFile.ageRating || parentFile.ageRating === 'NA') ? 'selected' : '' %>" data-value="NA">Not Rated (N/A)</div>
                        <div class="custom-option <%= parentFile.ageRating === '3+' ? 'selected' : '' %>" data-value="3+">3+ (Everyone)</div>
                        <div class="custom-option <%= parentFile.ageRating === '7+' ? 'selected' : '' %>" data-value="7+">7+ (Low Violence)</div>
                        <div class="custom-option <%= parentFile.ageRating === '12+' ? 'selected' : '' %>" data-value="12+">12+ (Moderate Violence)</div>
                        <div class="custom-option <%= parentFile.ageRating === '16+' ? 'selected' : '' %>" data-value="16+">16+ (Strong Violence)</div>
                        <div class="custom-option <%= parentFile.ageRating === '18+' ? 'selected' : '' %>" data-value="18+">18+ (Adults Only)</div>
                    </div>
                </div>
            </div>

            <!-- d. MINIMUM OS REQUIRED (Single column directly under Age Rating) -->
            <div class="form-group">
                <label for="minOsVersion">Minimum OS Required</label>
                <input type="text" id="minOsVersion" name="minOsVersion" value="<%= parentFile.minOsVersion || '' %>" placeholder="e.g., Required Android 8.0 or above">
            </div>

            <!-- e. WHAT'S NEW IN THIS VERSION -->
            <div class="form-group" style="position: relative;">
                <label>
                    What's New in this Version? (Optional)
                    <span class="template-helper-btn" data-target="whatsNew">💡 Use Template</span>
                </label>
                <div id="editor-container"><%- parentFile.whatsNew || '' %></div>
                <div id="dropdown-whatsNew" class="template-dropdown"></div>
                <input type="hidden" name="whatsNew" id="hiddenWhatsNew">
                <p style="color: var(--silver); font-size: 0.85em; margin-top: 5px;">List changes. If left blank, the old notes will be used.</p>
            </div>

            <!-- f. IMPORTANT NOTE / INSTRUCTIONS -->
            <div class="form-group" style="position: relative;">
                <label for="importantNote">
                    Important Note / Installation Instructions (Optional)
                    <span class="template-helper-btn" data-target="importantNote">💡 Use Template</span>
                </label>
                <textarea id="importantNote" name="importantNote" rows="4" style="width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid #333; background-color: var(--black); color: var(--white); font-size: 1.1em; font-family: 'Poppins', sans-serif; outline: none; resize: vertical;"><%= parentFile.importantNote || '' %></textarea>
                <div id="dropdown-importantNote" class="template-dropdown"></div>
                <span style="font-size: 0.85em; color: var(--silver); display: block; margin-top: 5px;">Leave blank to keep the previous version's instructions.</span>
            </div>

            <!-- g. METHOD SELECTION BUTTONS (DISTRIBUTOR / ADMIN / OWNER) -->
            <% if (user && (user.role === 'distributor' || user.role === 'admin' || user.role === 'owner')) { %>
                <div style="margin: 30px 0 20px 0; border-top: 1px solid #333; padding-top: 20px;">
                    <p style="color: var(--silver); margin-bottom: 1.5rem;">
                        <span style="color: var(--gold); font-weight: bold;">★ <%= user.role === 'owner' ? 'Owner' : (user.role === 'admin' ? 'Admin' : 'Distributor') %> Upload Method ★</span>
                    </p>
                    <div class="method-btn-group">
                        <button type="button" class="btn-method active-method" id="btn-show-file">Upload to Cloud</button>
                        <button type="button" class="btn-method inactive-method" id="btn-show-link">Paste External Link(s)</button>
                    </div>
                </div>

                <!-- External Link Section (Hidden by Default) -->
                <div id="distributor-section" style="display: none;">
                    <!-- Field Positioning: File Name (for display purposes) placed ABOVE the multi-part configurator -->
                    <div class="form-group">
                        <label for="originalFilename">File Name (for display purposes)*</label>
                        <input type="text" id="originalFilename" name="originalFilename" value="<%= parentFile.originalFilename || parentFile.name %>" placeholder="e.g., app-v2.0.apk">
                    </div>

                    <div class="form-group" style="text-align: left; margin-bottom: 15px;">
                        <div class="checkbox-group" style="display: flex; align-items: center; gap: 10px;">
                            <label class="switch" style="margin-bottom: 0;">
                                <input type="checkbox" id="isMultiPartDistributor" name="isMultiPart" value="true">
                                <span class="slider round"></span>
                            </label>
                            <label for="isMultiPartDistributor" style="margin-bottom: 0; cursor: pointer; color: var(--silver); font-weight: 600;">This mod requires multiple download links (Multi-Part)</label>
                        </div>
                    </div>

                    <!-- Single Link Input Group (Default) -->
                    <div id="single-link-group" class="form-group">
                        <label for="externalUrl">External Download Link*</label>
                        <input type="url" id="externalUrl" name="externalDownloadUrl" placeholder="https://linkvertise.com/...">

                        <div style="margin-top: 15px;">
                            <label for="directDownloadUrl">Direct Cloud Link (Optional)</label>
                            <input type="url" id="directDownloadUrl" name="directDownloadUrl" placeholder="https://www.dropbox.com/s/.../app.zip?dl=1">
                            <span style="font-size: 0.85em; color: var(--silver); display: block; margin-top: 5px;">Optional direct link for faster downloads and 1-click install flows.</span>
                        </div>
                    </div>

                    <!-- Advanced Multi-Part Configurator (Shown when checked) -->
                    <div id="multi-link-group" class="form-group" style="text-align: left; display: none;">
                        <div style="background: rgba(255, 215, 0, 0.1); border: 1px solid var(--gold); padding: 15px; border-radius: 8px;">
                            <p style="color: var(--gold); font-weight: bold; margin: 0; font-size: 1.1em;"><i class="fas fa-layer-group"></i> Multi-Part Configurator</p>
                            <p style="color: var(--silver); margin-top: 5px; margin-bottom: 10px; font-size: 0.95em;">Add parts below. Each part may include mirrors, a direct admin link, and scan references. You can add unlimited parts.</p>
                            <div id="parts-container">
                                <!-- Part 1 -->
                                <div class="part-block" style="border:1px solid #333; padding:10px; border-radius:8px; margin-bottom:10px;">
                                    <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Part Name</label>
                                    <input type="text" name="partNames[]" placeholder="Part 1 (e.g., main, data)" style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                    <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Part URL*</label>
                                    <input type="url" name="partUrls[]" placeholder="https://.../part1" style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                    <div style="display:flex; gap:8px;">
                                        <div style="flex:1;">
                                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Mirror 1 Provider</label>
                                            <input type="text" name="mirror1Providers[]" placeholder="Google Drive" style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                        </div>
                                        <div style="flex:2;">
                                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Mirror 1 URL</label>
                                            <input type="url" name="mirror1Urls[]" placeholder="https://..." style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                        </div>
                                    </div>
                                    <div style="display:flex; gap:8px;">
                                        <div style="flex:1;">
                                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Mirror 2 Provider</label>
                                            <input type="text" name="mirror2Providers[]" placeholder="Mega" style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                        </div>
                                        <div style="flex:2;">
                                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Mirror 2 URL</label>
                                            <input type="url" name="mirror2Urls[]" placeholder="https://..." style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                        </div>
                                    </div>
                                    <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Direct Admin Link</label>
                                    <input type="url" name="directAdminLinks[]" placeholder="https://admin.example.com/direct/" style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                    <div style="display:flex; gap:8px;">
                                        <div style="flex:1;">
                                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Manual File Scan URL</label>
                                            <input type="url" name="manualFileScanUrls[]" placeholder="https://www.virustotal.com/..." style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                        </div>
                                        <div style="flex:1;">
                                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Manual Site Scan URL</label>
                                            <input type="url" name="manualSiteScanUrls[]" placeholder="https://sitecheck.sucuri.net/..." style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                        </div>
                                    </div>
                                </div>
                                <!-- Part 2 -->
                                <div class="part-block" style="border:1px solid #333; padding:10px; border-radius:8px; margin-bottom:10px;">
                                    <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Part Name</label>
                                    <input type="text" name="partNames[]" placeholder="Part 2 (e.g., split-1)" style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                    <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Part URL*</label>
                                    <input type="url" name="partUrls[]" placeholder="https://.../part2" style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                    <div style="display:flex; gap:8px;">
                                        <div style="flex:1;">
                                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Mirror 1 Provider</label>
                                            <input type="text" name="mirror1Providers[]" placeholder="Google Drive" style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                        </div>
                                        <div style="flex:2;">
                                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Mirror 1 URL</label>
                                            <input type="url" name="mirror1Urls[]" placeholder="https://..." style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                        </div>
                                    </div>
                                    <div style="display:flex; gap:8px;">
                                        <div style="flex:1;">
                                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Mirror 2 Provider</label>
                                            <input type="text" name="mirror2Providers[]" placeholder="Mega" style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                        </div>
                                        <div style="flex:2;">
                                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Mirror 2 URL</label>
                                            <input type="url" name="mirror2Urls[]" placeholder="https://..." style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                        </div>
                                    </div>
                                    <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Direct Admin Link</label>
                                    <input type="url" name="directAdminLinks[]" placeholder="https://admin.example.com/direct/" style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                    <div style="display:flex; gap:8px;">
                                        <div style="flex:1;">
                                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Manual File Scan URL</label>
                                            <input type="url" name="manualFileScanUrls[]" placeholder="https://www.virustotal.com/..." style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                        </div>
                                        <div style="flex:1;">
                                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Manual Site Scan URL</label>
                                            <input type="url" name="manualSiteScanUrls[]" placeholder="https://sitecheck.sucuri.net/..." style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div style="display:flex; gap:8px;">
                                <button type="button" id="add-part-btn" class="btn-action btn-action-secondary" style="padding: 8px 14px; font-size: 0.95em;">+ Add Another Part</button>
                                <button type="button" id="remove-part-btn" class="btn-action btn-action-danger" style="padding: 8px 14px; font-size: 0.95em;">- Remove Last Part</button>
                            </div>
                        </div>
                    </div>

                    <% if (user.role === 'admin' || user.role === 'owner') { %>
                        <div class="form-group" style="border: 1px solid #444; padding: 15px; border-radius: 8px; margin-top: 15px;">
                            <label style="color: var(--gold);">Admin Override: Security Scan Links</label>
                            <input type="url" name="manualFileScanUrl" placeholder="File Scan URL (Optional)" style="margin-bottom: 10px;">
                            <input type="url" name="manualSiteScanUrl" placeholder="Site Scan URL (Optional)">
                        </div>
                    <% } %>
                </div>
            <% } %>

            <!-- FILE UPLOAD SECTION (Visible by default) -->
            <div id="file-upload-section">
                <% 
                    let limitText = (user && user.membership === 'premium') ? "1 GB" : "300 MB"; 
                    let limitBytes = (user && user.membership === 'premium') ? 1073741824 : 314572800;
                    if (user && (user.role === 'admin' || user.role === 'owner' || user.role === 'distributor')) { limitText = "Unlimited"; limitBytes = 999999999999; }
                %>
                <p style="color: var(--gold); font-weight: bold; margin: 1rem 0;">Max File Size: <%= limitText %></p>
                
                <div class="form-group">
                    <label for="modFile" class="file-input-label" id="drop-zone">
                        <i class="fas fa-cloud-upload-alt" style="font-size: 2em; display: block; margin-bottom: 10px;"></i>
                        Click to Choose New File
                    </label>
                    <input type="file" id="modFile" name="modFile" required style="display:none;" data-limit="<%= limitBytes %>">
                    <div id="file-name-display">No file selected</div>
                </div>
                
                <!-- LIVE PROGRESS BAR UI -->
                <div class="progress-wrapper" id="progressWrapper">
                    <div class="progress-container"><div class="progress-bar" id="progressBar">0%</div></div>
                    <p class="status-text" id="statusText">Starting upload...</p>
                </div>
            </div>

            <!-- SUBMIT BUTTON -->
            <button type="submit" class="submit-button" id="submitBtn">Publish Update</button>
            
            <!-- POLICY LINK (At bottom of page, below Publish Update button) -->
            <p style="font-size: 0.85em; color: var(--silver); margin-top: 2rem; margin-bottom: 1rem;">By uploading, you agree to our <a href="/upload-policy" target="_blank" style="color: var(--gold); text-decoration: underline;">Upload & Update Policy</a>.</p>
        </form>
    </div>
</div>

<!-- ERROR MODAL -->
<div id="error-modal" class="policy-modal">
    <div class="policy-modal-content" style="background-color: var(--dark-gray); padding: 30px; text-align: center; border-radius: 15px; max-width: 400px; width: 90%; border-top: 3px solid var(--red); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        <i class="fas fa-exclamation-triangle" style="font-size: 3em; color: var(--red); margin-bottom: 15px;"></i>
        <h2 style="color: var(--white); margin-bottom: 15px;">Upload Error</h2>
        <p id="error-modal-msg" style="margin-bottom: 25px; color: var(--silver); line-height: 1.6;"></p>
        <button type="button" class="btn btn-primary" onclick="closeErrorModal()" style="width: 100%; padding: 12px; border-radius: 8px; font-weight: bold; font-size: 1.1em; background-color: var(--red); border: none; cursor: pointer;">Okay</button>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

<script>
    function showErrorModal(message) {
        if (typeof window.showDynamicAlert === 'function') {
            window.showDynamicAlert('error', 'Upload Error', message, {
                Message: message,
                Page: window.location.pathname
            });
            return;
        }
        document.getElementById('error-modal-msg').textContent = message;
        const modal = document.getElementById('error-modal');
        modal.style.display = 'flex';
        setTimeout(() => modal.classList.add('show'), 10);
    }
    function closeErrorModal() {
        const modal = document.getElementById('error-modal');
        modal.classList.remove('show');
        setTimeout(() => modal.style.display = 'none', 200);
    }

    document.addEventListener('DOMContentLoaded', () => {
        // --- 1. Quill Editor Init ---
        var quill = new Quill('#editor-container', {
            theme: 'snow',
            placeholder: 'List changes... If left blank, the old notes will be used.',
            modules: { toolbar: [ ['bold', 'italic', 'underline', 'strike'], [{'list': 'ordered'}, {'list': 'bullet'}], ['clean'] ] }
        });
        const qlToolbar = document.querySelector('.ql-toolbar');
        const qlContainer = document.querySelector('.ql-container');
        if (qlToolbar) { qlToolbar.style.backgroundColor = '#222'; qlToolbar.style.borderColor = '#333'; qlToolbar.style.borderTopLeftRadius = '8px'; qlToolbar.style.borderTopRightRadius = '8px'; }
        if (qlContainer) { qlContainer.style.borderColor = '#333'; qlContainer.style.borderBottomLeftRadius = '8px'; qlContainer.style.borderBottomRightRadius = '8px'; qlContainer.style.minHeight = '150px'; qlContainer.style.color = 'var(--white)'; qlContainer.style.fontFamily = "'Poppins', sans-serif"; qlContainer.style.fontSize = '1em'; }

        // --- 2. Custom Dropdown Init ---
        function setupCustomSelect(wrapperId, nativeSelectId) {
            const wrapper = document.getElementById(wrapperId);
            const nativeSelect = document.getElementById(nativeSelectId);
            if (!wrapper || !nativeSelect) return;
            const customSelect = wrapper.querySelector('.custom-select');
            const selectedText = wrapper.querySelector('.selected-text');
            const optionsContainer = wrapper.querySelector('.custom-options');

            customSelect.addEventListener('click', (e) => {
                wrapper.classList.toggle('open');
                e.stopPropagation(); 
            });

            optionsContainer.addEventListener('click', (e) => {
                const optionEl = e.target.closest('.custom-option');
                if (!optionEl) return;
                selectedText.textContent = optionEl.textContent;
                nativeSelect.value = optionEl.getAttribute('data-value');
                wrapper.querySelectorAll('.custom-option').forEach(opt => opt.classList.remove('selected'));
                optionEl.classList.add('selected');
                wrapper.classList.remove('open');
            });
        }
        setupCustomSelect('wrapper-fetchPlatform', 'fetchPlatform');
        setupCustomSelect('ageRatingWrapper', 'ageRating');
        
        const ageRating = document.getElementById('ageRating');
        const ageRatingText = document.querySelector('#ageRatingWrapper .selected-text');
        if (ageRating && ageRatingText && ageRating.value) {
            const selectedAge = ageRating.options[ageRating.selectedIndex];
            if (selectedAge) {
                ageRatingText.textContent = selectedAge.textContent;
                document.querySelector(`#ageRatingWrapper .custom-option[data-value="${ageRating.value}"]`)?.classList.add('selected');
            }
        }
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.custom-select-wrapper')) {
                document.querySelectorAll('.custom-select-wrapper.open').forEach(w => w.classList.remove('open'));
            }
        });

        // --- 3. Auto Fetch & Metadata Modal Logic ---
        const toggleAutoFetch = document.getElementById('toggleAutoFetch');
        const autoFetchContainer = document.getElementById('autoFetchContainer');
        const fetchBtn = document.getElementById('fetchBtn');
        const fetchPlatformSelect = document.getElementById('fetchPlatform');
        const fetchUrlInput = document.getElementById('fetchUrl');

        const storePlaceholders = {
            auto: 'Paste store link (Google Play, App Store, Steam, Epic, WordPress)...',
            playstore: 'https://play.google.com/store/apps/details?id=...',
            appstore: 'https://apps.apple.com/app/.../id...',
            steam: 'https://store.steampowered.com/app/...',
            epic: 'https://store.epicgames.com/p/...',
            wordpress: 'https://wordpress.org/plugins/...'
        };

        const storeNames = {
            auto: 'Auto-Detected Store',
            playstore: 'Google Play Store',
            appstore: 'Apple App Store',
            steam: 'Steam Store',
            epic: 'Epic Games Store',
            wordpress: 'WordPress.org'
        };

        const updateFetchPlaceholder = () => {
            if (!fetchPlatformSelect || !fetchUrlInput) return;
            const currentPlatform = fetchPlatformSelect.value || 'auto';
            if (storePlaceholders[currentPlatform]) {
                fetchUrlInput.placeholder = storePlaceholders[currentPlatform];
            }
        };

        if (fetchPlatformSelect) {
            fetchPlatformSelect.addEventListener('change', updateFetchPlaceholder);
            updateFetchPlaceholder();
        }

        document.querySelectorAll('#wrapper-fetchPlatform .custom-option').forEach(option => {
            option.addEventListener('click', () => {
                setTimeout(updateFetchPlaceholder, 50);
            });
        });

        const fetchMetadataModal = document.getElementById('fetchMetadataModal');
        const closeFetchModalBtn = document.getElementById('closeFetchModalBtn');
        const cancelFetchModalBtn = document.getElementById('cancelFetchModalBtn');
        const applyFetchModalBtn = document.getElementById('applyFetchModalBtn');
        const selectAllFetchFieldsBtn = document.getElementById('selectAllFetchFieldsBtn');
        const deselectAllFetchFieldsBtn = document.getElementById('deselectAllFetchFieldsBtn');
        const fetchModalSourceBadge = document.getElementById('fetchModalSourceBadge');

        let lastFetchedMetadata = null;

        const closeMetadataModal = () => {
            if (fetchMetadataModal) {
                fetchMetadataModal.style.display = 'none';
                document.body.style.overflow = '';
            }
        };

        if (closeFetchModalBtn) closeFetchModalBtn.addEventListener('click', closeMetadataModal);
        if (cancelFetchModalBtn) cancelFetchModalBtn.addEventListener('click', closeMetadataModal);

        if (selectAllFetchFieldsBtn) {
            selectAllFetchFieldsBtn.addEventListener('click', () => {
                ['whatsNew', 'ageRating', 'minOsVersion', 'softwareVersion'].forEach(key => {
                    const chk = document.getElementById(`fetch_opt_${key}`);
                    if (chk && !chk.disabled) chk.checked = true;
                });
            });
        }

        if (deselectAllFetchFieldsBtn) {
            deselectAllFetchFieldsBtn.addEventListener('click', () => {
                ['whatsNew', 'ageRating', 'minOsVersion', 'softwareVersion'].forEach(key => {
                    const chk = document.getElementById(`fetch_opt_${key}`);
                    if (chk) chk.checked = false;
                });
            });
        }

        if (toggleAutoFetch && autoFetchContainer) {
            toggleAutoFetch.addEventListener('change', function() {
                autoFetchContainer.style.display = this.checked ? 'block' : 'none';
            });
        }

        if (fetchBtn) {
            fetchBtn.addEventListener('click', async function() {
                const platform = fetchPlatformSelect ? fetchPlatformSelect.value : 'auto';
                const url = fetchUrlInput ? fetchUrlInput.value.trim() : '';
                const statusSpan = document.getElementById('fetchStatus');

                if (!url) { 
                    if (statusSpan) {
                        statusSpan.textContent = 'Please enter a URL first.'; 
                        statusSpan.style.color = 'var(--red)'; 
                    }
                    return; 
                }

                fetchBtn.disabled = true; 
                fetchBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Fetching...'; 
                if (statusSpan) statusSpan.textContent = '';

                try {
                    const response = await fetch('/api/fetch-metadata', {
                        method: 'POST', 
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ url, platform })
                    });
                    const result = await response.json();
                    if (result.success && result.data) {
                        lastFetchedMetadata = result.data;
                        if (statusSpan) {
                            statusSpan.textContent = 'Store data fetched! Select fields in modal to apply.'; 
                            statusSpan.style.color = 'var(--green)';
                        }

                        const detectedSource = result.data.detectedPlatform || platform;
                        if (fetchModalSourceBadge) {
                            fetchModalSourceBadge.textContent = `${storeNames[detectedSource] || detectedSource} Data`;
                        }

                        const fieldMappings = [
                            { key: 'whatsNew', val: result.data.whatsNew || '' },
                            { key: 'ageRating', val: result.data.ageRating || result.data.minAge || '' },
                            { key: 'minOsVersion', val: result.data.minOsVersion || result.data.minOs || '' },
                            { key: 'softwareVersion', val: result.data.softwareVersion || result.data.version || '' }
                        ];

                        fieldMappings.forEach(item => {
                            const valEl = document.getElementById(`fetch_val_${item.key}`);
                            const chkEl = document.getElementById(`fetch_opt_${item.key}`);
                            if (valEl) {
                                valEl.innerHTML = item.val ? (item.val.length > 250 ? item.val.substring(0, 250) + '...' : item.val) : '<em style="color:#777;">Not found in store page</em>';
                            }
                            if (chkEl) {
                                if (item.val) {
                                    // CRITICAL: File Version is unchecked by default
                                    if (item.key === 'softwareVersion') {
                                        chkEl.checked = false;
                                    } else {
                                        chkEl.checked = true;
                                    }
                                    chkEl.disabled = false;
                                } else {
                                    chkEl.checked = false;
                                    chkEl.disabled = true;
                                }
                            }
                        });

                        if (fetchMetadataModal) {
                            fetchMetadataModal.style.display = 'flex';
                            document.body.style.overflow = 'hidden';
                        }
                    } else {
                        if (statusSpan) {
                            statusSpan.textContent = result.error || 'Failed to fetch data.'; 
                            statusSpan.style.color = 'var(--red)'; 
                        }
                    }
                } catch (err) { 
                    if (statusSpan) {
                        statusSpan.textContent = 'Server error.'; 
                        statusSpan.style.color = 'var(--red)'; 
                    }
                } finally { 
                    fetchBtn.disabled = false; 
                    fetchBtn.textContent = 'Fetch'; 
                }
            });
        }

        if (applyFetchModalBtn) {
            applyFetchModalBtn.addEventListener('click', () => {
                if (!lastFetchedMetadata) return;

                // 1. What's New
                if (document.getElementById('fetch_opt_whatsNew')?.checked && lastFetchedMetadata.whatsNew) {
                    if (quill) {
                        quill.root.innerHTML = lastFetchedMetadata.whatsNew;
                    }
                    const hiddenWhatsNew = document.getElementById('hiddenWhatsNew');
                    if (hiddenWhatsNew) hiddenWhatsNew.value = lastFetchedMetadata.whatsNew;
                }

                // 2. Minimum Age Requirement
                if (document.getElementById('fetch_opt_ageRating')?.checked && lastFetchedMetadata.ageRating) {
                    const ma = document.getElementById('ageRating');
                    const val = lastFetchedMetadata.ageRating;
                    if (ma) {
                        ma.value = val;
                        const opt = ma.querySelector(`option[value="${val}"]`);
                        if (opt && ageRatingText) ageRatingText.textContent = opt.textContent;
                        document.querySelectorAll('#ageRatingWrapper .custom-option').forEach(o => {
                            o.classList.toggle('selected', o.getAttribute('data-value') === val);
                        });
                    }
                }

                // 3. Minimum OS Required
                if (document.getElementById('fetch_opt_minOsVersion')?.checked) {
                    const moVal = lastFetchedMetadata.minOsVersion || lastFetchedMetadata.minOs;
                    const mo = document.getElementById('minOsVersion');
                    if (mo && moVal) mo.value = moVal;
                }

                // 4. File Version (Applied if checked - unchecked by default)
                if (document.getElementById('fetch_opt_softwareVersion')?.checked) {
                    const verVal = lastFetchedMetadata.softwareVersion || lastFetchedMetadata.version;
                    const verInput = document.getElementById('softwareVersion');
                    if (verInput && verVal) verInput.value = verVal;
                }

                closeMetadataModal();
            });
        }

        // --- SMART TEMPLATES LOGIC FOR ADD-VERSION ---
        const smartTemplates = {
            whatsNew: [
                { title: "Standard Release Notes", text: "• Bug fixes and performance improvements.\n• Unlocked latest premium features.\n• Enhanced stability and compatibility." },
                { title: "Major Update Changelog", text: "• Added full support for newest operating systems.\n• Fixed license verification and crashes.\n• Optimized memory usage and loading times." }
            ],
            importantNote: [
                { title: "Standard Install Guide", text: "1. Uninstall any previous or official versions of this app.\n2. Download the APK file from the link below.\n3. Allow installation from 'Unknown Sources' in your device settings.\n4. Install the app and enjoy!" },
                { title: "Login Fix Guide", text: "⚠️ IMPORTANT: If you are unable to login using Google or Facebook, please use a Guest Account or register using a generic email/password inside the app." }
            ]
        };

        const serverTemplates = <%- JSON.stringify(typeof customTemplates !== 'undefined' ? customTemplates : []) %>;
        if (Array.isArray(serverTemplates) && serverTemplates.length > 0) {
            serverTemplates.forEach(t => {
                if (t.targetField && t.content) {
                    if (!smartTemplates[t.targetField]) smartTemplates[t.targetField] = [];
                    smartTemplates[t.targetField].push({ title: t.title, text: t.content });
                }
            });
        }

        function setupAddVersionTemplate(targetId) {
            const dropdown = document.getElementById(`dropdown-${targetId}`);
            if (!dropdown) return;
            const templates = smartTemplates[targetId];
            if (!templates || templates.length === 0) return;

            dropdown.innerHTML = templates.map((tmpl, index) => `
                <div class="template-option" data-index="${index}">
                    <span class="template-option-title">${tmpl.title}</span>
                    <span class="template-option-preview">${tmpl.text.replace(/\n/g, ' ')}</span>
                </div>
            `).join('');

            dropdown.querySelectorAll('.template-option').forEach(opt => {
                opt.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const selectedTemplate = templates[this.getAttribute('data-index')].text;
                    if (targetId === 'whatsNew' && quill) {
                        const currentHtml = quill.root.innerHTML;
                        if (!currentHtml || currentHtml === '<p><br></p>') {
                            quill.setText(selectedTemplate + '\n');
                        } else {
                            quill.insertText(quill.getLength(), '\n' + selectedTemplate);
                        }
                    } else if (targetId === 'importantNote') {
                        const noteEl = document.getElementById('importantNote');
                        if (noteEl) {
                            if (!noteEl.value.trim()) {
                                noteEl.value = selectedTemplate;
                            } else {
                                noteEl.value += '\n\n' + selectedTemplate;
                            }
                        }
                    }
                    dropdown.style.display = 'none';
                });
            });
        }

        setupAddVersionTemplate('whatsNew');
        setupAddVersionTemplate('importantNote');

        document.querySelectorAll('.template-helper-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                const targetId = btn.getAttribute('data-target');
                const dropdown = document.getElementById(`dropdown-${targetId}`);
                if (!dropdown) return;
                const isCurrentlyOpen = dropdown.style.display === 'block';
                document.querySelectorAll('.template-dropdown').forEach(d => d.style.display = 'none');
                dropdown.style.display = isCurrentlyOpen ? 'none' : 'block';
            });
        });

        document.addEventListener('click', (e) => {
            if (!e.target.closest('.template-dropdown') && !e.target.closest('.template-helper-btn')) {
                document.querySelectorAll('.template-dropdown').forEach(d => d.style.display = 'none');
            }
        });

        // --- 4. Distributor Toggles & Logic ---
        const btnShowLink = document.getElementById('btn-show-link');
        const btnShowFile = document.getElementById('btn-show-file');
        const fileSection = document.getElementById('file-upload-section');
        const distSection = document.getElementById('distributor-section');
        const modFileInput = document.getElementById('modFile');
        const extUrlInput = document.getElementById('externalUrl');
        const origNameInput = document.getElementById('originalFilename');
        const uploadIdInput = document.getElementById('uploadId');
        const multiPartCheckbox = document.getElementById('isMultiPartDistributor');
        const partsContainer = document.getElementById('parts-container');
        let currentMode = 'file'; 

        function setPartsRequired(required) {
            if (!partsContainer) return;
            partsContainer.querySelectorAll('input').forEach(i => {
                if (i.name === 'partUrls[]') i.required = required;
            });
        }

        if (btnShowLink && btnShowFile && distSection && fileSection) {
            btnShowLink.addEventListener('click', () => {
                currentMode = 'link';
                btnShowLink.classList.remove('inactive-method');
                btnShowLink.classList.add('active-method');
                btnShowFile.classList.remove('active-method');
                btnShowFile.classList.add('inactive-method');
                distSection.style.display = 'block';
                fileSection.style.display = 'none';
                if (modFileInput) modFileInput.required = false; 
                if (origNameInput) origNameInput.required = true;
                if (multiPartCheckbox && multiPartCheckbox.checked) {
                    if (extUrlInput) extUrlInput.required = false;
                    setPartsRequired(true);
                } else {
                    if (extUrlInput) extUrlInput.required = true;
                    setPartsRequired(false);
                }
            });
            btnShowFile.addEventListener('click', () => {
                currentMode = 'file';
                btnShowFile.classList.remove('inactive-method');
                btnShowFile.classList.add('active-method');
                btnShowLink.classList.remove('active-method');
                btnShowLink.classList.add('inactive-method');
                fileSection.style.display = 'block';
                distSection.style.display = 'none';
                if (modFileInput) modFileInput.required = true; 
                if (extUrlInput) extUrlInput.required = false;
                if (origNameInput) origNameInput.required = false;
                setPartsRequired(false);
            });
        }

        if (uploadIdInput && !uploadIdInput.value) {
            uploadIdInput.value = 'up_' + Date.now();
        }

        // --- 5. Advanced Multi-Part Configurator Logic ---
        if (multiPartCheckbox && partsContainer) {
            const singleLinkGroup = document.getElementById('single-link-group');
            const multiLinkGroup = document.getElementById('multi-link-group');
            const addPartBtn = document.getElementById('add-part-btn');
            const removePartBtn = document.getElementById('remove-part-btn');

            multiPartCheckbox.addEventListener('change', function() {
                if (this.checked) {
                    if (singleLinkGroup) singleLinkGroup.style.display = 'none';
                    if (extUrlInput) extUrlInput.required = false;
                    if (multiLinkGroup) multiLinkGroup.style.display = 'block';
                    if (currentMode === 'link') setPartsRequired(true);
                } else {
                    if (singleLinkGroup) singleLinkGroup.style.display = 'block';
                    if (extUrlInput && currentMode === 'link') extUrlInput.required = true;
                    if (multiLinkGroup) multiLinkGroup.style.display = 'none';
                    setPartsRequired(false);
                }
            });

            function createPartBlock(index) {
                const block = document.createElement('div');
                block.className = 'part-block';
                block.style.cssText = 'border:1px solid #333; padding:10px; border-radius:8px; margin-bottom:10px;';
                block.innerHTML = `
                    <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Part Name</label>
                    <input type="text" name="partNames[]" placeholder="Part ${index} (optional)" style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                    <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Part URL*</label>
                    <input type="url" name="partUrls[]" placeholder="https://.../part${index}" ${currentMode === 'link' ? 'required' : ''} style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                    <div style="display:flex; gap:8px;">
                        <div style="flex:1;">
                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Mirror 1 Provider</label>
                            <input type="text" name="mirror1Providers[]" placeholder="Google Drive" style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                        </div>
                        <div style="flex:2;">
                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Mirror 1 URL</label>
                            <input type="url" name="mirror1Urls[]" placeholder="https://..." style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                        </div>
                    </div>
                    <div style="display:flex; gap:8px;">
                        <div style="flex:1;">
                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Mirror 2 Provider</label>
                            <input type="text" name="mirror2Providers[]" placeholder="Mega" style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                        </div>
                        <div style="flex:2;">
                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Mirror 2 URL</label>
                            <input type="url" name="mirror2Urls[]" placeholder="https://..." style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                        </div>
                    </div>
                    <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Direct Admin Link</label>
                    <input type="url" name="directAdminLinks[]" placeholder="https://admin.example.com/direct/" style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                    <div style="display:flex; gap:8px;">
                        <div style="flex:1;">
                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Manual File Scan URL</label>
                            <input type="url" name="manualFileScanUrls[]" placeholder="https://www.virustotal.com/..." style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                        </div>
                        <div style="flex:1;">
                            <label style="color:var(--silver); font-weight:600; display:block; margin-bottom:6px;">Manual Site Scan URL</label>
                            <input type="url" name="manualSiteScanUrls[]" placeholder="https://sitecheck.sucuri.net/..." style="width:100%; margin-bottom:8px; padding:10px; border-radius:6px; border:1px solid #333; background:var(--black); color:var(--white);">
                        </div>
                    </div>
                `;
                return block;
            }

            if (addPartBtn) {
                addPartBtn.addEventListener('click', () => {
                    const currentCount = partsContainer.querySelectorAll('.part-block').length;
                    const nextIndex = currentCount + 1;
                    const blk = createPartBlock(nextIndex);
                    partsContainer.appendChild(blk);
                    if (currentMode === 'link') setPartsRequired(true);
                });
            }

            if (removePartBtn) {
                removePartBtn.addEventListener('click', () => {
                    const blocks = partsContainer.querySelectorAll('.part-block');
                    if (blocks.length > 2) {
                        blocks[blocks.length - 1].remove();
                    }
                });
            }
        }

        // --- 6. File Selection & Form Submission Logic ---
        const fileNameDisplay = document.getElementById('file-name-display');
        const form = document.getElementById('unifiedAddVersionForm');
        const submitBtn = document.getElementById('submitBtn');
        const dropZone = document.getElementById('drop-zone');
        const progressWrapper = document.getElementById('progressWrapper');
        const progressBar = document.getElementById('progressBar');
        const statusText = document.getElementById('statusText');

        if (modFileInput) {
            modFileInput.addEventListener('change', function() {
                if (this.files && this.files.length > 0) {
                    const file = this.files[0];
                    const sizeInMB = (file.size / (1024 * 1024)).toFixed(2);
                    const maxLimit = parseInt(this.getAttribute('data-limit') || '999999999999', 10);
                    
                    if (file.size > maxLimit) {
                        showErrorModal(`File is too large! Your limit is ${maxLimit === 314572800 ? '300 MB' : '1 GB'}.`);
                        this.value = ''; 
                        fileNameDisplay.textContent = 'No file selected';
                        dropZone.style.borderColor = 'var(--red)';
                        dropZone.style.backgroundColor = 'rgba(229, 57, 53, 0.05)';
                        return;
                    }
                    fileNameDisplay.textContent = `Ready: ${file.name} (${sizeInMB} MB)`;
                    dropZone.style.borderColor = 'var(--gold)';
                    dropZone.style.backgroundColor = 'rgba(255, 215, 0, 0.05)';
                }
            });
        }

        form.addEventListener('submit', function(e) {
            e.preventDefault(); 
            
            const contentHtml = quill.root.innerHTML;
            document.getElementById('hiddenWhatsNew').value = (contentHtml === '<p><br></p>' || contentHtml.trim() === '') ? '' : contentHtml;

            if (currentMode === 'file' && (!modFileInput || modFileInput.files.length === 0)) {
                return showErrorModal("Please select a file to upload.");
            }

            if (currentMode === 'link') {
                if (origNameInput && !origNameInput.value.trim()) {
                    return showErrorModal("Please enter a display file name.");
                }
                if (multiPartCheckbox && multiPartCheckbox.checked) {
                    const partUrlInputs = partsContainer ? Array.from(partsContainer.querySelectorAll('input[name="partUrls[]"]')) : [];
                    const hasValidPart = partUrlInputs.some(i => i.value.trim().length > 0);
                    if (!hasValidPart) {
                        return showErrorModal("Please provide at least one valid part URL.");
                    }
                } else {
                    if (extUrlInput && !extUrlInput.value.trim()) {
                        return showErrorModal("Please enter an external download link.");
                    }
                }
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = 'Processing...';

            if (uploadIdInput && !uploadIdInput.value) {
                uploadIdInput.value = 'up_' + Date.now();
            }

            const formData = new FormData(form);
            const xhr = new XMLHttpRequest();
            xhr.open('POST', form.action, true);

            // ONLY show progress bar if we are actually uploading a file
            if (currentMode === 'file') {
                progressWrapper.style.display = 'block';
                progressBar.style.width = '0%';
                progressBar.textContent = '0%';
                progressBar.classList.remove('processing-pulse');
                statusText.innerHTML = 'Uploading file... Do not close this page.';

                // --- PHASE 2: Listen for Server-to-Cloud progress via Socket.IO ---
                const uploadId = uploadIdInput.value;
                const socket = io();
                socket.on(`b2_progress_${uploadId}`, (data) => {
                    const totalPercent = 50 + Math.round(data.percent / 2);
                    progressBar.style.width = totalPercent + '%';
                    progressBar.textContent = totalPercent + '%';
                    statusText.innerHTML = `Uploading... ${totalPercent}%`;
                    
                    if (data.percent === 100) {
                        progressBar.classList.add('processing-pulse');
                        statusText.innerHTML = 'Finalizing and scanning... Almost done!';
                    }
                });

                // --- PHASE 1: Listen for Browser-to-Server progress via XHR ---
                xhr.upload.addEventListener('progress', function(event) {
                    if (event.lengthComputable) {
                        const percentComplete = Math.round((event.loaded / event.total) * 50); 
                        progressBar.style.width = percentComplete + '%';
                        progressBar.textContent = percentComplete + '%';
                        
                        if (percentComplete === 50) {
                            statusText.innerHTML = 'Processing upload... Do not close this page.';
                        } else {
                            statusText.innerHTML = `Uploading... ${percentComplete}%`;
                        }
                    }
                });
            }

            xhr.onload = function() {
                if (xhr.status >= 200 && xhr.status < 400) {
                    try {
                        const res = JSON.parse(xhr.responseText);
                        if (res.success && res.redirectUrl) {
                            window.location.href = res.redirectUrl; 
                        } else {
                            showErrorModal('Update finished, but server did not provide a redirect URL.');
                            resetUI();
                        }
                    } catch(e) {
                        // Fallback if response isn't JSON
                        window.location.href = xhr.responseURL || '/my-uploads'; 
                    }
                } else {
                    try {
                        const res = JSON.parse(xhr.responseText);
                        showErrorModal(res.message || 'Update failed.');
                    } catch(e) {
                        showErrorModal(`Server error (${xhr.status}).`);
                    }
                    resetUI();
                }
            };

            xhr.onerror = function() { 
                showErrorModal('A network error occurred. Please check your internet connection.'); 
                resetUI(); 
            };
            
            xhr.send(formData);

            function resetUI() {
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Publish Update';
                if (currentMode === 'file') {
                    progressWrapper.style.display = 'none';
                    progressBar.classList.remove('processing-pulse');
                }
            }
        });
    });
</script>

