<%-include('../partials/header') %>
<style>
    /* Styling to match the rest of the Auth forms */
    .challenge-container { 
        background: var(--dark-gray); 
        padding: 40px; 
        border-radius: 15px; 
        border: 1px solid #2a2a2a; 
        max-width: 460px; 
        width: 100%; 
        text-align: center; 
        box-shadow: 0 10px 30px rgba(0,0,0,0.5); 
    }
    
    .social-verify-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: 100%;
        padding: 13px;
        margin-bottom: 12px;
        background-color: transparent; 
        border: 2px solid var(--silver); 
        color: var(--silver);           
        border-radius: 8px;
        font-size: 1.05em;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .social-verify-btn:hover {
        background-color: var(--gold);
        border-color: var(--gold);
        color: var(--black); 
        box-shadow: 0 0 15px var(--glow-gold);
    }
    .social-verify-btn i { font-size: 1.2em; }

    /* The input field for TOTP/Backup codes */
    .code-input {
        width: 100%; 
        padding: 15px; 
        border-radius: 8px; 
        border: 1px solid var(--gold); 
        background: var(--black); 
        color: var(--white); 
        text-align: center; 
        font-size: 1.5em; 
        letter-spacing: 5px; 
        margin-bottom: 20px; 
        outline: none;
        transition: box-shadow 0.3s ease;
        font-family: monospace;
    }
    .code-input:focus {
        box-shadow: 0 0 15px var(--glow-gold);
    }

    .divider {
        text-align: center;
        margin: 25px 0 15px 0;
        position: relative;
        color: #666;
        font-size: 0.9em;
    }
    .divider::before, .divider::after {
        content: "";
        position: absolute;
        top: 50%;
        width: 25%;
        height: 1px;
        background: #333;
    }
    .divider::before { left: 0; }
    .divider::after { right: 0; }

    /* Method Selector Pills */
    .method-selector-container {
        background: rgba(0, 0, 0, 0.45);
        padding: 12px 10px;
        border-radius: 12px;
        border: 1px solid #333;
        margin-bottom: 25px;
    }
    .method-nav-pill {
        padding: 8px 14px;
        border-radius: 20px;
        font-size: 0.85em;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.25s ease;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(255, 255, 255, 0.05);
        color: var(--silver);
    }
    .method-nav-pill:hover {
        background: rgba(255, 255, 255, 0.12);
        color: var(--white);
        border-color: rgba(255, 215, 0, 0.5);
    }
    .method-nav-pill.active {
        background: var(--gold);
        color: var(--black);
        border-color: var(--gold);
        box-shadow: 0 0 14px var(--glow-gold);
        font-weight: 700;
    }

    .alt-method-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 10px 14px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid #333;
        border-radius: 8px;
        color: var(--silver);
        font-size: 0.88em;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.25s ease;
    }
    .alt-method-btn:hover {
        background: rgba(255, 215, 0, 0.08);
        border-color: var(--gold);
        color: var(--gold);
        transform: translateY(-1px);
    }
</style>

<main class="container" style="display: flex; justify-content: center; align-items: center; min-height: 75vh; padding: 40px 0;">
    <div class="challenge-container">
        <%- include('../partials/go-back-button', { fallback: '/login' }) %>
        
        <i class="fas fa-shield-alt" style="font-size: 3.5em; color: var(--gold); margin-bottom: 15px; filter: drop-shadow(0 0 12px rgba(255,215,0,0.35));"></i>
        <h2 style="color: var(--white); margin-bottom: 8px; font-size: 1.6em;">Security Verification</h2>
        
        <% if (error) { %>
            <p style="background: rgba(229, 57, 53, 0.1); border: 1px solid var(--red); color: var(--red); padding: 10px; border-radius: 8px; margin-bottom: 15px; font-weight: bold; font-size: 0.9em;">
                <%= error %>
            </p>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <p style="background: rgba(46, 213, 115, 0.1); border: 1px solid #2ed573; color: #2ed573; padding: 10px; border-radius: 8px; margin-bottom: 15px; font-weight: bold; font-size: 0.9em;">
                <i class="fas fa-check-circle" style="margin-right: 6px;"></i> <%= success %>
            </p>
        <% } %>

        <!-- Multi-Option 2FA Switcher -->
        <% if (typeof availableMethods !== 'undefined' && availableMethods && availableMethods.length > 1) { %>
            <div class="method-selector-container">
                <p style="font-size: 0.82em; color: var(--silver); margin-bottom: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Choose Verification Method:</p>
                <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
                    <% availableMethods.forEach(m => { %>
                        <a href="/login/2fa?method=<%= m %>" 
                           class="method-nav-pill <%= method === m ? 'active' : '' %>">
                            <% if (m === 'email') { %>
                                <i class="fas fa-envelope"></i> Email OTP
                            <% } else if (m === 'totp') { %>
                                <i class="fas fa-mobile-alt"></i> Authenticator
                            <% } else if (m === 'passkey') { %>
                                <i class="fas fa-fingerprint"></i> Passkey
                            <% } else if (m === 'social') { %>
                                <i class="fas fa-share-alt"></i> Social
                            <% } %>
                        </a>
                    <% }); %>
                </div>
            </div>
        <% } %>

        <!-- SCENARIO 1: EMAIL OR TOTP -->
        <% if (method === 'email' || method === 'totp') { %>
            <p style="color: var(--silver); margin-bottom: 25px; font-size: 0.95em; line-height: 1.5;">
                <%= method === 'email' ? "We've sent a secure 6-digit code to your email address." : "Please open your Authenticator app to view your 6-digit code." %>
            </p>
            <form action="/login/2fa/verify" method="POST">
                <!-- Can accept either 6 digit TOTP or 8 char Backup Code -->
                <input type="text" name="token" class="code-input" placeholder="000000" maxlength="8" required autocomplete="off" autofocus>
                <button type="submit" class="btn btn-primary" style="width: 100%; padding: 15px; font-size: 1.1em; background: var(--gold); color: var(--black); border: none; font-weight: bold;">Verify & Login</button>
            </form>
            <% if (method === 'email') { %>
                <div style="margin-top: 12px;">
                    <a href="/login/2fa?method=email&resend=true" style="color: var(--gold); font-size: 0.88em; text-decoration: none;">
                        <i class="fas fa-redo"></i> Resend Email Code
                    </a>
                </div>
            <% } %>
            <p style="margin-top: 15px; font-size: 0.85em; color: #666;">Lost device access? You can enter one of your 8-character backup codes above.</p>
        
        <!-- SCENARIO 2: SOCIAL 2FA -->
        <% } else if (method === 'social') { %>
            <p style="color: var(--silver); margin-bottom: 25px; font-size: 0.95em;">Please verify your identity by logging into your linked social account.</p>
            
            <a href="/auth/google" class="social-verify-btn"><i class="fab fa-google"></i> Verify with Google</a>
            <a href="/auth/github" class="social-verify-btn"><i class="fab fa-github"></i> Verify with GitHub</a>
            <a href="/auth/microsoft" class="social-verify-btn"><i class="fab fa-windows"></i> Verify with Microsoft</a>

        <!-- SCENARIO 3: PASSKEY (WEBAUTHN) -->
        <% } else if (method === 'passkey') { %>
            <p style="color: var(--silver); margin-bottom: 20px; font-size: 0.95em; line-height: 1.5;">
                Use your device's biometric scanner (FaceID, TouchID) or Windows Hello / device PIN to log in securely.
            </p>
            
            <div id="passkey-error-box" style="display: none; background: rgba(229, 57, 53, 0.1); border: 1px solid var(--red); color: var(--red); padding: 12px; border-radius: 8px; margin-bottom: 16px; font-size: 0.88em; line-height: 1.4; text-align: left;">
                <i class="fas fa-exclamation-circle" style="margin-right: 6px;"></i> <span id="passkey-error-text"></span>
            </div>

            <button id="auth-passkey-btn" type="button" class="btn btn-primary" style="width: 100%; padding: 16px; font-size: 1.1em; background: var(--gold); color: var(--black); border: none; font-weight: bold; display: flex; align-items: center; justify-content: center; gap: 12px; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 20px rgba(255, 215, 0, 0.25);">
                <i class="fas fa-fingerprint" style="font-size: 1.3em;"></i> Scan Passkey / Device PIN
            </button>
            
            <script src="https://unpkg.com/@simplewebauthn/browser/dist/bundle/index.umd.min.js"></script>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const btn = document.getElementById('auth-passkey-btn');
                    const errBox = document.getElementById('passkey-error-box');
                    const errText = document.getElementById('passkey-error-text');
                    if (!btn) return;

                    btn.addEventListener('click', async () => {
                        if (errBox) errBox.style.display = 'none';
                        btn.disabled = true;
                        const originalHtml = btn.innerHTML;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Waiting for Device Prompt...';

                        try {
                            if (typeof SimpleWebAuthnBrowser === 'undefined' || !SimpleWebAuthnBrowser.browserSupportsWebAuthn()) {
                                throw new Error('Your browser or device does not support WebAuthn / Passkeys. Please choose another verification method below.');
                            }

                            const { startAuthentication } = SimpleWebAuthnBrowser;
                            const resp = await fetch('/login/2fa/passkey/options');
                            if (!resp.ok) {
                                const errJson = await resp.json().catch(() => ({}));
                                throw new Error(errJson.error || 'Server error initializing passkey');
                            }

                            const options = await resp.json();
                            const asseResp = await startAuthentication(options);

                            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Verifying with Server...';

                            const verificationResp = await fetch('/login/2fa/passkey/verify', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(asseResp),
                            });

                            const verification = await verificationResp.json();
                            if (verification.success) {
                                window.location.href = verification.redirect || '/home?message=Login successful!';
                            } else {
                                throw new Error(verification.error || 'Passkey verification failed on server.');
                            }
                        } catch (err) {
                            console.error('Passkey login error:', err);
                            let msg = err.message || 'Passkey verification failed.';
                            if (err.name === 'NotAllowedError') {
                                msg = 'Device prompt was cancelled or timed out. Click above to try again, or enter your device PIN/password when prompted.';
                            }
                            if (errText && errBox) {
                                errText.textContent = msg;
                                errBox.style.display = 'block';
                            } else {
                                alert(msg);
                            }
                        } finally {
                            btn.disabled = false;
                            btn.innerHTML = originalHtml;
                        }
                    });
                });
            </script>
        <% } %>

        <!-- ALTERNATIVE METHODS BOTTOM SWITCHER -->
        <% if (typeof availableMethods !== 'undefined' && availableMethods && availableMethods.length > 1) { %>
            <div class="alt-methods-container" style="margin-top: 25px; padding-top: 15px; border-top: 1px dashed rgba(255,255,255,0.12);">
                <p style="font-size: 0.82em; color: var(--silver); margin-bottom: 10px;">Or verify using another method:</p>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <% availableMethods.filter(m => m !== method).forEach(m => { %>
                        <a href="/login/2fa?method=<%= m %>" class="alt-method-btn">
                            <% if (m === 'email') { %>
                                <i class="fas fa-envelope" style="color: var(--gold);"></i> Use Email Verification Code
                            <% } else if (m === 'totp') { %>
                                <i class="fas fa-mobile-alt" style="color: var(--blue);"></i> Use Authenticator App Code
                            <% } else if (m === 'passkey') { %>
                                <i class="fas fa-fingerprint" style="color: var(--gold);"></i> Use Passkey / Device PIN
                            <% } else if (m === 'social') { %>
                                <i class="fas fa-share-alt" style="color: #2ecc71;"></i> Verify with Social Account
                            <% } %>
                        </a>
                    <% }); %>
                </div>
            </div>
        <% } %>
        
        <!-- UNIVERSAL BACKUP CODE FALLBACK (Only for Social/Passkey, since TOTP/Email share the main input) -->
        <% if (method === 'social' || method === 'passkey') { %>
            <div class="divider">Device Lost?</div>
            <p style="font-size: 0.85em; color: var(--silver); margin-bottom: 10px;">Use one of your 8-character backup codes.</p>
            <form action="/login/2fa/verify" method="POST">
                <input type="text" name="token" placeholder="Backup Code" maxlength="8" required style="width: 100%; padding: 12px; background: var(--black); color: var(--gold); border: 1px solid #333; text-align: center; margin-bottom: 15px; border-radius: 8px; font-family: monospace; font-size: 1.2em; outline: none; letter-spacing: 2px;">
                <button type="submit" class="btn btn-secondary" style="width: 100%; padding: 10px; border: 2px solid #555; background: transparent; color: var(--silver); transition: all 0.3s ease;" onmouseover="this.style.borderColor='var(--white)'; this.style.color='var(--white)';" onmouseout="this.style.borderColor='#555'; this.style.color='var(--silver)';">Use Backup Code</button>
            </form>
        <% } %>

    </div>
</main>
<%- include('../partials/footer') %>