<%-include('../../partials/header') %>
<style>
    .owner-header { text-align: center; padding: 40px 20px 20px; }
    .owner-header h1 { font-size: 2.5em; color: var(--white); }
    .owner-header h1 span { color: #f44336; text-shadow: 0 0 4px rgba(244, 67, 54, 0.6); }
    .owner-header p { color: var(--silver); max-width: 650px; margin: 10px auto; font-size: 0.95em; }
    
    .owner-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; max-width: 1200px; margin: 0 auto 60px auto; padding: 0 20px; }
    
    .owner-card { background: #1a1a1a; border: 1px solid #333; border-radius: 12px; padding: 22px; transition: all 0.3s ease; display: flex; flex-direction: column; gap: 12px; position: relative; overflow: hidden; }
    .owner-card::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: #444; transition: 0.3s; }
    
    .owner-card.render::before { background: #6b4fbb; }
    .owner-card.cloudflare::before { background: #f38020; }
    .owner-card.dynu::before { background: #0070ba; }
    .owner-card.netlify::before { background: #00ad9f; }
    .owner-card.mongo::before { background: #47a248; }
    .owner-card.b2::before { background: #d9241b; }
    .owner-card.failback::before { background: #00bcd4; }
    .owner-card.dns::before { background: #9c27b0; }
    .owner-card.improvmx::before { background: #ff9800; }
    .owner-card.devtool::before { background: #e53935; }

    .owner-card:hover { border-color: #555; transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.5); }
    
    .card-title { display: flex; align-items: center; justify-content: space-between; margin: 0; color: var(--white); font-size: 1.25em; }
    .card-title-left { display: flex; align-items: center; gap: 10px; }
    .card-title i { font-size: 1.15em; }
    
    .owner-card.render .card-title i { color: #6b4fbb; }
    .owner-card.cloudflare .card-title i { color: #f38020; }
    .owner-card.dynu .card-title i { color: #0070ba; }
    .owner-card.netlify .card-title i { color: #00ad9f; }
    .owner-card.mongo .card-title i { color: #47a248; }
    .owner-card.b2 .card-title i { color: #d9241b; }
    .owner-card.failback .card-title i { color: #00bcd4; }
    .owner-card.dns .card-title i { color: #9c27b0; }
    .owner-card.improvmx .card-title i { color: #ff9800; }
    .owner-card.devtool .card-title i { color: #e53935; }
    
    .card-desc { color: #aaa; font-size: 0.88em; margin: 0; line-height: 1.4; flex-grow: 1; }
    
    /* Badges */
    .owner-badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 6px; font-size: 0.75em; font-weight: 600; background: #222; border: 1px solid #444; width: fit-content; }
    .owner-badge.active { color: #4caf50; border-color: #4caf50; background: rgba(76, 175, 80, 0.1); }
    .owner-badge.warning { color: #ff9800; border-color: #ff9800; background: rgba(255, 152, 0, 0.1); }
    .owner-badge.info { color: #00bcd4; border-color: #00bcd4; background: rgba(0, 188, 212, 0.1); }
    .owner-badge.error { color: #f44336; border-color: #f44336; background: rgba(244, 67, 54, 0.1); }

    .details-box { max-height: 140px; overflow-y: auto; background: #111; border: 1px solid #2a2a2a; border-radius: 6px; padding: 8px 10px; font-size: 0.8em; color: #bbb; display: none; line-height: 1.4; }
    .details-row { display: flex; justify-content: space-between; align-items: center; padding: 4px 0; border-bottom: 1px solid #1f1f1f; }
    .details-row:last-child { border-bottom: none; }

    .action-group { display: flex; flex-direction: column; gap: 8px; margin-top: auto; }
    .action-row { display: flex; gap: 8px; }
    
    .btn-action { flex: 1; padding: 9px 12px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; display: flex; justify-content: center; align-items: center; gap: 6px; font-size: 0.85em; transition: 0.2s; background: #262626; color: #eee; }
    .btn-action:hover { background: #333; }
    .btn-action.primary { background: var(--gold); color: #000; }
    .btn-action.primary:hover { background: #ffca28; }
    .btn-action.warning { background: #ff9800; color: #000; }
    .btn-action.warning:hover { background: #ffa726; }
    .btn-action.danger { background: #d32f2f; color: #fff; }
    .btn-action.danger:hover { background: #b71c1c; }
    .btn-action.info { background: #0088cc; color: #fff; }
    .btn-action.info:hover { background: #0099e6; }
    
    .status-feedback { font-size: 0.82em; text-align: center; margin-top: 4px; min-height: 16px; color: var(--green); display: none; word-break: break-word; }
    .btn-link { text-decoration: none; text-align: center; }

    /* Modal styles */
    .owner-modal-overlay { 
        display: none; 
        position: fixed; 
        inset: 0; 
        background: rgba(0,0,0,0.85); 
        z-index: 100050; 
        justify-content: center; 
        align-items: center; 
        backdrop-filter: blur(8px); 
        opacity: 0;
        transition: opacity 0.25s ease;
    }
    .owner-modal-overlay.show {
        display: flex;
        opacity: 1;
    }
    .owner-modal-card { 
        background: #18181c; 
        border: 1px solid #383842; 
        border-radius: 14px; 
        width: 90%; 
        max-width: 480px; 
        padding: 26px; 
        box-shadow: 0 15px 40px rgba(0,0,0,0.85); 
        transform: scale(0.95);
        transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .owner-modal-overlay.show .owner-modal-card {
        transform: scale(1);
    }
    .owner-modal-card h3 { margin: 0 0 15px 0; color: var(--gold); display: flex; justify-content: space-between; align-items: center; }
    .owner-modal-card .close-btn { cursor: pointer; color: #888; border: none; background: none; font-size: 1.2em; transition: color 0.2s; }
    .owner-modal-card .close-btn:hover { color: #fff; }
    .owner-modal-input { width: 100%; padding: 10px 14px; background: #111; border: 1px solid #444; border-radius: 6px; color: #fff; margin-bottom: 12px; font-family: inherit; box-sizing: border-box; }
    
    .owner-modal-card.danger-modal {
        border-color: rgba(244, 67, 54, 0.45);
        box-shadow: 0 0 30px rgba(244, 67, 54, 0.22), 0 15px 40px rgba(0,0,0,0.85);
    }
    .owner-modal-card.success-modal {
        border-color: rgba(76, 175, 80, 0.45);
        box-shadow: 0 0 30px rgba(76, 175, 80, 0.22), 0 15px 40px rgba(0,0,0,0.85);
    }
    .modal-icon-badge {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75em;
        margin: 0 auto 16px auto;
    }
    .modal-icon-badge.danger {
        background: rgba(244, 67, 54, 0.15);
        color: #f44336;
        border: 1px solid rgba(244, 67, 54, 0.35);
        box-shadow: 0 0 15px rgba(244, 67, 54, 0.25);
    }
    .modal-icon-badge.success {
        background: rgba(76, 175, 80, 0.15);
        color: #4caf50;
        border: 1px solid rgba(76, 175, 80, 0.35);
        box-shadow: 0 0 15px rgba(76, 175, 80, 0.25);
    }
    .modal-head-title {
        font-size: 1.3em;
        font-weight: 700;
        color: #fff;
        text-align: center;
        margin: 0 0 8px 0;
    }
    .modal-body-desc {
        font-size: 0.9em;
        color: #bbb;
        text-align: center;
        line-height: 1.5;
        margin-bottom: 18px;
    }
    .modal-details-box {
        background: #111116;
        border: 1px solid #2a2a35;
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 0.85em;
        color: #ccc;
        margin-bottom: 20px;
        word-break: break-all;
        line-height: 1.5;
    }
</style>

<div class="owner-header">
    <h1>Owner <span>Command Center</span></h1>
    <p>Unified infrastructure control panel. Manage Cloudflare Workers, Backblaze B2, MongoDB Atlas, Dynu DNS, Netlify, InfinityFree FTP, and Anti-Revoke iOS archives from one dashboard.</p>
</div>

<div class="owner-grid">
    <!-- 1. Render -->
    <div class="owner-card render">
        <div class="card-title">
            <div class="card-title-left"><i class="fas fa-server"></i> <span>Render Deployment</span></div>
        </div>
        <p class="card-desc">Control the primary Node.js application hosted on Render. Trigger manual zero-downtime deployment pipelines.</p>
        <div class="action-group">
            <button class="btn-action primary" onclick="handleAction(this, '/api/owner/render/deploy')">
                <i class="fas fa-rocket"></i> Trigger Deployment
            </button>
            <a href="https://dashboard.render.com" target="_blank" class="btn-action btn-link">
                <i class="fas fa-external-link-alt"></i> Render Console
            </a>
            <div class="status-feedback"></div>
        </div>
    </div>

    <!-- 2. Cloudflare CDN & Workers -->
    <div class="owner-card cloudflare">
        <div class="card-title">
            <div class="card-title-left"><i class="fas fa-cloud"></i> <span>Cloudflare CDN & Workers</span></div>
            <div id="cfStatusBadge" class="owner-badge"><i class="fas fa-circle-notch fa-spin"></i> Checking...</div>
        </div>
        <p class="card-desc">Edge CDN cache management and Cloudflare Workers (<code>ios-api-cach</code> CDN & DNS archive gateway).</p>
        <div id="cfDetailsBox" class="details-box"></div>
        <div class="action-group">
            <div class="action-row">
                <button class="btn-action danger" onclick="handleAction(this, '/api/owner/cloudflare/purge')">
                    <i class="fas fa-eraser"></i> Purge Cache
                </button>
                <button class="btn-action" onclick="handleAction(this, '/api/owner/cloudflare/reload')">
                    <i class="fas fa-sync"></i> Reload Workers
                </button>
            </div>
            <div class="action-row">
                <button class="btn-action" onclick="checkCloudflareStatus(this)">
                    <i class="fas fa-check-circle"></i> Verify Token
                </button>
                <a href="https://dash.cloudflare.com" target="_blank" class="btn-action btn-link">
                    <i class="fas fa-external-link-alt"></i> Cloudflare Dash
                </a>
            </div>
            <div class="status-feedback"></div>
        </div>
    </div>

    <!-- 3. Dynu Domain Management -->
    <div class="owner-card dynu">
        <div class="card-title">
            <div class="card-title-left"><i class="fas fa-network-wired"></i> <span>Dynu Domains & DNS</span></div>
            <div id="dynuStatusBadge" class="owner-badge"><i class="fas fa-circle-notch fa-spin"></i> Checking...</div>
        </div>
        <p class="card-desc">Live domain resolution and DDNS bindings via Dynu v2 REST API (gplmods.webredirect.org & tunnels).</p>
        <div id="dynuDetailsBox" class="details-box"></div>
        <div class="action-group">
            <div class="action-row">
                <button class="btn-action primary" onclick="handleAction(this, '/api/owner/dynu/sync')">
                    <i class="fas fa-sync-alt"></i> Sync DNS Records
                </button>
                <button class="btn-action" onclick="checkDynuStatus(this)">
                    <i class="fas fa-redo"></i> Refresh
                </button>
            </div>
            <a href="https://www.dynu.com/ControlPanel" target="_blank" class="btn-action btn-link">
                <i class="fas fa-external-link-alt"></i> Dynu Control Panel
            </a>
            <div class="status-feedback"></div>
        </div>
    </div>

    <!-- 4. Netlify Welcome Screen -->
    <div class="owner-card netlify">
        <div class="card-title">
            <div class="card-title-left"><i class="fas fa-desktop"></i> <span>Netlify Welcome Screen</span></div>
            <div id="netlifyStatusBadge" class="owner-badge"><i class="fas fa-circle-notch fa-spin"></i> Checking...</div>
        </div>
        <p class="card-desc">Static web hosting for the Welcome Screen and onboarding app (<code>gplmods.netlify.app</code>).</p>
        <div id="netlifyDetailsBox" class="details-box"></div>
        <div class="action-group">
            <div class="action-row">
                <button class="btn-action primary" onclick="handleAction(this, '/api/owner/netlify/deploy')">
                    <i class="fas fa-upload"></i> Redeploy
                </button>
                <button class="btn-action" onclick="checkNetlifyStatus(this)">
                    <i class="fas fa-sync-alt"></i> Status
                </button>
            </div>
            <a href="https://app.netlify.com" target="_blank" class="btn-action btn-link">
                <i class="fas fa-external-link-alt"></i> Netlify Admin
            </a>
            <div class="status-feedback"></div>
        </div>
    </div>

    <!-- 5. MongoDB Atlas -->
    <div class="owner-card mongo">
        <div class="card-title">
            <div class="card-title-left"><i class="fas fa-database"></i> <span>MongoDB Atlas Admin</span></div>
            <div id="mongoStatusBadge" class="owner-badge"><i class="fas fa-circle-notch fa-spin"></i> Checking...</div>
        </div>
        <p class="card-desc">Atlas Admin API v2 (Digest Auth). Monitors cluster health, active connections, and organization status.</p>
        <div id="mongoDetailsBox" class="details-box"></div>
        <div class="action-group">
            <div class="action-row">
                <button class="btn-action primary" onclick="checkMongoAtlasStatus(this)">
                    <i class="fas fa-heartbeat"></i> Ping Atlas API
                </button>
                <a href="https://cloud.mongodb.com" target="_blank" class="btn-action btn-link">
                    <i class="fas fa-external-link-alt"></i> Atlas Console
                </a>
            </div>
            <div class="status-feedback"></div>
        </div>
    </div>

    <!-- 6. Backblaze B2 Master -->
    <div class="owner-card b2">
        <div class="card-title">
            <div class="card-title-left"><i class="fas fa-box-open"></i> <span>Backblaze B2 Master</span></div>
            <div id="b2StatusBadge" class="owner-badge"><i class="fas fa-circle-notch fa-spin"></i> Checking...</div>
        </div>
        <p class="card-desc">Master Application Key authentication for object storage (<code>gpl-cloud</code> bucket, presigned downloads).</p>
        <div id="b2DetailsBox" class="details-box"></div>
        <div class="action-group">
            <div class="action-row">
                <button class="btn-action primary" onclick="handleAction(this, '/api/owner/b2/test')">
                    <i class="fas fa-key"></i> Test Master Auth
                </button>
                <button class="btn-action" onclick="checkB2Status(this)">
                    <i class="fas fa-sync-alt"></i> Bucket Info
                </button>
            </div>
            <a href="https://secure.backblaze.com/b2_buckets.htm" target="_blank" class="btn-action btn-link">
                <i class="fas fa-external-link-alt"></i> B2 Console
            </a>
            <div class="status-feedback"></div>
        </div>
    </div>

    <!-- 7. Failback.JS CDN (InfinityFree FTP) -->
    <div class="owner-card failback">
        <div class="card-title">
            <div class="card-title-left"><i class="fas fa-shield-alt"></i> <span>Failback.JS CDN</span></div>
            <span class="owner-badge warning" title="InfinityFree hosting supports FTP only (No REST API)">FTP Only</span>
        </div>
        <p class="card-desc">Secondary CDN hosted on InfinityFree. Uses direct FTP socket synchronization (REST API unsupported).</p>
        <div id="failbackDetailsBox" class="details-box"></div>
        <div class="action-group">
            <div class="action-row">
                <button class="btn-action primary" onclick="checkFailbackFtpStatus(this)">
                    <i class="fas fa-plug"></i> Test FTP
                </button>
                <button class="btn-action" onclick="handleAction(this, '/api/owner/failback/sync')">
                    <i class="fas fa-sync-alt"></i> FTP Sync
                </button>
            </div>
            <button class="btn-action danger" onclick="handleAction(this, '/api/owner/failback/restart')">
                <i class="fas fa-power-off"></i> Restart Service
            </button>
            <div class="status-feedback"></div>
        </div>
    </div>

    <!-- 8. GPL Mods Anti-Revoke DNS & iOS Cert Archive -->
    <div class="owner-card dns">
        <div class="card-title">
            <div class="card-title-left"><i class="fas fa-globe"></i> <span>Anti-Revoke DNS & iOS Certs</span></div>
            <div id="dnsStatusBadge" class="owner-badge"><i class="fas fa-circle-notch fa-spin"></i> Checking...</div>
        </div>
        <p class="card-desc">Custom DNS routing and iOS Certificate Archive hosted on GitHub Pages (<code>GPL-Mods-DNS</code>).</p>
        <div id="dnsDetailsBox" class="details-box"></div>
        <div class="action-group">
            <div class="action-row">
                <button class="btn-action primary" onclick="handleAction(this, '/api/owner/dns/sync')">
                    <i class="fas fa-sync-alt"></i> Sync Certs & DNS
                </button>
                <button class="btn-action danger" onclick="handleAction(this, '/api/owner/dns/restart')">
                    <i class="fas fa-power-off"></i> Restart Routing
                </button>
            </div>
            <a href="https://github.com/GPLMods/GPL-Mods-DNS" target="_blank" class="btn-action btn-link">
                <i class="fab fa-github"></i> View Repo
            </a>
            <div class="status-feedback"></div>
        </div>
    </div>

    <!-- 9. ImprovMX Custom Email -->
    <div class="owner-card improvmx">
        <div class="card-title">
            <div class="card-title-left"><i class="fas fa-envelope-open-text"></i> <span>ImprovMX Custom Email</span></div>
            <div id="improvmxStatusBadge" class="owner-badge"><i class="fas fa-circle-notch fa-spin"></i> Checking...</div>
        </div>
        <p class="card-desc">Manage custom domain email forwarding and SMTP credentials on <b><%= improvmxDomain || 'gplmods.webredirect.org' %></b>.</p>
        <div id="improvmxAliasesList" class="details-box"></div>
        <div class="action-group">
            <div class="action-row">
                <button class="btn-action warning" onclick="openClaimEmailModal()">
                    <i class="fas fa-at"></i> Claim Email
                </button>
                <button class="btn-action" onclick="generateOwnerSmtp(this)">
                    <i class="fas fa-key"></i> Gen SMTP
                </button>
            </div>
            <div class="action-row">
                <button class="btn-action" onclick="checkImprovmxStatus(this)">
                    <i class="fas fa-sync-alt"></i> Check MX
                </button>
                <a href="https://app.improvmx.com" target="_blank" class="btn-action btn-link">
                    <i class="fas fa-external-link-alt"></i> Console
                </a>
            </div>
            <div class="status-feedback"></div>
        </div>
    </div>

    <!-- 10. Core Server Controls -->
    <div class="owner-card" style="border-color: #d32f2f;">
        <div class="card-title">
            <div class="card-title-left" style="color: #ef5350;"><i class="fas fa-power-off"></i> <span>Core Server</span></div>
        </div>
        <p class="card-desc">Danger Zone: Node.js process operations, connection recycling, and database purge.</p>
        <div class="action-group">
            <div class="action-row">
                <button class="btn-action primary" onclick="handleAction(this, '/api/owner/core/restart')">
                    <i class="fas fa-redo"></i> Quick Restart
                </button>
                <button class="btn-action danger" onclick="handleAction(this, '/api/owner/core/shutdown')">
                    <i class="fas fa-stop"></i> Shutdown
                </button>
            </div>
            <button class="btn-action" style="background: #e65100;" onclick="handleAction(this, '/api/owner/core/disconnect-db')">
                <i class="fas fa-unlink"></i> Disconnect DB
            </button>
            <button class="btn-action danger" style="background: #b71c1c; margin-top: 6px;" onclick="handleDataTermination(this)">
                <i class="fas fa-skull-crossbones"></i> TERMINATE DATA
            </button>
            <div class="status-feedback"></div>
        </div>
    </div>

    <!-- 10. DevTools & Debugger Protection -->
    <div class="owner-card devtool">
        <div class="card-title">
            <div class="card-title-left"><i class="fas fa-shield-alt"></i> <span>DevTools & Debugger Protection</span></div>
            <div class="owner-badge active"><i class="fas fa-lock"></i> Protected</div>
        </div>
        <p class="card-desc">Console inspection defense & tamper protection. Generates single-use 10–12 digit access keys rotated hourly.</p>
        
        <div style="background: #111; border: 1px solid #2a2a2a; border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 10px;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                    <span style="font-size: 0.75em; color: #888; text-transform: uppercase; font-weight: 600;">Hourly Single-Use Key</span>
                    <span style="font-size: 0.7em; color: var(--gold); background: rgba(255,215,0,0.1); border: 1px solid rgba(255,215,0,0.3); padding: 1px 6px; border-radius: 10px;">Auto-Rotates</span>
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                    <div id="ownerDebuggerKey" style="font-family: monospace; font-size: 1.3em; font-weight: 700; color: var(--gold); letter-spacing: 2px;">
                        <%= typeof debuggerKey !== 'undefined' ? debuggerKey : 'N/A' %>
                    </div>
                    <button type="button" class="btn-action" onclick="copyOwnerKey('ownerDebuggerKey', this)" style="padding: 4px 10px; font-size: 0.8em; flex: none;">
                        <i class="fas fa-copy"></i> Copy
                    </button>
                </div>
            </div>

            <div style="border-top: 1px solid #222; padding-top: 8px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                    <span style="font-size: 0.75em; color: #888; text-transform: uppercase; font-weight: 600;">Permanent Master Key</span>
                    <span style="font-size: 0.7em; color: #ff5252; background: rgba(244,67,54,0.1); border: 1px solid rgba(244,67,54,0.3); padding: 1px 6px; border-radius: 10px;">Permanent</span>
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                    <div id="ownerMasterKey" style="font-family: monospace; font-size: 1.1em; font-weight: 700; color: #ff5252;">
                        <%= typeof debuggerMasterKey !== 'undefined' ? debuggerMasterKey : 'OPAdmin@2026' %>
                    </div>
                    <button type="button" class="btn-action" onclick="copyOwnerKey('ownerMasterKey', this)" style="padding: 4px 10px; font-size: 0.8em; flex: none;">
                        <i class="fas fa-copy"></i> Copy
                    </button>
                </div>
            </div>
        </div>

        <div class="action-group">
            <button type="button" class="btn-action primary" onclick="generateOwnerDebuggerKey(this)">
                <i class="fas fa-sync-alt"></i> Rotate Hourly Key Now
            </button>
            <a href="/status" class="btn-action btn-link">
                <i class="fas fa-history"></i> Audit Logs (<%= typeof recentDevtoolLogs !== 'undefined' && recentDevtoolLogs ? recentDevtoolLogs.length : 0 %>)
            </a>
            <div class="status-feedback"></div>
        </div>
    </div>
</div>

<!-- Modal: Claim Custom Email -->
<div id="claimEmailModal" class="owner-modal-overlay">
    <div class="owner-modal-card">
        <h3>
            <span><i class="fas fa-at"></i> Claim Custom Work Email</span>
            <button type="button" class="close-btn" onclick="closeClaimEmailModal()">&times;</button>
        </h3>
        <p style="color: #bbb; font-size: 0.88em; margin-bottom: 15px;">
            Create an email alias on <b><%= improvmxDomain || 'gplmods.webredirect.org' %></b> that forwards to any address.
        </p>
        <form id="claimEmailForm" onsubmit="submitClaimEmail(event)">
            <label style="font-size: 0.8em; color: #aaa;">Alias Username (e.g. support, admin, owner):</label>
            <input type="text" id="emailAliasInput" class="owner-modal-input" placeholder="e.g. owner" required>

            <label style="font-size: 0.8em; color: #aaa;">Forward To (Destination Inbox):</label>
            <input type="email" id="emailForwardInput" class="owner-modal-input" value="<%= (user && user.email) || '' %>" placeholder="personal@gmail.com" required>

            <div style="display: flex; gap: 10px; margin-top: 15px;">
                <button type="button" class="btn-action" onclick="closeClaimEmailModal()">Cancel</button>
                <button type="submit" class="btn-action warning" id="submitClaimBtn">
                    <i class="fas fa-check"></i> Create Email
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Delete / Danger Confirmation -->
<div id="ownerDeleteModal" class="owner-modal-overlay">
    <div class="owner-modal-card danger-modal">
        <div class="modal-icon-badge danger"><i class="fas fa-trash-alt"></i></div>
        <h3 class="modal-head-title" id="ownerDeleteTitle">Confirm Deletion</h3>
        <p class="modal-body-desc" id="ownerDeleteMessage">Are you sure you want to delete this resource? This action cannot be undone.</p>
        <div id="ownerDeleteDetails" class="modal-details-box" style="display: none;"></div>
        <div style="display: flex; gap: 10px; margin-top: 15px;">
            <button type="button" class="btn-action" style="flex: 1;" onclick="closeOwnerDeleteModal()">Cancel</button>
            <button type="button" class="btn-action danger" style="flex: 1;" id="ownerDeleteConfirmBtn">
                <i class="fas fa-trash"></i> Delete
            </button>
        </div>
    </div>
</div>

<!-- Modal: Success Popup -->
<div id="ownerSuccessModal" class="owner-modal-overlay">
    <div class="owner-modal-card success-modal">
        <div class="modal-icon-badge success"><i class="fas fa-check-circle"></i></div>
        <h3 class="modal-head-title" id="ownerSuccessTitle">Action Completed</h3>
        <p class="modal-body-desc" id="ownerSuccessMessage">The operation finished successfully.</p>
        <div id="ownerSuccessDetails" class="modal-details-box" style="display: none;"></div>
        <div style="display: flex; justify-content: center; gap: 10px; margin-top: 15px;">
            <button type="button" class="btn-action primary" style="min-width: 140px;" onclick="closeOwnerSuccessModal()">
                <i class="fas fa-check"></i> Done
            </button>
        </div>
    </div>
</div>

<script>
    // ==========================================
    // 1. CLOUDFLARE STATUS
    // ==========================================
    async function checkCloudflareStatus(btnElement) {
        const badge = document.getElementById('cfStatusBadge');
        const box = document.getElementById('cfDetailsBox');
        badge.className = 'owner-badge';
        badge.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Checking...';

        try {
            const res = await fetch('/api/owner/cloudflare/status');
            const data = await res.json();
            if (data.success && data.status === 'active') {
                badge.className = 'owner-badge active';
                badge.innerHTML = '<i class="fas fa-check-circle"></i> Active Token';
                box.style.display = 'block';
                box.innerHTML = `
                    <div class="details-row"><span>Token ID:</span><span style="color:var(--gold);">${data.tokenId}</span></div>
                    <div class="details-row"><span>Worker Gateway:</span><span style="color:#00bcd4;">ios-api-cach</span></div>
                `;
            } else {
                badge.className = 'owner-badge error';
                badge.innerHTML = '<i class="fas fa-times-circle"></i> Error';
            }
        } catch (e) {
            badge.className = 'owner-badge error';
            badge.innerHTML = '<i class="fas fa-times-circle"></i> Offline';
        }
    }

    // ==========================================
    // 2. DYNU DOMAINS STATUS
    // ==========================================
    async function checkDynuStatus(btnElement) {
        const badge = document.getElementById('dynuStatusBadge');
        const box = document.getElementById('dynuDetailsBox');
        badge.className = 'owner-badge';
        badge.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Querying...';

        try {
            const res = await fetch('/api/owner/dynu/status');
            const data = await res.json();
            if (data.success && data.domains && data.domains.length > 0) {
                badge.className = 'owner-badge active';
                badge.innerHTML = `<i class="fas fa-check-circle"></i> ${data.domains.length} Domains Active`;
                box.style.display = 'block';
                box.innerHTML = data.domains.map(d => `
                    <div class="details-row">
                        <span><b>${d.name}</b></span>
                        <span style="color:var(--gold);">${d.ipv4Address || 'Dynamic'}</span>
                    </div>
                `).join('');
            } else {
                badge.className = 'owner-badge warning';
                badge.innerHTML = '<i class="fas fa-exclamation-triangle"></i> No Domains';
            }
        } catch (e) {
            badge.className = 'owner-badge error';
            badge.innerHTML = '<i class="fas fa-times-circle"></i> Dynu Error';
        }
    }

    // ==========================================
    // 3. NETLIFY STATUS
    // ==========================================
    async function checkNetlifyStatus(btnElement) {
        const badge = document.getElementById('netlifyStatusBadge');
        const box = document.getElementById('netlifyDetailsBox');
        badge.className = 'owner-badge';
        badge.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Checking...';

        try {
            const res = await fetch('/api/owner/netlify/status');
            const data = await res.json();
            if (data.success) {
                badge.className = 'owner-badge active';
                badge.innerHTML = `<i class="fas fa-check-circle"></i> Connected`;
                box.style.display = 'block';
                const site = data.sites && data.sites[0];
                if (site) {
                    box.innerHTML = `
                        <div class="details-row"><span>Site:</span><b style="color:var(--gold);">${site.name}</b></div>
                        <div class="details-row"><span>State:</span><span style="color:#4caf50;">${site.state || 'ready'}</span></div>
                        <div class="details-row"><span>Branch:</span><span>${site.branch || 'main'}</span></div>
                    `;
                } else {
                    box.innerHTML = `<div class="details-row"><span>Account:</span><span>${data.account.fullName}</span></div>`;
                }
            } else {
                badge.className = 'owner-badge error';
                badge.innerHTML = '<i class="fas fa-times-circle"></i> Netlify Error';
            }
        } catch (e) {
            badge.className = 'owner-badge error';
            badge.innerHTML = '<i class="fas fa-times-circle"></i> Offline';
        }
    }

    // ==========================================
    // 4. MONGODB ATLAS STATUS
    // ==========================================
    async function checkMongoAtlasStatus(btnElement) {
        const badge = document.getElementById('mongoStatusBadge');
        const box = document.getElementById('mongoDetailsBox');
        badge.className = 'owner-badge';
        badge.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Querying...';

        try {
            const res = await fetch('/api/owner/mongo-atlas/status');
            const data = await res.json();
            if (data.success) {
                badge.className = 'owner-badge active';
                badge.innerHTML = '<i class="fas fa-check-circle"></i> Cluster Online';
                box.style.display = 'block';
                box.innerHTML = `
                    <div class="details-row"><span>Cluster:</span><b style="color:var(--gold);">${data.clusterName || 'GPLMods DB'}</b></div>
                    <div class="details-row"><span>Pool Status:</span><span style="color:#4caf50;">Connected</span></div>
                    ${data.clusterCount ? `<div class="details-row"><span>Clusters:</span><span>${data.clusterCount} active</span></div>` : ''}
                `;
            } else {
                badge.className = 'owner-badge warning';
                badge.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Degraded';
            }
        } catch (e) {
            badge.className = 'owner-badge error';
            badge.innerHTML = '<i class="fas fa-times-circle"></i> Atlas Error';
        }
    }

    // ==========================================
    // 5. BACKBLAZE B2 STATUS
    // ==========================================
    async function checkB2Status(btnElement) {
        const badge = document.getElementById('b2StatusBadge');
        const box = document.getElementById('b2DetailsBox');
        badge.className = 'owner-badge';
        badge.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Verifying...';

        try {
            const res = await fetch('/api/owner/b2/status');
            const data = await res.json();
            if (data.success) {
                badge.className = 'owner-badge active';
                badge.innerHTML = '<i class="fas fa-check-circle"></i> Master Key Valid';
                box.style.display = 'block';
                box.innerHTML = `
                    <div class="details-row"><span>Bucket:</span><b style="color:var(--gold);">${data.bucketName}</b></div>
                    <div class="details-row"><span>Account ID:</span><span>${data.accountId}</span></div>
                    <div class="details-row"><span>API Node:</span><span style="font-size:0.85em;">${data.apiUrl}</span></div>
                `;
            } else {
                badge.className = 'owner-badge error';
                badge.innerHTML = '<i class="fas fa-times-circle"></i> Auth Failed';
            }
        } catch (e) {
            badge.className = 'owner-badge error';
            badge.innerHTML = '<i class="fas fa-times-circle"></i> B2 Offline';
        }
    }

    // ==========================================
    // 6. FAILBACK.JS FTP STATUS
    // ==========================================
    async function checkFailbackFtpStatus(btnElement) {
        const box = document.getElementById('failbackDetailsBox');
        if (btnElement) {
            btnElement.disabled = true;
            btnElement.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Connecting...';
        }
        box.style.display = 'block';
        box.innerHTML = '<div style="color:#aaa;"><i class="fas fa-circle-notch fa-spin"></i> Testing FTP socket on ftpupload.net...</div>';

        try {
            const res = await fetch('/api/owner/failback/status');
            const data = await res.json();
            if (data.success) {
                box.innerHTML = `
                    <div class="details-row"><span>FTP Host:</span><span style="color:var(--gold);">${data.host}</span></div>
                    <div class="details-row"><span>Latency:</span><span style="color:#4caf50;">${data.latencyMs || 250} ms</span></div>
                    <div class="details-row"><span>Path:</span><span>${data.basePath} (${data.fileCount || 0} items)</span></div>
                    <div style="font-size:0.75em; color:#888; margin-top:4px;">${data.note}</div>
                `;
            } else {
                box.innerHTML = `<div style="color:var(--red);"><i class="fas fa-times-circle"></i> ${data.message}</div>`;
            }
        } catch (e) {
            box.innerHTML = '<div style="color:var(--red);"><i class="fas fa-times-circle"></i> Failed to connect via FTP.</div>';
        } finally {
            if (btnElement) {
                btnElement.disabled = false;
                btnElement.innerHTML = '<i class="fas fa-plug"></i> Test FTP';
            }
        }
    }

    // ==========================================
    // 7. ANTI-REVOKE DNS & IOS CERTS
    // ==========================================
    async function checkDnsArchiveStatus(btnElement) {
        const badge = document.getElementById('dnsStatusBadge');
        const box = document.getElementById('dnsDetailsBox');
        badge.className = 'owner-badge';
        badge.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Checking...';

        try {
            const res = await fetch('/api/owner/dns/archive-status');
            const data = await res.json();
            if (data.success) {
                badge.className = 'owner-badge active';
                badge.innerHTML = '<i class="fas fa-check-circle"></i> Active';
                box.style.display = 'block';
                box.innerHTML = `
                    <div class="details-row"><span>CNAME:</span><b style="color:var(--gold);">${data.cname}</b></div>
                    <div class="details-row"><span>Source:</span><span>${data.repo}</span></div>
                    <div class="details-row"><span>Worker:</span><span style="color:#00bcd4;">ios-api-cach</span></div>
                `;
            } else {
                badge.className = 'owner-badge error';
                badge.innerHTML = '<i class="fas fa-times-circle"></i> Error';
            }
        } catch (e) {
            badge.className = 'owner-badge error';
            badge.innerHTML = '<i class="fas fa-times-circle"></i> Offline';
        }
    }

    // ==========================================
    // 8. IMPROVMX STATUS
    // ==========================================
    async function checkImprovmxStatus(btnElement) {
        const badge = document.getElementById('improvmxStatusBadge');
        const list = document.getElementById('improvmxAliasesList');
        badge.className = 'owner-badge';
        badge.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Checking...';

        try {
            const res = await fetch('/api/owner/improvmx/status');
            const data = await res.json();

            if (data.success) {
                if (data.validMx) {
                    badge.className = 'owner-badge active';
                    badge.innerHTML = `<i class="fas fa-check-circle"></i> MX Active`;
                } else {
                    badge.className = 'owner-badge warning';
                    badge.innerHTML = `<i class="fas fa-exclamation-triangle"></i> Pending MX`;
                }
            } else {
                badge.className = 'owner-badge error';
                badge.innerHTML = `<i class="fas fa-times-circle"></i> MX Error`;
            }

            await loadImprovmxAliases();
        } catch (err) {
            badge.className = 'owner-badge error';
            badge.innerHTML = `<i class="fas fa-times-circle"></i> Error`;
        }
    }

    async function loadImprovmxAliases() {
        const list = document.getElementById('improvmxAliasesList');
        try {
            const res = await fetch('/api/owner/improvmx/aliases');
            const data = await res.json();

            if (data.success && data.aliases && data.aliases.length > 0) {
                list.style.display = 'block';
                list.innerHTML = `<b style="color:var(--gold); font-size:0.85em;">Active Aliases (${data.aliases.length}):</b>` + 
                    data.aliases.map(a => `
                        <div class="details-row">
                            <span><b>${a.alias}</b>@${data.domain} &rarr; <span style="color:#aaa;">${a.forward}</span></span>
                            <button style="background:none; border:none; color:#f44336; cursor:pointer;" title="Delete Alias" onclick="deleteAlias('${a.id}', '${a.alias}')"><i class="fas fa-trash"></i></button>
                        </div>
                    `).join('');
            } else if (data.success) {
                list.style.display = 'block';
                list.innerHTML = '<span style="color:#888;">No aliases registered yet. Click "Claim Email" to add one.</span>';
            }
        } catch (e) {
            console.error(e);
        }
    }

    // ==========================================
    // OWNER MODAL HELPERS (DELETE & SUCCESS)
    // ==========================================
    let pendingOwnerDeleteAction = null;

    function showOwnerDeleteModal({ title, message, details, confirmText = 'Delete', onConfirm }) {
        document.getElementById('ownerDeleteTitle').textContent = title || 'Confirm Deletion';
        document.getElementById('ownerDeleteMessage').textContent = message || 'Are you sure you want to proceed?';
        const detailsEl = document.getElementById('ownerDeleteDetails');
        if (details) {
            detailsEl.innerHTML = details;
            detailsEl.style.display = 'block';
        } else {
            detailsEl.style.display = 'none';
        }
        const confirmBtn = document.getElementById('ownerDeleteConfirmBtn');
        confirmBtn.innerHTML = `<i class="fas fa-trash"></i> ${confirmText}`;
        confirmBtn.disabled = false;
        
        pendingOwnerDeleteAction = onConfirm;
        const modal = document.getElementById('ownerDeleteModal');
        modal.style.display = 'flex';
        setTimeout(() => modal.classList.add('show'), 10);
    }

    function closeOwnerDeleteModal() {
        const modal = document.getElementById('ownerDeleteModal');
        if (!modal) return;
        modal.classList.remove('show');
        setTimeout(() => { modal.style.display = 'none'; }, 200);
        pendingOwnerDeleteAction = null;
    }

    document.getElementById('ownerDeleteConfirmBtn')?.addEventListener('click', async () => {
        if (typeof pendingOwnerDeleteAction === 'function') {
            const btn = document.getElementById('ownerDeleteConfirmBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Deleting...';
            try {
                await pendingOwnerDeleteAction();
            } finally {
                closeOwnerDeleteModal();
            }
        }
    });

    function showOwnerSuccessModal({ title, message, details }) {
        document.getElementById('ownerSuccessTitle').textContent = title || 'Success';
        document.getElementById('ownerSuccessMessage').textContent = message || 'Operation completed successfully.';
        const detailsEl = document.getElementById('ownerSuccessDetails');
        if (details) {
            detailsEl.innerHTML = details;
            detailsEl.style.display = 'block';
        } else {
            detailsEl.style.display = 'none';
        }
        const modal = document.getElementById('ownerSuccessModal');
        modal.style.display = 'flex';
        setTimeout(() => modal.classList.add('show'), 10);
    }

    function closeOwnerSuccessModal() {
        const modal = document.getElementById('ownerSuccessModal');
        if (!modal) return;
        modal.classList.remove('show');
        setTimeout(() => { modal.style.display = 'none'; }, 200);
    }

    // Close modals on escape key or backdrop click
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeOwnerDeleteModal();
            closeOwnerSuccessModal();
            closeClaimEmailModal();
        }
    });

    ['ownerDeleteModal', 'ownerSuccessModal', 'claimEmailModal'].forEach(id => {
        const m = document.getElementById(id);
        if (m) {
            m.addEventListener('click', (e) => {
                if (e.target === m) {
                    if (id === 'ownerDeleteModal') closeOwnerDeleteModal();
                    else if (id === 'ownerSuccessModal') closeOwnerSuccessModal();
                    else if (id === 'claimEmailModal') closeClaimEmailModal();
                }
            });
        }
    });

    function deleteAlias(aliasId, aliasName) {
        showOwnerDeleteModal({
            title: 'Delete Email Alias',
            message: `Are you sure you want to permanently delete alias "${aliasName}"?`,
            details: `<b>Target Alias:</b> ${aliasName}@<%= improvmxDomain || 'gplmods.webredirect.org' %><br><span style="color:#f44336; font-size:0.9em;">Incoming emails sent to this address will stop forwarding immediately.</span>`,
            confirmText: 'Delete Alias',
            onConfirm: async () => {
                try {
                    const res = await fetch(`/api/owner/improvmx/alias/${aliasId}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) {
                        showOwnerSuccessModal({
                            title: 'Email Alias Deleted',
                            message: data.message || `Custom email alias "${aliasName}" was removed successfully.`
                        });
                        await loadImprovmxAliases();
                    } else {
                        alert('Failed to delete alias: ' + (data.message || 'Unknown error'));
                    }
                } catch (e) {
                    alert('Failed to delete alias: ' + e.message);
                }
            }
        });
    }

    function openClaimEmailModal() {
        const modal = document.getElementById('claimEmailModal');
        modal.style.display = 'flex';
        setTimeout(() => modal.classList.add('show'), 10);
    }

    function closeClaimEmailModal() {
        const modal = document.getElementById('claimEmailModal');
        modal.classList.remove('show');
        setTimeout(() => { modal.style.display = 'none'; }, 200);
    }

    async function submitClaimEmail(e) {
        e.preventDefault();
        const alias = document.getElementById('emailAliasInput').value.trim();
        const forwardEmail = document.getElementById('emailForwardInput').value.trim();
        const submitBtn = document.getElementById('submitClaimBtn');

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating...';

        try {
            const res = await fetch('/api/owner/improvmx/claim', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ alias, forwardEmail, assignToSelf: true })
            });
            const data = await res.json();

            if (data.success) {
                closeClaimEmailModal();
                showOwnerSuccessModal({
                    title: 'Email Alias Claimed',
                    message: data.message || 'Custom email alias created and routing configured.',
                    details: `<b>Active Address:</b> ${alias}@<%= improvmxDomain || 'gplmods.webredirect.org' %><br><b>Forwarding To:</b> ${forwardEmail}`
                });
                checkImprovmxStatus();
            } else {
                alert('✖ ' + (data.message || 'Failed to create alias'));
            }
        } catch (err) {
            alert('✖ Network error: ' + err.message);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-check"></i> Create Email';
        }
    }

    async function generateOwnerSmtp(btnElement) {
        const username = prompt("Enter the alias username to generate SMTP credentials for:", "<%= (user && user.customEmailAlias) || 'owner' %>");
        if (!username) return;

        const originalText = btnElement.innerHTML;
        btnElement.disabled = true;
        btnElement.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';

        try {
            const res = await fetch('/api/owner/improvmx/smtp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username })
            });
            const data = await res.json();

            if (data.success) {
                const creds = data.credentials;
                showOwnerSuccessModal({
                    title: 'SMTP Credentials Generated',
                    message: 'Your dedicated SMTP account is now active. Please save these credentials safely.',
                    details: `
                        <div style="display:flex; flex-direction:column; gap:6px; text-align:left;">
                            <div><span style="color:#aaa;">Host:</span> <b style="color:var(--gold);">${creds.host}</b></div>
                            <div><span style="color:#aaa;">Port:</span> <b>${creds.port}</b></div>
                            <div><span style="color:#aaa;">Username:</span> <b>${creds.username}</b></div>
                            <div><span style="color:#aaa;">Password:</span> <code style="color:#00e676; background:#1e1e24; padding:3px 8px; border-radius:4px; font-size:1.05em;">${creds.password}</code></div>
                        </div>
                    `
                });
            } else {
                alert('✖ ' + (data.message || 'Failed to generate SMTP'));
            }
        } catch (err) {
            alert('✖ Network error: ' + err.message);
        } finally {
            btnElement.disabled = false;
            btnElement.innerHTML = originalText;
        }
    }

    // ==========================================
    // CORE DASHBOARD ACTIONS
    // ==========================================
    async function handleDataTermination(btnElement) {
        const confirmWord = prompt("WARNING: This will drop the entire MongoDB database, destroying all users, mods, and state permanently.\n\nType 'TERMINATE_ALL_DATA' to confirm:");
        if (confirmWord !== 'TERMINATE_ALL_DATA') {
            alert('Data termination cancelled.');
            return;
        }

        const originalText = btnElement.innerHTML;
        const feedbackEl = btnElement.closest('.action-group').querySelector('.status-feedback');
        btnElement.disabled = true;
        btnElement.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Terminating...';
        feedbackEl.style.display = 'none';

        try {
            const res = await fetch('/api/owner/core/terminate-data', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ confirm: confirmWord })
            });
            const data = await res.json();
            
            feedbackEl.style.display = 'block';
            if (data.success) {
                feedbackEl.style.color = 'var(--red)';
                feedbackEl.textContent = '✔ ' + data.message;
                showOwnerSuccessModal({
                    title: 'Database Terminated',
                    message: data.message || 'All collections dropped.'
                });
            } else {
                feedbackEl.style.color = 'var(--red)';
                feedbackEl.textContent = '✖ ' + (data.message || data.error);
            }
        } catch (err) {
            feedbackEl.style.display = 'block';
            feedbackEl.style.color = 'var(--red)';
            feedbackEl.textContent = '✖ Network Error: ' + err.message;
        } finally {
            btnElement.disabled = false;
            btnElement.innerHTML = originalText;
        }
    }

    async function handleAction(btnElement, endpoint) {
        const originalText = btnElement.innerHTML;
        const feedbackEl = btnElement.closest('.action-group').querySelector('.status-feedback');
        
        btnElement.disabled = true;
        btnElement.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
        feedbackEl.style.display = 'none';

        try {
            const res = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            
            feedbackEl.style.display = 'block';
            if (data.success) {
                feedbackEl.style.color = 'var(--green)';
                feedbackEl.textContent = '✔ ' + data.message;
                showOwnerSuccessModal({
                    title: 'Operation Successful',
                    message: data.message || 'Action executed successfully.'
                });
            } else {
                feedbackEl.style.color = 'var(--red)';
                feedbackEl.textContent = '✖ ' + (data.message || data.error);
            }
        } catch (err) {
            feedbackEl.style.display = 'block';
            feedbackEl.style.color = 'var(--red)';
            feedbackEl.textContent = '✖ Network Error: ' + err.message;
        } finally {
            btnElement.disabled = false;
            btnElement.innerHTML = originalText;
            setTimeout(() => {
                feedbackEl.style.display = 'none';
            }, 6000);
        }
    }

    function copyOwnerKey(elemId, btn) {
        const text = document.getElementById(elemId).innerText.trim();
        navigator.clipboard.writeText(text).then(() => {
            const orig = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check" style="color:#4caf50;"></i>';
            setTimeout(() => { btn.innerHTML = orig; }, 2000);
        }).catch(() => {
            alert('Failed to copy key: ' + text);
        });
    }

    async function generateOwnerDebuggerKey(btn) {
        const orig = btn.innerHTML;
        const feedbackEl = btn.closest('.action-group').querySelector('.status-feedback');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';
        feedbackEl.style.display = 'none';

        try {
            const res = await fetch('/api/owner/debugger/generate-key', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            feedbackEl.style.display = 'block';

            if (data.success && data.key) {
                document.getElementById('ownerDebuggerKey').innerText = data.key;
                feedbackEl.style.color = 'var(--green)';
                feedbackEl.textContent = '✔ New 11-digit key active: ' + data.key;
                showOwnerSuccessModal({
                    title: 'New Debugger Key Generated',
                    message: 'Fresh single-use access code: ' + data.key + ' (Expires in 1 hour or upon use).'
                });
            } else {
                feedbackEl.style.color = 'var(--red)';
                feedbackEl.textContent = '✖ ' + (data.message || data.error || 'Failed to generate key');
            }
        } catch (err) {
            feedbackEl.style.display = 'block';
            feedbackEl.style.color = 'var(--red)';
            feedbackEl.textContent = '✖ Error: ' + err.message;
        } finally {
            btn.disabled = false;
            btn.innerHTML = orig;
            setTimeout(() => { feedbackEl.style.display = 'none'; }, 6000);
        }
    }

    // Auto-load diagnostics on startup
    window.addEventListener('DOMContentLoaded', () => {
        checkCloudflareStatus();
        checkDynuStatus();
        checkNetlifyStatus();
        checkMongoAtlasStatus();
        checkB2Status();
        checkDnsArchiveStatus();
        checkImprovmxStatus();
    });
</script>

