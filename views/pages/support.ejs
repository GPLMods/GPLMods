<%- include('../partials/header') %>

<style>
    /* Suppress the floating bottom-right support widget on the dedicated /support page */
    #gplChatToggle, #gplChatWindow, #gplChatGreeting, #gplChatHistoryDrawer, .gpl-chat-btn, .gpl-chat-window,
    #supportChatWindow, #supportChatLauncher, #supportChatGreeting, #supportChatDrawer {
        display: none !important;
    }

    .support-main-wrapper {
        max-width: 1100px;
        margin: 2rem auto 4rem auto;
        padding: 0 1rem;
    }

    /* ======== 1. CHOICE GATEWAY SCREEN ======== */
    .support-choice-container {
        animation: fadeInSupport 0.3s ease-out;
    }

    .support-hero-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }
    .support-hero-header h1 {
        font-size: 2.8em;
        color: var(--white);
        margin-bottom: 10px;
    }
    .support-hero-header h1 span {
        color: var(--gold);
        text-shadow: 0 0 4px var(--glow-gold);
    }
    .support-hero-header p {
        color: var(--silver);
        font-size: 1.1em;
        max-width: 650px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .choice-cards-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
        margin-top: 1.5rem;
    }

    .support-choice-card {
        background: linear-gradient(160deg, #181818 0%, #101010 100%);
        border: 1px solid #333;
        border-radius: 18px;
        padding: 35px 30px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    }
    .support-choice-card:hover {
        transform: translateY(-6px);
    }
    .support-choice-card.live-card {
        border-top: 4px solid var(--gold);
    }
    .support-choice-card.live-card:hover {
        border-color: var(--gold);
        box-shadow: 0 12px 35px rgba(255, 215, 0, 0.15);
    }
    .support-choice-card.ticket-card {
        border-top: 4px solid var(--blue);
    }
    .support-choice-card.ticket-card:hover {
        border-color: var(--blue);
        box-shadow: 0 12px 35px rgba(33, 150, 243, 0.15);
    }

    .card-badge-wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    .card-badge {
        font-size: 0.76em;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 4px 12px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .badge-live {
        background: rgba(255, 215, 0, 0.15);
        color: var(--gold);
        border: 1px solid rgba(255, 215, 0, 0.35);
    }
    .badge-ticket {
        background: rgba(33, 150, 243, 0.15);
        color: #64b5f6;
        border: 1px solid rgba(33, 150, 243, 0.35);
    }

    .card-icon-halo {
        width: 70px;
        height: 70px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2em;
        margin-bottom: 20px;
    }
    .halo-gold {
        background: rgba(255, 215, 0, 0.1);
        color: var(--gold);
        border: 1px solid rgba(255, 215, 0, 0.25);
    }
    .halo-blue {
        background: rgba(33, 150, 243, 0.1);
        color: #42a5f5;
        border: 1px solid rgba(33, 150, 243, 0.25);
    }

    .support-choice-card h2 {
        font-size: 1.7em;
        color: var(--white);
        margin: 0 0 12px 0;
    }
    .support-choice-card p {
        color: var(--silver);
        font-size: 0.95em;
        line-height: 1.6;
        margin: 0 0 20px 0;
    }

    .card-features-list {
        list-style: none;
        padding: 0;
        margin: 0 0 25px 0;
    }
    .card-features-list li {
        color: #ddd;
        font-size: 0.9em;
        margin-bottom: 9px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .card-features-list li i {
        font-size: 0.9em;
    }
    .live-card .card-features-list li i { color: var(--gold); }
    .ticket-card .card-features-list li i { color: #64b5f6; }

    .choice-btn {
        width: 100%;
        padding: 15px 20px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 1.05em;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: none;
        transition: all 0.25s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .btn-live-launch {
        background: var(--gold);
        color: #000;
        box-shadow: 0 0 15px var(--glow-gold);
    }
    .btn-live-launch:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 25px var(--glow-gold);
    }
    .btn-ticket-launch {
        background: transparent;
        color: #64b5f6;
        border: 2px solid #64b5f6;
    }
    .btn-ticket-launch:hover {
        background: rgba(33, 150, 243, 0.15);
        color: #fff;
        transform: translateY(-2px);
    }

    /* ======== 2. FULL-SCREEN LIVE CHAT SCREEN ======== */
    .fullscreen-chat-container {
        background: #111;
        border: 1px solid #333;
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.6);
        display: flex;
        flex-direction: column;
        height: 78vh;
        min-height: 600px;
        position: relative;
        overflow: hidden;
        animation: fadeInSupport 0.3s ease-out;
    }

    .fullscreen-chat-header {
        background: #181818;
        border-bottom: 1px solid #292929;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }
    .chat-header-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .chat-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8em;
        color: var(--green);
        background: rgba(46, 204, 113, 0.12);
        border: 1px solid rgba(46, 204, 113, 0.3);
        padding: 3px 10px;
        border-radius: 12px;
        margin-top: 4px;
    }
    .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--green);
        box-shadow: 0 0 8px var(--green);
        animation: pulseAnimation 2s infinite;
    }
    @keyframes pulseAnimation {
        0% { transform: scale(0.95); opacity: 0.7; }
        50% { transform: scale(1.2); opacity: 1; }
        100% { transform: scale(0.95); opacity: 0.7; }
    }

    .chat-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .chat-nav-action-btn {
        background: #242424;
        border: 1px solid #444;
        color: var(--silver);
        padding: 8px 15px;
        border-radius: 8px;
        font-size: 0.85em;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: all 0.2s;
    }
    .chat-nav-action-btn:hover {
        border-color: var(--gold);
        color: var(--gold);
        background: #2a2a2a;
    }
    .chat-nav-action-btn.gold {
        border-color: var(--gold);
        color: var(--gold);
        background: rgba(255, 215, 0, 0.08);
    }
    .chat-nav-action-btn.gold:hover {
        background: var(--gold);
        color: #000;
    }

    .ticket-top-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
        max-width: 850px;
        margin-left: auto;
        margin-right: auto;
    }

    @media (max-width: 540px) {
        .ticket-top-controls {
            gap: 10px;
        }
        .ticket-top-controls .chat-nav-action-btn {
            flex: 1 1 auto;
            justify-content: center;
            text-align: center;
            padding: 8px 10px;
            font-size: 0.78em;
            white-space: nowrap;
        }
    }

    .fullscreen-chat-messages {
        flex-grow: 1;
        padding: 25px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 15px;
        background: #0d0d0d;
    }

    .fs-msg-bubble {
        max-width: 72%;
        padding: 13px 18px;
        border-radius: 16px;
        line-height: 1.5;
        font-size: 0.95em;
        word-wrap: break-word;
        animation: supportMessageIn 0.22s ease-out;
    }
    @keyframes supportMessageIn {
        from { opacity: 0; transform: translateY(8px) scale(0.98); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .fs-msg-user {
        align-self: flex-end;
        background: #222;
        border: 1px solid #444;
        border-bottom-right-radius: 2px;
        color: var(--white);
    }
    .fs-msg-agent {
        align-self: flex-start;
        background: var(--blue);
        color: #fff;
        border-bottom-left-radius: 2px;
    }
    .fs-msg-bot {
        align-self: flex-start;
        background: rgba(255, 215, 0, 0.09);
        border: 1px solid var(--gold);
        color: var(--gold);
        border-bottom-left-radius: 2px;
    }
    .fs-msg-system {
        align-self: center;
        background: transparent;
        color: var(--silver);
        font-size: 0.85em;
        font-style: italic;
        border: 1px dashed #444;
        border-radius: 8px;
        text-align: center;
        padding: 6px 16px;
    }

    /* Media attachments tray */
    .fs-media-tray {
        padding: 8px 24px;
        background: #151515;
        border-top: 1px solid #282828;
        display: flex;
        gap: 10px;
        align-items: center;
        overflow-x: auto;
    }
    .fs-tray-item {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #202020;
        border: 1px solid #444;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8em;
        color: var(--gold);
    }
    .fs-tray-item .remove-media-btn {
        color: var(--red);
        cursor: pointer;
        background: transparent;
        border: none;
        font-size: 1.1em;
        padding: 0 2px;
    }

    /* Quick Questions / Replies */
    .fs-chat-quick-replies {
        display: flex;
        gap: 8px;
        padding: 10px 24px;
        overflow-x: auto;
        background: #141414;
        border-top: 1px solid #242424;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        flex-shrink: 0;
    }
    .fs-chat-quick-replies::-webkit-scrollbar {
        display: none;
    }
    .fs-quick-btn {
        background: #202020;
        border: 1px solid #383838;
        color: var(--white);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.84em;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }
    .fs-quick-btn i {
        color: var(--gold);
        font-size: 0.9em;
    }
    .fs-quick-btn:hover {
        background: #2a2a2a;
        border-color: var(--gold);
        color: var(--gold);
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(255, 215, 0, 0.2);
    }

    /* Input area */
    .fullscreen-chat-input-area {
        padding: 15px 24px;
        background: #181818;
        border-top: 1px solid #282828;
        display: flex;
        gap: 10px;
        align-items: center;
        position: relative;
    }
    .fs-tool-btn {
        background: #252525;
        border: 1px solid #444;
        color: var(--silver);
        border-radius: 8px;
        padding: 12px 15px;
        font-size: 1.1em;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .fs-tool-btn:hover {
        border-color: var(--gold);
        color: var(--gold);
        background: #2c2c2c;
        transform: scale(1.05);
    }
    .fullscreen-chat-input-area input {
        flex-grow: 1;
        padding: 14px 18px;
        border-radius: 8px;
        border: 1px solid #444;
        background: #0c0c0c;
        color: var(--white);
        outline: none;
        font-family: inherit;
        font-size: 0.95em;
        transition: border-color 0.2s;
    }
    .fullscreen-chat-input-area input:focus {
        border-color: var(--gold);
    }
    .fs-submit-btn {
        padding: 14px 22px;
        border-radius: 8px;
        border: none;
        background: var(--gold);
        color: #000;
        font-weight: bold;
        cursor: pointer;
        transition: 0.2s;
        font-size: 1.05em;
    }
    .fs-submit-btn:hover {
        filter: brightness(1.1);
        transform: scale(1.02);
    }

    /* Emoji Popover */
    .fs-emoji-popover {
        position: absolute;
        bottom: calc(100% + 12px);
        left: 24px;
        width: 320px;
        max-width: calc(100vw - 30px);
        background: #1c1c1c;
        border: 1px solid #444;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.8);
        z-index: 100005;
        padding: 12px;
    }
    .fs-emoji-grid {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 6px;
        max-height: 200px;
        overflow-y: auto;
        padding: 4px;
    }
    .fs-emoji-item {
        font-size: 1.35em;
        text-align: center;
        cursor: pointer;
        border-radius: 6px;
        padding: 4px;
        transition: background 0.15s, transform 0.15s;
        user-select: none;
    }
    .fs-emoji-item:hover {
        background: #2a2a2a;
        transform: scale(1.2);
    }

    /* ======== 3. TICKET DESK SCREEN ======== */
    .support-ticket-container {
        max-width: 850px;
        margin: 0 auto;
        padding: 3rem;
        background-color: var(--dark-gray);
        border-radius: 18px;
        border: 1px solid #333;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        animation: fadeInSupport 0.3s ease-out;
    }

    .form-group { margin-bottom: 25px; position: relative; }
    .form-group label { display: block; margin-bottom: 8px; font-weight: 600; color: var(--silver); }
    .form-group input, .form-group textarea { 
        width: 100%; 
        padding: 15px; 
        border-radius: 8px; 
        border: 1px solid #333; 
        background-color: var(--black); 
        color: var(--white); 
        font-family: 'Poppins', sans-serif; 
        font-size: 1em; 
        transition: all 0.3s ease; 
        outline: none;
    }
    .form-group input:focus, .form-group textarea:focus { border-color: var(--gold); box-shadow: 0 0 10px var(--glow-gold); }
    .form-group textarea { min-height: 180px; resize: vertical; }
    
    .submit-btn { width: 100%; background-color: var(--gold); color: var(--black); padding: 18px; font-size: 1.2em; font-weight: bold; border: none; border-radius: 8px; cursor: pointer; transition: all 0.3s ease; margin-top: 10px; box-shadow: 0 0 15px var(--glow-gold); text-transform: uppercase; letter-spacing: 1px; }
    .submit-btn:hover { transform: translateY(-3px); box-shadow: 0 0 25px var(--glow-gold); }

    .alert-msg { padding: 15px; border-radius: 8px; margin-bottom: 25px; font-weight: bold; text-align: center; }
    .alert-success { background-color: rgba(46, 204, 113, 0.1); color: #2ecc71; border: 1px solid #2ecc71; }
    .alert-error { background-color: rgba(229, 57, 53, 0.1); color: var(--red); border: 1px solid var(--red); }

    /* Custom select dropdown */
    .form-group.dropdown-group { position: relative; z-index: 50; }
    .custom-select-wrapper { position: relative; user-select: none; width: 100%; }
    .custom-select-wrapper.open { z-index: 100; }
    .custom-select {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px;
        background-color: var(--black);
        border: 1px solid #333;
        border-radius: 8px;
        cursor: pointer;
        color: var(--silver);
        font-size: 1em;
        transition: all 0.3s ease;
    }
    .custom-select-wrapper.open .custom-select {
        border-color: var(--gold);
        box-shadow: 0 0 10px var(--glow-gold);
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
    }
    .custom-select-wrapper.open .custom-select-arrow {
        transform: rotate(180deg);
        color: var(--gold);
    }
    .custom-options {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: var(--dark-gray);
        border: 1px solid var(--gold);
        border-top: none;
        border-radius: 0 0 8px 8px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.5);
        z-index: 999;
        display: none;
        max-height: 250px;
        overflow-y: auto;
    }
    .custom-select-wrapper.open .custom-options { display: block; }
    .custom-option {
        padding: 12px 15px;
        cursor: pointer;
        color: var(--white);
        transition: background-color 0.2s;
        border-bottom: 1px solid #2a2a2a;
    }
    .custom-option:last-child { border-bottom: none; }
    .custom-option:hover { background-color: var(--black); color: var(--gold); }
    .custom-option.selected { background-color: var(--black); color: var(--gold); font-weight: bold; }

    /* Ticket History */
    .ticket-history { margin-top: 5rem; border-top: 1px solid #333; padding-top: 3rem; }
    .ticket-history h2 { color: var(--white); margin-bottom: 2rem; font-size: 2em; }
    .ticket-card-item { background-color: var(--black); border: 1px solid #333; border-radius: 12px; padding: 25px; margin-bottom: 20px; transition: transform 0.2s, box-shadow 0.2s; }
    .ticket-card-item:hover { transform: translateY(-3px); box-shadow: 0 5px 15px rgba(0,0,0,0.3); border-color: #444; }
    .ticket-card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 1px solid #222; padding-bottom: 15px; }
    .ticket-subject { font-size: 1.3em; color: var(--gold); font-weight: 600; margin: 0; }
    .ticket-category-tag { font-size: 0.85em; color: var(--silver); background: #222; padding: 5px 12px; border-radius: 15px; text-transform: uppercase; letter-spacing: 0.5px; }
    
    .status-badge { padding: 6px 15px; border-radius: 15px; font-size: 0.85em; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px; }
    .status-open { background-color: rgba(255, 215, 0, 0.1); color: var(--gold); border: 1px solid var(--gold); }
    .status-in-progress { background-color: rgba(33, 150, 243, 0.1); color: var(--blue); border: 1px solid var(--blue); }
    .status-resolved, .status-closed { background-color: rgba(46, 204, 113, 0.1); color: var(--green); border: 1px solid var(--green); }

    @keyframes fadeInSupport {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 768px) {
        .choice-cards-grid { grid-template-columns: 1fr; }
        .support-ticket-container { padding: 2rem 1.25rem; }
        
        body.live-chat-active {
            overflow: hidden !important;
            position: fixed !important;
            width: 100% !important;
            height: 100% !important;
        }
        
        body:not(.live-chat-active) .fullscreen-chat-container {
            display: none !important;
        }

        /* True Full-Screen Native App Experience on Mobile when chat is active */
        body.live-chat-active .fullscreen-chat-container {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            height: 100% !important;
            height: 100dvh !important;
            min-height: 0 !important;
            margin: 0 !important;
            border: none !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            z-index: 999999 !important;
            display: flex !important;
            flex-direction: column !important;
            box-sizing: border-box !important;
            overflow: hidden !important;
        }

        .fullscreen-chat-header {
            padding: 10px 14px;
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            background: #141414;
            border-bottom: 1px solid #282828;
            flex-shrink: 0;
            padding-top: max(10px, env(safe-area-inset-top, 10px));
        }
        .chat-header-info {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
            flex: 1;
        }
        .chat-header-info h3 {
            font-size: 0.95em !important;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .chat-status-pill {
            font-size: 0.7em;
            padding: 2px 7px;
            margin-top: 1px;
        }
        .chat-header-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }
        .chat-nav-action-btn {
            padding: 6px 10px;
            font-size: 0.78em;
            border-radius: 6px;
            gap: 4px;
            white-space: nowrap;
        }
        .chat-nav-action-btn#btnChatSwitchToGemini span,
        .chat-nav-action-btn#btnChatNewSession span {
            display: none; /* Keep icons clean and concise on mobile */
        }
        .fullscreen-chat-messages {
            flex-grow: 1;
            padding: 12px 14px;
            gap: 10px;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }
        .fs-msg-bubble {
            max-width: 86%;
            padding: 10px 14px;
            font-size: 0.9em;
        }
        .fs-chat-quick-replies {
            padding: 8px 12px;
            gap: 6px;
        }
        .fs-quick-btn {
            padding: 5px 12px;
            font-size: 0.8em;
        }
        .fullscreen-chat-input-area {
            box-sizing: border-box !important;
            width: 100% !important;
            max-width: 100% !important;
            padding: 8px 10px !important;
            padding-bottom: max(10px, env(safe-area-inset-bottom, 10px)) !important;
            background: #161616 !important;
            border-top: 1px solid #282828 !important;
            gap: 6px !important;
            display: flex !important;
            align-items: center !important;
            flex-shrink: 0 !important;
            overflow: visible !important;
            position: relative !important;
        }
        .fullscreen-chat-input-area input {
            flex: 1 1 0% !important;
            min-width: 0 !important;
            width: auto !important;
            padding: 10px 14px !important;
            font-size: 16px !important; /* Critical: stops mobile auto-zoom */
            border-radius: 20px !important;
            box-sizing: border-box !important;
        }
        .fs-tool-btn {
            flex-shrink: 0 !important;
            width: 38px !important;
            height: 38px !important;
            padding: 0 !important;
            font-size: 1.05em !important;
            border-radius: 50% !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
        }
        .fs-submit-btn {
            flex-shrink: 0 !important;
            width: 42px !important;
            height: 38px !important;
            padding: 0 !important;
            border-radius: 20px !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            font-size: 1em !important;
        }
        .fs-emoji-popover {
            width: calc(100% - 20px) !important;
            left: 10px !important;
            right: 10px !important;
            max-width: 360px !important;
            bottom: calc(100% + 10px) !important;
            max-height: 220px !important;
            z-index: 100005 !important;
        }
    }

    @media (max-width: 480px) {
        .chat-nav-action-btn {
            padding: 5px 8px;
            font-size: 0.75em;
        }
        .chat-header-info h3 {
            font-size: 0.88em !important;
        }
        .chat-status-pill {
            display: none; /* Save space on small phones */
        }
    }
</style>

<div class="container">
    <div class="support-main-wrapper">

        <!-- ============================================== -->
        <!-- SCREEN 1: SUPPORT CHOICE / GATEWAY HUB -->
        <!-- ============================================== -->
        <div id="supportChoiceScreen" class="support-choice-container">
            <%- include('../partials/go-back-button', { fallback: '/', wrapperStyle: 'margin-bottom: 1.5rem;' }) %>

            <div class="support-hero-header">
                <h1>Help & <span>Support Desk</span></h1>
                <p>Welcome to the GPL Mods Support Hub. Choose your preferred channel to get real-time assistance or submit an inquiry.</p>
            </div>

            <div class="choice-cards-grid">
                <!-- Option 1: Live Chat -->
                <div class="support-choice-card live-card" id="cardChooseLiveChat">
                    <div>
                        <div class="card-badge-wrap">
                            <span class="card-badge badge-live"><i class="fas fa-bolt"></i> Instant 24/7 Response</span>
                        </div>
                        <div class="card-icon-halo halo-gold">
                            <i class="fas fa-headset"></i>
                        </div>
                        <h2>Live Support Chat</h2>
                        <p>Engage in real-time interactive conversation with our 24/7 AI or live human support agents. Ask questions, troubleshoot mods, or share error screenshots instantly.</p>
                        
                        <ul class="card-features-list">
                            <li><i class="fas fa-check-circle"></i> Instant replies & zero wait time</li>
                            <li><i class="fas fa-check-circle"></i> Seamless handoff to human support staff</li>
                            <li><i class="fas fa-check-circle"></i> Upload and send photos or video captures</li>
                            <li><i class="fas fa-check-circle"></i> Full-screen focused chat experience</li>
                        </ul>
                    </div>

                    <button type="button" class="choice-btn btn-live-launch">
                        <i class="fas fa-comments"></i> Launch Live Chat
                    </button>
                </div>

                <!-- Option 2: Submit a Ticket -->
                <div class="support-choice-card ticket-card" id="cardChooseTicket">
                    <div>
                        <div class="card-badge-wrap">
                            <span class="card-badge badge-ticket"><i class="fas fa-file-alt"></i> Official Inquiry</span>
                        </div>
                        <div class="card-icon-halo halo-blue">
                            <i class="fas fa-ticket-alt"></i>
                        </div>
                        <h2>Submit a Support Ticket</h2>
                        <p>Need in-depth investigation, billing reconciliation, or distributor partnership support? Submit a detailed ticket for our dedicated review team.</p>
                        
                        <ul class="card-features-list">
                            <li><i class="fas fa-check-circle"></i> Dedicated case tracker with ticket IDs</li>
                            <li><i class="fas fa-check-circle"></i> Receive reply alerts right in your Notifications</li>
                            <li><i class="fas fa-check-circle"></i> Detailed category classification</li>
                            <li><i class="fas fa-check-circle"></i> Historical records of past inquiries</li>
                        </ul>
                    </div>

                    <button type="button" class="choice-btn btn-ticket-launch">
                        <i class="fas fa-paper-plane"></i> Submit a Ticket
                    </button>
                </div>
            </div>
        </div>


        <!-- ============================================== -->
        <!-- SCREEN 2: FULL-SCREEN LIVE CHAT -->
        <!-- ============================================== -->
        <div id="supportChatScreen" class="fullscreen-chat-container" style="display: none;">
            <!-- Header -->
            <div class="fullscreen-chat-header">
                <div class="chat-header-info">
                    <button type="button" class="chat-nav-action-btn" id="btnChatBackToChoice" title="Back to Options">
                        <i class="fas fa-arrow-left"></i> <span>Options</span>
                    </button>
                    <div>
                        <h3 style="margin: 0; color: var(--white); font-size: 1.1em;">GPL Live Support</h3>
                        <div class="chat-status-pill">
                            <span class="pulse-dot"></span>
                            <span id="chatStatusText">AI & Staff Online</span>
                        </div>
                    </div>
                </div>

                <div class="chat-header-actions">
                    <button type="button" class="chat-nav-action-btn" id="btnChatSwitchToGemini" title="Switch back to Gemini AI" style="display: none; border-color: rgba(0,230,118,0.4); color: #00e676;">
                        <img src="/images/gemini.png" alt="Gemini" style="width: 15px; height: 15px; object-fit: contain;"> <span>Switch to Gemini</span>
                    </button>
                    <button type="button" class="chat-nav-action-btn" id="btnChatNewSession" title="Start fresh conversation">
                        <i class="fas fa-plus"></i> <span>New Chat</span>
                    </button>
                    <button type="button" class="chat-nav-action-btn gold" id="btnChatSwitchToTicket" title="Switch to Ticket Desk">
                        <i class="fas fa-ticket-alt"></i> <span>Ticket Desk</span>
                    </button>
                </div>
            </div>

            <!-- Messages Stream -->
            <div class="fullscreen-chat-messages" id="fullscreenChatMessages">
                <!-- Dynamically populated -->
            </div>

            <!-- Media Preview Tray -->
            <div class="fs-media-tray" id="fullscreenMediaTray" style="display: none;"></div>

            <!-- Quick Question Replies -->
            <div class="fs-chat-quick-replies" id="fsChatQuickReplies">
                <button type="button" class="fs-quick-btn" data-query="Suggest a Mod"><i class="fas fa-lightbulb"></i> Suggest a Mod</button>
                <button type="button" class="fs-quick-btn" data-query="Report a Bug"><i class="fas fa-bug"></i> Report a Bug</button>
                <button type="button" class="fs-quick-btn" data-query="Talk to Support"><i class="fas fa-headset"></i> Talk to Support</button>
            </div>

            <!-- Input Bar -->
            <form class="fullscreen-chat-input-area" id="fullscreenChatForm">
                <!-- Emoji Button -->
                <button type="button" class="fs-tool-btn" id="fsEmojiBtn" title="Insert Emoji">
                    <i class="far fa-smile"></i>
                </button>
                
                <!-- Media Attachment Button -->
                <button type="button" class="fs-tool-btn" id="fsMediaBtn" title="Upload Image or Video">
                    <i class="fas fa-paperclip"></i>
                </button>
                <input type="file" id="fsMediaFileInput" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime" style="display: none;">

                <!-- Floating Emoji Popover -->
                <div class="fs-emoji-popover" id="fsEmojiPopover" style="display: none;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 0.75em; color: var(--gold); font-weight: 700; text-transform: uppercase;">Quick Emojis</span>
                        <span id="closeFsEmojiBtn" style="font-size: 0.7em; color: var(--silver); cursor: pointer;">&times; Close</span>
                    </div>
                    <div class="fs-emoji-grid" id="fsEmojiGrid"></div>
                </div>

                <input type="text" id="fullscreenChatInput" placeholder="Type your message, or type 'human' to speak with staff..." autocomplete="off">
                <button type="submit" id="fullscreenChatSubmit" class="fs-submit-btn">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </form>

            <!-- Rich Machine-Textured Gemini Confirmation Modal for Support Page Live Chat -->
            <div class="gpl-chat-confirm-modal" id="fsGeminiModal" style="display: none; position: absolute; inset: 0; z-index: 10000; align-items: center; justify-content: center; padding: 20px; background: rgba(0,0,0,0.78); backdrop-filter: blur(4px);">
                <div style="background: linear-gradient(145deg, #1b2230 0%, #11141c 50%, #0a0c12 100%); color: var(--white); padding: 26px 22px; text-align: center; border-radius: 16px; max-width: 380px; width: 92%; border: 1.5px solid rgba(0, 230, 118, 0.45); box-shadow: 0 15px 40px rgba(0,0,0,0.85), 0 0 25px rgba(0, 176, 255, 0.25); position: relative;">
                    <div style="width: 54px; height: 54px; border-radius: 16px; background: linear-gradient(135deg, rgba(0, 176, 255, 0.2), rgba(0, 230, 118, 0.15)); border: 1.5px solid rgba(0, 230, 118, 0.5); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto; box-shadow: 0 0 20px rgba(0, 230, 118, 0.35); position: relative;">
                        <img src="/images/gemini.png" alt="Gemini AI" style="width: 32px; height: 32px; object-fit: contain;">
                        <span style="position: absolute; bottom: -2px; right: -2px; width: 12px; height: 12px; border-radius: 50%; background: #00e676; border: 2px solid #11141c; box-shadow: 0 0 8px #00e676;"></span>
                    </div>
                    <h3 style="color: #fff; margin: 0 0 10px; font-size: 1.18em; font-weight: 700;">
                        Switch to Gemini AI?
                    </h3>
                    <p id="fsGeminiMessage" style="margin: 0 0 20px; color: var(--silver); font-size: 0.88em; line-height: 1.55;">
                        Do you want to switch back to Gemini AI Assistant?
                    </p>
                    <div style="display: flex; gap: 10px; justify-content: center;">
                        <button type="button" id="fsGeminiCancelBtn" style="background: rgba(255, 255, 255, 0.06); color: #ccc; border: 1.5px solid #3d4250; padding: 9px 18px; border-radius: 10px; font-weight: 600; font-size: 0.88em; cursor: pointer; transition: all 0.2s;">
                            Keep Waiting
                        </button>
                        <button type="button" id="fsGeminiConfirmBtn" style="background: linear-gradient(135deg, #00e676 0%, #00b0ff 100%); color: #000; padding: 9px 20px; border-radius: 10px; font-weight: 700; font-size: 0.88em; border: 0; cursor: pointer; box-shadow: 0 0 16px rgba(0, 230, 118, 0.4); transition: all 0.2s;">
                            <i class="fas fa-robot" style="margin-right: 5px;"></i> Switch to Gemini
                        </button>
                    </div>
                </div>
            </div>
        </div>


        <!-- ============================================== -->
        <!-- SCREEN 3: TICKET DESK FORM & HISTORY -->
        <!-- ============================================== -->
        <div id="supportTicketScreen" style="display: none;">
            <!-- Top Controls -->
            <div class="ticket-top-controls">
                <button type="button" class="chat-nav-action-btn" id="btnTicketBackToChoice">
                    <i class="fas fa-arrow-left"></i> <span>Back to Options</span>
                </button>
                <button type="button" class="chat-nav-action-btn gold" id="btnTicketSwitchToChat">
                    <i class="fas fa-comments"></i> <span>Prefer Live Chat? Switch Now</span>
                </button>
            </div>

            <div class="support-ticket-container">
                <div class="support-header" style="text-align: center; margin-bottom: 2.5rem;">
                    <h1 style="font-size: 2.5em; color: var(--white); margin-bottom: 10px;">Submit a <span>Support Ticket</span></h1>
                    <p style="color: var(--silver); font-size: 1.05em;">Our team investigates all tickets thoroughly and responds directly via your Notifications.</p>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert-msg alert-error"><%= error %></div>
                <% } %>
                <% if (typeof message !== 'undefined' && message) { %>
                    <div class="alert-msg alert-success"><%= message %></div>
                <% } %>

                <!-- Support Form -->
                <form action="/support" method="POST" id="supportForm">
                    <div class="form-group dropdown-group">
                        <label>What do you need help with?*</label>
                        
                        <!-- Real Native Select -->
                        <select id="category" name="category" style="display: none;">
                            <option value="" disabled selected>Select a category...</option>
                            <option value="account">Account / Login Issues</option>
                            <option value="upload-issue">Problem Uploading a Mod</option>
                            <option value="download-issue">Problem Downloading a Mod</option>
                            <option value="billing">Billing / Premium Membership</option>
                            <option value="bug-report">Report a Website Bug</option>
                            <option value="other">Other</option>
                        </select>

                        <!-- Custom UI -->
                        <div class="custom-select-wrapper">
                            <div class="custom-select">
                                <span class="selected-text">Select a category...</span>
                                <i class="fas fa-chevron-down custom-select-arrow"></i>
                            </div>
                            <div class="custom-options">
                                <div class="custom-option" data-value="account">Account / Login Issues</div>
                                <div class="custom-option" data-value="upload-issue">Problem Uploading a Mod</div>
                                <div class="custom-option" data-value="download-issue">Problem Downloading a Mod</div>
                                <div class="custom-option" data-value="billing">Billing / Premium Membership</div>
                                <div class="custom-option" data-value="bug-report">Report a Website Bug</div>
                                <div class="custom-option" data-value="other">Other</div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="subject">Subject*</label>
                        <input type="text" id="subject" name="subject" placeholder="Brief summary of the issue" required autocomplete="off">
                    </div>

                    <div class="form-group">
                        <label for="message">Message Details*</label>
                        <textarea id="message" name="message" placeholder="Please provide as much detail as possible so we can help you quickly..." required></textarea>
                    </div>

                    <button type="submit" class="submit-btn" id="submitBtn">Submit Ticket</button>
                </form>

                <!-- Ticket History -->
                <div class="ticket-history">
                    <h2>Your Recent Tickets</h2>
                    <% if (tickets && tickets.length > 0) { %>
                        <% tickets.forEach(ticket => { %>
                            <div class="ticket-card-item">
                                <div class="ticket-card-header">
                                    <span class="ticket-category-tag"><i class="fas fa-tag" style="margin-right: 5px;"></i><%= ticket.category.toUpperCase().replace('-', ' ') %></span>
                                    <span class="status-badge status-<%= ticket.status %>"><%= ticket.status %></span>
                                </div>
                                <h3 class="ticket-subject"><%= ticket.subject %></h3>
                                <p style="color: var(--silver); font-size: 0.85em; margin: 10px 0 15px 0;">
                                    <i class="far fa-calendar-alt" style="margin-right: 5px;"></i>Submitted: <%= new Date(ticket.createdAt).toLocaleDateString() %>
                                </p>
                                <p style="color: var(--white); font-size: 0.95em; line-height: 1.6; margin: 0;"><%- ticket.message.replace(/\n/g, '<br>') %></p>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="text-align: center; padding: 40px 20px; background: rgba(0,0,0,0.25); border-radius: 16px; border: 1px dashed rgba(255,255,255,0.15);">
                            <div style="display: flex; justify-content: center; margin-bottom: 12px;">
                                <lottie-player src="<%= cdnUrl %>/animations/ticket.json" background="transparent" speed="1" style="width: 130px; height: 130px; filter: drop-shadow(0 0 15px rgba(0, 176, 255, 0.35));" loop autoplay></lottie-player>
                            </div>
                            <h3 style="color: var(--white); font-weight: 700; margin: 0 0 8px 0; font-size: 1.2em;">No Active Tickets</h3>
                            <p style="color: var(--silver); font-size: 0.92em; margin: 0; max-width: 340px; margin-left: auto; margin-right: auto; line-height: 1.5;">You haven't submitted any support requests yet. Create a ticket above if you need assistance.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // ==========================================
    // 1. SCREEN SWITCHER CONTROLLER
    // ==========================================
    const choiceScreen = document.getElementById('supportChoiceScreen');
    const chatScreen = document.getElementById('supportChatScreen');
    const ticketScreen = document.getElementById('supportTicketScreen');

    function showScreen(mode, isUserAction) {
        choiceScreen.style.display = 'none';
        chatScreen.style.display = 'none';
        ticketScreen.style.display = 'none';

        if (mode === 'chat') {
            chatScreen.style.display = 'flex';
            document.body.classList.add('live-chat-active');
            if (isUserAction) sessionStorage.setItem('gplSupportScreen', 'chat');
            window.location.hash = 'live-chat';
            window.scrollTo(0, 0);
            initLiveChat();
        } else if (mode === 'ticket') {
            document.body.classList.remove('live-chat-active');
            ticketScreen.style.display = 'block';
            if (isUserAction) sessionStorage.setItem('gplSupportScreen', 'ticket');
            window.location.hash = 'ticket-desk';
        } else {
            document.body.classList.remove('live-chat-active');
            choiceScreen.style.display = 'block';
            sessionStorage.removeItem('gplSupportScreen');
            if (history.replaceState) {
                history.replaceState(null, null, window.location.pathname + window.location.search);
            }
        }
    }

    // Navigation triggers (isUserAction = true for explicit user clicks)
    document.getElementById('cardChooseLiveChat')?.addEventListener('click', () => showScreen('chat', true));
    document.getElementById('cardChooseTicket')?.addEventListener('click', () => showScreen('ticket', true));

    document.getElementById('btnChatBackToChoice')?.addEventListener('click', () => showScreen('choice', true));
    document.getElementById('btnChatSwitchToTicket')?.addEventListener('click', () => showScreen('ticket', true));

    document.getElementById('btnTicketBackToChoice')?.addEventListener('click', () => showScreen('choice', true));
    document.getElementById('btnTicketSwitchToChat')?.addEventListener('click', () => showScreen('chat', true));


    // ==========================================
    // 2. FULL-SCREEN LIVE CHAT CONTROLLER
    // ==========================================
    let chatInitialized = false;
    let fsPendingMedia = [];

    const fsChatMessages = document.getElementById('fullscreenChatMessages');
    const fsChatForm = document.getElementById('fullscreenChatForm');
    const fsChatInput = document.getElementById('fullscreenChatInput');
    const fsMediaTray = document.getElementById('fullscreenMediaTray');
    const fsEmojiBtn = document.getElementById('fsEmojiBtn');
    const fsMediaBtn = document.getElementById('fsMediaBtn');
    const fsMediaFileInput = document.getElementById('fsMediaFileInput');
    const fsEmojiPopover = document.getElementById('fsEmojiPopover');
    const fsEmojiGrid = document.getElementById('fsEmojiGrid');
    const closeFsEmojiBtn = document.getElementById('closeFsEmojiBtn');
    const btnChatNewSession = document.getElementById('btnChatNewSession');

    const EMOJIS = [
        "👍", "👎", "❤️", "😊", "😂", "🎉", "🔥", "🚀", 
        "💡", "⚠️", "❌", "✔️", "💻", "📱", "📦", "⚡", 
        "🙌", "👋", "🙏", "😎", "🥳", "🤔", "👀", "✨", 
        "💯", "🔒", "🔑", "🛠️", "⚙️", "📎", "📩", "⭐"
    ];

    if (fsEmojiGrid) {
        EMOJIS.forEach(emoji => {
            const span = document.createElement('span');
            span.className = 'fs-emoji-item';
            span.textContent = emoji;
            span.onclick = () => {
                insertFsEmoji(emoji);
                if (fsEmojiPopover) fsEmojiPopover.style.display = 'none';
            };
            fsEmojiGrid.appendChild(span);
        });
    }

    function insertFsEmoji(emoji) {
        if (!fsChatInput) return;
        const start = fsChatInput.selectionStart || 0;
        const end = fsChatInput.selectionEnd || 0;
        const val = fsChatInput.value;
        fsChatInput.value = val.substring(0, start) + emoji + val.substring(end);
        fsChatInput.selectionStart = fsChatInput.selectionEnd = start + emoji.length;
        fsChatInput.focus();
    }

    if (fsEmojiBtn) {
        fsEmojiBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = fsEmojiPopover.style.display === 'block';
            fsEmojiPopover.style.display = isOpen ? 'none' : 'block';
        });
    }

    if (closeFsEmojiBtn) {
        closeFsEmojiBtn.addEventListener('click', () => {
            fsEmojiPopover.style.display = 'none';
        });
    }

    document.addEventListener('click', (e) => {
        if (fsEmojiPopover && !fsEmojiPopover.contains(e.target) && e.target !== fsEmojiBtn && (!fsEmojiBtn || !fsEmojiBtn.contains(e.target))) {
            fsEmojiPopover.style.display = 'none';
        }
    });

    // Attachment uploading
    if (fsMediaBtn && fsMediaFileInput) {
        fsMediaBtn.addEventListener('click', () => fsMediaFileInput.click());

        fsMediaFileInput.addEventListener('change', async () => {
            const file = fsMediaFileInput.files[0];
            if (!file) return;
            if (file.size > 25 * 1024 * 1024) {
                alert('File is too large. Maximum allowed size is 25MB.');
                fsMediaFileInput.value = '';
                return;
            }

            fsMediaTray.style.display = 'flex';
            fsMediaTray.innerHTML = '<span style="color: var(--gold); font-size: 0.85em;"><i class="fas fa-spinner fa-spin"></i> Uploading attachment...</span>';

            const formData = new FormData();
            formData.append('media', file);

            try {
                const res = await fetch('/api/support/upload-media', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                fsMediaFileInput.value = '';
                if (data.success && data.url) {
                    fsPendingMedia.push(data.url);
                    renderFsMediaTray();
                } else {
                    alert(data.message || 'Media upload failed.');
                    renderFsMediaTray();
                }
            } catch (err) {
                fsMediaFileInput.value = '';
                alert('Network error while uploading attachment.');
                renderFsMediaTray();
            }
        });
    }

    function renderFsMediaTray() {
        if (!fsMediaTray) return;
        if (fsPendingMedia.length === 0) {
            fsMediaTray.style.display = 'none';
            fsMediaTray.innerHTML = '';
            return;
        }
        fsMediaTray.style.display = 'flex';
        fsMediaTray.innerHTML = '';
        fsPendingMedia.forEach((url, idx) => {
            const item = document.createElement('div');
            item.className = 'fs-tray-item';
            const isVid = /\.(mp4|webm|mov|ogg)(\?|$)/i.test(url);
            item.innerHTML = `
                <i class="${isVid ? 'fas fa-film' : 'fas fa-image'}"></i>
                <span>Attachment ${idx + 1}</span>
                <button type="button" class="remove-media-btn" title="Remove attachment">&times;</button>
            `;
            item.querySelector('.remove-media-btn').onclick = () => {
                fsPendingMedia.splice(idx, 1);
                renderFsMediaTray();
            };
            fsMediaTray.appendChild(item);
        });
    }

    function appendFsMessage(text, sender, senderName, mediaUrls = []) {
        if (!fsChatMessages) return;
        const div = document.createElement('div');
        let typeClass = 'fs-msg-system';
        if (sender === 'user') typeClass = 'fs-msg-user';
        if (sender === 'agent') typeClass = 'fs-msg-agent';
        if (sender === 'bot') typeClass = 'fs-msg-bot';

        div.className = `fs-msg-bubble ${typeClass}`;

        let mediaHtml = '';
        if (Array.isArray(mediaUrls) && mediaUrls.length > 0) {
            mediaHtml = '<div style="margin-top: 8px; display: flex; flex-direction: column; gap: 8px;">';
            mediaUrls.forEach(url => {
                const isVid = /\.(mp4|webm|mov|ogg)(\?|$)/i.test(url);
                if (isVid) {
                    mediaHtml += `<video controls src="${url}" style="max-width: 100%; max-height: 280px; border-radius: 8px; background: #000;" preload="metadata"></video>`;
                } else {
                    mediaHtml += `<a href="${url}" target="_blank" rel="noopener noreferrer"><img src="${url}" style="max-width: 100%; max-height: 280px; border-radius: 8px; object-fit: contain; cursor: pointer;" alt="Attachment"></a>`;
                }
            });
            mediaHtml += '</div>';
        }

        div.innerHTML = `
            ${sender === 'agent' || sender === 'bot' ? `<strong style="font-size:0.8em; opacity:0.8; display:block; margin-bottom:3px;">${senderName || (sender === 'bot' ? 'GPL Assistant' : 'Support Agent')}</strong>` : ''}
            ${text ? `<div>${text.replace(/\n/g, '<br>')}</div>` : ''}
            ${mediaHtml}
        `;
        fsChatMessages.appendChild(div);
        fsChatMessages.scrollTop = fsChatMessages.scrollHeight;
    }

    function initLiveChat() {
        if (chatInitialized) {
            setTimeout(() => { if (fsChatInput) fsChatInput.focus(); }, 100);
            return;
        }
        chatInitialized = true;

        const socket = window.gplSupportSocket || (typeof io !== 'undefined' ? io() : null);
        if (!socket) {
            appendFsMessage("Live Chat is currently connecting. Please wait a moment...", "system");
            return;
        }

        let guestId = localStorage.getItem('gplGuestId');
        if (!guestId) {
            guestId = 'guest_' + Math.random().toString(36).substr(2, 9);
            localStorage.setItem('gplGuestId', guestId);
        }

        const userId = '<%= typeof user !== "undefined" && user ? user._id : "" %>';
        let sessionId = localStorage.getItem('gplChatSessionId');

        function joinSupport() {
            socket.emit('join_support_chat', {
                userId,
                guestId,
                sessionId,
                deviceInfo: { browser: navigator.userAgent, os: navigator.platform },
                currentPage: window.location.pathname,
                avatarUrl: '<%= typeof user !== "undefined" && user && user.signedAvatarUrl ? user.signedAvatarUrl : "" %>',
                username: '<%= typeof user !== "undefined" && user ? user.username : "" %>'
            });
        }

        const btnChatSwitchToGemini = document.getElementById('btnChatSwitchToGemini');
        const fsGeminiModal = document.getElementById('fsGeminiModal');
        const fsGeminiConfirmBtn = document.getElementById('fsGeminiConfirmBtn');
        const fsGeminiCancelBtn = document.getElementById('fsGeminiCancelBtn');
        let currentFsStatus = 'bot';

        function updateFsGeminiBtn() {
            if (!btnChatSwitchToGemini) return;
            if (currentFsStatus === 'waiting-for-agent' || currentFsStatus === 'active-agent') {
                btnChatSwitchToGemini.style.display = 'inline-flex';
            } else {
                btnChatSwitchToGemini.style.display = 'none';
            }
        }

        function openFsGeminiModal() {
            if (!fsGeminiModal) return;
            const msgEl = document.getElementById('fsGeminiMessage');
            if (msgEl) {
                msgEl.textContent = currentFsStatus === 'active-agent' 
                    ? 'A support team member is currently assisting you. Do you want to mark this issue as resolved and switch back to Gemini AI Assistant?' 
                    : 'Do you want to switch back to Gemini AI Assistant while waiting for a team member to join?';
            }
            fsGeminiModal.style.display = 'flex';
        }

        function closeFsGeminiModal() {
            if (fsGeminiModal) fsGeminiModal.style.display = 'none';
        }

        if (btnChatSwitchToGemini) btnChatSwitchToGemini.addEventListener('click', openFsGeminiModal);
        if (fsGeminiCancelBtn) fsGeminiCancelBtn.addEventListener('click', closeFsGeminiModal);
        if (fsGeminiConfirmBtn) {
            fsGeminiConfirmBtn.addEventListener('click', () => {
                const activeSessionId = sessionId || localStorage.getItem('gplChatSessionId');
                if (activeSessionId) {
                    socket.emit('user_transfer_to_bot', { sessionId: activeSessionId, guestId, userId });
                }
                closeFsGeminiModal();
                currentFsStatus = 'bot';
                updateFsGeminiBtn();
                appendFsMessage("You have switched back to Gemini AI Assistant. How can I help you today?", "system");
            });
        }

        const fsQuickReplies = document.getElementById('fsChatQuickReplies');
        const fsChatGreetingSfxAudio = new Audio('/sfx/greetings.mp3');
        fsChatGreetingSfxAudio.volume = 0.55;
        fsChatGreetingSfxAudio.preload = 'auto';

        const fsChatReceiveSfxAudio = new Audio('/sfx/massage-recieve.mp3');
        fsChatReceiveSfxAudio.volume = 0.55;
        fsChatReceiveSfxAudio.preload = 'auto';

        const fsChatSendSfxAudio = new Audio('/sfx/massage-sent.mp3');
        fsChatSendSfxAudio.volume = 0.55;
        fsChatSendSfxAudio.preload = 'auto';

        function playFsGreetingSfx() {
            try {
                fsChatGreetingSfxAudio.currentTime = 0;
                const p = fsChatGreetingSfxAudio.play();
                if (p && typeof p.catch === 'function') p.catch(() => {});
            } catch (e) {}
        }

        function playFsIncomingSfx() {
            try {
                fsChatReceiveSfxAudio.currentTime = 0;
                const p = fsChatReceiveSfxAudio.play();
                if (p && typeof p.catch === 'function') p.catch(() => {});
            } catch (e) {}
        }

        function playFsOutgoingSfx() {
            try {
                fsChatSendSfxAudio.currentTime = 0;
                const p = fsChatSendSfxAudio.play();
                if (p && typeof p.catch === 'function') p.catch(() => {});
            } catch (e) {}
        }

        if (fsQuickReplies) {
            fsQuickReplies.querySelectorAll('.fs-quick-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const query = btn.getAttribute('data-query');
                    if (query && fsChatInput) {
                        fsChatInput.value = query;
                        if (fsChatForm) {
                            fsChatForm.dispatchEvent(new Event('submit'));
                        }
                    }
                });
            });
        }

        socket.on('support_chat_ready', (data) => {
            localStorage.setItem('gplChatSessionId', data.sessionId);
            sessionId = data.sessionId;
            currentFsStatus = data.status || 'bot';
            updateFsGeminiBtn();
            fsChatMessages.innerHTML = '';

            if (data.history && data.history.length > 0) {
                data.history.forEach(msg => appendFsMessage(msg.text, msg.sender, msg.senderName, msg.mediaUrls));
            } else {
                appendFsMessage("Hello! 👋 I'm the GPL AI Assistant. How can I help you today? Type 'human' at any time to connect with our support agents.", "bot");
                playFsGreetingSfx();
            }

            if (fsQuickReplies) {
                fsQuickReplies.style.display = (data.history && data.history.length > 2) ? 'none' : 'flex';
            }

            setTimeout(() => { if (fsChatInput) fsChatInput.focus(); }, 150);
        });

        socket.on('support_chat_status_updated', (data) => {
            if (data && data.status) {
                currentFsStatus = data.status;
                updateFsGeminiBtn();
            }
        });

        socket.on('new_support_message', (msg) => {
            appendFsMessage(msg.text, msg.sender, msg.senderName, msg.mediaUrls);
            if (msg.sender !== 'user') {
                playFsIncomingSfx();
            } else {
                playFsOutgoingSfx();
            }
            if (fsQuickReplies && msg.sender === 'user') {
                fsQuickReplies.style.display = 'none';
            }
            if (msg.text && (msg.text.includes('human support team') || msg.text.includes('Transferring you'))) {
                currentFsStatus = 'waiting-for-agent';
                updateFsGeminiBtn();
            } else if (msg.sender === 'agent') {
                currentFsStatus = 'active-agent';
                updateFsGeminiBtn();
            }
        });

        socket.on('support_chat_deleted', () => {
            localStorage.removeItem('gplChatSessionId');
            sessionId = null;
            currentFsStatus = 'bot';
            updateFsGeminiBtn();
            fsChatMessages.innerHTML = '';
            appendFsMessage("Chat reset. Starting a fresh conversation...", "system");
            if (fsQuickReplies) fsQuickReplies.style.display = 'flex';
            socket.emit('join_support_chat', { userId, guestId, sessionId: null, forceNew: true });
        });

        joinSupport();

        // Send Message
        if (fsChatForm) {
            fsChatForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const text = fsChatInput.value.trim();
                const mediaUrls = [...fsPendingMedia];

                if (!text && mediaUrls.length === 0) return;

                const activeSessionId = localStorage.getItem('gplChatSessionId');
                socket.emit('send_support_message', {
                    sessionId: activeSessionId,
                    text,
                    mediaUrls,
                    guestId
                });

                fsChatInput.value = '';
                fsPendingMedia = [];
                renderFsMediaTray();
                if (fsQuickReplies) fsQuickReplies.style.display = 'none';
                if (fsChatInput) fsChatInput.focus();
            });
        }

        // New Chat Button
        if (btnChatNewSession) {
            btnChatNewSession.addEventListener('click', () => {
                if (confirm('Start a new support conversation?')) {
                    localStorage.removeItem('gplChatSessionId');
                    sessionId = null;
                    currentFsStatus = 'bot';
                    updateFsGeminiBtn();
                    fsChatMessages.innerHTML = '';
                    appendFsMessage("Starting a new conversation...", "system");
                    if (fsQuickReplies) fsQuickReplies.style.display = 'flex';
                    socket.emit('join_support_chat', { userId, guestId, sessionId: null, forceNew: true });
                }
            });
        }
    }


    // ==========================================
    // 3. TICKET FORM CUSTOM SELECT DROPDOWN LOGIC
    // ==========================================
    const wrapper = document.querySelector('.custom-select-wrapper');
    const customSelect = wrapper ? wrapper.querySelector('.custom-select') : null;
    const selectedText = wrapper ? wrapper.querySelector('.selected-text') : null;
    const options = wrapper ? wrapper.querySelectorAll('.custom-option') : [];
    const nativeSelect = document.getElementById('category');

    if (wrapper && customSelect && nativeSelect) {
        customSelect.addEventListener('click', function(e) {
            e.stopPropagation();
            wrapper.classList.toggle('open');
            this.style.borderColor = '';
            this.style.boxShadow = '';
        });

        options.forEach(option => {
            option.addEventListener('click', function(e) {
                e.stopPropagation();
                const value = this.getAttribute('data-value');
                const text = this.textContent;

                selectedText.textContent = text;
                selectedText.style.color = 'var(--white)';
                nativeSelect.value = value;

                options.forEach(opt => opt.classList.remove('selected'));
                this.classList.add('selected');
                wrapper.classList.remove('open');
            });
        });

        document.addEventListener('click', function(e) {
            if (!wrapper.contains(e.target)) {
                wrapper.classList.remove('open');
            }
        });
    }

    const ticketForm = document.getElementById('supportForm');
    const submitBtn = document.getElementById('submitBtn');

    if (ticketForm && submitBtn && nativeSelect) {
        ticketForm.addEventListener('submit', (e) => {
            if (!nativeSelect.value) {
                e.preventDefault();
                alert('Please select a support category from the dropdown menu.');
                if (customSelect) {
                    customSelect.style.borderColor = 'var(--red)';
                    customSelect.style.boxShadow = '0 0 10px rgba(229, 57, 53, 0.5)';
                }
            } else {
                submitBtn.disabled = true;
                submitBtn.style.opacity = '0.7';
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin" style="margin-right: 10px;"></i> Submitting...';
            }
        });
    }

    // Check URL parameters on load — only honour explicit query params, not leftover hashes
    const urlParams = new URLSearchParams(window.location.search);
    const hasTicketAlert = '<%= (typeof message !== "undefined" && message) || (typeof error !== "undefined" && error) ? "true" : "false" %>';

    if (hasTicketAlert === 'true' || urlParams.get('mode') === 'ticket') {
        showScreen('ticket');
    } else if (urlParams.get('mode') === 'chat' || urlParams.get('chat') === '1') {
        showScreen('chat');
    } else {
        // Clear any leftover hash so it doesn't persist
        if (window.location.hash) {
            history.replaceState(null, null, window.location.pathname + window.location.search);
        }
        showScreen('choice');
    }
});
</script>

<%- include('../partials/footer') %>