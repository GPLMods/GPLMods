<%- include('../../partials/header') %>

<%
    function formatBytes(bytes) {
        if (!bytes || bytes === 0) return '0 B';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function formatTimeAgo(date) {
        if (!date) return 'Recently';
        const seconds = Math.floor((new Date() - new Date(date)) / 1000);
        if (seconds < 5) return 'Just now';
        if (seconds < 60) return seconds + 's ago';
        const minutes = Math.floor(seconds / 60);
        if (minutes < 60) return minutes + 'm ago';
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return hours + 'h ago';
        const days = Math.floor(hours / 24);
        return days + 'd ago';
    }

    const memRss = (health && health.memoryUsage && health.memoryUsage.rss) ? health.memoryUsage.rss : 0;
    const memHeapUsed = (health && health.memoryUsage && health.memoryUsage.heapUsed) ? health.memoryUsage.heapUsed : 0;
    const memHeapTotal = (health && health.memoryUsage && health.memoryUsage.heapTotal) ? health.memoryUsage.heapTotal : 0;
    const memSysTotal = (health && health.memoryUsage && health.memoryUsage.systemTotal) ? health.memoryUsage.systemTotal : 0;
    const memPct = (health && health.memoryUsage && health.memoryUsage.percentage) ? health.memoryUsage.percentage : '0%';
    const heapPctNum = memHeapTotal > 0 ? ((memHeapUsed / memHeapTotal) * 100).toFixed(1) : '0';
    const rssPctNum = parseFloat(memPct) || 0;
%>

<style>
    .health-container {
        max-width: 1050px;
        margin: 3rem auto 5rem;
        padding: 2.2rem;
        background-color: var(--dark-gray, #12141c);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 20px 45px rgba(0,0,0,0.6);
    }
    
    .health-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 22px;
        margin-bottom: 28px;
        gap: 16px;
        flex-wrap: wrap;
    }

    .health-header-left {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .health-header h1 {
        color: var(--white);
        margin: 0;
        font-size: 2rem;
        display: flex;
        align-items: center;
        gap: 12px;
        letter-spacing: -0.5px;
    }

    .admin-status-shortcuts {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 8px;
    }

    .btn-stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: var(--silver, #bbb);
        padding: 6px 13px;
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-stat-pill:hover {
        background: rgba(255, 215, 0, 0.1);
        border-color: rgba(255, 215, 0, 0.3);
        color: var(--gold, #ffd700);
        text-decoration: none;
    }

    .btn-stat-pill.primary {
        background: rgba(255, 215, 0, 0.15);
        border-color: var(--gold, #ffd700);
        color: var(--gold, #ffd700);
    }
    
    /* Overall Status Badge */
    .status-badge {
        padding: 8px 22px;
        border-radius: 30px;
        font-weight: 700;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .status-UP {
        background-color: rgba(46, 204, 113, 0.12);
        color: #2ecc71;
        border: 1px solid rgba(46, 204, 113, 0.4);
        box-shadow: 0 0 15px rgba(46, 204, 113, 0.15);
    }
    .status-DEGRADED {
        background-color: rgba(255, 215, 0, 0.12);
        color: var(--gold, #ffd700);
        border: 1px solid rgba(255, 215, 0, 0.4);
        box-shadow: 0 0 15px rgba(255, 215, 0, 0.15);
    }
    .status-DOWN {
        background-color: rgba(229, 57, 53, 0.12);
        color: var(--red, #ff4d4f);
        border: 1px solid rgba(229, 57, 53, 0.4);
        box-shadow: 0 0 15px rgba(229, 57, 53, 0.15);
    }

    .section-title {
        color: var(--white);
        margin: 32px 0 16px 0;
        font-size: 1.25rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .section-title i {
        color: var(--gold, #ffd700);
        font-size: 1.1rem;
    }

    /* Grid Layouts */
    .system-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 18px;
        margin-bottom: 25px;
    }
    
    .info-card {
        background: #0d0f17;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
        padding: 18px 20px;
        position: relative;
        overflow: hidden;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }
    .info-card:hover {
        border-color: rgba(255, 215, 0, 0.25);
    }
    .info-card h3 {
        color: var(--silver, #888);
        font-size: 0.82rem;
        text-transform: uppercase;
        margin: 0 0 8px 0;
        letter-spacing: 1px;
        font-weight: 600;
    }
    .info-card .value {
        color: var(--white);
        font-size: 1.45rem;
        font-weight: 700;
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    }

    /* Memory Progress Bars */
    .memory-progress-track {
        background: rgba(255, 255, 255, 0.08);
        height: 6px;
        border-radius: 3px;
        overflow: hidden;
        margin-top: 10px;
        position: relative;
    }
    .memory-progress-fill {
        height: 100%;
        border-radius: 3px;
        transition: width 0.3s ease;
    }
    .memory-progress-fill.gold {
        background: linear-gradient(90deg, #ffd700, #ffb300);
        box-shadow: 0 0 8px rgba(255, 215, 0, 0.4);
    }
    .memory-progress-fill.cyan {
        background: linear-gradient(90deg, #00e5ff, #00b0ff);
        box-shadow: 0 0 8px rgba(0, 229, 255, 0.4);
    }
    .memory-submeta {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        color: var(--silver, #a0a6b8);
        margin-top: 6px;
        font-family: monospace;
    }
    
    /* Service Status List */
    .service-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 30px;
    }
    .service-item {
        background: #0d0f17;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
        padding: 18px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: border-color 0.2s ease;
    }
    .service-item:hover {
        border-color: rgba(255, 255, 255, 0.14);
    }
    .service-name {
        font-size: 1.05rem;
        color: var(--white);
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .service-details {
        color: var(--silver, #888);
        font-size: 0.85rem;
        font-family: 'SFMono-Regular', Consolas, monospace;
        margin-top: 4px;
        padding-left: 37px;
    }
    
    /* Indicator Dots */
    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 8px currentColor;
    }
    .dot-CONNECTED, .dot-CONFIGURED { background-color: #2ecc71; color: #2ecc71; }
    .dot-DISCONNECTED, .dot-ERROR { background-color: var(--red, #ff4d4f); color: var(--red, #ff4d4f); }
    .dot-UNKNOWN { background-color: var(--silver, #888); color: var(--silver, #888); }

    /* Key Buttons */
    .btn-diag-copy {
        padding: 7px 14px;
        font-size: 0.82rem;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: var(--white);
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 500;
        transition: all 0.2s ease;
    }
    .btn-diag-copy:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.3);
        color: var(--gold);
    }
    .btn-diag-rotate {
        padding: 7px 14px;
        font-size: 0.82rem;
        background: var(--gold);
        border: 1px solid var(--gold);
        color: #000;
        font-weight: 700;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }
    .btn-diag-rotate:hover {
        background: #ffe033;
        box-shadow: 0 0 12px rgba(255, 215, 0, 0.4);
    }

    /* DevTools Audit Logs Table */
    .audit-card {
        background: #0d0f17;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
        padding: 22px;
        margin-bottom: 35px;
    }
    .audit-table-wrapper {
        overflow-x: auto;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: #090a10;
        -webkit-overflow-scrolling: touch;
        margin-top: 14px;
    }
    .audit-table {
        width: 100%;
        min-width: 650px;
        border-collapse: collapse;
        font-size: 0.86rem;
        text-align: left;
    }
    .audit-table th {
        padding: 12px 14px;
        color: var(--silver, #a0a6b8);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.74rem;
        letter-spacing: 0.5px;
        background: rgba(255, 255, 255, 0.02);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .audit-table td {
        padding: 12px 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        vertical-align: middle;
    }
    .audit-table tr:last-child td {
        border-bottom: none;
    }
    .audit-table tr:hover td {
        background: rgba(255, 255, 255, 0.02);
    }

    /* Warnings Box */
    .warnings-box {
        background-color: rgba(229, 57, 53, 0.08);
        border: 1px solid rgba(229, 57, 53, 0.35);
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 30px;
    }
    .warnings-box h3 {
        color: #ff5252;
        margin: 0 0 10px 0;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1.1rem;
    }
    .warnings-list {
        margin: 0;
        padding-left: 20px;
        color: #ffb4b4;
        font-family: monospace;
        font-size: 0.9rem;
    }

    .btn-diag-refresh {
        background: transparent;
        border: 1px solid rgba(255, 215, 0, 0.4);
        color: var(--gold);
        padding: 10px 26px;
        border-radius: 25px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }
    .btn-diag-refresh:hover {
        background: rgba(255, 215, 0, 0.1);
        border-color: var(--gold);
        box-shadow: 0 0 15px rgba(255, 215, 0, 0.25);
    }

    .logo-gold-glow { color: var(--gold, #ffd700); text-shadow: 0 0 10px rgba(255, 215, 0, 0.45); }
    .logo-silver-glow { color: var(--silver, #ffffff); text-shadow: 0 0 10px rgba(192, 192, 192, 0.5); }

    @media (max-width: 680px) {
        .health-container {
            padding: 1.4rem;
            margin: 2rem auto;
        }
        
        .health-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }
        
        .health-header h1 {
            font-size: 1.6rem;
        }
        
        .service-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }

        .service-details {
            padding-left: 0;
        }
    }
</style>

<main class="container">
    <div class="health-container">
        
        <!-- Header -->
        <div class="health-header">
            <div class="health-header-left">
                <h1>
                    <span class="logo-gold-glow">GPL</span> <span class="logo-silver-glow">Mods</span>
                    <i class="fas fa-server" style="color: var(--gold); font-size: 0.9em;"></i> System Diagnostics
                </h1>
                <div class="admin-status-shortcuts">
                    <a href="/admin" class="btn-stat-pill"><i class="fas fa-sliders-h"></i> AdminJS</a>
                    <a href="/status" target="_blank" class="btn-stat-pill"><i class="fas fa-heartbeat"></i> Public Status</a>
                    <a href="/admin/reports" class="btn-stat-pill"><i class="fas fa-flag"></i> Reports</a>
                    <a href="/admin/support" class="btn-stat-pill"><i class="fas fa-headset"></i> Support</a>
                    <a href="/home" target="_blank" class="btn-stat-pill primary"><i class="fas fa-external-link-alt"></i> Live Site</a>
                </div>
            </div>

            <div class="status-badge status-<%= health.status %>">
                <i class="fas fa-circle" style="font-size: 0.65rem;"></i> System <%= health.status %>
            </div>
        </div>

        <!-- Node.js Runtime Environment Cards -->
        <h2 class="section-title"><i class="fas fa-microchip"></i> Node.js Runtime Environment</h2>
        <div class="system-grid">
            <div class="info-card">
                <h3>Server Uptime</h3>
                <div class="value"><%= health.uptime %></div>
            </div>
            <div class="info-card">
                <h3>Node Engine Version</h3>
                <div class="value"><%= health.nodeVersion %></div>
            </div>
            <div class="info-card">
                <h3>Runtime Environment</h3>
                <div class="value" <%- `style="color: ${health.environment === 'production' ? '#2ecc71' : 'var(--gold)'};"` %>><%= health.environment.toUpperCase() %></div>
            </div>
            <div class="info-card">
                <h3>Total RAM Allocated</h3>
                <div class="value"><%= formatBytes(memRss) %></div>
            </div>
        </div>

        <!-- Detailed Memory & Heap Telemetry -->
        <h2 class="section-title"><i class="fas fa-memory"></i> Memory & V8 Engine Allocation</h2>
        <div class="system-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
            
            <!-- Resident Set Size (RSS) Card -->
            <div class="info-card">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <h3>Process RSS (Allocated)</h3>
                    <span style="font-size: 0.78rem; color: var(--gold); font-family: monospace; font-weight: 600;"><%= memPct %> of RAM</span>
                </div>
                <div class="value" style="color: var(--gold);"><%= formatBytes(memRss) %></div>
                <div class="memory-progress-track">
                    <div class="memory-progress-fill gold" style="width: <%= Math.min(rssPctNum, 100) %>%;"></div>
                </div>
                <div class="memory-submeta">
                    <span>Server Total RAM: <%= formatBytes(memSysTotal) %></span>
                    <span>System Share: <%= memPct %></span>
                </div>
            </div>

            <!-- V8 Heap Usage Card -->
            <div class="info-card">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <h3>V8 Heap (Active JS Objects)</h3>
                    <span style="font-size: 0.78rem; color: #00e5ff; font-family: monospace; font-weight: 600;"><%= heapPctNum %>% used</span>
                </div>
                <div class="value" style="color: #00e5ff;"><%= formatBytes(memHeapUsed) %></div>
                <div class="memory-progress-track">
                    <div class="memory-progress-fill cyan" style="width: <%= Math.min(parseFloat(heapPctNum) || 0, 100) %>%;"></div>
                </div>
                <div class="memory-submeta">
                    <span>Heap Total: <%= formatBytes(memHeapTotal) %></span>
                    <span>Active Usage: <%= heapPctNum %>%</span>
                </div>
            </div>

        </div>

        <!-- Connected Services & Infrastructure -->
        <h2 class="section-title"><i class="fas fa-network-wired"></i> Connected Services & Infrastructure</h2>
        <div class="service-list">
            
            <!-- MongoDB Status -->
            <div class="service-item">
                <div>
                    <div class="service-name">
                        <i class="fas fa-database" style="color: #4DB33D; width: 25px; text-align: center;"></i> MongoDB Atlas Cluster
                    </div>
                    <div class="service-details"><%= health.services.database.details || 'Connection verified and active' %></div>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; font-weight: 700; color: var(--white); font-size: 0.9rem;">
                    <span class="dot dot-<%= health.services.database.status %>"></span>
                    <%= health.services.database.status %>
                </div>
            </div>

            <!-- Backblaze B2 Status -->
            <div class="service-item">
                <div>
                    <div class="service-name">
                        <i class="fas fa-cloud" style="color: #0088cc; width: 25px; text-align: center;"></i> Backblaze B2 Cloud Storage
                    </div>
                    <div class="service-details"><%= health.services.storage.details || 'Bucket authorized and operational' %></div>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; font-weight: 700; color: var(--white); font-size: 0.9rem;">
                    <span class="dot dot-<%= health.services.storage.status %>"></span>
                    <%= health.services.storage.status %>
                </div>
            </div>

            <!-- VirusTotal Status -->
            <div class="service-item">
                <div>
                    <div class="service-name">
                        <i class="fas fa-shield-virus" style="color: var(--gold); width: 25px; text-align: center;"></i> VirusTotal Security Engine
                    </div>
                    <div class="service-details"><%= health.services.virustotal.details || 'API endpoint verified' %></div>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; font-weight: 700; color: var(--white); font-size: 0.9rem;">
                    <span class="dot dot-<%= health.services.virustotal.status %>"></span>
                    <%= health.services.virustotal.status %>
                </div>
            </div>

        </div>

        <!-- ============================================== -->
        <!-- DEBUGGER & DEVTOOLS ACCESS CONTROL SECTION -->
        <!-- ============================================== -->
        <h2 class="section-title" style="margin-top: 38px;">
            <i class="fas fa-shield-alt" style="color: var(--gold);"></i> Debugger & DevTools Access Control
        </h2>

        <div class="system-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); margin-bottom: 25px;">
            <!-- Hourly Key Card -->
            <div class="info-card" style="border-left: 3px solid var(--gold);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <h3>Hourly Single-Use Key</h3>
                    <span style="font-size: 0.75em; background: rgba(255,215,0,0.15); color: var(--gold); border: 1px solid var(--gold); padding: 2px 8px; border-radius: 12px; font-weight: bold;">
                        Auto-Rotates
                    </span>
                </div>
                <div class="value" id="statusDebuggerKey" style="color: var(--gold); font-size: 1.5em; letter-spacing: 2px; margin-bottom: 12px;">
                    <%= typeof debuggerKey !== 'undefined' ? debuggerKey : 'N/A' %>
                </div>
                <p style="font-size: 0.8em; color: var(--silver); margin: 0 0 14px 0; line-height: 1.4;">
                    10–12 digit single-use code. Auto-regenerates upon use or every 60 minutes.
                </p>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    <button type="button" class="btn-diag-copy" onclick="copyKeyText('statusDebuggerKey', this)">
                        <i class="fas fa-copy"></i> Copy Key
                    </button>
                    <button type="button" id="btnAdminGenKey" class="btn-diag-rotate" onclick="adminGenerateNewKey(this)">
                        <i class="fas fa-sync-alt"></i> Rotate Key Now
                    </button>
                </div>
            </div>

            <!-- Master Key Card -->
            <div class="info-card" style="border-left: 3px solid #ff3366;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <h3>Master Access Key</h3>
                    <span style="font-size: 0.75em; background: rgba(255,51,102,0.15); color: #ff6688; border: 1px solid #ff3366; padding: 2px 8px; border-radius: 12px; font-weight: bold;">
                        Permanent
                    </span>
                </div>
                <div class="value" id="statusMasterKey" style="color: #ff3366; font-size: 1.3em; letter-spacing: 1px; margin-bottom: 12px;">
                    <%= typeof debuggerMasterKey !== 'undefined' ? debuggerMasterKey : 'T1BBZG1pbkAyMDI2' %>
                </div>
                <p style="font-size: 0.8em; color: var(--silver); margin: 0 0 14px 0; line-height: 1.4;">
                    Permanent master key for administrators. Multi-use, never expires.
                </p>
                <button type="button" class="btn-diag-copy" onclick="copyKeyText('statusMasterKey', this)">
                    <i class="fas fa-copy"></i> Copy Master Key
                </button>
            </div>
        </div>

        <!-- Recent DevTools Incidents Table -->
        <div class="audit-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; flex-wrap: wrap; gap: 8px;">
                <h3 style="color: var(--white); margin: 0; font-size: 1.05em; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-history" style="color: var(--gold);"></i> DevTools Inspection Audit Logs
                </h3>
                <span style="font-size: 0.8em; color: var(--silver); background: rgba(255,255,255,0.05); padding: 3px 10px; border-radius: 12px;">Last 10 Events</span>
            </div>

            <% if (typeof recentDevtoolLogs !== 'undefined' && recentDevtoolLogs && recentDevtoolLogs.length > 0) { %>
                <div class="audit-table-wrapper">
                    <table class="audit-table">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>User / IP</th>
                                <th>Page Path</th>
                                <th>Trigger</th>
                                <th style="text-align: right;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentDevtoolLogs.forEach(log => { %>
                                <tr>
                                    <td style="color: var(--silver); white-space: nowrap;"><%= formatTimeAgo(log.createdAt) %></td>
                                    <td style="color: var(--white);">
                                        <strong><%= log.username || 'Guest' %></strong>
                                        <div style="font-size: 0.8em; color: #777;"><%= log.ip || 'Unknown IP' %></div>
                                    </td>
                                    <td style="color: var(--gold); font-family: monospace;"><%= log.path || '/' %></td>
                                    <td style="color: var(--silver);"><%= log.triggerType %></td>
                                    <td style="text-align: right; white-space: nowrap;">
                                        <% if (log.status === 'blocked') { %>
                                            <span style="color: #ff4d4d; background: rgba(255,77,77,0.12); border: 1px solid rgba(255,77,77,0.3); padding: 3px 8px; border-radius: 4px; font-weight: bold;">Blocked</span>
                                        <% } else if (log.status === 'authorized-by-code') { %>
                                            <span style="color: #2ecc71; background: rgba(46,204,113,0.12); border: 1px solid rgba(46,204,113,0.3); padding: 3px 8px; border-radius: 4px; font-weight: bold;">Unlocked (Code)</span>
                                        <% } else if (log.status === 'authorized-by-master-key') { %>
                                            <span style="color: #64b5f6; background: rgba(33,150,243,0.12); border: 1px solid rgba(33,150,243,0.3); padding: 3px 8px; border-radius: 4px; font-weight: bold;">Unlocked (Master)</span>
                                        <% } else { %>
                                            <span style="color: #aaa;"><%= log.status %></span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p style="color: #666; font-size: 0.9em; margin: 0; text-align: center; padding: 25px 0;">No developer tools inspection incidents recorded yet.</p>
            <% } %>
        </div>

        <!-- Render Warnings if they exist -->
        <% if (health.warnings && health.warnings.length > 0) { %>
            <div class="warnings-box">
                <h3><i class="fas fa-exclamation-triangle"></i> System Warnings Detected (<%= health.warnings.length %>)</h3>
                <ul class="warnings-list">
                    <% health.warnings.forEach(warning => { %>
                        <li><%= warning %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <div style="text-align: center; margin-top: 30px;">
            <button onclick="refreshDiagnosticsPage(this)" class="btn-diag-refresh">
                <i class="fas fa-sync-alt" id="refreshSpinner"></i> Refresh Diagnostics
            </button>
            <p style="color: #666; font-size: 0.8em; margin-top: 15px;">Last checked: <%= new Date(health.timestamp).toLocaleTimeString() %></p>
        </div>

    </div>
</main>

<script>
    function copyKeyText(elementId, btn) {
        const el = document.getElementById(elementId);
        if (!el) return;
        const text = el.innerText.trim();
        navigator.clipboard.writeText(text).then(() => {
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
            if (typeof window.showGplToast === 'function') {
                window.showGplToast('Key copied to clipboard!', 'success');
            }
            setTimeout(() => { btn.innerHTML = originalHtml; }, 1800);
        }).catch(() => {
            if (typeof window.showGplToast === 'function') {
                window.showGplToast('Key: ' + text, 'info');
            }
        });
    }

    async function adminGenerateNewKey(btn) {
        btn.disabled = true;
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Rotating...';

        try {
            const res = await fetch('/api/admin/debugger/generate-key', { method: 'POST' });
            const data = await res.json();
            if (data.success && data.key) {
                document.getElementById('statusDebuggerKey').innerText = data.key;
                btn.innerHTML = '<i class="fas fa-check"></i> Rotated!';
                if (typeof window.showGplToast === 'function') {
                    window.showGplToast('Debugger key rotated successfully!', 'success');
                }
                setTimeout(() => { btn.innerHTML = originalHtml; btn.disabled = false; }, 2000);
            } else {
                if (typeof window.showGplToast === 'function') {
                    window.showGplToast(data.message || 'Failed to generate key.', 'error');
                }
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
        } catch (e) {
            if (typeof window.showGplToast === 'function') {
                window.showGplToast('Error generating key.', 'error');
            }
            btn.innerHTML = originalHtml;
            btn.disabled = false;
        }
    }

    function refreshDiagnosticsPage(btn) {
        const spinner = document.getElementById('refreshSpinner');
        if (spinner) spinner.classList.add('fa-spin');
        if (btn) btn.disabled = true;
        setTimeout(() => {
            window.location.reload();
        }, 300);
    }
</script>

<%- include('../../partials/footer') %>