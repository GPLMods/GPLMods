<%- include('../../partials/header') %>

<style>
    .health-container { max-width: 900px; margin: 4rem auto; padding: 2rem; background-color: var(--dark-gray); border-radius: 15px; border: 1px solid #333; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    
    .health-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #333; padding-bottom: 20px; margin-bottom: 30px; }
    .health-header h1 { color: var(--white); margin: 0; font-size: 2.2em; display: flex; align-items: center; gap: 15px; }
    
    /* Overall Status Badge */
    .status-badge { padding: 8px 20px; border-radius: 25px; font-weight: bold; font-size: 1.1em; text-transform: uppercase; letter-spacing: 1px; }
    .status-UP { background-color: rgba(46, 204, 113, 0.15); color: #2ecc71; border: 1px solid #2ecc71; }
    .status-DEGRADED { background-color: rgba(255, 215, 0, 0.15); color: var(--gold); border: 1px solid var(--gold); }
    .status-DOWN { background-color: rgba(229, 57, 53, 0.15); color: var(--red); border: 1px solid var(--red); }

    /* Grid Layouts */
    .system-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 40px; }
    
    .info-card { background: var(--black); border: 1px solid #222; border-radius: 10px; padding: 20px; }
    .info-card h3 { color: var(--silver); font-size: 0.9em; text-transform: uppercase; margin-bottom: 10px; letter-spacing: 1px; }
    .info-card .value { color: var(--white); font-size: 1.4em; font-family: monospace; }
    
    /* Service Status List */
    .service-list { display: flex; flex-direction: column; gap: 15px; margin-bottom: 40px; }
    .service-item { background: var(--black); border: 1px solid #222; border-radius: 10px; padding: 20px; display: flex; justify-content: space-between; align-items: center; }
    .service-name { font-size: 1.2em; color: var(--white); font-weight: bold; display: flex; align-items: center; gap: 10px; }
    .service-details { color: var(--silver); font-size: 0.9em; font-family: monospace; }
    
    /* Indicator Dots */
    .dot { width: 12px; height: 12px; border-radius: 50%; display: inline-block; box-shadow: 0 0 10px currentColor; }
    .dot-CONNECTED, .dot-CONFIGURED { background-color: #2ecc71; color: #2ecc71; }
    .dot-DISCONNECTED, .dot-ERROR { background-color: var(--red); color: var(--red); }
    .dot-UNKNOWN { background-color: var(--silver); color: var(--silver); }

    /* Warnings Box */
    .warnings-box { background-color: rgba(229, 57, 53, 0.1); border: 1px solid var(--red); border-radius: 10px; padding: 20px; }
     .warnings-box h3 { color: var(--red); margin-top: 0; display: flex; align-items: center; gap: 10px; }
    .warnings-list { margin: 0; padding-left: 20px; color: #ffadad; font-family: monospace; }

    /* ======== ADD THIS RESPONSIVE FIX ======== */
    @media (max-width: 600px) {
        .health-container {
            padding: 1.5rem; /* Slightly smaller padding on mobile */
            margin: 2rem auto;
        }
        
        .health-header {
            flex-direction: column; /* Stack the title and the badge vertically */
            align-items: flex-start; /* Align them to the left */
            gap: 15px; /* Add some space between them */
        }
        
        .health-header h1 {
            font-size: 1.8em; /* Make the title slightly smaller to fit better */
        }
        
        /* Make the service items stack vertically on very small screens */
        .service-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
    }
</style>

<main class="container">
    <div class="health-container">
        
        <div class="health-header">
            <h1><i class="fas fa-server" style="color: var(--gold);"></i> System Diagnostics</h1>
            <div class="status-badge status-<%= health.status %>">
                System <%= health.status %>
            </div>
        </div>

        <h2 style="color: var(--white); margin-bottom: 15px; font-size: 1.3em;">Node.js Environment</h2>
        <div class="system-grid">
            <div class="info-card">
                <h3>Server Uptime</h3>
                <div class="value"><%= health.uptime %></div>
            </div>
            <div class="info-card">
                <h3>Memory Usage (RSS)</h3>
                <div class="value"><%= formatBytes(health.memoryUsage.rss) %></div>
            </div>
            <div class="info-card">
                <h3>Node Version</h3>
                <div class="value"><%= health.nodeVersion %></div>
            </div>
            <div class="info-card">
                <h3>Environment</h3>
                <div class="value" style="color: <%= health.environment === 'production' ? '#2ecc71' : 'var(--gold)' %>;"><%= health.environment.toUpperCase() %></div>
            </div>
        </div>

        <h2 style="color: var(--white); margin-bottom: 15px; font-size: 1.3em;">External Services</h2>
        <div class="service-list">
            
            <!-- MongoDB Status -->
            <div class="service-item">
                <div>
                    <div class="service-name">
                        <i class="fas fa-database" style="color: #4DB33D; width: 25px;"></i> MongoDB Atlas
                    </div>
                    <div class="service-details"><%= health.services.database.details || 'No details available' %></div>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; font-weight: bold; color: var(--white);">
                    <span class="dot dot-<%= health.services.database.status %>"></span>
                    <%= health.services.database.status %>
                </div>
            </div>

            <!-- Backblaze B2 Status -->
            <div class="service-item">
                <div>
                    <div class="service-name">
                        <i class="fas fa-cloud" style="color: #0088cc; width: 25px;"></i> Backblaze B2
                    </div>
                    <div class="service-details"><%= health.services.storage.details || 'Connection check failed' %></div>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; font-weight: bold; color: var(--white);">
                    <span class="dot dot-<%= health.services.storage.status %>"></span>
                    <%= health.services.storage.status %>
                </div>
            </div>

            <!-- VirusTotal Status -->
            <div class="service-item">
                <div>
                    <div class="service-name">
                        <i class="fas fa-shield-virus" style="color: var(--gold); width: 25px;"></i> VirusTotal API
                    </div>
                    <div class="service-details"><%= health.services.virustotal.details %></div>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; font-weight: bold; color: var(--white);">
                    <span class="dot dot-<%= health.services.virustotal.status %>"></span>
                    <%= health.services.virustotal.status %>
                </div>
            </div>

        </div>

        <!-- ============================================== -->
        <!-- DEBUGGER & DEVTOOLS ACCESS CONTROL SECTION -->
        <!-- ============================================== -->
        <h2 style="color: var(--white); margin: 35px 0 15px 0; font-size: 1.3em; display: flex; align-items: center; gap: 10px;">
            <i class="fas fa-shield-alt" style="color: #ff3366;"></i> Debugger & DevTools Access Control
        </h2>

        <div class="system-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); margin-bottom: 25px;">
            <!-- Hourly Key Card -->
            <div class="info-card" style="border-left: 3px solid var(--gold);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <h3>Hourly Single-Use Key</h3>
                    <span style="font-size: 0.75em; background: rgba(255,215,0,0.15); color: var(--gold); border: 1px solid var(--gold); padding: 2px 8px; border-radius: 12px; font-weight: bold;">
                        Auto-Rotates
                    </span>
                </div>
                <div class="value" id="statusDebuggerKey" style="color: var(--gold); font-size: 1.5em; letter-spacing: 2px; margin-bottom: 12px;">
                    <%= typeof debuggerKey !== 'undefined' ? debuggerKey : 'N/A' %>
                </div>
                <p style="font-size: 0.8em; color: var(--silver); margin: 0 0 14px 0;">
                    10–12 digit single-use code. Auto-regenerates upon use or every 60 minutes.
                </p>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    <button type="button" class="btn btn-secondary" onclick="copyKeyText('statusDebuggerKey', this)" style="padding: 6px 12px; font-size: 0.85em; background: #222; border: 1px solid #444; color: #fff; border-radius: 6px; cursor: pointer;">
                        <i class="fas fa-copy"></i> Copy Key
                    </button>
                    <button type="button" id="btnAdminGenKey" onclick="adminGenerateNewKey(this)" style="padding: 6px 12px; font-size: 0.85em; background: var(--gold); border: none; color: #000; font-weight: 700; border-radius: 6px; cursor: pointer;">
                        <i class="fas fa-sync-alt"></i> Generate New Key
                    </button>
                </div>
            </div>

            <!-- Master Key Card -->
            <div class="info-card" style="border-left: 3px solid #ff3366;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <h3>Master Access Key</h3>
                    <span style="font-size: 0.75em; background: rgba(255,51,102,0.15); color: #ff6688; border: 1px solid #ff3366; padding: 2px 8px; border-radius: 12px; font-weight: bold;">
                        Permanent
                    </span>
                </div>
                <div class="value" id="statusMasterKey" style="color: #ff3366; font-size: 1.3em; letter-spacing: 1px; margin-bottom: 12px;">
                    <%= typeof debuggerMasterKey !== 'undefined' ? debuggerMasterKey : 'OPAdmin@2026' %>
                </div>
                <p style="font-size: 0.8em; color: var(--silver); margin: 0 0 14px 0;">
                    Permanent master key for administrators. Multi-use, never expires.
                </p>
                <button type="button" class="btn btn-secondary" onclick="copyKeyText('statusMasterKey', this)" style="padding: 6px 12px; font-size: 0.85em; background: #222; border: 1px solid #444; color: #fff; border-radius: 6px; cursor: pointer;">
                    <i class="fas fa-copy"></i> Copy Master Key
                </button>
            </div>
        </div>

        <!-- Recent DevTools Incidents Table -->
        <div style="background: var(--black); border: 1px solid #222; border-radius: 10px; padding: 20px; margin-bottom: 40px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <h3 style="color: var(--white); margin: 0; font-size: 1.05em; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-history" style="color: var(--gold);"></i> Recent DevTools Inspection Audit Logs
                </h3>
                <span style="font-size: 0.8em; color: var(--silver);">Last 10 Events</span>
            </div>

            <% if (typeof recentDevtoolLogs !== 'undefined' && recentDevtoolLogs && recentDevtoolLogs.length > 0) { %>
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.85em; text-align: left;">
                        <thead>
                            <tr style="border-bottom: 1px solid #333; color: var(--silver);">
                                <th style="padding: 8px;">Time</th>
                                <th style="padding: 8px;">User / IP</th>
                                <th style="padding: 8px;">Page Path</th>
                                <th style="padding: 8px;">Trigger</th>
                                <th style="padding: 8px; text-align: right;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentDevtoolLogs.forEach(log => { %>
                                <tr style="border-bottom: 1px solid #1a1a1a;">
                                    <td style="padding: 8px; color: var(--silver);"><%= timeAgo(log.createdAt) %></td>
                                    <td style="padding: 8px; color: var(--white);">
                                        <strong><%= log.username || 'Guest' %></strong>
                                        <div style="font-size: 0.8em; color: #777;"><%= log.ip || 'Unknown IP' %></div>
                                    </td>
                                    <td style="padding: 8px; color: var(--gold); font-family: monospace;"><%= log.path || '/' %></td>
                                    <td style="padding: 8px; color: var(--silver);"><%= log.triggerType %></td>
                                    <td style="padding: 8px; text-align: right;">
                                        <% if (log.status === 'blocked') { %>
                                            <span style="color: #ff4d4d; background: rgba(255,77,77,0.1); padding: 3px 8px; border-radius: 4px; font-weight: bold;">Blocked</span>
                                        <% } else if (log.status === 'authorized-by-code') { %>
                                            <span style="color: #2ecc71; background: rgba(46,204,113,0.1); padding: 3px 8px; border-radius: 4px; font-weight: bold;">Unlocked (Code)</span>
                                        <% } else if (log.status === 'authorized-by-master-key') { %>
                                            <span style="color: #64b5f6; background: rgba(33,150,243,0.1); padding: 3px 8px; border-radius: 4px; font-weight: bold;">Unlocked (Master)</span>
                                        <% } else { %>
                                            <span style="color: #aaa;"><%= log.status %></span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p style="color: #666; font-size: 0.9em; margin: 0; text-align: center; padding: 20px;">No developer tools inspection incidents recorded yet.</p>
            <% } %>
        </div>

        <!-- Render Warnings if they exist -->
        <% if (health.warnings.length > 0) { %>
            <div class="warnings-box">
                <h3><i class="fas fa-exclamation-triangle"></i> System Warnings Detected (<%= health.warnings.length %>)</h3>
                <ul class="warnings-list">
                    <% health.warnings.forEach(warning => { %>
                        <li><%= warning %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <div style="text-align: center; margin-top: 30px;">
            <button onclick="window.location.reload();" class="btn btn-secondary" style="background: transparent; border: 2px solid #555; color: var(--silver); padding: 10px 25px; border-radius: 20px; cursor: pointer;">
                <i class="fas fa-sync-alt" style="margin-right: 8px;"></i> Refresh Diagnostics
            </button>
            <p style="color: #666; font-size: 0.8em; margin-top: 15px;">Last checked: <%= new Date(health.timestamp).toLocaleTimeString() %></p>
        </div>

    </div>
</main>

<script>
    function copyKeyText(elementId, btn) {
        const el = document.getElementById(elementId);
        if (!el) return;
        const text = el.innerText.trim();
        navigator.clipboard.writeText(text).then(() => {
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
            setTimeout(() => { btn.innerHTML = originalHtml; }, 1800);
        }).catch(() => {
            alert('Key: ' + text);
        });
    }

    async function adminGenerateNewKey(btn) {
        btn.disabled = true;
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';

        try {
            const res = await fetch('/api/admin/debugger/generate-key', { method: 'POST' });
            const data = await res.json();
            if (data.success && data.key) {
                document.getElementById('statusDebuggerKey').innerText = data.key;
                btn.innerHTML = '<i class="fas fa-check"></i> Key Rotated!';
                setTimeout(() => { btn.innerHTML = originalHtml; btn.disabled = false; }, 2000);
            } else {
                alert('Failed to generate key.');
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
        } catch (e) {
            alert('Error generating key.');
            btn.innerHTML = originalHtml;
            btn.disabled = false;
        }
    }
</script>

<%- include('../../partials/footer') %>