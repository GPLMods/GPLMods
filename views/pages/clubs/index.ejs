<style>
    #floating-music-player {
        display: none !important;
    }
    .clubs-page-hero {
        background: radial-gradient(circle at 50% 0%, rgba(255, 215, 0, 0.12) 0%, rgba(20, 20, 25, 0.95) 75%), #0c0d12;
        border-bottom: 1px solid rgba(255, 215, 0, 0.15);
        padding: 50px 20px 40px;
        text-align: center;
        position: relative;
    }
    .clubs-hero-title {
        font-size: 2.8rem;
        font-weight: 800;
        margin-bottom: 12px;
        letter-spacing: -0.5px;
    }
    .clubs-hero-subtitle {
        color: var(--silver);
        font-size: 1.15rem;
        max-width: 720px;
        margin: 0 auto 30px;
        line-height: 1.6;
    }
    .clubs-hero-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
    }
    .btn-create-club {
        background: linear-gradient(135deg, var(--gold) 0%, #d4af37 100%);
        color: #000 !important;
        font-weight: 700;
        padding: 12px 28px;
        border-radius: 30px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 4px 18px rgba(255, 215, 0, 0.35);
        transition: all 0.25s ease;
    }
    .btn-create-club:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(255, 215, 0, 0.5);
    }
    .btn-explore-default {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 215, 0, 0.3);
        color: var(--gold) !important;
        font-weight: 600;
        padding: 12px 26px;
        border-radius: 30px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.25s ease;
    }
    .btn-explore-default:hover {
        background: rgba(255, 215, 0, 0.15);
        transform: translateY(-2px);
    }

    /* Filter Bar Container */
    .clubs-filter-card {
        background: linear-gradient(145deg, #181924 0%, #0f1017 100%);
        border: 1px solid rgba(255, 215, 0, 0.22);
        border-radius: 18px;
        padding: 22px 24px;
        margin: -25px auto 40px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.05);
        position: relative;
        z-index: 10;
    }
    .clubs-filter-form {
        display: grid;
        grid-template-columns: 2fr 1.1fr 1.2fr 1.3fr 1.2fr auto;
        gap: 14px;
        align-items: flex-end;
    }
    .filter-input-group label {
        display: block;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: var(--silver);
        margin-bottom: 6px;
        font-weight: 600;
    }
    .filter-input-group input {
        width: 100%;
        background: #0d0e12;
        border: 1px solid #333645;
        border-radius: 10px;
        color: #fff;
        padding: 11px 14px;
        font-size: 0.95rem;
        outline: none;
        height: 44px;
        box-sizing: border-box;
        transition: border-color 0.25s ease;
    }
    .filter-input-group input:focus {
        border-color: var(--gold);
        box-shadow: 0 0 10px rgba(255, 215, 0, 0.2);
    }

    /* Custom Dropdown UI (Reused from Club Creation) */
    .filter-input-group.dropdown-group {
        position: relative;
    }
    .custom-select-wrapper {
        position: relative;
        user-select: none;
        width: 100%;
    }
    .custom-select-wrapper.open {
        z-index: 1050 !important;
    }
    .filter-input-group.dropdown-group.is-open {
        z-index: 1050 !important;
    }
    .custom-select {
        background-color: rgba(18, 19, 27, 0.85);
        border: 1.5px solid rgba(255, 215, 0, 0.25);
        border-radius: 10px;
        padding: 0 14px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4), 0 4px 10px rgba(0, 0, 0, 0.4);
        box-sizing: border-box;
    }
    .custom-select:hover {
        border-color: rgba(255, 215, 0, 0.5);
    }
    .custom-select-wrapper.open .custom-select {
        border-color: var(--gold);
        box-shadow: 0 0 12px rgba(255, 215, 0, 0.25);
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
    }
    .custom-select-text {
        color: #fff;
        font-size: 0.92rem;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
        min-width: 0;
    }
    .custom-select-text span,
    .custom-select-text .opt-label,
    .custom-select-text .text-label {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .custom-select-arrow {
        color: var(--silver);
        font-size: 0.8rem;
        transition: transform 0.3s ease;
        flex-shrink: 0;
        margin-left: 8px;
    }
    .custom-select-wrapper.open .custom-select-arrow {
        transform: rotate(180deg);
        color: var(--gold);
    }
    .custom-options {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #14151e;
        border: 1px solid var(--gold);
        border-top: none;
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.85);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition: all 0.25s ease;
        z-index: 1100;
        max-height: 250px;
        overflow-y: auto;
    }
    .custom-select-wrapper.open .custom-options {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    .custom-option {
        padding: 10px 14px;
        color: var(--silver);
        font-size: 0.9rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: background 0.2s, color 0.2s;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .custom-option:last-child {
        border-bottom: none;
    }
    .custom-option:hover {
        background-color: rgba(255, 215, 0, 0.12);
        color: var(--gold);
    }
    .custom-option.selected {
        background-color: rgba(255, 215, 0, 0.18);
        color: var(--gold);
        font-weight: 700;
    }
    .custom-option i {
        width: 18px;
        text-align: center;
        flex-shrink: 0;
    }
    .custom-option .fi {
        flex-shrink: 0;
    }
    .custom-option span.opt-label {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .filter-submit-btn {
        background: var(--gold);
        color: #000;
        font-weight: 700;
        border: none;
        border-radius: 10px;
        padding: 12px 26px;
        height: 44px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }
    .filter-submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(255, 215, 0, 0.35);
    }

    /* Popular Tag Chips */
    .popular-tags-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        overflow-x: auto;
        padding-bottom: 4px;
    }
    .tag-chip {
        font-size: 0.8rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid #333645;
        color: #bbb;
        padding: 5px 12px;
        border-radius: 20px;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.2s;
    }
    .tag-chip:hover, .tag-chip.active {
        background: rgba(255, 215, 0, 0.15);
        border-color: var(--gold);
        color: var(--gold);
    }

    /* Clubs Grid */
    .clubs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
        gap: 26px;
        margin-bottom: 60px;
    }
    .club-card {
        background: #14151b;
        border: 1px solid #282a36;
        border-radius: 18px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
        position: relative;
    }
    .club-card:hover {
        transform: translateY(-5px);
        border-color: rgba(255, 215, 0, 0.45);
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.6);
    }
    .club-card-banner {
        height: 120px;
        background-color: #1f2029;
        position: relative;
    }
    .club-card-banner-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
    }
    .club-card-banner::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(20,21,27,0.95) 100%);
        z-index: 1;
    }
    .club-card-badges {
        position: absolute;
        top: 12px;
        right: 12px;
        display: flex;
        gap: 6px;
        z-index: 2;
    }
    .badge-pill {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        padding: 4px 10px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .badge-default { background: rgba(255, 215, 0, 0.2); color: var(--gold); border: 1px solid var(--gold); }
    .badge-private { background: rgba(244, 67, 54, 0.2); color: #ff6b6b; border: 1px solid #ff6b6b; }
    .badge-public { background: rgba(76, 175, 80, 0.2); color: #69f0ae; border: 1px solid #69f0ae; }

    .club-card-avatar-wrap {
        position: absolute;
        bottom: -28px;
        left: 20px;
        z-index: 3;
    }
    .club-card-avatar {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        border: 3px solid #14151b;
        background: #0d0e12;
        object-fit: cover;
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.5);
    }

    .club-card-body {
        padding: 38px 20px 20px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }
    .club-card-name {
        font-size: 1.3rem;
        font-weight: 700;
        color: #fff;
        margin: 0 0 6px 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .club-card-desc {
        color: #a4a9b6;
        font-size: 0.9rem;
        line-height: 1.5;
        margin: 0 0 16px 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex-grow: 1;
    }
    .club-tags-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 18px;
    }
    .club-tag-pill {
        font-size: 0.72rem;
        background: #1b1c24;
        border: 1px solid #2e3040;
        color: var(--silver);
        padding: 3px 9px;
        border-radius: 12px;
    }

    .club-card-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 14px;
        border-top: 1px solid #232530;
        font-size: 0.85rem;
        color: var(--silver);
    }
    .club-meta-stat {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .club-card-actions {
        display: flex;
        gap: 10px;
        margin-top: 16px;
    }
    .btn-enter-club {
        flex: 1;
        background: var(--gold);
        color: #000;
        font-weight: 700;
        text-align: center;
        padding: 10px 16px;
        border-radius: 12px;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    .btn-enter-club:hover {
        background: #ffe066;
        transform: translateY(-2px);
    }
    .btn-share-club {
        background: #1f2029;
        border: 1px solid #333645;
        color: var(--silver);
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .btn-share-club:hover {
        border-color: var(--gold);
        color: var(--gold);
        transform: translateY(-2px);
    }

    @media (max-width: 1200px) {
        .clubs-filter-form {
            grid-template-columns: 1.5fr 1fr 1fr;
        }
    }
    @media (max-width: 768px) {
        .clubs-filter-form {
            grid-template-columns: 1fr 1fr;
        }
    }
    @media (max-width: 520px) {
        .clubs-filter-form {
            grid-template-columns: 1fr;
        }
        .clubs-hero-title {
            font-size: 2.1rem;
        }
    }
</style>

<section class="clubs-page-hero">
    <div class="container">
        <!-- ======== DYNAMIC GO BACK BUTTON ======== -->
        <%- include('../../partials/go-back-button', { fallback: '/' }) %>
        <!-- ======================================== -->

        <h1 class="clubs-hero-title"><span class="logo-gold-glow">GPLMods</span> <span class="logo-silver-glow">Clubs &amp; Communities</span></h1>
        <p class="clubs-hero-subtitle">
            Join distributor updates, creator guilds, platform channels, and live text chats. Connect directly with top mod developers, participate in polls, and track updates in real-time.
        </p>

        <div class="clubs-hero-actions">
            <% if (user) { %>
                <a href="/clubs/create" class="btn-create-club">
                    <i class="fas fa-plus-circle"></i> Create Your Own Club
                    <% if (typeof userCreatedCount !== 'undefined' && typeof userClubCap !== 'undefined') { %>
                        <span style="font-size: 0.78rem; opacity: 0.9; margin-left: 6px; font-weight: 600; padding: 2px 7px; border-radius: 10px; background: rgba(0,0,0,0.3);">(<%= userCreatedCount %>/<%= userClubCap %>)</span>
                    <% } %>
                </a>
            <% } else { %>
                <a href="/login?redirect=/clubs/create" class="btn-create-club">
                    <i class="fas fa-plus-circle"></i> Login to Create a Club
                </a>
            <% } %>

            <a href="/clubs/gpl-community" class="btn-explore-default">
                <i class="fas fa-users"></i> Visit GPL Community (Official Hub)
            </a>
        </div>
    </div>
</section>

<main class="container">
    <!-- Filter Card -->
    <div class="clubs-filter-card">
        <form action="/clubs" method="GET" class="clubs-filter-form">
            <div class="filter-input-group">
                <label for="filter-q"><i class="fas fa-search"></i> Search Clubs or ID</label>
                <input type="text" id="filter-q" name="q" placeholder="Search by name, tag, or club ID..." value="<%= filters.q %>" autocomplete="off">
            </div>

            <div class="filter-input-group">
                <label for="filter-tag"><i class="fas fa-tag"></i> Tag</label>
                <input type="text" id="filter-tag" name="tag" placeholder="e.g. Gaming, Android" value="<%= filters.tag %>">
            </div>

            <div class="filter-input-group dropdown-group">
                <label><i class="fas fa-lock"></i> Access</label>
                <div class="custom-select-wrapper" id="wrapper-filter-access">
                    <% 
                        const accessOptions = [
                            { value: 'all', label: 'All Clubs', icon: 'fa-layer-group', color: 'var(--gold)' },
                            { value: 'public', label: 'Public (Instant Join)', icon: 'fa-globe', color: '#69f0ae' },
                            { value: 'private', label: 'Private (Approval Needed)', icon: 'fa-lock', color: '#ff8a80' }
                        ];
                        const curAccess = filters.access || 'all';
                        const curAccessObj = accessOptions.find(o => o.value === curAccess) || accessOptions[0];
                    %>
                    <div class="custom-select">
                        <span class="custom-select-text">
                            <i class="fas <%= curAccessObj.icon %>" style="color: <%= curAccessObj.color %>;"></i>
                            <span class="text-label"><%= curAccessObj.label %></span>
                        </span>
                        <i class="fas fa-chevron-down custom-select-arrow"></i>
                    </div>
                    <div class="custom-options">
                        <% accessOptions.forEach(opt => { %>
                            <div class="custom-option <%= (curAccess === opt.value) ? 'selected' : '' %>" data-value="<%= opt.value %>">
                                <i class="fas <%= opt.icon %>" style="color: <%= opt.color %>;"></i>
                                <span class="opt-label"><%= opt.label %></span>
                            </div>
                        <% }); %>
                    </div>
                    <input type="hidden" id="filter-access" name="access" value="<%= curAccess %>">
                </div>
            </div>

            <div class="filter-input-group dropdown-group">
                <label><i class="fas fa-globe-americas"></i> Country</label>
                <div class="custom-select-wrapper" id="wrapper-filter-country">
                    <% 
                        const curCountryFilter = filters.country || 'all';
                        let curCountryFilterObj = null;
                        if (curCountryFilter !== 'all') {
                            curCountryFilterObj = countryDataRaw.find(c => c.code === curCountryFilter || c.name === curCountryFilter);
                        }
                    %>
                    <div class="custom-select">
                        <span class="custom-select-text">
                            <% if (curCountryFilterObj) { %>
                                <% if (curCountryFilterObj.code !== 'GLOBAL') { %>
                                    <span class="fi fi-<%= curCountryFilterObj.code.toLowerCase() %>" style="border-radius: 2px; flex-shrink: 0;"></span>
                                <% } else { %>
                                    <i class="fas fa-globe" style="color: var(--gold); flex-shrink: 0;"></i>
                                <% } %>
                                <span class="text-label"><%= curCountryFilterObj.name %></span>
                            <% } else { %>
                                <i class="fas fa-globe-americas" style="color: var(--gold); flex-shrink: 0;"></i>
                                <span class="text-label">All Regions</span>
                            <% } %>
                        </span>
                        <i class="fas fa-chevron-down custom-select-arrow"></i>
                    </div>
                    <div class="custom-options">
                        <div class="custom-option <%= (curCountryFilter === 'all') ? 'selected' : '' %>" data-value="all">
                            <i class="fas fa-globe-americas" style="color: var(--gold); flex-shrink: 0;"></i>
                            <span class="opt-label">All Regions</span>
                        </div>
                        <% countryDataRaw.forEach(country => { %>
                            <div class="custom-option <%= (curCountryFilter === country.code || curCountryFilter === country.name) ? 'selected' : '' %>" data-value="<%= country.code %>">
                                <% if (country.code !== 'GLOBAL') { %>
                                    <span class="fi fi-<%= country.code.toLowerCase() %>" style="border-radius: 2px; flex-shrink: 0;"></span>
                                <% } else { %>
                                    <i class="fas fa-globe" style="color: var(--gold); flex-shrink: 0;"></i>
                                <% } %>
                                <span class="opt-label"><%= country.name %></span>
                            </div>
                        <% }); %>
                    </div>
                    <input type="hidden" id="filter-country" name="country" value="<%= curCountryFilter %>">
                </div>
            </div>

            <div class="filter-input-group dropdown-group">
                <label><i class="fas fa-sort"></i> Sort By</label>
                <div class="custom-select-wrapper" id="wrapper-filter-sort">
                    <% 
                        const sortOptions = [
                            { value: 'members', label: 'Most Members', icon: 'fa-users', color: 'var(--gold)' },
                            { value: 'newest', label: 'Newest Created', icon: 'fa-clock', color: '#64b5f6' },
                            { value: 'name', label: 'Alphabetical', icon: 'fa-sort-alpha-down', color: '#b388ff' }
                        ];
                        const curSort = filters.sort || 'members';
                        const curSortObj = sortOptions.find(o => o.value === curSort) || sortOptions[0];
                    %>
                    <div class="custom-select">
                        <span class="custom-select-text">
                            <i class="fas <%= curSortObj.icon %>" style="color: <%= curSortObj.color %>;"></i>
                            <span class="text-label"><%= curSortObj.label %></span>
                        </span>
                        <i class="fas fa-chevron-down custom-select-arrow"></i>
                    </div>
                    <div class="custom-options">
                        <% sortOptions.forEach(opt => { %>
                            <div class="custom-option <%= (curSort === opt.value) ? 'selected' : '' %>" data-value="<%= opt.value %>">
                                <i class="fas <%= opt.icon %>" style="color: <%= opt.color %>;"></i>
                                <span class="opt-label"><%= opt.label %></span>
                            </div>
                        <% }); %>
                    </div>
                    <input type="hidden" id="filter-sort" name="sort" value="<%= curSort %>">
                </div>
            </div>

            <button type="submit" class="filter-submit-btn">
                <i class="fas fa-filter"></i> Apply
            </button>
        </form>

        <!-- Popular Tags Row -->
        <div class="popular-tags-row">
            <span style="font-size: 0.8rem; color: var(--silver); margin-right: 4px;">Popular:</span>
            <% popularTags.forEach(t => { %>
                <a href="/clubs?tag=<%= encodeURIComponent(t) %>" class="tag-chip <%= filters.tag.toLowerCase() === t.toLowerCase() ? 'active' : '' %>">
                    #<%= t %>
                </a>
            <% }) %>
            <% if (filters.tag || filters.q || filters.access !== 'all' || (filters.country && filters.country !== 'all') || filters.sort !== 'members') { %>
                <a href="/clubs" class="tag-chip" style="color: #ff6b6b; border-color: rgba(255, 107, 107, 0.4);">
                    <i class="fas fa-times"></i> Clear Filters
                </a>
            <% } %>
        </div>
    </div>

    <!-- Clubs Grid -->
    <% if (clubs && clubs.length > 0) { %>
        <div class="clubs-grid">
            <% clubs.forEach(club => { %>
                <% const isJoined = joinedClubIds.includes(String(club._id)); %>
                <div class="club-card">
                    <div class="club-card-banner">
                        <img src="<%= club.bannerUrl || '/images/default-banner.jpg' %>" alt="<%= club.name %> Banner" class="club-card-banner-img" onerror="this.onerror=null; this.src='/images/default-banner.jpg';">
                        <div class="club-card-badges">
                            <% if (club.isDefault) { %>
                                <span class="badge-pill badge-default"><i class="fas fa-star"></i> Official Hub</span>
                            <% } else if (club.isPrivate) { %>
                                <span class="badge-pill badge-private"><i class="fas fa-lock"></i> Private</span>
                            <% } else { %>
                                <span class="badge-pill badge-public"><i class="fas fa-globe"></i> Public</span>
                            <% } %>
                        </div>
                        <div class="club-card-avatar-wrap">
                            <img src="<%= club.iconUrl || '/images/default-avatar.png' %>" alt="<%= club.name %> Icon" class="club-card-avatar" onerror="this.src='/images/default-avatar.png';">
                        </div>
                    </div>

                    <div class="club-card-body">
                        <h3 class="club-card-name">
                            <span><%= club.name %></span>
                            <% 
                                const creatorRole = club.creator ? club.creator.role : '';
                                const isOwner = creatorRole === 'owner' || club.isDefault;
                                const isStaff = ['admin', 'support'].includes(creatorRole);
                                const isDistributor = creatorRole === 'distributor';
                                const isVerified = club.isVerified || isOwner || isStaff || isDistributor;
                            %>
                            <% if (isVerified) { %>
                                <% if (isOwner) { %>
                                    <i class="fas fa-check-circle" style="color: #ffd700; font-size: 0.9em; filter: drop-shadow(0 0 5px rgba(255,215,0,0.5));" title="Official GPLMods Community (Verified Gold)"></i>
                                <% } else if (isStaff) { %>
                                    <i class="fas fa-check-circle" style="color: #e0e0e0; font-size: 0.9em; filter: drop-shadow(0 0 5px rgba(255,255,255,0.4));" title="Staff Verified Community (Silver)"></i>
                                <% } else if (isDistributor) { %>
                                    <i class="fas fa-check-circle" style="color: #0099ff; font-size: 0.9em; filter: drop-shadow(0 0 5px rgba(0,153,255,0.5));" title="Distributor Partner Verified Community (Blue)"></i>
                                <% } else { %>
                                    <i class="fas fa-check-circle" style="color: #ffd700; font-size: 0.9em;" title="Verified Community"></i>
                                <% } %>
                            <% } %>
                        </h3>

                        <p class="club-card-desc"><%= club.description || 'Welcome to this community on GPLMods!' %></p>

                        <% if (club.tags && club.tags.length > 0) { %>
                            <div class="club-tags-list">
                                <% club.tags.slice(0, 5).forEach(tag => { %>
                                    <span class="club-tag-pill">#<%= tag %></span>
                                <% }) %>
                                <% if (club.tags.length > 5) { %>
                                    <span class="club-tag-pill">+<%= club.tags.length - 5 %></span>
                                <% } %>
                            </div>
                        <% } %>

                        <div class="club-card-meta">
                            <div class="club-meta-stat">
                                <i class="fas fa-users" style="color: var(--gold);"></i>
                                <span><%= club.memberCount || 1 %> <%= (club.memberCount === 1) ? 'Member' : 'Members' %></span>
                            </div>
                            <div class="club-meta-stat">
                                <i class="fas fa-hashtag" style="color: #64b5f6;"></i>
                                <span><%= club.channelCount || 6 %> Channels</span>
                            </div>
                            <div class="club-meta-stat">
                                <i class="fas fa-language" style="color: #ba68c8;"></i>
                                <span><%= club.primaryLanguage || 'English' %></span>
                            </div>
                        </div>

                        <div class="club-card-actions">
                            <a href="/clubs/<%= club.slug %>" class="btn-enter-club">
                                <% if (isJoined) { %>
                                    <i class="fas fa-comments"></i> Open Chat
                                <% } else if (club.isPrivate) { %>
                                    <i class="fas fa-eye"></i> View Preview
                                <% } else { %>
                                    <i class="fas fa-sign-in-alt"></i> Join Club
                                <% } %>
                            </a>

                            <!-- Integrated Share Button (Mod Share System from download.ejs) -->
                            <button type="button" class="btn-share-club" data-club-id="<%= club._id %>" data-club-name="<%= club.name %>" data-club-url="/clubs/<%= club.slug %>" onclick="handleClubShare(this)" title="Share this club">
                                <i class="fas fa-share-alt"></i>
                            </button>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div style="background: #14151b; border: 1px dashed #333645; border-radius: 18px; padding: 60px 20px; text-align: center; margin-bottom: 60px;">
            <i class="fas fa-search" style="font-size: 3rem; color: #555; margin-bottom: 16px;"></i>
            <h3 style="color: #fff; font-size: 1.4rem; margin-bottom: 8px;">No Clubs Found</h3>
            <p style="color: var(--silver); margin-bottom: 24px;">No clubs matched your search criteria. Try modifying your search query or create the first one!</p>
            <a href="/clubs/create" class="btn-create-club">
                <i class="fas fa-plus-circle"></i> Create a Club
            </a>
        </div>
    <% } %>
</main>

<!-- Custom Dropdown Controller & Share System Modal -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        function initCustomSelect(wrapperId, hiddenInputId, onSelectCallback) {
            const wrapper = document.getElementById(wrapperId);
            const hiddenInput = document.getElementById(hiddenInputId);
            if (!wrapper || !hiddenInput) return;

            const selectBtn = wrapper.querySelector('.custom-select');
            const selectText = wrapper.querySelector('.custom-select-text');
            const optionsContainer = wrapper.querySelector('.custom-options');

            selectBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const willOpen = !wrapper.classList.contains('open');
                // Close other open wrappers
                document.querySelectorAll('.custom-select-wrapper.open').forEach(w => {
                    w.classList.remove('open');
                    w.closest('.dropdown-group')?.classList.remove('is-open');
                });
                if (willOpen) {
                    wrapper.classList.add('open');
                    wrapper.closest('.dropdown-group')?.classList.add('is-open');
                }
            });

            optionsContainer.addEventListener('click', (e) => {
                const opt = e.target.closest('.custom-option');
                if (!opt) return;

                const val = opt.getAttribute('data-value');
                wrapper.querySelectorAll('.custom-option').forEach(o => o.classList.remove('selected'));
                opt.classList.add('selected');

                // Update trigger text with exact HTML from selected option
                selectText.innerHTML = opt.innerHTML;

                hiddenInput.value = val;
                hiddenInput.dispatchEvent(new Event('change'));
                wrapper.classList.remove('open');
                wrapper.closest('.dropdown-group')?.classList.remove('is-open');

                if (typeof onSelectCallback === 'function') {
                    onSelectCallback(val, opt);
                }
            });
        }

        // Close dropdowns on outside click
        document.addEventListener('click', () => {
            document.querySelectorAll('.custom-select-wrapper.open').forEach(w => {
                w.classList.remove('open');
                w.closest('.dropdown-group')?.classList.remove('is-open');
            });
        });

        // Initialize Filter Dropdowns
        initCustomSelect('wrapper-filter-access', 'filter-access');
        initCustomSelect('wrapper-filter-country', 'filter-country');
        initCustomSelect('wrapper-filter-sort', 'filter-sort');
    });

    function handleClubShare(btn) {
        const clubId = btn.getAttribute('data-club-id');
        const clubName = btn.getAttribute('data-club-name');
        const clubUrl = btn.getAttribute('data-club-url');
        shareClub(clubId, clubName, clubUrl);
    }

    function shareClub(clubId, clubName, clubUrl) {
        const fullShareUrl = window.location.origin + clubUrl;
        const gatewayShareUrl = `https://gplmods.webredirect.org${clubUrl}`;

        if (navigator.share) {
            navigator.share({
                title: `${clubName} on GPL Mods`,
                text: `Join ${clubName} community chat and distributor channels on GPL Mods!`,
                url: fullShareUrl
            }).catch(e => console.log('Share dismissed'));
        } else {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(fullShareUrl).then(() => {
                    alert(`Link to "${clubName}" copied to clipboard!`);
                }).catch(() => {
                    prompt('Copy this club link:', fullShareUrl);
                });
            } else {
                prompt('Copy this club link:', fullShareUrl);
            }
        }
    }
</script>

<%- include('../../partials/footer') %>
