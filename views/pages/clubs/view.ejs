<%- include('../../partials/header') %>

<style>
    /* Discord Container & Page Layout */
    html, body {
        height: 100%;
        height: 100dvh;
        overflow: hidden !important;
        margin: 0;
        padding: 0;
    }
    body {
        display: flex;
        flex-direction: column;
        background: #0f1015;
    }
    main {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden !important;
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
    }
    header, .main-header, #main-header, nav.main-nav {
        display: none !important;
    }
    #floating-music-player {
        display: none !important;
    }
    footer.main-footer {
        display: none !important;
    }
    .discord-app-layout {
        flex: 1;
        height: 100%;
        min-height: 0;
        display: flex;
        background: #0f1015;
        color: #dcddde;
        font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
        position: relative;
        overflow: hidden;
        width: 100%;
    }

    /* Left Drawer Container (Combines Rail + Channels on Mobile) */
    .discord-left-pane-wrapper {
        display: flex;
        height: 100%;
        flex-shrink: 0;
    }

    /* Mobile Backdrop for off-canvas drawers */
    .discord-mobile-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.72);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 1080;
        opacity: 0;
        transition: opacity 0.25s ease;
        pointer-events: none;
    }
    .discord-mobile-backdrop.active {
        display: block;
        opacity: 1;
        pointer-events: auto;
    }

    /* Mobile Drawer Toggle & Close Buttons */
    .mobile-channels-toggle-btn {
        display: none;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        color: #fff;
        cursor: pointer;
        padding: 0;
        font-size: 1.05rem;
        transition: background 0.2s, color 0.2s;
        flex-shrink: 0;
    }
    .mobile-channels-toggle-btn:hover {
        background: rgba(255, 215, 0, 0.15);
        color: var(--gold);
        border-color: var(--gold);
    }
    .mobile-drawer-close-btn {
        display: none;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid #333645;
        border-radius: 6px;
        color: #8e9297;
        cursor: pointer;
        font-size: 0.95rem;
        transition: all 0.2s;
    }
    .mobile-drawer-close-btn:hover {
        background: rgba(244, 67, 54, 0.2);
        color: #ff5252;
        border-color: #ff5252;
    }
    .members-mobile-header {
        display: none;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        border-bottom: 1px solid #20222c;
        background: #111218;
    }
    .drawer-close-btn {
        background: transparent;
        border: none;
        color: #8e9297;
        font-size: 1.4rem;
        cursor: pointer;
        padding: 2px 8px;
        line-height: 1;
        border-radius: 6px;
        transition: color 0.2s, background 0.2s;
    }
    .drawer-close-btn:hover {
        color: #fff;
        background: #232532;
    }

    /* Club Dropdown Menu */
    .club-header-box {
        position: relative;
    }
    .club-header-dropdown {
        position: absolute;
        top: 52px;
        left: 8px;
        right: 8px;
        background: #12131b;
        border: 1px solid var(--gold);
        border-radius: 12px;
        padding: 6px;
        display: none;
        flex-direction: column;
        gap: 2px;
        z-index: 1200;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.85);
    }
    .club-header-dropdown.active {
        display: flex;
    }
    .club-menu-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 12px;
        border-radius: 8px;
        color: #dcddde;
        font-size: 0.88rem;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
        border: none;
        background: transparent;
        width: 100%;
        text-align: left;
        box-sizing: border-box;
    }
    .club-menu-item:hover {
        background: #232532;
        color: #fff;
    }
    .club-menu-item i {
        width: 18px;
        text-align: center;
        color: var(--silver);
    }
    .club-menu-item:hover i {
        color: var(--gold);
    }
    .club-menu-divider {
        height: 1px;
        background: #222430;
        margin: 4px 6px;
    }

    /* 1. LEFTMOST VERTICAL RAIL (CLUBS NAV) */
    .discord-rail {
        width: 72px;
        background: #090a0d;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 14px 0 10px;
        gap: 10px;
        border-right: 1px solid #1c1d25;
        overflow-y: auto;
        flex-shrink: 0;
        z-index: 50;
    }
    .rail-item {
        position: relative;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #1e1f29;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.2, 0, 0, 1);
        text-decoration: none;
        color: var(--silver);
    }
    .rail-item:hover, .rail-item.active {
        border-radius: 16px;
        background: var(--gold);
        color: #000;
        box-shadow: 0 0 16px rgba(255, 215, 0, 0.4);
    }
    .rail-item img {
        width: 100%;
        height: 100%;
        border-radius: inherit;
        object-fit: cover;
    }
    .rail-item-pill {
        position: absolute;
        left: -12px;
        width: 4px;
        height: 0;
        background: #fff;
        border-radius: 0 4px 4px 0;
        transition: height 0.2s ease;
    }
    .rail-item:hover .rail-item-pill { height: 20px; }
    .rail-item.active .rail-item-pill { height: 40px; background: var(--gold); }
    .rail-divider {
        width: 32px;
        height: 2px;
        background: #232530;
        border-radius: 1px;
        margin: 2px 0;
    }

    /* 2. CHANNELS SIDEBAR (2ND COLUMN) */
    .discord-channels-col {
        width: 250px;
        background: #14151c;
        display: flex;
        flex-direction: column;
        border-right: 1px solid #20222c;
        flex-shrink: 0;
    }
    .club-banner-wrap {
        width: 100%;
        height: 105px;
        position: relative;
        overflow: hidden;
        flex-shrink: 0;
        background: #0f1015;
    }
    .club-banner-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .club-banner-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(20,21,28,0.65) 70%, #14151c 100%);
        pointer-events: none;
    }
    .club-header-box {
        padding: 14px 16px;
        border-bottom: 1px solid #20222c;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        position: relative;
        background: rgba(255, 255, 255, 0.02);
        transition: background 0.2s;
    }
    .club-header-box:hover {
        background: rgba(255, 255, 255, 0.05);
    }
    .club-header-title {
        font-weight: 700;
        font-size: 1.05rem;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .channels-scroll-area {
        flex: 1;
        overflow-y: auto;
        padding: 12px 8px;
    }
    .channel-category-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: #8e9297;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 12px 8px 4px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .channel-item-link {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        border-radius: 8px;
        color: #96989d;
        text-decoration: none;
        font-size: 0.92rem;
        font-weight: 500;
        margin-bottom: 2px;
        transition: all 0.2s;
    }
    .channel-item-link:hover {
        background: #232532;
        color: #dcddde;
    }
    .channel-item-link.active {
        background: #2b2d3c;
        color: #fff;
        font-weight: 600;
    }
    .channel-item-link.active i {
        color: var(--gold);
    }
    .channel-lock-icon {
        font-size: 0.75rem;
        color: #ff8a80;
        margin-left: auto;
    }

    /* User Profile Footer */
    .discord-user-footer {
        height: 58px;
        background: #111218;
        border-top: 1px solid #1c1d25;
        padding: 0 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .footer-user-info {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        padding: 4px 6px;
        border-radius: 8px;
        transition: background 0.2s;
    }
    .footer-user-info:hover {
        background: #1e1f29;
    }
    .footer-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        object-fit: cover;
        position: relative;
    }
    .footer-name-box {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }
    .footer-username {
        font-size: 0.88rem;
        font-weight: 600;
        color: #fff;
    }
    .footer-status-tag {
        font-size: 0.72rem;
        color: var(--silver);
    }

    /* 3. CENTER CHAT AREA */
    .discord-chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #181922;
        position: relative;
        min-width: 0;
    }
    .chat-topbar {
        height: 52px;
        background: #181922;
        border-bottom: 1px solid #222430;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 18px;
        flex-shrink: 0;
    }
    .topbar-channel-info {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1.05rem;
        font-weight: 700;
        color: #fff;
    }
    .topbar-topic {
        color: #8e9297;
        font-size: 0.82rem;
        font-weight: 400;
        border-left: 1px solid #333645;
        padding-left: 12px;
        margin-left: 6px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 400px;
    }
    .topbar-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .topbar-btn {
        background: transparent;
        border: none;
        color: #b9bbbe;
        font-size: 1.1rem;
        cursor: pointer;
        padding: 6px;
        border-radius: 6px;
        transition: color 0.2s, background 0.2s;
    }
    .topbar-btn:hover {
        color: #fff;
        background: #252735;
    }

    /* Message Feed */
    .chat-messages-container {
        flex: 1;
        overflow-y: auto;
        padding: 16px 20px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }
    .message-item {
        display: flex;
        gap: 14px;
        padding: 4px 6px;
        border-radius: 8px;
        transition: background 0.15s;
    }
    .message-item:hover {
        background: rgba(255, 255, 255, 0.02);
    }
    .message-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }
    .message-content-col {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 0;
    }
    .message-header-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
        flex-wrap: wrap;
    }
    .message-username {
        font-weight: 700;
        font-size: 0.95rem;
        color: #fff;
        text-decoration: none;
    }
    .badge-icon-tag {
        font-size: 0.72rem;
        padding: 2px 8px;
        border-radius: 10px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .badge-owner { background: rgba(255, 215, 0, 0.2); color: var(--gold); border: 1px solid var(--gold); }
    .badge-admin { background: rgba(33, 150, 243, 0.2); color: #64b5f6; border: 1px solid #2196f3; }
    .badge-premium { background: rgba(186, 104, 200, 0.2); color: #e1bee7; border: 1px solid #ba68c8; }
    .badge-creator { background: rgba(255, 112, 67, 0.2); color: #ffab91; border: 1px solid #ff7043; }
    .message-time {
        font-size: 0.75rem;
        color: #72767d;
        margin-left: 4px;
    }
    .message-body-text {
        font-size: 0.94rem;
        color: #dcddde;
        line-height: 1.5;
        word-break: break-word;
    }
    .btn-translate-msg {
        background: transparent;
        border: 1px solid #333645;
        color: #8e9297;
        font-size: 0.72rem;
        padding: 2px 8px;
        border-radius: 12px;
        cursor: pointer;
        margin-top: 4px;
        align-self: flex-start;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s;
    }
    .btn-translate-msg:hover {
        border-color: var(--gold);
        color: var(--gold);
    }

    /* Mod Update Embed Card */
    .mod-update-embed-box {
        background: #111219;
        border-left: 4px solid var(--gold);
        border-radius: 8px;
        padding: 14px 18px;
        margin-top: 8px;
        display: flex;
        gap: 16px;
        align-items: center;
        max-width: 600px;
    }
    .mod-embed-icon {
        width: 54px;
        height: 54px;
        border-radius: 12px;
        object-fit: cover;
    }
    .mod-embed-info h4 {
        margin: 0 0 4px;
        color: #fff;
        font-size: 1.05rem;
    }
    .mod-embed-info p {
        margin: 0 0 8px;
        color: var(--silver);
        font-size: 0.85rem;
    }

    /* Poll Card */
    .poll-embed-card {
        background: #12131b;
        border: 1px solid #282a36;
        border-radius: 12px;
        padding: 16px;
        margin-top: 8px;
        max-width: 520px;
    }
    .poll-question {
        font-weight: 700;
        color: #fff;
        font-size: 1.05rem;
        margin-bottom: 12px;
    }
    .poll-option-row {
        background: #1a1b24;
        border: 1px solid #2e3040;
        border-radius: 8px;
        padding: 8px 12px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: border-color 0.2s;
    }
    .poll-option-row:hover {
        border-color: var(--gold);
    }
    .poll-progress-fill {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        background: rgba(255, 215, 0, 0.15);
        pointer-events: none;
        transition: width 0.3s ease;
    }

    /* Reactions Bar */
    .reactions-row {
        display: flex;
        gap: 6px;
        margin-top: 6px;
        flex-wrap: wrap;
    }
    .reaction-pill {
        background: #12131b;
        border: 1px solid #282a36;
        color: #b9bbbe;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.82rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .reaction-pill:hover, .reaction-pill.user-reacted {
        background: rgba(255, 215, 0, 0.15);
        border-color: var(--gold);
        color: var(--gold);
    }

    /* Chat Input Bar */
    .chat-input-bar-wrap {
        padding: 0 18px 18px;
        position: relative;
        flex-shrink: 0;
    }
    .chat-input-box {
        background: #232532;
        border-radius: 12px;
        display: flex;
        align-items: center;
        padding: 0 14px;
        border: 1px solid #2d3040;
        position: relative;
    }
    .chat-textarea {
        flex: 1;
        background: transparent;
        border: none;
        color: #fff;
        padding: 12px 8px;
        font-size: 0.95rem;
        outline: none;
        resize: none;
        max-height: 120px;
    }
    .chat-input-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .chat-action-btn {
        background: transparent;
        border: none;
        color: #b9bbbe;
        font-size: 1.15rem;
        cursor: pointer;
        padding: 6px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s, transform 0.15s;
    }
    .chat-action-btn:hover {
        color: var(--gold);
        transform: scale(1.1);
    }
    .btn-send-chat {
        background: var(--gold);
        color: #000;
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }
    .btn-send-chat:hover {
        background: #ffe066;
        transform: scale(1.05);
    }

    /* 4. RIGHT SIDEBAR (MEMBERS LIST) */
    .discord-members-col {
        width: 240px;
        background: #14151c;
        border-left: 1px solid #20222c;
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
    }
    .members-scroll-area {
        flex: 1;
        overflow-y: auto;
        padding: 16px 12px;
    }
    .member-group-header {
        font-size: 0.72rem;
        font-weight: 700;
        color: #8e9297;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 8px;
    }
    .member-card-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 8px;
        border-radius: 8px;
        cursor: pointer;
        margin-bottom: 3px;
        transition: background 0.15s;
    }
    .member-card-row:hover {
        background: #232532;
    }
    .member-avatar-wrap {
        position: relative;
        width: 32px;
        height: 32px;
        flex-shrink: 0;
    }
    .member-avatar-img {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
        background: #1e2029;
    }
    .online-dot {
        position: absolute;
        bottom: -1px;
        right: -1px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #43b581;
        border: 2px solid #14151c;
    }
    .member-meta-box {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }
    .member-display-name {
        font-size: 0.88rem;
        font-weight: 600;
        color: #fff;
    }

    /* Emoticons Popover */
    .emoticon-popover {
        position: absolute;
        bottom: 60px;
        right: 80px;
        background: #1a1b24;
        border: 1px solid var(--gold);
        border-radius: 12px;
        padding: 12px;
        display: none;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        z-index: 100;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.7);
    }
    .emoticon-popover.active {
        display: grid;
    }
    .emoticon-btn {
        background: #232532;
        border: 1px solid #333645;
        color: #fff;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
        text-align: center;
        white-space: nowrap;
    }
    .emoticon-btn:hover {
        background: var(--gold);
        color: #000;
    }

    /* GIF Picker Popover */
    .gif-picker-modal {
        position: absolute;
        bottom: 60px;
        right: 40px;
        width: 340px;
        background: #14151c;
        border: 1px solid var(--gold);
        border-radius: 14px;
        padding: 14px;
        display: none;
        flex-direction: column;
        z-index: 100;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.8);
    }
    .gif-picker-modal.active {
        display: flex;
    }
    .gif-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        max-height: 250px;
        overflow-y: auto;
        margin-top: 10px;
    }
    .gif-item img {
        width: 100%;
        height: 90px;
        border-radius: 8px;
        object-fit: cover;
        cursor: pointer;
        transition: transform 0.2s;
    }
    .gif-item img:hover {
        transform: scale(1.04);
    }

    /* Modal Backdrop */
    .gpl-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(6px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }
    .gpl-modal-backdrop.active {
        display: flex;
    }
    .gpl-modal-box {
        background: #14151c;
        border: 1px solid var(--gold);
        border-radius: 18px;
        padding: 28px;
        width: 90%;
        max-width: 480px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
    }

    /* RESPONSIVE MOBILE STYLING (Discord / Telegram Mobile Experience) */
    @media (max-width: 992px) {
        .discord-left-pane-wrapper {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            width: 320px;
            max-width: 86vw;
            height: 100dvh;
            height: 100%;
            z-index: 1100;
            transform: translateX(-100%);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            box-shadow: 6px 0 30px rgba(0, 0, 0, 0.8);
        }
        .discord-left-pane-wrapper.open {
            transform: translateX(0);
        }
        .discord-rail {
            width: 64px;
            padding: 12px 0 10px;
            gap: 8px;
        }
        .rail-item {
            width: 44px;
            height: 44px;
        }
        .discord-channels-col {
            width: auto;
            flex: 1;
            min-width: 0;
        }
        .mobile-channels-toggle-btn {
            display: inline-flex;
        }
        .mobile-drawer-close-btn {
            display: inline-flex;
        }
        .members-mobile-header {
            display: flex;
        }
        .discord-members-col {
            position: fixed;
            top: 0;
            bottom: 0;
            right: 0;
            width: 280px;
            max-width: 85vw;
            height: 100dvh;
            height: 100%;
            z-index: 1100;
            transform: translateX(100%);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            border-left: 1px solid #282a38;
            box-shadow: -6px 0 30px rgba(0, 0, 0, 0.8);
            display: flex !important;
        }
        .discord-members-col.open {
            transform: translateX(0);
        }
        .chat-topbar {
            padding: 0 10px;
            height: 50px;
        }
        .topbar-topic {
            display: none;
        }
        .topbar-channel-info {
            gap: 8px;
            font-size: 0.95rem;
            min-width: 0;
        }
        .topbar-actions {
            gap: 4px;
        }
        .topbar-btn {
            padding: 6px;
            font-size: 1rem;
        }
        .chat-messages-container {
            padding: 12px 10px;
            gap: 12px;
        }
        .message-item {
            padding: 4px 2px;
            gap: 10px;
        }
        .message-avatar {
            width: 36px;
            height: 36px;
        }
        .message-username {
            font-size: 0.9rem;
        }
        .message-body-text {
            font-size: 0.9rem;
        }
        .chat-input-bar-wrap {
            padding: 0 8px 8px;
        }
        .chat-input-box {
            padding: 0 8px;
            border-radius: 10px;
        }
        .chat-textarea {
            font-size: 16px; /* Prevents auto-zoom in mobile browsers */
            padding: 10px 4px;
        }
        .chat-input-actions {
            gap: 4px;
        }
        .chat-action-btn {
            padding: 6px 4px;
            font-size: 1.05rem;
            min-width: 32px;
        }
        .btn-send-chat {
            padding: 8px 12px;
        }
        .emoticon-popover {
            left: 8px;
            right: 8px;
            bottom: 60px;
            width: auto;
            max-width: calc(100vw - 16px);
            grid-template-columns: repeat(3, 1fr);
        }
        .gif-picker-modal {
            left: 8px;
            right: 8px;
            bottom: 60px;
            width: auto;
            max-width: calc(100vw - 16px);
        }
        #mainEmojiPicker {
            left: 8px !important;
            right: 8px !important;
            bottom: 60px !important;
            width: auto !important;
            max-width: calc(100vw - 16px) !important;
        }
    }

    @media (max-width: 480px) {
        .discord-left-pane-wrapper {
            width: 295px;
        }
        .chat-action-btn {
            padding: 5px 2px;
            font-size: 0.95rem;
            min-width: 28px;
        }
        .btn-send-chat {
            padding: 7px 10px;
        }
        .mod-update-embed-box {
            flex-direction: column;
            align-items: flex-start;
            padding: 12px;
            gap: 10px;
            max-width: 100%;
        }
        .mod-embed-icon {
            width: 44px;
            height: 44px;
        }
        .poll-embed-card {
            max-width: 100%;
            padding: 12px;
        }
    }
</style>

<div class="discord-app-layout">

    <!-- Mobile Backdrop for off-canvas Drawers -->
    <div class="discord-mobile-backdrop" id="discordBackdrop" onclick="closeDiscordDrawers()"></div>

    <!-- LEFT DRAWER: RAIL (Clubs) + CHANNELS SIDEBAR -->
    <div class="discord-left-pane-wrapper" id="leftNavDrawer">

    <!-- ========================================== -->
    <!-- 1. LEFT RAIL: JOINED CLUBS & DISCOVER      -->
    <!-- ========================================== -->
    <div class="discord-rail">
        <!-- Go Back Arrow to Clubs Directory -->
        <a href="/clubs" class="rail-item back-rail-btn" title="Back to All Clubs & Communities" style="display: flex; align-items: center; justify-content: center; background: rgba(255, 215, 0, 0.12); border: 1.5px solid var(--gold); color: var(--gold); text-decoration: none; font-size: 1.25rem;">
            <div class="rail-item-pill"></div>
            <i class="fas fa-arrow-left" style="color: var(--gold);"></i>
        </a>

        <div class="rail-divider"></div>

        <!-- Joined Clubs Icons -->
        <% if (joinedClubs && joinedClubs.length > 0) { %>
            <% joinedClubs.forEach(jClub => { %>
                <a href="/clubs/<%= jClub.slug %>" class="rail-item <%= String(jClub._id) === String(club._id) ? 'active' : '' %>" title="<%= jClub.name %>">
                    <div class="rail-item-pill"></div>
                    <img src="<%= jClub.iconUrl || '/images/default-avatar.png' %>" alt="<%= jClub.name %>" onerror="this.src='/images/default-avatar.png';">
                </a>
            <% }) %>
        <% } %>

        <div class="rail-divider"></div>

        <!-- Add Club (+) -->
        <a href="/clubs/create" class="rail-item" title="Create a New Club">
            <i class="fas fa-plus" style="font-size: 1.2rem;"></i>
        </a>

        <!-- Explore Clubs (Compass) -->
        <a href="/clubs" class="rail-item" title="Discover Clubs &amp; Communities">
            <i class="fas fa-compass" style="font-size: 1.2rem;"></i>
        </a>
    </div>

    <!-- ========================================== -->
    <!-- 2. CHANNELS SIDEBAR                        -->
    <!-- ========================================== -->
    <div class="discord-channels-col">
        <!-- Club Banner Header -->
        <div class="club-banner-wrap">
            <img src="<%= club.bannerUrl || '/images/default-banner.jpg' %>" alt="<%= club.name %> Banner" class="club-banner-img" onerror="this.onerror=null; this.src='/images/default-banner.jpg';">
            <div class="club-banner-overlay"></div>
        </div>

        <!-- Club Header with Server Actions Dropdown -->
        <div class="club-header-box" onclick="toggleClubMenu(event)">
            <div class="club-header-title">
                <span><%= club.name %></span>
                <% if (club.isVerified || club.isDefault) { %>
                    <i class="fas fa-check-circle" style="color: var(--gold); font-size: 0.85em;"></i>
                <% } %>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-chevron-down" style="font-size: 0.8rem; color: #8e9297;"></i>
                <button type="button" class="mobile-drawer-close-btn" onclick="closeDiscordDrawers(event)" title="Close Navigation">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <!-- Club Dropdown Menu -->
        <div class="club-header-dropdown" id="clubHeaderDropdown">
            <a href="/clubs/<%= club.slug %>/preview" class="club-menu-item">
                <i class="fas fa-info-circle"></i>
                <span>Club Overview &amp; Info</span>
            </a>
            <div class="club-menu-item" data-club-id="<%= club._id %>" data-club-name="<%= club.name %>" data-club-url="/clubs/<%= club.slug %>" onclick="handleClubShare(this); toggleClubMenu();">
                <i class="fas fa-share-alt"></i>
                <span>Invite &amp; Share Club</span>
            </div>
            <% if (hasManageClubPerm) { %>
                <div class="club-menu-divider"></div>
                <div class="club-menu-item" onclick="openCreateChannelModal(); toggleClubMenu();">
                    <i class="fas fa-plus-circle"></i>
                    <span>Create Text Channel</span>
                </div>
                <div class="club-menu-item" onclick="openTrackedCreatorsModal(); toggleClubMenu();">
                    <i class="fas fa-user-plus"></i>
                    <span>Tracked Creators</span>
                </div>
            <% } %>
            <div class="club-menu-divider"></div>
            <a href="/clubs" class="club-menu-item">
                <i class="fas fa-compass"></i>
                <span>Explore Other Clubs</span>
            </a>
            <% if (!club.isDefault && membership && !isClubCreator) { %>
                <form action="/clubs/<%= club.slug %>/leave" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to leave this club?');">
                    <button type="submit" class="club-menu-item" style="color: #ff5252;">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Leave Club</span>
                    </button>
                </form>
            <% } %>
        </div>

        <!-- Channels Scroll Area -->
        <div class="channels-scroll-area">
            <!-- 1. INFORMATION CHANNELS -->
            <div class="channel-category-label">
                <span>📌 Information</span>
            </div>
            <% channels.filter(c => ['rules', 'announcements'].includes(c.type)).forEach(chan => { %>
                <a href="/clubs/<%= club.slug %>?channel=<%= chan._id %>" class="channel-item-link <%= (activeChannel && String(activeChannel._id) === String(chan._id)) ? 'active' : '' %>">
                    <i class="fas <%= chan.type === 'rules' ? 'fa-scroll' : 'fa-bullhorn' %>"></i>
                    <span><%= chan.name %></span>
                </a>
            <% }) %>

            <!-- 2. MOD FEEDS (Automated uploader/distributor feeds) -->
            <div class="channel-category-label" style="margin-top: 8px;">
                <span>🚀 Mod Feeds</span>
            </div>
            <% channels.filter(c => ['new-uploads', 'new-updates'].includes(c.type)).forEach(chan => { %>
                <a href="/clubs/<%= club.slug %>?channel=<%= chan._id %>" class="channel-item-link <%= (activeChannel && String(activeChannel._id) === String(chan._id)) ? 'active' : '' %>">
                    <i class="fas <%= chan.type === 'new-uploads' ? 'fa-download' : 'fa-sync-alt' %>"></i>
                    <span><%= chan.name %></span>
                </a>
            <% }) %>

            <!-- 3. TEXT & POLL CHANNELS -->
            <div class="channel-category-label" style="margin-top: 8px;">
                <span>💬 Text Channels</span>
                <% if (hasManageClubPerm) { %>
                    <button type="button" onclick="openCreateChannelModal()" title="Create Channel" style="background: none; border: none; color: #8e9297; cursor: pointer;">
                        <i class="fas fa-plus"></i>
                    </button>
                <% } %>
            </div>
            <% channels.filter(c => !['rules', 'announcements', 'new-uploads', 'new-updates'].includes(c.type)).forEach(chan => { %>
                <a href="/clubs/<%= club.slug %>?channel=<%= chan._id %>" class="channel-item-link <%= (activeChannel && String(activeChannel._id) === String(chan._id)) ? 'active' : '' %>">
                    <i class="fas <%= chan.type === 'polls' ? 'fa-poll' : 'fa-hashtag' %>"></i>
                    <span><%= chan.name %></span>
                    <% if (chan.isPrivate) { %>
                        <i class="fas fa-lock channel-lock-icon" title="Role-Specific Channel"></i>
                    <% } %>
                </a>
            <% }) %>
        </div>

        <!-- User Profile Footer with Vanished Mode for Staff -->
        <div class="discord-user-footer">
            <div class="footer-user-info" onclick="window.location.href='/users/<%= user ? user.username : '' %>'">
                <% const myFooterAvatar = (user && user.signedAvatarUrl && user.signedAvatarUrl !== '/images/default-avatar.png') ? user.signedAvatarUrl : ((user && (user.cardAvatarUrl || user.avatarUrl || user.avatar)) ? (user.cardAvatarUrl || user.avatarUrl || user.avatar) : ((user && user.username === 'GPLMods') ? '/images/team-logo.png' : '/images/default-avatar.png')); %>
                <img src="<%= myFooterAvatar %>" alt="<%= user ? user.username : 'User Avatar' %>" class="footer-avatar" onerror="this.onerror=null; this.src=(this.alt==='GPLMods')?'/images/team-logo.png':'/images/default-avatar.png';">
                <div class="footer-name-box">
                    <span class="footer-username"><%= user ? user.username : 'Guest' %></span>
                    <span class="footer-status-tag"><%= isStaff ? 'Site Staff' : 'Member' %></span>
                </div>
            </div>

            <!-- Vanished Mode Toggle (Site Owner & Admin Only) -->
            <% if (isStaff) { %>
                <button type="button" id="vanishToggleBtn" onclick="toggleVanishedMode()" title="Vanished Mode (Ghost Audit Mode: Visit without showing online or increasing count)" style="background: none; border: 1px solid #444; border-radius: 8px; color: <%= vanishedModeDefault ? 'var(--gold)' : '#777' %>; padding: 4px 8px; cursor: pointer; display: flex; align-items: center; gap: 4px; font-size: 0.75rem;">
                    <i class="fas fa-ghost"></i>
                    <span id="vanishStatusText"><%= vanishedModeDefault ? 'Ghost ON' : 'Ghost' %></span>
                </button>
            <% } %>
        </div>
    </div>
    </div> <!-- Close .discord-left-pane-wrapper -->

    <!-- ========================================== -->
    <!-- 3. MAIN CHAT AREA                          -->
    <!-- ========================================== -->
    <div class="discord-chat-main">
        <!-- Top Bar -->
        <div class="chat-topbar">
            <div class="topbar-channel-info">
                <!-- Mobile Navigation Toggle Button -->
                <button type="button" class="mobile-channels-toggle-btn" id="mobileChannelsToggleBtn" onclick="toggleLeftDrawer()" title="Channels &amp; Clubs">
                    <i class="fas fa-bars"></i>
                </button>

                <!-- Go Back to Clubs Button -->
                <a href="/clubs" class="topbar-btn back-btn-topbar" title="Back to All Clubs" style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; text-decoration: none; color: var(--gold); border: 1px solid rgba(255,215,0,0.3); border-radius: 8px; padding: 4px 10px; font-size: 0.82rem; font-weight: 600; margin-right: 6px; background: rgba(255,215,0,0.06);">
                    <i class="fas fa-arrow-left"></i> <span class="hide-mobile">Clubs</span>
                </a>

                <i class="fas <%= activeChannel ? (activeChannel.type === 'polls' ? 'fa-poll' : (activeChannel.type === 'rules' ? 'fa-scroll' : (activeChannel.type === 'announcements' ? 'fa-bullhorn' : 'fa-hashtag'))) : 'fa-hashtag' %>" style="color: var(--gold);"></i>
                <span style="font-weight: 700;"><%= activeChannel ? activeChannel.name : 'general' %></span>

                <!-- Verified Badge for Club in Topbar -->
                <% 
                    const clubCreatorRole = club.creator ? club.creator.role : '';
                    const isClubOwner = clubCreatorRole === 'owner' || club.isDefault;
                    const isClubStaff = ['admin', 'support'].includes(clubCreatorRole);
                    const isClubDistributor = clubCreatorRole === 'distributor';
                    const isClubVerified = club.isVerified || isClubOwner || isClubStaff || isClubDistributor;
                %>
                <% if (isClubVerified) { %>
                    <% if (isClubOwner) { %>
                        <i class="fas fa-check-circle" style="color: #ffd700; margin-left: 5px; font-size: 0.9em; filter: drop-shadow(0 0 4px rgba(255,215,0,0.4));" title="Official GPLMods Community (Gold Verified)"></i>
                    <% } else if (isClubStaff) { %>
                        <i class="fas fa-check-circle" style="color: #e0e0e0; margin-left: 5px; font-size: 0.9em; filter: drop-shadow(0 0 4px rgba(255,255,255,0.4));" title="Staff Verified Community (Silver)"></i>
                    <% } else if (isClubDistributor) { %>
                        <i class="fas fa-check-circle" style="color: #0099ff; margin-left: 5px; font-size: 0.9em; filter: drop-shadow(0 0 4px rgba(0,153,255,0.4));" title="Distributor Partner Verified (Blue)"></i>
                    <% } else { %>
                        <i class="fas fa-check-circle" style="color: #ffd700; margin-left: 5px; font-size: 0.9em;" title="Verified Community"></i>
                    <% } %>
                <% } %>

                <% if (activeChannel && activeChannel.topic) { %>
                    <span class="topbar-topic"><%= activeChannel.topic %></span>
                <% } %>
            </div>

            <div class="topbar-actions">
                <!-- Mod Share System -->
                <button type="button" class="topbar-btn" data-club-id="<%= club._id %>" data-club-name="<%= club.name %>" data-club-url="/clubs/<%= club.slug %>" onclick="handleClubShare(this)" title="Share Club">
                    <i class="fas fa-share-alt"></i>
                </button>

                <!-- Restrict Channel Toggle (Staff/Creator) -->
                <% if (hasManageClubPerm) { %>
                    <button type="button" class="topbar-btn" id="btnToggleChannelRestrict" onclick="toggleChannelRestriction()" title="<%= (activeChannel && activeChannel.isReadOnly) ? 'Unlock Channel Chat' : 'Restrict Channel Chat' %>" style="color: <%= (activeChannel && activeChannel.isReadOnly) ? '#e74c3c' : 'var(--silver)' %>;">
                        <i class="fas <%= (activeChannel && activeChannel.isReadOnly) ? 'fa-lock' : 'fa-lock-open' %>"></i>
                    </button>
                    <button type="button" class="topbar-btn" onclick="openTrackedCreatorsModal()" title="Track Creator Mod Updates">
                        <i class="fas fa-user-plus"></i>
                    </button>
                <% } %>

                <!-- Toggle Members Sidebar on Mobile/Desktop -->
                <button type="button" class="topbar-btn" onclick="toggleMembersSidebar()" title="Toggle Members List">
                    <i class="fas fa-users"></i>
                </button>
            </div>
        </div>

        <!-- Channel Restricted Warning Banner -->
        <div id="channelRestrictedNotice" style="display: <%= (activeChannel && activeChannel.isReadOnly) ? 'flex' : 'none' %>; align-items: center; justify-content: center; gap: 8px; background: rgba(231, 76, 60, 0.12); border-bottom: 1px solid rgba(231, 76, 60, 0.4); color: #ff8a80; padding: 7px 14px; font-size: 0.82rem; font-weight: 600;">
            <i class="fas fa-lock"></i> Chat in this channel is restricted to staff announcements.
        </div>

        <!-- Chat Messages Container -->
        <div class="chat-messages-container" id="messagesFeed">
            <!-- Pinned Message Banner -->
            <% const pinnedMsg = (messages && messages.length > 0) ? messages.find(m => m.isPinned && !m.isDeleted) : null; %>
            <div id="pinnedMessageBanner" style="display: <%= pinnedMsg ? 'flex' : 'none' %>; align-items: center; justify-content: space-between; background: linear-gradient(90deg, rgba(255,215,0,0.14) 0%, rgba(20,21,27,0.96) 100%); border-bottom: 1.5px solid var(--gold); padding: 8px 16px; font-size: 0.85rem; color: #fff; position: sticky; top: 0; z-index: 10; backdrop-filter: blur(8px);">
                <div style="display: flex; align-items: center; gap: 8px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">
                    <i class="fas fa-thumbtack" style="color: var(--gold); transform: rotate(45deg); font-size: 0.9rem;"></i>
                    <span style="font-weight: 700; color: var(--gold); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px;">Pinned:</span>
                    <span id="pinnedBannerText" style="color: #eee; overflow: hidden; text-overflow: ellipsis;"><%= pinnedMsg ? pinnedMsg.content : '' %></span>
                </div>
                <div style="display: flex; gap: 8px; align-items: center; flex-shrink: 0;">
                    <button type="button" id="pinnedBannerJumpBtn" onclick="jumpToPinnedMessage('<%= pinnedMsg ? pinnedMsg._id : '' %>')" style="background: rgba(255,215,0,0.2); border: 1px solid var(--gold); color: #fff; border-radius: 6px; padding: 2px 10px; font-size: 0.75rem; cursor: pointer; font-weight: 600;">Jump</button>
                    <% if (hasManageClubPerm) { %>
                        <button type="button" id="pinnedBannerUnpinBtn" onclick="togglePinClubMessage('<%= pinnedMsg ? pinnedMsg._id : '' %>', false)" title="Unpin Message" style="background: none; border: none; color: var(--silver); cursor: pointer; font-size: 1.2rem; line-height: 1; padding: 0 4px;">&times;</button>
                    <% } %>
                </div>
            </div>

            <% if (messages && messages.length > 0) { %>
                <% messages.forEach(msg => { %>
                    <% const isMyMessage = user && String(user._id) === String(msg.sender ? msg.sender._id : ''); %>
                    <% if (msg.isDeleted && isMyMessage) { return; } %>
                    <div class="message-item <%= msg.isPinned ? 'pinned-msg-item' : '' %>" id="msg-<%= msg._id %>" style="<%= msg.isPinned ? 'border-left: 3px solid var(--gold); background: rgba(255,215,0,0.02);' : '' %>">
                        <% 
                            const isGPLModsMsg = !msg.sender || msg.sender.username === 'GPLMods' || msg.isSystemMessage;
                            const senderAvatar = (msg.sender && msg.sender.signedAvatarUrl) ? msg.sender.signedAvatarUrl : (isGPLModsMsg ? '/images/team-logo.png' : '/images/default-avatar.png');
                        %>
                        <img src="<%= senderAvatar %>" alt="Sender Avatar" class="message-avatar" onerror="this.src='<%= isGPLModsMsg ? '/images/team-logo.png' : '/images/default-avatar.png' %>';">
                        <div class="message-content-col">
                            <div class="message-header-row">
                                <a href="/users/<%= (msg.sender && msg.sender.username) ? msg.sender.username : 'GPLMods' %>" class="message-username" target="_blank">
                                    <%= (msg.sender && msg.sender.username) ? msg.sender.username : 'GPLMods' %>
                                </a>

                                <!-- Badges -->
                                <% if (msg.sender && msg.sender.role === 'owner') { %>
                                    <span class="badge-icon-tag badge-owner"><i class="fas fa-crown"></i> Owner</span>
                                <% } else if (msg.sender && msg.sender.role === 'admin') { %>
                                    <span class="badge-icon-tag badge-admin"><i class="fas fa-shield-alt"></i> Admin</span>
                                <% } %>
                                <% if (msg.sender && (msg.sender.membership === 'premium' || msg.sender.isPremium)) { %>
                                    <span class="badge-icon-tag badge-premium"><i class="fas fa-star"></i> Premium</span>
                                <% } %>
                                <% if (String(club.creator._id || club.creator) === String(msg.sender ? msg.sender._id : '')) { %>
                                    <span class="badge-icon-tag badge-creator"><i class="fas fa-paint-brush"></i> Creator</span>
                                <% } %>
                                <% if (msg.isPinned) { %>
                                    <span class="badge-icon-tag badge-pinned" style="background: rgba(255,215,0,0.15); color: var(--gold); border: 1px solid var(--gold);"><i class="fas fa-thumbtack"></i> Pinned</span>
                                <% } %>

                                <span class="message-time"><%= new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                            </div>

                            <!-- Body Text -->
                            <div class="message-body-text" id="msg-text-<%= msg._id %>"><% if (msg.isDeleted) { %><em style="color: #777; font-size: 0.85rem;"><i class="fas fa-trash-alt" style="margin-right: 4px; font-size: 0.75rem;"></i> This message was deleted</em><% } else { %><%= msg.content %><% if (msg.isEdited) { %> <span style="font-size: 0.72rem; color: #888; font-style: italic; margin-left: 6px;">(edited)</span><% } %><% } %></div>

                            <% if (!msg.isDeleted) { %>
                                <!-- Mod Update Embed (for #new-uploads and #new-updates) -->
                                <% if (msg.modUpdate && msg.modUpdate.name) { %>
                                    <div class="mod-update-embed-box">
                                        <img src="<%= msg.modUpdate.iconUrl || '/images/default-avatar.png' %>" class="mod-embed-icon" alt="Mod Icon">
                                        <div class="mod-embed-info">
                                            <h4><%= msg.modUpdate.name %> <span style="font-size: 0.8rem; color: var(--gold); font-weight: normal;">v<%= msg.modUpdate.version %></span></h4>
                                            <p><%= msg.modUpdate.changelog || 'Download this release safely on GPLMods.' %></p>
                                            <a href="<%= msg.modUpdate.downloadUrl %>" class="btn-send-chat" style="display: inline-flex; text-decoration: none; padding: 4px 14px; font-size: 0.85rem;">
                                                <i class="fas fa-download"></i> View Mod Page
                                            </a>
                                        </div>
                                    </div>
                                <% } %>

                                <!-- Poll Embed -->
                                <% if (msg.poll && msg.poll.question) { %>
                                    <div class="poll-embed-card" id="poll-<%= msg._id %>">
                                        <div class="poll-question"><i class="fas fa-poll" style="color: var(--gold);"></i> <%= msg.poll.question %></div>
                                        <div class="poll-options-list">
                                            <% 
                                                const totalVotes = msg.poll.options.reduce((sum, opt) => sum + (opt.votes ? opt.votes.length : 0), 0);
                                            %>
                                            <% msg.poll.options.forEach((opt, idx) => { %>
                                                <% 
                                                    const voteCount = opt.votes ? opt.votes.length : 0;
                                                    const pct = totalVotes > 0 ? Math.round((voteCount / totalVotes) * 100) : 0;
                                                    const hasVoted = user && opt.votes && opt.votes.some(v => String(v) === String(user._id));
                                                %>
                                                <div class="poll-option-row" onclick="votePoll('<%= msg._id %>', <%= idx %>)">
                                                    <div class="poll-progress-fill" style="width: <%= pct %>%;"></div>
                                                    <span style="position: relative; z-index: 2; font-weight: <%= hasVoted ? '700' : 'normal' %>;">
                                                        <%= hasVoted ? '✓ ' : '' %><%= opt.text %>
                                                    </span>
                                                    <span style="position: relative; z-index: 2; font-size: 0.85rem; color: var(--gold);">
                                                        <%= pct %>% (<%= voteCount %>)
                                                    </span>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </div>
                                <% } %>

                                <!-- Reactions Bar -->
                                <div class="reactions-row" id="reactions-<%= msg._id %>">
                                    <% if (msg.reactions && msg.reactions.length > 0) { %>
                                        <% msg.reactions.forEach(r => { %>
                                            <% const userReacted = user && r.users && r.users.some(u => String(u) === String(user._id)); %>
                                            <div class="reaction-pill <%= userReacted ? 'user-reacted' : '' %>" onclick="toggleReaction('<%= msg._id %>', '<%= r.emoji %>')">
                                                <span><%= r.emoji %></span>
                                                <span><%= r.users.length %></span>
                                            </div>
                                        <% }) %>
                                    <% } %>
                                    <div class="reaction-pill" onclick="quickReactPicker('<%= msg._id %>', event)" title="Add Reaction">
                                        <i class="far fa-smile-plus"></i>
                                    </div>
                                </div>

                                <!-- Message Action Toolbar -->
                                <div class="message-actions-toolbar" style="display: flex; gap: 8px; margin-top: 6px; flex-wrap: wrap; align-items: center;">
                                    <button type="button" class="btn-msg-action" onclick="openClubShareModal('Club Message', '/clubs/<%= club.slug %>#msg-<%= msg._id %>')" title="Share Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: var(--silver); border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                                        <i class="fas fa-share-alt"></i> Share
                                    </button>
                                    <button type="button" class="btn-msg-action" onclick="openForwardModal('<%= msg._id %>')" title="Forward Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: var(--silver); border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                                        <i class="fas fa-reply"></i> Forward
                                    </button>
                                    <% if (hasManageClubPerm) { %>
                                        <button type="button" class="btn-msg-action btn-msg-pin" onclick="togglePinClubMessage('<%= msg._id %>', <%= msg.isPinned ? 'false' : 'true' %>)" title="<%= msg.isPinned ? 'Unpin' : 'Pin' %> Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: <%= msg.isPinned ? 'var(--gold)' : 'var(--silver)' %>; border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                                            <i class="fas fa-thumbtack"></i> <%= msg.isPinned ? 'Unpin' : 'Pin' %>
                                        </button>
                                    <% } %>
                                    <% if (user && (String(user._id) === String(msg.sender ? msg.sender._id : '') || hasManageClubPerm)) { %>
                                        <button type="button" class="btn-msg-action btn-msg-edit" onclick="openEditMessageModal('<%= msg._id %>')" title="Edit Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: var(--gold); border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                        <button type="button" class="btn-msg-action btn-msg-delete" onclick="deleteClubMessage('<%= msg._id %>')" title="Delete Message" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(244,67,54,0.3); color: #ff6b6b; border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </button>
                                    <% } %>
                                    <button type="button" class="btn-translate-msg" onclick="translateMessage('<%= msg._id %>')" style="margin: 0; padding: 3px 8px; font-size: 0.75rem;">
                                        <i class="fas fa-language"></i> Translate
                                    </button>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div style="text-align: center; color: #72767d; margin: auto;">
                    <i class="fas fa-comments" style="font-size: 3rem; margin-bottom: 12px; color: #333645;"></i>
                    <p>Welcome to <strong>#<%= activeChannel ? activeChannel.name : 'general' %></strong>!</p>
                    <p style="font-size: 0.85rem;">This is the start of the channel history.</p>
                </div>
            <% } %>
        </div>

        <!-- Chat Input Bar -->
        <div class="chat-input-bar-wrap">
            <div id="linkWarningBanner" style="display: none; background: rgba(244, 67, 54, 0.2); border: 1px solid #f44336; color: #ff8a80; padding: 8px 12px; border-radius: 8px; margin-bottom: 8px; font-size: 0.85rem;">
                <i class="fas fa-ban"></i> <strong>External links are forbidden!</strong> Only official GPLMods site links are allowed in this chat.
            </div>

            <div class="chat-input-box">
                <textarea id="chatInput" class="chat-textarea" rows="1" placeholder="<%= (activeChannel && activeChannel.isReadOnly && !isStaff && !isClubCreator) ? 'This channel is read-only.' : `Message #${activeChannel ? activeChannel.name : 'general'}...` %>" <%= (activeChannel && activeChannel.isReadOnly && !isStaff && !isClubCreator) ? 'disabled' : '' %>></textarea>

                <div class="chat-input-actions">
                    <!-- Emoticon Button (ASCII faces) -->
                    <button type="button" class="chat-action-btn" onclick="toggleEmoticonPopover()" title="Insert Emoticon">
                        <span style="font-size: 1rem; font-weight: 700;">(✿)</span>
                    </button>

                    <!-- Emoji Picker Button -->
                    <button type="button" class="chat-action-btn" id="emojiPickerBtn" title="Insert Emoji">
                        <i class="far fa-smile"></i>
                    </button>

                    <!-- GIF Selector Button -->
                    <button type="button" class="chat-action-btn" onclick="toggleGifPicker()" title="Insert GIF">
                        <i class="fas fa-film"></i>
                    </button>

                    <!-- Poll Button -->
                    <button type="button" class="chat-action-btn" onclick="openCreatePollModal()" title="Create Poll">
                        <i class="fas fa-poll"></i>
                    </button>

                    <!-- Send Button -->
                    <button type="button" class="btn-send-chat" id="sendChatBtn" onclick="sendClubMessage()">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </div>

            <!-- ASCII Emoticons Popover -->
            <div class="emoticon-popover" id="emoticonPopover">
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('(✿◠‿◠)')">(✿◠‿◠)</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('(づ｡◕‿‿◕｡)づ')">(づ｡◕‿‿◕｡)づ</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('¯\\_(ツ)_/¯')">¯\_(ツ)_/¯</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('(╯°□°)╯︵ ┻━┻')">(╯°□°)╯︵ ┻━┻</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('(•‿•)')">(•‿•)</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('(▀̿Ĺ̯▀̿ ̿)')">(▀̿Ĺ̯▀̿ ̿)</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('(ง\'̀-\'́)ง')">(ง'̀-'́)ง</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('ʕ•ᴥ•ʔ')">ʕ•ᴥ•ʔ</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('(ʘ‿ʘ)')">(ʘ‿ʘ)</button>
            </div>

            <!-- GIF Picker Popover -->
            <div class="gif-picker-modal" id="gifPickerModal">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="font-weight: 700; color: #fff; font-size: 0.95rem;">Select Animated GIF</span>
                    <button type="button" onclick="toggleGifPicker()" style="background: none; border: none; color: #aaa; cursor: pointer;">&times;</button>
                </div>
                <div class="gif-grid">
                    <div class="gif-item" onclick="insertGif('https://media.giphy.com/media/artj92V8o75VPL7AeQ/giphy.gif')">
                        <img src="https://media.giphy.com/media/artj92V8o75VPL7AeQ/giphy.gif" alt="Gaming GIF">
                    </div>
                    <div class="gif-item" onclick="insertGif('https://media.giphy.com/media/blSTtZehjAZ8I/giphy.gif')">
                        <img src="https://media.giphy.com/media/blSTtZehjAZ8I/giphy.gif" alt="Victory GIF">
                    </div>
                    <div class="gif-item" onclick="insertGif('https://media.giphy.com/media/LmN8OYiY4m0X85K0Zz/giphy.gif')">
                        <img src="https://media.giphy.com/media/LmN8OYiY4m0X85K0Zz/giphy.gif" alt="Rocket GIF">
                    </div>
                    <div class="gif-item" onclick="insertGif('https://media.giphy.com/media/3o7abKhOpu0NwenH3O/giphy.gif')">
                        <img src="https://media.giphy.com/media/3o7abKhOpu0NwenH3O/giphy.gif" alt="Hype GIF">
                    </div>
                </div>
            </div>

            <!-- Lightweight Emoji Picker Element -->
            <emoji-picker class="dark" id="mainEmojiPicker" style="position: absolute; bottom: 70px; right: 80px; display: none; z-index: 1000;"></emoji-picker>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- 4. RIGHT SIDEBAR: MEMBERS LIST             -->
    <!-- ========================================== -->
    <div class="discord-members-col" id="membersSidebar">
        <!-- Mobile Members Header -->
        <div class="members-mobile-header">
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-users" style="color: var(--gold);"></i>
                <span style="font-weight: 700; color: #fff; font-size: 0.95rem;">Club Members</span>
            </div>
            <button type="button" class="drawer-close-btn" onclick="toggleMembersSidebar()" title="Close Members">&times;</button>
        </div>
        <div class="members-scroll-area">
            <!-- SITE STAFF SECTION -->
            <% const staffMembers = members.filter(m => m.user && ['owner', 'admin'].includes(m.user.role)); %>
            <% if (staffMembers.length > 0) { %>
                <div class="member-group-header"><i class="fas fa-crown" style="color: var(--gold); margin-right: 6px;"></i> SITE STAFF — <%= staffMembers.length %></div>
                <% staffMembers.forEach(sm => { %>
                    <div class="member-card-row" onclick="window.location.href='/users/<%= sm.user.username %>'">
                        <div class="member-avatar-wrap">
                            <% const smAvatar = (sm.user.signedAvatarUrl && sm.user.signedAvatarUrl !== '/images/default-avatar.png') ? sm.user.signedAvatarUrl : (sm.user.cardAvatarUrl || sm.user.avatarUrl || sm.user.avatar || (sm.user.username === 'GPLMods' ? '/images/team-logo.png' : '/images/default-avatar.png')); %>
                            <img src="<%= smAvatar %>" class="member-avatar-img" alt="<%= sm.user.username %>" onerror="this.onerror=null; this.src=(this.alt==='GPLMods')?'/images/team-logo.png':'/images/default-avatar.png';">
                            <div class="online-dot"></div>
                        </div>
                        <div class="member-meta-box">
                            <span class="member-display-name" style="color: <%= sm.user.role === 'owner' ? 'var(--gold)' : '#64b5f6' %>;">
                                <%= sm.user.username %>
                            </span>
                            <span style="font-size: 0.72rem; color: #8e9297;"><%= sm.user.role === 'owner' ? 'Site Owner' : 'Site Admin' %></span>
                        </div>
                    </div>
                <% }) %>
            <% } %>

            <!-- CLUB CREATOR -->
            <% const creatorMember = members.find(m => m.user && String(m.user._id) === String(club.creator._id || club.creator)); %>
            <% if (creatorMember && (!staffMembers.some(sm => String(sm.user._id) === String(creatorMember.user._id)))) { %>
                <div class="member-group-header" style="margin-top: 14px;"><i class="fas fa-palette" style="color: #ffab91; margin-right: 6px;"></i> CLUB CREATOR — 1</div>
                <div class="member-card-row" onclick="window.location.href='/users/<%= creatorMember.user.username %>'">
                    <div class="member-avatar-wrap">
                        <% const crAvatar = (creatorMember.user.signedAvatarUrl && creatorMember.user.signedAvatarUrl !== '/images/default-avatar.png') ? creatorMember.user.signedAvatarUrl : (creatorMember.user.cardAvatarUrl || creatorMember.user.avatarUrl || creatorMember.user.avatar || (creatorMember.user.username === 'GPLMods' ? '/images/team-logo.png' : '/images/default-avatar.png')); %>
                        <img src="<%= crAvatar %>" class="member-avatar-img" alt="<%= creatorMember.user.username %>" onerror="this.onerror=null; this.src=(this.alt==='GPLMods')?'/images/team-logo.png':'/images/default-avatar.png';">
                        <div class="online-dot"></div>
                    </div>
                    <div class="member-meta-box">
                        <span class="member-display-name" style="color: #ffab91;"><%= creatorMember.user.username %></span>
                        <span style="font-size: 0.72rem; color: #8e9297;">Club Owner</span>
                    </div>
                </div>
            <% } %>

            <!-- ONLINE MEMBERS -->
            <div class="member-group-header" style="margin-top: 14px;"><i class="fas fa-circle" style="color: #43b581; font-size: 0.65rem; margin-right: 6px;"></i> ONLINE MEMBERS — <span id="onlineCountNum"><%= members.length %></span></div>
            <div id="onlineMembersList">
                <% members.forEach(mem => { %>
                    <% if (mem.user) { %>
                        <div class="member-card-row" onclick="window.location.href='/users/<%= mem.user.username %>'">
                            <div class="member-avatar-wrap">
                                <% const memAvatar = (mem.user.signedAvatarUrl && mem.user.signedAvatarUrl !== '/images/default-avatar.png') ? mem.user.signedAvatarUrl : (mem.user.cardAvatarUrl || mem.user.avatarUrl || mem.user.avatar || (mem.user.username === 'GPLMods' ? '/images/team-logo.png' : '/images/default-avatar.png')); %>
                                <img src="<%= memAvatar %>" class="member-avatar-img" alt="<%= mem.user.username %>" onerror="this.onerror=null; this.src=(this.alt==='GPLMods')?'/images/team-logo.png':'/images/default-avatar.png';">
                                <div class="online-dot"></div>
                            </div>
                            <div class="member-meta-box">
                                <span class="member-display-name"><%= mem.user.username %></span>
                                <% if (mem.roles && mem.roles.length > 0) { %>
                                    <span style="font-size: 0.72rem; color: <%= mem.roles[0].color || '#99aab5' %>;"><%= mem.roles[0].name %></span>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODALS (CREATE CHANNEL, POLL, SHARE, ETC)  -->
<!-- ========================================== -->

<!-- Create Channel Modal -->
<div class="gpl-modal-backdrop" id="createChannelModal">
    <div class="gpl-modal-box">
        <h3 style="color: #fff; margin-top: 0; margin-bottom: 16px;"><i class="fas fa-hashtag" style="color: var(--gold);"></i> Create Text Channel</h3>
        <form action="/clubs/<%= club.slug %>/channels" method="POST">
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Channel Name</label>
                <input type="text" name="name" placeholder="e.g. android-mods, general-chat" required style="width: 100%; background: #0d0e12; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px; box-sizing: border-box;">
            </div>
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Channel Topic</label>
                <input type="text" name="topic" placeholder="Channel purpose or guidelines..." style="width: 100%; background: #0d0e12; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px; box-sizing: border-box;">
            </div>
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Channel Type</label>
                <select name="type" style="width: 100%; background: #0d0e12; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px; box-sizing: border-box;">
                    <option value="text">Text Channel</option>
                    <option value="polls">Community Polls Channel</option>
                </select>
            </div>
            <div style="margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                <input type="checkbox" name="isPrivate" id="channelPrivateCheck">
                <label for="channelPrivateCheck" style="color: #fff; font-size: 0.88rem;">Private / Role-Specific Channel</label>
            </div>
            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" onclick="closeCreateChannelModal()" style="background: transparent; border: 1px solid #444; color: var(--silver); padding: 8px 16px; border-radius: 8px; cursor: pointer;">Cancel</button>
                <button type="submit" style="background: var(--gold); border: none; color: #000; font-weight: 700; padding: 8px 18px; border-radius: 8px; cursor: pointer;">Create Channel</button>
            </div>
        </form>
    </div>
</div>

<!-- Create Poll Modal -->
<div class="gpl-modal-backdrop" id="createPollModal">
    <div class="gpl-modal-box">
        <h3 style="color: #fff; margin-top: 0; margin-bottom: 16px;"><i class="fas fa-poll" style="color: var(--gold);"></i> Create Community Poll</h3>
        <form action="/clubs/<%= club.slug %>/channels/<%= activeChannel ? activeChannel._id : '' %>/poll" method="POST">
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Poll Question</label>
                <input type="text" name="question" placeholder="e.g. Which platform should we focus on next?" required style="width: 100%; background: #0d0e12; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px; box-sizing: border-box;">
            </div>
            <div style="margin-bottom: 18px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Options (One per line, minimum 2)</label>
                <textarea name="options" rows="4" placeholder="Android APK&#10;iOS IPA&#10;Windows Software" required style="width: 100%; background: #0d0e12; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px; box-sizing: border-box;"></textarea>
            </div>
            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" onclick="closeCreatePollModal()" style="background: transparent; border: 1px solid #444; color: var(--silver); padding: 8px 16px; border-radius: 8px; cursor: pointer;">Cancel</button>
                <button type="submit" style="background: var(--gold); border: none; color: #000; font-weight: 700; padding: 8px 18px; border-radius: 8px; cursor: pointer;">Launch Poll</button>
            </div>
        </form>
    </div>
</div>

<!-- Tracked Creator Profiles Modal -->
<div class="gpl-modal-backdrop" id="trackedCreatorsModal">
    <div class="gpl-modal-box">
        <h3 style="color: #fff; margin-top: 0; margin-bottom: 14px;"><i class="fas fa-rss" style="color: var(--gold);"></i> Track Creator Mod Updates</h3>
        <p style="color: var(--silver); font-size: 0.85rem; margin-bottom: 18px;">
            Assign developer/creator profiles to track. When they upload a new mod or publish an update, an automated rich card will be posted to #new-uploads and #new-updates.
        </p>
        <form action="/clubs/<%= club.slug %>/tracked-creators" method="POST">
            <div style="margin-bottom: 18px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Creator Username</label>
                <input type="text" name="username" placeholder="Exact username on GPLMods..." required style="width: 100%; background: #0d0e12; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px; box-sizing: border-box;">
            </div>
            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" onclick="closeTrackedCreatorsModal()" style="background: transparent; border: 1px solid #444; color: var(--silver); padding: 8px 16px; border-radius: 8px; cursor: pointer;">Cancel</button>
                <button type="submit" style="background: var(--gold); border: none; color: #000; font-weight: 700; padding: 8px 18px; border-radius: 8px; cursor: pointer;">Add Tracked Creator</button>
            </div>
        </form>
    </div>
</div>

<!-- Forward Message Modal -->
<div class="gpl-modal-backdrop" id="clubForwardModal" style="display: none; position: fixed; inset: 0; z-index: 99999; background: rgba(0,0,0,0.75); align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="gpl-modal-box" style="background: #14151b; border: 1px solid var(--gold); border-radius: 16px; padding: 24px; width: 90%; max-width: 440px; box-shadow: 0 15px 40px rgba(0,0,0,0.8);">
        <h3 style="margin: 0 0 14px 0; color: #fff; font-size: 1.15rem; display: flex; align-items: center; gap: 8px;">
            <i class="fas fa-share" style="color: var(--gold);"></i> Forward Message
        </h3>
        <p style="color: var(--silver); font-size: 0.85rem; margin-bottom: 14px;">Select the channel where you want to forward this message:</p>
        <input type="hidden" id="forwardMessageId">
        <select id="forwardChannelSelect" style="width: 100%; background: #0d0e12; border: 1px solid #333645; color: #fff; padding: 10px 14px; border-radius: 8px; font-size: 0.9rem; margin-bottom: 18px;">
            <% channels.forEach(c => { %>
                <option value="<%= c._id %>">#<%= c.name %></option>
            <% }) %>
        </select>
        <div style="display: flex; gap: 10px; justify-content: flex-end;">
            <button type="button" onclick="closeForwardModal()" style="background: transparent; border: 1px solid #444; color: var(--silver); padding: 8px 16px; border-radius: 8px; cursor: pointer;">Cancel</button>
            <button type="button" onclick="submitForwardMessage()" style="background: var(--gold); border: none; color: #000; font-weight: 700; padding: 8px 20px; border-radius: 8px; cursor: pointer;">Forward Now</button>
        </div>
    </div>
</div>

<!-- Edit Message Modal -->
<div class="gpl-modal-backdrop" id="clubEditModal" style="display: none; position: fixed; inset: 0; z-index: 99999; background: rgba(0,0,0,0.75); align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="gpl-modal-box" style="background: #14151b; border: 1px solid var(--gold); border-radius: 16px; padding: 24px; width: 90%; max-width: 480px; box-shadow: 0 15px 40px rgba(0,0,0,0.8);">
        <h3 style="margin: 0 0 14px 0; color: #fff; font-size: 1.15rem; display: flex; align-items: center; gap: 8px;">
            <i class="fas fa-edit" style="color: var(--gold);"></i> Edit Message
