    async function loadPersonalTrackedCreators() {
        const container = document.getElementById('personalTrackedList');
        if (!container) return;

        try {
            const res = await fetch('/api/user/tracking');
            const data = await res.json();
            if (!data.success || !data.trackedCreators || data.trackedCreators.length === 0) {
                container.innerHTML = '<div style="text-align: center; color: var(--silver); padding: 18px; font-size: 0.82rem;">You are not tracking any creator profiles yet.</div>';
                return;
            }

            container.innerHTML = data.trackedCreators.map(item => {
                const c = item.creator || {};
                const cName = c.username || 'Unknown';
                const cAvatar = c.signedAvatarUrl || c.avatarUrl || '/images/default-avatar.png';
                const tType = item.trackType || 'both';

                return `
                    <div class="creator-track-row" style="display: flex; align-items: center; justify-content: space-between; background: #0d0e12; border: 1px solid #282a36; border-radius: 10px; padding: 10px 14px; gap: 10px;">
                        <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
                            <img src="${cAvatar}" style="width: 34px; height: 34px; border-radius: 50%; object-fit: cover; flex-shrink: 0;" onerror="this.src='/images/default-avatar.png'">
                            <div style="overflow: hidden;">
                                <strong style="color: #fff; display: block; font-size: 0.88rem; text-overflow: ellipsis; white-space: nowrap;">${cName}</strong>
                                <span style="font-size: 0.72rem; color: var(--silver); text-transform: capitalize;">Tracking: ${tType}</span>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 6px; flex-shrink: 0;">
                            <button type="button" onclick="updatePersonalTrackType('${c._id}', '${tType === 'both' ? 'uploads' : (tType === 'uploads' ? 'updates' : 'both')}')" style="background: rgba(255,215,0,0.1); border: 1px solid var(--gold); color: var(--gold); border-radius: 6px; padding: 4px 8px; font-size: 0.72rem; font-weight: 600; cursor: pointer;" title="Cycle tracking preference">
                                <i class="fas fa-sliders-h"></i> ${tType === 'both' ? 'Both' : (tType === 'uploads' ? 'Uploads' : 'Updates')}
                            </button>
                            <button type="button" onclick="removePersonalTrackedCreator('${c._id}', '${cName}')" style="background: rgba(231,76,60,0.12); border: 1px solid rgba(231,76,60,0.3); color: #ff8a80; border-radius: 6px; padding: 4px 8px; font-size: 0.75rem; cursor: pointer;" title="Stop tracking">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        } catch (err) {
            container.innerHTML = '<div style="color: #ff8a80; padding: 12px; font-size: 0.8rem;">Failed to load tracked creators.</div>';
        }
    }

