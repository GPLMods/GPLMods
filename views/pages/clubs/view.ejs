        }
        .message-username {
            font-size: 0.9rem;
        }
        .message-body-text {
            font-size: 0.9rem;
        }
        .chat-input-bar-wrap {
            padding: 0 8px 8px;
        }
        .chat-input-box {
            padding: 0 8px;
            border-radius: 10px;
        }
        .chat-textarea {
            font-size: 16px; /* Prevents auto-zoom in mobile browsers */
