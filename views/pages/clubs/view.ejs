        }
        .discord-members-col {
            position: fixed;
            top: 0;
            bottom: 0;
            right: 0;
            width: 280px;
            max-width: 85vw;
            height: 100dvh;
            height: 100%;
            z-index: 1100;
            transform: translateX(100%);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            border-left: 1px solid #282a38;
            box-shadow: -6px 0 30px rgba(0, 0, 0, 0.8);
