    async function submitCreateRole(e) {
        e.preventDefault();
        const name = document.getElementById('newRoleName')?.value?.trim();
        const badgeIcon = document.getElementById('newRoleBadge')?.value?.trim() || '🛡️';
        const color = document.getElementById('newRoleColor')?.value || '#FFD700';
        const canManageChannels = document.getElementById('permManageChannels')?.checked || false;
        const canKickMembers = document.getElementById('permKickMembers')?.checked || false;
        const canPostPolls = document.getElementById('permPostPolls')?.checked || false;

        if (!name) return showGplToast('Role name is required.', 'warning');

        try {
            const res = await fetch(`/clubs/<%= club.slug %>/roles`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    name,
                    badgeIcon,
                    color,
                    canManageChannels,
                    canKickMembers,
                    canPostPolls
                })
            });
            const data = await res.json();
            if (data.success && data.role) {
                showGplToast(`Role "${data.role.name}" created successfully!`, 'success');

                const list = document.getElementById('guiRolesDisplayList');
                if (list) {
                    const row = document.createElement('div');
                    row.className = 'role-list-row';
                    row.id = `roleRow-${data.role._id}`;
                    row.style.cssText = 'display: flex; align-items: center; justify-content: space-between; background: #14151b; border: 1px solid #282a36; border-radius: 8px; padding: 8px 12px; margin-bottom: 6px;';
                    row.innerHTML = `
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span class="discord-sidebar-role-pill" style="color: ${data.role.color}; background: ${data.role.color}18; border: 1px solid ${data.role.color}40; padding: 4px 10px; border-radius: 12px; font-size: 0.82rem; display: inline-flex; align-items: center; gap: 6px;">
                                ${data.role.badgeIcon || '🛡️'} ${data.role.name}
                            </span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <button type="button" class="btn-role-action edit" onclick="openEditRoleModal('${data.role._id}', '${data.role.name}', '${data.role.badgeIcon || '🛡️'}', '${data.role.color}', ${data.role.permissions?.canManageChannels || false}, ${data.role.permissions?.canKickMembers || false}, ${data.role.permissions?.canPostPolls || false})" title="Edit Role">
                                <i class="fas fa-pencil-alt"></i> Edit
                            </button>
                            <button type="button" class="btn-role-action delete" onclick="confirmDeleteRole('${data.role._id}', '${data.role.name}')" title="Delete Role">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    `;
                    list.appendChild(row);
                }

                // Append checkbox to member roles list
                const checkList = document.getElementById('memberRolesCheckboxesList');
                if (checkList) {
                    const label = document.createElement('label');
                    label.className = 'role-checkbox-item';
                    label.id = `roleLabel-${data.role._id}`;
                    label.style.cssText = 'display: flex; align-items: center; gap: 8px; background: #14151b; border: 1px solid #2a2d3a; border-radius: 8px; padding: 8px 10px; cursor: pointer; font-size: 0.82rem; color: #fff;';
                    label.innerHTML = `
                        <input type="checkbox" class="member-role-checkbox" value="${data.role._id}" onchange="onMemberRoleCheckboxChange()">
                        <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: ${data.role.color || '#5865F2'}; flex-shrink: 0;"></span>
                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${data.role.badgeIcon || '🛡️'} ${data.role.name}</span>
                    `;
                    checkList.appendChild(label);
                }

                document.getElementById('newRoleName').value = '';
            } else {
                showGplToast(data.error || 'Failed to create role.', 'error');
            }
        } catch (err) {
            showGplToast('An error occurred while creating role.', 'error');
        }
    }

