    }

    function closeEditRoleModal() {
        const modal = document.getElementById('editRoleModal');
        if (modal) modal.style.display = 'none';
    }

    async function submitEditRole(e) {
        e.preventDefault();
        const roleId = document.getElementById('editRoleId')?.value;
        const name = document.getElementById('editRoleNameInput')?.value?.trim();
        const badgeIcon = document.getElementById('editRoleBadgeInput')?.value?.trim() || '🛡️';
        const color = document.getElementById('editRoleColorInput')?.value || '#FFD700';
        const canManageChannels = document.getElementById('editPermManageChannels')?.checked || false;
        const canKickMembers = document.getElementById('editPermKickMembers')?.checked || false;
        const canPostPolls = document.getElementById('editPermPostPolls')?.checked || false;

        if (!roleId || !name) return showGplToast('Role name is required.', 'warning');

        try {
            const res = await fetch(`/clubs/<%= club.slug %>/roles/${roleId}/edit`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, badgeIcon, color, canManageChannels, canKickMembers, canPostPolls })
            });
            const data = await res.json();
            if (data.success) {
                showGplToast(`Role "${name}" updated successfully!`, 'success');
                closeEditRoleModal();
                setTimeout(() => window.location.reload(), 800);
            } else {
                showGplToast(data.error || 'Failed to update role.', 'error');
            }
        } catch (err) {
            showGplToast('Error updating role.', 'error');
        }
    }

    function confirmDeleteRole(roleId, roleName) {
        openGplConfirmModal({
            title: `Delete Role "${roleName}"?`,
            message: `Are you sure you want to delete "${roleName}"? It will be automatically removed from all members and private channel permissions.`,
            confirmText: 'Delete Role',
            isDanger: true,
            onConfirm: async () => {
                try {
                    const res = await fetch(`/clubs/<%= club.slug %>/roles/${roleId}/delete`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await res.json();
                    if (data.success) {
                        showGplToast(`Role "${roleName}" deleted.`, 'success');
                        const row = document.getElementById(`roleRow-${roleId}`);
                        if (row) row.remove();
                        const checkLabel = document.getElementById(`roleLabel-${roleId}`);
                        if (checkLabel) checkLabel.remove();
                    } else {
                        showGplToast(data.error || 'Failed to delete role.', 'error');
                    }
                } catch (err) {
                    showGplToast('Error deleting role.', 'error');
                }
            }
        });
    }

    // Member Roles Assignment (Strict 10 Roles Maximum)
    function onSelectMemberForRoles(memberId) {
        const section = document.getElementById('memberRolesCheckboxesSection');
        if (!memberId) {
            if (section) section.style.display = 'none';
            return;
        }

        const select = document.getElementById('assignTargetMember');
        const selectedOpt = select.querySelector(`option[value="${memberId}"]`);
        const rolesAttr = selectedOpt ? selectedOpt.getAttribute('data-roles') : '';
        const memberRoleIds = rolesAttr ? rolesAttr.split(',').filter(Boolean) : [];

        // Check assigned roles, uncheck rest
        document.querySelectorAll('.member-role-checkbox').forEach(cb => {
            cb.checked = memberRoleIds.includes(cb.value);
        });

        if (section) section.style.display = 'block';
        onMemberRoleCheckboxChange();
    }

    function onMemberRoleCheckboxChange() {
        const allCheckboxes = document.querySelectorAll('.member-role-checkbox');
        const checkedCheckboxes = document.querySelectorAll('.member-role-checkbox:checked');
        const count = checkedCheckboxes.length;

        const counterBadge = document.getElementById('memberRoleCounterBadge');
        if (counterBadge) {
            counterBadge.textContent = `${count} / 10 Roles Assigned`;
            counterBadge.style.borderColor = (count >= 10) ? '#ff453a' : 'var(--gold)';
            counterBadge.style.color = (count >= 10) ? '#ff8a80' : 'var(--gold)';
        }

        if (count >= 10) {
            allCheckboxes.forEach(cb => {
                if (!cb.checked) {
                    cb.disabled = true;
                    const parent = cb.closest('.role-checkbox-item');
                    if (parent) parent.classList.add('max-roles-disabled');
                }
            });
            if (count > 10) {
                showGplToast('Maximum 10 roles reached for this member.', 'warning');
            }
        } else {
            allCheckboxes.forEach(cb => {
                cb.disabled = false;
                const parent = cb.closest('.role-checkbox-item');
                if (parent) parent.classList.remove('max-roles-disabled');
            });
        }
    }

    async function saveMemberAssignedRoles() {
        const memberId = document.getElementById('assignTargetMember')?.value;
        if (!memberId) return showGplToast('Please select a member first.', 'warning');

        const checkedBoxes = Array.from(document.querySelectorAll('.member-role-checkbox:checked'));
        if (checkedBoxes.length > 10) {
            return showGplToast('Cannot assign more than 10 roles to a member.', 'error');
        }

        const roleIds = checkedBoxes.map(cb => cb.value);
        const saveBtn = document.getElementById('btnSaveMemberRoles');
        if (saveBtn) {
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
        }

        try {
            const res = await fetch(`/clubs/<%= club.slug %>/members/${memberId}/roles`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ roles: roleIds })
            });
            const data = await res.json();
            if (data.success) {
                showGplToast('Member roles saved successfully!', 'success');
                const select = document.getElementById('assignTargetMember');
                const opt = select.querySelector(`option[value="${memberId}"]`);
                if (opt) {
                    opt.setAttribute('data-roles', roleIds.join(','));
                }
            } else {
                showGplToast(data.error || 'Failed to update member roles.', 'error');
            }
        } catch (err) {
            showGplToast('Error saving member roles.', 'error');
        } finally {
            if (saveBtn) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="fas fa-save"></i> Save Member Roles';
            }
        }
    }

    // ==========================================
    // CHANNEL EDIT, PRIVACY & DELETE
    // ==========================================
    async function saveChannelInformation(e) {
        e.preventDefault();
        if (!channelId) return;

        const name = document.getElementById('editChannelName')?.value?.trim();
        const topic = document.getElementById('editChannelTopic')?.value?.trim();
        const type = document.getElementById('editChannelTypeInput')?.value;

        try {
            const res = await fetch(`/clubs/<%= club.slug %>/channels/${channelId}/edit`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ name, topic, type })
            });
            const data = await res.json();
            if (data.success) {
                showGplToast('Channel information updated successfully!', 'success');
                setTimeout(() => window.location.reload(), 600);
            } else {
                showGplToast(data.error || 'Failed to update channel.', 'error');
            }
        } catch (err) {
            showGplToast('An error occurred while saving channel information.', 'error');
        }
    }

    async function saveChannelPrivacyAccess(e) {
        e.preventDefault();
        if (!channelId) return;

        const accessModeRadio = document.querySelector('input[name="accessMode"]:checked');
        const accessMode = accessModeRadio ? accessModeRadio.value : 'open';

        const roleCheckboxes = document.querySelectorAll('#editChanRolesChecklistWrap input[name="allowedRoles"]:checked');
        const allowedRoles = Array.from(roleCheckboxes).map(cb => cb.value);

        try {
            const res = await fetch(`/clubs/<%= club.slug %>/channels/${channelId}/edit`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ accessMode, allowedRoles })
            });
            const data = await res.json();
            if (data.success) {
                showGplToast('Channel privacy and role access updated successfully!', 'success');
                setTimeout(() => window.location.reload(), 600);
            } else {
                showGplToast(data.error || 'Failed to update channel access.', 'error');
            }
        } catch (err) {
            showGplToast('An error occurred while saving channel privacy settings.', 'error');
        }
    }

    function confirmDeleteActiveChannel() {
        if (!channelId) return;
        openGplConfirmModal({
            title: 'Delete Channel Permanently?',
            message: 'Are you ABSOLUTELY sure you want to permanently delete this channel? All chat messages, media, and polls in this channel will be completely erased. This cannot be undone.',
            confirmText: 'Delete Channel',
            isDanger: true,
            onConfirm: async () => {
                try {
                    const res = await fetch(`/clubs/<%= club.slug %>/channels/${channelId}/delete`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                    const data = await res.json();
                    if (data.success) {
                        showGplToast('Channel deleted successfully.', 'success');
                        window.location.href = data.fallbackUrl || `/clubs/<%= club.slug %>`;
                    } else {
                        showGplToast(data.error || 'Failed to delete channel.', 'error');
                    }
                } catch (err) {
                    showGplToast('An error occurred while deleting the channel.', 'error');
                }
            }
        });
    }

    // Close Modals on backdrop click
    const channelSettingsModalBackdrop = document.getElementById('channelSettingsGUIModal');
    if (channelSettingsModalBackdrop) {
        channelSettingsModalBackdrop.addEventListener('click', (e) => {
            if (e.target === channelSettingsModalBackdrop) {
                closeChannelSettingsGUI();
            }
        });
    }

    const uniqueInviteBackdrop = document.getElementById('uniqueInviteModal');
    if (uniqueInviteBackdrop) {
        uniqueInviteBackdrop.addEventListener('click', (e) => {
            if (e.target === uniqueInviteBackdrop) {
                closeUniqueInviteModal();
            }
        });
    }

    const trackedCreatorsBackdrop = document.getElementById('trackedCreatorsModal');
    if (trackedCreatorsBackdrop) {
        trackedCreatorsBackdrop.addEventListener('click', (e) => {
            if (e.target === trackedCreatorsBackdrop) {
                closeTrackedCreatorsModal();
            }
        });
    }

    const editRoleBackdrop = document.getElementById('editRoleModal');
    if (editRoleBackdrop) {
        editRoleBackdrop.addEventListener('click', (e) => {
            if (e.target === editRoleBackdrop) {
                closeEditRoleModal();
            }
        });
    }
</script>

