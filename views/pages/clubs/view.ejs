    /* Custom Select for Channel Modals */
    .chan-custom-select-wrapper {
        position: relative;
        user-select: none;
        width: 100%;
    }
    .chan-custom-select {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 11px 14px;
        border-radius: 8px;
        border: 1.5px solid #2e3142;
        background-color: #0d0e14;
        cursor: pointer;
        transition: all 0.25s ease;
        min-height: 44px;
        color: #fff;
    }
    .chan-custom-select:hover {
        border-color: rgba(255, 215, 0, 0.5);
    }
    .chan-custom-select-wrapper.open .chan-custom-select {
        border-color: var(--gold);
        box-shadow: 0 0 12px rgba(255, 215, 0, 0.25);
    }
    .chan-custom-select .fa-chevron-down {
        transition: transform 0.25s ease, color 0.2s ease;
    }
    .chan-custom-select-wrapper.open .chan-custom-select .fa-chevron-down {
        transform: rotate(180deg);
        color: var(--gold);
    }
    .chan-custom-select-text {
        color: #fff;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .chan-custom-options {
        position: absolute;
        top: calc(100% + 5px);
        left: 0;
        right: 0;
        background: #14151e;
        border: 1px solid var(--gold);
        border-radius: 10px;
        box-shadow: 0 14px 35px rgba(0, 0, 0, 0.85), 0 0 15px rgba(255, 215, 0, 0.15);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-6px);
        transition: all 0.25s ease;
        z-index: 1050;
        max-height: 240px;
        overflow-y: auto;
        padding: 6px;
    }
    .chan-custom-select-wrapper.open .chan-custom-options {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    .chan-custom-option {
        padding: 10px 12px;
        border-radius: 8px;
        margin-bottom: 2px;
        color: var(--silver);
        font-size: 0.88rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 12px;
        border: 1px solid transparent;
        transition: all 0.2s ease;
    }
    .chan-custom-option:hover {
        background-color: rgba(255, 215, 0, 0.1);
        border-color: rgba(255, 215, 0, 0.3);
        color: #fff;
        transform: translateX(2px);
    }
    .chan-custom-option.selected {
        background-color: rgba(255, 215, 0, 0.16);
        border-color: rgba(255, 215, 0, 0.45);
        color: var(--gold);
        font-weight: 700;
    }

    /* Channel Type Pills in Topbar */
    .chan-type-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        margin-left: 6px;
    }
    .chan-type-pill.text { background: rgba(255, 215, 0, 0.12); color: var(--gold); border: 1px solid rgba(255, 215, 0, 0.3); }
    .chan-type-pill.polls { background: rgba(56, 239, 125, 0.12); color: #38ef7d; border: 1px solid rgba(56, 239, 125, 0.3); }
    .chan-type-pill.announce { background: rgba(0, 210, 255, 0.12); color: #00d2ff; border: 1px solid rgba(0, 210, 255, 0.3); }
    .chan-type-pill.rules { background: rgba(186, 104, 200, 0.12); color: #ba68c8; border: 1px solid rgba(186, 104, 200, 0.3); }
    .chan-type-pill.feeds { background: rgba(255, 152, 0, 0.12); color: #ff9800; border: 1px solid rgba(255, 152, 0, 0.3); }
    .chan-type-pill.locked { background: rgba(244, 67, 54, 0.15); color: #ff8a80; border: 1px solid rgba(244, 67, 54, 0.35); }
    .chan-type-pill.priv { background: rgba(142, 68, 173, 0.2); color: #bb86fc; border: 1px solid rgba(142, 68, 173, 0.4); }

    /* Share Community Modal Responsive Grid */
    .club-share-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }
    .club-share-social-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 12px 6px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 0.76rem;
        font-weight: 600;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        box-sizing: border-box;
    }
    .club-share-social-btn:hover {
        transform: translateY(-2px);
    }
    .club-share-social-btn i {
        font-size: 1.35rem;
    }
    .share-btn-whatsapp { background: rgba(37,211,102,0.1); border: 1px solid rgba(37,211,102,0.3); color: #25d366; }
    .share-btn-telegram { background: rgba(0,136,204,0.1); border: 1px solid rgba(0,136,204,0.3); color: #0088cc; }
    .share-btn-twitter  { background: rgba(29,161,242,0.1); border: 1px solid rgba(29,161,242,0.3); color: #1da1f2; }
    .share-btn-reddit   { background: rgba(255,69,0,0.1); border: 1px solid rgba(255,69,0,0.3); color: #ff4500; }
    @media (max-width: 480px) {
        .club-share-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 10px;
        }
    }

    /* Tracked Creator Custom Option Selector Pills */
    .gpl-track-pill-group {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .track-pill-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #14151b;
        border: 1px solid #333645;
        padding: 7px 14px;
        border-radius: 20px;
        font-size: 0.82rem;
        color: var(--silver);
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
    }
    .track-pill-label:hover {
        border-color: rgba(255, 215, 0, 0.4);
        color: #fff;
    }
    .track-pill-label input[type="radio"] {
        appearance: none;
        -webkit-appearance: none;
        width: 14px;
        height: 14px;
        border: 1.5px solid #555869;
        border-radius: 50%;
        outline: none;
        margin: 0;
        cursor: pointer;
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }
    .track-pill-label input[type="radio"]:checked {
        border-color: var(--gold);
        background: var(--gold);
        box-shadow: 0 0 8px rgba(255, 215, 0, 0.5);
    }
    .track-pill-label input[type="radio"]:checked::after {
        content: '';
        width: 5px;
        height: 5px;
        background: #14151b;
        border-radius: 50%;
    }
    .track-pill-label.active,
    .track-pill-label:has(input[type="radio"]:checked) {
        background: rgba(255, 215, 0, 0.12) !important;
        border-color: var(--gold) !important;
        color: var(--gold) !important;
        box-shadow: 0 0 10px rgba(255, 215, 0, 0.15) !important;
        font-weight: 600;
    }

    /* Typing UI Indicator */
    .club-typing-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 5px 14px;
        background: rgba(15, 16, 21, 0.95);
        border-top: 1px solid rgba(255, 215, 0, 0.15);
        border-radius: 6px 6px 0 0;
        font-size: 0.78rem;
        color: var(--silver);
        animation: fadeInTyping 0.2s ease-out;
    }
    @keyframes fadeInTyping {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .typing-bubble-dots {
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }
    .typing-bubble-dots .typing-dot {
        width: 4px;
        height: 4px;
        background: var(--gold);
        border-radius: 50%;
        animation: typingDotPulse 1.4s infinite ease-in-out;
    }
    .typing-bubble-dots .typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .typing-bubble-dots .typing-dot:nth-child(3) { animation-delay: 0.4s; }
    @keyframes typingDotPulse {
        0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
        40% { transform: translateY(-4px); opacity: 1; }
    }
    .typing-usernames-text {
        font-weight: 500;
        color: #fff;
    }

    /* Read-Only Locked Full Box in Chat */
    .chat-locked-full-box {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(244, 67, 54, 0.1);
        border: 1px solid rgba(244, 67, 54, 0.35);
        border-radius: 10px;
        padding: 12px 18px;
        margin: 6px 0;
    }

    /* Channel Settings & Options GUI Modal */
    .channel-menu-gui-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.78);
        backdrop-filter: blur(6px);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }
    .channel-menu-gui-box {
        background: #14151b;
        border: 1px solid #333645;
        border-radius: 18px;
        width: 100%;
        max-width: 680px;
        max-height: 88vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 20px rgba(255, 215, 0, 0.1);
    }
    .channel-menu-gui-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        border-bottom: 1px solid #282a36;
        background: #0d0e12;
    }
    .channel-menu-gui-header h3 {
        margin: 0;
        font-size: 1.15rem;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .channel-menu-tabs-bar {
        display: flex;
        gap: 4px;
        padding: 8px 16px;
        background: #101117;
        border-bottom: 1px solid #282a36;
        overflow-x: auto;
    }
    .chan-tab-btn {
        background: none;
        border: none;
        color: var(--silver);
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        transition: all 0.2s ease;
    }
    .chan-tab-btn:hover {
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
    }
    .chan-tab-btn.active {
        background: rgba(255, 215, 0, 0.14);
        color: var(--gold);
        border: 1px solid rgba(255, 215, 0, 0.35);
    }
    .channel-menu-tab-content {
        padding: 20px;
        overflow-y: auto;
        flex: 1;
    }
    .channel-menu-gui-btn {
        background: rgba(255, 215, 0, 0.1);
        border: 1px solid rgba(255, 215, 0, 0.35);
        color: var(--gold);
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .channel-menu-gui-btn:hover {
        background: var(--gold);
        color: #000;
    }

    /* Access Mode 3-Card Selector */
    .access-mode-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 16px;
    }
    @media (max-width: 600px) {
        .access-mode-grid {
            grid-template-columns: 1fr;
        }
    }
    .access-mode-card {
        background: #0f1015;
        border: 1.5px solid #282a36;
        border-radius: 12px;
        padding: 14px 10px;
        cursor: pointer;
        transition: all 0.25s ease;
        text-align: center;
        user-select: none;
        position: relative;
    }
    .access-mode-card:hover {
        border-color: rgba(255, 215, 0, 0.4);
        background: #14151e;
        transform: translateY(-2px);
    }
    .access-mode-card.selected {
        border-color: var(--gold);
        background: rgba(255, 215, 0, 0.08);
        box-shadow: 0 0 16px rgba(255, 215, 0, 0.18);
    }
    .mode-icon {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px;
        font-size: 1.15rem;
        transition: all 0.25s ease;
    }
    .mode-icon.open {
        background: rgba(105, 240, 174, 0.12);
        color: #69f0ae;
        border: 1.5px solid rgba(105, 240, 174, 0.35);
    }
    .mode-icon.public-view {
        background: rgba(255, 215, 0, 0.12);
        color: var(--gold);
        border: 1.5px solid rgba(255, 215, 0, 0.35);
    }
    .mode-icon.role-private {
        background: rgba(186, 104, 200, 0.15);
        color: #ba68c8;
        border: 1.5px solid rgba(186, 104, 200, 0.4);
    }
    .access-mode-card.selected .mode-icon {
        transform: scale(1.08);
        box-shadow: 0 0 12px currentColor;
    }
    .access-mode-card .mode-title {
        display: block;
        font-weight: 700;
        font-size: 0.88rem;
        color: #fff;
        margin-bottom: 4px;
    }
    .access-mode-card .mode-desc {
        display: block;
        font-size: 0.72rem;
        color: var(--silver);
        line-height: 1.35;
    }

    /* Role Counter & Badges */
    .role-usage-counter-wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 12px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        margin-bottom: 12px;
        font-size: 0.82rem;
    }
    .role-usage-counter {
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 6px;
    }
    .role-usage-counter.under { background: rgba(76, 175, 80, 0.15); color: #69f0ae; }
    .role-usage-counter.near { background: rgba(255, 152, 0, 0.15); color: #ffb74d; }
    .role-usage-counter.max { background: rgba(244, 67, 54, 0.2); color: #ff8a80; }

    /* Member Invite Badge */
    .member-invite-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: rgba(255, 215, 0, 0.12);
        border: 1px solid rgba(255, 215, 0, 0.35);
        color: var(--gold);
        font-size: 0.68rem;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 10px;
        margin-left: 6px;
        vertical-align: middle;
    }
    .topbar-invite-badge {
        background: var(--gold);
        color: #000;
        font-size: 0.7rem;
        font-weight: 800;
        padding: 1px 6px;
        border-radius: 8px;
        margin-left: 4px;
    }

    /* Track Type Pills */
    .track-type-pills {
        display: inline-flex;
        background: #0f1015;
        border: 1px solid #282a36;
        border-radius: 8px;
        padding: 2px;
        gap: 2px;
    }
    .track-pill {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.72rem;
        font-weight: 600;
        color: #8e9297;
        cursor: pointer;
        transition: all 0.18s;
        border: none;
        background: transparent;
    }
    .track-pill:hover { color: #fff; }
    .track-pill.active {
        background: var(--gold);
        color: #000;
        font-weight: 700;
    }

    /* Universal GPL Toast Notification Container */
    #gplToastContainer {
        position: fixed;
        bottom: 24px;
        right: 24px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        z-index: 9999999;
        pointer-events: none;
        max-width: 90vw;
        width: 380px;
    }
    .gpl-toast-item {
        pointer-events: auto;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 18px;
        border-radius: 12px;
        background: #14151b;
        color: #fff;
        font-size: 0.88rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(8px);
        transform: translateY(20px);
        opacity: 0;
        transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.25s ease;
    }
    .gpl-toast-item.show {
        transform: translateY(0);
        opacity: 1;
    }
    .gpl-toast-item.success { border-color: #69f0ae; }
    .gpl-toast-item.success i { color: #69f0ae; font-size: 1.2rem; }
    .gpl-toast-item.error { border-color: #ff8a80; }
    .gpl-toast-item.error i { color: #ff8a80; font-size: 1.2rem; }
    .gpl-toast-item.info { border-color: var(--gold); }
    .gpl-toast-item.info i { color: var(--gold); font-size: 1.2rem; }
</style>

<div class="discord-app-layout">

    <!-- Mobile Backdrop for off-canvas Drawers -->
    <div class="discord-mobile-backdrop" id="discordBackdrop" onclick="closeDiscordDrawers()"></div>

    <!-- LEFT DRAWER: RAIL (Clubs) + CHANNELS SIDEBAR -->
    <div class="discord-left-pane-wrapper" id="leftNavDrawer">

    <!-- ========================================== -->
    <!-- 1. LEFT RAIL: JOINED CLUBS & DISCOVER      -->
    <!-- ========================================== -->
    <div class="discord-rail">
        <!-- Go Back Arrow to Clubs Directory -->
        <a href="/clubs" class="rail-item back-rail-btn" title="Back to All Clubs & Communities" style="display: flex; align-items: center; justify-content: center; background: rgba(255, 215, 0, 0.12); border: 1.5px solid var(--gold); color: var(--gold); text-decoration: none; font-size: 1.25rem;">
            <div class="rail-item-pill"></div>
            <i class="fas fa-arrow-left" style="color: var(--gold);"></i>
        </a>

        <div class="rail-divider"></div>

        <!-- Joined Clubs Icons -->
        <% if (joinedClubs && joinedClubs.length > 0) { %>
            <% joinedClubs.forEach(jClub => { %>
                <a href="/clubs/<%= jClub.slug %>" class="rail-item <%= String(jClub._id) === String(club._id) ? 'active' : '' %>" title="<%= jClub.name %>">
                    <div class="rail-item-pill"></div>
                    <img src="<%= jClub.iconUrl || '/images/default-avatar.png' %>" alt="<%= jClub.name %>" onerror="this.src='/images/default-avatar.png';">
                </a>
            <% }) %>
        <% } %>

        <div class="rail-divider"></div>

        <!-- Add Club (+) -->
        <a href="/clubs/create" class="rail-item" title="Create a New Club">
            <i class="fas fa-plus" style="font-size: 1.2rem;"></i>
        </a>

        <!-- Explore Clubs (Compass) -->
        <a href="/clubs" class="rail-item" title="Discover Clubs &amp; Communities">
            <i class="fas fa-compass" style="font-size: 1.2rem;"></i>
        </a>
    </div>

    <!-- ========================================== -->
    <!-- 2. CHANNELS SIDEBAR                        -->
    <!-- ========================================== -->
    <div class="discord-channels-col">
        <!-- Club Banner Header -->
        <div class="club-banner-wrap">
            <img src="<%= club.bannerUrl || '/images/default-banner.jpg' %>" alt="<%= club.name %> Banner" class="club-banner-img" onerror="this.onerror=null; this.src='/images/default-banner.jpg';">
            <div class="club-banner-overlay"></div>
        </div>

        <!-- Club Header with Server Actions Dropdown -->
        <div class="club-header-area">
            <div class="club-header-box" onclick="toggleClubMenu(event)">
                <div class="club-header-title">
                    <span><%= club.name %></span>
                    <% if (club.isVerified || club.isDefault) { %>
                        <i class="fas fa-check-circle" style="color: var(--gold); font-size: 0.85em; flex-shrink: 0;"></i>
                    <% } %>
                </div>
                <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
                    <i class="fas fa-chevron-down" style="font-size: 0.8rem; color: #8e9297;"></i>
                    <button type="button" class="mobile-drawer-close-btn" onclick="closeDiscordDrawers(event)" title="Close Navigation">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>

            <!-- Club Dropdown Menu -->
            <div class="club-header-dropdown" id="clubHeaderDropdown">
                <a href="/clubs/<%= club.slug %>/preview" class="club-menu-item">
                    <i class="fas fa-info-circle"></i>
                    <span>Club Overview &amp; Info</span>
                </a>
                <div class="club-menu-item" onclick="openUniqueInviteModal(); toggleClubMenu();">
                    <i class="fas fa-user-plus" style="color: var(--gold);"></i>
                    <span>Invite Members (Unique Link)</span>
                    <% if (myInviteCount > 0) { %>
                        <span class="member-invite-badge" style="margin-left: auto;"><i class="fas fa-trophy"></i> <%= myInviteCount %></span>
                    <% } %>
                </div>
                <% if (hasManageClubPerm) { %>
                    <div class="club-menu-divider"></div>
                    <% if (isClubCreator || (locals.user && locals.user.role === 'owner')) { %>
                        <div class="club-menu-item" onclick="openEditClubModal(); toggleClubMenu();">
                            <i class="fas fa-cog" style="color: var(--silver);"></i>
                            <span>Club Settings</span>
                        </div>
                    <% } %>
                    <div class="club-menu-item" onclick="openCreateChannelModal(); toggleClubMenu();">
                        <i class="fas fa-plus-circle"></i>
                        <span>Create Text Channel</span>
                    </div>
                    <div class="club-menu-item" onclick="openTrackedCreatorsModal(); toggleClubMenu();">
                        <i class="fas fa-rss" style="color: var(--gold);"></i>
                        <span>Tracked Creators</span>
                    </div>
                <% } else { %>
                    <div class="club-menu-divider"></div>
                    <div class="club-menu-item" onclick="openTrackedCreatorsModal(); toggleClubMenu();">
                        <i class="fas fa-bell"></i>
                        <span>My Subscriptions</span>
                    </div>
                <% } %>
                <div class="club-menu-divider"></div>
                <a href="/clubs" class="club-menu-item">
                    <i class="fas fa-compass"></i>
                    <span>Explore Other Clubs</span>
                </a>
                <% if (isClubCreator || (locals.user && locals.user.role === 'owner')) { %>
                    <% if (!club.isDefault) { %>
                        <div class="club-menu-divider"></div>
                        <div class="club-menu-item" onclick="openDeleteClubModal(); toggleClubMenu();" style="color: #ff5252;">
                            <i class="fas fa-trash-alt" style="color: #ff5252;"></i>
                            <span>Delete Club</span>
                        </div>
                    <% } %>
                <% } %>
                <% if (!club.isDefault && membership && !isClubCreator) { %>
                    <form id="leaveClubForm" action="/clubs/<%= club.slug %>/leave" method="POST" style="margin: 0;">
                        <button type="button" class="club-menu-item" onclick="confirmLeaveClub(event)" style="color: #ff5252; background: none; border: none; width: 100%; text-align: left; cursor: pointer;">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Leave Club</span>
                        </button>
                    </form>
                <% } %>
            </div>
        </div>

        <!-- Channels Scroll Area -->
        <div class="channels-scroll-area">
            <!-- 1. INFORMATION CHANNELS -->
            <div class="channel-category-label">
                <span><i class="fas fa-thumbtack" style="margin-right: 4px; color: var(--gold);"></i> Information</span>
            </div>
            <% channels.filter(c => ['rules', 'announcements'].includes(c.type)).forEach(chan => { %>
                <a href="/clubs/<%= club.slug %>?channel=<%= chan._id %>" class="channel-item-link <%= (activeChannel && String(activeChannel._id) === String(chan._id)) ? 'active' : '' %>">
                    <i class="fas <%= chan.type === 'rules' ? 'fa-scroll' : 'fa-bullhorn' %>"></i>
                    <span><%= chan.name %></span>
                </a>
            <% }) %>

            <!-- 2. MOD FEEDS (Automated uploader/distributor feeds) -->
            <div class="channel-category-label" style="margin-top: 8px;">
                <span><i class="fas fa-rocket" style="margin-right: 4px; color: #64b5f6;"></i> Mod Feeds</span>
            </div>
            <% channels.filter(c => ['new-uploads', 'new-updates'].includes(c.type)).forEach(chan => { %>
                <a href="/clubs/<%= club.slug %>?channel=<%= chan._id %>" class="channel-item-link <%= (activeChannel && String(activeChannel._id) === String(chan._id)) ? 'active' : '' %>">
                    <i class="fas <%= chan.type === 'new-uploads' ? 'fa-download' : 'fa-sync-alt' %>"></i>
                    <span><%= chan.name %></span>
                </a>
            <% }) %>

            <!-- 3. TEXT & POLL CHANNELS -->
            <div class="channel-category-label" style="margin-top: 8px;">
                <span><i class="fas fa-comments" style="margin-right: 4px; color: #81c784;"></i> Text Channels</span>
                <% if (hasManageClubPerm) { %>
                    <button type="button" onclick="openCreateChannelModal()" title="Create Channel" style="background: none; border: none; color: #8e9297; cursor: pointer;">
                        <i class="fas fa-plus"></i>
                    </button>
                <% } %>
            </div>
            <% channels.filter(c => !['rules', 'announcements', 'new-uploads', 'new-updates'].includes(c.type)).forEach(chan => { %>
                <a href="/clubs/<%= club.slug %>?channel=<%= chan._id %>" class="channel-item-link <%= (activeChannel && String(activeChannel._id) === String(chan._id)) ? 'active' : '' %>">
                    <i class="fas <%= chan.type === 'polls' ? 'fa-poll' : 'fa-hashtag' %>"></i>
                    <span><%= chan.name %></span>
                    <% if (chan.isPrivate) { %>
                        <i class="fas fa-lock channel-lock-icon" title="Role-Specific Channel"></i>
                    <% } %>
                </a>
            <% }) %>
        </div>

        <!-- User Profile Footer with Vanished Mode for Staff -->
        <div class="discord-user-footer">
            <div class="footer-user-info" onclick="window.location.href='/users/<%= user ? user.username : '' %>'">
                <% const myFooterAvatar = (user && user.signedAvatarUrl && user.signedAvatarUrl !== '/images/default-avatar.png') ? user.signedAvatarUrl : ((user && (user.cardAvatarUrl || user.avatarUrl || user.avatar)) ? (user.cardAvatarUrl || user.avatarUrl || user.avatar) : ((user && user.username === 'GPLMods') ? '/images/team-logo.png' : '/images/default-avatar.png')); %>
                <img src="<%= myFooterAvatar %>" alt="<%= user ? user.username : 'User Avatar' %>" class="footer-avatar" onerror="this.onerror=null; this.src=(this.alt==='GPLMods')?'/images/team-logo.png':'/images/default-avatar.png';">
                <div class="footer-name-box">
                    <span class="footer-username"><%= user ? user.username : 'Guest' %></span>
                    <span class="footer-status-tag"><%= isStaff ? 'Site Staff' : 'Member' %></span>
                </div>
            </div>

            <!-- Vanished Mode Toggle (Site Owner & Admin Only) -->
            <% if (isStaff) { %>
                <button type="button" id="vanishToggleBtn" class="vanish-toggle-btn <%= vanishedModeDefault ? 'active' : '' %>" onclick="toggleVanishedMode()" title="Vanished Mode (Ghost Audit Mode: Visit without showing online or increasing count)">
                    <i class="fas fa-ghost"></i>
                    <span id="vanishStatusText"><%= vanishedModeDefault ? 'Ghost ON' : 'Ghost' %></span>
                </button>
            <% } %>
        </div>
    </div>
    </div> <!-- Close .discord-left-pane-wrapper -->

    <!-- ========================================== -->
    <!-- 3. MAIN CHAT AREA                          -->
    <!-- ========================================== -->
    <div class="discord-chat-main">
        <!-- Top Bar -->
        <div class="chat-topbar">
            <div class="topbar-channel-info">
                <% 
                    const clubCreatorRole = club.creator ? club.creator.role : '';
                    const isClubOwner = clubCreatorRole === 'owner' || club.isDefault;
                    const isClubStaff = ['admin', 'support'].includes(clubCreatorRole);
                    const isClubDistributor = clubCreatorRole === 'distributor';
                    const isClubVerified = club.isVerified || isClubOwner || isClubStaff || isClubDistributor;
                %>
                <!-- Mobile Navigation Toggle Button -->
                <button type="button" class="mobile-channels-toggle-btn" id="mobileChannelsToggleBtn" onclick="toggleLeftDrawer()" title="Channels &amp; Clubs">
                    <i class="fas fa-bars"></i>
                </button>

                <!-- Go Back to Clubs Button (Desktop only shortcut) -->
                <a href="/clubs" class="topbar-btn back-btn-topbar hide-mobile" title="Back to All Clubs" style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; text-decoration: none; color: var(--gold); border: 1px solid rgba(255,215,0,0.3); border-radius: 8px; padding: 4px 10px; font-size: 0.82rem; font-weight: 600; margin-right: 2px; background: rgba(255,215,0,0.06);">
                    <i class="fas fa-arrow-left"></i> <span>Clubs</span>
                </a>

                <!-- Club Identity (Club Name + Verified Badge) -->
                <div class="topbar-club-badge-wrap" onclick="toggleLeftDrawer()" title="<%= club.name %> (Click to view channels &amp; club settings)">
                    <span class="topbar-club-name"><%= club.name %></span>
                    <% if (isClubVerified) { %>
                        <% if (isClubOwner) { %>
                            <i class="fas fa-check-circle" style="color: #ffd700; font-size: 0.85em; filter: drop-shadow(0 0 4px rgba(255,215,0,0.4)); flex-shrink: 0;" title="Official GPLMods Community (Gold Verified)"></i>
                        <% } else if (isClubStaff) { %>
                            <i class="fas fa-check-circle" style="color: #e0e0e0; font-size: 0.85em; filter: drop-shadow(0 0 4px rgba(255,255,255,0.4)); flex-shrink: 0;" title="Staff Verified Community (Silver)"></i>
                        <% } else if (isClubDistributor) { %>
                            <i class="fas fa-check-circle" style="color: #0099ff; font-size: 0.85em; filter: drop-shadow(0 0 4px rgba(0,153,255,0.4)); flex-shrink: 0;" title="Distributor Partner Verified (Blue)"></i>
                        <% } else { %>
                            <i class="fas fa-check-circle" style="color: #ffd700; font-size: 0.85em; flex-shrink: 0;" title="Verified Community"></i>
                        <% } %>
                    <% } %>
                </div>

                <span class="topbar-breadcrumb-sep">/</span>

                <!-- Channel Name -->
                <div class="topbar-channel-name-wrap">
                    <i class="fas <%= activeChannel ? (activeChannel.type === 'polls' ? 'fa-poll' : (activeChannel.type === 'rules' ? 'fa-scroll' : (activeChannel.type === 'announcements' ? 'fa-bullhorn' : 'fa-hashtag'))) : 'fa-hashtag' %>" style="color: var(--gold); font-size: 0.9rem;"></i>
                    <span class="topbar-channel-title"><%= activeChannel ? activeChannel.name : 'general' %></span>
                </div>

                <!-- Channel Type & Status Pills -->
                <% if (activeChannel) { %>
                    <% if (activeChannel.type === 'rules') { %>
                        <span class="chan-type-pill rules hide-on-tiny-screen"><i class="fas fa-scroll"></i> Rules</span>
                    <% } else if (activeChannel.type === 'announcements') { %>
                        <span class="chan-type-pill announce hide-on-tiny-screen"><i class="fas fa-bullhorn"></i> Announcements</span>
                    <% } else if (activeChannel.type === 'polls') { %>
                        <span class="chan-type-pill polls hide-on-tiny-screen"><i class="fas fa-poll"></i> Polls</span>
                    <% } else if (activeChannel.type === 'new-uploads' || activeChannel.type === 'new-updates') { %>
                        <span class="chan-type-pill feeds hide-on-tiny-screen"><i class="fas fa-rss"></i> Mod Feed</span>
                    <% } else { %>
                        <span class="chan-type-pill text hide-on-tiny-screen"><i class="fas fa-hashtag"></i> Text</span>
                    <% } %>
                    <span class="chan-type-pill locked" id="topbarLockedBadge" style="display: <%= activeChannel.isReadOnly ? 'inline-flex' : 'none' %>;"><i class="fas fa-lock"></i> Locked</span>
                    <% if (activeChannel.isPrivate) { %>
                        <span class="chan-type-pill priv"><i class="fas fa-shield-alt"></i> Private</span>
                    <% } %>
                <% } %>

                <% if (activeChannel && activeChannel.topic) { %>
                    <span class="topbar-topic"><%= activeChannel.topic %></span>
                <% } %>
            </div>

            <div class="topbar-actions">
                <!-- Desktop Action Buttons -->
                <div class="topbar-desktop-actions hide-mobile">
                    <!-- Invite Button with counter -->
                    <button type="button" class="topbar-btn" onclick="openUniqueInviteModal()" title="Invite Friends & View Total Invites" style="background: rgba(255,215,0,0.1); border: 1px solid rgba(255,215,0,0.35); color: var(--gold); font-weight: 600; padding: 6px 12px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                        <i class="fas fa-user-plus"></i>
                        <span>Invite</span>
                        <% if (myInviteCount > 0) { %>
                            <span class="topbar-invite-badge"><%= myInviteCount %></span>
                        <% } %>
                    </button>

                    <!-- Tracked Creators Quick Button (Desktop only) -->
                    <button type="button" class="topbar-btn" onclick="openTrackedCreatorsModal()" title="Tracked Creators & Updates" style="color: #64b5f6; border-color: rgba(100,181,246,0.3); background: rgba(100,181,246,0.08); border-radius: 8px;">
                        <i class="fas fa-rss"></i>
                    </button>

                    <!-- Consolidated Channel Options & Settings GUI Button -->
                    <button type="button" class="channel-menu-gui-btn" id="btnOpenChannelMenu" onclick="openChannelSettingsGUI()" title="Channel Settings, Roles, Permissions &amp; Invites">
                        <i class="fas fa-sliders-h"></i>
                        <span>Channel Menu</span>
                    </button>

                    <!-- Toggle Members Sidebar -->
                    <button type="button" class="topbar-btn" id="topbarMembersBtn" onclick="toggleMembersSidebar()" title="Toggle Members List">
                        <i class="fas fa-users"></i>
                    </button>
                </div>

                <!-- Mobile More Options Dropdown Menu -->
                <div class="topbar-mobile-more-wrapper">
                    <button type="button" class="topbar-btn topbar-more-btn" id="mobileMoreOptionsBtn" onclick="toggleMobileMoreMenu(event)" title="More Options" style="background: rgba(255,215,0,0.1); border: 1px solid rgba(255,215,0,0.35); color: var(--gold); border-radius: 8px; padding: 6px 10px;">
                        <i class="fas fa-ellipsis-v"></i>
                    </button>
                    <div class="topbar-more-dropdown" id="mobileMoreOptionsDropdown" style="display: none;">
                        <div class="topbar-dropdown-item" onclick="openUniqueInviteModal(); closeMobileMoreMenu();">
                            <i class="fas fa-user-plus" style="color: var(--gold); font-size: 0.95rem;"></i>
                            <span>Invite Members</span>
                            <% if (myInviteCount > 0) { %>
                                <span class="topbar-invite-badge" style="margin-left: auto;"><%= myInviteCount %></span>
                            <% } %>
                        </div>
                        <div class="topbar-dropdown-item" onclick="openChannelSettingsGUI(); closeMobileMoreMenu();">
                            <i class="fas fa-sliders-h" style="color: #64b5f6; font-size: 0.95rem;"></i>
                            <span>Channel Settings</span>
                        </div>
                        <div class="topbar-dropdown-item" onclick="toggleMembersSidebar(); closeMobileMoreMenu();">
                            <i class="fas fa-users" style="color: #a78bfa; font-size: 0.95rem;"></i>
                            <span>Channel Members</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Channel Restricted Warning Banner -->
        <div id="channelRestrictedNotice" style="display: <%= (activeChannel && activeChannel.isReadOnly) ? 'flex' : 'none' %>; align-items: center; justify-content: center; gap: 8px; background: rgba(231, 76, 60, 0.12); border-bottom: 1px solid rgba(231, 76, 60, 0.4); color: #ff8a80; padding: 7px 14px; font-size: 0.82rem; font-weight: 600;">
            <i class="fas fa-lock"></i> Chat in this channel is locked / restricted to staff announcements.
            <% if (hasManageClubPerm) { %>
                <button type="button" onclick="toggleChannelRestriction()" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.25); color: #fff; padding: 2px 8px; border-radius: 6px; font-size: 0.75rem; cursor: pointer; margin-left: 8px;">
                    Unlock Now
                </button>
            <% } %>
        </div>

        <!-- Chat Messages Container -->
        <div class="chat-messages-container" id="messagesFeed">
            <!-- Pinned Message Banner -->
            <% const pinnedMsg = (messages && messages.length > 0) ? messages.find(m => m.isPinned && !m.isDeleted) : null; %>
            <div id="pinnedMessageBanner" style="display: <%= pinnedMsg ? 'flex' : 'none' %>; align-items: center; justify-content: space-between; background: linear-gradient(90deg, rgba(255,215,0,0.14) 0%, rgba(20,21,27,0.96) 100%); border-bottom: 1.5px solid var(--gold); padding: 8px 16px; font-size: 0.85rem; color: #fff; position: sticky; top: 0; z-index: 10; backdrop-filter: blur(8px);">
                <div style="display: flex; align-items: center; gap: 8px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">
                    <i class="fas fa-thumbtack" style="color: var(--gold); transform: rotate(45deg); font-size: 0.9rem;"></i>
                    <span style="font-weight: 700; color: var(--gold); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px;">Pinned:</span>
                    <span id="pinnedBannerText" style="color: #eee; overflow: hidden; text-overflow: ellipsis;"><%= pinnedMsg ? pinnedMsg.content : '' %></span>
                </div>
                <div style="display: flex; gap: 8px; align-items: center; flex-shrink: 0;">
                    <button type="button" id="pinnedBannerJumpBtn" onclick="jumpToPinnedMessage('<%= pinnedMsg ? pinnedMsg._id : '' %>')" style="background: rgba(255,215,0,0.2); border: 1px solid var(--gold); color: #fff; border-radius: 6px; padding: 2px 10px; font-size: 0.75rem; cursor: pointer; font-weight: 600;">Jump</button>
                    <% if (hasManageClubPerm) { %>
                        <button type="button" id="pinnedBannerUnpinBtn" onclick="togglePinClubMessage('<%= pinnedMsg ? pinnedMsg._id : '' %>', false)" title="Unpin Message" style="background: none; border: none; color: var(--silver); cursor: pointer; font-size: 1.2rem; line-height: 1; padding: 0 4px;">&times;</button>
                    <% } %>
                </div>
            </div>

            <% if (messages && messages.length > 0) { %>
                <% messages.forEach(msg => { %>
                    <% const isMyMessage = user && String(user._id) === String(msg.sender ? msg.sender._id : ''); %>
                    <% if (msg.isDeleted && isMyMessage) { return; } %>
                    <div class="message-item <%= msg.isPinned ? 'pinned-msg-item' : '' %>" id="msg-<%= msg._id %>" data-sender-username="<%= (msg.sender && msg.sender.username) ? msg.sender.username : 'GPLMods' %>" style="<%= msg.isPinned ? 'border-left: 3px solid var(--gold); background: rgba(255,215,0,0.02);' : '' %>">
                        <% 
                            const isGPLModsMsg = !msg.sender || msg.sender.username === 'GPLMods' || msg.isSystemMessage;
                            const senderAvatar = (msg.sender && msg.sender.signedAvatarUrl) ? msg.sender.signedAvatarUrl : (isGPLModsMsg ? '/images/team-logo.png' : '/images/default-avatar.png');
                        %>
                        <img src="<%= senderAvatar %>" alt="Sender Avatar" class="message-avatar" onerror="this.src='<%= isGPLModsMsg ? '/images/team-logo.png' : '/images/default-avatar.png' %>';">
                        <div class="message-content-col">
                            <div class="message-header-row">
                                <a href="/users/<%= (msg.sender && msg.sender.username) ? msg.sender.username : 'GPLMods' %>" class="message-username" target="_blank">
                                    <%= (msg.sender && msg.sender.username) ? msg.sender.username : 'GPLMods' %>
                                </a>

                                <!-- Badges -->
                                <% if (msg.sender && msg.sender.role === 'owner') { %>
                                    <span class="badge-icon-tag badge-owner"><i class="fas fa-crown"></i> Owner</span>
                                <% } else if (msg.sender && msg.sender.role === 'admin') { %>
                                    <span class="badge-icon-tag badge-admin"><i class="fas fa-shield-alt"></i> Admin</span>
                                <% } %>
                                <% if (msg.sender && (msg.sender.membership === 'premium' || msg.sender.isPremium)) { %>
                                    <span class="badge-icon-tag badge-premium"><i class="fas fa-star"></i> Premium</span>
                                <% } %>
                                <% if (String(club.creator._id || club.creator) === String(msg.sender ? msg.sender._id : '')) { %>
                                    <span class="badge-icon-tag badge-creator"><i class="fas fa-paint-brush"></i> Creator</span>
                                <% } %>
                                <% 
                                    const senderMember = members.find(m => m.user && String(m.user._id) === String(msg.sender ? msg.sender._id : ''));
                                    const senderRole = senderMember && senderMember.roles && senderMember.roles.length > 0 ? senderMember.roles[0] : null;
                                %>
                                <% if (senderRole && senderRole.name !== 'everyone') { %>
                                    <span class="discord-role-pill" style="border: 1px solid <%= senderRole.color %>50; color: <%= senderRole.color %>; background: <%= senderRole.color %>18;">
                                        <span class="role-dot" style="background: <%= senderRole.color %>;"></span>
                                        <%= senderRole.name %>
                                    </span>
                                <% } %>
                                <% if (msg.isPinned) { %>
                                    <span class="badge-icon-tag badge-pinned" style="background: rgba(255,215,0,0.15); color: var(--gold); border: 1px solid var(--gold);"><i class="fas fa-thumbtack"></i> Pinned</span>
                                <% } %>

                                <span class="message-time"><%= new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                            </div>

                            <!-- Body Text -->
                            <div class="message-body-text" id="msg-text-<%= msg._id %>"><% if (msg.isDeleted) { %><em style="color: #777; font-size: 0.85rem;"><i class="fas fa-trash-alt" style="margin-right: 4px; font-size: 0.75rem;"></i> This message was deleted</em><% } else { %><%= msg.content %><% if (msg.isEdited) { %> <span style="font-size: 0.72rem; color: #888; font-style: italic; margin-left: 6px;">(edited)</span><% } %><% } %></div>

                            <% if (!msg.isDeleted) { %>
                                <!-- Mod Update Embed (for #new-uploads and #new-updates) -->
                                <% if (msg.modUpdate && msg.modUpdate.name) { %>
                                    <div class="mod-update-embed-box">
                                        <img src="<%= msg.modUpdate.iconUrl || '/images/default-avatar.png' %>" class="mod-embed-icon" alt="Mod Icon">
                                        <div class="mod-embed-info">
                                            <h4><%= msg.modUpdate.name %> <span style="font-size: 0.8rem; color: var(--gold); font-weight: normal;">v<%= msg.modUpdate.version %></span></h4>
                                            <p><%= msg.modUpdate.changelog || 'Download this release safely on GPLMods.' %></p>
                                            <a href="<%= msg.modUpdate.downloadUrl %>" class="btn-send-chat" style="display: inline-flex; text-decoration: none; padding: 4px 14px; font-size: 0.85rem;">
                                                <i class="fas fa-download"></i> View Mod Page
                                            </a>
                                        </div>
                                    </div>
                                <% } %>

                                <!-- Poll Embed -->
                                <% if (msg.poll && msg.poll.question) { %>
                                    <div class="poll-embed-card" id="poll-<%= msg._id %>">
                                        <div class="poll-question"><i class="fas fa-poll" style="color: var(--gold);"></i> <%= msg.poll.question %></div>
                                        <div class="poll-options-list">
                                            <% 
                                                const totalVotes = msg.poll.options.reduce((sum, opt) => sum + (opt.votes ? opt.votes.length : 0), 0);
                                            %>
                                            <% msg.poll.options.forEach((opt, idx) => { %>
                                                <% 
                                                    const voteCount = opt.votes ? opt.votes.length : 0;
                                                    const pct = totalVotes > 0 ? Math.round((voteCount / totalVotes) * 100) : 0;
                                                    const hasVoted = user && opt.votes && opt.votes.some(v => String(v) === String(user._id));
                                                %>
                                                <div class="poll-option-row" onclick="votePoll('<%= msg._id %>', <%= idx %>)">
                                                    <div class="poll-progress-fill" style="width: <%= pct %>%;"></div>
                                                    <span style="position: relative; z-index: 2; font-weight: <%= hasVoted ? '700' : 'normal' %>;">
                                                        <%= hasVoted ? '✓ ' : '' %><%= opt.text %>
                                                    </span>
                                                    <span style="position: relative; z-index: 2; font-size: 0.85rem; color: var(--gold);">
                                                        <%= pct %>% (<%= voteCount %>)
                                                    </span>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </div>
                                <% } %>

                                <!-- Reactions Bar -->
                                <div class="reactions-row" id="reactions-<%= msg._id %>">
                                    <% if (msg.reactions && msg.reactions.length > 0) { %>
                                        <% msg.reactions.forEach(r => { %>
                                            <% const userReacted = user && r.users && r.users.some(u => String(u) === String(user._id)); %>
                                            <div class="reaction-pill <%= userReacted ? 'user-reacted' : '' %>" onclick="toggleReaction('<%= msg._id %>', '<%= r.emoji %>')">
                                                <span><%= r.emoji %></span>
                                                <span><%= r.users.length %></span>
                                            </div>
                                        <% }) %>
                                    <% } %>
                                    <div class="reaction-pill" onclick="quickReactPicker('<%= msg._id %>', event)" title="Add Reaction">
                                        <i class="far fa-face-smile"></i> <i class="fas fa-plus" style="font-size: 0.65rem; margin-left: 2px;"></i>
                                    </div>
                                </div>

                                <!-- Message Action Toolbar -->
                                <div class="message-actions-toolbar" style="display: flex; gap: 8px; margin-top: 6px; flex-wrap: wrap; align-items: center;">
                                    <button type="button" class="btn-msg-action" onclick="openClubShareModal('Club Message', '/clubs/<%= club.slug %>#msg-<%= msg._id %>')" title="Share Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: var(--silver); border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                                        <i class="fas fa-share-alt"></i> Share
                                    </button>
                                    <button type="button" class="btn-msg-action" onclick="openForwardModal('<%= msg._id %>')" title="Forward Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: var(--silver); border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                                        <i class="fas fa-reply"></i> Forward
                                    </button>
                                    <% if (hasManageClubPerm) { %>
                                        <button type="button" class="btn-msg-action btn-msg-pin" onclick="togglePinClubMessage('<%= msg._id %>', <%= msg.isPinned ? 'false' : 'true' %>)" title="<%= msg.isPinned ? 'Unpin' : 'Pin' %> Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: <%= msg.isPinned ? 'var(--gold)' : 'var(--silver)' %>; border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                                            <i class="fas fa-thumbtack"></i> <%= msg.isPinned ? 'Unpin' : 'Pin' %>
                                        </button>
                                    <% } %>
                                    <% if (user && (String(user._id) === String(msg.sender ? msg.sender._id : '') || hasManageClubPerm)) { %>
                                        <button type="button" class="btn-msg-action btn-msg-edit" onclick="openEditMessageModal('<%= msg._id %>')" title="Edit Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: var(--gold); border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                        <button type="button" class="btn-msg-action btn-msg-delete" onclick="deleteClubMessage('<%= msg._id %>')" title="Delete Message" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(244,67,54,0.3); color: #ff6b6b; border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </button>
                                    <% } %>
                                    <button type="button" class="btn-translate-msg" onclick="translateMessage('<%= msg._id %>')" style="margin: 0; padding: 3px 8px; font-size: 0.75rem;">
                                        <i class="fas fa-language"></i> Translate
                                    </button>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div style="text-align: center; color: #72767d; margin: auto;">
                    <i class="fas fa-comments" style="font-size: 3rem; margin-bottom: 12px; color: #333645;"></i>
                    <p>Welcome to <strong>#<%= activeChannel ? activeChannel.name : 'general' %></strong>!</p>
                    <p style="font-size: 0.85rem;">This is the start of the channel history.</p>
                </div>
            <% } %>
        </div>

        <!-- Chat Input Bar -->
        <div class="chat-input-bar-wrap">
            <div id="linkWarningBanner" style="display: none; background: rgba(244, 67, 54, 0.2); border: 1px solid #f44336; color: #ff8a80; padding: 8px 12px; border-radius: 8px; margin-bottom: 8px; font-size: 0.85rem;">
                <i class="fas fa-ban"></i> <strong>External links are forbidden!</strong> Only official GPLMods site links are allowed in this chat.
            </div>

            <!-- Real-time Typing Indicator Bar -->
            <div id="clubTypingBar" class="club-typing-bar" style="display: none;">
                <div class="typing-bubble-dots">
                    <span class="typing-dot"></span>
                    <span class="typing-dot"></span>
                    <span class="typing-dot"></span>
                </div>
                <span id="clubTypingUsersText" class="typing-usernames-text"></span>
            </div>

            <!-- Channel Locked Chat Placeholder for Members -->
            <% 
                const canChatInChannel = typeof canUserChatInActiveChannel !== 'undefined' ? canUserChatInActiveChannel : true;
                const isPublicViewRestricted = activeChannel && activeChannel.accessMode === 'public_view' && !canChatInChannel;
                const isChanLocked = Boolean(activeChannel && (activeChannel.isLocked || activeChannel.isReadOnly));
                const canPostWhenLocked = Boolean(typeof hasManageClubPerm !== 'undefined' && hasManageClubPerm);
            %>
            <div id="channelLockedChatOverlay" style="display: <%= canChatInChannel ? 'none' : 'flex' %>;" class="chat-locked-full-box">
                <i class="fas fa-lock" style="color: var(--gold); font-size: 1.3rem;"></i>
                <div>
                    <strong style="color: #fff; display: block; font-size: 0.95rem;">
                        <%= isPublicViewRestricted ? 'Restricted Chat Channel' : 'Channel is in Read-Only Mode' %>
                    </strong>
                    <span style="color: var(--silver); font-size: 0.82rem;">
                        <%= isPublicViewRestricted ? 'This channel is publicly viewable, but only members with assigned roles have permission to send messages.' : 'This channel is locked. Only staff and channel managers have permission to send messages here.' %>
                    </span>
                </div>
            </div>

            <div class="chat-input-box" id="mainChatInputBox" style="position: relative; display: <%= canChatInChannel ? 'flex' : 'none' %>;">
                <!-- Discord Mention Autocomplete Dropdown -->
                <div id="mentionAutocompleteDropdown" class="mention-autocomplete-dropdown"></div>

                <textarea id="chatInput" class="chat-textarea" rows="1" placeholder="<%= isChanLocked ? (canPostWhenLocked ? `Message #${activeChannel ? activeChannel.name : 'general'} (Channel is locked for members)...` : 'This channel is read-only.') : `Message #${activeChannel ? activeChannel.name : 'general'}...` %>"></textarea>

                <div class="chat-input-actions">
                    <!-- Emoticon Button (ASCII faces) -->
                    <button type="button" class="chat-action-btn" onclick="toggleEmoticonPopover(event)" title="Insert Emoticon">
                        <span style="font-size: 1rem; font-weight: 700;">(✿)</span>
                    </button>

                    <!-- Emoji Picker Button -->
                    <button type="button" class="chat-action-btn" id="emojiPickerBtn" onclick="toggleEmojiPicker(event)" title="Insert Emoji">
                        <i class="far fa-face-smile"></i>
                    </button>

                    <!-- GIF Selector Button -->
                    <button type="button" class="chat-action-btn" onclick="toggleGifPicker(event)" title="Insert GIF">
                        <i class="fas fa-film"></i>
                    </button>

                    <!-- Poll Button -->
                    <button type="button" class="chat-action-btn" onclick="openCreatePollModal()" title="Create Poll">
                        <i class="fas fa-poll"></i>
                    </button>

                    <!-- Send Button -->
                    <button type="button" class="btn-send-chat" id="sendChatBtn" onclick="sendClubMessage()">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </div>

            <!-- ASCII Emoticons Popover -->
            <div class="emoticon-popover" id="emoticonPopover">
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('(✿◠‿◠)')">(✿◠‿◠)</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('(づ｡◕‿‿◕｡)づ')">(づ｡◕‿‿◕｡)づ</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('¯\\_(ツ)_/¯')">¯\_(ツ)_/¯</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('(╯°□°)╯︵ ┻━┻')">(╯°□°)╯︵ ┻━┻</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('(•‿•)')">(•‿•)</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('(▀̿Ĺ̯▀̿ ̿)')">(▀̿Ĺ̯▀̿ ̿)</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('(ง\'̀-\'́)ง')">(ง'̀-'́)ง</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('ʕ•ᴥ•ʔ')">ʕ•ᴥ•ʔ</button>
                <button type="button" class="emoticon-btn" onclick="insertEmoticon('(ʘ‿ʘ)')">(ʘ‿ʘ)</button>
            </div>

            <!-- GIF Picker Popover -->
            <div class="gif-picker-modal" id="gifPickerModal">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="font-weight: 700; color: #fff; font-size: 0.95rem;">Select Animated GIF</span>
                    <button type="button" onclick="toggleGifPicker(event)" style="background: none; border: none; color: #aaa; cursor: pointer; font-size: 1.2rem; line-height: 1; padding: 2px 6px;">&times;</button>
                </div>
                <div class="gif-grid">
                    <div class="gif-item" onclick="insertGif('https://media.giphy.com/media/artj92V8o75VPL7AeQ/giphy.gif')">
                        <img src="https://media.giphy.com/media/artj92V8o75VPL7AeQ/giphy.gif" alt="Gaming GIF">
                    </div>
                    <div class="gif-item" onclick="insertGif('https://media.giphy.com/media/blSTtZehjAZ8I/giphy.gif')">
                        <img src="https://media.giphy.com/media/blSTtZehjAZ8I/giphy.gif" alt="Victory GIF">
                    </div>
                    <div class="gif-item" onclick="insertGif('https://media.giphy.com/media/LmN8OYiY4m0X85K0Zz/giphy.gif')">
                        <img src="https://media.giphy.com/media/LmN8OYiY4m0X85K0Zz/giphy.gif" alt="Rocket GIF">
                    </div>
                    <div class="gif-item" onclick="insertGif('https://media.giphy.com/media/3o7abKhOpu0NwenH3O/giphy.gif')">
                        <img src="https://media.giphy.com/media/3o7abKhOpu0NwenH3O/giphy.gif" alt="Hype GIF">
                    </div>
                </div>
            </div>

            <!-- Lightweight Emoji Picker Element -->
            <emoji-picker class="dark" id="mainEmojiPicker" style="position: absolute; bottom: 70px; right: 80px; display: none; z-index: 1000;"></emoji-picker>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- 4. RIGHT SIDEBAR: MEMBERS LIST             -->
    <!-- ========================================== -->
    <div class="discord-members-col" id="membersSidebar">
        <!-- Mobile Members Header -->
        <div class="members-mobile-header">
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-users" style="color: var(--gold);"></i>
                <span style="font-weight: 700; color: #fff; font-size: 0.95rem;">Club Members</span>
            </div>
            <button type="button" class="drawer-close-btn" onclick="toggleMembersSidebar()" title="Close Members">&times;</button>
        </div>
        <div class="members-scroll-area">
            <!-- SITE STAFF SECTION -->
            <% const staffMembers = members.filter(m => m.user && ['owner', 'admin'].includes(m.user.role)); %>
            <% if (staffMembers.length > 0) { %>
                <div class="member-group-header"><i class="fas fa-crown" style="color: var(--gold); margin-right: 6px;"></i> SITE STAFF — <%= staffMembers.length %></div>
                <% staffMembers.forEach(sm => { %>
                    <div class="member-card-row" onclick="window.location.href='/users/<%= sm.user.username %>'">
                        <div class="member-avatar-wrap">
                            <% const smAvatar = (sm.user.signedAvatarUrl && sm.user.signedAvatarUrl !== '/images/default-avatar.png') ? sm.user.signedAvatarUrl : (sm.user.cardAvatarUrl || sm.user.avatarUrl || sm.user.avatar || (sm.user.username === 'GPLMods' ? '/images/team-logo.png' : '/images/default-avatar.png')); %>
                            <img src="<%= smAvatar %>" class="member-avatar-img" alt="<%= sm.user.username %>" onerror="this.onerror=null; this.src=(this.alt==='GPLMods')?'/images/team-logo.png':'/images/default-avatar.png';">
                            <div class="online-dot"></div>
                        </div>
                        <div class="member-meta-box">
                            <span class="member-display-name" style="color: <%= sm.user.role === 'owner' ? 'var(--gold)' : '#64b5f6' %>;">
                                <%= sm.user.username %>
                            </span>
                            <span style="font-size: 0.72rem; color: #8e9297;"><%= sm.user.role === 'owner' ? 'Site Owner' : 'Site Admin' %></span>
                        </div>
                    </div>
                <% }) %>
            <% } %>

            <!-- CLUB CREATOR -->
            <% const creatorMember = members.find(m => m.user && String(m.user._id) === String(club.creator._id || club.creator)); %>
            <% if (creatorMember && (!staffMembers.some(sm => String(sm.user._id) === String(creatorMember.user._id)))) { %>
                <div class="member-group-header" style="margin-top: 14px;"><i class="fas fa-palette" style="color: #ffab91; margin-right: 6px;"></i> CLUB CREATOR — 1</div>
                <div class="member-card-row" onclick="window.location.href='/users/<%= creatorMember.user.username %>'">
                    <div class="member-avatar-wrap">
                        <% const crAvatar = (creatorMember.user.signedAvatarUrl && creatorMember.user.signedAvatarUrl !== '/images/default-avatar.png') ? creatorMember.user.signedAvatarUrl : (creatorMember.user.cardAvatarUrl || creatorMember.user.avatarUrl || creatorMember.user.avatar || (creatorMember.user.username === 'GPLMods' ? '/images/team-logo.png' : '/images/default-avatar.png')); %>
                        <img src="<%= crAvatar %>" class="member-avatar-img" alt="<%= creatorMember.user.username %>" onerror="this.onerror=null; this.src=(this.alt==='GPLMods')?'/images/team-logo.png':'/images/default-avatar.png';">
                        <div class="online-dot"></div>
                    </div>
                    <div class="member-meta-box">
                        <span class="member-display-name" style="color: #ffab91;"><%= creatorMember.user.username %></span>
                        <span style="font-size: 0.72rem; color: #8e9297;">Club Owner</span>
                    </div>
                </div>
            <% } %>

            <!-- ALL MEMBERS / EVERYONE -->
            <div class="member-group-header" style="margin-top: 14px;"><i class="fas fa-users" style="color: #99aab5; font-size: 0.75rem; margin-right: 6px;"></i> @everyone — <span id="onlineCountNum"><%= members.length %></span></div>
            <div id="onlineMembersList">
                <% members.forEach(mem => { %>
                    <% if (mem.user) { %>
                        <% const memRole = (mem.roles && mem.roles.length > 0) ? mem.roles[0] : { name: 'everyone', color: '#99AAB5', badgeIcon: '🌐' }; %>
                        <div class="member-card-row" onclick="window.location.href='/users/<%= mem.user.username %>'">
                            <div class="member-avatar-wrap">
                                <% const memAvatar = (mem.user.signedAvatarUrl && mem.user.signedAvatarUrl !== '/images/default-avatar.png') ? mem.user.signedAvatarUrl : (mem.user.cardAvatarUrl || mem.user.avatarUrl || mem.user.avatar || (mem.user.username === 'GPLMods' ? '/images/team-logo.png' : '/images/default-avatar.png')); %>
                                <img src="<%= memAvatar %>" class="member-avatar-img" alt="<%= mem.user.username %>" onerror="this.onerror=null; this.src=(this.alt==='GPLMods')?'/images/team-logo.png':'/images/default-avatar.png';">
                                <div class="online-dot"></div>
                            </div>
                            <div class="member-meta-box">
                                <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px;">
                                    <span class="member-display-name" style="color: <%= (memRole && memRole.color && memRole.name !== 'everyone') ? memRole.color : '#fff' %>;"><%= mem.user.username %></span>
                                    <% if (mem.inviteCount && mem.inviteCount > 0) { %>
                                        <span class="member-invite-badge" title="<%= mem.inviteCount %> user(s) invited">
                                            <i class="fas fa-trophy"></i> <%= mem.inviteCount %>
                                        </span>
                                    <% } %>
                                </div>
                                <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-top: 3px;">
                                    <% if (mem.roles && mem.roles.length > 0) { %>
                                        <% mem.roles.slice(0, 3).forEach(r => { %>
                                            <span class="discord-sidebar-role-pill" style="color: <%= r.color || '#99aab5' %>; background: <%= (r.color || '#99aab5') %>18; border: 1px solid <%= (r.color || '#99aab5') %>40;">
                                                <%= r.badgeIcon || '🛡️' %> <%= r.name %>
                                            </span>
                                        <% }); %>
                                        <% if (mem.roles.length > 3) { %>
                                            <span class="discord-sidebar-role-pill" style="color: var(--silver); background: rgba(255,255,255,0.06); font-size: 0.68rem;" title="<%= mem.roles.slice(3).map(r => r.name).join(', ') %>">
                                                +<%= mem.roles.length - 3 %>
                                            </span>
                                        <% } %>
                                    <% } else { %>
                                        <span class="discord-sidebar-role-pill" style="color: #99aab5; background: #99aab518; border: 1px solid #99aab540;">
                                            <i class="fas fa-globe" style="margin-right: 3px;"></i> everyone
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODALS (CREATE CHANNEL, POLL, SHARE, ETC)  -->
<!-- ========================================== -->

<!-- Edit Club Modal -->
<div class="gpl-modal-backdrop" id="editClubModal">
    <div class="gpl-modal-box">
        <h3 style="color: #fff; margin-top: 0; margin-bottom: 16px;"><i class="fas fa-cog" style="color: var(--gold);"></i> Club Settings</h3>
        <form action="/clubs/<%= club.slug %>/edit" method="POST" enctype="multipart/form-data">
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Club Name</label>
                <input type="text" name="name" value="<%= club.name %>" required <%= club.isDefault ? 'readonly' : '' %> style="width: 100%; background: #0d0e12; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px; box-sizing: border-box;">
                <% if (club.isDefault) { %>
                    <span style="font-size: 0.75rem; color: #ff5252; margin-top: 4px; display: block;">Official community name cannot be changed.</span>
                <% } %>
            </div>
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Description</label>
                <textarea name="description" rows="3" style="width: 100%; background: #0d0e12; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px; box-sizing: border-box; resize: vertical;"><%= club.description %></textarea>
            </div>
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Club Icon (Optional)</label>
                <input type="file" name="icon" accept="image/png, image/jpeg, image/gif, image/webp" style="color: #fff;">
            </div>
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Club Banner (Optional)</label>
                <input type="file" name="banner" accept="image/png, image/jpeg, image/gif, image/webp" style="color: #fff;">
            </div>
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Visibility</label>
                <input type="hidden" name="isPrivate" id="editClubIsPrivate" value="<%= club.isPrivate ? 'true' : 'false' %>">
                <% if (club.isDefault) { %>
                    <div style="background: rgba(255,255,255,0.04); border: 1px solid #333645; border-radius: 10px; padding: 10px 14px; display: flex; align-items: center; gap: 10px; color: #fff; font-size: 0.9rem;">
                        <i class="fas fa-globe" style="color: #69f0ae;"></i>
                        <span>Public (Official Community)</span>
                    </div>
                <% } else { %>
                    <div class="chan-custom-select-wrapper" id="wrapper-editClubVisibility">
                        <div class="chan-custom-select" onclick="toggleEditClubVisibilityDropdown(event)">
                            <span class="chan-custom-select-text">
                                <i class="fas <%= club.isPrivate ? 'fa-lock' : 'fa-globe' %>" style="color: <%= club.isPrivate ? 'var(--gold)' : '#69f0ae' %>;"></i>
                                <span class="text-label"><%= club.isPrivate ? 'Private (Requires approval to join)' : 'Public (Anyone can instantly join)' %></span>
                            </span>
                            <i class="fas fa-chevron-down" style="font-size: 0.8rem; color: var(--silver);"></i>
                        </div>
                        <div class="chan-custom-options">
                            <div class="chan-custom-option <%= !club.isPrivate ? 'selected' : '' %>" onclick="selectEditClubVisibility('false', 'Public (Anyone can instantly join)', 'fa-globe', '#69f0ae')">
                                <i class="fas fa-globe" style="color: #69f0ae; font-size: 1rem;"></i>
                                <div>
                                    <strong style="color: #fff; display: block; font-size: 0.88rem;">Public</strong>
                                    <span style="font-size: 0.76rem; color: var(--silver);">Anyone can instantly join and participate</span>
                                </div>
                            </div>
                            <div class="chan-custom-option <%= club.isPrivate ? 'selected' : '' %>" onclick="selectEditClubVisibility('true', 'Private (Requires approval to join)', 'fa-lock', 'var(--gold)')">
                                <i class="fas fa-lock" style="color: var(--gold); font-size: 1rem;"></i>
                                <div>
                                    <strong style="color: #fff; display: block; font-size: 0.88rem;">Private</strong>
                                    <span style="font-size: 0.76rem; color: var(--silver);">Requires owner or admin approval to join</span>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 18px;">
                <button type="button" class="gpl-btn-secondary" onclick="closeEditClubModal()">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="submit" class="gpl-btn-primary">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Club Modal -->
<div class="gpl-modal-backdrop" id="deleteClubModal">
    <div class="gpl-modal-box">
        <h3 style="color: #ff5252; margin-top: 0; margin-bottom: 16px;"><i class="fas fa-exclamation-triangle"></i> Delete Club</h3>
        <p style="color: #dcddde; font-size: 0.95rem; margin-bottom: 20px;">
            Are you absolutely sure you want to delete <strong><%= club.name %></strong>?<br>
            This action <strong>CANNOT</strong> be undone. All channels, messages, and roles will be permanently lost.
        </p>
        <form action="/clubs/<%= club.slug %>/delete" method="POST" onsubmit="handleDeleteClub(event)">
            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 18px;">
                <button type="button" class="gpl-btn-secondary" onclick="closeDeleteClubModal()">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="submit" class="gpl-btn-danger">
                    <i class="fas fa-trash-alt"></i> Yes, Delete Club
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Create Channel Modal (With Custom Dropdown GUI & 3 Access Modes) -->
<div class="gpl-modal-backdrop" id="createChannelModal">
    <div class="gpl-modal-box">
        <h3 style="color: #fff; margin-top: 0; margin-bottom: 16px;"><i class="fas fa-hashtag" style="color: var(--gold);"></i> Create Text Channel</h3>
        <form action="/clubs/<%= club.slug %>/channels" method="POST">
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Channel Name</label>
                <input type="text" name="name" placeholder="e.g. android-mods, general-chat" required style="width: 100%; background: #0d0e12; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px; box-sizing: border-box;">
            </div>
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Channel Topic</label>
                <input type="text" name="topic" placeholder="Channel purpose or guidelines..." style="width: 100%; background: #0d0e12; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px; box-sizing: border-box;">
            </div>
            <!-- Custom Channel Type Dropdown GUI -->
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Channel Type</label>
                <div class="chan-custom-select-wrapper" id="wrapper-createChannelType">
                    <div class="chan-custom-select">
                        <span class="chan-custom-select-text">
                            <i class="fas fa-hashtag" style="color: var(--gold);"></i>
                            <span class="text-label">Text Channel</span>
                        </span>
                        <i class="fas fa-chevron-down" style="font-size: 0.8rem; color: var(--silver);"></i>
                    </div>
                    <div class="chan-custom-options">
                        <div class="chan-custom-option selected" data-value="text">
                            <i class="fas fa-hashtag" style="color: var(--gold);"></i>
                            <div>
                                <strong style="color: #fff; display: block;">Text Channel</strong>
                                <span style="font-size: 0.78rem; color: var(--silver);">Standard text discussions and mod releases</span>
                            </div>
                        </div>
                        <div class="chan-custom-option" data-value="polls">
                            <i class="fas fa-poll" style="color: #38ef7d;"></i>
                            <div>
                                <strong style="color: #fff; display: block;">Community Polls Channel</strong>
                                <span style="font-size: 0.78rem; color: var(--silver);">Community voting, member feedback & polls</span>
                            </div>
                        </div>
                        <div class="chan-custom-option" data-value="announcements">
                            <i class="fas fa-bullhorn" style="color: #00d2ff;"></i>
                            <div>
                                <strong style="color: #fff; display: block;">Announcements Channel</strong>
                                <span style="font-size: 0.78rem; color: var(--silver);">Broadcast and staff updates only</span>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" name="type" id="createChannelTypeInput" value="text">
                </div>
            </div>

            <!-- 3-Way Access Mode Selector -->
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 8px;">Channel Access Mode</label>
                <div class="access-mode-grid">
                    <label class="access-mode-card selected" onclick="selectAccessMode('create', 'open', this)">
                        <input type="radio" name="accessMode" value="open" checked style="display: none;">
                        <div class="mode-header">
                            <div class="mode-icon open"><i class="fas fa-globe"></i></div>
                            <div class="mode-title">Open</div>
                        </div>
                        <div class="mode-desc">Public to all club members. Everyone can view and chat.</div>
                    </label>
                    <label class="access-mode-card" onclick="selectAccessMode('create', 'public_view', this)">
                        <input type="radio" name="accessMode" value="public_view" style="display: none;">
                        <div class="mode-header">
                            <div class="mode-icon public-view"><i class="fas fa-eye"></i></div>
                            <div class="mode-title">Public View</div>
                        </div>
                        <div class="mode-desc">Visible to all, but only allowed roles can send messages.</div>
                    </label>
                    <label class="access-mode-card" onclick="selectAccessMode('create', 'role_private', this)">
                        <input type="radio" name="accessMode" value="role_private" style="display: none;">
                        <div class="mode-header">
                            <div class="mode-icon role-private"><i class="fas fa-user-lock"></i></div>
                            <div class="mode-title">Role-Private</div>
                        </div>
                        <div class="mode-desc">Completely hidden from members who lack an allowed role.</div>
                    </label>
                </div>
            </div>

            <!-- Allowed Roles Checklist (visible when public_view or role_private is chosen) -->
            <div id="createChannelRolesSection" style="display: none; background: #0d0e12; border: 1px solid #282a36; border-radius: 10px; padding: 14px; margin-bottom: 16px;">
                <label style="display: block; font-size: 0.82rem; color: var(--gold); font-weight: 600; margin-bottom: 8px;">
                    <i class="fas fa-shield-alt"></i> Select Roles with Chat/Access Permissions:
                </label>
                <div style="display: flex; flex-direction: column; gap: 8px; max-height: 160px; overflow-y: auto;">
                    <% (roles || []).filter(r => r.name !== 'everyone').forEach(r => { %>
                        <label style="display: flex; align-items: center; gap: 8px; color: #fff; font-size: 0.84rem; cursor: pointer; padding: 6px 10px; background: rgba(255,255,255,0.03); border: 1px solid #282a38; border-radius: 8px;">
                            <input type="checkbox" name="allowedRoles" value="<%= r._id %>">
                            <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: <%= r.color || '#5865F2' %>;"></span>
                            <span><i class="fas fa-shield-alt" style="color: <%= r.color || 'var(--gold)' %>; margin-right: 4px;"></i> <%= r.name %></span>
                        </label>
                    <% }); %>
                    <% if ((roles || []).filter(r => r.name !== 'everyone').length === 0) { %>
                        <span style="color: var(--silver); font-size: 0.8rem; font-style: italic;">No custom roles created yet. You can create roles in Roles &amp; Perms.</span>
                    <% } %>
                </div>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 18px;">
                <button type="button" class="gpl-btn-secondary" onclick="closeCreateChannelModal()">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="submit" class="gpl-btn-primary">
                    <i class="fas fa-plus-circle"></i> Create Channel
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ============================================================== -->
<!-- CONSOLIDATED CHANNEL SETTINGS & ACTIONS GUI MODAL              -->
<!-- ============================================================== -->
<div class="channel-menu-gui-modal" id="channelSettingsGUIModal">
    <div class="channel-menu-gui-box">
        <div class="channel-menu-gui-header">
            <h3>
                <i class="fas <%= activeChannel ? (activeChannel.type === 'polls' ? 'fa-poll' : (activeChannel.type === 'rules' ? 'fa-scroll' : (activeChannel.type === 'announcements' ? 'fa-bullhorn' : 'fa-hashtag'))) : 'fa-hashtag' %>" style="color: var(--gold);"></i>
                <span>#<%= activeChannel ? activeChannel.name : 'general' %> — Settings</span>
            </h3>
            <button type="button" class="gpl-modal-close-btn" onclick="closeChannelSettingsGUI()" title="Close Settings">&times;</button>
        </div>

        <!-- Navigation Tabs Bar -->
        <div class="channel-menu-tabs-bar">
            <button type="button" class="chan-tab-btn active" id="tabBtn-info" onclick="switchChannelMenuTab('info')">
                <i class="fas fa-info-circle"></i> <span>Channel Info</span>
            </button>
            <button type="button" class="chan-tab-btn" id="tabBtn-invite" onclick="switchChannelMenuTab('invite')">
                <i class="fas fa-link"></i> <span>Invite &amp; Share</span>
            </button>
            <% if (hasManageClubPerm) { %>
                <button type="button" class="chan-tab-btn" id="tabBtn-lock" onclick="switchChannelMenuTab('lock')">
                    <i class="fas fa-lock"></i> <span>Lock &amp; Access</span>
                </button>
                <button type="button" class="chan-tab-btn" id="tabBtn-edit" onclick="switchChannelMenuTab('edit')">
                    <i class="fas fa-edit"></i> <span>Edit Channel</span>
                </button>
                <button type="button" class="chan-tab-btn" id="tabBtn-roles" onclick="switchChannelMenuTab('roles')">
                    <i class="fas fa-user-shield"></i> <span>Roles &amp; Perms</span>
                </button>
                <% if (!['rules', 'announcements', 'new-uploads', 'new-updates'].includes(activeChannel ? activeChannel.type : '')) { %>
                    <button type="button" class="chan-tab-btn" id="tabBtn-danger" onclick="switchChannelMenuTab('danger')" style="color: #ff6b6b;">
                        <i class="fas fa-trash-alt"></i> <span>Delete</span>
                    </button>
                <% } %>
            <% } %>
        </div>

        <!-- TAB 1: Channel Overview & Information (All Members) -->
        <div class="channel-menu-tab-content" id="tabPane-info">
            <div style="background: #0d0e12; border: 1px solid #282a36; border-radius: 12px; padding: 18px; margin-bottom: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px; margin-bottom: 12px;">
                    <div>
                        <h4 style="margin: 0 0 4px 0; color: #fff; font-size: 1.2rem;">#<%= activeChannel ? activeChannel.name : 'general' %></h4>
                        <p style="margin: 0; color: var(--silver); font-size: 0.85rem;"><%= activeChannel && activeChannel.topic ? activeChannel.topic : 'No description set for this channel.' %></p>
                    </div>
                    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                        <% if (activeChannel) { %>
                            <% if (activeChannel.type === 'rules') { %>
                                <span class="chan-type-pill rules"><i class="fas fa-scroll"></i> Rules</span>
                            <% } else if (activeChannel.type === 'announcements') { %>
                                <span class="chan-type-pill announce"><i class="fas fa-bullhorn"></i> Announcements</span>
                            <% } else if (activeChannel.type === 'polls') { %>
                                <span class="chan-type-pill polls"><i class="fas fa-poll"></i> Polls</span>
                            <% } else if (activeChannel.type === 'new-uploads' || activeChannel.type === 'new-updates') { %>
                                <span class="chan-type-pill feeds"><i class="fas fa-rss"></i> Mod Feed</span>
                            <% } else { %>
                                <span class="chan-type-pill text"><i class="fas fa-hashtag"></i> Text</span>
                            <% } %>
                            <span class="chan-type-pill <%= activeChannel.isReadOnly ? 'locked' : 'polls' %>" id="guiChannelLockStatus">
                                <i class="fas <%= activeChannel.isReadOnly ? 'fa-lock' : 'fa-lock-open' %>"></i>
                                <%= activeChannel.isReadOnly ? 'Read-Only' : 'Open Chat' %>
                            </span>
                            <span class="chan-type-pill <%= activeChannel.isPrivate ? 'priv' : 'text' %>">
                                <i class="fas <%= activeChannel.isPrivate ? 'fa-shield-alt' : 'fa-globe' %>"></i>
                                <%= activeChannel.isPrivate ? 'Private' : 'Public' %>
                            </span>
                        <% } %>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 14px; font-size: 0.84rem; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 14px;">
                    <div>
                        <span style="color: var(--silver); display: block;">Channel Type:</span>
                        <strong style="color: #fff;"><%= (activeChannel && activeChannel.type) ? activeChannel.type.toUpperCase() : 'TEXT' %> Channel</strong>
                    </div>
                    <div>
                        <span style="color: var(--silver); display: block;">Who Can Chat:</span>
                        <strong style="color: <%= (activeChannel && activeChannel.isReadOnly) ? '#ff8a80' : '#69f0ae' %>;">
                            <%= (activeChannel && activeChannel.isReadOnly) ? 'Staff & Managers Only' : 'All Club Members' %>
                        </strong>
                    </div>
                    <div>
                        <span style="color: var(--silver); display: block;">Club:</span>
                        <strong style="color: var(--gold);"><%= club.name %></strong>
                    </div>
                    <div>
                        <span style="color: var(--silver); display: block;">Your Role:</span>
                        <strong style="color: #fff;">
                            <%= isClubCreator ? 'Club Owner' : (isStaff ? 'Site Staff' : (membership ? 'Member' : 'Guest')) %>
                        </strong>
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 14px;">
                <button type="button" class="gpl-btn-secondary" onclick="copyActiveChannelLink()">
                    <i class="fas fa-copy" style="color: var(--gold); margin-right: 6px;"></i> Copy Channel Link
                </button>
            </div>
        </div>

        <!-- TAB 2: Invite & Share Link (All Members) -->
        <div class="channel-menu-tab-content" id="tabPane-invite" style="display: none;">
            <div style="background: #0d0e12; border: 1px solid #282a36; border-radius: 12px; padding: 18px; margin-bottom: 16px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Direct Channel Invite Link</label>
                <div style="display: flex; gap: 8px;">
                    <input type="text" id="directChannelInviteInput" readonly style="flex: 1; background: #14151b; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px 14px; font-size: 0.9rem;" value="">
                    <button type="button" id="btnCopyChannelInvite" class="gpl-btn-primary" onclick="copyChannelInviteDirect()">
                        <i class="fas fa-copy"></i> <span>Copy</span>
                    </button>
                </div>
                <p style="color: var(--silver); font-size: 0.78rem; margin: 8px 0 0 0;">
                    Share this link with friends or community members. It takes them directly into <strong>#<%= activeChannel ? activeChannel.name : 'general' %></strong>!
                </p>
            </div>

            <!-- Social Share Quick Links -->
            <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 10px;">Quick Share via Platforms:</label>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px;">
                <a href="#" id="shareChanWhatsApp" target="_blank" rel="noopener" style="display: flex; align-items: center; justify-content: center; gap: 8px; background: #25D366; color: #fff; text-decoration: none; padding: 10px; border-radius: 8px; font-weight: 600; font-size: 0.85rem;">
                    <i class="fab fa-whatsapp"></i> WhatsApp
                </a>
                <a href="#" id="shareChanTelegram" target="_blank" rel="noopener" style="display: flex; align-items: center; justify-content: center; gap: 8px; background: #0088cc; color: #fff; text-decoration: none; padding: 10px; border-radius: 8px; font-weight: 600; font-size: 0.85rem;">
                    <i class="fab fa-telegram-plane"></i> Telegram
                </a>
                <a href="#" id="shareChanTwitter" target="_blank" rel="noopener" style="display: flex; align-items: center; justify-content: center; gap: 8px; background: #1da1f2; color: #fff; text-decoration: none; padding: 10px; border-radius: 8px; font-weight: 600; font-size: 0.85rem;">
                    <i class="fab fa-x-twitter"></i> X / Twitter
                </a>
                <a href="#" id="shareChanReddit" target="_blank" rel="noopener" style="display: flex; align-items: center; justify-content: center; gap: 8px; background: #ff4500; color: #fff; text-decoration: none; padding: 10px; border-radius: 8px; font-weight: 600; font-size: 0.85rem;">
                    <i class="fab fa-reddit"></i> Reddit
                </a>
            </div>
        </div>

        <% if (hasManageClubPerm) { %>
            <!-- TAB 3: Lock Chat & Privacy Controls (Staff/Manager Only) -->
            <div class="channel-menu-tab-content" id="tabPane-lock" style="display: none;">
                <!-- 1. Lock/Unlock Chat Section -->
                <div style="background: #0d0e12; border: 1px solid #282a36; border-radius: 12px; padding: 18px; margin-bottom: 20px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;">
                        <div>
                            <h4 style="margin: 0 0 4px 0; color: #fff; font-size: 1rem;"><i class="fas fa-lock" style="color: var(--gold); margin-right: 6px;"></i> Lock Channel Chat</h4>
                            <p style="margin: 0; color: var(--silver); font-size: 0.82rem;">
                                Restrict regular members from sending messages. Only staff, owner, and managers can chat.
                            </p>
                        </div>
                        <button type="button" id="btnGuiToggleLock" onclick="toggleChannelRestriction()" style="background: <%= (activeChannel && activeChannel.isReadOnly) ? 'rgba(76, 175, 80, 0.2)' : 'rgba(244, 67, 54, 0.2)' %>; border: 1px solid <%= (activeChannel && activeChannel.isReadOnly) ? '#69f0ae' : '#ff8a80' %>; color: <%= (activeChannel && activeChannel.isReadOnly) ? '#69f0ae' : '#ff8a80' %>; padding: 9px 18px; border-radius: 8px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
                            <i class="fas <%= (activeChannel && activeChannel.isReadOnly) ? 'fa-lock-open' : 'fa-lock' %>"></i>
                            <span id="btnGuiToggleLockText"><%= (activeChannel && activeChannel.isReadOnly) ? 'Unlock Channel Chat' : 'Lock Channel Chat' %></span>
                        </button>
                    </div>
                </div>

                <!-- 2. Channel Privacy & Allowed Roles (3 Access Modes) -->
                <form id="channelPrivacyAccessForm" onsubmit="saveChannelPrivacyAccess(event)">
                    <div style="background: #0d0e12; border: 1px solid #282a36; border-radius: 12px; padding: 18px;">
                        <h4 style="margin: 0 0 4px 0; color: #fff; font-size: 1rem;"><i class="fas fa-shield-alt" style="color: #ba68c8; margin-right: 6px;"></i> Channel Access &amp; Privacy</h4>
                        <p style="margin: 0 0 14px 0; color: var(--silver); font-size: 0.82rem;">Select how this channel is presented and who is allowed to view or chat.</p>

                        <!-- 3-Way Access Mode Selector for Active Channel -->
                        <% const curAccessMode = activeChannel ? (activeChannel.accessMode || (activeChannel.isPrivate ? 'role_private' : 'open')) : 'open'; %>
                        <div class="access-mode-grid" style="margin-bottom: 14px;">
                            <label class="access-mode-card <%= curAccessMode === 'open' ? 'selected' : '' %>" onclick="selectAccessMode('edit', 'open', this)">
                                <input type="radio" name="accessMode" value="open" <%= curAccessMode === 'open' ? 'checked' : '' %> style="display: none;">
                                <div class="mode-header">
                                    <div class="mode-icon open"><i class="fas fa-globe"></i></div>
                                    <div class="mode-title">Open</div>
                                </div>
                                <div class="mode-desc">Public to all club members. Everyone can view and chat.</div>
                            </label>
                            <label class="access-mode-card <%= curAccessMode === 'public_view' ? 'selected' : '' %>" onclick="selectAccessMode('edit', 'public_view', this)">
                                <input type="radio" name="accessMode" value="public_view" <%= curAccessMode === 'public_view' ? 'checked' : '' %> style="display: none;">
                                <div class="mode-header">
                                    <div class="mode-icon public-view"><i class="fas fa-eye"></i></div>
                                    <div class="mode-title">Public View</div>
                                </div>
                                <div class="mode-desc">Visible to all, but only allowed roles can send messages.</div>
                            </label>
                            <label class="access-mode-card <%= curAccessMode === 'role_private' ? 'selected' : '' %>" onclick="selectAccessMode('edit', 'role_private', this)">
                                <input type="radio" name="accessMode" value="role_private" <%= curAccessMode === 'role_private' ? 'checked' : '' %> style="display: none;">
                                <div class="mode-header">
                                    <div class="mode-icon role-private"><i class="fas fa-user-lock"></i></div>
                                    <div class="mode-title">Role-Private</div>
                                </div>
                                <div class="mode-desc">Completely hidden from members who lack an allowed role.</div>
                            </label>
                        </div>

                        <!-- Roles Checklist -->
                        <div id="editChanRolesChecklistWrap" style="<%= curAccessMode === 'open' ? 'display: none;' : '' %> border-top: 1px solid rgba(255,255,255,0.06); padding-top: 14px; margin-top: 14px;">
                            <label style="display: block; font-size: 0.82rem; color: var(--gold); font-weight: 600; margin-bottom: 8px;">
                                <i class="fas fa-shield-alt"></i> Select Roles with Access/Chat Permissions:
                            </label>
                            <div style="display: flex; flex-direction: column; gap: 8px; max-height: 160px; overflow-y: auto;">
                                <% (roles || []).filter(r => r.name !== 'everyone').forEach(r => { 
                                    const isAllowed = (activeChannel && activeChannel.allowedRoles && activeChannel.allowedRoles.some(ar => String(ar) === String(r._id)));
                                %>
                                    <label style="display: flex; align-items: center; gap: 8px; color: #fff; font-size: 0.85rem; cursor: pointer;">
                                        <input type="checkbox" name="allowedRoles" value="<%= r._id %>" <%= isAllowed ? 'checked' : '' %>>
                                        <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: <%= r.color || '#5865F2' %>;"></span>
                                        <span><%= r.badgeIcon || '🛡️' %> <%= r.name %></span>
                                    </label>
                                <% }); %>
                            </div>
                        </div>

                        <div style="display: flex; justify-content: flex-end; margin-top: 16px;">
                            <button type="submit" class="gpl-btn-primary">
                                <i class="fas fa-shield-alt"></i> Save Access Settings
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- TAB 4: Edit Channel Information (Staff/Manager Only) -->
            <div class="channel-menu-tab-content" id="tabPane-edit" style="display: none;">
                <form id="editChannelInfoForm" onsubmit="saveChannelInformation(event)">
                    <div style="margin-bottom: 14px;">
                        <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Channel Name</label>
                        <input type="text" id="editChannelName" name="name" value="<%= activeChannel ? activeChannel.name : '' %>" required style="width: 100%; background: #0d0e12; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px; box-sizing: border-box;">
                    </div>
                    <div style="margin-bottom: 14px;">
                        <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Channel Topic</label>
                        <input type="text" id="editChannelTopic" name="topic" value="<%= (activeChannel && activeChannel.topic) ? activeChannel.topic : '' %>" placeholder="Channel purpose or guidelines..." style="width: 100%; background: #0d0e12; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px; box-sizing: border-box;">
                    </div>
                    <div style="margin-bottom: 18px;">
                        <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Channel Type</label>
                        <div class="chan-custom-select-wrapper" id="wrapper-editChannelType">
                            <% const editCurType = activeChannel ? activeChannel.type : 'text'; %>
                            <div class="chan-custom-select">
                                <span class="chan-custom-select-text">
                                    <i class="fas <%= editCurType === 'polls' ? 'fa-poll' : (editCurType === 'announcements' ? 'fa-bullhorn' : 'fa-hashtag') %>" style="color: var(--gold);"></i>
                                    <span class="text-label"><%= editCurType === 'polls' ? 'Community Polls Channel' : (editCurType === 'announcements' ? 'Announcements Channel' : 'Text Channel') %></span>
                                </span>
                                <i class="fas fa-chevron-down" style="font-size: 0.8rem; color: var(--silver);"></i>
                            </div>
                            <div class="chan-custom-options">
                                <div class="chan-custom-option <%= editCurType === 'text' ? 'selected' : '' %>" data-value="text">
                                    <i class="fas fa-hashtag" style="color: var(--gold);"></i>
                                    <div><strong style="color: #fff; display: block;">Text Channel</strong><span style="font-size: 0.78rem; color: var(--silver);">Standard text discussions and mod releases</span></div>
                                </div>
                                <div class="chan-custom-option <%= editCurType === 'polls' ? 'selected' : '' %>" data-value="polls">
                                    <i class="fas fa-poll" style="color: #38ef7d;"></i>
                                    <div><strong style="color: #fff; display: block;">Community Polls Channel</strong><span style="font-size: 0.78rem; color: var(--silver);">Community voting, member feedback & polls</span></div>
                                </div>
                                <div class="chan-custom-option <%= editCurType === 'announcements' ? 'selected' : '' %>" data-value="announcements">
                                    <i class="fas fa-bullhorn" style="color: #00d2ff;"></i>
                                    <div><strong style="color: #fff; display: block;">Announcements Channel</strong><span style="font-size: 0.78rem; color: var(--silver);">Broadcast and staff updates only</span></div>
                                </div>
                            </div>
                            <input type="hidden" name="type" id="editChannelTypeInput" value="<%= editCurType %>">
                        </div>
                    </div>
                    <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 16px;">
                        <button type="submit" class="gpl-btn-primary">
                            <i class="fas fa-save"></i> Save Channel Information
                        </button>
                    </div>
                </form>
            </div>

            <!-- TAB 5: Role Management & "Make Roles" (Staff/Manager Only) -->
            <div class="channel-menu-tab-content" id="tabPane-roles" style="display: none;">
                <!-- 1. Create New Custom Role ("Make Roles") -->
                <div style="background: #0d0e12; border: 1px solid #282a36; border-radius: 12px; padding: 18px; margin-bottom: 20px;">
                    <h4 style="margin: 0 0 12px 0; color: #fff; font-size: 1rem;"><i class="fas fa-plus-circle" style="color: var(--gold); margin-right: 6px;"></i> Create New Custom Role</h4>
                    <form id="createRoleGUIForm" onsubmit="submitCreateRole(event)">
                        <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 10px; margin-bottom: 12px;">
                            <div>
                                <label style="display: block; font-size: 0.78rem; color: var(--silver); margin-bottom: 4px;">Role Name</label>
                                <input type="text" id="newRoleName" placeholder="e.g. VIP Modder, Helper" required style="width: 100%; background: #14151b; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 8px 10px; box-sizing: border-box;">
                            </div>
                            <div>
                                <label style="display: block; font-size: 0.78rem; color: var(--silver); margin-bottom: 4px;">Badge Emoji</label>
                                <input type="text" id="newRoleBadge" placeholder="🛡️" value="🛡️" maxlength="4" style="width: 100%; background: #14151b; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 8px 10px; box-sizing: border-box; text-align: center;">
                            </div>
                            <div>
                                <label style="display: block; font-size: 0.78rem; color: var(--silver); margin-bottom: 4px;">Role Color</label>
                                <input type="color" id="newRoleColor" value="#FFD700" style="width: 100%; height: 36px; background: #14151b; border: 1px solid #333645; border-radius: 8px; padding: 2px; cursor: pointer; box-sizing: border-box;">
                            </div>
                        </div>

                        <!-- Permissions Checkboxes -->
                        <div style="display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 14px; font-size: 0.82rem; color: var(--silver);">
                            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                                <input type="checkbox" id="permManageChannels"> Manage Channels
                            </label>
                            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                                <input type="checkbox" id="permKickMembers"> Kick Members
                            </label>
                            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                                <input type="checkbox" id="permPostPolls" checked> Create Polls
                            </label>
                        </div>

                        <button type="submit" class="gpl-btn-primary">
                            <i class="fas fa-magic"></i> Make Role
                        </button>
                    </form>
                </div>

                <!-- 2. Existing Roles List with Edit & Delete Actions -->
                <div style="background: #0d0e12; border: 1px solid #282a36; border-radius: 12px; padding: 18px; margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <h4 style="margin: 0; color: #fff; font-size: 0.95rem;">Existing Club Roles</h4>
                        <span style="font-size: 0.75rem; color: var(--silver);"><%= (roles || []).length %> Roles</span>
                    </div>
                    <div id="guiRolesDisplayList" style="display: flex; flex-direction: column; gap: 8px;">
                        <% (roles || []).forEach(r => { %>
                            <div class="role-list-row" id="roleRow-<%= r._id %>" style="display: flex; align-items: center; justify-content: space-between; background: #14151b; border: 1px solid #282a36; border-radius: 8px; padding: 8px 12px;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <span class="discord-sidebar-role-pill" style="color: <%= r.color || '#99aab5' %>; background: <%= (r.color || '#99aab5') %>18; border: 1px solid <%= (r.color || '#99aab5') %>40; padding: 4px 10px; border-radius: 12px; font-size: 0.82rem; display: inline-flex; align-items: center; gap: 6px;">
                                        <%= r.badgeIcon || '🛡️' %> <%= r.name %>
                                    </span>
                                    <% if (r.name === 'everyone') { %>
                                        <span style="font-size: 0.72rem; color: #8e9297;">(Default Role)</span>
                                    <% } %>
                                </div>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <% if (r.name !== 'everyone') { %>
                                        <button type="button" class="btn-role-action edit" onclick="openEditRoleModal('<%= r._id %>', '<%= r.name %>', '<%= r.badgeIcon || "🛡️" %>', '<%= r.color || "#FFD700" %>', <%= r.permissions?.canManageChannels || false %>, <%= r.permissions?.canKickMembers || false %>, <%= r.permissions?.canPostPolls || false %>)" title="Edit Role">
                                            <i class="fas fa-pencil-alt"></i> Edit
                                        </button>
                                        <button type="button" class="btn-role-action delete" onclick="confirmDeleteRole('<%= r._id %>', '<%= r.name %>')" title="Delete Role">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <!-- 3. Assign Roles to Member (Max 10 Roles Limit Enforced) -->
                <div style="background: #0d0e12; border: 1px solid #282a36; border-radius: 12px; padding: 18px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
                        <h4 style="margin: 0; color: #fff; font-size: 0.95rem;">
                            <i class="fas fa-user-tag" style="color: var(--gold); margin-right: 6px;"></i> Assign Roles to Member
                        </h4>
                        <span id="memberRoleCounterBadge" class="roles-counter-badge">
                            0 / 10 Roles Assigned
                        </span>
                    </div>

                    <div style="margin-bottom: 14px;">
                        <label style="display: block; font-size: 0.78rem; color: var(--silver); margin-bottom: 4px;">Select Member</label>
                        <select id="assignTargetMember" class="gui-select" onchange="onSelectMemberForRoles(this.value)" style="width: 100%;">
                            <option value="">-- Choose Member --</option>
                            <% (members || []).forEach(m => { %>
                                <% if (m.user) { %>
                                    <option value="<%= m._id %>" data-roles="<%= (m.roles || []).map(r => r._id || r).join(',') %>">
                                        <%= m.user.username %> (<%= (m.roles || []).length %> roles)
                                    </option>
                                <% } %>
                            <% }); %>
                        </select>
                    </div>

                    <!-- Member Roles Checkboxes Grid -->
                    <div id="memberRolesCheckboxesSection" style="display: none; border-top: 1px solid rgba(255,255,255,0.06); padding-top: 12px;">
                        <label style="display: block; font-size: 0.8rem; color: var(--silver); margin-bottom: 8px;">
                            Check or uncheck roles for this member (Max 10):
                        </label>
                        <div id="memberRolesCheckboxesList" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 8px; max-height: 180px; overflow-y: auto; margin-bottom: 14px;">
                            <% (roles || []).filter(r => r.name !== 'everyone').forEach(r => { %>
                                <label class="role-checkbox-item" id="roleLabel-<%= r._id %>" style="display: flex; align-items: center; gap: 8px; background: #14151b; border: 1px solid #2a2d3a; border-radius: 8px; padding: 8px 10px; cursor: pointer; font-size: 0.82rem; color: #fff;">
                                    <input type="checkbox" class="member-role-checkbox" value="<%= r._id %>" onchange="onMemberRoleCheckboxChange()">
                                    <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: <%= r.color || '#5865F2' %>; flex-shrink: 0;"></span>
                                    <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= r.badgeIcon || '🛡️' %> <%= r.name %></span>
                                </label>
                            <% }); %>
                        </div>
                        <div style="display: flex; justify-content: flex-end; gap: 10px;">
                            <button type="button" class="gpl-btn-primary" onclick="saveMemberAssignedRoles()" id="btnSaveMemberRoles">
                                <i class="fas fa-save"></i> Save Member Roles
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 6: Danger Zone / Delete Channel (Staff/Manager Only) -->
            <% if (!['rules', 'announcements', 'new-uploads', 'new-updates'].includes(activeChannel ? activeChannel.type : '')) { %>
                <div class="channel-menu-tab-content" id="tabPane-danger" style="display: none;">
                    <div style="background: rgba(244, 67, 54, 0.1); border: 1px solid rgba(244, 67, 54, 0.4); border-radius: 12px; padding: 20px;">
                        <h4 style="margin: 0 0 8px 0; color: #ff8a80; font-size: 1.05rem;"><i class="fas fa-exclamation-triangle"></i> Delete This Channel</h4>
                        <p style="margin: 0 0 16px 0; color: var(--silver); font-size: 0.85rem; line-height: 1.5;">
                            Are you sure you want to permanently delete <strong>#<%= activeChannel ? activeChannel.name : '' %></strong>? This action cannot be undone. All message logs and community polls in this channel will be erased.
                        </p>
                        <button type="button" class="gpl-btn-danger" onclick="confirmDeleteActiveChannel()">
                            <i class="fas fa-trash-alt"></i> Delete Channel Permanently
                        </button>
                    </div>
                </div>
            <% } %>
        <% } %>
    </div>
</div>

<!-- Create Poll Modal -->
<div class="gpl-modal-backdrop" id="createPollModal">
    <div class="gpl-modal-box">
        <h3 style="color: #fff; margin-top: 0; margin-bottom: 16px;"><i class="fas fa-poll" style="color: var(--gold);"></i> Create Community Poll</h3>
        <form action="/clubs/<%= club.slug %>/channels/<%= activeChannel ? activeChannel._id : '' %>/poll" method="POST">
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Poll Question</label>
                <input type="text" name="question" placeholder="e.g. Which platform should we focus on next?" required style="width: 100%; background: #0d0e12; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px; box-sizing: border-box;">
            </div>
            <div style="margin-bottom: 18px;">
                <label style="display: block; font-size: 0.85rem; color: var(--silver); margin-bottom: 6px;">Options (One per line, minimum 2)</label>
                <textarea name="options" rows="4" placeholder="Android APK&#10;iOS IPA&#10;Windows Software" required style="width: 100%; background: #0d0e12; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px; box-sizing: border-box;"></textarea>
            </div>
            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 18px;">
                <button type="button" class="gpl-btn-secondary" onclick="closeCreatePollModal()">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="submit" class="gpl-btn-primary">
                    <i class="fas fa-poll"></i> Launch Poll
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Tracked Creator Profiles Modal (Multi-Profile, Uploads/Updates/Both, Club & Personal) -->
<div class="gpl-modal-backdrop" id="trackedCreatorsModal" style="display: none; position: fixed; inset: 0; z-index: 99999; background: rgba(0,0,0,0.8); align-items: center; justify-content: center; backdrop-filter: blur(4px); padding: 12px; box-sizing: border-box; overflow-y: auto;">
    <div class="gpl-modal-box" style="max-width: 600px; background: #14151b; border: 1.5px solid var(--gold); border-radius: 16px; padding: 22px 18px; width: 100%; box-sizing: border-box; max-height: 90vh; overflow-y: auto;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <h3 style="color: #fff; margin: 0; font-size: 1.2rem; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-rss" style="color: var(--gold);"></i> Track Creator Mod Updates &amp; Uploads
            </h3>
            <button type="button" class="gpl-modal-close-btn" onclick="closeTrackedCreatorsModal()" title="Close">&times;</button>
        </div>

        <!-- Tracking Tabs -->
        <div style="display: flex; gap: 8px; border-bottom: 1px solid #282a36; padding-bottom: 10px; margin-bottom: 16px; flex-wrap: wrap;">
            <button type="button" class="chan-tab-btn active" id="tabBtn-trackPersonal" onclick="switchTrackTab('personal')" style="background: rgba(255,215,0,0.15); border: 1px solid var(--gold); color: #fff; padding: 8px 14px; border-radius: 8px; font-weight: 600; cursor: pointer; flex: 1 1 140px; display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
                <i class="fas fa-user-check"></i> <span>My Tracked Creators</span>
            </button>
            <% if (hasManageClubPerm) { %>
                <button type="button" class="chan-tab-btn" id="tabBtn-trackClub" onclick="switchTrackTab('club')" style="background: transparent; border: 1px solid #333645; color: var(--silver); padding: 8px 14px; border-radius: 8px; font-weight: 600; cursor: pointer; flex: 1 1 140px; display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
                    <i class="fas fa-satellite-dish"></i> <span>Club Feed Tracking</span>
                </button>
            <% } %>
        </div>

        <!-- TAB 1: Personal User Creator Tracking -->
        <div id="trackPane-personal">
            <p style="color: var(--silver); font-size: 0.84rem; margin-bottom: 14px; line-height: 1.4;">
                Track creators to receive personalized notifications whenever they publish new mods or mod updates.
            </p>

            <!-- Add Personal Tracked Creator Form -->
            <form id="addPersonalTrackForm" onsubmit="submitAddPersonalTrack(event)" style="background: #0d0e12; border: 1px solid #282a36; border-radius: 12px; padding: 14px; margin-bottom: 16px; box-sizing: border-box;">
                <div style="margin-bottom: 10px;">
                    <label style="display: block; font-size: 0.78rem; color: var(--silver); margin-bottom: 4px;">Creator Username</label>
                    <input type="text" id="personalTrackUsername" placeholder="Exact username on GPLMods..." required style="width: 100%; background: #14151b; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px 12px; box-sizing: border-box;">
                </div>
                <div style="margin-bottom: 14px;">
                    <label style="display: block; font-size: 0.78rem; color: var(--silver); margin-bottom: 6px;">What do you want to track?</label>
                    <div class="gpl-track-pill-group">
                        <label class="track-pill-label active">
                            <input type="radio" name="personalTrackType" value="both" checked onchange="updateTrackRadioActive(this)">
                            <i class="fas fa-layer-group" style="font-size: 0.85rem;"></i>
                            <span>Both Uploads &amp; Updates</span>
                        </label>
                        <label class="track-pill-label">
                            <input type="radio" name="personalTrackType" value="uploads" onchange="updateTrackRadioActive(this)">
                            <i class="fas fa-cloud-upload-alt" style="font-size: 0.85rem;"></i>
                            <span>New Uploads Only</span>
                        </label>
                        <label class="track-pill-label">
                            <input type="radio" name="personalTrackType" value="updates" onchange="updateTrackRadioActive(this)">
                            <i class="fas fa-sync-alt" style="font-size: 0.85rem;"></i>
                            <span>Mod Updates Only</span>
                        </label>
                    </div>
                </div>
                <button type="submit" class="gpl-btn-primary" style="padding: 8px 16px;">
                    <i class="fas fa-plus"></i> Track Creator
                </button>
            </form>

            <!-- Personal Tracked Creators List -->
            <div>
                <label style="display: block; font-size: 0.82rem; color: var(--silver); margin-bottom: 8px; font-weight: 600;">Creators You Are Currently Tracking:</label>
                <div id="personalTrackedList" style="display: flex; flex-direction: column; gap: 8px; max-height: 220px; overflow-y: auto;">
                    <div style="text-align: center; color: var(--silver); padding: 18px; font-size: 0.85rem;">Loading tracked creators...</div>
                </div>
            </div>
        </div>

        <% if (hasManageClubPerm) { %>
            <!-- TAB 2: Club Mod Feeds Tracking -->
            <div id="trackPane-club" style="display: none;">
                <p style="color: var(--silver); font-size: 0.84rem; margin-bottom: 14px; line-height: 1.4;">
                    Assign creator profiles to feed into this club's <strong>#new-uploads</strong> and <strong>#new-updates</strong> channels.
                </p>

                <!-- Add Club Tracked Creator Form -->
                <form id="addClubTrackForm" onsubmit="submitAddClubTrack(event)" style="background: #0d0e12; border: 1px solid #282a36; border-radius: 12px; padding: 14px; margin-bottom: 16px; box-sizing: border-box;">
                    <div style="margin-bottom: 10px;">
                        <label style="display: block; font-size: 0.78rem; color: var(--silver); margin-bottom: 4px;">Creator Username</label>
                        <input type="text" id="clubTrackUsername" placeholder="Exact username on GPLMods..." required style="width: 100%; background: #14151b; border: 1px solid #333645; border-radius: 8px; color: #fff; padding: 10px 12px; box-sizing: border-box;">
                    </div>
                    <div style="margin-bottom: 14px;">
                        <label style="display: block; font-size: 0.78rem; color: var(--silver); margin-bottom: 6px;">Feed Notification Scope</label>
                        <div class="gpl-track-pill-group">
                            <label class="track-pill-label active">
                                <input type="radio" name="clubTrackType" value="both" checked onchange="updateTrackRadioActive(this)">
                                <i class="fas fa-layer-group" style="font-size: 0.85rem;"></i>
                                <span>Both Uploads &amp; Updates</span>
                            </label>
                            <label class="track-pill-label">
                                <input type="radio" name="clubTrackType" value="uploads" onchange="updateTrackRadioActive(this)">
                                <i class="fas fa-cloud-upload-alt" style="font-size: 0.85rem;"></i>
                                <span>New Uploads Only</span>
                            </label>
                            <label class="track-pill-label">
                                <input type="radio" name="clubTrackType" value="updates" onchange="updateTrackRadioActive(this)">
                                <i class="fas fa-sync-alt" style="font-size: 0.85rem;"></i>
                                <span>Mod Updates Only</span>
                            </label>
                        </div>
                    </div>
                    <button type="submit" class="gpl-btn-primary" style="padding: 8px 16px;">
                        <i class="fas fa-rss"></i> Add to Club Feeds
                    </button>
                </form>

                <!-- Club Tracked Creators List -->
                <div>
                    <label style="display: block; font-size: 0.82rem; color: var(--silver); margin-bottom: 8px; font-weight: 600;">Creators Feeding This Club:</label>
                    <div id="clubTrackedList" style="display: flex; flex-direction: column; gap: 8px; max-height: 220px; overflow-y: auto;">
                        <div style="text-align: center; color: var(--silver); padding: 18px; font-size: 0.85rem;">Loading club tracked creators...</div>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</div>

<!-- Forward Message Modal -->
<div class="gpl-modal-backdrop" id="clubForwardModal" style="display: none; position: fixed; inset: 0; z-index: 99999; background: rgba(0,0,0,0.75); align-items: center; justify-content: center; backdrop-filter: blur(4px); padding: 16px; box-sizing: border-box; overflow-y: auto;">
    <div class="gpl-modal-box" style="background: #14151b; border: 1.5px solid var(--gold); border-radius: 16px; padding: 22px 18px; width: 100%; max-width: 440px; box-shadow: 0 15px 40px rgba(0,0,0,0.8); position: relative; overflow: visible; box-sizing: border-box;">
        <h3 style="margin: 0 0 14px 0; color: #fff; font-size: 1.15rem; display: flex; align-items: center; gap: 8px;">
            <i class="fas fa-share" style="color: var(--gold);"></i> Forward Message
        </h3>
        <p style="color: var(--silver); font-size: 0.85rem; margin-bottom: 14px;">Select the channel where you want to forward this message:</p>
        <input type="hidden" id="forwardMessageId">
        <input type="hidden" id="forwardChannelSelect" value="<%= (channels && channels.length > 0) ? channels[0]._id : '' %>">
        <div class="chan-custom-select-wrapper" id="wrapper-forwardChannel" style="margin-bottom: 18px;">
            <div class="chan-custom-select" onclick="toggleForwardChannelDropdown(event)">
                <span class="chan-custom-select-text">
                    <% const defaultForwardChan = (channels && channels.length > 0) ? channels[0] : null; %>
                    <i class="fas <%= defaultForwardChan ? (defaultForwardChan.type === 'polls' ? 'fa-poll' : (defaultForwardChan.type === 'rules' ? 'fa-scroll' : (defaultForwardChan.type === 'announcements' ? 'fa-bullhorn' : 'fa-hashtag'))) : 'fa-hashtag' %>" style="color: var(--gold);"></i>
                    <span class="text-label">#<%= defaultForwardChan ? defaultForwardChan.name : 'general' %></span>
                </span>
                <i class="fas fa-chevron-down" style="font-size: 0.8rem; color: var(--silver);"></i>
            </div>
            <div class="chan-custom-options" style="max-height: 160px; overflow-y: auto;">
                <% (channels || []).forEach((c, idx) => { %>
                    <% const fIcon = (c.type === 'polls' ? 'fa-poll' : (c.type === 'rules' ? 'fa-scroll' : (c.type === 'announcements' ? 'fa-bullhorn' : 'fa-hashtag'))); %>
                    <div class="chan-custom-option <%= idx === 0 ? 'selected' : '' %>" data-value="<%= c._id %>" onclick="selectForwardChannel('<%= c._id %>', '#<%= c.name %>', '<%= fIcon %>')">
                        <i class="fas <%= fIcon %>" style="color: var(--gold); font-size: 0.95rem;"></i>
                        <div>
                            <strong style="color: #fff; display: block; font-size: 0.88rem;">#<%= c.name %></strong>
                            <span style="font-size: 0.76rem; color: var(--silver);"><%= c.topic || (c.type === 'polls' ? 'Polls & Voting' : (c.type === 'announcements' ? 'Announcements' : 'Discussion Channel')) %></span>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
        <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 18px;">
            <button type="button" class="gpl-btn-secondary" onclick="closeForwardModal()">
                <i class="fas fa-times"></i> Cancel
            </button>
            <button type="button" class="gpl-btn-primary" onclick="submitForwardMessage()">
                <i class="fas fa-share"></i> Forward Now
            </button>
        </div>
    </div>
</div>

<!-- Edit Message Modal -->
<div class="gpl-modal-backdrop" id="clubEditModal" style="display: none; position: fixed; inset: 0; z-index: 99999; background: rgba(0,0,0,0.75); align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="gpl-modal-box" style="background: #14151b; border: 1px solid var(--gold); border-radius: 16px; padding: 24px; width: 90%; max-width: 480px; box-shadow: 0 15px 40px rgba(0,0,0,0.8);">
        <h3 style="margin: 0 0 14px 0; color: #fff; font-size: 1.15rem; display: flex; align-items: center; gap: 8px;">
            <i class="fas fa-edit" style="color: var(--gold);"></i> Edit Message
        </h3>
        <input type="hidden" id="editMessageId">
        <textarea id="editMessageTextarea" rows="4" style="width: 100%; background: #0d0e12; border: 1px solid #333645; color: #fff; padding: 12px; border-radius: 8px; font-size: 0.92rem; margin-bottom: 18px; resize: vertical; box-sizing: border-box;"></textarea>
        <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 18px;">
            <button type="button" class="gpl-btn-secondary" onclick="closeEditMessageModal()">
                <i class="fas fa-times"></i> Cancel
            </button>
            <button type="button" class="gpl-btn-primary" onclick="submitEditMessage()">
                <i class="fas fa-save"></i> Save Changes
            </button>
        </div>
    </div>
</div>

<!-- Delete Message Confirmation Modal -->
<div class="gpl-modal-backdrop" id="clubDeleteConfirmModal" style="display: none; position: fixed; inset: 0; z-index: 999999; background: rgba(0,0,0,0.8); align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="gpl-modal-box" style="background: #14151b; border: 1.5px solid #e74c3c; border-radius: 16px; padding: 26px; width: 90%; max-width: 400px; box-shadow: 0 16px 45px rgba(0,0,0,0.9); text-align: center;">
        <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(231,76,60,0.15); border: 1.5px solid #e74c3c; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; color: #e74c3c; font-size: 1.5rem;">
            <i class="fas fa-trash-alt"></i>
        </div>
        <h3 style="color: #fff; margin: 0 0 8px; font-size: 1.2rem;">Delete Message?</h3>
        <p style="color: var(--silver); font-size: 0.88rem; line-height: 1.5; margin: 0 0 20px;">Are you sure you want to permanently delete this message? This cannot be undone.</p>
        <div style="display: flex; gap: 12px; justify-content: center; margin-top: 18px;">
            <button type="button" class="gpl-btn-secondary" onclick="closeClubDeleteModal()">
                <i class="fas fa-times"></i> Cancel
            </button>
            <button type="button" class="gpl-btn-danger" id="confirmDeleteMessageBtn">
                <i class="fas fa-trash-alt"></i> Delete
            </button>
        </div>
    </div>
</div>

<!-- Floating Quick Reaction Bar -->
<div id="reactionFloatingBar" style="display: none; position: fixed; z-index: 999999; background: #161822; border: 1.5px solid var(--gold); border-radius: 30px; padding: 6px 12px; box-shadow: 0 8px 25px rgba(0,0,0,0.85); gap: 6px; align-items: center;">
    <span class="react-quick-emoji" onclick="submitQuickReaction('👍', event)" title="Thumbs Up">👍</span>
    <span class="react-quick-emoji" onclick="submitQuickReaction('❤️', event)" title="Heart">❤️</span>
    <span class="react-quick-emoji" onclick="submitQuickReaction('🔥', event)" title="Fire">🔥</span>
    <span class="react-quick-emoji" onclick="submitQuickReaction('🚀', event)" title="Rocket">🚀</span>
    <span class="react-quick-emoji" onclick="submitQuickReaction('🎉', event)" title="Tada">🎉</span>
    <span class="react-quick-emoji" onclick="submitQuickReaction('😂', event)" title="Laugh">😂</span>
    <span class="react-quick-emoji" onclick="submitQuickReaction('💯', event)" title="100">💯</span>
    <span class="react-quick-emoji" onclick="submitQuickReaction('⚡', event)" title="Zap">⚡</span>
</div>

