<!-- ============================================================== -->
<!-- FLOATING TOAST CONTAINER                                       -->
<!-- ============================================================== -->
<div id="gplToastContainer"></div>

<!-- Scripts -->
<script src="/socket.io/socket.io.js"></script>
<script type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@^1/index.js"></script>

<script>
    const clubId = '<%= club._id %>';
    const channelId = '<%= activeChannel ? activeChannel._id : "" %>';
    const isChannelReadOnly = <%= (activeChannel && activeChannel.isReadOnly && !isStaff && !isClubCreator) ? 'true' : 'false' %>;
    const currentUserId = '<%= user ? user._id : "" %>';
    const currentUsername = '<%= user ? user.username : "" %>';
    const hasManageClubPermClient = <%= hasManageClubPerm ? 'true' : 'false' %>;
    let isVanished = <%= vanishedModeDefault ? 'true' : 'false' %>;
    try {
        if (currentUserId) {
            const savedGhost = localStorage.getItem('club_ghost_mode_' + currentUserId);
            if (savedGhost !== null) {
                isVanished = (savedGhost === '1');
            }
        }
    } catch (e) {}

    // Immediately reflect restored ghost mode status in the UI
    if (isVanished) {
        setTimeout(() => {
            const vBtn = document.getElementById('vanishToggleBtn');
            const vTxt = document.getElementById('vanishStatusText');
            if (vBtn) {
                vBtn.classList.add('active');
                vBtn.style.color = 'var(--gold)';
            }
            if (vTxt) vTxt.textContent = 'Ghost ON';
        }, 10);
    }

    const clubRoles = <%- JSON.stringify(roles.map(r => ({ _id: r._id, name: r.name, color: r.color, icon: r.badgeIcon, isDefault: r.isDefault }))) %>;
    const clubMembers = <%- JSON.stringify(members.map(m => ({ _id: m.user?._id, username: m.user?.username, role: m.user?.role, roles: (m.roles || []).map(r => r.name || r) }))) %>;
    const currentUserRoles = <%- JSON.stringify(membership && membership.roles ? membership.roles.map(r => r.name || r) : ['everyone']) %>;
    const myInviteCode = '<%= myInviteCode || "" %>';
    let myInviteCount = <%= myInviteCount || 0 %>;

    // ==========================================
    // ZERO BROWSER STATIC: TOAST & CONFIRM SYSTEM
    // ==========================================
    function showGplToast(message, type = 'info', duration = 3500) {
        const container = document.getElementById('gplToastContainer');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `gpl-toast ${type}`;

        let iconClass = 'fa-info-circle';
        if (type === 'success') iconClass = 'fa-check-circle';
        if (type === 'error') iconClass = 'fa-exclamation-circle';
        if (type === 'warning') iconClass = 'fa-exclamation-triangle';

        toast.innerHTML = `
            <i class="fas ${iconClass} toast-icon"></i>
            <div class="toast-body">
                <span class="toast-msg">${message}</span>
            </div>
            <button type="button" class="toast-close" onclick="this.parentElement.remove()">&times;</button>
        `;

        container.appendChild(toast);

        setTimeout(() => {
            toast.style.animation = 'gplToastSlideOut 0.3s forwards ease';
            setTimeout(() => toast.remove(), 320);
        }, duration);
    }

    let activeConfirmCallback = null;
    function openGplConfirmModal({ title = 'Confirm Action', message = 'Are you sure you want to proceed?', confirmText = 'Confirm', isDanger = true, onConfirm = null }) {
        const modal = document.getElementById('gplUniversalConfirmModal');
        const titleEl = document.getElementById('gplConfirmTitle');
        const msgEl = document.getElementById('gplConfirmMessage');
        const actionBtn = document.getElementById('gplConfirmActionBtn');
        const iconWrap = document.getElementById('gplConfirmIconWrap');

        if (!modal) return;
        if (titleEl) titleEl.textContent = title;
        if (msgEl) msgEl.textContent = message;
        if (actionBtn) {
            actionBtn.textContent = confirmText;
            actionBtn.style.background = isDanger ? '#e74c3c' : 'var(--gold)';
            actionBtn.style.color = isDanger ? '#fff' : '#000';
        }
        if (iconWrap) {
            iconWrap.style.borderColor = isDanger ? '#ff453a' : 'var(--gold)';
            iconWrap.style.background = isDanger ? 'rgba(255,69,58,0.15)' : 'rgba(255,215,0,0.15)';
            iconWrap.style.color = isDanger ? '#ff453a' : 'var(--gold)';
        }

        activeConfirmCallback = onConfirm;
        modal.style.display = 'flex';
    }

    function closeGplConfirmModal(confirmed = false) {
        const modal = document.getElementById('gplUniversalConfirmModal');
        if (modal) modal.style.display = 'none';

        if (confirmed && typeof activeConfirmCallback === 'function') {
            const cb = activeConfirmCallback;
            activeConfirmCallback = null;
            cb();
        } else {
            activeConfirmCallback = null;
        }
    }

    // Access Mode Card Selector (for Create Channel & Edit Channel settings)
    function selectAccessMode(context, mode, cardEl) {
        const parent = cardEl.closest('.access-mode-grid');
        if (parent) {
            parent.querySelectorAll('.access-mode-card').forEach(c => c.classList.remove('selected'));
        }
        cardEl.classList.add('selected');
        const radio = cardEl.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;

        if (context === 'create') {
            const rolesSection = document.getElementById('createChannelRolesSection');
            if (rolesSection) {
                rolesSection.style.display = (mode === 'open') ? 'none' : 'block';
            }
        } else if (context === 'edit') {
            const rolesSection = document.getElementById('editChanRolesChecklistWrap');
            if (rolesSection) {
                rolesSection.style.display = (mode === 'open') ? 'none' : 'block';
            }
        }
    }

    // Discord Mention System & Role Pings
    function formatDiscordMentions(text) {
        if (!text) return '';
        let res = text;
        const isEveryoneMe = Boolean(currentUsername);
        res = res.replace(/@everyone\b/gi, `<span class="discord-mention discord-mention-everyone ${isEveryoneMe ? 'mention-me' : ''}">@everyone</span>`);

        clubRoles.forEach(r => {
            if (!r.name) return;
            const reg = new RegExp(`@${r.name}\\b`, 'gi');
            const hasRole = currentUserRoles && (currentUserRoles.includes(r.name) || (r.isDefault && currentUserRoles.includes('everyone')));
            const rColor = r.color || '#99AAB5';
            res = res.replace(reg, `<span class="discord-mention discord-mention-role ${hasRole ? 'mention-me' : ''}" style="color: ${rColor}; border-color: ${rColor}50;">@${r.name}</span>`);
        });

        clubMembers.forEach(m => {
            if (!m.username) return;
            const reg = new RegExp(`@${m.username}\\b`, 'gi');
            const isMe = currentUsername && (m.username.toLowerCase() === currentUsername.toLowerCase());
            res = res.replace(reg, `<span class="discord-mention ${isMe ? 'mention-me' : ''}">@${m.username}</span>`);
        });

        return res;
    }

    function checkIsMentioned(text) {
        if (!text || !currentUsername) return false;
        if (/@everyone\b/i.test(text)) return true;
        const userReg = new RegExp(`@${currentUsername}\\b`, 'i');
        if (userReg.test(text)) return true;
        if (currentUserRoles && currentUserRoles.length > 0) {
            return currentUserRoles.some(rName => new RegExp(`@${rName}\\b`, 'i').test(text));
        }
        return false;
    }

    // Initialize formatting on existing loaded messages
    document.querySelectorAll('.message-body-text').forEach(bodyEl => {
        if (!bodyEl.querySelector('.fa-trash-alt')) {
            const raw = bodyEl.innerHTML;
            bodyEl.innerHTML = formatDiscordMentions(raw);
            if (checkIsMentioned(raw)) {
                const parentItem = bodyEl.closest('.message-item');
                if (parentItem) parentItem.classList.add('message-highlighted-mention');
            }
        }
    });

    // Mention Autocomplete Popover Logic
    const mentionDropdown = document.getElementById('mentionAutocompleteDropdown');
    let mentionActiveIndex = 0;
    let mentionItemsList = [];

    function setupMentionAutocomplete() {
        const inputEl = document.getElementById('chatInput');
        if (!inputEl || !mentionDropdown) return;

        inputEl.addEventListener('input', () => {
            const cursor = inputEl.selectionStart;
            const textBefore = inputEl.value.slice(0, cursor);
            const match = textBefore.match(/@([a-zA-Z0-9_-]*)$/);

            if (match) {
                const query = match[1].toLowerCase();
                renderMentionDropdown(query);
            } else {
                hideMentionDropdown();
            }
        });

        inputEl.addEventListener('keydown', (e) => {
            if (mentionDropdown.style.display === 'block') {
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    mentionActiveIndex = (mentionActiveIndex + 1) % mentionItemsList.length;
                    highlightMentionItem();
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    mentionActiveIndex = (mentionActiveIndex - 1 + mentionItemsList.length) % mentionItemsList.length;
                    highlightMentionItem();
                } else if (e.key === 'Enter' || e.key === 'Tab') {
                    if (mentionItemsList.length > 0) {
                        e.preventDefault();
                        selectMentionItem(mentionItemsList[mentionActiveIndex]);
                    }
                } else if (e.key === 'Escape') {
                    hideMentionDropdown();
                }
            }
        });

        document.addEventListener('click', (e) => {
            if (!mentionDropdown.contains(e.target) && e.target !== inputEl) {
                hideMentionDropdown();
            }
        });
    }

    function renderMentionDropdown(query) {
        mentionItemsList = [];
        let html = '';

        // Roles Section
        const roleMatches = [];
        if ('everyone'.includes(query)) {
            roleMatches.push({ type: 'role', name: 'everyone', color: '#ff8dfb', icon: '🌐' });
        }
        clubRoles.forEach(r => {
            if (r.name && r.name !== 'everyone' && r.name.toLowerCase().includes(query)) {
                roleMatches.push({ type: 'role', name: r.name, color: r.color || '#99AAB5', icon: r.badgeIcon || '🛡️' });
            }
        });

        if (roleMatches.length > 0) {
            html += `<div class="mention-autocomplete-header"><i class="fas fa-shield-alt"></i> Roles</div>`;
            roleMatches.forEach(r => {
                const idx = mentionItemsList.length;
                mentionItemsList.push(r);
                html += `
                    <div class="mention-item" data-idx="${idx}" onclick="selectMentionItem(mentionItemsList[${idx}])">
                        <span style="color: ${r.color}; font-size: 1rem;">${r.icon}</span>
                        <span class="mention-item-name" style="color: ${r.color};">@${r.name}</span>
                        <span class="mention-item-tag">Role</span>
                    </div>
                `;
            });
        }

        // Members Section
        const memberMatches = [];
        clubMembers.forEach(m => {
            if (m.username && m.username.toLowerCase().includes(query)) {
                memberMatches.push({ type: 'user', name: m.username });
            }
        });

        if (memberMatches.length > 0) {
            html += `<div class="mention-autocomplete-header" style="margin-top: 4px;"><i class="fas fa-users"></i> Members</div>`;
            memberMatches.slice(0, 10).forEach(m => {
                const idx = mentionItemsList.length;
                mentionItemsList.push(m);
                html += `
                    <div class="mention-item" data-idx="${idx}" onclick="selectMentionItem(mentionItemsList[${idx}])">
                        <i class="fas fa-user-circle" style="color: var(--gold); font-size: 1.1rem;"></i>
                        <span class="mention-item-name">@${m.name}</span>
                        <span class="mention-item-tag">Member</span>
                    </div>
                `;
            });
        }

        if (mentionItemsList.length === 0) {
            hideMentionDropdown();
            return;
        }

        mentionDropdown.innerHTML = html;
        mentionActiveIndex = 0;
        mentionDropdown.style.display = 'block';
        highlightMentionItem();
    }

    function highlightMentionItem() {
        const items = mentionDropdown.querySelectorAll('.mention-item');
        items.forEach((it, idx) => {
            if (idx === mentionActiveIndex) {
                it.classList.add('active');
                it.scrollIntoView({ block: 'nearest' });
            } else {
                it.classList.remove('active');
            }
        });
    }

    function selectMentionItem(item) {
        if (!item) return;
        const inputEl = document.getElementById('chatInput');
        const cursor = inputEl.selectionStart;
        const textBefore = inputEl.value.slice(0, cursor);
        const textAfter = inputEl.value.slice(cursor);
        const newBefore = textBefore.replace(/@[a-zA-Z0-9_-]*$/, `@${item.name} `);
        inputEl.value = newBefore + textAfter;
        inputEl.focus();
        inputEl.setSelectionRange(newBefore.length, newBefore.length);
        hideMentionDropdown();
    }

    function hideMentionDropdown() {
        if (mentionDropdown) {
            mentionDropdown.style.display = 'none';
            mentionItemsList = [];
        }
    }

    setupMentionAutocomplete();

    const socket = io();

    // 1. Join Club & Channel on Socket Connection
    socket.emit('club_join', { clubId, vanished: isVanished });
    if (channelId) {
        socket.emit('club_join_channel', { clubId, channelId });
    }

    // Scroll chat to bottom
    const messagesFeed = document.getElementById('messagesFeed');
    function scrollChatToBottom() {
        if (messagesFeed) messagesFeed.scrollTop = messagesFeed.scrollHeight;
    }
    scrollChatToBottom();

    // 2. Strict Link Validation (Only GPLMods Links Allowed)
    const ALLOWED_DOMAINS = ['gplmods.webredirect.org', 'gplmods.mytunnel.org', 'localhost', '127.0.0.1'];
    if (window.location.hostname && !ALLOWED_DOMAINS.includes(window.location.hostname)) {
        ALLOWED_DOMAINS.push(window.location.hostname);
    }
    function containsExternalLinks(text) {
        if (!text) return false;
        const urlPattern = /(https?:\/\/[^\s]+)|(www\.[^\s]+)|([a-zA-Z0-9-]+\.(?:com|org|net|io|gg|me|app|xyz|site|online|tv|cc|ru|cn|in|info|biz|co|uk|de|eu|club|link|live)[^\s]*)/gi;
        const matches = text.match(urlPattern);
        if (!matches || matches.length === 0) return false;

        for (const match of matches) {
            let testUrl = match;
            if (!testUrl.startsWith('http://') && !testUrl.startsWith('https://')) {
                testUrl = 'http://' + testUrl;
            }
            try {
                const parsed = new URL(testUrl);
                const host = parsed.hostname.toLowerCase();
                const isAllowed = ALLOWED_DOMAINS.some(allowed => host === allowed || host.endsWith('.' + allowed));
                if (!isAllowed) return true;
            } catch(e) {
                return true;
            }
        }
        return false;
    }

    // 3. Send Message Handler
    // 3. Send Message & Typing Emitter Handler
    const chatInput = document.getElementById('chatInput');
    const warningBanner = document.getElementById('linkWarningBanner');

    let clubTypingTimeout = null;
    let isUserTyping = false;

    function emitClubTyping() {
        if (!socket || !channelId) return;
        if (!isUserTyping) {
            isUserTyping = true;
            socket.emit('club_typing', { clubId, channelId });
        }
        clearTimeout(clubTypingTimeout);
        clubTypingTimeout = setTimeout(() => {
            stopClubTypingImmediate();
        }, 1800);
    }

    function stopClubTypingImmediate() {
        if (isUserTyping) {
            isUserTyping = false;
            clearTimeout(clubTypingTimeout);
            socket.emit('club_stop_typing', { clubId, channelId });
        }
    }

    function sendClubMessage() {
        if (isChannelReadOnly) return;
        stopClubTypingImmediate();
        const text = chatInput.value ? chatInput.value.trim() : '';
        if (!text) return;

        // Strictly check for external links
        if (containsExternalLinks(text)) {
            warningBanner.style.display = 'block';
            setTimeout(() => { warningBanner.style.display = 'none'; }, 5000);
            return;
        }

        socket.emit('club_send_message', {
            clubId,
            channelId,
            text
        });

        chatInput.value = '';
        hideMentionDropdown();
    }

    if (chatInput) {
        chatInput.addEventListener('input', () => {
            if (chatInput.value.trim().length > 0) {
                emitClubTyping();
            } else {
                stopClubTypingImmediate();
            }
        });

        chatInput.addEventListener('blur', () => {
            stopClubTypingImmediate();
        });

        chatInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey && mentionDropdown.style.display !== 'block') {
                e.preventDefault();
                sendClubMessage();
            }
        });
    }

    // 4. Socket Listeners for Real-Time Updates
    socket.on('club_new_message', (msg) => {
        if (String(msg.channel) !== channelId) return;

        const isMentioned = checkIsMentioned(msg.content);
        const msgDiv = document.createElement('div');
        msgDiv.className = `message-item ${msg.isPinned ? 'pinned-msg-item' : ''} ${isMentioned ? 'message-highlighted-mention' : ''}`;
        msgDiv.id = `msg-${msg._id}`;

        const isGPLModsMsg = !msg.sender || msg.sender.username === 'GPLMods' || msg.isSystemMessage;
        const senderAvatar = msg.sender?.signedAvatarUrl || (isGPLModsMsg ? '/images/team-logo.png' : '/images/default-avatar.png');
        const senderName = msg.sender?.username || 'GPLMods';
        msgDiv.dataset.senderUsername = senderName;
        const roleBadges = [];

        if (msg.sender?.role === 'owner') roleBadges.push('<span class="badge-icon-tag badge-owner"><i class="fas fa-crown"></i> Owner</span>');
        else if (msg.sender?.role === 'admin') roleBadges.push('<span class="badge-icon-tag badge-admin"><i class="fas fa-shield-alt"></i> Admin</span>');
        if (msg.sender?.membership === 'premium' || msg.sender?.isPremium) roleBadges.push('<span class="badge-icon-tag badge-premium"><i class="fas fa-star"></i> Premium</span>');
        if (msg.sender?.isCreator) roleBadges.push('<span class="badge-icon-tag badge-creator"><i class="fas fa-paint-brush"></i> Creator</span>');

        // Sender club role badge
        const senderMem = clubMembers.find(m => m.username === senderName);
        if (senderMem && senderMem.roles && senderMem.roles.length > 0) {
            const roleName = senderMem.roles[0];
            const matchingRole = clubRoles.find(r => r.name === roleName);
            if (matchingRole && matchingRole.name !== 'everyone') {
                roleBadges.push(`<span class="discord-role-pill" style="border: 1px solid ${matchingRole.color || '#99AAB5'}50; color: ${matchingRole.color || '#99AAB5'}; background: ${matchingRole.color || '#99AAB5'}18;"><span class="role-dot" style="background: ${matchingRole.color || '#99AAB5'};"></span>${matchingRole.name}</span>`);
            }
        }

        const formattedBody = formatDiscordMentions(msg.content);

        msgDiv.innerHTML = `
            <img src="${senderAvatar}" alt="Avatar" class="message-avatar" onerror="this.src='${isGPLModsMsg ? '/images/team-logo.png' : '/images/default-avatar.png'}';">
            <div class="message-content-col">
                <div class="message-header-row">
                    <a href="/users/${senderName}" class="message-username" target="_blank">${senderName}</a>
                    ${roleBadges.join(' ')}
                    <span class="message-time">${new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
                </div>
                <div class="message-body-text" id="msg-text-${msg._id}">${formattedBody}</div>
                <div class="reactions-row" id="reactions-${msg._id}">
                    <div class="reaction-pill" onclick="quickReactPicker('${msg._id}', event)" title="Add Reaction">
                        <i class="far fa-face-smile"></i> <i class="fas fa-plus" style="font-size: 0.65rem; margin-left: 2px;"></i>
                    </div>
                </div>
                <div class="message-actions-toolbar" style="display: flex; gap: 8px; margin-top: 6px; flex-wrap: wrap; align-items: center;">
                    <button type="button" class="btn-msg-action" onclick="openClubShareModal('Club Message', '/clubs/<%= club.slug %>#msg-${msg._id}')" title="Share Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: var(--silver); border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                        <i class="fas fa-share-alt"></i> Share
                    </button>
                    <button type="button" class="btn-msg-action" onclick="openForwardModal('${msg._id}')" title="Forward Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: var(--silver); border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                        <i class="fas fa-reply"></i> Forward
                    </button>
                    ${hasManageClubPermClient ? `
                        <button type="button" class="btn-msg-action btn-msg-pin" onclick="togglePinClubMessage('${msg._id}', true)" title="Pin Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: var(--silver); border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                            <i class="fas fa-thumbtack"></i> Pin
                        </button>
                    ` : ''}
                    ${(String(msg.sender?._id) === currentUserId || hasManageClubPermClient) ? `
                        <button type="button" class="btn-msg-action btn-msg-edit" onclick="openEditMessageModal('${msg._id}')" title="Edit Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: var(--gold); border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button type="button" class="btn-msg-action btn-msg-delete" onclick="deleteClubMessage('${msg._id}')" title="Delete Message" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(244,67,54,0.3); color: #ff6b6b; border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                            <i class="fas fa-trash-alt"></i> Delete
                        </button>
                    ` : ''}
                    <button type="button" class="btn-translate-msg" onclick="translateMessage('${msg._id}')" style="margin: 0; padding: 3px 8px; font-size: 0.75rem;">
                        <i class="fas fa-language"></i> Translate
                    </button>
                </div>
            </div>
        `;

        messagesFeed.appendChild(msgDiv);
        scrollChatToBottom();
    });

    socket.on('club_message_edited', (data) => {
        const textEl = document.getElementById(`msg-text-${data.messageId}`);
        if (textEl) {
            textEl.innerHTML = `${data.content} <span style="font-size: 0.72rem; color: #888; font-style: italic; margin-left: 6px;">(edited)</span>`;
        }
    });

    socket.on('club_message_deleted', (data) => {
        const msgDiv = document.getElementById(`msg-${data.messageId}`);
        if (!msgDiv) return;

        const isSender = data.senderId && String(data.senderId) === String(currentUserId);
        if (isSender) {
            msgDiv.remove();
        } else {
            const textEl = document.getElementById(`msg-text-${data.messageId}`);
            if (textEl) {
                textEl.innerHTML = `<em style="color: #777; font-size: 0.85rem;"><i class="fas fa-trash-alt" style="margin-right: 4px; font-size: 0.75rem;"></i> This message was deleted</em>`;
            }
            const toolbar = msgDiv.querySelector('.message-actions-toolbar');
            if (toolbar) toolbar.remove();
            const reactions = msgDiv.querySelector('.reactions-row');
            if (reactions) reactions.remove();
        }
    });

    socket.on('club_message_pinned', (data) => {
        const banner = document.getElementById('pinnedMessageBanner');
        const text = document.getElementById('pinnedBannerText');
        const jumpBtn = document.getElementById('pinnedBannerJumpBtn');
        const unpinBtn = document.getElementById('pinnedBannerUnpinBtn');

        if (banner) {
            if (data.isPinned) {
                banner.style.display = 'flex';
                if (text) text.textContent = data.content || '';
                if (jumpBtn) jumpBtn.setAttribute('onclick', `jumpToPinnedMessage('${data.messageId}')`);
                if (unpinBtn) unpinBtn.setAttribute('onclick', `togglePinClubMessage('${data.messageId}', false)`);
            } else {
                const remainingPinned = document.querySelector(`.message-item.pinned-msg-item:not(#msg-${data.messageId})`);
                if (remainingPinned) {
                    const remId = remainingPinned.id.replace('msg-', '');
                    const remText = remainingPinned.querySelector('.message-body-text')?.textContent || '';
                    banner.style.display = 'flex';
                    if (text) text.textContent = remText;
                    if (jumpBtn) jumpBtn.setAttribute('onclick', `jumpToPinnedMessage('${remId}')`);
                    if (unpinBtn) unpinBtn.setAttribute('onclick', `togglePinClubMessage('${remId}', false)`);
                } else {
                    banner.style.display = 'none';
                }
            }
        }

        // Real-time update of the pinned message item in the chat feed
        const msgDiv = document.getElementById(`msg-${data.messageId}`);
        if (msgDiv) {
            const pinBtn = msgDiv.querySelector('.btn-msg-pin');
            if (data.isPinned) {
                msgDiv.classList.add('pinned-msg-item');
                msgDiv.style.borderLeft = '3px solid var(--gold)';
                msgDiv.style.background = 'rgba(255,215,0,0.02)';
                if (pinBtn) {
                    pinBtn.innerHTML = '<i class="fas fa-thumbtack"></i> Unpin';
                    pinBtn.title = 'Unpin Message';
                    pinBtn.style.color = 'var(--gold)';
                    pinBtn.setAttribute('onclick', `togglePinClubMessage('${data.messageId}', false)`);
                }
            } else {
                msgDiv.classList.remove('pinned-msg-item');
                msgDiv.style.borderLeft = '';
                msgDiv.style.background = '';
                if (pinBtn) {
                    pinBtn.innerHTML = '<i class="fas fa-thumbtack"></i> Pin';
                    pinBtn.title = 'Pin Message';
                    pinBtn.style.color = 'var(--silver)';
                    pinBtn.setAttribute('onclick', `togglePinClubMessage('${data.messageId}', true)`);
                }
            }
        }
    });

    // Live Typing Indicator State & Listeners
    const activeTypers = new Map();

    function updateTypingUI() {
        const typingBar = document.getElementById('clubTypingBar');
        const typingText = document.getElementById('clubTypingUsersText');
        if (!typingBar || !typingText) return;

        const typers = Array.from(activeTypers.keys());
        if (typers.length === 0) {
            typingBar.style.display = 'none';
            typingText.textContent = '';
        } else {
            typingBar.style.display = 'flex';
            if (typers.length === 1) {
                typingText.textContent = `${typers[0]} is typing...`;
            } else if (typers.length === 2) {
                typingText.textContent = `${typers[0]} and ${typers[1]} are typing...`;
            } else {
                typingText.textContent = `${typers[0]} and ${typers.length - 1} others are typing...`;
            }
        }
    }

    socket.on('club_user_typing', (data) => {
        if (!data || String(data.channelId) !== channelId) return;
        if (data.username && data.username !== currentUsername) {
            activeTypers.set(data.username, Date.now());
            updateTypingUI();
        }
    });

    socket.on('club_user_stop_typing', (data) => {
        if (!data || String(data.channelId) !== channelId) return;
        if (data.username && activeTypers.has(data.username)) {
            activeTypers.delete(data.username);
            updateTypingUI();
        }
    });

    // Clear stale typing indicators after 4.5 seconds
    setInterval(() => {
        const now = Date.now();
        let changed = false;
        for (const [user, time] of activeTypers.entries()) {
            if (now - time > 4500) {
                activeTypers.delete(user);
                changed = true;
            }
        }
        if (changed) updateTypingUI();
    }, 2000);

    // Live Channel Lock / Restriction Updated
    socket.on('club_channel_restriction_updated', (data) => {
        if (!data || String(data.channelId) !== channelId) return;
        const isLocked = Boolean(data.isReadOnly);
        const canPostWhenLocked = hasManageClubPermClient;

        // Topbar badge
        const topbarBadge = document.getElementById('topbarLockedBadge');
        if (topbarBadge) topbarBadge.style.display = isLocked ? 'inline-flex' : 'none';

        // Warning banner
        const notice = document.getElementById('channelRestrictedNotice');
        if (notice) notice.style.display = isLocked ? 'flex' : 'none';

        // Locked Chat Overlay & Main Input Box
        const overlay = document.getElementById('channelLockedChatOverlay');
        const mainInput = document.getElementById('mainChatInputBox');
        if (overlay) overlay.style.display = (isLocked && !canPostWhenLocked) ? 'flex' : 'none';
        if (mainInput) mainInput.style.display = (isLocked && !canPostWhenLocked) ? 'none' : 'flex';

        // Update placeholder
        if (chatInput) {
            chatInput.placeholder = isLocked 
                ? (canPostWhenLocked ? 'Message channel (Channel is locked for members)...' : 'This channel is read-only.')
                : `Message #${document.querySelector('.topbar-channel-info span')?.textContent?.trim() || 'general'}...`;
        }

        // GUI Modal Lock Status Pill & Button
        const guiStatus = document.getElementById('guiChannelLockStatus');
        if (guiStatus) {
            guiStatus.className = `chan-type-pill ${isLocked ? 'locked' : 'polls'}`;
            guiStatus.innerHTML = `<i class="fas ${isLocked ? 'fa-lock' : 'fa-lock-open'}"></i> ${isLocked ? 'Read-Only' : 'Open Chat'}`;
        }
        const lockBtn = document.getElementById('btnGuiToggleLock');
        const lockBtnText = document.getElementById('btnGuiToggleLockText');
        if (lockBtn && lockBtnText) {
            lockBtn.style.background = isLocked ? 'rgba(76, 175, 80, 0.2)' : 'rgba(244, 67, 54, 0.2)';
            lockBtn.style.borderColor = isLocked ? '#69f0ae' : '#ff8a80';
            lockBtn.style.color = isLocked ? '#69f0ae' : '#ff8a80';
            const icon = lockBtn.querySelector('i');
            if (icon) icon.className = `fas ${isLocked ? 'fa-lock-open' : 'fa-lock'}`;
            lockBtnText.textContent = isLocked ? 'Unlock Channel Chat' : 'Lock Channel Chat';
        }
    });

    socket.on('club_message_error', (data) => {
        showGplToast(data.message || 'Error sending message.', 'error');
    });

    socket.on('club_reaction_updated', (data) => {
        const reactionsRow = document.getElementById(`reactions-${data.messageId}`);
        if (!reactionsRow) return;

        let html = '';
        (data.reactions || []).forEach(r => {
            const hasReacted = r.users && r.users.some(u => String(u) === currentUserId);
            html += `
                <div class="reaction-pill ${hasReacted ? 'user-reacted' : ''}" onclick="toggleReaction('${data.messageId}', '${r.emoji}')">
                    <span>${r.emoji}</span>
                    <span>${r.users.length}</span>
                </div>
            `;
        });
        html += `<div class="reaction-pill" onclick="quickReactPicker('${data.messageId}', event)" title="Add Reaction"><i class="far fa-face-smile"></i> <i class="fas fa-plus" style="font-size: 0.65rem; margin-left: 2px;"></i></div>`;
        reactionsRow.innerHTML = html;
    });

    socket.on('club_poll_updated', (data) => {
        const pollCard = document.getElementById(`poll-${data.messageId}`);
        if (!pollCard) return;

        const totalVotes = data.poll.options.reduce((sum, opt) => sum + (opt.votes ? opt.votes.length : 0), 0);
        let optionsHtml = '';
        data.poll.options.forEach((opt, idx) => {
            const voteCount = opt.votes ? opt.votes.length : 0;
            const pct = totalVotes > 0 ? Math.round((voteCount / totalVotes) * 100) : 0;
            const hasVoted = opt.votes && opt.votes.some(v => String(v) === currentUserId);

            optionsHtml += `
                <div class="poll-option-row" onclick="votePoll('${data.messageId}', ${idx})">
                    <div class="poll-progress-fill" style="width: ${pct}%;"></div>
                    <span style="position: relative; z-index: 2; font-weight: ${hasVoted ? '700' : 'normal'};">
                        ${hasVoted ? '✓ ' : ''}${opt.text}
                    </span>
                    <span style="position: relative; z-index: 2; font-size: 0.85rem; color: var(--gold);">
                        ${pct}% (${voteCount})
                    </span>
                </div>
            `;
        });
        pollCard.querySelector('.poll-options-list').innerHTML = optionsHtml;
    });

    // 5. Presence & Online Members Update
    socket.on('club_presence_update', (data) => {
        const onlineCountEl = document.getElementById('onlineCountNum');
        if (onlineCountEl) onlineCountEl.textContent = data.onlineCount || 0;

        const listEl = document.getElementById('onlineMembersList');
        if (listEl && data.onlineUsers) {
            let html = '';
            data.onlineUsers.forEach(u => {
                html += `
                    <div class="member-card-row" onclick="window.location.href='/users/${u.username}'">
                        <div class="member-avatar-wrap">
                            <img src="${u.avatarUrl || (u.username === 'GPLMods' ? '/images/team-logo.png' : '/images/default-avatar.png')}" class="member-avatar-img" alt="${u.username}" onerror="this.onerror=null; this.src=(this.alt==='GPLMods')?'/images/team-logo.png':'/images/default-avatar.png';">
                            <div class="online-dot"></div>
                        </div>
                        <div class="member-meta-box">
                            <span class="member-display-name">${u.username}</span>
                        </div>
                    </div>
                `;
            });
            listEl.innerHTML = html;
        }
    });

    // 6. Vanished Mode Toggle (Site Owner / Admin)
    function toggleVanishedMode() {
        isVanished = !isVanished;
        try {
            if (currentUserId) {
                localStorage.setItem('club_ghost_mode_' + currentUserId, isVanished ? '1' : '0');
            }
            fetch('/clubs/api/vanish-mode', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ vanished: isVanished })
            }).catch(() => {});
        } catch (e) {}

        socket.emit('club_vanish_toggle', { clubId, vanished: isVanished });
        const btn = document.getElementById('vanishToggleBtn');
        const txt = document.getElementById('vanishStatusText');
        if (btn) {
            btn.classList.toggle('active', isVanished);
            btn.style.color = isVanished ? 'var(--gold)' : '';
        }
        if (txt) txt.textContent = isVanished ? 'Ghost ON' : 'Ghost';
        showGplToast(isVanished ? 'Ghost Mode Activated (You are hidden from member list).' : 'Ghost Mode Deactivated (You are visible).', 'info');
    }

    // 7. Interactive Reactions & Poll Actions
    function toggleReaction(messageId, emoji) {
        if (!messageId || !emoji) return;

        // Optimistic UI update
        const reactionsRow = document.getElementById(`reactions-${messageId}`);
        if (reactionsRow) {
            const pills = Array.from(reactionsRow.querySelectorAll('.reaction-pill'));
            // Remove user reaction from any other pill on the same message
            pills.forEach(pill => {
                if (pill.classList.contains('user-reacted')) {
                    const spanEmoji = pill.querySelector('span:first-child');
                    if (spanEmoji && spanEmoji.textContent.trim() !== emoji) {
                        pill.classList.remove('user-reacted');
                        const countSpan = pill.querySelector('span:last-child');
                        let count = parseInt(countSpan ? countSpan.textContent.trim() : '0', 10) || 0;
                        count = Math.max(0, count - 1);
                        if (count === 0) pill.remove();
                        else if (countSpan) countSpan.textContent = count;
                    }
                }
            });

            // Handle the clicked emoji pill
            let matchedPill = null;
            Array.from(reactionsRow.querySelectorAll('.reaction-pill')).forEach(pill => {
                const spanEmoji = pill.querySelector('span:first-child');
                if (spanEmoji && spanEmoji.textContent.trim() === emoji) {
                    matchedPill = pill;
                }
            });

            if (matchedPill) {
                const countSpan = matchedPill.querySelector('span:last-child');
                let count = parseInt(countSpan ? countSpan.textContent.trim() : '0', 10) || 0;
                if (matchedPill.classList.contains('user-reacted')) {
                    matchedPill.classList.remove('user-reacted');
                    count = Math.max(0, count - 1);
                    if (count === 0) matchedPill.remove();
                    else if (countSpan) countSpan.textContent = count;
                } else {
                    matchedPill.classList.add('user-reacted');
                    if (countSpan) countSpan.textContent = count + 1;
                }
            } else {
                const newPill = document.createElement('div');
                newPill.className = 'reaction-pill user-reacted';
                newPill.onclick = () => toggleReaction(messageId, emoji);
                newPill.innerHTML = `<span>${emoji}</span><span>1</span>`;
                const addBtn = reactionsRow.querySelector('[title="Add Reaction"]');
                if (addBtn) reactionsRow.insertBefore(newPill, addBtn);
                else reactionsRow.appendChild(newPill);
            }
        }

        socket.emit('club_message_reaction', { clubId, channelId, messageId, emoji });
    }

