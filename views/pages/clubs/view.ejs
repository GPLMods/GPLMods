            }
            showGplToast('Channel invite link copied!', 'success');
        };

        if (navigator.clipboard) {
            navigator.clipboard.writeText(input.value).then(finishCopy).catch(() => {
                input.select();
                document.execCommand('copy');
                finishCopy();
            });
        } else {
            input.select();
            document.execCommand('copy');
            finishCopy();
        }
    }

