    // Initialize Custom Select GUI for Modals (Create & Edit Channel Type)
    function initCustomChannelSelects() {
        document.querySelectorAll('.chan-custom-select-wrapper').forEach(wrapper => {
            const trigger = wrapper.querySelector('.chan-custom-select');
            const optionsList = wrapper.querySelectorAll('.chan-custom-option');
            const hiddenInput = wrapper.querySelector('input[type="hidden"]');
            const textLabel = wrapper.querySelector('.text-label');
            const iconSpan = wrapper.querySelector('.chan-custom-select-text i');

            if (trigger) {
                trigger.onclick = (e) => {
                    e.stopPropagation();
                    // Close any other open selects
                    document.querySelectorAll('.chan-custom-select-wrapper').forEach(w => {
                        if (w !== wrapper) w.classList.remove('open');
                    });
                    wrapper.classList.toggle('open');
                };
            }

            optionsList.forEach(opt => {
                opt.onclick = (e) => {
                    e.stopPropagation();
                    const val = opt.getAttribute('data-value');
                    const optStrong = opt.querySelector('strong');
                    const optText = optStrong ? optStrong.textContent.trim() : val;
                    const optIcon = opt.querySelector('i');

                    if (textLabel) textLabel.textContent = optText;
                    if (iconSpan && optIcon) {
                        iconSpan.className = optIcon.className;
                        iconSpan.style.color = optIcon.style.color || 'var(--gold)';
                    }
                    if (hiddenInput) hiddenInput.value = val;

                    optionsList.forEach(o => o.classList.remove('selected'));
                    opt.classList.add('selected');
                    wrapper.classList.remove('open');
                };
            });
        });

        document.addEventListener('click', (e) => {
            document.querySelectorAll('.chan-custom-select-wrapper').forEach(w => {
                if (!w.contains(e.target)) {
                    w.classList.remove('open');
                }
            });
        });
    }
