    // 8. Live Translation Helper with DeepL API, Device Language & Sender Username
    async function translateMessage(messageId) {
        const msgEl = document.getElementById(`msg-text-${messageId}`);
        if (!msgEl) return;

        const msgItem = document.getElementById(`msg-${messageId}`);
        const senderUsername = msgItem?.dataset?.senderUsername || msgItem?.querySelector('.message-username')?.innerText?.trim() || 'user';

        // Detect user's device language or user-selected site language
        const deviceLangRaw = localStorage.getItem('site_language') || navigator.language || navigator.userLanguage || 'en';
        const targetLang = deviceLangRaw.split('-')[0].toLowerCase();

        // Check if message was already translated to target language
        if (msgEl.dataset.translatedLang === targetLang) {
            showGplToast(`@${senderUsername}'s message is already translated to your device language (${targetLang.toUpperCase()}).`, 'info');
            return;
        }

        // Cache original text before translation if not already saved
        if (!msgEl.dataset.originalText) {
            msgEl.dataset.originalText = msgEl.innerText.replace(/\(edited\)/gi, '').replace(/\(Translated to [A-Z-]+\)/gi, '').trim();
        }
        const textToTranslate = msgEl.dataset.originalText;
        if (!textToTranslate) return;

        try {
            const res = await fetch('/api/translate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    texts: [textToTranslate],
                    targetLanguage: targetLang
                })
            });

            const data = await res.json();
            if (data.translations && data.translations.length > 0) {
                const translated = data.translations[0];

                // If identical or already written in that language
                if (translated.trim().toLowerCase() === textToTranslate.trim().toLowerCase()) {
                    showGplToast(`@${senderUsername}'s message is already written in your device language (${targetLang.toUpperCase()}).`, 'info');
                    return;
                }

                // Update text with translation note
                msgEl.innerHTML = `${translated} <span class="translation-note" style="font-size: 0.72rem; color: var(--gold); margin-left: 6px;"><i class="fas fa-language"></i> (Translated to ${targetLang.toUpperCase()})</span>`;
                msgEl.dataset.translatedLang = targetLang;
                showGplToast(`Translated @${senderUsername}'s message to ${targetLang.toUpperCase()} successfully!`, 'success');
            } else {
                showGplToast(`@${senderUsername}'s message is already written in your device language (${targetLang.toUpperCase()}).`, 'info');
            }
        } catch (err) {
            console.error('Translation error:', err);
            showGplToast('Translation service is temporarily unavailable.', 'error');
        }
    }

