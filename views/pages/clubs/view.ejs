<!-- Scripts -->
<script src="/socket.io/socket.io.js"></script>
<script type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@^1/index.js"></script>

<script>
    const clubId = '<%= club._id %>';
    const channelId = '<%= activeChannel ? activeChannel._id : "" %>';
    const isChannelReadOnly = <%= (activeChannel && activeChannel.isReadOnly && !isStaff && !isClubCreator) ? 'true' : 'false' %>;
    const currentUserId = '<%= user ? user._id : "" %>';
    const currentUsername = '<%= user ? user.username : "" %>';
    const hasManageClubPermClient = <%= hasManageClubPerm ? 'true' : 'false' %>;
    let isVanished = <%= vanishedModeDefault ? 'true' : 'false' %>;

    const socket = io();

    // 1. Join Club & Channel on Socket Connection
    socket.emit('club_join', { clubId, vanished: isVanished });
    if (channelId) {
        socket.emit('club_join_channel', { clubId, channelId });
    }

    // Scroll chat to bottom
    const messagesFeed = document.getElementById('messagesFeed');
    function scrollChatToBottom() {
        if (messagesFeed) messagesFeed.scrollTop = messagesFeed.scrollHeight;
    }
    scrollChatToBottom();

    // 2. Strict Link Validation (Only GPLMods Links Allowed)
    const ALLOWED_DOMAINS = ['gplmods.webredirect.org', 'gplmods.mytunnel.org', 'localhost', '127.0.0.1'];
    if (window.location.hostname && !ALLOWED_DOMAINS.includes(window.location.hostname)) {
        ALLOWED_DOMAINS.push(window.location.hostname);
    }
    function containsExternalLinks(text) {
        if (!text) return false;
        const urlPattern = /(https?:\/\/[^\s]+)|(www\.[^\s]+)|([a-zA-Z0-9-]+\.(?:com|org|net|io|gg|me|app|xyz|site|online|tv|cc|ru|cn|in|info|biz|co|uk|de|eu|club|link|live)[^\s]*)/gi;
        const matches = text.match(urlPattern);
        if (!matches || matches.length === 0) return false;

        for (const match of matches) {
            let testUrl = match;
            if (!testUrl.startsWith('http://') && !testUrl.startsWith('https://')) {
                testUrl = 'http://' + testUrl;
            }
            try {
                const parsed = new URL(testUrl);
                const host = parsed.hostname.toLowerCase();
                const isAllowed = ALLOWED_DOMAINS.some(allowed => host === allowed || host.endsWith('.' + allowed));
                if (!isAllowed) return true;
            } catch(e) {
                return true;
            }
        }
        return false;
    }

    // 3. Send Message Handler
    const chatInput = document.getElementById('chatInput');
    const warningBanner = document.getElementById('linkWarningBanner');

    function sendClubMessage() {
        if (isChannelReadOnly) return;
        const text = chatInput.value ? chatInput.value.trim() : '';
        if (!text) return;

        // Strictly check for external links
        if (containsExternalLinks(text)) {
            warningBanner.style.display = 'block';
            setTimeout(() => { warningBanner.style.display = 'none'; }, 5000);
            return;
        }

        socket.emit('club_send_message', {
            clubId,
            channelId,
            text
        });

        chatInput.value = '';
    }

    chatInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendClubMessage();
        }
    });

    // 4. Socket Listeners for Real-Time Updates
    socket.on('club_new_message', (msg) => {
        if (String(msg.channel) !== channelId) return;

        const msgDiv = document.createElement('div');
        msgDiv.className = 'message-item';
        msgDiv.id = `msg-${msg._id}`;

        const isGPLModsMsg = !msg.sender || msg.sender.username === 'GPLMods' || msg.isSystemMessage;
        const senderAvatar = msg.sender?.signedAvatarUrl || (isGPLModsMsg ? '/images/team-logo.png' : '/images/default-avatar.png');
        const senderName = msg.sender?.username || 'GPLMods';
        const roleBadges = [];

        if (msg.sender?.role === 'owner') roleBadges.push('<span class="badge-icon-tag badge-owner"><i class="fas fa-crown"></i> Owner</span>');
        else if (msg.sender?.role === 'admin') roleBadges.push('<span class="badge-icon-tag badge-admin"><i class="fas fa-shield-alt"></i> Admin</span>');
        if (msg.sender?.membership === 'premium' || msg.sender?.isPremium) roleBadges.push('<span class="badge-icon-tag badge-premium"><i class="fas fa-star"></i> Premium</span>');
        if (msg.sender?.isCreator) roleBadges.push('<span class="badge-icon-tag badge-creator"><i class="fas fa-paint-brush"></i> Creator</span>');

        msgDiv.innerHTML = `
            <img src="${senderAvatar}" alt="Avatar" class="message-avatar" onerror="this.src='${isGPLModsMsg ? '/images/team-logo.png' : '/images/default-avatar.png'}';">
            <div class="message-content-col">
                <div class="message-header-row">
                    <a href="/users/${senderName}" class="message-username" target="_blank">${senderName}</a>
                    ${roleBadges.join(' ')}
                    <span class="message-time">${new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
                </div>
                <div class="message-body-text" id="msg-text-${msg._id}">${msg.content}</div>
                <div class="reactions-row" id="reactions-${msg._id}">
                    <div class="reaction-pill" onclick="quickReactPicker('${msg._id}', event)" title="Add Reaction">
                        <i class="far fa-smile-plus"></i>
                    </div>
                </div>
                <div class="message-actions-toolbar" style="display: flex; gap: 8px; margin-top: 6px; flex-wrap: wrap; align-items: center;">
                    <button type="button" class="btn-msg-action" onclick="openClubShareModal('Club Message', '/clubs/<%= club.slug %>#msg-${msg._id}')" title="Share Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: var(--silver); border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                        <i class="fas fa-share-alt"></i> Share
                    </button>
                    <button type="button" class="btn-msg-action" onclick="openForwardModal('${msg._id}')" title="Forward Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: var(--silver); border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                        <i class="fas fa-reply"></i> Forward
                    </button>
                    ${hasManageClubPermClient ? `
                        <button type="button" class="btn-msg-action btn-msg-pin" onclick="togglePinClubMessage('${msg._id}', true)" title="Pin Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: var(--silver); border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                            <i class="fas fa-thumbtack"></i> Pin
                        </button>
                    ` : ''}
                    ${(String(msg.sender?._id) === currentUserId || hasManageClubPermClient) ? `
                        <button type="button" class="btn-msg-action btn-msg-edit" onclick="openEditMessageModal('${msg._id}')" title="Edit Message" style="background: rgba(255,255,255,0.05); border: 1px solid #333; color: var(--gold); border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button type="button" class="btn-msg-action btn-msg-delete" onclick="deleteClubMessage('${msg._id}')" title="Delete Message" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(244,67,54,0.3); color: #ff6b6b; border-radius: 6px; padding: 3px 8px; font-size: 0.75rem; cursor: pointer;">
                            <i class="fas fa-trash-alt"></i> Delete
                        </button>
                    ` : ''}
                    <button type="button" class="btn-translate-msg" onclick="translateMessage('${msg._id}')" style="margin: 0; padding: 3px 8px; font-size: 0.75rem;">
                        <i class="fas fa-language"></i> Translate
                    </button>
                </div>
            </div>
        `;

        messagesFeed.appendChild(msgDiv);
        scrollChatToBottom();
    });

    socket.on('club_message_edited', (data) => {
        const textEl = document.getElementById(`msg-text-${data.messageId}`);
        if (textEl) {
            textEl.innerHTML = `${data.content} <span style="font-size: 0.72rem; color: #888; font-style: italic; margin-left: 6px;">(edited)</span>`;
        }
    });

    socket.on('club_message_deleted', (data) => {
        const msgDiv = document.getElementById(`msg-${data.messageId}`);
        if (!msgDiv) return;

        const isSender = data.senderId && String(data.senderId) === String(currentUserId);
        if (isSender) {
            msgDiv.remove();
        } else {
            const textEl = document.getElementById(`msg-text-${data.messageId}`);
            if (textEl) {
                textEl.innerHTML = `<em style="color: #777; font-size: 0.85rem;"><i class="fas fa-trash-alt" style="margin-right: 4px; font-size: 0.75rem;"></i> This message was deleted</em>`;
            }
            const toolbar = msgDiv.querySelector('.message-actions-toolbar');
            if (toolbar) toolbar.remove();
            const reactions = msgDiv.querySelector('.reactions-row');
            if (reactions) reactions.remove();
        }
    });

    socket.on('club_message_pinned', (data) => {
        const banner = document.getElementById('pinnedMessageBanner');
        const text = document.getElementById('pinnedBannerText');
        const jumpBtn = document.getElementById('pinnedBannerJumpBtn');
        const unpinBtn = document.getElementById('pinnedBannerUnpinBtn');
        if (!banner) return;

        if (data.isPinned) {
            banner.style.display = 'flex';
            if (text) text.textContent = data.content || '';
            if (jumpBtn) jumpBtn.setAttribute('onclick', `jumpToPinnedMessage('${data.messageId}')`);
            if (unpinBtn) unpinBtn.setAttribute('onclick', `togglePinClubMessage('${data.messageId}', false)`);
        } else {
            banner.style.display = 'none';
        }
    });

    socket.on('club_channel_restriction_updated', (data) => {
        if (String(data.channelId) === channelId) {
            window.location.reload();
        }
    });

    socket.on('club_message_error', (data) => {
        alert(data.message || 'Error sending message.');
    });

    socket.on('club_reaction_updated', (data) => {
        const reactionsRow = document.getElementById(`reactions-${data.messageId}`);
        if (!reactionsRow) return;

        let html = '';
        (data.reactions || []).forEach(r => {
            const hasReacted = r.users && r.users.some(u => String(u) === currentUserId);
            html += `
                <div class="reaction-pill ${hasReacted ? 'user-reacted' : ''}" onclick="toggleReaction('${data.messageId}', '${r.emoji}')">
                    <span>${r.emoji}</span>
                    <span>${r.users.length}</span>
                </div>
            `;
        });
        html += `<div class="reaction-pill" onclick="quickReactPicker('${data.messageId}')" title="Add Reaction"><i class="far fa-smile-plus"></i></div>`;
        reactionsRow.innerHTML = html;
    });

    socket.on('club_poll_updated', (data) => {
        const pollCard = document.getElementById(`poll-${data.messageId}`);
        if (!pollCard) return;

        const totalVotes = data.poll.options.reduce((sum, opt) => sum + (opt.votes ? opt.votes.length : 0), 0);
        let optionsHtml = '';
        data.poll.options.forEach((opt, idx) => {
            const voteCount = opt.votes ? opt.votes.length : 0;
            const pct = totalVotes > 0 ? Math.round((voteCount / totalVotes) * 100) : 0;
            const hasVoted = opt.votes && opt.votes.some(v => String(v) === currentUserId);

            optionsHtml += `
                <div class="poll-option-row" onclick="votePoll('${data.messageId}', ${idx})">
                    <div class="poll-progress-fill" style="width: ${pct}%;"></div>
                    <span style="position: relative; z-index: 2; font-weight: ${hasVoted ? '700' : 'normal'};">
                        ${hasVoted ? '✓ ' : ''}${opt.text}
                    </span>
                    <span style="position: relative; z-index: 2; font-size: 0.85rem; color: var(--gold);">
                        ${pct}% (${voteCount})
                    </span>
                </div>
            `;
        });
        pollCard.querySelector('.poll-options-list').innerHTML = optionsHtml;
    });

    // 5. Presence & Online Members Update
    socket.on('club_presence_update', (data) => {
        const onlineCountEl = document.getElementById('onlineCountNum');
        if (onlineCountEl) onlineCountEl.textContent = data.onlineCount || 0;

        const listEl = document.getElementById('onlineMembersList');
        if (listEl && data.onlineUsers) {
            let html = '';
            data.onlineUsers.forEach(u => {
                html += `
                    <div class="member-card-row" onclick="window.location.href='/users/${u.username}'">
                        <div class="member-avatar-wrap">
                            <img src="${u.avatarUrl || (u.username === 'GPLMods' ? '/images/team-logo.png' : '/images/default-avatar.png')}" class="member-avatar-img" alt="${u.username}" onerror="this.onerror=null; this.src=(this.alt==='GPLMods')?'/images/team-logo.png':'/images/default-avatar.png';">
                            <div class="online-dot"></div>
                        </div>
                        <div class="member-meta-box">
                            <span class="member-display-name">${u.username}</span>
                        </div>
                    </div>
                `;
            });
            listEl.innerHTML = html;
        }
    });

    // 6. Vanished Mode Toggle (Site Owner / Admin)
    function toggleVanishedMode() {
        isVanished = !isVanished;
        socket.emit('club_vanish_toggle', { clubId, vanished: isVanished });
        const btn = document.getElementById('vanishToggleBtn');
        const txt = document.getElementById('vanishStatusText');
        if (btn) btn.style.color = isVanished ? 'var(--gold)' : '#777';
        if (txt) txt.textContent = isVanished ? 'Ghost ON' : 'Ghost';
    }

    // 7. Interactive Reactions & Poll Actions
    function toggleReaction(messageId, emoji) {
        socket.emit('club_message_reaction', { clubId, channelId, messageId, emoji });
    }

    let currentReactMsgId = null;
    function quickReactPicker(messageId, event) {
        if (event) {
            event.stopPropagation();
        }
        currentReactMsgId = messageId;
        const bar = document.getElementById('reactionFloatingBar');
        if (!bar) return;

        const targetEl = event ? (event.currentTarget || event.target) : document.getElementById(`reactions-${messageId}`);
        if (targetEl) {
            const rect = targetEl.getBoundingClientRect();
            bar.style.top = (window.scrollY + rect.top - 46) + 'px';
            bar.style.left = (window.scrollX + rect.left) + 'px';
            bar.style.display = 'flex';
        }
    }

    function submitQuickReaction(emoji) {
        if (currentReactMsgId && emoji) {
            toggleReaction(currentReactMsgId, emoji);
        }
        const bar = document.getElementById('reactionFloatingBar');
        if (bar) bar.style.display = 'none';
        currentReactMsgId = null;
    }

    document.addEventListener('click', (e) => {
        const bar = document.getElementById('reactionFloatingBar');
        if (bar && !bar.contains(e.target) && !e.target.closest('.reaction-pill')) {
            bar.style.display = 'none';
        }
    });

    function votePoll(messageId, optionIndex) {
        socket.emit('club_poll_vote', { clubId, channelId, messageId, optionIndex });
    }

    // 8. Live Translation Helper
    async function translateMessage(messageId) {
        const msgEl = document.getElementById(`msg-text-${messageId}`);
        if (!msgEl) return;
        const currentLang = localStorage.getItem('site_language') || 'es';
        if (window.executeTranslation) {
            await window.executeTranslation(currentLang, msgEl);
        } else {
            alert('Live translation engine active.');
        }
    }

    // 9. Emoji & Emoticon Popovers
    const emojiBtn = document.getElementById('emojiPickerBtn');
    const mainEmojiPicker = document.getElementById('mainEmojiPicker');
    if (emojiBtn && mainEmojiPicker) {
        emojiBtn.addEventListener('click', () => {
            mainEmojiPicker.style.display = (mainEmojiPicker.style.display === 'block') ? 'none' : 'block';
        });
        mainEmojiPicker.addEventListener('emoji-click', event => {
            chatInput.value += event.detail.unicode;
            chatInput.focus();
        });
    }

    function toggleEmoticonPopover() {
        const pop = document.getElementById('emoticonPopover');
        pop.classList.toggle('active');
    }

    function insertEmoticon(emoticon) {
        chatInput.value += ' ' + emoticon + ' ';
        chatInput.focus();
        document.getElementById('emoticonPopover').classList.remove('active');
    }

    function toggleGifPicker() {
        const gifModal = document.getElementById('gifPickerModal');
        gifModal.classList.toggle('active');
    }

    function insertGif(gifUrl) {
        chatInput.value += ` ${gifUrl} `;
        chatInput.focus();
        toggleGifPicker();
    }

    // Modal Controllers
    function openCreateChannelModal() { document.getElementById('createChannelModal').classList.add('active'); }
    function closeCreateChannelModal() { document.getElementById('createChannelModal').classList.remove('active'); }
    function openCreatePollModal() { document.getElementById('createPollModal').classList.add('active'); }
    function closeCreatePollModal() { document.getElementById('createPollModal').classList.remove('active'); }
    function openTrackedCreatorsModal() { document.getElementById('trackedCreatorsModal').classList.add('active'); }
    function closeTrackedCreatorsModal() { document.getElementById('trackedCreatorsModal').classList.remove('active'); }

    // Drawer Controllers (Mobile Off-Canvas & Desktop)
    function toggleLeftDrawer() {
        const drawer = document.getElementById('leftNavDrawer');
        const backdrop = document.getElementById('discordBackdrop');
        if (!drawer) return;
        const isOpen = drawer.classList.contains('open');
        closeDiscordDrawers();
        if (!isOpen) {
            drawer.classList.add('open');
            if (backdrop) backdrop.classList.add('active');
        }
    }

    function toggleMembersSidebar() {
        const sidebar = document.getElementById('membersSidebar');
        const backdrop = document.getElementById('discordBackdrop');
        if (!sidebar) return;
        if (window.innerWidth <= 992) {
            const isOpen = sidebar.classList.contains('open');
            closeDiscordDrawers();
            if (!isOpen) {
                sidebar.classList.add('open');
                if (backdrop) backdrop.classList.add('active');
            }
        } else {
            sidebar.style.display = (sidebar.style.display === 'none') ? 'flex' : 'none';
        }
    }

    function closeDiscordDrawers(e) {
        if (e && e.stopPropagation) {
            e.stopPropagation();
        }
        const leftDrawer = document.getElementById('leftNavDrawer');
        const membersSidebar = document.getElementById('membersSidebar');
        const backdrop = document.getElementById('discordBackdrop');
        const clubDropdown = document.getElementById('clubHeaderDropdown');
        if (leftDrawer) leftDrawer.classList.remove('open');
        if (membersSidebar && window.innerWidth <= 992) membersSidebar.classList.remove('open');
        if (backdrop) backdrop.classList.remove('active');
        if (clubDropdown) clubDropdown.classList.remove('active');
    }

    function toggleClubMenu(e) {
        if (e && e.stopPropagation) {
            e.stopPropagation();
        }
        const dropdown = document.getElementById('clubHeaderDropdown');
        if (dropdown) {
            dropdown.classList.toggle('active');
        }
    }

    // Auto-close navigation drawer on mobile when clicking channel link
    document.querySelectorAll('.channel-item-link').forEach(link => {
        link.addEventListener('click', () => {
            if (window.innerWidth <= 992) {
                closeDiscordDrawers();
            }
        });
    });

    // Close club dropdown on outside click
    document.addEventListener('click', function(e) {
        const dropdown = document.getElementById('clubHeaderDropdown');
        const headerBox = document.querySelector('.club-header-box');
        if (dropdown && dropdown.classList.contains('active')) {
            if (!dropdown.contains(e.target) && (!headerBox || !headerBox.contains(e.target))) {
                dropdown.classList.remove('active');
            }
        }
    });

    // Close drawers on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeDiscordDrawers();
        }
    });

    // Share Club System (from download.ejs)
    function handleClubShare(btn) {
        const clubId = btn.getAttribute('data-club-id');
        const clubName = btn.getAttribute('data-club-name');
        const clubUrl = btn.getAttribute('data-club-url');
        shareClub(clubId, clubName, clubUrl);
    }

    function shareClub(clubId, clubName, clubUrl) {
        const fullShareUrl = window.location.origin + clubUrl;
        if (navigator.share) {
            navigator.share({
                title: `${clubName} on GPL Mods`,
                text: `Join ${clubName} community chat and distributor channels on GPL Mods!`,
                url: fullShareUrl
            }).catch(e => console.log('Share dismissed'));
        } else {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(fullShareUrl).then(() => {
                    alert(`Link to "${clubName}" copied to clipboard!`);
                });
            } else {
                prompt('Copy this club link:', fullShareUrl);
            }
        }
    }

    function openForwardModal(messageId) {
        const modal = document.getElementById('clubForwardModal');
        const input = document.getElementById('forwardMessageId');
        if (modal && input) {
            input.value = messageId;
            modal.style.display = 'flex';
        }
    }
    function closeForwardModal() {
        const modal = document.getElementById('clubForwardModal');
        if (modal) modal.style.display = 'none';
    }
    function submitForwardMessage() {
        const messageId = document.getElementById('forwardMessageId')?.value;
        const targetChan = document.getElementById('forwardChannelSelect')?.value;
        if (!messageId || !targetChan) return;

        socket.emit('club_forward_message', {
            targetClubId: clubId,
            targetChannelId: targetChan,
            messageId
        });
        closeForwardModal();
        alert('Message forwarded successfully!');
    }

    function openEditMessageModal(messageId) {
        const modal = document.getElementById('clubEditModal');
        const input = document.getElementById('editMessageId');
        const textarea = document.getElementById('editMessageTextarea');
        const textEl = document.getElementById(`msg-text-${messageId}`);
        if (modal && input && textarea) {
            input.value = messageId;
            let currentText = textEl ? textEl.innerText.replace(/\(edited\)$/, '').trim() : '';
            textarea.value = currentText;
            modal.style.display = 'flex';
        }
    }
    function closeEditMessageModal() {
        const modal = document.getElementById('clubEditModal');
        if (modal) modal.style.display = 'none';
    }
    function submitEditMessage() {
        const messageId = document.getElementById('editMessageId')?.value;
        const newText = document.getElementById('editMessageTextarea')?.value;
        if (!messageId || !newText || !newText.trim()) return;

        socket.emit('club_edit_message', {
            clubId,
            channelId,
            messageId,
            content: newText.trim()
        });
        closeEditMessageModal();
    }

    // Custom Delete Confirmation Modal Logic
    let pendingDeleteMsgId = null;
    function deleteClubMessage(messageId) {
        pendingDeleteMsgId = messageId;
        const modal = document.getElementById('clubDeleteConfirmModal');
        if (modal) modal.style.display = 'flex';
    }

    function closeClubDeleteModal() {
        const modal = document.getElementById('clubDeleteConfirmModal');
        if (modal) modal.style.display = 'none';
        pendingDeleteMsgId = null;
    }

    const confirmDeleteBtn = document.getElementById('confirmDeleteMessageBtn');
    if (confirmDeleteBtn) {
        confirmDeleteBtn.addEventListener('click', () => {
            if (pendingDeleteMsgId) {
                socket.emit('club_delete_message', {
                    clubId,
                    channelId,
                    messageId: pendingDeleteMsgId
                });
                closeClubDeleteModal();
            }
        });
    }

    // Pinned Messages Control
    function jumpToPinnedMessage(msgId) {
        if (!msgId) return;
        const el = document.getElementById(`msg-${msgId}`);
        if (el) {
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.style.transition = 'background-color 0.4s ease';
            el.style.backgroundColor = 'rgba(255, 215, 0, 0.2)';
            setTimeout(() => { el.style.backgroundColor = ''; }, 2200);
        }
    }

    function togglePinClubMessage(messageId, shouldPin) {
        socket.emit('club_pin_message', {
            clubId,
            channelId,
            messageId,
            pin: shouldPin
        });
    }

    // Channel Restriction Toggle
    function toggleChannelRestriction() {
        socket.emit('club_toggle_channel_restriction', {
            clubId,
            channelId
        });
    }

    // Club Share System
    let currentShareUrl = '';
    function handleClubShare(btn) {
        const cName = btn.dataset.clubName || '<%= club.name %>';
        const cUrl = btn.dataset.clubUrl || `/clubs/<%= club.slug %>`;
        openClubShareModal(cName, cUrl);
    }

    function openClubShareModal(title, relativeUrl) {
        const fullUrl = window.location.origin + relativeUrl;
        currentShareUrl = fullUrl;

        const modal = document.getElementById('clubShareGUIModal');
        const input = document.getElementById('shareDirectLinkInput');
        const sub = document.getElementById('shareModalSubtitle');
        const copyBtn = document.getElementById('copyShareLinkBtn');

        if (sub) sub.textContent = `Invite friends and creators to ${title} on GPLMods:`;
        if (input) input.value = fullUrl;
        if (copyBtn) copyBtn.innerHTML = '<i class="fas fa-copy"></i> Copy';

        const encUrl = encodeURIComponent(fullUrl);
        const encText = encodeURIComponent(`Join ${title} on GPLMods! Safe & working mods:`);

        const wa = document.getElementById('shareWhatsAppBtn');
        const tg = document.getElementById('shareTelegramBtn');
        const tw = document.getElementById('shareTwitterBtn');
        const rd = document.getElementById('shareRedditBtn');

        if (wa) wa.href = `https://api.whatsapp.com/send?text=${encText}%20${encUrl}`;
        if (tg) tg.href = `https://t.me/share/url?url=${encUrl}&text=${encText}`;
        if (tw) tw.href = `https://twitter.com/intent/tweet?text=${encText}&url=${encUrl}`;
        if (rd) rd.href = `https://reddit.com/submit?url=${encUrl}&title=${encodeURIComponent(title)}`;

        if (modal) modal.style.display = 'flex';
    }

    function closeClubShareModal() {
        const modal = document.getElementById('clubShareGUIModal');
        if (modal) modal.style.display = 'none';
    }

    function copyShareDirectLink() {
        const input = document.getElementById('shareDirectLinkInput');
        const copyBtn = document.getElementById('copyShareLinkBtn');
        if (!input) return;
        navigator.clipboard.writeText(input.value).then(() => {
            if (copyBtn) copyBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
            setTimeout(() => { if (copyBtn) copyBtn.innerHTML = '<i class="fas fa-copy"></i> Copy'; }, 3000);
        }).catch(() => {
            input.select();
            document.execCommand('copy');
            if (copyBtn) copyBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
        });
    }
</script>

<%- include('../../partials/footer') %>
