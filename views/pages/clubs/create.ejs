<%- include('../../partials/header') %>

<style>
    .club-create-wrapper {
        max-width: 820px;
        margin: 40px auto 70px;
    }
    .club-create-card {
        background: #14151b;
        border: 1px solid #282a36;
        border-radius: 20px;
        padding: 36px 32px;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6);
    }
    .create-card-header {
        text-align: center;
        margin-bottom: 30px;
        border-bottom: 1px solid #282a36;
        padding-bottom: 20px;
    }
    .create-card-title {
        font-size: 2.2rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 8px;
    }
    .create-card-subtitle {
        color: var(--silver);
        font-size: 0.95rem;
    }
    .form-group-block {
        margin-bottom: 22px;
    }
    .form-group-block label {
        display: block;
        font-size: 0.88rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 8px;
        letter-spacing: 0.3px;
    }
    .form-group-block label .req {
        color: #ff5252;
    }
    .form-group-block label .hint {
        color: var(--silver);
        font-size: 0.8rem;
        font-weight: 400;
        margin-left: 6px;
    }
    .form-control-input,
    .form-control-select,
    .form-control-textarea {
        width: 100%;
        background: #0d0e12;
        border: 1px solid #333645;
        border-radius: 10px;
        color: #fff;
        padding: 12px 16px;
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.25s, box-shadow 0.25s;
        box-sizing: border-box;
    }
    .form-control-input:focus,
    .form-control-select:focus,
    .form-control-textarea:focus {
        border-color: var(--gold);
        box-shadow: 0 0 12px rgba(255, 215, 0, 0.2);
    }
    .form-row-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }
    /* Custom Select Dropdowns */
    .form-group-block.dropdown-block {
        position: relative;
    }
    .custom-select-wrapper {
        position: relative;
        user-select: none;
        width: 100%;
    }
    .custom-select-wrapper.open {
        z-index: 1000;
    }
    .custom-select {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-radius: 10px;
        border: 1px solid #333645;
        background-color: #0d0e12;
        cursor: pointer;
        transition: all 0.25s ease;
        min-height: 48px;
        box-sizing: border-box;
    }
    .custom-select:hover {
        border-color: rgba(255, 215, 0, 0.5);
    }
    .custom-select-wrapper.open .custom-select {
        border-color: var(--gold);
        box-shadow: 0 0 12px rgba(255, 215, 0, 0.25);
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
    }
    .custom-select-text {
        color: #fff;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .custom-select-arrow {
        color: var(--silver);
        font-size: 0.82rem;
        transition: transform 0.3s ease;
    }
    .custom-select-wrapper.open .custom-select-arrow {
        transform: rotate(180deg);
        color: var(--gold);
    }
    .custom-options {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #14151e;
        border: 1px solid var(--gold);
        border-top: none;
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.7);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition: all 0.25s ease;
        z-index: 1001;
        max-height: 250px;
        overflow-y: auto;
    }
    .custom-select-wrapper.open .custom-options {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    .custom-option {
        padding: 11px 16px;
        color: var(--silver);
        font-size: 0.92rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: background 0.2s, color 0.2s;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }
    .custom-option:last-child {
        border-bottom: none;
    }
    .custom-option:hover {
        background-color: rgba(255, 215, 0, 0.12);
        color: var(--gold);
    }
    .custom-option.selected {
        background-color: rgba(255, 215, 0, 0.18);
        color: var(--gold);
        font-weight: 700;
    }
    .custom-option i {
        width: 18px;
        text-align: center;
    }
    .privacy-toggle-box {
        background: #0d0e12;
        border: 1px solid #333645;
        border-radius: 12px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }
    .privacy-toggle-info h4 {
        margin: 0 0 4px 0;
        color: #fff;
        font-size: 1rem;
    }
    .privacy-toggle-info p {
        margin: 0;
        color: var(--silver);
        font-size: 0.85rem;
    }
    .switch-ui {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 28px;
        flex-shrink: 0;
    }
    .switch-ui input {
        opacity: 0;
        width: 0;
        height: 0;
    }
    .slider-ui {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #333645;
        transition: .3s;
        border-radius: 34px;
    }
    .slider-ui:before {
        position: absolute;
        content: "";
        height: 20px;
        width: 20px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        transition: .3s;
        border-radius: 50%;
    }
    input:checked + .slider-ui {
        background-color: var(--gold);
    }
    input:checked + .slider-ui:before {
        transform: translateX(22px);
        background-color: #000;
    }
    .btn-submit-club {
        background: linear-gradient(135deg, var(--gold) 0%, #d4af37 100%);
        color: #000;
        font-weight: 700;
        font-size: 1.05rem;
        padding: 14px 28px;
        border: none;
        border-radius: 12px;
        width: 100%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 6px 20px rgba(255, 215, 0, 0.35);
        transition: all 0.25s ease;
        margin-top: 10px;
    }
    .btn-submit-club:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(255, 215, 0, 0.5);
    }
    .error-alert-banner {
        background: rgba(244, 67, 54, 0.15);
        border: 1px solid #f44336;
        color: #ff8a80;
        padding: 12px 18px;
        border-radius: 10px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
    }
    /* Image Upload Previews & Live Card Preview */
    .upload-preview-card {
        background: #0d0e12;
        border: 1px solid #333645;
        border-radius: 12px;
        padding: 16px;
    }
    .image-upload-zone {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .avatar-preview-box {
        position: relative;
        width: 74px;
        height: 74px;
        border-radius: 16px;
        border: 2px solid var(--gold);
        background: #14151b;
        flex-shrink: 0;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(0,0,0,0.5);
    }
    .club-avatar-preview-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .upload-badge-overlay {
        position: absolute;
        bottom: 0;
        inset-inline: 0;
        background: rgba(0,0,0,0.65);
        color: #fff;
        font-size: 0.7rem;
        text-align: center;
        padding: 2px 0;
    }
    .banner-upload-zone {
        width: 100%;
    }
    .banner-preview-box {
        position: relative;
        width: 100%;
        height: 80px;
        border-radius: 10px;
        border: 1.5px solid #333645;
        background: #14151b;
        overflow: hidden;
    }
    .club-banner-preview-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .banner-badge-overlay {
        position: absolute;
        top: 6px;
        right: 8px;
        background: rgba(0,0,0,0.65);
        color: var(--gold);
        border-radius: 6px;
        padding: 3px 8px;
        font-size: 0.75rem;
    }
    .upload-zone-meta {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
        flex-grow: 1;
    }
    .file-hidden-input {
        display: none !important;
    }
    .btn-choose-file {
        background: #1e202b;
        border: 1px solid rgba(255, 215, 0, 0.4);
        color: var(--gold);
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        width: fit-content;
        transition: all 0.2s ease;
    }
    .btn-choose-file:hover {
        background: var(--gold);
        color: #000;
        box-shadow: 0 0 10px rgba(255, 215, 0, 0.3);
    }
    .file-name-display {
        font-size: 0.78rem;
        color: var(--silver);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .btn-remove-preview {
        background: none;
        border: none;
        color: #ff6b6b;
        font-size: 0.78rem;
        cursor: pointer;
        padding: 0;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        width: fit-content;
    }
    .btn-remove-preview:hover {
        text-decoration: underline;
    }

    /* Live Card Shell */
    .live-card-preview-container {
        background: #0d0e12;
        border: 1px dashed #333645;
        border-radius: 14px;
        padding: 18px;
        display: flex;
        justify-content: center;
    }
    .club-card-preview-shell {
        width: 100%;
        max-width: 380px;
        background: #14151b;
        border: 1px solid rgba(255, 215, 0, 0.3);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.6);
    }
    .preview-banner-wrap {
        height: 100px;
        background: #1f2029;
        position: relative;
    }
    .preview-banner-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .preview-badges {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 2;
    }
    .preview-badge-pill {
        background: rgba(76, 175, 80, 0.2);
        color: #69f0ae;
        border: 1px solid #69f0ae;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 2px 8px;
        border-radius: 10px;
    }
    .preview-avatar-wrap {
        position: absolute;
        bottom: -22px;
        left: 16px;
        width: 52px;
        height: 52px;
        border-radius: 14px;
        border: 2.5px solid #14151b;
        background: #0d0e12;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    }
    .preview-avatar-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .preview-card-body {
        padding: 28px 16px 16px;
    }
    .preview-club-name {
        margin: 0 0 4px 0;
        font-size: 1.15rem;
        font-weight: 700;
        color: #fff;
    }
    .preview-club-desc {
        margin: 0 0 10px 0;
        font-size: 0.82rem;
        color: var(--silver);
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .preview-tags-row {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-bottom: 12px;
    }
    .preview-tag-pill {
        font-size: 0.7rem;
        background: #1e202b;
        border: 1px solid #2e3040;
        color: var(--silver);
        padding: 2px 8px;
        border-radius: 10px;
    }
    .preview-footer-meta {
        border-top: 1px solid rgba(255,255,255,0.06);
        padding-top: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.78rem;
        color: var(--silver);
    }

    @media (max-width: 768px) {
        .form-row-2col { grid-template-columns: 1fr; }
        .club-create-card { padding: 24px 18px; }
    }
</style>

<div class="container club-create-wrapper">
    <!-- ======== DYNAMIC GO BACK BUTTON ======== -->
    <%- include('../../partials/go-back-button', { fallback: '/clubs' }) %>
    <!-- ======================================== -->

    <div class="club-create-card" style="margin-top: 1rem;">
        <div class="create-card-header">
            <h1 class="create-card-title"><i class="fas fa-users-cog" style="color: var(--gold);"></i> Create a Club</h1>
            <p class="create-card-subtitle">
                Establish your community hub on GPLMods. You will receive dedicated Discord-like channels including #rules, #announcements, #new-uploads, #new-updates, and text channels.
            </p>
        <!-- Club Cap Status -->
        <div style="display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 24px; flex-wrap: wrap;">
            <span style="background: <%= (typeof limitReached !== 'undefined' && limitReached) ? 'rgba(231, 76, 60, 0.15)' : 'rgba(255, 215, 0, 0.12)' %>; border: 1.5px solid <%= (typeof limitReached !== 'undefined' && limitReached) ? '#e74c3c' : 'var(--gold)' %>; color: <%= (typeof limitReached !== 'undefined' && limitReached) ? '#ff6b6b' : 'var(--gold)' %>; padding: 7px 18px; border-radius: 20px; font-weight: 700; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-users"></i> Clubs Created: <%= typeof userCreatedCount !== 'undefined' ? userCreatedCount : 0 %> / <%= typeof maxClubsAllowed !== 'undefined' ? maxClubsAllowed : (typeof isHigherTier !== 'undefined' && isHigherTier ? 5 : 3) %> Max
            </span>
            <span style="font-size: 0.85rem; color: var(--silver);">
                <%= (typeof isHigherTier !== 'undefined' && isHigherTier) ? '🌟 GPLLite, GPLPlus & Staff Tier (Max 5 Clubs)' : '👤 Free Tier: 3 Clubs Max' %>
            </span>
        </div>

        <% if (typeof limitReached !== 'undefined' && limitReached) { %>
            <div style="background: linear-gradient(145deg, #221212 0%, #140808 100%); border: 1.5px solid #e74c3c; border-radius: 14px; padding: 24px; text-align: center; margin-bottom: 28px; box-shadow: 0 10px 30px rgba(231, 76, 60, 0.2);">
                <i class="fas fa-ban" style="font-size: 2.4rem; color: #e74c3c; margin-bottom: 12px;"></i>
                <h3 style="color: #fff; margin: 0 0 10px 0; font-size: 1.3rem;">Club Creation Limit Reached</h3>
                <p style="color: var(--silver); margin: 0 0 18px 0; font-size: 0.95rem; line-height: 1.6; max-width: 600px; margin-left: auto; margin-right: auto;">
                    You have created <strong><%= typeof userCreatedCount !== 'undefined' ? userCreatedCount : 0 %></strong> of your maximum <strong><%= typeof maxClubsAllowed !== 'undefined' ? maxClubsAllowed : 3 %></strong> allowed clubs.
                    <% if (typeof isHigherTier !== 'undefined' && !isHigherTier) { %>
                        Free users can create up to 3 clubs. Upgrade to <strong>GPLLite</strong> or <strong>GPLPlus</strong> to unlock up to 5 clubs!
                    <% } else { %>
                        You have reached the maximum allowed limit of 5 clubs for premium and staff members.
                    <% } %>
                </p>
                <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
                    <% if (typeof isHigherTier !== 'undefined' && !isHigherTier) { %>
                        <a href="/membership" style="background: var(--gold); color: #000; font-weight: 700; padding: 10px 22px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                            <i class="fas fa-crown"></i> Upgrade to GPLLite / GPLPlus
                        </a>
                    <% } %>
                    <a href="/clubs" style="background: rgba(255,255,255,0.08); border: 1px solid #555; color: #fff; padding: 10px 20px; border-radius: 8px; font-weight: 600; text-decoration: none;">
                        <i class="fas fa-arrow-left"></i> Back to Clubs
                    </a>
                </div>
            </div>
        <% } %>

        <% if (error) { %>
            <div class="error-alert-banner">
                <i class="fas fa-exclamation-triangle"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <form action="/clubs/create" method="POST" enctype="multipart/form-data" id="clubCreateForm">
            <!-- Club Name -->
            <div class="form-group-block">
                <label for="clubName">Club Name <span class="req">*</span> <span class="hint">(Unique, 3–60 characters. Reserved names like GPLMods/GPL Community are protected)</span></label>
                <input type="text" id="clubName" name="name" class="form-control-input" placeholder="e.g. Apex Modding Guild, Retro Tweakers" required maxlength="60" value="<%= formData.name || '' %>">
            </div>

            <!-- Description -->
            <div class="form-group-block">
                <label for="clubDesc">Description <span class="hint">(Brief summary of what your community is about)</span></label>
                <textarea id="clubDesc" name="description" class="form-control-textarea" rows="3" placeholder="Tell members what mods, tweaks, or topics you discuss here..." maxlength="1000"><%= formData.description || '' %></textarea>
            </div>

            <!-- Primary Topic / Category Dropdown -->
            <div class="form-group-block dropdown-block">
                <label>Club Category / Niche <span class="hint">(Helps players discover your club in searches)</span></label>
                <div class="custom-select-wrapper" id="wrapper-clubCategory">
                    <div class="custom-select">
                        <span class="custom-select-text"><i class="fas fa-gamepad" style="color: var(--gold);"></i> Gaming &amp; Game Modding</span>
                        <i class="fas fa-chevron-down custom-select-arrow"></i>
                    </div>
                    <div class="custom-options">
                        <div class="custom-option selected" data-value="Gaming &amp; Game Modding" data-tag="Gaming">
                            <i class="fas fa-gamepad" style="color: var(--gold);"></i> Gaming &amp; Game Modding
                        </div>
                        <div class="custom-option" data-value="Android Tweaks &amp; Apps" data-tag="Android">
                            <i class="fab fa-android" style="color: #3ddc84;"></i> Android Tweaks &amp; Apps
                        </div>
                        <div class="custom-option" data-value="iOS Jailbreak &amp; IPAs" data-tag="iOS">
                            <i class="fab fa-apple" style="color: #007aff;"></i> iOS Jailbreak &amp; IPAs
                        </div>
                        <div class="custom-option" data-value="Windows Software &amp; Utilities" data-tag="Windows">
                            <i class="fab fa-windows" style="color: #00a4ef;"></i> Windows Software &amp; Utilities
                        </div>
                        <div class="custom-option" data-value="WordPress &amp; Web Development" data-tag="WordPress">
                            <i class="fab fa-wordpress" style="color: #21759b;"></i> WordPress &amp; Web Development
                        </div>
                        <div class="custom-option" data-value="Emulation &amp; Retro Gaming" data-tag="Emulation">
                            <i class="fas fa-ghost" style="color: #ff9800;"></i> Emulation &amp; Retro Gaming
                        </div>
                        <div class="custom-option" data-value="General Modding &amp; Tech Hub" data-tag="General">
                            <i class="fas fa-users" style="color: #ba68c8;"></i> General Modding &amp; Tech Hub
                        </div>
                    </div>
                    <input type="hidden" name="clubCategory" id="clubCategoryInput" value="Gaming &amp; Game Modding">
                </div>
            </div>

            <!-- Tags -->
            <div class="form-group-block">
                <label for="clubTags">Tags <span class="hint">(Up to 10 comma-separated keywords)</span></label>
                <input type="text" id="clubTags" name="tags" class="form-control-input" placeholder="e.g. Android, IPA, Gaming, Tools, Tweaks, Windows" value="<%= formData.tags || 'Gaming, Modding, Community' %>">
            </div>

            <!-- Language & Country/Region Dropdowns -->
            <div class="form-row-2col">
                <!-- Custom Primary Language Dropdown -->
                <div class="form-group-block dropdown-block" style="z-index: 50;">
                    <label><i class="fas fa-language" style="color: var(--gold); margin-right: 6px;"></i> Primary Language</label>
                    <div class="custom-select-wrapper" id="wrapper-primaryLanguage">
                        <% 
                            const languagesList = [
                                { code: 'English', label: 'English', flag: '🇬🇧' },
                                { code: 'Spanish', label: 'Español (Spanish)', flag: '🇪🇸' },
                                { code: 'Hindi', label: 'हिन्दी (Hindi)', flag: '🇮🇳' },
                                { code: 'French', label: 'Français (French)', flag: '🇫🇷' },
                                { code: 'Russian', label: 'Русский (Russian)', flag: '🇷🇺' },
                                { code: 'German', label: 'Deutsch (German)', flag: '🇩🇪' },
                                { code: 'Portuguese', label: 'Português (Portuguese)', flag: '🇧🇷' },
                                { code: 'Arabic', label: 'العربية (Arabic)', flag: '🇦🇪' },
                                { code: 'Chinese', label: '中文 (Chinese)', flag: '🇨🇳' },
                                { code: 'Indonesian', label: 'Bahasa Indonesia', flag: '🇮🇩' },
                                { code: 'Japanese', label: '日本語 (Japanese)', flag: '🇯🇵' },
                                { code: 'Korean', label: '한국어 (Korean)', flag: '🇰🇷' },
                                { code: 'Turkish', label: 'Türkçe (Turkish)', flag: '🇹🇷' }
                            ];
                            const curLang = formData.primaryLanguage || 'English';
                            const curLangObj = languagesList.find(l => l.code === curLang) || languagesList[0];
                        %>
                        <div class="custom-select">
                            <span class="custom-select-text">
                                <span class="custom-select-flag" style="font-size: 1.25rem; line-height: 1;"><%= curLangObj.flag %></span>
                                <span class="text-label"><%= curLangObj.label %></span>
                            </span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options">
                            <% languagesList.forEach(lang => { %>
                                <div class="custom-option <%= (curLang === lang.code) ? 'selected' : '' %>" data-value="<%= lang.code %>">
                                    <span class="opt-flag" style="font-size: 1.25rem; line-height: 1;"><%= lang.flag %></span>
                                    <span class="opt-label"><%= lang.label %></span>
                                </div>
                            <% }); %>
                        </div>
                        <input type="hidden" id="primaryLanguage" name="primaryLanguage" value="<%= curLang %>">
                    </div>
                </div>

                <!-- Custom Country / Region Dropdown (Reused from profile) -->
                <div class="form-group-block dropdown-block" style="z-index: 50;">
