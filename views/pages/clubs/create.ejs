            </div>

            <!-- Custom Rules -->
            <div class="form-group-block">
                <label for="rules">Community Rules <span class="hint">(One rule per line. Displayed in #rules channel and pre-join preview)</span></label>
                <textarea id="rules" name="rules" class="form-control-textarea" rows="4" placeholder="1. Be respectful to all members.&#10;2. Only GPLMods site links are allowed in chat.&#10;3. No malicious files or scamming."><%= formData.rules || "Be respectful to all members and staff.\nOnly official GPLMods site links are allowed in the chat.\nNo spam, scamming, or abusive language.\nFollow platform community safety guidelines." %></textarea>
            </div>

            <!-- Icon & Banner Upload with Interactive Previews -->
            <div class="form-row-2col">
                <div class="form-group-block upload-preview-card">
                    <label for="icon">Club Icon <span class="hint">(Square avatar, max 5MB)</span></label>
                    <div class="image-upload-zone" id="iconUploadZone">
                        <div class="avatar-preview-box">
                            <img src="/images/default-avatar.png" id="iconPreviewImg" alt="Club Icon Preview" class="club-avatar-preview-img">
                            <div class="upload-badge-overlay"><i class="fas fa-camera"></i></div>
                        </div>
                        <div class="upload-zone-meta">
                            <input type="file" id="icon" name="icon" class="file-hidden-input" accept="image/png,image/jpeg,image/webp,image/gif">
                            <button type="button" class="btn-choose-file" onclick="document.getElementById('icon').click()">
                                <i class="fas fa-upload"></i> Choose Icon
                            </button>
                            <span class="file-name-display" id="iconFileName">No image selected (PNG, JPG, WEBP)</span>
                            <button type="button" class="btn-remove-preview" id="iconRemoveBtn" style="display: none;">
                                <i class="fas fa-times"></i> Remove
                            </button>
                        </div>
                    </div>
                </div>

                <div class="form-group-block upload-preview-card">
                    <label for="banner">Club Banner <span class="hint">(Wide banner, max 5MB)</span></label>
                    <div class="banner-upload-zone" id="bannerUploadZone">
                        <div class="banner-preview-box">
                            <img src="/images/default-banner.jpg" id="bannerPreviewImg" alt="Club Banner Preview" class="club-banner-preview-img">
                            <div class="banner-badge-overlay"><i class="fas fa-image"></i> Banner</div>
                        </div>
                        <div class="upload-zone-meta" style="margin-top: 8px;">
                            <input type="file" id="banner" name="banner" class="file-hidden-input" accept="image/png,image/jpeg,image/webp,image/gif">
                            <button type="button" class="btn-choose-file" onclick="document.getElementById('banner').click()">
                                <i class="fas fa-upload"></i> Choose Banner
                            </button>
                            <span class="file-name-display" id="bannerFileName">No image selected (1200x400 recommended)</span>
                            <button type="button" class="btn-remove-preview" id="bannerRemoveBtn" style="display: none;">
                                <i class="fas fa-times"></i> Remove
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Live Pre-Join Club Card Preview -->
            <div class="form-group-block" style="margin-top: 14px; margin-bottom: 24px;">
                <label style="display: flex; align-items: center; justify-content: space-between;">
                    <span><i class="fas fa-eye" style="color: var(--gold); margin-right: 6px;"></i> Live Pre-Join Club Card Preview</span>
                    <span class="hint" style="font-weight: normal;">Live preview of how your club appears in discovery</span>
                </label>
                <div class="live-card-preview-container">
                    <div class="club-card-preview-shell">
                        <div class="preview-banner-wrap">
                            <img src="/images/default-banner.jpg" id="liveCardBannerImg" alt="Banner">
                            <div class="preview-badges">
                                <span class="preview-badge-pill" id="liveCardPrivacyBadge"><i class="fas fa-globe"></i> Public</span>
                            </div>
                            <div class="preview-avatar-wrap">
                                <img src="/images/default-avatar.png" id="liveCardAvatarImg" alt="Avatar">
                            </div>
                        </div>
                        <div class="preview-card-body">
                            <h3 class="preview-club-name" id="liveCardName">Your Club Name</h3>
                            <p class="preview-club-desc" id="liveCardDesc">Brief summary of what your community is about...</p>
                            <div class="preview-tags-row" id="liveCardTags">
                                <span class="preview-tag-pill">#Gaming</span>
                                <span class="preview-tag-pill">#Modding</span>
                            </div>
                            <div class="preview-footer-meta">
                                <span id="liveCardCountry" style="display: inline-flex; align-items: center; gap: 6px; max-width: 48%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    <% if (curCountryObj.code !== 'GLOBAL') { %>
                                        <span class="fi fi-<%= curCountryObj.code.toLowerCase() %>" style="border-radius: 2px; flex-shrink: 0;"></span>
                                    <% } else { %>
                                        <i class="fas fa-globe" style="color: var(--gold); flex-shrink: 0;"></i>
                                    <% } %>
                                    <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= curCountryObj.name %></span>
                                </span>
                                <span id="liveCardLang" style="display: inline-flex; align-items: center; gap: 6px; max-width: 48%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    <span class="preview-flag" style="flex-shrink: 0;"><%= curLangObj.flag %></span>
                                    <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= curLangObj.label %></span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <% if (typeof limitReached !== 'undefined' && limitReached) { %>
                <button type="button" class="btn-submit-club" disabled style="opacity: 0.5; cursor: not-allowed; background: #333; color: #888; box-shadow: none;">
                    <i class="fas fa-lock"></i> Club Creation Cap Reached (<%= userCreatedCount %>/<%= maxClubsAllowed %>)
                </button>
            <% } else { %>
                <button type="submit" class="btn-submit-club">
                    <i class="fas fa-rocket"></i> Launch Community Club
                </button>
            <% } %>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Universal Custom Select Setup
        function initCustomSelect(wrapperId, hiddenInputId, onSelectCallback) {
            const wrapper = document.getElementById(wrapperId);
            const hiddenInput = document.getElementById(hiddenInputId);
            if (!wrapper || !hiddenInput) return;

            const selectBtn = wrapper.querySelector('.custom-select');
            const selectText = wrapper.querySelector('.custom-select-text');
            const optionsContainer = wrapper.querySelector('.custom-options');

            selectBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                // Close other open wrappers
                document.querySelectorAll('.custom-select-wrapper.open').forEach(w => {
                    if (w !== wrapper) w.classList.remove('open');
                });
                wrapper.classList.toggle('open');
            });

            optionsContainer.addEventListener('click', (e) => {
                const opt = e.target.closest('.custom-option');
                if (!opt) return;

                const val = opt.getAttribute('data-value');
                wrapper.querySelectorAll('.custom-option').forEach(o => o.classList.remove('selected'));
                opt.classList.add('selected');

                // Dynamic icon/flag and label update
                selectText.innerHTML = opt.innerHTML;

                hiddenInput.value = val;
                hiddenInput.dispatchEvent(new Event('change'));
                wrapper.classList.remove('open');

                if (typeof onSelectCallback === 'function') {
                    onSelectCallback(val, opt);
                }
            });
        }

        // 1. Club Category Dropdown
        initCustomSelect('wrapper-clubCategory', 'clubCategoryInput', (val, opt) => {
            const tagVal = opt.getAttribute('data-tag');
            const tagsInput = document.getElementById('clubTags');
            if (tagsInput && tagVal) {
                let currentTags = tagsInput.value.split(',').map(t => t.trim()).filter(Boolean);
                if (!currentTags.includes(tagVal)) {
                    currentTags.unshift(tagVal);
                    tagsInput.value = currentTags.slice(0, 10).join(', ');
                    updateLiveTags(tagsInput.value);
                }
            }
        });

        // 2. Primary Language Dropdown
        initCustomSelect('wrapper-primaryLanguage', 'primaryLanguage', (val, opt) => {
            const liveLang = document.getElementById('liveCardLang');
            if (liveLang) {
                liveLang.innerHTML = opt.innerHTML;
            }
        });

        // 3. Country / Region Dropdown
        initCustomSelect('wrapper-country', 'country', (val, opt) => {
            const liveCountry = document.getElementById('liveCardCountry');
            if (liveCountry) {
                liveCountry.innerHTML = opt.innerHTML;
            }
        });

        // 4. Club Privacy Dropdown
        initCustomSelect('wrapper-clubPrivacy', 'isPrivateInput', (val) => {
            const isPriv = (val === 'private');
            const hidden = document.getElementById('isPrivateInput');
            if (hidden) hidden.value = isPriv ? 'true' : 'false';
            
            const selectText = document.querySelector('#wrapper-clubPrivacy .custom-select-text');
            if (selectText) {
                selectText.innerHTML = isPriv
                    ? '<i class="fas fa-lock" style="color: #ff8a80;"></i> <span class="text-label">Private Club (Join Approval Required)</span>'
                    : '<i class="fas fa-globe" style="color: #69f0ae;"></i> <span class="text-label">Public Club (Instant Join for All Members)</span>';
            }

            const livePrivacy = document.getElementById('liveCardPrivacyBadge');
            if (livePrivacy) {
                if (isPriv) {
                    livePrivacy.style.background = 'rgba(244, 67, 54, 0.2)';
                    livePrivacy.style.color = '#ff6b6b';
                    livePrivacy.style.borderColor = '#ff6b6b';
                    livePrivacy.innerHTML = '<i class="fas fa-lock"></i> Private';
                } else {
                    livePrivacy.style.background = 'rgba(76, 175, 80, 0.2)';
                    livePrivacy.style.color = '#69f0ae';
                    livePrivacy.style.borderColor = '#69f0ae';
                    livePrivacy.innerHTML = '<i class="fas fa-globe"></i> Public';
                }
            }
        });

        // Close dropdowns on outside click
        document.addEventListener('click', () => {
            document.querySelectorAll('.custom-select-wrapper.open').forEach(w => w.classList.remove('open'));
        });

        // ==========================================
        // IMAGE UPLOAD PREVIEW & LIVE CARD SYNC
        // ==========================================
        const iconInput = document.getElementById('icon');
        const iconPreviewImg = document.getElementById('iconPreviewImg');
        const liveCardAvatarImg = document.getElementById('liveCardAvatarImg');
        const iconFileName = document.getElementById('iconFileName');
        const iconRemoveBtn = document.getElementById('iconRemoveBtn');

        const bannerInput = document.getElementById('banner');
        const bannerPreviewImg = document.getElementById('bannerPreviewImg');
        const liveCardBannerImg = document.getElementById('liveCardBannerImg');
        const bannerFileName = document.getElementById('bannerFileName');
        const bannerRemoveBtn = document.getElementById('bannerRemoveBtn');

        function formatBytes(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
        }

        // Handle Icon Selection
        if (iconInput) {
            iconInput.addEventListener('change', function(e) {
                const file = this.files && this.files[0];
                if (file) {
                    if (file.size > 5 * 1024 * 1024) {
                        alert('Image file is too large! Maximum allowed size is 5MB.');
                        this.value = '';
                        return;
                    }
                    const reader = new FileReader();
                    reader.onload = function(evt) {
                        if (iconPreviewImg) iconPreviewImg.src = evt.target.result;
                        if (liveCardAvatarImg) liveCardAvatarImg.src = evt.target.result;
                    };
                    reader.readAsDataURL(file);
                    if (iconFileName) iconFileName.textContent = `${file.name} (${formatBytes(file.size)})`;
                    if (iconRemoveBtn) iconRemoveBtn.style.display = 'inline-flex';
                }
            });
        }

        if (iconRemoveBtn) {
            iconRemoveBtn.addEventListener('click', () => {
                if (iconInput) iconInput.value = '';
                if (iconPreviewImg) iconPreviewImg.src = '/images/default-avatar.png';
                if (liveCardAvatarImg) liveCardAvatarImg.src = '/images/default-avatar.png';
                if (iconFileName) iconFileName.textContent = 'No image selected (PNG, JPG, WEBP)';
                iconRemoveBtn.style.display = 'none';
            });
        }

        // Handle Banner Selection
        if (bannerInput) {
            bannerInput.addEventListener('change', function(e) {
                const file = this.files && this.files[0];
                if (file) {
                    if (file.size > 5 * 1024 * 1024) {
                        alert('Banner image is too large! Maximum allowed size is 5MB.');
                        this.value = '';
                        return;
                    }
                    const reader = new FileReader();
                    reader.onload = function(evt) {
                        if (bannerPreviewImg) bannerPreviewImg.src = evt.target.result;
                        if (liveCardBannerImg) liveCardBannerImg.src = evt.target.result;
                    };
                    reader.readAsDataURL(file);
                    if (bannerFileName) bannerFileName.textContent = `${file.name} (${formatBytes(file.size)})`;
                    if (bannerRemoveBtn) bannerRemoveBtn.style.display = 'inline-flex';
                }
            });
        }

        if (bannerRemoveBtn) {
            bannerRemoveBtn.addEventListener('click', () => {
                if (bannerInput) bannerInput.value = '';
                if (bannerPreviewImg) bannerPreviewImg.src = '/images/default-banner.jpg';
                if (liveCardBannerImg) liveCardBannerImg.src = '/images/default-banner.jpg';
                if (bannerFileName) bannerFileName.textContent = 'No image selected (1200x400 recommended)';
                bannerRemoveBtn.style.display = 'none';
            });
        }

        // Live Text Preview Sync
        const clubNameInput = document.getElementById('clubName');
        const liveCardName = document.getElementById('liveCardName');
        if (clubNameInput && liveCardName) {
            clubNameInput.addEventListener('input', function() {
                liveCardName.textContent = this.value.trim() || 'Your Club Name';
            });
        }

        const clubDescInput = document.getElementById('clubDesc');
        const liveCardDesc = document.getElementById('liveCardDesc');
        if (clubDescInput && liveCardDesc) {
            clubDescInput.addEventListener('input', function() {
                liveCardDesc.textContent = this.value.trim() || 'Brief summary of what your community is about...';
            });
        }

        const clubTagsInput = document.getElementById('clubTags');
        function updateLiveTags(tagString) {
            const liveTagsContainer = document.getElementById('liveCardTags');
            if (!liveTagsContainer) return;
            const tags = (tagString || '').split(',').map(t => t.trim()).filter(Boolean);
            if (tags.length === 0) {
                liveTagsContainer.innerHTML = '<span class="preview-tag-pill">#Gaming</span><span class="preview-tag-pill">#Modding</span>';
            } else {
                liveTagsContainer.innerHTML = tags.slice(0, 4).map(t => `<span class="preview-tag-pill">#${t.replace(/^#/, '')}</span>`).join('');
            }
        }
        if (clubTagsInput) {
            clubTagsInput.addEventListener('input', function() {
                updateLiveTags(this.value);
            });
            updateLiveTags(clubTagsInput.value);
        }
    });
</script>

<%- include('../../partials/footer') %>
