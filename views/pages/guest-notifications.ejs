                </div>

                <!-- Test Notification Action Row -->
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; background: rgba(33, 150, 243, 0.08); border: 1px solid rgba(33, 150, 243, 0.3); border-radius: 12px; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(33, 150, 243, 0.15); border: 1px solid #2196F3; display: flex; align-items: center; justify-content: center; color: #64b5f6; font-size: 1.1rem; flex-shrink: 0;">
