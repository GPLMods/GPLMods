                    </div>
                </div>
            </div>
        </div>

        <!-- 1. Site Notifications Card -->
        <div class="guest-card">
            <div class="card-head">
                <h2><i class="fas fa-satellite-dish"></i> Site Notifications</h2>
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <span id="pushPermBadge" style="font-size: 0.78rem; padding: 4px 10px; border-radius: 12px; background: rgba(255,255,255,0.06); color: var(--silver); border: 1px solid #444;">
                        Status: Checking...
                    </span>
                </div>
            </div>

            <!-- Dynamic PWA / Notification Status Banner -->
            <div id="guestNotifStatusBanner" style="display: none; align-items: center; justify-content: space-between; padding: 12px 18px; border-radius: 10px; margin-bottom: 18px; font-size: 0.92rem; font-weight: 600; transition: all 0.3s ease;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span id="guestStatusIcon"><i class="fas fa-info-circle"></i></span>
                    <span id="guestStatusText">PWA installed successfully, enable notification</span>
                </div>
                <span id="guestStatusPill" style="font-size: 0.78rem; padding: 3px 10px; border-radius: 12px; font-weight: 700;">Status</span>
            </div>

            <!-- Master Toggle -->
            <div class="master-switch-box" id="masterSwitchWrapper" style="position: relative;">
                <div class="master-switch-info">
                    <h3 style="display: flex; align-items: center; gap: 8px;">
                        Allow Site to Send Notifications
                        <span id="pwaLockIndicator" style="color: #ffc107; font-size: 0.8rem; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                            <i class="fas fa-lock"></i> (PWA Install Required)
