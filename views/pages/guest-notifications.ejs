<%- include('../partials/header') %>

<style>
    .guest-notif-page {
        min-height: 80vh;
        padding: 50px 20px 80px;
        background: radial-gradient(circle at top, rgba(255, 215, 0, 0.04) 0%, transparent 60%);
    }

    .guest-notif-container {
        max-width: 780px;
        margin: 0 auto;
    }

    .guest-notif-hero {
        text-align: center;
        margin-bottom: 35px;
    }

    .guest-notif-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 215, 0, 0.1);
        border: 1px solid rgba(255, 215, 0, 0.3);
        color: var(--gold);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 14px;
    }

    .guest-notif-hero h1 {
        font-size: clamp(1.8rem, 4vw, 2.5rem);
        color: #fff;
        font-weight: 800;
        margin: 0 0 10px 0;
        letter-spacing: -0.5px;
    }

    .guest-notif-hero p {
        color: var(--silver);
        font-size: 1rem;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.5;
    }

    .guest-card {
        background: linear-gradient(145deg, #15161e 0%, #0d0e14 100%);
        border: 1px solid rgba(255, 215, 0, 0.25);
        border-radius: 16px;
        padding: 28px 24px;
        margin-bottom: 24px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
        position: relative;
        overflow: hidden;
    }

    .guest-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--gold), transparent);
    }

    .card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        flex-wrap: wrap;
        gap: 12px;
    }

    .card-head h2 {
        font-size: 1.25rem;
        color: #fff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-head h2 i {
        color: var(--gold);
    }

    /* Master Switch Box */
    .master-switch-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 215, 0, 0.06);
        border: 1.5px solid rgba(255, 215, 0, 0.35);
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 0;
    }

    .master-switch-info h3 {
        margin: 0 0 4px 0;
        color: #fff;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .master-switch-info p {
        margin: 0;
        color: var(--silver);
        font-size: 0.85rem;
    }

    /* Toggle Switch */
    .switch-ui {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 26px;
        flex-shrink: 0;
    }

    .switch-ui input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider-ui {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #2a2c38;
        transition: 0.3s;
        border-radius: 26px;
        border: 1px solid #444;
    }

    .slider-ui:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: #fff;
        transition: 0.3s;
        border-radius: 50%;
    }

    input:checked + .slider-ui {
        background-color: var(--gold);
        border-color: var(--gold);
    }

    input:checked + .slider-ui:before {
        transform: translateX(24px);
        background-color: #000;
    }

    .btn-gold {
        background: var(--gold);
        color: #000;
        font-weight: 700;
        border: none;
        border-radius: 8px;
        padding: 12px 22px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
    }

    .status-msg-banner {
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 0.88rem;
        margin-top: 14px;
        display: none;
    }
</style>

<main class="guest-notif-page">
    <div class="guest-notif-container">
        <!-- Hero Header -->
        <div class="guest-notif-hero">
            <span class="guest-notif-badge"><i class="fas fa-bell"></i> Guest Control Center</span>
            <h1>Notification &amp; Newsletter Settings</h1>
            <p>Configure which alerts you receive while visiting GPLMods, manage browser push permissions, or update your newsletter preferences.</p>
        </div>

        <!-- 1. Site Notifications Card -->
        <div class="guest-card">
            <div class="card-head">
                <h2><i class="fas fa-satellite-dish"></i> Site Notifications</h2>
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <span id="pushPermBadge" style="font-size: 0.78rem; padding: 4px 10px; border-radius: 12px; background: rgba(255,255,255,0.06); color: var(--silver); border: 1px solid #444;">
                        Status: Checking...
                    </span>
                    <button type="button" class="btn btn-secondary" onclick="openGlobalNotificationModal()" style="border-color: var(--gold); color: var(--gold); padding: 5px 12px; font-size: 0.82rem; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; background: rgba(255,215,0,0.08);">
                        <i class="fas fa-sliders-h"></i> PWA &amp; App Notification Hub
                    </button>
                </div>
            </div>

            <!-- Master Toggle -->
            <div class="master-switch-box">
                <div class="master-switch-info">
                    <h3>Allow Site to Send Notifications</h3>
                    <p>Master switch for Web Push, PWA alerts, and live in-app notifications.</p>
                </div>
                <label class="switch-ui">
                    <input type="checkbox" id="guestMasterSwitch" onchange="handleGuestMasterToggle(this.checked)">
                    <span class="slider-ui"></span>
                </label>
            </div>

            <div id="guestNotifSaveStatus" class="status-msg-banner" style="background: rgba(46, 204, 113, 0.15); border: 1px solid #2ecc71; color: #2ecc71; margin-top: 18px;">
                <i class="fas fa-check-circle"></i> Notification preferences saved to your device.
            </div>
        </div>

        <!-- 2. Newsletter & Email Unsubscribe Card -->
        <div class="guest-card">
            <div class="card-head">
                <h2><i class="fas fa-envelope-open-text"></i> Email Newsletter</h2>
            </div>

            <div style="display: flex; flex-direction: column; gap: 16px;">
                <p style="color: var(--silver); font-size: 0.95rem; margin: 0; line-height: 1.6;">
                    We send periodic mod releases, developer highlights, and platform security bulletins. If you wish to stop receiving updates or manage your email subscriptions, you can unsubscribe at any time via our official portal.
                </p>

                <div style="display: flex; align-items: center; justify-content: flex-start; gap: 15px; flex-wrap: wrap; margin-top: 8px;">
                    <a href="/unsubscribe" class="btn-gold">
                        <i class="fas fa-user-minus"></i> Unsubscribe Newsletter
                    </a>
                    <a href="https://gplmods.webredirect.org/unsubscribe" target="_blank" style="color: var(--silver); font-size: 0.85rem; text-decoration: underline;">
                        https://gplmods.webredirect.org/unsubscribe
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Global PWA / App Notification Management Modal -->
<%- include('../partials/pwa-notification-modal') %>

<script>
    const STORAGE_KEY = 'gpl_notif_prefs';

    function loadGuestPrefs() {
        // Sync from gpl_push_notification_enabled as well
        const isPushEnabled = localStorage.getItem('gpl_push_notification_enabled');
        const raw = localStorage.getItem(STORAGE_KEY);
        let master = true;

        if (isPushEnabled !== null) {
            master = isPushEnabled === 'true';
        } else if (raw) {
            try {
                const parsed = JSON.parse(raw);
                if (typeof parsed.master !== 'undefined') master = Boolean(parsed.master);
            } catch(e) {}
        }

        const masterSwitch = document.getElementById('guestMasterSwitch');
        if (masterSwitch) masterSwitch.checked = master;

        syncHubModal(master);
        updatePushPermBadge();
    }

    function syncHubModal(isEnabled) {
        const u = document.getElementById('modal_newUploads');
        const c = document.getElementById('modal_clubUpdates');
        const a = document.getElementById('modal_adminMessages');
        const s = document.getElementById('modal_soundEnabled');
        [u, c, a, s].forEach(el => {
            if (el) {
                el.disabled = !isEnabled;
                el.checked = isEnabled;
            }
        });
    }

    async function handleGuestMasterToggle(isChecked) {
        syncHubModal(isChecked);

        // Store across all notification keys used by site
        localStorage.setItem('gpl_push_notification_enabled', isChecked ? 'true' : 'false');
        localStorage.setItem('gpl_push_notification_sound', isChecked ? 'true' : 'false');
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
            master: isChecked,
            newUploads: isChecked,
            clubUpdates: isChecked,
            adminMessages: isChecked,
            soundEnabled: isChecked
        }));

        if (isChecked) {
            if (window.enablePushNotifications) {
                try {
                    await window.enablePushNotifications();
                } catch (e) {
                    console.log('[GuestPush] In-app alerts enabled, push prompt unavailable:', e);
                }
            }
        } else {
            if (window.disablePushNotifications) {
                try {
                    await window.disablePushNotifications();
                } catch (e) {}
            }
        }

        updatePushPermBadge();

        // Show brief save indicator
        const banner = document.getElementById('guestNotifSaveStatus');
        if (banner) {
            banner.style.display = 'block';
            banner.innerHTML = isChecked 
                ? '<i class="fas fa-check-circle"></i> Site notifications enabled successfully.' 
                : '<i class="fas fa-check-circle"></i> Site notifications disabled.';
            setTimeout(() => { banner.style.display = 'none'; }, 3000);
        }

        // Sync with backend API
        fetch('/settings/notifications', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
                notificationsEnabled: isChecked,
                newUploads: isChecked,
                clubUpdates: isChecked,
                adminMessages: isChecked,
                soundEnabled: isChecked
            })
        }).catch(() => {});
    }

    function updatePushPermBadge() {
        const badge = document.getElementById('pushPermBadge');
        if (!badge) return;
        if (!('Notification' in window)) {
            badge.textContent = 'Push: Unsupported';
            badge.style.color = '#888';
            return;
        }
        if (Notification.permission === 'granted') {
            badge.innerHTML = '<i class="fas fa-check-circle" style="color: #2ecc71;"></i> Push: Granted';
            badge.style.color = '#2ecc71';
            badge.style.borderColor = 'rgba(46, 204, 113, 0.4)';
        } else if (Notification.permission === 'denied') {
            badge.innerHTML = '<i class="fas fa-ban" style="color: #e74c3c;"></i> Push: Blocked';
            badge.style.color = '#e74c3c';
            badge.style.borderColor = 'rgba(231, 76, 60, 0.4)';
        } else {
            const isEnabled = localStorage.getItem('gpl_push_notification_enabled') === 'true';
            badge.innerHTML = isEnabled 
                ? '<i class="fas fa-info-circle" style="color: var(--gold);"></i> Enabled (In-App)' 
                : '<i class="fas fa-times-circle" style="color: var(--silver);"></i> Disabled';
            badge.style.color = isEnabled ? 'var(--gold)' : 'var(--silver)';
            badge.style.borderColor = isEnabled ? 'rgba(255, 215, 0, 0.4)' : '#444';
        }
    }

    document.addEventListener('DOMContentLoaded', loadGuestPrefs);
</script>

<%- include('../partials/footer') %>
