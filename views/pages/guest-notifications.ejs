<%- include('../partials/header') %>

<style>
    .guest-notif-page {
        min-height: 80vh;
        padding: 50px 20px 80px;
        background: radial-gradient(circle at top, rgba(255, 215, 0, 0.04) 0%, transparent 60%);
    }

    .guest-notif-container {
        max-width: 780px;
        margin: 0 auto;
    }

    .guest-notif-hero {
        text-align: center;
        margin-bottom: 35px;
    }

    .guest-notif-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 215, 0, 0.1);
        border: 1px solid rgba(255, 215, 0, 0.3);
        color: var(--gold);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 14px;
    }

    .guest-notif-hero h1 {
        font-size: clamp(1.8rem, 4vw, 2.5rem);
        color: #fff;
        font-weight: 800;
        margin: 0 0 10px 0;
        letter-spacing: -0.5px;
    }

    .guest-notif-hero p {
        color: var(--silver);
        font-size: 1rem;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.5;
    }

    .guest-card {
        background: linear-gradient(145deg, #15161e 0%, #0d0e14 100%);
        border: 1px solid rgba(255, 215, 0, 0.25);
        border-radius: 16px;
        padding: 28px 24px;
        margin-bottom: 24px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
        position: relative;
        overflow: hidden;
    }

    .guest-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--gold), transparent);
    }

    .card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        flex-wrap: wrap;
        gap: 12px;
    }

    .card-head h2 {
        font-size: 1.25rem;
        color: #fff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-head h2 i {
        color: var(--gold);
    }

    /* Master Switch Box */
    .master-switch-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 215, 0, 0.06);
        border: 1.5px solid rgba(255, 215, 0, 0.35);
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 0;
    }

    .master-switch-info h3 {
        margin: 0 0 4px 0;
        color: #fff;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .master-switch-info p {
        margin: 0;
        color: var(--silver);
        font-size: 0.85rem;
    }

    /* Toggle Switch */
    .switch-ui {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 26px;
        flex-shrink: 0;
    }

    .switch-ui input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider-ui {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #2a2c38;
        transition: 0.3s;
        border-radius: 26px;
        border: 1px solid #444;
    }

    .slider-ui:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: #fff;
        transition: 0.3s;
        border-radius: 50%;
    }

    input:checked + .slider-ui {
        background-color: var(--gold);
        border-color: var(--gold);
    }

    input:checked + .slider-ui:before {
        transform: translateX(24px);
        background-color: #000;
    }

    .btn-gold {
        background: var(--gold);
        color: #000;
        font-weight: 700;
        border: none;
        border-radius: 8px;
        padding: 12px 22px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
    }

    .status-msg-banner {
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 0.88rem;
        margin-top: 14px;
        display: none;
    }

    .guest-unsubscribe-actions {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 8px;
        width: 100%;
    }

    .guest-unsubscribe-url-wrap {
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
        max-width: 100%;
    }

    .guest-unsub-label {
        font-size: 0.72rem;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
    }

    .guest-unsub-url {
        color: var(--gold);
        font-size: 0.85rem;
        text-decoration: underline;
        word-break: break-all;
        overflow-wrap: anywhere;
        max-width: 100%;
        line-height: 1.4;
        display: inline-block;
        transition: color 0.2s;
    }

    .guest-unsub-url:hover {
        color: #fff;
    }

    @media (max-width: 600px) {
        .guest-unsubscribe-actions {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 12px !important;
        }
        .guest-unsubscribe-actions .btn-gold {
            justify-content: center;
            width: 100%;
            box-sizing: border-box;
        }
        .guest-unsubscribe-url-wrap {
            width: 100%;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            padding: 10px 12px;
            box-sizing: border-box;
        }
        .guest-unsub-url {
            font-size: 0.82rem;
            word-break: break-all !important;
            overflow-wrap: anywhere !important;
            text-align: center;
            display: block;
        }
        .guest-unsub-label {
            text-align: center;
        }
    }
</style>

<main class="guest-notif-page">
    <div class="guest-notif-container">
        <!-- Hero Header -->
        <div class="guest-notif-hero">
            <span class="guest-notif-badge"><i class="fas fa-bell"></i> Guest Control Center</span>
            <h1>Notification &amp; Newsletter Settings</h1>
            <p>Configure which alerts you receive while visiting GPLMods, manage browser push permissions, or update your newsletter preferences.</p>
        </div>

        <!-- ======== PWA INSTALLATION REQUIREMENT WARNING ======== -->
        <div id="pwaNotifWarningBanner" class="guest-card" style="border-color: rgba(255, 193, 7, 0.5); background: linear-gradient(145deg, #1b170c 0%, #0e0d08 100%);">
            <div style="display: flex; align-items: flex-start; gap: 16px;">
                <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(255, 193, 7, 0.15); border: 1.5px solid #ffc107; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: #ffc107; flex-shrink: 0;">
                    <i class="fas fa-mobile-alt"></i>
