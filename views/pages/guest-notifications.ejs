</main>

<script>
    const STORAGE_KEY = 'gpl_notif_prefs';

    function isPwaMode() {
        return Boolean(
            (typeof window.isGplPwaInstalled === 'function' && window.isGplPwaInstalled()) ||
            window.matchMedia('(display-mode: standalone)').matches ||
            window.navigator.standalone === true ||
            document.referrer.includes('android-app://') ||
            localStorage.getItem('gpl_pwa_installed') === 'true'
        );
    }

    function toggleGuestInstructions() {
        const inst = document.getElementById('guestPwaInstructions');
        if (inst) {
            inst.style.display = (inst.style.display === 'none' || !inst.style.display) ? 'block' : 'none';
        }
    }

    function triggerGuestPwaInstall() {
        if (typeof window.triggerPwaInstallPrompt === 'function') {
            window.triggerPwaInstallPrompt('guestPwaInstructions');
        } else {
            toggleGuestInstructions();
        }
    }

    function handleLockedSwitchClick(e) {
        if (!isPwaMode()) {
            if (e) e.preventDefault();
            const inst = document.getElementById('guestPwaInstructions');
            if (inst) {
                inst.style.display = 'block';
                inst.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
            if (window.showGplToast) {
                window.showGplToast({
                    title: 'PWA Installation Required',
                    body: 'Install GPLMods as PWA following the steps above to unlock device push notifications.'
                });
            }
        }
    }

    function updateGuestNotificationUi() {
        const isInstalled = isPwaMode();
        const pwaBanner = document.getElementById('pwaNotifWarningBanner');
        const statusBanner = document.getElementById('guestNotifStatusBanner');
        const statusIcon = document.getElementById('guestStatusIcon');
        const statusText = document.getElementById('guestStatusText');
        const statusPill = document.getElementById('guestStatusPill');
        const pushBadge = document.getElementById('pushPermBadge');
        const masterSwitch = document.getElementById('guestMasterSwitch');
        const lockIndicator = document.getElementById('pwaLockIndicator');
        const blocker = document.getElementById('switchClickBlocker');
        const otherSettings = document.getElementById('guestOtherSettings');

        // 1. If PWA is NOT installed:
        if (!isInstalled) {
            if (pwaBanner) pwaBanner.style.display = 'block';
            if (statusBanner) statusBanner.style.display = 'none';
            if (otherSettings) otherSettings.style.display = 'none';
            if (masterSwitch) {
                masterSwitch.checked = false;
                masterSwitch.disabled = true;
            }
            if (lockIndicator) lockIndicator.style.display = 'inline-flex';
            if (blocker) {
                const innerUi = blocker.querySelector('.switch-ui');
                if (innerUi) innerUi.style.pointerEvents = 'none';
                blocker.style.cursor = 'not-allowed';
            }
            if (pushBadge) {
                pushBadge.innerHTML = '<i class="fas fa-lock" style="color: #ffc107;"></i> PWA Required';
                pushBadge.style.color = '#ffc107';
                pushBadge.style.borderColor = 'rgba(255, 193, 7, 0.4)';
            }
            syncHubModal(false);
            return;
        }

        // 2. PWA IS INSTALLED: Hide banner completely!
        if (pwaBanner) pwaBanner.style.display = 'none';

        // Unlock toggle
        if (lockIndicator) lockIndicator.style.display = 'none';
        if (blocker) {
            const innerUi = blocker.querySelector('.switch-ui');
            if (innerUi) innerUi.style.pointerEvents = 'auto';
            blocker.style.cursor = 'pointer';
        }
        if (masterSwitch) {
            masterSwitch.disabled = false;
        }

        // Check whether notification is enabled
        const isPushPermGranted = ('Notification' in window) && Notification.permission === 'granted';
        const savedPushPref = localStorage.getItem('gpl_push_notification_enabled');
        let isEnabled = false;

        if (savedPushPref !== null) {
            isEnabled = savedPushPref === 'true';
        } else if (isPushPermGranted) {
            isEnabled = true;
        } else {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    if (typeof parsed.master === 'boolean') isEnabled = parsed.master;
                }
            } catch(e) {}
        }

        if (masterSwitch) masterSwitch.checked = isEnabled;

        // Sync channel checkboxes from storage
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (raw) {
                const parsed = JSON.parse(raw);
                const u = document.getElementById('guest_newUploads');
                const c = document.getElementById('guest_clubUpdates');
                const a = document.getElementById('guest_adminMessages');
                const s = document.getElementById('guest_soundEnabled');
                if (u && typeof parsed.newUploads === 'boolean') u.checked = parsed.newUploads;
                if (c && typeof parsed.clubUpdates === 'boolean') c.checked = parsed.clubUpdates;
                if (a && typeof parsed.adminMessages === 'boolean') a.checked = parsed.adminMessages;
                if (s && typeof parsed.soundEnabled === 'boolean') s.checked = parsed.soundEnabled;
            }
        } catch(e) {}

        // State 2: PWA installed successfully, enable notification
        if (!isEnabled) {
            if (statusBanner) {
                statusBanner.style.display = 'flex';
                statusBanner.style.background = 'rgba(255, 193, 7, 0.12)';
                statusBanner.style.border = '1px solid rgba(255, 193, 7, 0.4)';
                statusBanner.style.color = '#ffc107';
            }
            if (statusIcon) statusIcon.innerHTML = '<i class="fas fa-info-circle" style="color: var(--gold); font-size: 1.1rem;"></i>';
            if (statusText) statusText.textContent = 'PWA installed successfully, enable notification';
            if (statusPill) {
                statusPill.textContent = 'PWA Installed';
                statusPill.style.background = 'rgba(255, 193, 7, 0.2)';
                statusPill.style.color = '#ffc107';
                statusPill.style.border = '1px solid rgba(255, 193, 7, 0.4)';
            }
            if (pushBadge) {
                pushBadge.innerHTML = '<i class="fas fa-info-circle" style="color: var(--gold);"></i> PWA installed successfully, enable notification';
                pushBadge.style.color = 'var(--gold)';
                pushBadge.style.borderColor = 'rgba(255, 215, 0, 0.4)';
            }
            if (otherSettings) otherSettings.style.display = 'none';
            syncHubModal(false);
        } else {
            // State 3: Notification enabled, PWA installed
            if (statusBanner) {
                statusBanner.style.display = 'flex';
                statusBanner.style.background = 'rgba(46, 204, 113, 0.12)';
                statusBanner.style.border = '1px solid rgba(46, 204, 113, 0.4)';
                statusBanner.style.color = '#2ecc71';
            }
            if (statusIcon) statusIcon.innerHTML = '<i class="fas fa-check-circle" style="color: #2ecc71; font-size: 1.1rem;"></i>';
            if (statusText) statusText.textContent = 'Notification enabled, PWA installed';
            if (statusPill) {
                statusPill.textContent = 'Notification Enabled';
                statusPill.style.background = 'rgba(46, 204, 113, 0.2)';
                statusPill.style.color = '#2ecc71';
                statusPill.style.border = '1px solid rgba(46, 204, 113, 0.4)';
            }
            if (pushBadge) {
                pushBadge.innerHTML = '<i class="fas fa-check-circle" style="color: #2ecc71;"></i> Notification enabled, PWA installed';
                pushBadge.style.color = '#2ecc71';
                pushBadge.style.borderColor = 'rgba(46, 204, 113, 0.4)';
            }
            // Test notification button and other settings appear as usual!
            if (otherSettings) otherSettings.style.display = 'block';
            syncHubModal(true);
        }
    }

    function syncHubModal(isEnabled) {
        const u = document.getElementById('modal_newUploads');
        const c = document.getElementById('modal_clubUpdates');
        const a = document.getElementById('modal_adminMessages');
        const s = document.getElementById('modal_soundEnabled');
        [u, c, a, s].forEach(el => {
            if (el) {
                el.disabled = !isEnabled;
                el.checked = isEnabled;
            }
        });
    }

    async function handleGuestSubSettingChange() {
        const u = document.getElementById('guest_newUploads');
        const c = document.getElementById('guest_clubUpdates');
        const a = document.getElementById('guest_adminMessages');
        const s = document.getElementById('guest_soundEnabled');

        const prefs = {
            master: true,
            newUploads: u ? u.checked : true,
            clubUpdates: c ? c.checked : true,
            adminMessages: a ? a.checked : true,
            soundEnabled: s ? s.checked : true
        };

        localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
        if (s) localStorage.setItem('gpl_push_notification_sound', s.checked ? 'true' : 'false');

        // Sync with global modal if open
        const mu = document.getElementById('modal_newUploads');
        const mc = document.getElementById('modal_clubUpdates');
        const ma = document.getElementById('modal_adminMessages');
        const ms = document.getElementById('modal_soundEnabled');
        if (mu && u) mu.checked = u.checked;
        if (mc && c) mc.checked = c.checked;
        if (ma && a) ma.checked = a.checked;
        if (ms && s) ms.checked = s.checked;

        // Send to backend
        fetch('/settings/notifications', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
                notificationsEnabled: true,
                newUploads: prefs.newUploads,
                clubUpdates: prefs.clubUpdates,
                adminMessages: prefs.adminMessages,
                soundEnabled: prefs.soundEnabled
            })
        }).catch(() => {});

        const banner = document.getElementById('guestNotifSaveStatus');
        if (banner) {
            banner.style.display = 'block';
            banner.innerHTML = '<i class="fas fa-check-circle"></i> Channel preferences updated.';
            setTimeout(() => { banner.style.display = 'none'; }, 2500);
        }
    }

    async function handleGuestMasterToggle(isChecked) {
        if (!isPwaMode()) {
            handleLockedSwitchClick();
            return;
        }

        if (isChecked) {
            if (window.enablePushNotifications) {
                try {
                    await window.enablePushNotifications();
                } catch (e) {
                    console.log('[GuestPush] Notification prompt error:', e);
                }
            }
            localStorage.setItem('gpl_push_notification_enabled', 'true');
            localStorage.setItem('gpl_push_notification_sound', 'true');
            localStorage.setItem(STORAGE_KEY, JSON.stringify({
                master: true,
                newUploads: true,
                clubUpdates: true,
                adminMessages: true,
                soundEnabled: true
            }));
        } else {
            if (window.disablePushNotifications) {
                try { await window.disablePushNotifications(); } catch (e) {}
            }
            localStorage.setItem('gpl_push_notification_enabled', 'false');
            localStorage.setItem(STORAGE_KEY, JSON.stringify({
                master: false,
                newUploads: false,
                clubUpdates: false,
                adminMessages: false,
                soundEnabled: false
            }));
        }

        updateGuestNotificationUi();

        const banner = document.getElementById('guestNotifSaveStatus');
        if (banner) {
            banner.style.display = 'block';
            banner.innerHTML = isChecked 
                ? '<i class="fas fa-check-circle"></i> Notification enabled, PWA installed.' 
                : '<i class="fas fa-info-circle"></i> Notifications turned off.';
            setTimeout(() => { banner.style.display = 'none'; }, 3000);
        }

        fetch('/settings/notifications', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
                notificationsEnabled: isChecked,
                newUploads: isChecked,
                clubUpdates: isChecked,
                adminMessages: isChecked,
                soundEnabled: isChecked
            })
        }).catch(() => {});
    }

    async function triggerGuestTestNotification() {
        if (typeof window.sendTestNotification === 'function') {
            await window.sendTestNotification();
        } else if (typeof window.testNotificationSound === 'function') {
            window.testNotificationSound();
            if (window.showGplToast) {
                window.showGplToast({ title: 'Test Alert', body: 'Test sound chime played.' });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', updateGuestNotificationUi);
    window.addEventListener('pageshow', updateGuestNotificationUi);
    window.addEventListener('focus', updateGuestNotificationUi);
    window.addEventListener('gplmods:pwa-installed', updateGuestNotificationUi);
</script>

