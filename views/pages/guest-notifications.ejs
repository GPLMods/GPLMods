<%- include('../partials/header') %>

<style>
    .guest-notif-page {
        min-height: 80vh;
        padding: 50px 20px 80px;
        background: radial-gradient(circle at top, rgba(255, 215, 0, 0.04) 0%, transparent 60%);
    }

    .guest-notif-container {
        max-width: 780px;
        margin: 0 auto;
    }

    .guest-notif-hero {
        text-align: center;
        margin-bottom: 35px;
    }

    .guest-notif-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 215, 0, 0.1);
        border: 1px solid rgba(255, 215, 0, 0.3);
        color: var(--gold);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 14px;
    }

    .guest-notif-hero h1 {
        font-size: clamp(1.8rem, 4vw, 2.5rem);
        color: #fff;
        font-weight: 800;
        margin: 0 0 10px 0;
        letter-spacing: -0.5px;
    }

    .guest-notif-hero p {
        color: var(--silver);
        font-size: 1rem;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.5;
    }

    .guest-card {
        background: linear-gradient(145deg, #15161e 0%, #0d0e14 100%);
        border: 1px solid rgba(255, 215, 0, 0.25);
        border-radius: 16px;
        padding: 28px 24px;
        margin-bottom: 24px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
        position: relative;
        overflow: hidden;
    }

    .guest-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--gold), transparent);
    }

    .card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        flex-wrap: wrap;
        gap: 12px;
    }

    .card-head h2 {
        font-size: 1.25rem;
        color: #fff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-head h2 i {
        color: var(--gold);
    }

    /* Master Switch Box */
    .master-switch-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 215, 0, 0.06);
        border: 1.5px solid rgba(255, 215, 0, 0.35);
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 0;
    }

    .master-switch-info h3 {
        margin: 0 0 4px 0;
        color: #fff;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .master-switch-info p {
        margin: 0;
        color: var(--silver);
        font-size: 0.85rem;
    }

    /* Toggle Switch */
    .switch-ui {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 26px;
        flex-shrink: 0;
    }

    .switch-ui input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider-ui {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #2a2c38;
        transition: 0.3s;
        border-radius: 26px;
        border: 1px solid #444;
    }

    .slider-ui:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: #fff;
        transition: 0.3s;
        border-radius: 50%;
    }

    input:checked + .slider-ui {
        background-color: var(--gold);
        border-color: var(--gold);
    }

    input:checked + .slider-ui:before {
        transform: translateX(24px);
        background-color: #000;
    }

    .btn-gold {
        background: var(--gold);
        color: #000;
        font-weight: 700;
        border: none;
        border-radius: 8px;
        padding: 12px 22px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
    }

    .status-msg-banner {
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 0.88rem;
        margin-top: 14px;
        display: none;
    }
</style>

<main class="guest-notif-page">
    <div class="guest-notif-container">
        <!-- Hero Header -->
        <div class="guest-notif-hero">
            <span class="guest-notif-badge"><i class="fas fa-bell"></i> Guest Control Center</span>
            <h1>Notification &amp; Newsletter Settings</h1>
            <p>Configure which alerts you receive while visiting GPLMods, manage browser push permissions, or update your newsletter preferences.</p>
        </div>

        <!-- ======== PWA INSTALLATION REQUIREMENT WARNING ======== -->
        <div id="pwaNotifWarningBanner" class="guest-card" style="border-color: rgba(255, 193, 7, 0.5); background: linear-gradient(145deg, #1b170c 0%, #0e0d08 100%);">
            <div style="display: flex; align-items: flex-start; gap: 16px;">
                <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(255, 193, 7, 0.15); border: 1.5px solid #ffc107; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: #ffc107; flex-shrink: 0;">
                    <i class="fas fa-mobile-alt"></i>
                </div>
                <div style="flex: 1;">
                    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 6px;">
                        <h3 style="margin: 0; color: #ffc107; font-size: 1.15rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                            <i class="fas fa-exclamation-triangle"></i> Install App as PWA to Enable Push Notifications
                        </h3>
                        <span id="pwaStatusTag" style="font-size: 0.76rem; font-weight: 700; padding: 3px 10px; border-radius: 12px; background: rgba(255, 193, 7, 0.2); color: #ffc107; border: 1px solid rgba(255, 193, 7, 0.4);">
                            PWA Required
                        </span>
                    </div>
                    <p style="margin: 0 0 14px 0; color: var(--silver); font-size: 0.9rem; line-height: 1.5;">
                        To guarantee reliable background notifications, instant mod release alerts, and lock-screen sound updates on both mobile and desktop, GPLMods must be installed to your home screen or system as a Progressive Web App (PWA). Push alerts remain locked until installed.
                    </p>

                    <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 14px;">
                        <button type="button" id="btnInstallPwaGuest" onclick="triggerGuestPwaInstall()" class="btn-gold" style="padding: 9px 18px; font-size: 0.88rem;">
                            <i class="fas fa-download"></i> Install GPLMods App
                        </button>
                        <button type="button" onclick="toggleGuestInstructions()" style="background: rgba(255, 255, 255, 0.08); border: 1px solid #555; color: #fff; padding: 9px 16px; border-radius: 8px; font-size: 0.85rem; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                            <i class="fas fa-info-circle" style="color: var(--gold);"></i> How to Install
                        </button>
                    </div>

                    <!-- Step-by-Step Instructions Drawer -->
                    <div id="guestPwaInstructions" style="display: none; background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; padding: 16px; margin-top: 10px;">
                        <div style="font-weight: 700; color: #fff; font-size: 0.9rem; margin-bottom: 10px;">Step-by-Step Installation Instructions:</div>
                        <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.86rem; color: #ddd; line-height: 1.5;">
                            <div>
                                <strong style="color: var(--gold);"><i class="fab fa-android"></i> Android (Chrome / Edge / Firefox):</strong>
                                <div style="color: var(--silver); margin-left: 20px;">Tap the three dots (⋮) in the browser bar &rarr; Select <strong>"Install app"</strong> or <strong>"Add to Home screen"</strong>.</div>
                            </div>
                            <div>
                                <strong style="color: #64b5f6;"><i class="fab fa-apple"></i> iOS / iPadOS (Safari):</strong>
                                <div style="color: var(--silver); margin-left: 20px;">Tap the <strong>Share</strong> button (<i class="fas fa-share-square"></i>) in Safari bottom toolbar &rarr; Scroll down and tap <strong>"Add to Home Screen"</strong> (<i class="fas fa-plus-square"></i>) &rarr; Open GPLMods from your Home Screen.</div>
                            </div>
                            <div>
                                <strong style="color: #81c784;"><i class="fas fa-desktop"></i> Windows / Mac / Linux (Chrome / Edge / Brave):</strong>
                                <div style="color: var(--silver); margin-left: 20px;">Click the <strong>Install</strong> icon (<i class="fas fa-desktop"></i>) on the right side of the address bar &rarr; Click <strong>"Install"</strong>.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 1. Site Notifications Card -->
        <div class="guest-card">
            <div class="card-head">
                <h2><i class="fas fa-satellite-dish"></i> Site Notifications</h2>
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <span id="pushPermBadge" style="font-size: 0.78rem; padding: 4px 10px; border-radius: 12px; background: rgba(255,255,255,0.06); color: var(--silver); border: 1px solid #444;">
                        Status: Checking...
                    </span>
                    <button type="button" class="btn btn-secondary" onclick="openGlobalNotificationModal()" style="border-color: var(--gold); color: var(--gold); padding: 5px 12px; font-size: 0.82rem; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; background: rgba(255,215,0,0.08);">
                        <i class="fas fa-sliders-h"></i> PWA &amp; App Notification Hub
                    </button>
                </div>
            </div>

            <!-- Master Toggle (Disabled until PWA installed) -->
            <div class="master-switch-box" id="masterSwitchWrapper" style="position: relative;">
                <div class="master-switch-info">
                    <h3 style="display: flex; align-items: center; gap: 8px;">
                        Allow Site to Send Notifications
                        <span id="pwaLockIndicator" style="color: #ffc107; font-size: 0.8rem; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                            <i class="fas fa-lock"></i> (PWA Install Required)
                        </span>
                    </h3>
                    <p id="masterSwitchDesc">Master switch for Web Push, PWA alerts, and live in-app notifications.</p>
                </div>
                <div id="switchClickBlocker" onclick="handleLockedSwitchClick(event)" style="cursor: not-allowed; display: inline-block;">
                    <label class="switch-ui" style="pointer-events: none;">
                        <input type="checkbox" id="guestMasterSwitch" onchange="handleGuestMasterToggle(this.checked)" disabled>
                        <span class="slider-ui" style="opacity: 0.5;"></span>
                    </label>
                </div>
            </div>

            <div id="guestNotifSaveStatus" class="status-msg-banner" style="background: rgba(46, 204, 113, 0.15); border: 1px solid #2ecc71; color: #2ecc71; margin-top: 18px;">
                <i class="fas fa-check-circle"></i> Notification preferences saved to your device.
            </div>
        </div>

        <!-- 2. Newsletter & Email Unsubscribe Card -->
        <div class="guest-card">
            <div class="card-head">
                <h2><i class="fas fa-envelope-open-text"></i> Email Newsletter</h2>
            </div>

            <div style="display: flex; flex-direction: column; gap: 16px;">
                <p style="color: var(--silver); font-size: 0.95rem; margin: 0; line-height: 1.6;">
                    We send periodic mod releases, developer highlights, and platform security bulletins. If you wish to stop receiving updates or manage your email subscriptions, you can unsubscribe at any time via our official portal.
                </p>

                <div style="display: flex; align-items: center; justify-content: flex-start; gap: 15px; flex-wrap: wrap; margin-top: 8px;">
                    <a href="/unsubscribe" class="btn-gold">
                        <i class="fas fa-user-minus"></i> Unsubscribe Newsletter
                    </a>
                    <a href="https://gplmods.webredirect.org/unsubscribe" target="_blank" style="color: var(--silver); font-size: 0.85rem; text-decoration: underline;">
                        https://gplmods.webredirect.org/unsubscribe
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Global PWA / App Notification Management Modal -->
<%- include('../partials/pwa-notification-modal') %>

<script>
    const STORAGE_KEY = 'gpl_notif_prefs';

    function isPwaMode() {
        return Boolean(
            (typeof window.isGplPwaInstalled === 'function' && window.isGplPwaInstalled()) ||
            window.matchMedia('(display-mode: standalone)').matches ||
            window.navigator.standalone === true ||
            document.referrer.includes('android-app://') ||
            localStorage.getItem('gpl_pwa_installed') === 'true'
        );
    }

    function toggleGuestInstructions() {
        const inst = document.getElementById('guestPwaInstructions');
        if (inst) {
            inst.style.display = (inst.style.display === 'none' || !inst.style.display) ? 'block' : 'none';
        }
    }

    function triggerGuestPwaInstall() {
        if (typeof window.triggerPwaInstallPrompt === 'function') {
            window.triggerPwaInstallPrompt('guestPwaInstructions');
        } else {
            toggleGuestInstructions();
        }
    }

    function handleLockedSwitchClick(e) {
        if (!isPwaMode()) {
            if (e) e.preventDefault();
            const inst = document.getElementById('guestPwaInstructions');
            if (inst) {
                inst.style.display = 'block';
                inst.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
            if (window.showGplToast) {
                window.showGplToast({
                    title: 'PWA Installation Required',
                    body: 'Install GPLMods as PWA following the steps above to unlock device push notifications.'
                });
            }
        }
    }

    function loadGuestPrefs() {
        const isInstalled = isPwaMode();
        const masterSwitch = document.getElementById('guestMasterSwitch');
        const lockIndicator = document.getElementById('pwaLockIndicator');
        const blocker = document.getElementById('switchClickBlocker');
        const pwaTag = document.getElementById('pwaStatusTag');
        const pwaBanner = document.getElementById('pwaNotifWarningBanner');

        if (!isInstalled) {
            // Keep switch strictly OFF and DISABLED until installed properly
            if (masterSwitch) {
                masterSwitch.checked = false;
                masterSwitch.disabled = true;
            }
            if (lockIndicator) lockIndicator.style.display = 'inline-flex';
            if (blocker) {
                const innerUi = blocker.querySelector('.switch-ui');
                if (innerUi) innerUi.style.pointerEvents = 'none';
                blocker.style.cursor = 'not-allowed';
            }
            if (pwaTag) {
                pwaTag.textContent = 'PWA Required';
                pwaTag.style.background = 'rgba(255, 193, 7, 0.2)';
                pwaTag.style.color = '#ffc107';
            }
            syncHubModal(false);
            updatePushPermBadge();
            return;
        }

        // PWA IS INSTALLED! Unlock toggle and allow normal preference loading
        if (pwaTag) {
            pwaTag.innerHTML = '<i class="fas fa-check-circle"></i> PWA Active';
            pwaTag.style.background = 'rgba(46, 204, 113, 0.2)';
            pwaTag.style.color = '#2ecc71';
            pwaTag.style.borderColor = 'rgba(46, 204, 113, 0.5)';
        }
        if (lockIndicator) lockIndicator.style.display = 'none';
        if (blocker) {
            const innerUi = blocker.querySelector('.switch-ui');
            if (innerUi) innerUi.style.pointerEvents = 'auto';
            blocker.style.cursor = 'pointer';
        }
        if (masterSwitch) {
            masterSwitch.disabled = false;
        }

        // Sync from gpl_push_notification_enabled as well
        const isPushEnabled = localStorage.getItem('gpl_push_notification_enabled');
        const raw = localStorage.getItem(STORAGE_KEY);
        let master = true;

        if (isPushEnabled !== null) {
            master = isPushEnabled === 'true';
        } else if (raw) {
            try {
                const parsed = JSON.parse(raw);
                if (typeof parsed.master !== 'undefined') master = Boolean(parsed.master);
            } catch(e) {}
        }

        if (masterSwitch) masterSwitch.checked = master;

        syncHubModal(master);
        updatePushPermBadge();
    }

    function syncHubModal(isEnabled) {
        const u = document.getElementById('modal_newUploads');
        const c = document.getElementById('modal_clubUpdates');
        const a = document.getElementById('modal_adminMessages');
        const s = document.getElementById('modal_soundEnabled');
        [u, c, a, s].forEach(el => {
            if (el) {
                el.disabled = !isEnabled;
                el.checked = isEnabled;
            }
        });
    }

    async function handleGuestMasterToggle(isChecked) {
        syncHubModal(isChecked);

        // Store across all notification keys used by site
        localStorage.setItem('gpl_push_notification_enabled', isChecked ? 'true' : 'false');
        localStorage.setItem('gpl_push_notification_sound', isChecked ? 'true' : 'false');
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
            master: isChecked,
            newUploads: isChecked,
            clubUpdates: isChecked,
            adminMessages: isChecked,
            soundEnabled: isChecked
        }));

        if (isChecked) {
            if (window.enablePushNotifications) {
                try {
                    await window.enablePushNotifications();
                } catch (e) {
                    console.log('[GuestPush] In-app alerts enabled, push prompt unavailable:', e);
                }
            }
        } else {
            if (window.disablePushNotifications) {
                try {
                    await window.disablePushNotifications();
                } catch (e) {}
            }
        }

        updatePushPermBadge();

        // Show brief save indicator
        const banner = document.getElementById('guestNotifSaveStatus');
        if (banner) {
            banner.style.display = 'block';
            banner.innerHTML = isChecked 
                ? '<i class="fas fa-check-circle"></i> Site notifications enabled successfully.' 
                : '<i class="fas fa-check-circle"></i> Site notifications disabled.';
            setTimeout(() => { banner.style.display = 'none'; }, 3000);
        }

        // Sync with backend API
        fetch('/settings/notifications', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
                notificationsEnabled: isChecked,
                newUploads: isChecked,
                clubUpdates: isChecked,
                adminMessages: isChecked,
                soundEnabled: isChecked
            })
        }).catch(() => {});
    }

    function updatePushPermBadge() {
        const badge = document.getElementById('pushPermBadge');
        if (!badge) return;
        if (!('Notification' in window)) {
            badge.textContent = 'Push: Unsupported';
            badge.style.color = '#888';
            return;
        }
        if (Notification.permission === 'granted') {
            badge.innerHTML = '<i class="fas fa-check-circle" style="color: #2ecc71;"></i> Push: Granted';
            badge.style.color = '#2ecc71';
            badge.style.borderColor = 'rgba(46, 204, 113, 0.4)';
        } else if (Notification.permission === 'denied') {
            badge.innerHTML = '<i class="fas fa-ban" style="color: #e74c3c;"></i> Push: Blocked';
            badge.style.color = '#e74c3c';
            badge.style.borderColor = 'rgba(231, 76, 60, 0.4)';
        } else {
            const isEnabled = localStorage.getItem('gpl_push_notification_enabled') === 'true';
            badge.innerHTML = isEnabled 
                ? '<i class="fas fa-info-circle" style="color: var(--gold);"></i> Enabled (In-App)' 
                : '<i class="fas fa-times-circle" style="color: var(--silver);"></i> Disabled';
            badge.style.color = isEnabled ? 'var(--gold)' : 'var(--silver)';
            badge.style.borderColor = isEnabled ? 'rgba(255, 215, 0, 0.4)' : '#444';
        }
    }

    document.addEventListener('DOMContentLoaded', loadGuestPrefs);
</script>

<%- include('../partials/footer') %>
