                    </h3>
                    <p id="masterSwitchDesc">Master switch for Web Push, PWA alerts, and live in-app notifications.</p>
                </div>
                <div id="switchClickBlocker" onclick="handleLockedSwitchClick(event)" style="cursor: not-allowed; display: inline-block;">
                    <label class="switch-ui" style="pointer-events: none;">
                        <input type="checkbox" id="guestMasterSwitch" onchange="handleGuestMasterToggle(this.checked)" disabled>
                        <span class="slider-ui" style="opacity: 0.5;"></span>
                    </label>
                </div>
            </div>

            <!-- Other Settings & Channels (Shown When Notifications are Enabled) -->
            <div id="guestOtherSettings" style="display: none; margin-top: 18px;">
                <div style="font-size: 0.82rem; font-weight: 700; color: var(--gold); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-sliders-h"></i> Notification Channels &amp; Preferences
                </div>

                <!-- Alert Channels Grid -->
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 16px;">
                    <!-- Channel 1: New Uploads -->
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: rgba(255, 255, 255, 0.03); border: 1px solid #333; border-radius: 10px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <i class="fas fa-cloud-upload-alt" style="color: #64b5f6; width: 18px;"></i>
                            <div>
                                <div style="font-size: 0.88em; color: #fff; font-weight: 600;">New Mod Uploads</div>
