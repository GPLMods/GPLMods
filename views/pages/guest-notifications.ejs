                    </div>

                    <!-- Channel 2: Club Discussions -->
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: rgba(255, 255, 255, 0.03); border: 1px solid #333; border-radius: 10px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <i class="fas fa-users" style="color: #81c784; width: 18px;"></i>
                            <div>
                                <div style="font-size: 0.88em; color: #fff; font-weight: 600;">Club Discussions</div>
                                <div style="font-size: 0.75em; color: var(--silver);">Notifications from clubs and communities</div>
                            </div>
                        </div>
                        <label class="switch-ui" style="margin: 0; width: 44px; height: 24px;">
                            <input type="checkbox" id="guest_clubUpdates" onchange="handleGuestSubSettingChange()" checked>
                            <span class="slider-ui"></span>
                        </label>
                    </div>

                    <!-- Channel 3: Admin Announcements -->
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: rgba(255, 255, 255, 0.03); border: 1px solid #333; border-radius: 10px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <i class="fas fa-shield-alt" style="color: #ba68c8; width: 18px;"></i>
                            <div>
                                <div style="font-size: 0.88em; color: #fff; font-weight: 600;">Admin Announcements</div>
                                <div style="font-size: 0.75em; color: var(--silver);">Official patch notes and platform updates</div>
                            </div>
                        </div>
                        <label class="switch-ui" style="margin: 0; width: 44px; height: 24px;">
                            <input type="checkbox" id="guest_adminMessages" onchange="handleGuestSubSettingChange()" checked>
                            <span class="slider-ui"></span>
