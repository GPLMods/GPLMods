<%- include('../partials/header') %>

<style>
    .source-hub-container {
        max-width: 1200px;
        margin: 3.5rem auto;
        padding: 0 20px;
    }

    .source-hub-header {
        margin-bottom: 35px;
        background: linear-gradient(145deg, #141414, #1c1c1c);
        border: 1px solid #333;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
    }

    .source-hub-header h1 {
        color: var(--white);
        margin-bottom: 10px;
        font-size: 2.2rem;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .source-hub-header h1 i {
        color: var(--gold);
    }

    .source-hub-header p {
        color: var(--silver);
        line-height: 1.6;
        font-size: 1.05rem;
        margin: 0;
    }

    .source-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 24px;
    }

    .source-card {
        background: var(--dark-gray);
        border: 1px solid #333;
        border-radius: 12px;
        padding: 26px;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .source-card:hover {
        transform: translateY(-3px);
        border-color: var(--gold);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), 0 0 15px rgba(255, 215, 0, 0.15);
    }

    .source-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }

    .source-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: #2ecc71;
        border: 1px solid #2ecc71;
        background: rgba(46, 204, 113, 0.1);
        border-radius: 20px;
        padding: 3px 10px;
        font-size: 0.75em;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .source-badge.private {
        color: var(--gold);
        border-color: var(--gold);
        background: rgba(255, 215, 0, 0.1);
    }

    .source-card h2 {
        color: var(--white);
        font-size: 1.35em;
        margin-bottom: 8px;
        font-weight: 700;
    }

    .source-card p {
        color: var(--silver);
        line-height: 1.5;
        flex: 1;
        margin-bottom: 14px;
        font-size: 0.95rem;
    }

    .source-meta {
        color: #8b949e;
        font-family: 'JetBrains Mono', Consolas, monospace;
        font-size: 0.88em;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .source-features {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .feat-tag {
        background: rgba(255, 255, 255, 0.05);
        color: var(--silver);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        padding: 3px 8px;
        font-size: 0.78rem;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .feat-tag i {
        color: var(--gold);
    }

    .source-card-link {
        background: var(--gold);
        color: var(--black);
        border-radius: 8px;
        padding: 12px 18px;
        text-align: center;
        text-decoration: none;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background-color 0.2s ease, box-shadow 0.2s ease;
    }

    .source-card-link:hover {
        background: #ffe033;
        color: var(--black);
        box-shadow: 0 0 15px var(--glow-gold);
        text-decoration: none;
    }

    .source-empty {
        background: var(--dark-gray);
        border: 1px solid #333;
        border-radius: 12px;
        padding: 60px 20px;
        text-align: center;
        color: var(--silver);
    }

    .source-empty i {
        color: #555;
        font-size: 3.5em;
        margin-bottom: 18px;
    }

    .source-empty h2 {
        color: var(--white);
        margin-bottom: 8px;
    }
</style>

<main class="container">
    <div class="source-hub-container">
        <header class="source-hub-header">
            <h1><i class="fab fa-github" aria-hidden="true"></i> Source Code Hub</h1>
            <p>Browse official GPL Mods repositories, explore file trees, view raw source code, inspect licenses, and download published releases.</p>
        </header>

        <% if (sources && sources.length) { %>
            <div class="source-grid">
                <% sources.forEach(source => { %>
                    <article class="source-card">
                        <div class="source-card-top">
                            <span class="source-badge <%= source.isPrivate ? 'private' : '' %>">
                                <i class="fas <%= source.isPrivate ? 'fa-lock' : 'fa-globe' %>" aria-hidden="true"></i>
                                <%= source.isPrivate ? 'Assigned access' : 'Public' %>
                            </span>
                            <i class="fab fa-github" style="color: #666; font-size: 1.2rem;"></i>
                        </div>

                        <h2><%= source.title %></h2>

                        <p><%= source.description || 'Full repository source code, directory explorer, and release archives.' %></p>

                        <div class="source-meta">
                            <i class="fas fa-code-branch"></i>
                            <span><%= source.githubOwner %>/<%= source.githubRepo %></span>
                        </div>

                        <div class="source-features">
                            <span class="feat-tag"><i class="fas fa-code"></i> Source Tree</span>
                            <span class="feat-tag"><i class="fas fa-file-code"></i> Raw Code</span>
                            <span class="feat-tag"><i class="fas fa-book-open"></i> README</span>
                            <span class="feat-tag"><i class="fas fa-scale-balanced"></i> License</span>
                        </div>

                        <a class="source-card-link" href="/source/<%= encodeURIComponent(source.slug) %>">
                            <i class="fas fa-code"></i> Browse Source Code
                        </a>
                    </article>
                <% }) %>
            </div>
        <% } else { %>
            <div class="source-empty">
                <i class="fas fa-code-branch" aria-hidden="true"></i>
                <h2>No Source Repositories Available</h2>
                <p>Published repositories will appear here once they are added in Admin settings.</p>
            </div>
        <% } %>
    </div>
</main>

<%- include('../partials/popunder-ads') %>
<%- include('../partials/video-ad-modal') %>
<%- include('../partials/footer') %>