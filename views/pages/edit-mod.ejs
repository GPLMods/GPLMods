                    <input type="url" id="directDownloadUrl" name="directDownloadUrl" placeholder="e.g., https://www.dropbox.com/s/.../app.zip?dl=1" value="<%= file.directDownloadUrl || '' %>">
                    <span style="font-size: 0.85em; color: var(--silver); display: block; margin-top: 5px;">A direct streamable link. Enables 1-Click repo installs for iOS/Android, and acts as a fast mirror for all platforms.</span>
                </div>
                
                <!-- JAILBREAK PACKAGE ID -->
                <div class="form-group" id="pkg-id-group" style="display: none; background: rgba(255, 149, 0, 0.1); padding: 20px; border-radius: 8px; border: 1px solid #FF9500; margin-bottom: 25px;">
                    <label for="iosPackageId" style="color: var(--white);"><i class="fas fa-box-open"></i> Jailbreak Package ID <span style="color: var(--gold); font-size: 0.8em; font-weight: normal;">Optional</span></label>
                    <input type="text" id="iosPackageId" name="iosPackageId" placeholder="e.g., com.spark.snowboard" value="<%= file.iosPackageId || '' %>">
                    <span style="font-size: 0.85em; color: var(--silver); display: block; margin-top: 5px;">Required to enable direct Sileo/Zebra package installation buttons. Must exactly match the ID in your control file.</span>
