                        <button type="button" id="btn-multi-part" class="btn <%= file.isMultiPart ? 'btn-primary' : 'btn-secondary' %>" style="flex:1; padding:10px;">Multi-Part Download</button>
                    </div>

                    <input type="hidden" id="isMultiPartHidden" name="isMultiPart" value="<%= file.isMultiPart ? 'true' : 'false' %>">

                    <div id="single-link-container" style="display: <%= file.isMultiPart ? 'none' : 'block' %>">
                        <div class="form-group">
                            <label for="externalDownloadUrl">Main External URL*</label>
                            <input type="url" id="externalDownloadUrl" name="externalDownloadUrl" value="<%= file.externalDownloadUrl || '' %>" class="link-req-single" placeholder="https://linkvertise.com/...">
                        </div>

                        <div style="margin-top:10px; border-top:1px solid #333; padding-top:10px;">
                            <p style="color:var(--silver); margin-bottom:8px; font-weight:600;">Admin & Safety Overrides</p>
                            <div class="form-group">
                                <label for="manualFileScanUrl">Manual File Scan URL</label>
                                <input type="url" id="manualFileScanUrl" name="manualFileScanUrl" value="<%= file.manualFileScanUrl || '' %>" placeholder="Manual File Scan URL">
                            </div>
                            <div class="form-group">
                                <label for="manualSiteScanUrl">Manual Site Scan URL</label>
                                <input type="url" id="manualSiteScanUrl" name="manualSiteScanUrl" value="<%= file.manualSiteScanUrl || '' %>" placeholder="Manual Site Scan URL">
                            </div>
                        </div>
                    </div>

                    <div id="multi-part-container" style="display: <%= file.isMultiPart ? 'block' : 'none' %>">
                        <div id="parts-wrapper">
                            <!-- JS will populate existing parts -->
                        </div>
                        <div style="display:flex; gap:8px; margin-top:8px;">
                            <button type="button" id="add-part-btn" class="btn btn-secondary">+ Add New Part</button>
                        </div>
                    </div>
                </fieldset>
            <% } %>

            <fieldset class="form-section">
                <legend>Media & Metadata</legend>
                
                <% if (!file.isVariant) { %>
                    <div class="form-group">
                        <label for="tags">Tags (Optional, comma-separated)</label>
                        <input type="text" id="tags" name="tags" value="<%= file.tags ? file.tags.join(', ') : '' %>">
                    </div>
                <% } %>

                <div class="form-group">
                    <label>Mod Screenshots (Upload to replace existing)</label>
                    <div class="file-input-wrapper">
                        <input type="file" id="screenshots" name="screenshots" accept="image/png, image/jpeg" multiple>
                        <label for="screenshots" class="file-input-label">Replace Screenshots (Optional)</label>
                        <span class="file-name" id="screenshotFileName" style="display:block; margin-top: 10px; color: var(--silver); text-align: center;">Leave empty to keep current screenshots</span>
                    </div>
                    
                    <div class="preview-container" id="screenshotPreviewContainer" style="<%= file.screenshotUrls && file.screenshotUrls.length > 0 ? 'display:block;' : 'display:none;' %>">
                        <% if(file.screenshotUrls) { file.screenshotUrls.forEach(url => { %>
                            <img src="<%= url %>" alt="Current Screenshot">
