<%- include('../partials/header') %>

<!-- ✅ DOWNGRADE TO STABLE QUILL v1.3.7 -->
<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>

<style>
    :root {
        --black: #0a0a0a;
        --dark-gray: #1a1a1a;
        --white: #ffffff;
        --gold: #FFD700;
        --silver: #c0c0c0;
        --glow-gold: rgba(255, 215, 0, 0.5);
        --red: #e53935;
        --blue: #2196F3;
    }
    
    /* Reusing your standard form styles */
    .upload-form-container { max-width: 800px; margin: 2rem auto; padding: 30px; background-color: var(--dark-gray); border: 1px solid #333; border-radius: 15px; }
    .upload-form-container h2 { text-align: center; font-size: 2.5em; margin-bottom: 1rem; color: var(--white); }
    .upload-form-container h2 span { color: var(--gold); text-shadow: 0 0 15px var(--glow-gold); }
    .form-section { border: 1px solid #333; border-radius: 8px; padding: 20px; margin-bottom: 30px; }
    .form-section legend { padding: 0 10px; margin-left: 15px; font-size: 1.3em; font-weight: 600; color: var(--gold); }
    .form-group { margin-bottom: 25px; position: relative; } 
    .form-group label { display: block; margin-bottom: 8px; font-weight: 600; color: var(--silver); }
    .form-group input[type="text"], .form-group input[type="url"], .form-group select, .form-group textarea { width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid #333; background-color: var(--black); color: var(--white); font-size: 1em; font-family: 'Poppins', sans-serif; transition: all 0.3s ease; }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 10px var(--glow-gold); }
    .form-group textarea { min-height: 120px; resize: vertical; }
    
    .icon-upload-container { display: flex; flex-direction: column; align-items: center; margin-bottom: 30px; padding: 20px; border: 2px dashed #333; border-radius: 15px; background-color: rgba(0,0,0,0.2); }
    .icon-preview { width: 100px; height: 100px; background-color: var(--black); border-radius: 20px; margin-bottom: 15px; display: flex; align-items: center; justify-content: center; border: 2px solid var(--gold); overflow: hidden; }
    .icon-preview img { width: 100%; height: 100%; object-fit: contain; }
    
    .file-input-wrapper { position: relative; display: inline-block; width: 100%; }
    input[type="file"] { display: none; }
    .file-input-label { display: block; padding: 12px 20px; background: transparent; color: var(--gold); border: 2px solid var(--gold); border-radius: 8px; cursor: pointer; text-align: center; font-size: 1em; transition: all 0.3s ease; }
    .file-input-label:hover { background: var(--gold); color: var(--black); box-shadow: 0 0 15px var(--glow-gold); }
    
    .preview-container { margin-top: 15px; border-radius: 8px; background-color: var(--black); padding: 15px; border: 1px solid #333; display: none; }
    #screenshotPreviewContainer { column-count: 2; column-gap: 15px; }
    #screenshotPreviewContainer img { width: 100%; height: auto; border-radius: 8px; margin-bottom: 15px; break-inside: avoid; display: block; box-shadow: 0 4px 6px rgba(0,0,0,0.3); }
    
    .submit-button { display: block; width: 100%; background: var(--gold); color: var(--black); padding: 15px 20px; border-radius: 8px; font-size: 1.2em; font-weight: 700; border: none; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 0 15px var(--glow-gold); margin-top: 20px; }
    .submit-button:hover { transform: translateY(-5px); box-shadow: 0 0 25px var(--glow-gold); }

    .status-banner { text-align: center; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-weight: bold; }
    .status-banner.rejected { background-color: rgba(229, 57, 53, 0.1); border: 1px solid var(--red); color: var(--red); }

    /* --- Custom Styles for Quill v1.3.7 --- */
    .ql-toolbar.ql-snow { background-color: #333; border-color: #444; border-radius: 8px 8px 0 0; }
    .ql-container.ql-snow { background-color: var(--black); border-color: #444; border-radius: 0 0 8px 8px; color: var(--white); font-family: 'Poppins', sans-serif; font-size: 1em; min-height: 250px; }
    .ql-editor.ql-blank::before { color: #888; font-style: normal; } /* Fixed placeholder color */
    .ql-snow .ql-stroke { stroke: var(--silver); }
    .ql-snow .ql-fill { fill: var(--silver); }
    .ql-snow .ql-picker { color: var(--silver); }
    .ql-snow.ql-toolbar button:hover .ql-stroke, .ql-snow .ql-toolbar button:hover .ql-stroke { stroke: var(--gold); }
    .ql-snow.ql-toolbar button:hover .ql-fill, .ql-snow .ql-toolbar button:hover .ql-fill { fill: var(--gold); }
    
    /* --- Force Quill Editors to be responsive on mobile --- */
    .ql-toolbar, .ql-container { max-width: 100% !important; box-sizing: border-box !important; }
    .ql-editor { word-wrap: break-word !important; overflow-wrap: break-word !important; word-break: break-word !important; max-width: 100% !important; padding: 12px 15px !important; }
    .upload-form-container { max-width: 100%; overflow-x: hidden; }

    /* --- CUSTOM SELECT DROPDOWN CSS --- */
    .custom-select-wrapper { position: relative; user-select: none; width: 100%; }
    .custom-select { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 15px; background-color: var(--black); border: 1px solid #333; border-radius: 8px; cursor: pointer; color: var(--silver); font-size: 1em; transition: all 0.3s ease; }
    .custom-select-wrapper.open .custom-select { border-color: var(--gold); box-shadow: 0 0 10px var(--glow-gold); border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
    .custom-select-wrapper.open .custom-select-arrow { transform: rotate(180deg); color: var(--gold); }
    .custom-options { position: absolute; top: 100%; left: 0; right: 0; background-color: var(--dark-gray); border: 1px solid var(--gold); border-top: none; border-radius: 0 0 8px 8px; box-shadow: 0 10px 20px rgba(0,0,0,0.5); z-index: 100; display: none; max-height: 250px; overflow-y: auto; }
    .custom-select-wrapper.open .custom-options { display: block; }
    .custom-option { padding: 12px 15px; cursor: pointer; color: var(--white); transition: background-color 0.2s; border-bottom: 1px solid #2a2a2a; }
    .custom-option:last-child { border-bottom: none; }
    .custom-option:hover { background-color: var(--black); color: var(--gold); }
    .custom-option.selected { background-color: var(--black); color: var(--gold); font-weight: bold; }
    .custom-select-wrapper.disabled .custom-select { opacity: 0.5; cursor: not-allowed; background-color: #111; }
    .custom-select-wrapper.disabled .custom-options { display: none !important; }

    /* --- NEW: Smart Template Dropdown Styles --- */
    .template-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--dark-gray);
        border: 1px solid var(--gold);
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        z-index: 100;
        display: none; /* Hidden by default */
        overflow: hidden;
        margin-top: 5px;
    }
    .template-option {
        padding: 12px 15px;
        cursor: pointer;
        border-bottom: 1px solid #333;
        transition: background 0.2s;
    }
    .template-option:last-child { border-bottom: none; }
    .template-option:hover { background: #222; }
    .template-option-title { color: var(--gold); font-weight: bold; display: block; margin-bottom: 4px; }
    .template-option-preview { color: var(--silver); font-size: 0.85em; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    
    .template-helper-btn {
        float: right;
        background: rgba(255, 215, 0, 0.1);
        color: var(--gold);
        border: 1px solid var(--gold);
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 0.8em;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        user-select: none;
    }
    .template-helper-btn:hover { background: var(--gold); color: var(--black); }
</style>

<div class="container">
    <!-- ======== DYNAMIC GO BACK BUTTON ======== -->
    <div style="margin-bottom: 20px;">
        <a href="javascript:history.back()" style="color: var(--silver); text-decoration: none; display: inline-flex; align-items: center; font-weight: 600; font-size: 1.05em; transition: color 0.3s ease;" onmouseover="this.style.color='var(--white)'" onmouseout="this.style.color='var(--silver)'">
            <i class="fas fa-arrow-left" style="margin-right: 8px;"></i> Go Back
        </a>
    </div>
    <!-- ======================================== -->
    <div class="upload-form-container">
        
        <h2>
            Edit 
            <span style="color: var(--gold); text-shadow: 0 0 15px var(--glow-gold);">
                <%= file.isVariant ? 'Variant: ' : 'Mod: ' %><%= file.name %>
            </span>
        </h2>
        
        <div id="status-alert-box" class="alert-msg" style="display: none; width: 100%; max-width: 800px; margin: 0 auto 20px auto;"></div>

        <% if (file.isVariant) { %>
            <div class="status-banner" style="background-color: rgba(33, 150, 243, 0.1); border: 1px solid var(--blue); color: var(--blue);">
                <i class="fas fa-info-circle"></i> You are editing a Variant of an existing app. The App Icon, Official Description, and Tags are managed by the original uploader.
            </div>
        <% } %>
        
        <% if (file.status === 'rejected' && file.rejectionReason) { %>
            <div class="status-banner rejected">
                ⚠️ Mod Rejected: <%= file.rejectionReason %>
                <br><span style="font-size: 0.85em; font-weight: normal; color: var(--silver);">Fix the issues below and submit to return to the review queue.</span>
            </div>
        <% } %>

        <form action="/mods/<%= file._id %>/edit" method="POST" enctype="multipart/form-data" id="details-form">
            
            <fieldset class="form-section">
                <legend>Core Details</legend>

                <% if (!file.isVariant) { %>
                <div class="icon-upload-container">
                    <label>Mod Icon</label>
                    <div class="icon-preview" id="iconPreviewBox">
                        <img id="iconImage" src="<%= file.iconUrl %>" alt="Icon Preview" style="display:block;">
                    </div>
                    <div style="max-width: 250px; text-align: center;">
                        <input type="file" id="modIcon" name="softwareIcon" accept="image/*">
                        <label for="modIcon" class="file-input-label">Change Icon (Optional)</label>
                    </div>
                </div>
                <% } %>

                <div style="background: rgba(33, 150, 243, 0.1); border: 1px solid var(--blue); padding: 20px; border-radius: 8px; margin-bottom: 25px;">
                    <h4 style="color: var(--blue); margin-bottom: 15px;"><i class="fas fa-magic"></i> Auto-Fetch App Details</h4>
                    <div class="form-group" style="margin-bottom: 15px;">
                        <label style="color: var(--silver); font-size: 0.9em; margin-bottom: 5px;">Platform Source</label>
                        <select id="fetchPlatform" name="fetchPlatform" style="display: none;">
                            <option value="playstore" selected>Google Play Store</option>
                            <option value="appstore">Apple App Store</option>
                            <option value="steam">Steam</option>
                            <option value="epic">Epic Games Store</option>
                            <option value="wordpress">WordPress.org</option>
                        </select>
                        <div class="custom-select-wrapper" id="fetchPlatformWrapper">
                            <div class="custom-select" style="padding: 10px 15px;">
                                <span class="selected-text" style="color: var(--white);">Google Play Store</span>
                                <i class="fas fa-chevron-down custom-select-arrow"></i>
                            </div>
                            <div class="custom-options">
                                <div class="custom-option selected" data-value="playstore">Google Play Store</div>
                                <div class="custom-option" data-value="appstore">Apple App Store</div>
                                <div class="custom-option" data-value="steam">Steam</div>
                                <div class="custom-option" data-value="epic">Epic Games Store</div>
                                <div class="custom-option" data-value="wordpress">WordPress.org</div>
                            </div>
                        </div>
                    </div>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <input type="url" id="fetchUrl" placeholder="Paste the store link here (e.g., https://play.google.com/...)" style="flex-grow: 1; padding: 12px 15px; border-radius: 8px; background: var(--black); color: white; border: 1px solid #333; outline: none; transition: border-color 0.3s;">
                        <button type="button" id="fetchBtn" class="btn btn-primary" style="background: var(--blue); color: white; border: none; border-radius: 8px; padding: 0 25px; font-weight: bold; cursor: pointer; transition: transform 0.2s;">Fetch Data</button>
                    </div>
                    <span id="fetchStatus" style="display: block; margin-top: 10px; font-size: 0.85em; font-weight: bold;"></span>
                </div>

                <div class="form-group">
                    <label for="modName">Mod Name*</label>
                    <input type="text" id="modName" name="modName" value="<%= file.name %>" <%= file.isVariant ? 'readonly style="opacity:0.7; cursor:not-allowed;"' : 'required' %>>
                </div>

                <div class="form-group">
                    <label for="ageRating">Age Rating*</label>
                    <select id="ageRating" name="ageRating" style="display: none;">
                        <option value="NA" <%= (typeof file !== 'undefined' && file.ageRating === 'NA') ? 'selected' : '' %>>Not Rated (N/A)</option>
                        <option value="3+" <%= (typeof file !== 'undefined' && file.ageRating === '3+') ? 'selected' : '' %>>3+ (Everyone)</option>
                        <option value="7+" <%= (typeof file !== 'undefined' && file.ageRating === '7+') ? 'selected' : '' %>>7+ (Low Violence)</option>
                        <option value="12+" <%= (typeof file !== 'undefined' && file.ageRating === '12+') ? 'selected' : '' %>>12+ (Moderate Violence)</option>
                        <option value="16+" <%= (typeof file !== 'undefined' && file.ageRating === '16+') ? 'selected' : '' %>>16+ (Strong Violence)</option>
                        <option value="18+" <%= (typeof file !== 'undefined' && file.ageRating === '18+') ? 'selected' : '' %>>18+ (Adults Only)</option>
                    </select>
                    <div class="custom-select-wrapper" id="ageRatingWrapper">
                        <div class="custom-select">
                            <span class="selected-text">
                                <% if (typeof file !== 'undefined' && file.ageRating) { %>
                                    <% if (file.ageRating === '3+') { %> 3+ (Everyone)
                                    <% } else if (file.ageRating === '7+') { %> 7+ (Low Violence)
                                    <% } else if (file.ageRating === '12+') { %> 12+ (Moderate Violence)
                                    <% } else if (file.ageRating === '16+') { %> 16+ (Strong Violence)
                                    <% } else if (file.ageRating === '18+') { %> 18+ (Adults Only)
                                    <% } else { %> Not Rated (N/A) <% } %>
                                <% } else { %>
                                    Not Rated (N/A)
                                <% } %>
                            </span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options">
                            <div class="custom-option" data-value="NA">Not Rated (N/A)</div>
                            <div class="custom-option" data-value="3+">3+ (Everyone)</div>
                            <div class="custom-option" data-value="7+">7+ (Low Violence)</div>
                            <div class="custom-option" data-value="12+">12+ (Moderate Violence)</div>
                            <div class="custom-option" data-value="16+">16+ (Strong Violence)</div>
                            <div class="custom-option" data-value="18+">18+ (Adults Only)</div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="modVersion">Mod Version*</label>
                    <input type="text" id="modVersion" name="modVersion" value="<%= file.version !== 'Draft' ? file.version : '' %>" required>
                </div>

                <div class="form-group">
                    <label for="developerName">Official Developer / Company</label>
                    <input type="text" id="developerName" name="developerName" value="<%= file.developer !== 'N/A' ? file.developer : '' %>">
                </div>

                <div class="form-group">
                    <label>Platform*</label>
                    <select id="modPlatform" name="modPlatform" style="display: none;">
                        <option value="" disabled <%= !file.category ? 'selected' : '' %>>Select a platform...</option>
                        <option value="android" <%= file.category === 'android' ? 'selected' : '' %>>Android</option>
                        <option value="ios-jailed" <%= file.category === 'ios-jailed' ? 'selected' : '' %>>iOS - Jailed (IPA)</option>
                        <option value="ios-jailbroken" <%= file.category === 'ios-jailbroken' ? 'selected' : '' %>>iOS - Jailbroken (DEB)</option>
                        <option value="windows" <%= file.category === 'windows' ? 'selected' : '' %>>Windows</option>
                        <option value="wordpress" <%= file.category === 'wordpress' ? 'selected' : '' %>>WordPress</option>
                    </select>
                    <div class="custom-select-wrapper" id="platformWrapper">
                        <div class="custom-select">
                            <span class="selected-text"><%= file.category ? file.category.toUpperCase() : 'Select a platform...' %></span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options">
                            <div class="custom-option <%= file.category === 'android' ? 'selected' : '' %>" data-value="android">Android</div>
                            <div class="custom-option <%= file.category === 'ios-jailed' ? 'selected' : '' %>" data-value="ios-jailed">iOS - Jailed (IPA)</div>
                            <div class="custom-option <%= file.category === 'ios-jailbroken' ? 'selected' : '' %>" data-value="ios-jailbroken">iOS - Jailbroken (DEB)</div>
                            <div class="custom-option <%= file.category === 'windows' ? 'selected' : '' %>" data-value="windows">Windows</div>
                            <div class="custom-option <%= file.category === 'wordpress' ? 'selected' : '' %>" data-value="wordpress">WordPress</div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="minOsVersion">Minimum Required OS Version <span id="os-req-star" style="color: var(--red); display: none;">*</span></label>
                    <input type="text" id="minOsVersion" name="minOsVersion" value="<%= file.minOsVersion || '' %>" placeholder="e.g., iOS 14.0, Android 8.0, Windows 10">
                </div>

                <div class="form-group">
                    <label for="modLicense">Software License (Optional)</label>
                    <select id="modLicense" name="modLicense" style="display: none;">
                        <option value="">None / Proprietary</option>
                        <% if (typeof licenses !== 'undefined') { licenses.forEach(license => { %>
                            <option value="<%= license._id %>" <%= file.license && file.license.toString() === license._id.toString() ? 'selected' : '' %>><%= license.name %></option>
                        <% }) } %>
                    </select>
                    <div class="custom-select-wrapper" id="licenseWrapper">
                        <div class="custom-select">
                            <span class="selected-text">
                                <% if (file.license && typeof licenses !== 'undefined') { %>
                                    <% const selectedLicense = licenses.find(license => license._id.toString() === file.license.toString()); %>
                                    <%= selectedLicense ? selectedLicense.name : 'None / Proprietary' %>
                                <% } else { %>
                                    None / Proprietary
                                <% } %>
                            </span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options">
                            <div class="custom-option <%= !file.license ? 'selected' : '' %>" data-value="">None / Proprietary</div>
                            <% if (typeof licenses !== 'undefined') { licenses.forEach(license => { %>
                                <div class="custom-option <%= file.license && file.license.toString() === license._id.toString() ? 'selected' : '' %>" data-value="<%= license._id %>"><%= license.name %></div>
                            <% }) } %>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Sub-Category*</label>
                    <select id="modCategory" name="modCategory" disabled style="display: none;">
                        <option value="<%= file.platforms[0] || '' %>" selected><%= file.platforms[0] || 'Select category...' %></option>
                    </select>
                    <div class="custom-select-wrapper disabled" id="categoryWrapper">
                        <div class="custom-select">
                            <span class="selected-text"><%= file.platforms[0] || 'Select a platform first...' %></span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options" id="categoryOptionsContainer"></div>
                    </div>
                </div>

                <div class="form-group" id="arch-group" style="display: none; background: rgba(255, 215, 0, 0.05); padding: 20px; border-radius: 8px; border: 1px solid #333; margin-top: 15px;">
                    <label style="color: var(--gold);"><i class="fas fa-microchip"></i> Architecture Support <span id="arch-req-star" style="color: var(--red); display: none;">*</span></label>
                    <p style="font-size: 0.85em; color: var(--silver); margin-bottom: 10px;">Select all hardware architectures this file supports.</p>
                    <div class="custom-select-wrapper" id="archWrapper">
                        <div class="custom-select" id="archCustomSelect">
                            <span class="selected-text" id="archSelectedText">Select architectures...</span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options" id="archOptionsContainer" style="max-height: 250px; overflow-y: auto;"></div>
                    </div>
                </div>
            </fieldset>
            
            <fieldset class="form-section">
                <legend>Descriptions</legend>
                
                <!-- ======== ✅ UPGRADED: AUTO-FETCH METADATA UI ======== -->
                <div style="background: rgba(33, 150, 243, 0.1); border: 1px solid var(--blue); padding: 20px; border-radius: 8px; margin-bottom: 25px;">
                    <h4 style="color: var(--blue); margin-bottom: 15px;"><i class="fas fa-magic"></i> Auto-Fetch App Details</h4>
                    
                    <div class="form-group" style="margin-bottom: 15px;">
                        <label style="color: var(--silver); font-size: 0.9em; margin-bottom: 5px;">Platform Source</label>
                        <!-- Native Select (Hidden) -->
                        <select id="fetchPlatform" name="fetchPlatform" style="display: none;">
                            <option value="playstore" selected>Google Play Store</option>
                            <option value="appstore">Apple App Store</option>
                            <option value="steam">Steam</option>
                            <option value="epic">Epic Games Store</option>
                            <option value="wordpress">WordPress.org</option>
                        </select>
                        
                        <!-- Custom Select UI -->
                        <div class="custom-select-wrapper" id="fetchPlatformWrapper">
                            <div class="custom-select" style="padding: 10px 15px;">
                                <span class="selected-text" style="color: var(--white);">Google Play Store</span>
                                <i class="fas fa-chevron-down custom-select-arrow"></i>
                            </div>
                            <div class="custom-options">
                                <div class="custom-option selected" data-value="playstore">Google Play Store</div>
                                <div class="custom-option" data-value="appstore">Apple App Store</div>
                                <div class="custom-option" data-value="steam">Steam</div>
                                <div class="custom-option" data-value="epic">Epic Games Store</div>
                                <div class="custom-option" data-value="wordpress">WordPress.org</div>
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <input type="url" id="fetchUrl" placeholder="Paste the store link here (e.g., https://play.google.com/...)" style="flex-grow: 1; padding: 12px 15px; border-radius: 8px; background: var(--black); color: white; border: 1px solid #333; outline: none; transition: border-color 0.3s;">
                        <button type="button" id="fetchBtn" class="btn btn-primary" style="background: var(--blue); color: white; border: none; border-radius: 8px; padding: 0 25px; font-weight: bold; cursor: pointer; transition: transform 0.2s;">
                            Fetch Data
                        </button>
                    </div>
                    <span id="fetchStatus" style="display: block; margin-top: 10px; font-size: 0.85em; font-weight: bold;"></span>
                </div>
                <!-- ======================================================== -->

                <!-- HIDDEN TEXTAREAS - REQUIRED REMOVED to prevent silent browser failures -->
                <div class="form-group" style="position: relative;">
                    <label for="modDescription">
                        Mod Description* 
                        <span class="template-helper-btn" data-target="modDescription">💡 Use Template</span>
                    </label>
                    <textarea id="modDescription" name="modDescription" style="display:none;"><%- file.modDescription %></textarea>
                    <div id="editor-modDescription"><%- file.modDescription %></div>
                    <div id="dropdown-modDescription" class="template-dropdown"></div>
                </div>

                <div class="form-group" style="position: relative;">
                    <label for="modFeatures">
                        Mod Features* (One per line)
                        <span class="template-helper-btn" data-target="modFeatures">💡 Use Template</span>
                    </label>
                    <textarea id="modFeatures" name="modFeatures" style="display:none;"><%- file.modFeatures %></textarea>
                    <div id="editor-modFeatures"><%- file.modFeatures %></div>
                    <div id="dropdown-modFeatures" class="template-dropdown"></div>
