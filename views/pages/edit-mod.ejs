            <input type="hidden" name="fileSize" id="fileSize" value="<%= file.fileSize || 0 %>">
            <input type="hidden" name="actionType" id="actionType" value="submit">

            <div class="button-group" style="display: flex; gap: 15px; margin-top: 30px;">
                <button type="button" class="btn btn-secondary" id="saveDraftBtn" style="flex: 1; padding: 15px; border-radius: 8px; font-weight: bold; border-color: #555; color: var(--silver); background: transparent;">Save as Draft</button>
                
                <button type="button" class="submit-button" id="submitModBtn" style="flex: 2; margin-top: 0;">
                    <%= file.status === 'rejected' ? 'Resubmit for Review' : 'Save & Publish Changes' %>
                </button>
            </div>
        </form>
    </div>
</div>

            <script>
            // --- ADVANCED LINK & PARTS MANAGEMENT LOGIC (Edit Page) ---
            document.addEventListener('DOMContentLoaded', () => {
                const btnSingleLink = document.getElementById('btn-single-link');
                const btnMultiPart = document.getElementById('btn-multi-part');
                const singleLinkContainer = document.getElementById('single-link-container');
                const multiPartContainer = document.getElementById('multi-part-container');
                const isMultiPartHidden = document.getElementById('isMultiPartHidden');
                const partsWrapper = document.getElementById('parts-wrapper');
                const addPartBtn = document.getElementById('add-part-btn');

                function createPartCard(part = {}, index = 0) {
                    const div = document.createElement('div');
                    div.className = 'part-card';
                    div.style.cssText = 'background: rgba(255,255,255,0.03); border:1px solid #333; padding:12px; border-radius:8px; margin-bottom:12px;';
                    div.innerHTML = `
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                            <strong>Part <span class="part-index">${index + 1}</span></strong>
                            <button type="button" class="remove-part-btn btn btn-danger" style="padding:6px 10px;">Remove</button>
                        </div>
                        <div class="form-group">
                            <label>Part Name</label>
                            <input type="text" name="partNames[]" class="link-req-multi" value="${part.partName || ''}" placeholder="e.g., main, split-1">
                        </div>
                        <div class="form-group">
                            <label>Main URL*</label>
                            <input type="url" name="partUrls[]" class="link-req-multi" value="${part.partUrl || ''}" placeholder="https://...">
                        </div>
                        <div style="display:flex; gap:8px;">
                            <div style="flex:1;">
                                <label>Mirror 1 Provider</label>
                                <input type="text" name="mirror1Providers[]" value="${part.mirror1Provider || ''}" placeholder="Google Drive">
                            </div>
                            <div style="flex:2;">
                                <label>Mirror 1 URL</label>
                                <input type="url" name="mirror1Urls[]" value="${part.mirror1Url || ''}" placeholder="https://...">
                            </div>
                        </div>
                        <div style="display:flex; gap:8px; margin-top:8px;">
                            <div style="flex:1;">
                                <label>Mirror 2 Provider</label>
                                <input type="text" name="mirror2Providers[]" value="${part.mirror2Provider || ''}" placeholder="Mega">
                            </div>
                            <div style="flex:2;">
                                <label>Mirror 2 URL</label>
                                <input type="url" name="mirror2Urls[]" value="${part.mirror2Url || ''}" placeholder="https://...">
                            </div>
                        </div>
                        <div class="form-group" style="margin-top:8px;">
                            <label>Direct Admin Link</label>
                            <input type="url" name="directAdminLinks[]" value="${part.directAdminLink || ''}" placeholder="https://admin.example.com/direct/...">
                        </div>
                        <div style="display:flex; gap:8px;">
                            <div style="flex:1;">
                                <label>Manual File Scan URL</label>
                                <input type="url" name="manualFileScanUrls[]" value="${part.manualFileScanUrl || ''}" placeholder="https://virustotal.com/...">
                            </div>
                            <div style="flex:1;">
                                <label>Manual Site Scan URL</label>
                                <input type="url" name="manualSiteScanUrls[]" value="${part.manualSiteScanUrl || ''}" placeholder="https://sitecheck.sucuri.net/...">
                            </div>
                        </div>
                    `;

                    div.querySelector('.remove-part-btn').addEventListener('click', () => { div.remove(); updatePartIndices(); });
                    return div;
                }

                function updatePartIndices() {
                    partsWrapper.querySelectorAll('.part-card').forEach((card, idx) => card.querySelector('.part-index').textContent = idx + 1);
                }

                if (!btnSingleLink || !btnMultiPart || !partsWrapper) return;

                btnSingleLink.addEventListener('click', () => {
                    btnSingleLink.classList.replace('btn-secondary','btn-primary');
                    btnMultiPart.classList.replace('btn-primary','btn-secondary');
                    singleLinkContainer.style.display = 'block';
                    multiPartContainer.style.display = 'none';
                    isMultiPartHidden.value = 'false';
                    document.querySelectorAll('.link-req-single').forEach(el => el.required = true);
                    document.querySelectorAll('.link-req-multi').forEach(el => el.required = false);
                });

                btnMultiPart.addEventListener('click', () => {
                    btnMultiPart.classList.replace('btn-secondary','btn-primary');
                    btnSingleLink.classList.replace('btn-primary','btn-secondary');
                    multiPartContainer.style.display = 'block';
                    singleLinkContainer.style.display = 'none';
                    isMultiPartHidden.value = 'true';
                    document.querySelectorAll('.link-req-single').forEach(el => el.required = false);
                    document.querySelectorAll('.link-req-multi').forEach(el => el.required = true);
                });

                const existingParts = <%- JSON.stringify(file.downloadParts || []) %>;
                if (existingParts && existingParts.length > 0) {
                    existingParts.forEach((p, idx) => partsWrapper.appendChild(createPartCard(p, idx)));
                } else {
                    partsWrapper.appendChild(createPartCard({}, 0));
                    partsWrapper.appendChild(createPartCard({}, 1));
                }

                addPartBtn.addEventListener('click', () => {
                    const count = partsWrapper.querySelectorAll('.part-card').length;
                    partsWrapper.appendChild(createPartCard({}, count));
                    if (isMultiPartHidden.value === 'true') partsWrapper.lastElementChild.querySelectorAll('.link-req-multi').forEach(el => el.required = true);
                });

                if (isMultiPartHidden.value === 'true') {
                    document.querySelectorAll('.link-req-single').forEach(el => el.required = false);
                    document.querySelectorAll('.link-req-multi').forEach(el => el.required = true);
                } else {
                    document.querySelectorAll('.link-req-single').forEach(el => el.required = true);
                    document.querySelectorAll('.link-req-multi').forEach(el => el.required = false);
                }
            });
            </script>

