                </form>
            </section>

            <!-- Right Column: Account Security & Password -->
            <section class="form-section">
                <% if (user.password) { %>
                    <h2><i class="fas fa-key" style="font-size: 0.9em;"></i> Change Password</h2>
                    <form action="/account/change-password" method="POST">
                        <div class="form-group">
                            <label for="current-password">Current Password</label>
                            <input type="password" id="current-password" name="currentPassword" required autocomplete="current-password">
                        </div>
                        <div class="form-group">
                            <label for="new-password">New Password</label>
                            <input type="password" id="new-password" name="newPassword" required autocomplete="new-password">
                        </div>
                        <div class="form-group">
                            <label for="confirm-password">Confirm New Password</label>
                            <input type="password" id="confirm-password" name="confirmPassword" required autocomplete="new-password">
                        </div>
                        <button type="submit" class="submit-button secondary-button">
                            <i class="fas fa-lock" style="margin-right: 8px;"></i> Update Password
                        </button>
                    </form>
                <% } else { %>
                    <h2><i class="fas fa-shield-alt" style="font-size: 0.9em;"></i> Set Local Password</h2>
                    <p style="color: var(--silver); margin-bottom: 18px; font-size: 0.9em; line-height: 1.5;">Since you signed up with a social account, you can set a password here to allow logging in directly with your email address.</p>
                    <form action="/account/change-password" method="POST">
                        <input type="hidden" name="currentPassword" value="social_login_bypass">
                        <div class="form-group">
                            <label for="new-password">Set New Password</label>
                            <input type="password" id="new-password" name="newPassword" required autocomplete="new-password">
                        </div>
                        <div class="form-group">
                            <label for="confirm-password">Confirm Password</label>
                            <input type="password" id="confirm-password" name="confirmPassword" required autocomplete="new-password">
                        </div>
                        <button type="submit" class="submit-button secondary-button">
                            <i class="fas fa-lock" style="margin-right: 8px;"></i> Set Password
                        </button>
                    </form>
                <% } %>
            </section>

            <% if (user.role === 'distributor') { %>
                <section class="form-section" style="border-top: 3px solid var(--gold); margin-top: 30px;">
                    <h2>
                        <i class="fas fa-id-card" style="color: var(--gold); font-size: 0.9em; margin-right: 8px;"></i> Verified Distributor Card
                        <% if (user.cardStatus === 'suspended' || (!user.twoFactorEnabled && !user.is2FAEnabled)) { %>
                            <span style="background: rgba(229,57,53,0.2); color: #ff6b6b; border: 1px solid var(--red); font-size: 0.65em; padding: 2px 8px; border-radius: 12px; margin-left: 8px; font-weight: normal; vertical-align: middle;">Suspended (2FA Required)</span>
                        <% } else { %>
                            <span style="background: rgba(46,204,113,0.2); color: #2ecc71; border: 1px solid #2ecc71; font-size: 0.65em; padding: 2px 8px; border-radius: 12px; margin-left: 8px; font-weight: normal; vertical-align: middle;">Active</span>
                        <% } %>
                    </h2>
                    <p style="color: var(--silver); margin-bottom: 20px; font-size: 0.9em; line-height: 1.6;">
                        You are an official Verified Mod Distributor. You can view, customize, and export your digital credential with Quick-Login capabilities, or manage your partnership status.
                    </p>
                    <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
                        <a href="/id-card" class="submit-button btn-responsive-mobile" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center; width: auto; padding: 12px 22px; font-weight: bold; background: var(--gold); color: var(--black);">
                            <i class="fas fa-id-badge" style="margin-right: 8px;"></i> Open My ID Card
                        </a>
                        <form action="/account/quit-distributor" method="POST" style="display:inline; margin: 0;" onsubmit="return confirm('Are you sure you want to leave the Distributor Partnership program? All your external-link uploads will be transferred to GPL Community and your ID Card will be revoked.');">
                            <button type="submit" class="submit-button secondary-button btn-responsive-mobile" style="width: auto; padding: 12px 20px; border-color: var(--red); color: var(--red);">
                                <i class="fas fa-sign-out-alt" style="margin-right: 8px;"></i> Quit Partnership
                            </button>
                        </form>
                    </div>
                </section>
            <% } else if (user.role === 'admin' || user.role === 'owner') { %>
                <section class="form-section" style="border-top: 3px solid var(--gold); margin-top: 30px;">
                    <h2>
                        <i class="fas fa-id-card" style="color: var(--gold); font-size: 0.9em; margin-right: 8px;"></i> <%= user.role === 'owner' ? 'Owner Credential Card' : 'Administrator ID Card' %>
                        <% if (user.cardStatus === 'suspended' || (!user.twoFactorEnabled && !user.is2FAEnabled)) { %>
                            <span style="background: rgba(229,57,53,0.2); color: #ff6b6b; border: 1px solid var(--red); font-size: 0.65em; padding: 2px 8px; border-radius: 12px; margin-left: 8px; font-weight: normal; vertical-align: middle;">Suspended (2FA Required)</span>
                        <% } else { %>
                            <span style="background: rgba(46,204,113,0.2); color: #2ecc71; border: 1px solid #2ecc71; font-size: 0.65em; padding: 2px 8px; border-radius: 12px; margin-left: 8px; font-weight: normal; vertical-align: middle;">Active</span>
                        <% } %>
                    </h2>
                    <p style="color: var(--silver); margin-bottom: 20px; font-size: 0.9em; line-height: 1.6;">
                        As a member of the administration, you have access to your official verified ID Card, customizable welcome broadcast, and Private Quick-Login QR.
                    </p>
                    <a href="/id-card" class="submit-button btn-responsive-mobile" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center; width: auto; padding: 12px 22px; font-weight: bold; background: var(--gold); color: var(--black);">
                        <i class="fas fa-id-badge" style="margin-right: 8px;"></i> Open My ID Card
                    </a>
                </section>
            <% } %>

            <!-- ======== STAFF PROFESSIONAL WORK EMAIL SECTION ======== -->
            <% if (user && (user.role === 'owner' || user.role === 'admin' || user.role === 'support')) { %>
            <section class="form-section" style="border-top: 4px solid var(--blue); margin-top: 30px;">
                <h2 style="color: var(--blue); border-bottom-color: var(--blue);">
                    <i class="fas fa-envelope-open-text" style="margin-right: 10px;"></i> Staff Work Email & SMTP
                </h2>
                
                <% if (!user.customEmailAlias) { %>
                    <!-- Staff hasn't claimed it yet -->
                    <p style="color: var(--silver); margin-bottom: 20px; font-size: 0.9em; line-height: 1.6;">
                        As an official GPL Mods staff member, you can claim your official <strong>@gplmods.webredirect.org</strong> email address. Any emails sent here will automatically forward directly to your personal inbox (<strong><%= user.email %></strong>).
                    </p>
                    
                    <% const previewAlias = (typeof slugify !== 'undefined' ? slugify(user.username).replace(/-/g, '').toLowerCase() : user.username.toLowerCase()); %>
                    <div style="background: var(--black); padding: 20px; border-radius: 8px; border: 1px dashed var(--blue); text-align: center; margin-bottom: 20px;">
                        <span style="font-size: 1.1em; color: var(--silver);">Your proposed staff email:</span><br>
                        <strong class="staff-email-preview" style="font-size: 1.4em; color: var(--gold); word-break: break-all;"><%= previewAlias %>@gplmods.webredirect.org</strong>
                    </div>

                    <form action="/account/claim-custom-email" method="POST">
                        <button type="submit" class="submit-button btn-responsive-mobile" style="background: var(--blue); border-color: var(--blue); box-shadow: 0 0 15px rgba(33, 150, 243, 0.4); width: auto; padding: 12px 24px;">
                            <i class="fas fa-check-circle" style="margin-right: 8px;"></i> Claim Official Staff Email
                        </button>
                    </form>

                <% } else { %>
                    <!-- Staff HAS claimed it -->
                    <div style="background: rgba(46, 204, 113, 0.1); border: 1px solid var(--green); padding: 18px 20px; border-radius: 8px; margin-bottom: 20px;">
                        <p class="staff-email-active" style="margin: 0; color: var(--green); font-weight: bold; font-size: 1.2em; word-break: break-all;">
                            <i class="fas fa-check-circle"></i> <%= user.customEmailAlias %>@gplmods.webredirect.org
                        </p>
                        <p style="margin: 6px 0 0 0; color: var(--silver); font-size: 0.9em; word-break: break-word;">
                            Inbound emails currently forwarding to: <strong style="color: var(--white); word-break: break-all;"><%= user.email %></strong>
                        </p>
                    </div>

                    <!-- SMTP Send Section -->
                    <div style="background: var(--black); padding: 20px; border-radius: 8px; border: 1px solid #333;">
                        <h4 style="color: var(--white); margin-top: 0; font-size: 1.05em;"><i class="fas fa-paper-plane" style="color: var(--gold); margin-right: 8px;"></i> Send Emails From This Address</h4>
                        
                        <% if (!user.hasSmtpAccess) { %>
                            <p style="color: var(--silver); font-size: 0.9em; margin-bottom: 15px; line-height: 1.5; word-break: break-word;">
                                Generate SMTP credentials to configure Gmail, Outlook, or Apple Mail to send official staff emails directly from your <code style="word-break: break-all;"><%= user.customEmailAlias %>@gplmods.webredirect.org</code> address.
                            </p>
                            <form action="/account/generate-smtp" method="POST">
                                <button type="submit" class="submit-button secondary-button btn-responsive-mobile" style="border-color: var(--gold); color: var(--gold); width: auto; padding: 10px 20px;">
                                    <i class="fas fa-key" style="margin-right: 6px;"></i> Generate SMTP Credentials
                                </button>
                            </form>
                        <% } else { %>
                            <p style="color: var(--gold); font-size: 0.9em; font-weight: bold; margin-bottom: 8px;">
                                <i class="fas fa-shield-alt"></i> SMTP Access Active
                            </p>
                            <p style="color: var(--silver); font-size: 0.85em; margin-bottom: 12px; line-height: 1.5; word-break: break-word;">
                                Configure your email client (Gmail, Outlook, Apple Mail) "Send As" settings using these details:
                            </p>
                            <ul class="staff-smtp-list" style="color: var(--white); font-family: monospace; font-size: 0.88em; background: #111; padding: 16px 20px; border-radius: 6px; list-style: none; margin: 0 0 15px 0; border: 1px solid #2a2a2a;">
                                <li style="margin-bottom: 8px;"><strong style="color: var(--silver);">SMTP Host:</strong> smtp.improvmx.com</li>
                                <li style="margin-bottom: 8px;"><strong style="color: var(--silver);">Port:</strong> 587 (TLS / STARTTLS)</li>
                                <li style="margin-bottom: 8px;"><strong style="color: var(--silver);">Username:</strong> <%= user.customEmailAlias %></li>
                                <li><strong style="color: var(--silver);">Password:</strong> <em>(The password generated when you clicked the button)</em></li>
                            </ul>
                            <form action="/account/generate-smtp" method="POST" onsubmit="return confirm('Generating a new password will invalidate any previous SMTP password. Continue?');">
                                <button type="submit" class="submit-button secondary-button btn-responsive-mobile" style="border-color: #555; color: var(--silver); font-size: 0.85em; width: auto; padding: 8px 16px;">
                                    <i class="fas fa-sync-alt" style="margin-right: 6px;"></i> Regenerate SMTP Password
                                </button>
                            </form>
                        <% } %>
                    </div>
                <% } %>
            </section>
            <% } %>
        </div>
    </div>
</main>

<!-- ======== AVATAR SELECTION MODAL ======== -->
<div id="avatar-choice-modal" class="avatar-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="avatar-modal-title">
    <div class="avatar-modal-card">
        <div style="padding: 20px 24px; border-bottom: 1px solid #333; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-camera-retro" style="color: var(--gold); font-size: 1.3em;"></i>
                <h3 id="avatar-modal-title" style="margin: 0; color: var(--white); font-size: 1.25em;">Update Profile Picture</h3>
            </div>
            <button type="button" id="close-avatar-modal-btn" style="background: none; border: none; color: var(--silver); font-size: 1.6em; cursor: pointer; line-height: 1; transition: color 0.2s;" onmouseover="this.style.color='var(--white)'" onmouseout="this.style.color='var(--silver)'">&times;</button>
        </div>
        
        <div style="padding: 24px;">
            <p style="color: var(--silver); margin-top: 0; margin-bottom: 20px; font-size: 0.9em; line-height: 1.5;">Choose how you want to update your profile picture:</p>

            <div style="display: flex; flex-direction: column; gap: 14px;">
                <!-- Option 1: Upload from Cloud / Device -->
                <div class="avatar-option-card" id="option-upload-cloud" role="button" tabindex="0">
                    <div style="width: 48px; height: 48px; border-radius: 50%; background: rgba(255, 215, 0, 0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i class="fas fa-cloud-upload-alt" style="color: var(--gold); font-size: 1.4em;"></i>
                    </div>
                    <div style="flex-grow: 1;">
                        <div style="font-weight: 700; color: var(--white); margin-bottom: 3px; font-size: 1em;">Upload from Device / Cloud</div>
                        <div style="color: var(--silver); font-size: 0.82em; line-height: 1.4;">Select an image file (PNG, JPG, WebP) from your device or cloud storage</div>
                    </div>
                    <i class="fas fa-chevron-right" style="color: var(--silver); font-size: 0.9em;"></i>
                </div>

                <!-- Option 2: Fetch from Gravatar -->
                <div class="avatar-option-card" id="option-fetch-gravatar" role="button" tabindex="0">
                    <div style="width: 48px; height: 48px; border-radius: 50%; background: rgba(30, 140, 190, 0.2); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="width: 24px; height: 24px; fill: #46b5e8;">
                            <path d="M12 24C5.383 24 0 18.617 0 12c0-3.203 1.248-6.217 3.513-8.486 1.059-1.059 2.903-1.06 3.962 0a2.804 2.804 0 0 1 0 3.961A6.354 6.354 0 0 0 5.601 12c0 3.528 2.871 6.398 6.399 6.398s6.399-2.871 6.399-6.399A6.414 6.414 0 0 0 14.8 6.244v4.606c0 1.543-1.256 2.798-2.8 2.798s-2.8-1.255-2.8-2.798V2.8C9.2 1.256 10.456 0 12 0c6.617 0 12 5.383 12 12s-5.383 12-12 12zM5.494 3.692c-.481 0-.934.188-1.274.528A10.945 10.945 0 0 0 1 12c0 6.065 4.935 11 11 11s11-4.935 11-11S18.065 1 12 1c-.992 0-1.8.808-1.8 1.8v8.05c0 .991.808 1.798 1.8 1.798s1.8-.807 1.8-1.798V5.493a.5.5 0 0 1 .667-.471A7.416 7.416 0 0 1 19.399 12c0 4.08-3.319 7.399-7.399 7.399S4.601 16.079 4.601 12c0-1.978.77-3.836 2.167-5.232a1.803 1.803 0 0 0-1.274-3.076z"></path>
                        </svg>
                    </div>
                    <div style="flex-grow: 1;">
                        <div style="font-weight: 700; color: var(--white); margin-bottom: 3px; font-size: 1em;">Fetch from Gravatar</div>
                        <div style="color: var(--silver); font-size: 0.82em; line-height: 1.4;">Automatically sync avatar linked to <span style="color: var(--gold); font-weight: 600;"><%= user.email %></span></div>
                    </div>
                    <i class="fas fa-chevron-right" style="color: var(--silver); font-size: 0.9em;"></i>
                </div>
            </div>

            <!-- Upload preview & submit block (appears when user selects an image) -->
            <div id="modal-upload-preview" style="display: none; margin-top: 20px; padding-top: 18px; border-top: 1px solid #333; text-align: center;">
                <p style="color: var(--gold); font-weight: 600; font-size: 0.88em; margin-bottom: 12px;"><i class="fas fa-check-circle"></i> Image Selected &amp; Ready:</p>
                <img id="modal-preview-img" src="" alt="Selected Preview" style="width: 85px; height: 85px; border-radius: 50%; object-fit: cover; border: 2.5px solid var(--gold); margin-bottom: 15px; box-shadow: 0 0 15px var(--glow-gold);">
                <div style="display: flex; gap: 10px; justify-content: center;">
                    <button type="button" id="modal-confirm-upload-btn" class="submit-button" style="padding: 10px 20px; font-size: 0.95em; width: auto; min-width: 140px;">Upload Image</button>
                    <button type="button" id="modal-cancel-upload-btn" class="submit-button secondary-button" style="padding: 10px 18px; font-size: 0.95em; width: auto;">Cancel</button>
                </div>
            </div>

            <!-- Gravatar loading indicator -->
            <div id="gravatar-loading-indicator" style="display: none; margin-top: 20px; text-align: center; color: var(--gold); font-size: 0.9em;">
                <i class="fas fa-spinner fa-spin" style="margin-right: 8px; font-size: 1.2em;"></i> Syncing image from Gravatar...
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        
        // ==========================================
        // 1. CUSTOM COUNTRY DROPDOWN LOGIC
        // ==========================================
        const wrapper = document.getElementById('wrapper-country');
        const nativeSelect = document.getElementById('country');
        
        if (wrapper && nativeSelect) {
            const customSelect = wrapper.querySelector('.custom-select');
            const selectedText = wrapper.querySelector('.selected-text');
            const optionsContainer = wrapper.querySelector('.custom-options');

            customSelect.addEventListener('click', (e) => {
                wrapper.classList.toggle('open');
                e.stopPropagation(); 
            });

            optionsContainer.addEventListener('click', (e) => {
                const optionEl = e.target.closest('.custom-option');
                if (!optionEl) return;
                
                selectedText.textContent = optionEl.textContent;
                nativeSelect.value = optionEl.getAttribute('data-value');
                
                wrapper.querySelectorAll('.custom-option').forEach(opt => opt.classList.remove('selected'));
                optionEl.classList.add('selected');
                wrapper.classList.remove('open');
            });

            document.addEventListener('click', () => {
                wrapper.classList.remove('open');
            });
        }

        // ==========================================
        // 2. AVATAR CHOICE MODAL LOGIC (PENCIL ICON)
        // ==========================================
        const openAvatarModalBtn = document.getElementById('open-avatar-modal-btn');
        const avatarModal = document.getElementById('avatar-choice-modal');
        const closeAvatarModalBtn = document.getElementById('close-avatar-modal-btn');
        const optionUploadCloud = document.getElementById('option-upload-cloud');
        const optionFetchGravatar = document.getElementById('option-fetch-gravatar');
        
        const avatarInput = document.getElementById('avatar-input');
        const avatarForm = document.getElementById('avatar-form');
        const modalUploadPreview = document.getElementById('modal-upload-preview');
        const modalPreviewImg = document.getElementById('modal-preview-img');
        const modalConfirmUploadBtn = document.getElementById('modal-confirm-upload-btn');
        const modalCancelUploadBtn = document.getElementById('modal-cancel-upload-btn');
        const gravatarLoadingIndicator = document.getElementById('gravatar-loading-indicator');

        function openAvatarModal() {
            if (!avatarModal) return;
            avatarModal.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeAvatarModal() {
            if (!avatarModal) return;
            avatarModal.classList.remove('show');
            document.body.style.overflow = '';
            if (modalUploadPreview) modalUploadPreview.style.display = 'none';
            if (gravatarLoadingIndicator) gravatarLoadingIndicator.style.display = 'none';
        }

        if (openAvatarModalBtn) {
            openAvatarModalBtn.addEventListener('click', (e) => {
                e.preventDefault();
                openAvatarModal();
            });
        }

        if (closeAvatarModalBtn) {
            closeAvatarModalBtn.addEventListener('click', closeAvatarModal);
        }

        if (avatarModal) {
            avatarModal.addEventListener('click', (e) => {
                if (e.target === avatarModal) closeAvatarModal();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && avatarModal.classList.contains('show')) {
                    closeAvatarModal();
                }
            });
        }

        // Option 1: Upload from Cloud / Device
        if (optionUploadCloud && avatarInput) {
            optionUploadCloud.addEventListener('click', () => {
                avatarInput.click();
            });
        }

        if (avatarInput) {
            avatarInput.addEventListener('change', function() {
                if (this.files && this.files[0]) {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        if (modalPreviewImg) modalPreviewImg.src = e.target.result;
                        if (modalUploadPreview) modalUploadPreview.style.display = 'block';
                    };
                    reader.readAsDataURL(this.files[0]);
                } else {
                    if (modalUploadPreview) modalUploadPreview.style.display = 'none';
                }
            });
        }

        if (modalCancelUploadBtn) {
            modalCancelUploadBtn.addEventListener('click', () => {
                if (avatarInput) avatarInput.value = '';
                if (modalUploadPreview) modalUploadPreview.style.display = 'none';
            });
        }

        if (modalConfirmUploadBtn && avatarForm) {
            modalConfirmUploadBtn.addEventListener('click', () => {
                modalConfirmUploadBtn.disabled = true;
                modalConfirmUploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading...';
                avatarForm.submit();
            });
        }

        // Option 2: Fetch from Gravatar
        if (optionFetchGravatar) {
            optionFetchGravatar.addEventListener('click', async () => {
                if (gravatarLoadingIndicator) gravatarLoadingIndicator.style.display = 'block';
                if (modalUploadPreview) modalUploadPreview.style.display = 'none';

                try {
                    const response = await fetch('/account/fetch-gravatar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    if (response.redirected) {
                        window.location.href = response.url;
                        return;
                    }

                    if (response.ok) {
                        window.location.href = '/profile?success=' + encodeURIComponent('Gravatar image synced successfully.');
                    } else {
                        const errorData = await response.json().catch(() => null);
                        alert(errorData?.error || 'Could not fetch Gravatar. Ensure your email is registered at gravatar.com');
                        if (gravatarLoadingIndicator) gravatarLoadingIndicator.style.display = 'none';
                    }
                } catch (err) {
                    console.error('Gravatar fetch error:', err);
                    alert('Network error occurred while fetching Gravatar.');
                    if (gravatarLoadingIndicator) gravatarLoadingIndicator.style.display = 'none';
                }
            });
        }

        // ==========================================
        // 3. CUSTOM CALENDAR UI (DOB)
        // ==========================================
        initCustomDobCalendar({
            containerId: 'dob-calendar-container',
            triggerId: 'dob-calendar-trigger',
            displayTextId: 'dob-display-text',
            popupId: 'dob-calendar-popup',
            hiddenInputId: 'dateOfBirth',
            monthSelectId: 'cal-month-select',
            yearSelectId: 'cal-year-select',
            daysGridId: 'cal-days-grid',
            prevBtnId: 'cal-prev-month',
            nextBtnId: 'cal-next-month',
            clearBtnId: 'cal-clear-btn',
            closeBtnId: 'cal-close-btn'
        });

    });

    // Reusable Custom DOB Calendar Initializer
    function initCustomDobCalendar(config) {
        const container = document.getElementById(config.containerId);
        const trigger = document.getElementById(config.triggerId);
        const displayText = document.getElementById(config.displayTextId);
        const popup = document.getElementById(config.popupId);
        const hiddenInput = document.getElementById(config.hiddenInputId);
        const monthSelect = document.getElementById(config.monthSelectId);
        const yearSelect = document.getElementById(config.yearSelectId);
        const daysGrid = document.getElementById(config.daysGridId);
        const prevBtn = document.getElementById(config.prevBtnId);
        const nextBtn = document.getElementById(config.nextBtnId);
        const clearBtn = document.getElementById(config.clearBtnId);
        const closeBtn = document.getElementById(config.closeBtnId);

        if (!container || !trigger || !hiddenInput) return;

        const currentYear = new Date().getFullYear();
        const startYear = 1920;

        // Populate year dropdown (descending from currentYear to startYear)
        if (yearSelect) {
            yearSelect.innerHTML = '';
            for (let y = currentYear; y >= startYear; y--) {
                const opt = document.createElement('option');
                opt.value = y;
                opt.textContent = y;
                yearSelect.appendChild(opt);
            }
        }

        // Initial Selected Date Parsing
        let selectedDate = null;
        if (hiddenInput.value) {
            const parts = hiddenInput.value.split('-');
            if (parts.length === 3) {
                selectedDate = new Date(Date.UTC(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2])));
            }
        }

        // Current View State (Month & Year in view)
        let viewDate = selectedDate ? new Date(selectedDate) : new Date(Date.UTC(currentYear - 20, 0, 1));
        let viewYear = viewDate.getUTCFullYear();
        let viewMonth = viewDate.getUTCMonth();

        function updateTriggerDisplay() {
            if (selectedDate && !isNaN(selectedDate.getTime())) {
                displayText.textContent = selectedDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    timeZone: 'UTC'
                });
                displayText.classList.remove('placeholder');
            } else {
                displayText.textContent = 'Select your Date of Birth';
                displayText.classList.add('placeholder');
            }
        }

        function renderCalendar() {
            if (monthSelect) monthSelect.value = viewMonth;
            if (yearSelect) yearSelect.value = viewYear;

            if (!daysGrid) return;
            daysGrid.innerHTML = '';

            const firstDayOfMonth = new Date(Date.UTC(viewYear, viewMonth, 1)).getUTCDay();
            const daysInMonth = new Date(Date.UTC(viewYear, viewMonth + 1, 0)).getUTCDate();
            const daysInPrevMonth = new Date(Date.UTC(viewYear, viewMonth, 0)).getUTCDate();

            const today = new Date();
            const todayUTC = new Date(Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()));

            // Previous month overflow days
            for (let i = firstDayOfMonth - 1; i >= 0; i--) {
                const dayNum = daysInPrevMonth - i;
                const cell = document.createElement('div');
                cell.className = 'cal-day-cell other-month';
                cell.textContent = dayNum;
                cell.addEventListener('click', () => {
                    viewMonth--;
                    if (viewMonth < 0) {
                        viewMonth = 11;
                        viewYear--;
                    }
                    selectDay(viewYear, viewMonth, dayNum);
                });
                daysGrid.appendChild(cell);
            }

            // Current month days
            for (let d = 1; d <= daysInMonth; d++) {
                const cellDate = new Date(Date.UTC(viewYear, viewMonth, d));
                const cell = document.createElement('div');
                cell.className = 'cal-day-cell';
                cell.textContent = d;

                // Disable future dates (no future DOBs)
                if (cellDate > todayUTC) {
                    cell.classList.add('disabled');
                } else {
                    if (selectedDate && 
                        selectedDate.getUTCFullYear() === viewYear && 
                        selectedDate.getUTCMonth() === viewMonth && 
                        selectedDate.getUTCDate() === d) {
                        cell.classList.add('selected');
                    }
                    cell.addEventListener('click', () => {
                        selectDay(viewYear, viewMonth, d);
                    });
                }
                daysGrid.appendChild(cell);
            }

            // Next month overflow days to fill 35 or 42 grid slots
            const totalCells = daysGrid.children.length;
            const remaining = totalCells % 7 === 0 ? 0 : 7 - (totalCells % 7);
            for (let n = 1; n <= remaining; n++) {
                const cell = document.createElement('div');
                cell.className = 'cal-day-cell other-month';
                cell.textContent = n;
                cell.addEventListener('click', () => {
                    viewMonth++;
                    if (viewMonth > 11) {
                        viewMonth = 0;
                        viewYear++;
                    }
                    selectDay(viewYear, viewMonth, n);
                });
                daysGrid.appendChild(cell);
            }
        }

        function selectDay(y, m, d) {
            const chosen = new Date(Date.UTC(y, m, d));
            const today = new Date();
            const todayUTC = new Date(Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()));
            if (chosen > todayUTC) return;

            selectedDate = chosen;
            viewYear = y;
            viewMonth = m;

            // Update hidden input to ISO YYYY-MM-DD
            const isoYear = selectedDate.getUTCFullYear();
            const isoMonth = String(selectedDate.getUTCMonth() + 1).padStart(2, '0');
            const isoDay = String(selectedDate.getUTCDate()).padStart(2, '0');
            hiddenInput.value = `${isoYear}-${isoMonth}-${isoDay}`;

            updateTriggerDisplay();
            renderCalendar();
            container.classList.remove('open');
            container.closest('.form-section')?.classList.remove('cal-open');
            trigger.setAttribute('aria-expanded', 'false');
        }

        // Toggle calendar popup
        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = container.classList.toggle('open');
            container.closest('.form-section')?.classList.toggle('cal-open', isOpen);
            trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            if (isOpen) {
                if (selectedDate) {
                    viewYear = selectedDate.getUTCFullYear();
                    viewMonth = selectedDate.getUTCMonth();
                }
                renderCalendar();
            }
        });

        if (monthSelect) {
            monthSelect.addEventListener('change', (e) => {
                viewMonth = parseInt(e.target.value);
                renderCalendar();
            });
        }

        if (yearSelect) {
            yearSelect.addEventListener('change', (e) => {
                viewYear = parseInt(e.target.value);
                renderCalendar();
            });
        }

        if (prevBtn) {
            prevBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                viewMonth--;
                if (viewMonth < 0) {
                    viewMonth = 11;
                    viewYear--;
                }
                renderCalendar();
            });
        }

        if (nextBtn) {
            nextBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                viewMonth++;
                if (viewMonth > 11) {
                    viewMonth = 0;
                    viewYear++;
                }
                renderCalendar();
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                selectedDate = null;
                hiddenInput.value = '';
                updateTriggerDisplay();
                renderCalendar();
            });
        }

        if (closeBtn) {
            closeBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                container.classList.remove('open');
                container.closest('.form-section')?.classList.remove('cal-open');
                trigger.setAttribute('aria-expanded', 'false');
            });
        }

        // Close on outside click
        document.addEventListener('click', (e) => {
            if (!container.contains(e.target)) {
                container.classList.remove('open');
                container.closest('.form-section')?.classList.remove('cal-open');
                trigger.setAttribute('aria-expanded', 'false');
            }
        });

        // Initialize display text
        updateTriggerDisplay();
    }
</script>

<%- include('../partials/footer') %>