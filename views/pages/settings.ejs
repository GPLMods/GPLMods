    <div class="policy-modal-content" style="background-color: var(--dark-gray); color: var(--white); padding: 40px 30px; text-align: center; border-radius: 15px; max-width: 500px; width: 90%; border-top: 4px solid var(--gold); box-shadow: 0 15px 40px rgba(0,0,0,0.6);">
        <i class="fas fa-user-slash" style="font-size: 3.5em; color: var(--gold); margin-bottom: 20px;"></i>
        <h2 style="color: var(--white); margin-bottom: 15px; font-size: 1.8em;">Leave Partnership Program?</h2>
