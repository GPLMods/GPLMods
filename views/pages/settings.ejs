<%-include('../partials/header') %>

<style>
    .settings-container { max-width: 800px; margin: 2rem auto 4rem auto; }
    .settings-section { background: var(--dark-gray); border: 1px solid #333; border-radius: 12px; padding: 30px; margin-bottom: 25px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; transition: box-shadow 0.3s ease; }
    .settings-section:hover { box-shadow: 0 5px 20px rgba(0,0,0,0.4); }
    .settings-info h3 { margin: 0 0 8px 0; color: var(--white); font-size: 1.4em; display: flex; align-items: center; gap: 10px; }
    .settings-info p { margin: 0; color: var(--silver); font-size: 1em; line-height: 1.5; max-width: 500px; }
    
    .btn-danger-outline { background: transparent; border: 2px solid var(--red); color: var(--red); padding: 12px 25px; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.3s; font-family: 'Poppins', sans-serif; font-size: 1em; }
    .btn-danger-outline:hover { background: var(--red); color: var(--white); box-shadow: 0 0 15px var(--glow-red); }

    /* Custom GUI Dropdown for Security Questions */
    .custom-select-wrapper { position: relative; user-select: none; width: 100%; }
    .custom-select-wrapper.open { z-index: 99999 !important; }
    .custom-select { position: relative; display: flex; align-items: center; justify-content: space-between; background: #0d0d12; border: 1.5px solid #444; border-radius: 8px; cursor: pointer; padding: 11px 14px; color: #fff; font-size: 0.9em; transition: all 0.2s ease; min-height: 44px; }
    .custom-select:hover { border-color: rgba(255, 215, 0, 0.6); }
    .custom-select-wrapper.open .custom-select { border-color: var(--gold); border-bottom-left-radius: 0; border-bottom-right-radius: 0; box-shadow: 0 0 14px rgba(255, 215, 0, 0.25); background: #12131a; }
    .custom-select-arrow { transition: transform 0.25s ease; color: var(--gold); font-size: 0.85em; pointer-events: none; }
    .custom-select-wrapper.open .custom-select-arrow { transform: rotate(180deg); }
    .custom-options { position: absolute; display: none; top: 100%; left: 0; right: 0; background: #12131a; border: 1.5px solid var(--gold); border-top: none; border-radius: 0 0 8px 8px; z-index: 999999 !important; max-height: 250px; overflow-y: auto; box-shadow: 0 12px 30px rgba(0,0,0,0.9); }
    .custom-select-wrapper.open .custom-options { display: block; }
    .custom-option { padding: 11px 14px; color: var(--silver); cursor: pointer; transition: all 0.18s ease; font-size: 0.88em; border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
    .custom-option:last-child { border-bottom: none; }
    .custom-option:hover { background-color: rgba(255, 215, 0, 0.18); color: #fff; }
    .custom-option.selected { color: var(--gold); font-weight: bold; background: rgba(255, 215, 0, 0.1); }
    .custom-write-in-option { border-top: 1px dashed rgba(255, 215, 0, 0.4); color: var(--gold) !important; font-weight: 600; }
</style>

<main class="container">
    <div class="settings-container">
        
        <!-- ======== DYNAMIC GO BACK BUTTON ======== -->
        <%- include('../partials/go-back-button', { fallback: '/dashboard' }) %>
        <!-- ======================================== -->

        <div style="text-align: center; padding: 10px 0 40px;">
            <h1 style="color: var(--white); font-size: 2.8em; margin-bottom: 10px;">Account <span style="color: var(--gold); text-shadow: 0 0 4px var(--glow-gold);">Settings</span></h1>
        </div>

        <!-- Membership & Subscription Status Section -->
        <%
            let displayTierName = 'Free Member';
            let tierSubtitle = 'Basic Member • Ad-Supported Access';
            let timeRemainingText = 'Free Access';
            let uploadSlotText = '3 Slots';
            let maxFileSizeText = '300 MB';
            let isLifetimeVIP = false;
            let statusBadgeText = 'Free Member';

            if (user.role === 'owner') {
                displayTierName = 'GPL Plus (OWNER VIP)';
                tierSubtitle = 'Permanent Lifetime Access • No Recurring Charges • Owner Privileges';
                timeRemainingText = 'Permanent';
                uploadSlotText = 'Unlimited Slots';
                maxFileSizeText = '100.0 GB';
                isLifetimeVIP = true;
                statusBadgeText = 'Lifetime VIP';
            } else if (user.role === 'admin') {
                displayTierName = 'GPL Plus (ADMIN VIP)';
                tierSubtitle = 'Permanent Lifetime Access • No Recurring Charges • Admin Privileges';
                timeRemainingText = 'Permanent';
                uploadSlotText = 'Unlimited Slots';
                maxFileSizeText = '100.0 GB';
                isLifetimeVIP = true;
                statusBadgeText = 'Lifetime VIP';
            } else if (user.role === 'support') {
                displayTierName = 'GPL Plus (SUPPORT VIP)';
                tierSubtitle = 'Permanent Lifetime Access • Support Team Privileges';
                timeRemainingText = 'Permanent';
                uploadSlotText = 'Unlimited Slots';
                maxFileSizeText = '100.0 GB';
                isLifetimeVIP = true;
                statusBadgeText = 'Lifetime VIP';
            } else if (user.role === 'distributor') {
                displayTierName = 'Distributor Partner';
                tierSubtitle = 'Permanent Partner Access • Distributor Partner Privileges';
                timeRemainingText = 'Permanent';
                uploadSlotText = '50 Slots';
                maxFileSizeText = '5.0 GB';
                isLifetimeVIP = true;
                statusBadgeText = 'Partner Access';
            } else if (user.membership === 'plus' || user.membership === 'premium') {
                displayTierName = 'GPL Plus';
                if ((user.membershipPlan && user.membershipPlan.includes('lifetime')) || !user.membershipExpiresAt) {
                    isLifetimeVIP = true;
                    tierSubtitle = 'Permanent Lifetime Access • No Recurring Charges';
                    timeRemainingText = 'Permanent';
                    statusBadgeText = 'Lifetime VIP';
                } else {
                    const daysLeft = Math.max(0, Math.ceil((new Date(user.membershipExpiresAt).getTime() - Date.now()) / (1000 * 60 * 60 * 24)));
                    tierSubtitle = 'Active Subscription • Cycle ends: ' + new Date(user.membershipExpiresAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                    timeRemainingText = daysLeft + ' Days';
                    statusBadgeText = 'Active Member';
                }
                uploadSlotText = '10 Slots';
                maxFileSizeText = '2.0 GB';
            } else if (user.membership === 'lite') {
                displayTierName = 'GPL Lite';
                if ((user.membershipPlan && user.membershipPlan.includes('lifetime')) || !user.membershipExpiresAt) {
                    isLifetimeVIP = true;
                    tierSubtitle = 'Permanent Lifetime Access • No Recurring Charges';
                    timeRemainingText = 'Permanent';
                    statusBadgeText = 'Lifetime VIP';
                } else {
                    const daysLeft = Math.max(0, Math.ceil((new Date(user.membershipExpiresAt).getTime() - Date.now()) / (1000 * 60 * 60 * 24)));
                    tierSubtitle = 'Active Subscription • Cycle ends: ' + new Date(user.membershipExpiresAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                    timeRemainingText = daysLeft + ' Days';
                    statusBadgeText = 'Active Member';
                }
                uploadSlotText = '5 Slots';
                maxFileSizeText = '600 MB';
            }
        %>
        <div class="settings-section" style="border: 1px solid rgba(255, 215, 0, 0.35); background: linear-gradient(145deg, rgba(255, 215, 0, 0.05), rgba(18, 18, 18, 0.95)); border-radius: 14px; padding: 22px; margin-bottom: 25px; flex-direction: column; align-items: stretch; gap: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px;">
                <div class="settings-info" style="flex: 1;">
                    <h3 style="color: var(--gold); display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                        <i class="fas fa-crown"></i> Membership &amp; Subscription Status
                    </h3>
                    <div style="font-size: 1.15rem; font-weight: 700; color: #fff; margin-top: 2px;">
                        Current Tier: <span style="color: var(--gold);"><%= displayTierName %></span>
                    </div>
                    <p style="margin: 4px 0 0 0; color: var(--silver); font-size: 0.88em;">
                        <%= tierSubtitle %>
                    </p>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <span <%- `style="background: ${isLifetimeVIP ? 'rgba(255, 215, 0, 0.18)' : 'rgba(46, 204, 113, 0.18)'}; color: ${isLifetimeVIP ? 'var(--gold)' : '#2ecc71'}; border: 1px solid ${isLifetimeVIP ? 'var(--gold)' : '#2ecc71'}; padding: 5px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;"` %>>
                        <i class="fas <%= isLifetimeVIP ? 'fa-infinity' : 'fa-check-circle' %>"></i> <%= statusBadgeText %>
                    </span>
                    <a href="/my-membership" class="btn" style="background: var(--gold); color: #000; font-weight: 700; padding: 8px 16px; border-radius: 8px; text-decoration: none; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-id-card"></i> Manage Membership
                    </a>
                    <a href="/membership" class="btn" style="background: rgba(255,255,255,0.08); color: #fff; border: 1px solid #444; font-weight: 600; padding: 8px 14px; border-radius: 8px; text-decoration: none; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-gem"></i> All Plans
                    </a>
                </div>
            </div>

            <!-- Detailed Quota & Membership Sync Grid -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; background: rgba(0, 0, 0, 0.4); border: 1px solid #282828; border-radius: 10px; padding: 14px;">
                <div style="display: flex; flex-direction: column; gap: 3px;">
                    <span style="font-size: 0.75rem; color: var(--silver); text-transform: uppercase; letter-spacing: 0.5px;">Membership Tier</span>
                    <span style="font-size: 0.95rem; font-weight: 700; color: var(--gold);"><%= displayTierName %></span>
                </div>
                <div style="display: flex; flex-direction: column; gap: 3px;">
                    <span style="font-size: 0.75rem; color: var(--silver); text-transform: uppercase; letter-spacing: 0.5px;">Time Remaining</span>
                    <span <%- `style="font-size: 0.95rem; font-weight: 700; color: ${isLifetimeVIP ? 'var(--gold)' : '#2ecc71'};"` %>><%= timeRemainingText %></span>
                </div>
                <div style="display: flex; flex-direction: column; gap: 3px;">
                    <span style="font-size: 0.75rem; color: var(--silver); text-transform: uppercase; letter-spacing: 0.5px;">Upload Cap Slot</span>
                    <span style="font-size: 0.95rem; font-weight: 700; color: #fff;"><%= uploadSlotText %></span>
                </div>
                <div style="display: flex; flex-direction: column; gap: 3px;">
                    <span style="font-size: 0.75rem; color: var(--silver); text-transform: uppercase; letter-spacing: 0.5px;">Max File Size</span>
                    <span style="font-size: 0.95rem; font-weight: 700; color: #fff;"><%= maxFileSizeText %></span>
                </div>
            </div>
        </div>

        <!-- 2FA Settings (INDIVIDUAL METHOD TOGGLES) -->
        <div class="settings-section" style="flex-direction: column; align-items: stretch;">
            <div class="settings-info" style="width: 100%;">
                <h3><i class="fas fa-shield-alt" style="color: var(--gold);"></i> Two-Factor Auth (2FA)</h3>
                <p>Protect your account with up to 2-3 verification options. Toggle each method individually.</p>
            </div>

            <% if (user.twoFactorEnabled) { %>
                <%
                    const activeMethods = (Array.isArray(user.twoFactorMethods) && user.twoFactorMethods.length > 0) 
                        ? user.twoFactorMethods 
                        : [user.twoFactorMethod || 'email'];
                    const methodLabels = { email: 'Email OTP', totp: 'Authenticator App', passkey: 'Passkey', social: 'Social 2FA' };
                    const methodIcons = { email: 'fa-envelope', totp: 'fa-key', passkey: 'fa-fingerprint', social: 'fa-sign-in-alt' };
                    const methodColors = { email: '#4fc3f7', totp: '#ab47bc', passkey: '#66bb6a', social: '#ff7043' };
                %>
                <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 12px; width: 100%;">
                    <% activeMethods.forEach((m, idx) => { %>
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; background: linear-gradient(145deg, rgba(255,255,255,0.04) 0%, rgba(0,0,0,0.3) 100%); border: 1px solid rgba(255,215,0,0.18); border-radius: 10px; transition: border-color 0.2s;">
                            <div style="display: flex; align-items: center; gap: 12px; min-width: 0;">
                                <div <%- `style="width: 38px; height: 38px; border-radius: 10px; background: ${methodColors[m] || '#666'}22; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"` %>>
                                    <i class="fas <%= methodIcons[m] || 'fa-shield-alt' %>" <%- `style="color: ${methodColors[m] || '#aaa'}; font-size: 1em;"` %>></i>
                                </div>
                                <div>
                                    <div style="font-weight: 600; color: #fff; font-size: 0.95em;"><%= methodLabels[m] || m %></div>
                                    <div style="font-size: 0.75em; color: var(--silver); margin-top: 2px;">
                                        <% if (idx === 0) { %>
                                            <span style="color: var(--gold); font-weight: 600;">Primary</span> · Active
                                        <% } else { %>
                                            Active
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            <form action="/account/2fa/disable-method" method="POST" style="margin: 0;" onsubmit="<%= activeMethods.length <= 1 ? 'return confirm(\'This is your last 2FA method. Disabling it will turn off 2FA completely and suspend your ID Card. Continue?\')' : '' %>">
                                <input type="hidden" name="method" value="<%= m %>">
                                <label class="switch" title="Disable <%= methodLabels[m] || m %>">
                                    <input type="checkbox" checked onChange="this.form.submit()">
                                    <span class="slider round"></span>
                                </label>
                            </form>
                        </div>
                    <% }); %>

                    <% if (activeMethods.length < 3) { %>
                        <a href="/account/2fa/setup" style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 14px 18px; background: rgba(255,255,255,0.03); border: 1.5px dashed rgba(255,215,0,0.3); border-radius: 10px; color: var(--gold); text-decoration: none; font-weight: 600; font-size: 0.9em; transition: all 0.2s;" onmouseover="this.style.borderColor='var(--gold)';this.style.background='rgba(255,215,0,0.06)'" onmouseout="this.style.borderColor='rgba(255,215,0,0.3)';this.style.background='rgba(255,255,255,0.03)'">
                            <i class="fas fa-plus-circle"></i> Add Another Method (<%= activeMethods.length %>/3)
                        </a>
                    <% } %>
                </div>
            <% } else { %>
                <div style="margin-top: 12px; width: 100%;">
                    <a href="/account/2fa/setup" style="display: flex; align-items: center; justify-content: center; gap: 10px; padding: 14px 20px; background: rgba(255,215,0,0.1); border: 1.5px solid rgba(255,215,0,0.4); border-radius: 10px; color: var(--gold); text-decoration: none; font-weight: 600; font-size: 0.95em; transition: all 0.3s;" onmouseover="this.style.background='rgba(255,215,0,0.18)';this.style.boxShadow='0 0 15px rgba(255,215,0,0.2)'" onmouseout="this.style.background='rgba(255,215,0,0.1)';this.style.boxShadow='none'">
                        <i class="fas fa-shield-alt"></i> Enable Two-Factor Authentication
                    </a>
                    <p style="text-align: center; color: var(--silver); font-size: 0.82em; margin-top: 8px; opacity: 0.8;">Your account is currently not protected by 2FA.</p>
                </div>
            <% } %>
        </div>

        <div class="settings-section">
            <div class="settings-info">
                <h3><i class="fas fa-bell" style="color: var(--gold);"></i> New Login Alerts</h3>
                <p>Receive an email when a new device signs in to your account.</p>
            </div>
            <form action="/settings/safety-emails" method="POST" style="margin: 0;">
                <input type="hidden" name="settingType" value="loginAlertEmailsEnabled">
                <label class="switch">
                    <input type="checkbox" name="loginAlertEmailsEnabled" onchange="this.form.submit()" <%= user.loginAlertEmailsEnabled ? 'checked' : '' %>>
                    <span class="slider round"></span>
                </label>
            </form>
        </div>

        <!-- Dynamic & PWA Notifications Settings -->
        <%
            const notifSettings = user.notificationSettings || {
                enabled: true,
                newUploads: true,
                clubUpdates: true,
                adminMessages: true,
                soundEnabled: true
            };
        %>
        <div class="settings-section" id="notifications" style="flex-direction: column; align-items: stretch;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; width: 100%;">
                <div class="settings-info" style="max-width: 580px;">
                    <h3><i class="fas fa-bell" style="color: var(--gold);"></i> Dynamic &amp; PWA Notifications</h3>
                    <p>Receive real-time push and in-app alerts on your device for new mod uploads, club releases, and official administrator messages.</p>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <button type="button" class="btn btn-secondary" onclick="openGlobalNotificationModal()" id="btn-open-global-notif" style="border-color: var(--gold); color: var(--gold); padding: 8px 14px; font-size: 0.85em; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-sliders-h"></i> Notification Hub &amp; Channels
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="handleSyncPwaPushClick()" id="btn-request-push" style="border-color: #555; color: var(--silver); padding: 8px 14px; font-size: 0.85em; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-mobile-alt"></i> Sync Device Push
                    </button>
                </div>
            </div>

            <!-- ======== PWA REQUIREMENT NOTICE FOR DEVICE PUSH ======== -->
            <div id="settingsPwaNotice" style="margin-top: 18px; border: 1px solid rgba(255, 193, 7, 0.45); background: linear-gradient(145deg, #1b170c 0%, #0e0d08 100%); border-radius: 14px; padding: 18px 20px;">
                <div style="display: flex; align-items: flex-start; gap: 14px;">
                    <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255, 193, 7, 0.15); border: 1px solid #ffc107; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; color: #ffc107; flex-shrink: 0;">
                        <i class="fas fa-mobile-alt"></i>
                    </div>
                    <div style="flex: 1;">
                        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 4px;">
                            <h4 style="margin: 0; color: #ffc107; font-size: 0.98rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                                <i class="fas fa-exclamation-triangle"></i> Install App as PWA to Enable Device Push Notifications
                            </h4>
                            <span id="settingsPwaTag" style="font-size: 0.74rem; font-weight: 700; padding: 2px 8px; border-radius: 10px; background: rgba(255, 193, 7, 0.2); color: #ffc107; border: 1px solid rgba(255, 193, 7, 0.4);">
                                PWA Required
                            </span>
                        </div>
                        <p style="margin: 0 0 12px 0; color: var(--silver); font-size: 0.86rem; line-height: 1.45;">
                            In-app notifications and site updates work directly in your browser. To unlock background push notifications, device lock-screen alerts, and audio chimes, GPLMods must be installed as a Progressive Web App (PWA).
                        </p>
                        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                            <button type="button" onclick="if(window.triggerPwaInstallPrompt) window.triggerPwaInstallPrompt('settingsPwaInstructions'); else toggleSettingsPwaInstructions();" style="background: var(--gold); color: #000; font-weight: 700; border: none; border-radius: 6px; padding: 7px 14px; font-size: 0.82rem; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                                <i class="fas fa-download"></i> Install GPLMods App
                            </button>
                            <button type="button" onclick="toggleSettingsPwaInstructions()" style="background: rgba(255, 255, 255, 0.08); border: 1px solid #555; color: #fff; padding: 7px 14px; border-radius: 6px; font-size: 0.82rem; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                                <i class="fas fa-info-circle" style="color: var(--gold);"></i> How to Install
                            </button>
                        </div>

                        <!-- Step-by-Step Instructions Drawer -->
                        <div id="settingsPwaInstructions" style="display: none; background: rgba(0, 0, 0, 0.45); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; padding: 14px; margin-top: 12px;">
                            <div style="display: flex; flex-direction: column; gap: 8px; font-size: 0.82rem; color: #ddd; line-height: 1.45;">
                                <div>
                                    <strong style="color: var(--gold);"><i class="fab fa-android"></i> Android (Chrome / Edge):</strong>
                                    <span style="color: var(--silver); margin-left: 6px;">Tap browser menu (⋮) &rarr; "Install app" or "Add to Home screen".</span>
                                </div>
                                <div>
                                    <strong style="color: #64b5f6;"><i class="fab fa-apple"></i> iOS / iPadOS (Safari):</strong>
                                    <span style="color: var(--silver); margin-left: 6px;">Tap Share button (<i class="fas fa-share-square"></i>) &rarr; "Add to Home Screen" (<i class="fas fa-plus-square"></i>).</span>
                                </div>
                                <div>
                                    <strong style="color: #81c784;"><i class="fas fa-desktop"></i> Desktop (Chrome / Edge / Brave):</strong>
                                    <span style="color: var(--silver); margin-left: 6px;">Click the Install icon (<i class="fas fa-desktop"></i>) on the right of the address bar &rarr; "Install".</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dynamic PWA / Notification Status Display -->
            <div id="settingsNotifStatusCard" style="display: none; align-items: center; justify-content: space-between; padding: 12px 18px; border-radius: 10px; margin-top: 14px; font-size: 0.92rem; font-weight: 600; transition: all 0.3s ease;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span id="settingsStatusIcon"><i class="fas fa-info-circle"></i></span>
                    <span id="settingsStatusText">PWA installed successfully, enable notification</span>
                </div>
                <span id="settingsStatusPill" style="font-size: 0.78rem; padding: 3px 10px; border-radius: 12px; font-weight: 700;">Status</span>
            </div>

            <form action="/settings/notifications" method="POST" id="notif-settings-form" style="margin-top: 18px; width: 100%;">
                <!-- Master Toggle -->
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; background: rgba(255, 215, 0, 0.05); border: 1px solid rgba(255, 215, 0, 0.25); border-radius: 10px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(255, 215, 0, 0.15); display: flex; align-items: center; justify-content: center; color: var(--gold);">
                            <i class="fas fa-toggle-on" style="font-size: 1.1em;"></i>
                        </div>
                        <div>
                            <div style="font-weight: 700; color: #fff; font-size: 0.95em;">Allow Site to Send Notifications</div>
                            <div style="font-size: 0.78em; color: var(--silver); margin-top: 2px;">Master authorization for Web Push alerts and device sound chimes</div>
                        </div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" id="masterNotifSwitch" name="notificationsEnabled" onchange="handleMasterNotifChange(this)" <%= notifSettings.enabled ? 'checked' : '' %>>
                        <span class="slider round"></span>
                    </label>
                </div>

                <!-- Alert Channels & Test Notification Container (Shown when notifications are enabled) -->
                <div id="settingsOtherOptions" style="display: none; margin-top: 14px;">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px;">
                        <!-- Channel 1: New Uploads -->
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: rgba(255, 255, 255, 0.03); border: 1px solid #333; border-radius: 10px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <i class="fas fa-cloud-upload-alt" style="color: #64b5f6; width: 18px;"></i>
                                <div>
                                    <div style="font-size: 0.88em; color: #fff; font-weight: 600;">New Mod Uploads</div>
                                    <div style="font-size: 0.75em; color: var(--silver);">Instant alerts when fresh mods are published</div>
                                </div>
                            </div>
                            <label class="switch" style="margin: 0;">
                                <input type="checkbox" id="setting_newUploads" name="newUploads" onchange="handleSubSettingChange()" <%= notifSettings.newUploads !== false ? 'checked' : '' %>>
                                <span class="slider round"></span>
                            </label>
                        </div>

                        <!-- Channel 2: Club Updates -->
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: rgba(255, 255, 255, 0.03); border: 1px solid #333; border-radius: 10px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <i class="fas fa-users" style="color: #81c784; width: 18px;"></i>
                                <div>
                                    <div style="font-size: 0.88em; color: #fff; font-weight: 600;">Club Discussions</div>
                                    <div style="font-size: 0.75em; color: var(--silver);">Notifications from clubs and communities you joined</div>
                                </div>
                            </div>
                            <label class="switch" style="margin: 0;">
                                <input type="checkbox" id="setting_clubUpdates" name="clubUpdates" onchange="handleSubSettingChange()" <%= notifSettings.clubUpdates !== false ? 'checked' : '' %>>
                                <span class="slider round"></span>
                            </label>
                        </div>

                        <!-- Channel 3: Admin Messages -->
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: rgba(255, 255, 255, 0.03); border: 1px solid #333; border-radius: 10px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <i class="fas fa-shield-alt" style="color: #ba68c8; width: 18px;"></i>
                                <div>
                                    <div style="font-size: 0.88em; color: #fff; font-weight: 600;">Admin Announcements</div>
                                    <div style="font-size: 0.75em; color: var(--silver);">Official patch notes, security alerts, and replies</div>
                                </div>
                            </div>
                            <label class="switch" style="margin: 0;">
                                <input type="checkbox" id="setting_adminMessages" name="adminMessages" onchange="handleSubSettingChange()" <%= notifSettings.adminMessages !== false ? 'checked' : '' %>>
                                <span class="slider round"></span>
                            </label>
                        </div>

                        <!-- Channel 4: Sound Chime -->
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: rgba(255, 255, 255, 0.03); border: 1px solid #333; border-radius: 10px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <i class="fas fa-volume-up" style="color: var(--gold); width: 18px;"></i>
                                <div>
                                    <div style="font-size: 0.88em; color: #fff; font-weight: 600;">Audio Chimes</div>
                                    <div style="font-size: 0.75em; color: var(--silver);">Play sound effect on new notifications</div>
                                </div>
                            </div>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <button type="button" onclick="if(window.testNotificationSound) window.testNotificationSound();" style="background: rgba(255,255,255,0.06); border: 1px solid #555; color: #fff; padding: 4px 8px; border-radius: 6px; font-size: 0.74em; cursor: pointer;">
                                    <i class="fas fa-play" style="color: var(--gold);"></i> Test
                                </button>
                                <label class="switch" style="margin: 0;">
                                    <input type="checkbox" id="setting_soundEnabled" name="soundEnabled" onchange="handleSubSettingChange()" <%= notifSettings.soundEnabled !== false ? 'checked' : '' %>>
                                    <span class="slider round"></span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Test Notification Button Row -->
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; background: rgba(33, 150, 243, 0.08); border: 1px solid rgba(33, 150, 243, 0.3); border-radius: 10px; margin-top: 14px; flex-wrap: wrap; gap: 12px;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(33, 150, 243, 0.15); border: 1px solid #2196F3; display: flex; align-items: center; justify-content: center; color: #64b5f6; font-size: 1.1rem; flex-shrink: 0;">
                                <i class="fas fa-paper-plane"></i>
                            </div>
                            <div>
                                <div style="font-weight: 700; color: #fff; font-size: 0.95em;">Test Push Notification</div>
                                <div style="font-size: 0.78em; color: var(--silver); margin-top: 2px;">Send an instant test alert to this device</div>
                            </div>
                        </div>
                        <button type="button" id="btnSettingsTestNotif" onclick="triggerSettingsTestNotif()" class="btn btn-primary" style="background: var(--gold); color: #000; font-weight: 700; border: none; border-radius: 8px; padding: 8px 18px; font-size: 0.85em; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                            <i class="fas fa-bell"></i> Send Test Notification
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <script>
            function isSettingsPwaMode() {
                return Boolean(
                    (typeof window.isGplPwaInstalled === 'function' && window.isGplPwaInstalled()) ||
                    window.matchMedia('(display-mode: standalone)').matches ||
                    window.navigator.standalone === true ||
                    document.referrer.includes('android-app://') ||
                    localStorage.getItem('gpl_pwa_installed') === 'true'
                );
            }

            function toggleSettingsPwaInstructions() {
                const el = document.getElementById('settingsPwaInstructions');
                if (el) el.style.display = (el.style.display === 'none' || !el.style.display) ? 'block' : 'none';
            }

            function syncHubModalWithSettings(payload) {
                const modal_u = document.getElementById('modal_newUploads');
                const modal_c = document.getElementById('modal_clubUpdates');
                const modal_a = document.getElementById('modal_adminMessages');
                const modal_s = document.getElementById('modal_soundEnabled');

                if (modal_u) modal_u.checked = payload.newUploads;
                if (modal_c) modal_c.checked = payload.clubUpdates;
                if (modal_a) modal_a.checked = payload.adminMessages;
                if (modal_s) modal_s.checked = payload.soundEnabled;

                [modal_u, modal_c, modal_a, modal_s].forEach(el => {
                    if (el) el.disabled = !payload.notificationsEnabled;
                });
            }

            async function handleSyncPwaPushClick() {
                if (!isSettingsPwaMode()) {
                    toggleSettingsPwaInstructions();
                    if (window.showGplToast) {
                        window.showGplToast({
                            title: 'PWA Installation Required',
                            body: 'Please install GPLMods as an app to enable background push notifications on your device.'
                        });
                    }
                    if (typeof window.triggerPwaInstallPrompt === 'function') {
                        window.triggerPwaInstallPrompt('settingsPwaInstructions');
                    }
                    return;
                }

                if (window.enablePushNotifications) {
                    await window.enablePushNotifications();
                    const master = document.getElementById('masterNotifSwitch');
                    if (master) {
                        master.checked = true;
                        handleMasterNotifChange(master);
                    }
                }
            }

            async function triggerSettingsTestNotif() {
                if (typeof window.sendTestNotification === 'function') {
                    await window.sendTestNotification();
                } else if (typeof window.testNotificationSound === 'function') {
                    window.testNotificationSound();
                    if (window.showGplToast) {
                        window.showGplToast({ title: 'Test Alert', body: 'Notification sound chime played.' });
                    }
                }
            }

            async function handleMasterNotifChange(checkbox) {
                const isInstalled = isSettingsPwaMode();
                
                // If trying to enable push notifications without PWA installed:
                if (checkbox.checked && !isInstalled) {
                    checkbox.checked = false; // Revert
                    const instructions = document.getElementById('settingsPwaInstructions');
                    if (instructions) instructions.style.display = 'block';
                    
                    if (window.showGplToast) {
                        window.showGplToast({
                            title: 'PWA Installation Required',
                            body: 'Install GPLMods as an app on your home screen or PC to enable device push alerts. In-app alerts remain active.'
                        });
                    }
                    if (typeof window.triggerPwaInstallPrompt === 'function') {
                        window.triggerPwaInstallPrompt('settingsPwaInstructions');
                    }
                    syncSettingsUiState();
                    return;
                }

                const isEnabled = checkbox.checked;
                const u = document.getElementById('setting_newUploads');
                const c = document.getElementById('setting_clubUpdates');
                const a = document.getElementById('setting_adminMessages');
                const s = document.getElementById('setting_soundEnabled');

                [u, c, a, s].forEach(el => {
                    if (el) {
                        el.disabled = !isEnabled;
                        if (!isEnabled) el.checked = false;
                        else el.checked = true;
                    }
                });

                const payload = {
                    notificationsEnabled: isEnabled,
                    newUploads: isEnabled,
                    clubUpdates: isEnabled,
                    adminMessages: isEnabled,
                    soundEnabled: isEnabled
                };

                syncHubModalWithSettings(payload);

                try {
                    localStorage.setItem('gpl_push_notification_enabled', isEnabled ? 'true' : 'false');
                    localStorage.setItem('gpl_push_notification_sound', isEnabled ? 'true' : 'false');
                    localStorage.setItem('gpl_notif_prefs', JSON.stringify({
                        master: isEnabled,
                        newUploads: isEnabled,
                        clubUpdates: isEnabled,
                        adminMessages: isEnabled,
                        soundEnabled: isEnabled
                    }));
                } catch(e) {}

                if (isEnabled) {
                    if (window.enablePushNotifications) {
                        try { await window.enablePushNotifications(); } catch (err) {}
                    }
                } else {
                    if (window.disablePushNotifications) {
                        try { await window.disablePushNotifications(); } catch (err) {}
                    }
                }

                syncSettingsUiState();

                try {
                    await fetch('/settings/notifications', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (window.showGplToast) {
                        window.showGplToast({
                            title: isEnabled ? 'Notifications Enabled' : 'Notifications Disabled',
                            body: isEnabled ? 'Notification enabled, PWA installed.' : 'All site notifications have been disabled.'
                        });
                    }
                } catch (e) {
                    console.error('Error saving notification preferences:', e);
                }
            }

            async function handleSubSettingChange() {
                const u = document.getElementById('setting_newUploads');
                const c = document.getElementById('setting_clubUpdates');
                const a = document.getElementById('setting_adminMessages');
                const s = document.getElementById('setting_soundEnabled');

                const anyChecked = (u && u.checked) || (c && c.checked) || (a && a.checked) || (s && s.checked);
                const master = document.getElementById('masterNotifSwitch');
                if (master) master.checked = Boolean(anyChecked);

                const payload = {
                    notificationsEnabled: Boolean(anyChecked),
                    newUploads: u ? u.checked : false,
                    clubUpdates: c ? c.checked : false,
                    adminMessages: a ? a.checked : false,
                    soundEnabled: s ? s.checked : false
                };

                syncHubModalWithSettings(payload);

                try {
                    localStorage.setItem('gpl_push_notification_enabled', anyChecked ? 'true' : 'false');
                    if (s) localStorage.setItem('gpl_push_notification_sound', s.checked ? 'true' : 'false');
                    localStorage.setItem('gpl_notif_prefs', JSON.stringify({
                        master: Boolean(anyChecked),
                        newUploads: payload.newUploads,
                        clubUpdates: payload.clubUpdates,
                        adminMessages: payload.adminMessages,
                        soundEnabled: payload.soundEnabled
                    }));

                    await fetch('/settings/notifications', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (window.showGplToast) {
                        window.showGplToast({ title: 'Preferences Saved', body: 'Notification channels updated.' });
                    }
                } catch(e) {}
            }

            function syncSettingsUiState() {
                const isInstalled = isSettingsPwaMode();
                const notice = document.getElementById('settingsPwaNotice');
                const statusCard = document.getElementById('settingsNotifStatusCard');
                const statusIcon = document.getElementById('settingsStatusIcon');
                const statusText = document.getElementById('settingsStatusText');
                const statusPill = document.getElementById('settingsStatusPill');
                const otherOptions = document.getElementById('settingsOtherOptions');
                const master = document.getElementById('masterNotifSwitch');

                // 1. If PWA not installed: show notice, hide status card & other options
                if (!isInstalled) {
                    if (notice) notice.style.display = 'block';
                    if (statusCard) statusCard.style.display = 'none';
                    if (otherOptions) otherOptions.style.display = 'none';
                    if (master) master.checked = false;
                    return;
                }

                // 2. PWA IS INSTALLED: completely hide notice!
                if (notice) notice.style.display = 'none';

                // Check notification enablement
                const pushPref = localStorage.getItem('gpl_push_notification_enabled');
                const hasPushGranted = ('Notification' in window) && Notification.permission === 'granted';
                let isEnabled = false;

                if (pushPref !== null) {
                    isEnabled = pushPref === 'true';
                } else if (hasPushGranted) {
                    isEnabled = true;
                } else {
                    try {
                        const localPref = localStorage.getItem('gpl_notif_prefs');
                        if (localPref) {
                            const parsed = JSON.parse(localPref);
                            if (typeof parsed.master === 'boolean') isEnabled = parsed.master;
                        }
                    } catch(e) {}
                }

                if (master) master.checked = isEnabled;

                // Sync channel sub-checkboxes
                try {
                    const localPref = localStorage.getItem('gpl_notif_prefs');
                    if (localPref) {
                        const parsed = JSON.parse(localPref);
                        const u = document.getElementById('setting_newUploads');
                        const c = document.getElementById('setting_clubUpdates');
                        const a = document.getElementById('setting_adminMessages');
                        const s = document.getElementById('setting_soundEnabled');

                        if (u && typeof parsed.newUploads === 'boolean') u.checked = parsed.newUploads;
                        if (c && typeof parsed.clubUpdates === 'boolean') c.checked = parsed.clubUpdates;
                        if (a && typeof parsed.adminMessages === 'boolean') a.checked = parsed.adminMessages;
                        if (s && typeof parsed.soundEnabled === 'boolean') s.checked = parsed.soundEnabled;
                    }
                } catch(e) {}

                // State 2: PWA installed successfully, enable notification
                if (!isEnabled) {
                    if (statusCard) {
                        statusCard.style.display = 'flex';
                        statusCard.style.background = 'rgba(255, 193, 7, 0.12)';
                        statusCard.style.border = '1px solid rgba(255, 193, 7, 0.4)';
                        statusCard.style.color = '#ffc107';
                    }
                    if (statusIcon) statusIcon.innerHTML = '<i class="fas fa-info-circle" style="color: var(--gold); font-size: 1.1rem;"></i>';
                    if (statusText) statusText.textContent = 'PWA installed successfully, enable notification';
                    if (statusPill) {
                        statusPill.textContent = 'PWA Installed';
                        statusPill.style.background = 'rgba(255, 193, 7, 0.2)';
                        statusPill.style.color = '#ffc107';
                        statusPill.style.border = '1px solid rgba(255, 193, 7, 0.4)';
                    }
                    if (otherOptions) otherOptions.style.display = 'none';
                } else {
                    // State 3: Notification enabled, PWA installed
                    if (statusCard) {
                        statusCard.style.display = 'flex';
                        statusCard.style.background = 'rgba(46, 204, 113, 0.12)';
                        statusCard.style.border = '1px solid rgba(46, 204, 113, 0.4)';
                        statusCard.style.color = '#2ecc71';
                    }
                    if (statusIcon) statusIcon.innerHTML = '<i class="fas fa-check-circle" style="color: #2ecc71; font-size: 1.1rem;"></i>';
                    if (statusText) statusText.textContent = 'Notification enabled, PWA installed';
                    if (statusPill) {
                        statusPill.textContent = 'Active & Synced';
                        statusPill.style.background = 'rgba(46, 204, 113, 0.2)';
                        statusPill.style.color = '#2ecc71';
                        statusPill.style.border = '1px solid rgba(46, 204, 113, 0.4)';
                    }
                    // Test notification button with other settings appear as usual!
                    if (otherOptions) otherOptions.style.display = 'block';
                }
            }

            document.addEventListener('DOMContentLoaded', syncSettingsUiState);
            window.addEventListener('pageshow', syncSettingsUiState);
            window.addEventListener('focus', syncSettingsUiState);
            window.addEventListener('gplmods:pwa-installed', syncSettingsUiState);
        </script>

        <div class="settings-section">
            <div class="settings-info">
                <h3><i class="fas fa-cloud-upload-alt" style="color: var(--blue);"></i> Draft Auto-save</h3>
                <p>Automatically save changes while editing a mod. Drafts remain private until you submit them.</p>
            </div>
            <form action="/settings/auto-save" method="POST" style="margin: 0;">
                <label class="switch">
                    <input type="checkbox" name="autoSaveEnabled" onchange="this.form.submit()" <%= user.autoSaveEnabled ? 'checked' : '' %>>
                    <span class="slider round"></span>
                </label>
            </form>
        </div>

        <div class="settings-section">
            <div class="settings-info">
                <h3><i class="fas fa-eye-slash" style="color: var(--gold);"></i> Filter 18+ Mods</h3>
                <p>Hide mods marked 18+ across the site. This is enabled by default for members under 18 and disabled by default for adults.</p>
            </div>
            <form action="/settings/adult-content" method="POST" style="margin: 0;">
                <label class="switch">
                    <input type="checkbox" name="hideAdultContent" onchange="this.form.submit()" <%= user.hideAdultContent ? 'checked' : '' %>>
                    <span class="slider round"></span>
                </label>
            </form>
        </div>

        <div class="settings-section">
            <div class="settings-info">
                <h3><i class="fas fa-globe" style="color: var(--gold);"></i> Global Council</h3>
                <p>When enabled, Editor's Choice Council showcases top mods across all platforms combined instead of filtering by a single platform.</p>
            </div>
            <form action="/settings/global-council" method="POST" style="margin: 0;">
                <label class="switch">
                    <input type="checkbox" name="globalCouncil" onchange="this.form.submit()" <%= user.globalCouncil ? 'checked' : '' %>>
                    <span class="slider round"></span>
                </label>
            </form>
        </div>

        <div class="settings-section">
            <div class="settings-info">
                <h3><i class="fas fa-shield-alt" style="color: var(--red);"></i> Failed Login Alerts</h3>
                <p>Receive an email after five incorrect password attempts on your account.</p>
            </div>
            <form action="/settings/safety-emails" method="POST" style="margin: 0;">
                <input type="hidden" name="settingType" value="failedLoginAlertEmailsEnabled">
                <label class="switch">
                    <input type="checkbox" name="failedLoginAlertEmailsEnabled" onchange="this.form.submit()" <%= user.failedLoginAlertEmailsEnabled ? 'checked' : '' %>>
                    <span class="slider round"></span>
                </label>
            </form>
        </div>

        
        <!-- ======== SECURITY QUESTIONS FOR FAILED LOGIN ATTEMPTS ======== -->
        <div class="settings-section" id="securityQuestionsCard" style="flex-direction: column; align-items: stretch;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; width: 100%;">
                <div class="settings-info" style="max-width: 620px;">
                    <h3><i class="fas fa-key" style="color: var(--gold);"></i> Security Questions (Failed Login Protection)</h3>
                    <p>Configure 3 secret security questions. If multiple failed login attempts occur on your account, answering these questions correctly unlocks your account (followed by 2FA if enabled). 2FA is not required to enable this.</p>
                </div>
                <div>
                    <% if (user.securityQuestions && user.securityQuestions.length === 3) { %>
                        <span style="background: rgba(46, 204, 113, 0.15); color: #2ecc71; border: 1px solid rgba(46, 204, 113, 0.35); padding: 6px 14px; border-radius: 20px; font-size: 0.85em; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
                            <i class="fas fa-check-circle"></i> 3 Questions Active
                        </span>
                    <% } else { %>
                        <span style="background: rgba(231, 76, 60, 0.15); color: #e74c3c; border: 1px solid rgba(231, 76, 60, 0.35); padding: 6px 14px; border-radius: 20px; font-size: 0.85em; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
                            <i class="fas fa-exclamation-circle"></i> Not Configured
                        </span>
                    <% } %>
                </div>
            </div>

            <!-- Custom Security Questions Configuration Form with Pure GUI Selectors (No Browser Static) -->
            <form id="secQuestionsForm" onsubmit="saveSecurityQuestions(event)" style="margin-top: 18px; width: 100%; display: flex; flex-direction: column; gap: 16px;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
                    <!-- Question 1 -->
                    <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid #333; border-radius: 12px; padding: 16px;">
                        <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--gold); margin-bottom: 8px; text-transform: uppercase;">
                            <i class="fas fa-question-circle"></i> Security Question 1
                        </label>
                        <div class="custom-select-wrapper" id="sqWrap1" style="width: 100%; margin-bottom: 10px;">
                            <input type="hidden" name="question1" id="sqVal1" value="What was the name of your first elementary school?">
                            <div class="custom-select" onclick="toggleSqDropdown('sqWrap1', event)">
                                <span class="selected-text" id="sqDisp1">What was the name of your first elementary school?</span>
                                <i class="fas fa-chevron-down custom-select-arrow"></i>
                            </div>
                            <div class="custom-options">
                                <div class="custom-option selected" onclick="selectSqOption('sqWrap1', 'sqVal1', 'sqDisp1', 'What was the name of your first elementary school?', this, 'sqCustom1', event)">What was the name of your first elementary school?</div>
                                <div class="custom-option" onclick="selectSqOption('sqWrap1', 'sqVal1', 'sqDisp1', 'What was your childhood nickname?', this, 'sqCustom1', event)">What was your childhood nickname?</div>
                                <div class="custom-option" onclick="selectSqOption('sqWrap1', 'sqVal1', 'sqDisp1', 'In what city or town did your parents meet?', this, 'sqCustom1', event)">In what city or town did your parents meet?</div>
                                <div class="custom-option" onclick="selectSqOption('sqWrap1', 'sqVal1', 'sqDisp1', 'What was the make and model of your first phone or car?', this, 'sqCustom1', event)">What was the make and model of your first phone or car?</div>
                                <div class="custom-option custom-write-in-option" onclick="selectSqOption('sqWrap1', 'sqVal1', 'sqDisp1', '__CUSTOM__', this, 'sqCustom1', event)"><i class="fas fa-pencil-alt" style="margin-right: 6px;"></i> ✍️ Write my own custom question...</div>
                            </div>
                        </div>
                        <input type="text" id="sqCustom1" placeholder="Type your custom security question 1..." oninput="handleCustomSqInput('sqVal1', 'sqDisp1', this.value)" style="display: none; width: 100%; box-sizing: border-box; background: #0d0d12; border: 1.5px solid var(--gold); border-radius: 8px; padding: 10px 12px; color: #fff; font-size: 0.9em; outline: none; margin-bottom: 10px;">
                        <input type="text" name="answer1" id="sqAns1" placeholder="Enter answer to question 1" required style="width: 100%; box-sizing: border-box; background: #0d0d12; border: 1px solid #444; border-radius: 8px; padding: 10px 12px; color: #fff; font-size: 0.9em; outline: none;">
                    </div>

                    <!-- Question 2 -->
                    <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid #333; border-radius: 12px; padding: 16px;">
                        <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--gold); margin-bottom: 8px; text-transform: uppercase;">
                            <i class="fas fa-question-circle"></i> Security Question 2
                        </label>
                        <div class="custom-select-wrapper" id="sqWrap2" style="width: 100%; margin-bottom: 10px;">
                            <input type="hidden" name="question2" id="sqVal2" value="What is your favorite video game of all time?">
                            <div class="custom-select" onclick="toggleSqDropdown('sqWrap2', event)">
                                <span class="selected-text" id="sqDisp2">What is your favorite video game of all time?</span>
                                <i class="fas fa-chevron-down custom-select-arrow"></i>
                            </div>
                            <div class="custom-options">
                                <div class="custom-option selected" onclick="selectSqOption('sqWrap2', 'sqVal2', 'sqDisp2', 'What is your favorite video game of all time?', this, 'sqCustom2', event)">What is your favorite video game of all time?</div>
                                <div class="custom-option" onclick="selectSqOption('sqWrap2', 'sqVal2', 'sqDisp2', 'What was the name of your first pet?', this, 'sqCustom2', event)">What was the name of your first pet?</div>
                                <div class="custom-option" onclick="selectSqOption('sqWrap2', 'sqVal2', 'sqDisp2', 'What was your dream job when you were a kid?', this, 'sqCustom2', event)">What was your dream job when you were a kid?</div>
                                <div class="custom-option" onclick="selectSqOption('sqWrap2', 'sqVal2', 'sqDisp2', 'What was the first movie or concert you attended?', this, 'sqCustom2', event)">What was the first movie or concert you attended?</div>
                                <div class="custom-option custom-write-in-option" onclick="selectSqOption('sqWrap2', 'sqVal2', 'sqDisp2', '__CUSTOM__', this, 'sqCustom2', event)"><i class="fas fa-pencil-alt" style="margin-right: 6px;"></i> ✍️ Write my own custom question...</div>
                            </div>
                        </div>
                        <input type="text" id="sqCustom2" placeholder="Type your custom security question 2..." oninput="handleCustomSqInput('sqVal2', 'sqDisp2', this.value)" style="display: none; width: 100%; box-sizing: border-box; background: #0d0d12; border: 1.5px solid var(--gold); border-radius: 8px; padding: 10px 12px; color: #fff; font-size: 0.9em; outline: none; margin-bottom: 10px;">
                        <input type="text" name="answer2" id="sqAns2" placeholder="Enter answer to question 2" required style="width: 100%; box-sizing: border-box; background: #0d0d12; border: 1px solid #444; border-radius: 8px; padding: 10px 12px; color: #fff; font-size: 0.9em; outline: none;">
                    </div>

                    <!-- Question 3 -->
                    <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid #333; border-radius: 12px; padding: 16px;">
                        <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--gold); margin-bottom: 8px; text-transform: uppercase;">
                            <i class="fas fa-question-circle"></i> Security Question 3
                        </label>
                        <div class="custom-select-wrapper" id="sqWrap3" style="width: 100%; margin-bottom: 10px;">
                            <input type="hidden" name="question3" id="sqVal3" value="In what city were you born or grew up?">
                            <div class="custom-select" onclick="toggleSqDropdown('sqWrap3', event)">
                                <span class="selected-text" id="sqDisp3">In what city were you born or grew up?</span>
                                <i class="fas fa-chevron-down custom-select-arrow"></i>
                            </div>
                            <div class="custom-options">
                                <div class="custom-option selected" onclick="selectSqOption('sqWrap3', 'sqVal3', 'sqDisp3', 'In what city were you born or grew up?', this, 'sqCustom3', event)">In what city were you born or grew up?</div>
                                <div class="custom-option" onclick="selectSqOption('sqWrap3', 'sqVal3', 'sqDisp3', 'What is your favorite dish or comfort food?', this, 'sqCustom3', event)">What is your favorite dish or comfort food?</div>
                                <div class="custom-option" onclick="selectSqOption('sqWrap3', 'sqVal3', 'sqDisp3', 'What was the street you lived on in high school?', this, 'sqCustom3', event)">What was the street you lived on in high school?</div>
                                <div class="custom-option" onclick="selectSqOption('sqWrap3', 'sqVal3', 'sqDisp3', 'What was the name of your favorite teacher?', this, 'sqCustom3', event)">What was the name of your favorite teacher?</div>
                                <div class="custom-option custom-write-in-option" onclick="selectSqOption('sqWrap3', 'sqVal3', 'sqDisp3', '__CUSTOM__', this, 'sqCustom3', event)"><i class="fas fa-pencil-alt" style="margin-right: 6px;"></i> ✍️ Write my own custom question...</div>
                            </div>
                        </div>
                        <input type="text" id="sqCustom3" placeholder="Type your custom security question 3..." oninput="handleCustomSqInput('sqVal3', 'sqDisp3', this.value)" style="display: none; width: 100%; box-sizing: border-box; background: #0d0d12; border: 1.5px solid var(--gold); border-radius: 8px; padding: 10px 12px; color: #fff; font-size: 0.9em; outline: none; margin-bottom: 10px;">
                        <input type="text" name="answer3" id="sqAns3" placeholder="Enter answer to question 3" required style="width: 100%; box-sizing: border-box; background: #0d0d12; border: 1px solid #444; border-radius: 8px; padding: 10px 12px; color: #fff; font-size: 0.9em; outline: none;">
                    </div>
                </div>

                <div style="display: flex; justify-content: flex-end; margin-top: 10px;">
                    <button type="submit" id="btnSaveSq" class="btn" style="background: var(--gold); color: #000; font-weight: 700; padding: 11px 24px; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
                        <i class="fas fa-save"></i> Save Security Questions
                    </button>
                </div>
            </form>
        </div>

        <script>
            function toggleSqDropdown(wrapId, e) {
                if (e) {
                    e.stopPropagation();
                    e.preventDefault();
                }
                const wrap = document.getElementById(wrapId);
                if (!wrap) return;
                const isOpen = wrap.classList.contains('open');
                document.querySelectorAll('.custom-select-wrapper').forEach(w => w.classList.remove('open'));
                if (!isOpen) {
                    wrap.classList.add('open');
                }
            }

            function selectSqOption(wrapId, valId, dispId, text, element, customInputId, e) {
                if (e) {
                    e.stopPropagation();
                    e.preventDefault();
                }
                const wrap = document.getElementById(wrapId);
                const customInput = document.getElementById(customInputId);

                if (wrap) {
                    wrap.querySelectorAll('.custom-option').forEach(o => o.classList.remove('selected'));
                }
                if (element) element.classList.add('selected');

                if (text === '__CUSTOM__') {
                    if (customInput) {
                        customInput.style.display = 'block';
                        customInput.focus();
                        document.getElementById(valId).value = customInput.value.trim();
                        document.getElementById(dispId).textContent = customInput.value.trim() || '✍️ Custom Question (Type below)';
                    }
                } else {
                    if (customInput) customInput.style.display = 'none';
                    document.getElementById(valId).value = text;
                    document.getElementById(dispId).textContent = text;
                }
                if (wrap) wrap.classList.remove('open');
            }

            function handleCustomSqInput(valId, dispId, customVal) {
                const clean = customVal.trim();
                document.getElementById(valId).value = clean;
                document.getElementById(dispId).textContent = clean || '✍️ Custom Question (Type below)';
            }

            document.addEventListener('click', function(e) {
                if (!e.target.closest('.custom-select-wrapper')) {
                    document.querySelectorAll('.custom-select-wrapper').forEach(w => w.classList.remove('open'));
                }
            });

            async function saveSecurityQuestions(e) {
                e.preventDefault();
                const q1 = document.getElementById('sqVal1').value;
                const a1 = document.getElementById('sqAns1').value.trim();
                const q2 = document.getElementById('sqVal2').value;
                const a2 = document.getElementById('sqAns2').value.trim();
                const q3 = document.getElementById('sqVal3').value;
                const a3 = document.getElementById('sqAns3').value.trim();

                const btn = document.getElementById('btnSaveSq');
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

                try {
                    const res = await fetch('/settings/security-questions', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ question1: q1, answer1: a1, question2: q2, answer2: a2, question3: q3, answer3: a3 })
                    });
                    const data = await res.json();
                    if (res.ok && data.success) {
                        btn.innerHTML = '<i class="fas fa-check"></i> Saved!';
                        if (window.showGplToast) {
                            window.showGplToast({ title: 'Security Questions Active', body: 'Your 3 security questions have been saved and encrypted.' });
                        }
                        setTimeout(() => window.location.reload(), 1200);
                    } else {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-save"></i> Save Security Questions';
                        if (window.showGplToast) {
                            window.showGplToast({ title: 'Error Saving Questions', body: data.error || 'Failed to save security questions.' });
                        }
                    }
                } catch(err) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-save"></i> Save Security Questions';
                    if (window.showGplToast) {
                        window.showGplToast({ title: 'Network Error', body: 'Failed to communicate with server.' });
                    }
                }
            }
        </script>
    
        <!-- Newsletter Settings -->
        <div class="settings-section">
            <div class="settings-info">
                <h3><i class="fas fa-newspaper" style="color: var(--blue);"></i> Newsletter Subscription</h3>
                <p>Receive updates about exclusive new mods and platform news directly to your inbox.</p>
            </div>
            <div>
                <% if (user.isSubscribedToNewsletter) { %>
                    <!-- Assuming you have this route built -->
                    <form action="/account/newsletter" method="POST" style="margin: 0;">
                        <input type="hidden" name="subscribe" value="false">
                        <button type="submit" class="btn btn-secondary" style="border-color: var(--silver); color: var(--silver);">Unsubscribe</button>
                    </form>
                <% } else { %>
                    <button type="button" id="open-newsletter-modal" class="btn btn-primary" style="background: var(--blue); color: var(--white); border: none; box-shadow: 0 0 15px rgba(33, 150, 243, 0.4);">Subscribe Now</button>
                <% } %>
            </div>
        </div>

        <div class="settings-section">
            <div class="settings-info">
                <h3><i class="fas fa-music" style="color: var(--gold);"></i> Music Preferences</h3>
                <p>Customize how background and theme music behave across the site.</p>
            </div>
            <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <label class="switch">
                        <input type="checkbox" id="setting-allow-theme" <%= user.musicSettings && user.musicSettings.allowThemeMusic ? 'checked' : '' %>>
                        <span class="slider round"></span>
                    </label>
                    <span style="color: var(--white); font-size: 0.9em; font-weight: 500;">Allow Theme Music</span>
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                    <label class="switch">
                        <input type="checkbox" id="setting-autoplay-theme" <%= user.musicSettings && user.musicSettings.autoPlayTheme ? 'checked' : '' %>>
                        <span class="slider round"></span>
                    </label>
                    <span style="color: var(--white); font-size: 0.9em; font-weight: 500;">Auto-play Theme Music</span>
                </div>
            </div>
        </div>

        <!-- Web Storage & Cache Cleaner -->
        <div class="settings-section">
            <div class="settings-info">
                <h3><i class="fas fa-broom" style="color: var(--gold);"></i> Web Storage & Cache Cleaner</h3>
                <p>Purge outdated browser cache, cached scripts, stale service workers, and temporary client storage. Fast URL shortcut: navigate to <b>/cc</b> anytime.</p>
                <div id="cache-clean-status" style="margin-top: 8px; font-size: 0.85em; display: none;"></div>
            </div>
            <div>
                <button type="button" id="btn-purge-cache" class="btn btn-secondary" style="border-color: var(--gold); color: var(--gold); font-weight: 600; padding: 10px 20px; border-radius: 8px; cursor: pointer;">
                    <i class="fas fa-trash-alt" style="margin-right: 6px;"></i> Clear Web Cache Now
                </button>
            </div>
        </div>

        <!-- Account Actions (Danger Zone) -->

        <div class="settings-section" style="border-color: rgba(229, 57, 53, 0.5); background-color: rgba(229, 57, 53, 0.05); margin-top: 40px;">
            <div class="settings-info">
                <h3 style="color: var(--red);"><i class="fas fa-exclamation-triangle"></i> Danger Zone</h3>
                <p>Log out of your current session, permanently request account deletion, or leave the partnership program.</p>
            </div>
            <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                <% if (user.role === 'distributor') { %>
                    <button type="button" id="open-leave-partnership-modal-btn" class="btn-danger-outline" style="border-color: var(--gold); color: var(--gold);">
                        <i class="fas fa-user-minus" style="margin-right: 8px;"></i> Leave Program
                    </button>
                <% } %>
                <a href="/logout" id="logout-btn" class="btn-danger-outline" style="text-decoration: none; display: inline-flex; align-items: center;"><i class="fas fa-sign-out-alt" style="margin-right: 8px;"></i> Log Out</a>
                <button type="button" class="btn btn-primary" style="background: var(--red); color: var(--white); border: none; box-shadow: 0 0 15px var(--glow-red); font-size: 1em; padding: 12px 25px;" id="open-delete-modal-btn">Delete Account</button>
            </div>
        </div>
    </div>
</main>

<!-- Newsletter Modal -->
<div id="newsletter-modal" class="policy-modal">
    <div class="policy-modal-content" style="background-color: var(--dark-gray); padding: 40px 30px; border-radius: 15px; border-top: 4px solid var(--blue); text-align: center; box-shadow: 0 15px 40px rgba(0,0,0,0.6);">
        <i class="fas fa-envelope-open-text" style="font-size: 3.5em; color: var(--blue); margin-bottom: 20px;"></i>
        <h2 style="color: var(--white); margin-bottom: 15px; font-size: 1.8em;">Subscribe to Newsletter</h2>
        <p style="color: var(--silver); margin-bottom: 25px; line-height: 1.6;">Enter your email to receive weekly updates on top mods. We never spam, and you can unsubscribe at any time.</p>
        <form action="/account/newsletter" method="POST">
            <input type="hidden" name="subscribe" value="true">
            <input type="email" name="email" value="<%= user.email %>" required style="width: 100%; padding: 15px; border-radius: 8px; border: 1px solid #444; background: var(--black); color: white; margin-bottom: 25px; outline: none; font-family: 'Poppins', sans-serif; font-size: 1.05em;" placeholder="your@email.com">
            <div style="display: flex; gap: 15px; justify-content: center;">
                <button type="submit" class="btn btn-primary" style="background: var(--blue); color: white; border: none; padding: 12px 25px; font-size: 1em;">Confirm</button>
                <button type="button" id="cancel-newsletter-btn" class="btn btn-secondary" style="padding: 12px 25px; font-size: 1em;">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- ======== LEAVE PARTNERSHIP MODAL ======== -->
