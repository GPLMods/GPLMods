<%-include('../partials/header') %>

<style>
    .hub-container { max-width: 800px; margin: 4rem auto; text-align: center; }
    .hub-container h1 { font-size: 2.8em; color: var(--white); margin-bottom: 10px; }
    .hub-container h1 span { color: var(--gold); text-shadow: 0 0 4px var(--glow-gold); }
    .hub-container p { color: var(--silver); font-size: 1.1em; margin-bottom: 3rem; }

    .notification-categories {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .category-card {
        background-color: var(--dark-gray);
        border: 1px solid #333;
        border-radius: 15px;
        padding: 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .category-card:hover {
        transform: translateY(-5px);
        border-color: var(--gold);
        box-shadow: 0 10px 25px rgba(255, 215, 0, 0.1);
    }

    .category-info {
        display: flex;
        align-items: center;
        gap: 20px;
        text-align: left;
    }

    .category-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background-color: var(--black);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8em;
        color: var(--gold);
        border: 2px solid #333;
    }

    .category-text h2 {
        color: var(--white);
        margin: 0 0 5px 0;
        font-size: 1.5em;
    }

    .category-text p {
        color: var(--silver);
        margin: 0;
        font-size: 0.95em;
    }

    .card-arrow {
        color: var(--silver);
        font-size: 1.5em;
        transition: transform 0.3s;
    }

    .category-card:hover .card-arrow {
        transform: translateX(5px);
        color: var(--gold);
    }

    /* The Red Badge for Categories */
    .cat-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        background-color: var(--red);
        color: var(--white);
        font-weight: bold;
        font-size: 0.85em;
        padding: 4px 10px;
        border-radius: 20px;
        box-shadow: 0 0 10px var(--glow-red);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    /* Hide the global badge initially, JS will show it if needed */
    #global-badge { display: none; }

    /* Switch UI */
    .switch-ui {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 26px;
        flex-shrink: 0;
    }
    .switch-ui input { opacity: 0; width: 0; height: 0; }
    .slider-ui {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #2a2c38;
        transition: 0.3s;
        border-radius: 26px;
        border: 1px solid #444;
    }
    .slider-ui:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: #fff;
        transition: 0.3s;
        border-radius: 50%;
    }
    input:checked + .slider-ui {
        background-color: var(--gold);
        border-color: var(--gold);
    }
    input:checked + .slider-ui:before {
        transform: translateX(24px);
        background-color: #000;
    }
    .btn-gold {
        background: var(--gold);
        color: #000;
        font-weight: 700;
        border: none;
        border-radius: 8px;
        padding: 9px 18px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s;
        font-size: 0.88rem;
    }
    .btn-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
    }
</style>

<main class="container">
    <!-- ======== DYNAMIC GO BACK BUTTON ======== -->
    <%- include('../partials/go-back-button', { fallback: '/dashboard', wrapperStyle: 'max-width: 800px; margin: 2rem auto 0 auto; display: flex; justify-content: flex-start;' }) %>
    <!-- ======================================== -->
    <div class="hub-container" style="margin-top: 1rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 2.2rem; text-align: left;">
            <div>
                <h1 style="margin: 0; font-size: 2.5em;">Your <span>Notifications</span></h1>
                <p style="margin: 6px 0 0 0; color: var(--silver); font-size: 1.05em;">Select a category below to view your alerts, updates, and announcements.</p>
            </div>
            <div>
                <% if (user) { %>
                    <a href="/settings#notifications" class="btn btn-secondary" style="border-color: var(--gold); color: var(--gold); padding: 9px 18px; border-radius: 10px; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; background: rgba(255,215,0,0.06); font-weight: 600;">
                        <i class="fas fa-cog"></i> Notification Settings
                    </a>
                <% } else { %>
                    <a href="/guest/notifications" class="btn btn-secondary" style="border-color: var(--gold); color: var(--gold); padding: 9px 18px; border-radius: 10px; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; background: rgba(255,215,0,0.06); font-weight: 600;">
                        <i class="fas fa-cog"></i> Notification Settings
                    </a>
                <% } %>
            </div>
        </div>

        <!-- ALL CARDS MUST BE INSIDE THIS DIV -->
        <div class="notification-categories">
            
            <!-- ✅ FIX: Logged-in Users Only -->
            <% if (user) { %>
                <!-- Category 1: Admin Responses (Personal) -->
                <a href="/notifications/admin-messages" class="category-card">
                    <div class="category-info">
                        <div class="category-icon" style="background: transparent; border: none;">
                            <lottie-player src="<%= cdnUrl %>/animations/massage.json" background="transparent" speed="1" style="width: 80px; height: 80px; transform: scale(1.5);" loop autoplay></lottie-player>
                        </div>
                        <div class="category-text">
                            <h2>Admin Responses</h2>
                            <p>Direct messages, warnings, and support ticket replies.</p>
                        </div>
                    </div>
                    
                    <% if (typeof unreadPersonalCount !== 'undefined' && unreadPersonalCount > 0) { %>
                        <div class="cat-badge">
                            <%= unreadPersonalCount > 9 ? '9+' : unreadPersonalCount %> New
                        </div>
                    <% } else { %>
                        <i class="fas fa-chevron-right card-arrow"></i>
                    <% } %>
                </a>
            <% } %>

            <!-- Category 2: Site Updates (Global - Visible to Everyone) -->
            <a href="/notifications/site-updates" class="category-card" id="site-updates-card" data-total-updates="<%= typeof recentAnnouncementsCount !== 'undefined' ? recentAnnouncementsCount : 0 %>">
                <div class="category-info">
                    <div class="category-icon" style="background: transparent; border: none;">
                        <lottie-player src="<%= cdnUrl %>/animations/update.json" background="transparent" speed="1" style="width: 80px; height: 80px; transform: scale(1.5);" loop autoplay></lottie-player>
                    </div>
                    <div class="category-text">
                        <h2>Site Updates</h2>
                        <p>Global announcements, new features, and patch notes.</p>
                    </div>
                </div>
                <div class="cat-badge" id="global-badge"></div>
                <i class="fas fa-chevron-right card-arrow" id="global-arrow"></i>
            </a>

            <!-- Category 3: New Uploads (24h - Visible to Everyone) -->
            <a href="/notifications/new-uploads" class="category-card" id="new-uploads-card">
                <div class="category-info">
                    <div class="category-icon" style="background: transparent; border: none;">
                        <lottie-player src="<%= cdnUrl %>/animations/upload.json" background="transparent" speed="1" style="width: 80px; height: 80px; transform: scale(1.5);" loop autoplay></lottie-player>
                    </div>
                    <div class="category-text">
                        <h2>New Uploads (24h)</h2>
                        <p>Fresh mods added to the platform today.</p>
                    </div>
                </div>
                <div class="cat-badge" id="uploads-badge" style="display: none;"></div>
                <i class="fas fa-chevron-right card-arrow" id="uploads-arrow"></i>
            </a>

            <!-- Category 4: New Updates (24h - Visible to Everyone) -->
            <a href="/notifications/new-updates" class="category-card" id="new-updates-card">
                <div class="category-info">
                    <div class="category-icon" style="background: transparent; border: none;">
                        <lottie-player src="<%= cdnUrl %>/animations/sync.json" background="transparent" speed="1" style="width: 80px; height: 80px; transform: scale(1.5);" loop autoplay></lottie-player>
                    </div>
                    <div class="category-text">
                        <h2>Recent Updates (24h)</h2>
                        <p>Existing mods that were updated today.</p>
                    </div>
                </div>
                <div class="cat-badge" id="mods-update-badge" style="display: none;"></div>
                <i class="fas fa-chevron-right card-arrow" id="mods-update-arrow"></i>
            </a>

            <!-- ✅ FIX: Logged-in Users Only -->
            <% if (user) { %>
                <!-- Category 5: Following Feed -->
                 <a href="/notifications/following" class="category-card" id="following-card">
                    <div class="category-info">
                        <div class="category-icon" style="background: transparent; border: none;">
                            <lottie-player src="<%= cdnUrl %>/animations/group.json" background="transparent" speed="1" style="width: 80px; height: 80px; transform: scale(1.5);" loop autoplay></lottie-player>
                        </div>
                        <div class="category-text">
                            <h2>Following Updates</h2>
                            <p>Latest uploads and updates from members you follow.</p>
                        </div>
                    </div>
                    <div class="cat-badge" id="following-badge" style="display: none;"></div>
                    <i class="fas fa-chevron-right card-arrow" id="following-arrow"></i>
                </a>

                <!-- Category 6: Clubs & Community Alerts -->
                <a href="/notifications/clubs" class="category-card" id="clubs-notifs-card">
                    <div class="category-info">
                        <div class="category-icon" style="background: rgba(255, 215, 0, 0.15); border: 2px solid var(--gold); color: var(--gold); display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-users" style="font-size: 1.5rem;"></i>
                        </div>
                        <div class="category-text">
                            <h2>Clubs &amp; Community Alerts</h2>
                            <p>Join requests, invites, announcements, and tracked mod feeds.</p>
                        </div>
                    </div>
                    <% if (typeof clubNotificationsCount !== 'undefined' && clubNotificationsCount > 0) { %>
                        <div class="cat-badge">
                            <%= clubNotificationsCount > 9 ? '9+' : clubNotificationsCount %> New
                        </div>
                    <% } else { %>
                        <i class="fas fa-chevron-right card-arrow"></i>
                    <% } %>
                </a>
            <% } %>

        </div> <!-- Closes .notification-categories -->
    </div> <!-- Closes .hub-container -->
</main>

<script>
    (function() {
        const currentUserId = '<%= user ? user._id : 'guest' %>';
        const storagePrefix = `gplmods_notifications_${currentUserId}_`;

        function setupBadge(cardId, badgeId, arrowId, localStorageKey, currentCount) {
            const card = document.getElementById(cardId);
            const badge = document.getElementById(badgeId);
            const arrow = document.getElementById(arrowId);
            
            if (card && badge) {
                const lastSeen = parseInt(localStorage.getItem(storagePrefix + localStorageKey) || '0', 10);
                const unread = Math.max(0, currentCount - lastSeen);
                
                if (unread > 0) {
                    badge.textContent = (unread > 9 ? '9+' : unread) + ' New';
                    badge.style.display = 'flex';
                    if (arrow) arrow.style.display = 'none';
                } else {
                    badge.style.display = 'none';
                    if (arrow) arrow.style.display = '';
                }
                
                if (!card._hasBoundClick) {
                    card.addEventListener('click', () => {
                        localStorage.setItem(storagePrefix + localStorageKey, currentCount.toString());
                        if (typeof window.refreshNotificationBadge === 'function') {
                            window.refreshNotificationBadge();
                        }
                    });
                    card._hasBoundClick = true;
                }
            }
        }

        function refreshHubBadges() {
            const totalUpdates = <%= typeof recentAnnouncementsCount !== 'undefined' ? recentAnnouncementsCount : 0 %>;
            const totalUploads = <%= typeof newUploadsCount !== 'undefined' ? newUploadsCount : 0 %>;
            const totalModsUpdates = <%= typeof newUpdatesCount !== 'undefined' ? newUpdatesCount : 0 %>;
            const totalFollowing = <%= typeof followingCount !== 'undefined' ? followingCount : 0 %>;

            setupBadge('site-updates-card', 'global-badge', 'global-arrow', 'lastSeenUpdates', totalUpdates);
            setupBadge('new-uploads-card', 'uploads-badge', 'uploads-arrow', 'lastSeenUploads', totalUploads);
            setupBadge('new-updates-card', 'mods-update-badge', 'mods-update-arrow', 'lastSeenModsUpd', totalModsUpdates);
            
            if (document.getElementById('following-card')) {
                setupBadge('following-card', 'following-badge', 'following-arrow', 'lastSeenFollowing', totalFollowing);
            }
        }

        document.addEventListener('DOMContentLoaded', refreshHubBadges);
        window.addEventListener('pageshow', refreshHubBadges);
        window.addEventListener('focus', refreshHubBadges);
    })();
</script>

<%- include('../partials/footer') %>