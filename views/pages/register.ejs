<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - GPL Mods</title>
    
    <!-- Fonts and Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="apple-touch-icon" href="/favicon.png">
    
    <!-- ✅ ADDED: Global Stylesheet for Footer & Common Styles -->
    <link rel="stylesheet" href="/css/style.css">
<!-- ✅ FIX 6: Ensure FontAwesome is included so footer icons render! -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Dynamic reCAPTCHA Script -->
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    
    <style>
        /* Local overrides for the Auth Page */
        :root {
            --error: #ff4d4d;
            --success: #2ecc71;
        }

        /* ✅ FIXED: Changed body layout so the footer stays at the bottom */
        body { 
            font-family: 'Poppins', sans-serif; 
            background-color: var(--black); 
            color: var(--white); 
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        /* ✅ FIXED: Created a wrapper to center the form without breaking the footer */
        .auth-page-wrapper {
            flex-grow: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .auth-container { 
            width: 100%;
            max-width: 450px; 
            background-color: var(--dark-gray); 
            padding: 40px; 
            border-radius: 15px; 
            border: 1px solid #2a2a2a;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .logo-area {
            text-align: center;
            margin-bottom: 20px;
            font-size: 1.8em;
            font-weight: 700;
            color: var(--gold);
            text-shadow: 0 0 6px rgba(255, 215, 0, 0.45), 0 0 12px rgba(255, 215, 0, 0.22);
            text-decoration: none;
            display: block;
        }
        .logo-area span { 
            color: var(--silver); 
            text-shadow: 0 0 6px rgba(192, 192, 192, 0.4), 0 0 12px rgba(192, 192, 192, 0.2); 
        }
        .logo { font-size: 1.8em; font-weight: 700; color: var(--gold); text-shadow: 0 0 6px rgba(255, 215, 0, 0.45), 0 0 12px rgba(255, 215, 0, 0.22); text-decoration: none; }
        .logo span { color: var(--silver); text-shadow: 0 0 6px rgba(192, 192, 192, 0.4), 0 0 12px rgba(192, 192, 192, 0.2); }
        .form-container h2 { text-align: center; font-size: 1.8em; margin-bottom: 25px; }
        
        .form-group { margin-bottom: 20px; position: relative; }
        .form-group label { display: block; margin-bottom: 8px; font-weight: 600; color: var(--silver); font-size: 0.9em; }
        .form-group input { width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid #333; background-color: var(--black); color: var(--white); font-size: 1em; }
        .form-group input:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 10px var(--glow-gold); }

        /* Password Strength Bar */
        .strength-container {
            margin-top: 8px;
            height: 5px;
            width: 100%;
            background-color: #333;
            border-radius: 10px;
            overflow: hidden;
        }
        #strength-bar {
            height: 100%;
            width: 0%;
            transition: all 0.3s ease;
        }
        #strength-text {
            font-size: 0.75em;
            margin-top: 5px;
            display: block;
            text-align: right;
        }

        .submit-button { 
            display: block; 
            width: 100%; 
            background: var(--gold); 
            color: var(--black); 
            padding: 14px 20px; 
            border-radius: 8px; 
            font-size: 1.1em; 
            font-weight: 700; 
            border: none; 
            cursor: pointer; 
            transition: all 0.3s ease; 
            margin-top: 10px;
        }
        .submit-button:hover { transform: translateY(-2px); box-shadow: 0 0 20px var(--glow-gold); }

        .divider {
            text-align: center;
            margin: 20px 0;
            position: relative;
            color: #666;
            font-size: 0.9em;
        }
        .divider::before, .divider::after {
            content: "";
            position: absolute;
            top: 50%;
            width: 40%;
            height: 1px;
            background: #333;
        }
        .divider::before { left: 0; }
        .divider::after { right: 0; }

        /* Custom Social Sign-In Buttons (Ghost Style) */
        .social-signin-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%;
            padding: 12px;
            margin-bottom: 12px; /* Reduced slightly to fit 3 buttons nicely */
            background-color: transparent; 
            border: 2px solid var(--silver); 
            color: var(--silver);           
            border-radius: 8px;
            font-size: 1.1em;
            font-weight: 600;
            font-family: 'Poppins', sans-serif;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .social-signin-btn:hover {
            background-color: var(--gold);
            border-color: var(--gold);
            color: var(--black); 
            box-shadow: 0 0 15px var(--glow-gold);
        }

        .social-signin-btn .social-icon {
            width: 24px;
            height: 24px;
            fill: currentColor; /* This makes the SVG inherit the text color! */
        }

        .form-switch { text-align: center; margin-top: 25px; color: var(--silver); font-size: 0.9em; }
        .form-switch a { color: var(--gold); text-decoration: none; font-weight: 600; }
        .form-switch a:hover { text-decoration: underline; }

        @media (max-width: 480px) {
            .auth-container { padding: 25px; border-radius: 0; border: none; box-shadow: none; }
            .auth-page-wrapper { padding: 0; align-items: flex-start; }
        }
/* New Styles for Username Suggestions */
        .username-feedback {
            font-size: 0.85em;
            margin-top: 5px;
            display: block;
            min-height: 18px; /* Keep space even when empty */
        }
        .feedback-available { color: var(--success); }
        .feedback-taken { color: var(--error); }
        
        .suggestion-box {
            display: none;
            margin-top: 10px;
            background: rgba(0,0,0,0.2);
            padding: 10px;
            border-radius: 8px;
            border: 1px dashed #444;
        }
        .suggestion-box p {
            margin: 0 0 8px 0;
            font-size: 0.85em;
            color: var(--silver);
        }
        .suggestion-tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .suggestion-tag {
            background: var(--dark-gray);
            border: 1px solid var(--gold);
            color: var(--gold);
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 0.85em;
            cursor: pointer;
            transition: all 0.2s;
        }
        .suggestion-tag:hover {
            background: var(--gold);
            color: var(--black);
        }

        /* Custom Calendar UI Styles */
        .custom-calendar-container {
            position: relative;
            width: 100%;
            user-select: none;
            z-index: 10;
        }
        .custom-calendar-container.open {
            z-index: 10000;
        }
        .form-group:has(.custom-calendar-container.open),
        .form-group.cal-open {
            z-index: 1000 !important;
            position: relative;
        }
        .custom-calendar-trigger {
            width: 100%;
            padding: 12px 15px;
            background: var(--black);
            border: 1px solid #333;
            border-radius: 8px;
            color: var(--white);
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            font-family: 'Poppins', sans-serif;
            font-size: 1em;
            transition: border-color 0.25s, box-shadow 0.25s;
            box-sizing: border-box;
        }
        .custom-calendar-trigger:hover {
            border-color: #555;
        }
        .custom-calendar-container.open .custom-calendar-trigger {
            border-color: var(--gold);
            box-shadow: 0 0 10px rgba(255, 215, 0, 0.3);
        }
        .dob-display-text.placeholder {
            color: #777;
        }
        .calendar-trigger-icons {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--gold);
        }
        .calendar-arrow {
            font-size: 0.85em;
            color: var(--silver);
            transition: transform 0.3s ease, color 0.3s ease;
        }
        .custom-calendar-container.open .calendar-arrow {
            transform: rotate(180deg);
            color: var(--gold);
        }
        .custom-calendar-popup {
            display: none;
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            width: 330px;
            max-width: calc(100vw - 40px);
            background: #18181c;
            border: 1.5px solid rgba(255, 215, 0, 0.35);
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.95);
            padding: 16px;
            z-index: 99999 !important;
            box-sizing: border-box;
            animation: gplCalPopIn 0.2s ease-out;
        }
        @keyframes gplCalPopIn {
            from { opacity: 0; transform: translateY(-8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .custom-calendar-container.open .custom-calendar-popup {
            display: block;
        }
        .calendar-nav-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            gap: 6px;
        }
        .cal-nav-btn {
            background: #222;
            border: 1px solid #444;
            color: var(--silver);
            width: 32px;
            height: 32px;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85em;
            transition: all 0.2s;
        }
        .cal-nav-btn:hover {
            background: var(--gold);
            color: var(--black);
            border-color: var(--gold);
        }
        .cal-selectors {
            display: flex;
            gap: 6px;
            flex-grow: 1;
            justify-content: center;
        }
        .cal-select {
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            background: #222 url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23ffd700'%3e%3cpath d='M7 10l5 5 5-5z'/%3e%3c/svg%3e") no-repeat right 6px center;
            background-size: 14px;
            color: var(--white);
            border: 1px solid #444;
            border-radius: 6px;
            padding: 5px 22px 5px 8px;
            font-size: 0.85em;
            font-family: inherit;
            cursor: pointer;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .cal-select:hover {
            border-color: #666;
        }
        .cal-select:focus {
            border-color: var(--gold);
            box-shadow: 0 0 8px rgba(255, 215, 0, 0.25);
        }
        .cal-select option {
            background-color: #18181c;
            color: #ffffff;
        }
        .calendar-weekdays {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            text-align: center;
            font-size: 0.75em;
            font-weight: 700;
            color: var(--gold);
            margin-bottom: 8px;
            text-transform: uppercase;
        }
        .calendar-days-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 4px;
            text-align: center;
        }
        .cal-day-cell {
            aspect-ratio: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85em;
            border-radius: 6px;
            cursor: pointer;
            color: var(--white);
            transition: all 0.18s ease;
            border: 1px solid transparent;
        }
        .cal-day-cell:hover:not(.disabled) {
            background: rgba(255, 215, 0, 0.2);
            border-color: var(--gold);
        }
        .cal-day-cell.selected {
            background: var(--gold) !important;
            color: var(--black) !important;
            font-weight: 700;
            box-shadow: 0 0 10px var(--glow-gold);
        }
        .cal-day-cell.other-month {
            color: #555;
        }
        .cal-day-cell.disabled {
            color: #444;
            cursor: not-allowed;
            opacity: 0.35;
        }
        .calendar-footer {
            display: flex;
            justify-content: space-between;
            margin-top: 12px;
            padding-top: 10px;
            border-top: 1px solid #333;
        }
        .cal-footer-btn {
            background: none;
            border: none;
            font-size: 0.82em;
            cursor: pointer;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 4px;
            transition: all 0.2s;
        }
        .cal-clear-btn { color: var(--silver); }
        .cal-clear-btn:hover { color: var(--red); }
        .cal-close-btn { color: var(--gold); }
        .cal-close-btn:hover { color: var(--white); }
    </style>
</head>
<body>

    <!-- Wrapper that takes up the remaining space, pushing footer down -->
    <main class="auth-page-wrapper">

        <div class="auth-container">
    <!-- ======== GO BACK BUTTON ======== -->
    <div class="back-btn-wrapper">
        <a href="/" class="dynamic-back-btn" onclick="event.preventDefault(); smartGoBack('/');">
            <i class="fas fa-arrow-left"></i> Go Back
        </a>
    </div>
    <!-- ======================================== -->
            <a href="/" class="logo-area">GPL <span>Mods</span></a>
            
           <section class="form-container">
                <h2>Create Account</h2>

                <!-- SUCCESS MESSAGE BLOCK -->
                <% if (typeof message !== 'undefined' && message) { %>
                    <p style="padding: 10px; background-color: rgba(46, 204, 113, 0.1); border: 1px solid #2ecc71; text-align: center; margin-bottom: 1rem; border-radius: 8px; font-size: 0.9em; color: #2ecc71; font-weight: bold;">
                        <%= message %>
                    </p>
                <% } %>

                <!-- ERROR MESSAGE BLOCK -->
                <% if (typeof error !== 'undefined' && error) { %>
                    <p style="padding: 10px; background-color: rgba(229, 57, 53, 0.1); border: 1px solid var(--red); text-align: center; margin-bottom: 1rem; border-radius: 8px; font-size: 0.9em; color: var(--red); font-weight: bold;">
                        <%= error %>
                    </p>
                <% } %>

                <form id="signup-form" action="/register" method="POST">
                    <!-- UPDATED Username Group -->
                    <div class="form-group">
                        <label for="username">Username</label>
                        <input type="text" id="username" name="username" placeholder="e.g. YourName" required autocomplete="off">
                        
                        <!-- NEW: Feedback and Suggestions -->
                        <span id="username-msg" class="username-feedback"></span>
                        <div id="suggestion-container" class="suggestion-box">
                            <p>Try one of these instead:</p>
                            <div id="suggestion-list" class="suggestion-tags"></div>
                        </div>
                    </div>


                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="youremail@example.com" required>
                        <p style="font-size: 0.8rem; color: var(--silver); margin-top: 5px;"><i class="fas fa-shield-alt" style="color: var(--gold); margin-right: 4px;"></i> Disposable &amp; temporary email addresses are not allowed.</p>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="********" required>
                        <div class="strength-container">
                            <div id="strength-bar"></div>
                        </div>
                        <span id="strength-text">Strength: Too short</span>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Confirm Password</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="********" required>
                    </div>
                    <!-- ======== CUSTOM CALENDAR UI FOR DATE OF BIRTH ======== -->
                    <div class="form-group">
                        <label for="dob-calendar-trigger"><i class="fas fa-calendar-alt" style="color: var(--gold); margin-right: 6px;"></i> Date of Birth</label>
                        <div class="custom-calendar-container" id="dob-calendar-container">
                            <input type="hidden" name="dateOfBirth" id="dateOfBirth" required>
                            
                            <div class="custom-calendar-trigger" id="dob-calendar-trigger" tabindex="0" role="button" aria-haspopup="dialog" aria-expanded="false">
                                <span class="dob-display-text placeholder" id="dob-display-text">Select your Date of Birth</span>
                                <div class="calendar-trigger-icons">
                                    <i class="fas fa-calendar-alt calendar-icon"></i>
                                    <i class="fas fa-chevron-down calendar-arrow"></i>
                                </div>
                            </div>

                            <div class="custom-calendar-popup" id="dob-calendar-popup" role="dialog" aria-label="Date of Birth Calendar">
                                <div class="calendar-nav-header">
                                    <button type="button" class="cal-nav-btn" id="cal-prev-month" title="Previous Month"><i class="fas fa-chevron-left"></i></button>
                                    <div class="cal-selectors">
                                        <select class="cal-select" id="cal-month-select" aria-label="Select Month">
                                            <option value="0">January</option>
                                            <option value="1">February</option>
                                            <option value="2">March</option>
                                            <option value="3">April</option>
                                            <option value="4">May</option>
                                            <option value="5">June</option>
                                            <option value="6">July</option>
                                            <option value="7">August</option>
                                            <option value="8">September</option>
                                            <option value="9">October</option>
                                            <option value="10">November</option>
                                            <option value="11">December</option>
                                        </select>
                                        <select class="cal-select" id="cal-year-select" aria-label="Select Year"></select>
                                    </div>
                                    <button type="button" class="cal-nav-btn" id="cal-next-month" title="Next Month"><i class="fas fa-chevron-right"></i></button>
                                </div>

                                <div class="calendar-weekdays">
                                    <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
                                </div>

                                <div class="calendar-days-grid" id="cal-days-grid"></div>

                                <div class="calendar-footer">
                                    <button type="button" class="cal-footer-btn cal-clear-btn" id="cal-clear-btn">Clear</button>
                                    <button type="button" class="cal-footer-btn cal-close-btn" id="cal-close-btn">Done</button>
                                </div>
                            </div>
                        </div>
                        <p style="font-size: 0.8rem; color: var(--silver); margin-top: 6px;">Required to access mature content (Must be 13+).</p>
                    </div>
                    <!-- ======================================================= -->
                    <!-- ======== NEW: REFERRAL CODE INPUT ======== -->
                    <div class="form-group">
                        <label for="referralCode">Referral Code <span style="color: var(--silver); font-weight: normal;">(Optional)</span></label>
                        <input type="text" id="referralCode" name="referralCode" placeholder="Enter code if you have one" style="text-transform: uppercase;">
                    </div>
                    <!-- ========================================== -->

                    <!-- UPDATED: ReCAPTCHA and Terms -->
                    <div class="form-group">
                        <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>"></div>
                    </div>
                    <div style="margin-bottom: 20px; color: var(--silver); font-size: 0.85em; line-height: 1.4;">
                        By registering, you agree to our <a href="/privacy-policy" style="color: var(--gold);">Privacy Policy</a> and confirm that you are at least 13 years old.
                    </div>

                    <button type="submit" id="register-submit-btn" class="submit-button">Sign Up</button>
                </form>

                <div class="divider">or</div>

                <!-- Google Login -->
                <a href="/auth/google" class="social-signin-btn">
                    <svg class="social-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M21.35,11.1H12.18V13.83H18.69C18.36,17.64 15.19,19.27 12.19,19.27C8.36,19.27 5,16.25 5,12C5,7.9 8.2,4.73 12,4.73C15.29,4.73 17.1,6.7 17.1,6.7L19,4.72C19,4.72 16.56,2 12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,11.63 21.95,11.36 21.89,11.1H21.35Z"/>
                    </svg>
                    <span>Continue with Google</span>
                </a>

                <!-- GitHub Login -->
                <a href="/auth/github" class="social-signin-btn">
                    <svg class="social-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.379.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
                    </svg>
                    <span>Continue with GitHub</span>
                </a>

                <!-- Microsoft Login -->
                <a href="/auth/microsoft" class="social-signin-btn">
                    <svg class="social-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M11.4 24H0V12.6h11.4V24zM24 24H12.6V12.6H24V24zM11.4 11.4H0V0h11.4v11.4zm12.6 0H12.6V0H24v11.4z"/>
                    </svg>
                    <span>Continue with Microsoft</span>
                </a>

                <p class="form-switch">Already have an account? <a href="/login">Login</a></p>
            </section>
        </div>
    </main>

    <script>
        const passwordInput = document.getElementById('password');
        const strengthBar = document.getElementById('strength-bar');
        const strengthText = document.getElementById('strength-text');

        passwordInput.addEventListener('input', () => {
            const val = passwordInput.value;
            let strength = 0;
            if (val.length >= 6) strength += 25;
            if (val.match(/[a-z]/) && val.match(/[A-Z]/)) strength += 25;
            if (val.match(/\d/)) strength += 25;
            if (val.match(/[^a-zA-Z\d]/)) strength += 25;

            strengthBar.style.width = strength + '%';
            if (strength <= 25) {
                strengthBar.style.backgroundColor = '#ff4d4d';
                strengthText.innerText = 'Strength: Weak';
                strengthText.style.color = '#ff4d4d';
            } else if (strength <= 75) {
                strengthBar.style.backgroundColor = '#ffa500';
                strengthText.innerText = 'Strength: Medium';
                strengthText.style.color = '#ffa500';
            } else {
                strengthBar.style.backgroundColor = '#2ecc71';
                strengthText.innerText = 'Strength: Strong';
                strengthText.style.color = '#2ecc71';
            }
        });
// --- NEW: Live Username Suggestions Logic ---
        const usernameInput = document.getElementById('username');
        const usernameMsg = document.getElementById('username-msg');
        const suggestionContainer = document.getElementById('suggestion-container');
        const suggestionList = document.getElementById('suggestion-list');
        const submitBtn = document.getElementById('register-submit-btn');
        let typingTimer;

        usernameInput.addEventListener('input', function() {
            clearTimeout(typingTimer);
            const val = this.value.trim();

            // Reset UI
            usernameMsg.textContent = '';
            usernameMsg.className = 'username-feedback';
            suggestionContainer.style.display = 'none';
            suggestionList.innerHTML = '';
            submitBtn.disabled = false; // Assume okay until checked

            if (val.length < 3) {
                if (val.length > 0) {
                    usernameMsg.textContent = 'Username must be at least 3 characters.';
                    usernameMsg.classList.add('feedback-taken');
                    submitBtn.disabled = true;
                }
                return;
            }

            // Show checking status
            usernameMsg.textContent = 'Checking availability...';
            usernameMsg.style.color = 'var(--silver)';

            // Wait 500ms after user stops typing before making the API call (debounce)
            typingTimer = setTimeout(async () => {
                try {
                    const response = await fetch(`/api/check-username?username=${encodeURIComponent(val)}`);
                    const data = await response.json();

                    if (data.available) {
                        usernameMsg.textContent = data.message;
                        usernameMsg.classList.add('feedback-available');
                        submitBtn.disabled = false;
                    } else {
                        usernameMsg.textContent = data.message;
                        usernameMsg.classList.add('feedback-taken');
                        // Optional: You could disable the button here, but our backend
                        // generateUniqueUsername helper will automatically fix it anyway.
                        // Letting them submit is fine, it will just append #1 automatically.

                        if (data.suggestions && data.suggestions.length > 0) {
                            suggestionContainer.style.display = 'block';
                            data.suggestions.forEach(suggestion => {
                                const tag = document.createElement('span');
                                tag.className = 'suggestion-tag';
                                tag.textContent = suggestion;
                                // If they click a suggestion, fill the input and re-check
                                tag.addEventListener('click', () => {
                                    usernameInput.value = suggestion;
                                    // Manually trigger the input event to re-validate
                                    usernameInput.dispatchEvent(new Event('input'));
                                });
                                suggestionList.appendChild(tag);
                            });
                        }
                    }
                } catch (err) {
                    usernameMsg.textContent = 'Error checking username.';
                    usernameMsg.classList.add('feedback-taken');
                }
            }, 500); // 500ms delay
        });
        // --- Auto-fill Referral Code from URL ---
        const urlParams = new URLSearchParams(window.location.search);
        const refCode = urlParams.get('ref');
        if (refCode) {
            const refInput = document.getElementById('referralCode');
            if (refInput) {
                refInput.value = refCode.toUpperCase();
                // Optional: Make it read-only so they don't accidentally change it
                // refInput.readOnly = true; 
                // refInput.style.opacity = '0.7';
            }
        }

        const dateOfBirthInput = document.getElementById('dateOfBirth');
        const registrationForm = document.getElementById('signup-form');

        // ======== CUSTOM CALENDAR INITIALIZER FOR REGISTER ========
        function initRegisterDobCalendar() {
            const container = document.getElementById('dob-calendar-container');
            const trigger = document.getElementById('dob-calendar-trigger');
            const displayText = document.getElementById('dob-display-text');
            const popup = document.getElementById('dob-calendar-popup');
            const hiddenInput = document.getElementById('dateOfBirth');
            const monthSelect = document.getElementById('cal-month-select');
            const yearSelect = document.getElementById('cal-year-select');
            const daysGrid = document.getElementById('cal-days-grid');
            const prevBtn = document.getElementById('cal-prev-month');
            const nextBtn = document.getElementById('cal-next-month');
            const clearBtn = document.getElementById('cal-clear-btn');
            const closeBtn = document.getElementById('cal-close-btn');

            if (!container || !trigger || !hiddenInput) return;

            const currentYear = new Date().getFullYear();
            const startYear = 1920;

            // Populate year dropdown (descending from currentYear to startYear, matches profile)
            if (yearSelect) {
                yearSelect.innerHTML = '';
                for (let y = currentYear; y >= startYear; y--) {
                    const opt = document.createElement('option');
                    opt.value = y;
                    opt.textContent = y;
                    yearSelect.appendChild(opt);
                }
            }

            let selectedDate = null;
            if (hiddenInput.value) {
                const parts = hiddenInput.value.split('-');
                if (parts.length === 3) {
                    selectedDate = new Date(Date.UTC(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2])));
                }
            }

            let viewDate = selectedDate ? new Date(selectedDate) : new Date(Date.UTC(currentYear - 20, 0, 1));
            let viewYear = viewDate.getUTCFullYear();
            let viewMonth = viewDate.getUTCMonth();

            function updateTriggerDisplay() {
                if (selectedDate && !isNaN(selectedDate.getTime())) {
                    displayText.textContent = selectedDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        timeZone: 'UTC'
                    });
                    displayText.classList.remove('placeholder');
                } else {
                    displayText.textContent = 'Select your Date of Birth';
                    displayText.classList.add('placeholder');
                }
            }

            function renderCalendar() {
                if (monthSelect) monthSelect.value = viewMonth;
                if (yearSelect) yearSelect.value = viewYear;

                if (!daysGrid) return;
                daysGrid.innerHTML = '';

                const firstDayOfMonth = new Date(Date.UTC(viewYear, viewMonth, 1)).getUTCDay();
                const daysInMonth = new Date(Date.UTC(viewYear, viewMonth + 1, 0)).getUTCDate();
                const daysInPrevMonth = new Date(Date.UTC(viewYear, viewMonth, 0)).getUTCDate();

                const today = new Date();
                const todayUTC = new Date(Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()));

                // Previous month overflow days
                for (let i = firstDayOfMonth - 1; i >= 0; i--) {
                    const dayNum = daysInPrevMonth - i;
                    const cell = document.createElement('div');
                    cell.className = 'cal-day-cell other-month';
                    cell.textContent = dayNum;
                    cell.addEventListener('click', () => {
                        viewMonth--;
                        if (viewMonth < 0) {
                            viewMonth = 11;
                            viewYear--;
                        }
                        selectDay(viewYear, viewMonth, dayNum);
                    });
                    daysGrid.appendChild(cell);
                }

                // Current month days
                for (let d = 1; d <= daysInMonth; d++) {
                    const cellDate = new Date(Date.UTC(viewYear, viewMonth, d));
                    const cell = document.createElement('div');
                    cell.className = 'cal-day-cell';
                    cell.textContent = d;

                    if (cellDate > todayUTC) {
                        cell.classList.add('disabled');
                    } else {
                        if (selectedDate && 
                            selectedDate.getUTCFullYear() === viewYear && 
                            selectedDate.getUTCMonth() === viewMonth && 
                            selectedDate.getUTCDate() === d) {
                            cell.classList.add('selected');
                        }
                        cell.addEventListener('click', () => {
                            selectDay(viewYear, viewMonth, d);
                        });
                    }
                    daysGrid.appendChild(cell);
                }

                // Next month overflow days
                const totalCells = daysGrid.children.length;
                const remaining = totalCells % 7 === 0 ? 0 : 7 - (totalCells % 7);
                for (let n = 1; n <= remaining; n++) {
                    const cell = document.createElement('div');
                    cell.className = 'cal-day-cell other-month';
                    cell.textContent = n;
                    cell.addEventListener('click', () => {
                        viewMonth++;
                        if (viewMonth > 11) {
                            viewMonth = 0;
                            viewYear++;
                        }
                        selectDay(viewYear, viewMonth, n);
                    });
                    daysGrid.appendChild(cell);
                }
            }

            function selectDay(y, m, d) {
                const chosen = new Date(Date.UTC(y, m, d));
                const today = new Date();
                const todayUTC = new Date(Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()));
                if (chosen > todayUTC) return;

                selectedDate = chosen;
                viewYear = y;
                viewMonth = m;

                const isoYear = selectedDate.getUTCFullYear();
                const isoMonth = String(selectedDate.getUTCMonth() + 1).padStart(2, '0');
                const isoDay = String(selectedDate.getUTCDate()).padStart(2, '0');
                hiddenInput.value = `${isoYear}-${isoMonth}-${isoDay}`;

                updateTriggerDisplay();
                renderCalendar();
                container.classList.remove('open');
                container.closest('.form-group')?.classList.remove('cal-open');
                trigger.setAttribute('aria-expanded', 'false');
            }

            trigger.addEventListener('click', (e) => {
                e.stopPropagation();
                const isOpen = container.classList.toggle('open');
                container.closest('.form-group')?.classList.toggle('cal-open', isOpen);
                trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                if (isOpen) {
                    if (selectedDate) {
                        viewYear = selectedDate.getUTCFullYear();
                        viewMonth = selectedDate.getUTCMonth();
                    }
                    renderCalendar();
                }
            });

            if (monthSelect) {
                monthSelect.addEventListener('change', (e) => {
                    viewMonth = parseInt(e.target.value);
                    renderCalendar();
                });
            }

            if (yearSelect) {
                yearSelect.addEventListener('change', (e) => {
                    viewYear = parseInt(e.target.value);
                    renderCalendar();
                });
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    viewMonth--;
                    if (viewMonth < 0) {
                        viewMonth = 11;
                        viewYear--;
                    }
                    renderCalendar();
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    viewMonth++;
                    if (viewMonth > 11) {
                        viewMonth = 0;
                        viewYear++;
                    }
                    renderCalendar();
                });
            }

            if (clearBtn) {
                clearBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    selectedDate = null;
                    hiddenInput.value = '';
                    updateTriggerDisplay();
                    renderCalendar();
                });
            }

            if (closeBtn) {
                closeBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    container.classList.remove('open');
                    container.closest('.form-group')?.classList.remove('cal-open');
                    trigger.setAttribute('aria-expanded', 'false');
                });
            }

            document.addEventListener('click', (e) => {
                if (!container.contains(e.target)) {
                    container.classList.remove('open');
                    container.closest('.form-group')?.classList.remove('cal-open');
                    trigger.setAttribute('aria-expanded', 'false');
                }
            });

            updateTriggerDisplay();
        }

        initRegisterDobCalendar();

        if (registrationForm) {
            registrationForm.addEventListener('submit', (event) => {
                const dobInput = document.getElementById('dateOfBirth');
                if (!dobInput || !dobInput.value) {
                    event.preventDefault();
                    alert('Please select your Date of Birth.');
                    const triggerEl = document.getElementById('dob-calendar-trigger');
                    if (triggerEl) triggerEl.focus();
                    return;
                }

                const cutoffDate = new Date();
                cutoffDate.setFullYear(cutoffDate.getFullYear() - 13);
                const maxIsoDate = cutoffDate.toISOString().split('T')[0];

                if (dobInput.value > maxIsoDate) {
                    event.preventDefault();
                    alert('You must be at least 13 years old to register.');
                    const triggerEl = document.getElementById('dob-calendar-trigger');
                    if (triggerEl) triggerEl.focus();
                }
            });
        }
        function smartGoBack(fallbackUrl) {
            const fallback = fallbackUrl || '/';
            if (document.referrer && document.referrer !== window.location.href) {
                try {
                    const refUrl = new URL(document.referrer);
                    const currentUrl = new URL(window.location.href);
                    if (refUrl.origin === currentUrl.origin) {
                        const trapPaths = ['/login', '/register', '/logout', '/login/2fa', '/admin'];
                        const isTrap = trapPaths.some(p => refUrl.pathname.startsWith(p));
                        if (!isTrap && refUrl.pathname !== currentUrl.pathname) {
                            window.location.href = document.referrer;
                            return;
                        }
                    }
                } catch (e) {}
            }
            if (window.history.length > 1) {
                const prevLoc = window.location.href;
                window.history.back();
                setTimeout(() => {
                    if (window.location.href === prevLoc) {
                        window.location.href = fallback;
                    }
                }, 300);
            } else {
                window.location.href = fallback;
            }
        }
    </script>

