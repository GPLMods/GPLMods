<%- include('../partials/header') %>

<style>
    .preview-page { max-width: 1200px; margin: 35px auto 70px; }
    .preview-banner { padding: 16px 20px; margin-bottom: 25px; background: rgba(33,150,243,0.12); border: 1px solid var(--blue); border-radius: 10px; color: var(--silver); }
    .preview-banner strong { color: var(--blue); }
    .preview-layout { display: grid; grid-template-columns: 300px 1fr; gap: 40px; }
    .preview-sidebar, .preview-section { background: var(--dark-gray); border: 1px solid #333; border-radius: 15px; padding: 30px; }
    .preview-sidebar { text-align: center; align-self: start; }
    .preview-icon { width: 100%; max-width: 200px; height: auto; aspect-ratio: 1; object-fit: contain; border-radius: 15px; margin: 0 auto 20px; display: block; box-shadow: 0 5px 15px rgba(0,0,0,0.3); }
    .preview-sidebar h1 { color: var(--white); overflow-wrap: anywhere; font-size: 2em; line-height: 1.3; margin-bottom: 20px; }
    .preview-rating { color: var(--silver); margin-bottom: 20px; }
    .preview-sidebar p, .preview-section { color: var(--silver); line-height: 1.7; }
    .preview-meta { list-style: none; padding: 0; margin: 20px 0; text-align: left; }
    .preview-meta li { display: grid; grid-template-columns: minmax(105px, 38%) minmax(0, 1fr); gap: 12px; padding: 10px 0; border-bottom: 1px solid #2a2a2a; }
    .preview-meta li > span:first-child { color: var(--silver); }
    .preview-meta li > span:last-child { color: var(--white); font-weight: 600; text-align: right; overflow-wrap: anywhere; }
    .preview-actions { display: block; padding: 15px 20px; background: var(--gold); color: var(--black); border-radius: 10px; text-decoration: none; font-weight: 700; box-shadow: 0 0 15px var(--glow-gold); }
    .preview-actions:hover { background: var(--white); box-shadow: 0 0 25px var(--glow-gold); }
    .preview-section { margin-bottom: 18px; }
    .preview-section h2 { color: var(--gold); margin-bottom: 12px; }
    .preview-section img { max-width: 100%; height: auto; border-radius: 8px; margin: 5px; }
    .preview-section a { color: var(--gold); }
    .preview-parts { padding-left: 20px; }
    @media (max-width: 760px) { .preview-layout { grid-template-columns: 1fr; } }
</style>

<main class="container preview-page">
    <div class="preview-banner"><strong><i class="fas fa-eye"></i> Private Preview</strong><br>Only the file owner and administrators can view this draft preview. It is not published or indexed.</div>
    <div class="preview-layout">
        <aside class="preview-sidebar">
            <img class="preview-icon" src="<%= file.iconUrl || '/images/default-app-icon.png' %>" alt="<%= file.name %> icon">
            <h1><%= file.name || 'Untitled mod' %></h1>
            <div class="preview-rating"><i class="fas fa-star" style="color: var(--gold);"></i> Draft preview</div>
            <a class="preview-actions" href="#preview-content"><i class="fas fa-eye"></i> Preview Draft</a>
            <ul class="preview-meta">
                <li><span>Version:</span><span><%= file.version || 'Draft' %></span></li>
                <li><span>Category:</span><span><%= file.category || 'Not selected' %></span></li>
                <li><span>Suitable For:</span><span><%= file.ageRating || 'NA' %></span></li>
                <li><span>Developer:</span><span><%= file.developer || 'N/A' %></span></li>
                <li><span>License:</span><span><%= file.license ? file.license.name : 'Proprietary / Unknown' %></span></li>
                <li><span>Uploaded By:</span><span><%= file.uploader || 'N/A' %></span></li>
                <% if (file.minOsVersion) { %><li><span>Min OS:</span><span><%= file.minOsVersion %></span></li><% } %>
                <% if (file.architectures && file.architectures.length) { %><li><span>Architecture:</span><span><%= file.architectures.join(', ') %></span></li><% } %>
                <% if (file.isMultiPart && file.downloadParts && file.downloadParts.length) { %><li><span>Parts:</span><span><%= file.downloadParts.length %></span></li><% } %>
            </ul>
        </aside>
        <section id="preview-content">
            <% if (file.modFeatures) { %><article class="preview-section"><h2>Mod Features</h2><%- file.modFeatures %></article><% } %>
            <% if (file.officialDescription) { %><article class="preview-section"><h2>Official Description</h2><%- file.officialDescription %></article><% } %>
            <% if (file.importantNote) { %><article class="preview-section"><h2>Important Note</h2><%- file.importantNote %></article><% } %>
            <% if (file.whatsNew) { %><article class="preview-section"><h2>What's New</h2><%- file.whatsNew %></article><% } %>
            <% if (file.modDescription) { %><article class="preview-section"><h2>Description</h2><%- file.modDescription %></article><% } %>
            <% if (file.downloadParts && file.downloadParts.length) { %><article class="preview-section"><h2>Download Parts</h2><ol class="preview-parts"><% file.downloadParts.forEach(part => { %><li><%= part.partName %>: <%= part.partUrl %></li><% }) %></ol></article><% } %>
            <% if (file.screenshotUrls && file.screenshotUrls.length) { %><article class="preview-section"><h2>Screenshots</h2><% file.screenshotUrls.forEach(url => { %><img src="<%= url %>" alt="Mod screenshot"><% }) %></article><% } %>
            <% if (!file.modFeatures && !file.officialDescription && !file.importantNote && !file.whatsNew && !file.modDescription) { %><article class="preview-section"><p>No description has been added yet.</p></article><% } %>
        </section>
    </div>
</main>

<%- include('../partials/footer') %>
