<%- include('../partials/header') %>
<style>
    .auth-container { 
        max-width: 620px; 
        margin: 40px auto; 
        background: var(--dark-gray); 
        padding: 35px; 
        border-radius: 16px; 
        border: 1px solid #333; 
        border-top: 4px solid var(--gold);
        box-shadow: 0 15px 40px rgba(0,0,0,0.6); 
    }
    
    .suspension-banner {
        background: rgba(229, 57, 53, 0.12);
        border: 2px solid var(--red);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
        text-align: center;
        box-shadow: 0 0 25px rgba(229, 57, 53, 0.2);
        animation: pulseWarning 2s infinite ease-in-out;
    }
    @keyframes pulseWarning {
        0%, 100% { border-color: var(--red); box-shadow: 0 0 15px rgba(229, 57, 53, 0.2); }
        50% { border-color: #ff6b6b; box-shadow: 0 0 25px rgba(229, 57, 53, 0.4); }
    }

    .method-card { 
        background: var(--black); 
        padding: 20px; 
        border-radius: 10px; 
        border: 1px solid #333; 
        margin-bottom: 15px; 
        cursor: pointer; 
        transition: all 0.2s; 
        text-align: left; 
        width: 100%; 
        display: block; 
        position: relative; 
    }
    .method-card:hover { 
        border-color: var(--gold); 
        transform: translateY(-2px); 
        box-shadow: 0 5px 15px rgba(255, 215, 0, 0.1); 
    }
    .method-card.recommended-card {
        border-color: rgba(33, 150, 243, 0.5);
        background: linear-gradient(180deg, rgba(33, 150, 243, 0.05) 0%, var(--black) 100%);
    }
    .method-card.recommended-card:hover {
        border-color: var(--blue);
        box-shadow: 0 5px 20px rgba(33, 150, 243, 0.2);
    }
    .method-card:disabled, .method-card.disabled { 
        opacity: 0.5; 
        cursor: not-allowed; 
        transform: none; 
        box-shadow: none; 
        border-color: #333; 
    }
    
    .method-header { 
        display: flex; 
        justify-content: space-between; 
        align-items: flex-start; 
        gap: 10px;
        margin-bottom: 5px; 
    }
    .method-card h3 { 
        color: var(--white); 
        margin: 0; 
        display: flex; 
        align-items: center; 
        gap: 8px; 
        font-size: 1.15em; 
        flex-wrap: wrap;
        flex: 1;
        min-width: 0;
    }
    .method-card p { 
        color: var(--silver); 
        font-size: 0.88em; 
        margin: 0 0 0 35px; 
        line-height: 1.4; 
    }
    
    .recommended-badge {
        background: rgba(33, 150, 243, 0.2);
        color: #64b5f6;
        border: 1px solid var(--blue);
        font-size: 0.6em;
        padding: 2px 8px;
        border-radius: 12px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        flex-shrink: 0;
        vertical-align: middle;
    }

    @media (max-width: 600px) {
        .auth-container { padding: 25px 16px; margin: 20px auto; }
        .method-card { padding: 16px 14px; }
        .method-card h3 { font-size: 1.05em; }
        .method-card p { margin: 6px 0 0 0; font-size: 0.85em; }
    }

    .info-icon { 
        color: var(--silver); 
        font-size: 1.2em; 
        transition: color 0.2s; 
        padding: 5px; 
        z-index: 10; 
        flex-shrink: 0;
    }
    .info-icon:hover { 
        color: var(--gold); 
    }

    .custom-select-wrapper { position: relative; width: 100%; margin-bottom: 15px; user-select: none; }
    .custom-select { display: flex; justify-content: space-between; align-items: center; padding: 12px 15px; background-color: var(--black); border: 1px solid #333; border-radius: 8px; color: var(--white); cursor: pointer; font-size: 1em; transition: all 0.3s ease; }
    .custom-select:hover { border-color: var(--gold); }
    .custom-select-wrapper.open .custom-select { border-color: var(--gold); border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
    .custom-select-arrow { transition: transform 0.3s ease; color: var(--gold); }
    .custom-select-wrapper.open .custom-select-arrow { transform: rotate(180deg); }
    .custom-options { position: absolute; top: 100%; left: 0; right: 0; background-color: var(--black); border: 1px solid var(--gold); border-top: none; border-radius: 0 0 8px 8px; overflow: hidden; display: none; z-index: 100; box-shadow: 0 10px 20px rgba(0,0,0,0.5); }
    .custom-select-wrapper.open .custom-options { display: block; }
    .custom-option { padding: 12px 15px; color: var(--silver); transition: all 0.2s; cursor: pointer; display: flex; align-items: center; gap: 10px; }
    .custom-option:hover { background-color: #222; color: var(--gold); }
    .custom-option.selected { background-color: rgba(255, 215, 0, 0.1); color: var(--gold); font-weight: bold; }

    .qr-box { background: white; padding: 12px; display: inline-block; border-radius: 12px; margin: 15px 0; border: 2px solid var(--gold); box-shadow: 0 5px 20px rgba(0,0,0,0.4); }

    .cancel-setup-btn { 
        background: transparent; 
        color: var(--silver); 
        border: 1px solid #444; 
        width: 100%; 
        padding: 12px; 
        border-radius: 8px; 
        margin-top: 20px; 
        transition: all 0.3s; 
        cursor: pointer; 
        font-family: inherit; 
        font-size: 0.95em; 
        font-weight: bold; 
    }
    .cancel-setup-btn:hover { 
        background: rgba(229, 57, 53, 0.1); 
        border-color: var(--red); 
        color: var(--red); 
    }
</style>

<main class="container">
    <div class="back-btn-wrapper" style="max-width: 620px; margin: 20px auto 0 auto;">
        <a href="javascript:history.back()" class="dynamic-back-btn">
            <i class="fas fa-arrow-left"></i> Go Back
        </a>
    </div>
    <div class="auth-container" style="margin-top: 15px;">
        
        <% if (typeof isSuspended !== 'undefined' && isSuspended) { %>
            <!-- CARD SUSPENSION ALERT -->
            <div class="suspension-banner">
                <div style="font-size: 2.2em; color: var(--red); margin-bottom: 6px;">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h2 style="color: var(--white); margin: 0 0 6px 0; font-size: 1.4em;">Partner ID Card Suspended</h2>
                <p style="color: #ffadad; margin: 0; font-size: 0.92em; line-height: 1.5;">
                    Your Official ID Card and Quick-Login QR are currently <strong>suspended</strong> because Two-Factor Authentication was disabled. Re-enable any 2FA option below to instantly reactivate your card!
                </p>
            </div>
        <% } else { %>
            <div style="width: 75px; height: 75px; border-radius: 50%; background: rgba(255, 215, 0, 0.1); border: 2px solid var(--gold); display: flex; align-items: center; justify-content: center; margin: 0 auto 15px auto; box-shadow: 0 0 20px rgba(255,215,0,0.2);">
                <i class="fas fa-shield-alt" style="font-size: 2.2em; color: var(--gold);"></i>
            </div>
            <h2 style="color: var(--gold); text-align: center; margin-bottom: 6px; font-size: 1.8em;">Unlock Your ID Card</h2>
            <p style="color: var(--silver); text-align: center; margin-bottom: 25px; font-size: 0.92em;">
                To generate and view your official verified ID Card with Quick-Login access, secure your account using any of the 4 methods below.
            </p>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div style="background: rgba(229, 57, 53, 0.1); border: 1px solid var(--red); color: var(--red); padding: 12px; border-radius: 8px; text-align: center; margin-bottom: 20px; font-weight: bold; font-size: 0.9em;">
                <%= error %>
            </div>
        <% } %>

        <% if (typeof message !== 'undefined' && message) { %>
            <div style="background: rgba(255, 215, 0, 0.1); border: 1px solid rgba(255, 215, 0, 0.3); color: var(--gold); padding: 12px; border-radius: 8px; text-align: center; margin-bottom: 20px; font-weight: bold; font-size: 0.9em;">
                <%= message %>
            </div>
        <% } %>

        <!-- METHOD SELECTION LIST (ALL 4 OPTIONS) -->
        <div id="method-selection">
            
            <!-- 1. Authenticator App Method (TOTP - Recommended) -->
            <div class="method-card recommended-card" id="card-totp">
                <div class="method-header">
                    <h3 id="btn-setup-totp">
                        <i class="fas fa-qrcode" style="color: var(--blue); width: 25px; flex-shrink: 0;"></i>
                        <span>Authenticator App (QR Code)</span>
                        <span class="recommended-badge">Recommended</span>
                    </h3>
                    <i class="fas fa-info-circle info-icon" data-info="totp" title="Learn More"></i>
                </div>
                <p id="btn-setup-totp-p">Scan a QR Code with Google Authenticator, Authy, or 1Password for instant offline codes.</p>
            </div>

            <!-- 2. Passkeys (WebAuthn) Method -->
            <div class="method-card" id="card-passkey">
                <div class="method-header">
                    <h3 id="btn-setup-passkey">
                        <i class="fas fa-fingerprint" style="color: var(--silver); width: 25px;"></i> Passkey (Biometric)
                    </h3>
                    <i class="fas fa-info-circle info-icon" data-info="passkey" title="Learn More"></i>
                </div>
                <p id="btn-setup-passkey-p">Use your device FaceID, TouchID, or Windows Hello PIN for seamless hardware-grade logins.</p>
            </div>

            <!-- 3. Email Authentication Method -->
            <form action="/account/2fa/enable" method="POST" id="form-email-2fa">
                <input type="hidden" name="method" value="email">
                <input type="hidden" name="returnTo" value="/id-card">
                <div class="method-card" id="card-email">
                    <div class="method-header">
                        <h3 onclick="document.getElementById('form-email-2fa').submit()">
                            <i class="fas fa-envelope" style="color: var(--gold); width: 25px;"></i> Email Authentication
                        </h3>
                        <i class="fas fa-info-circle info-icon" data-info="email" title="Learn More"></i>
                    </div>
                    <p onclick="document.getElementById('form-email-2fa').submit()">We will email you a secure 6-digit verification code each time you log in.</p>
                </div>
            </form>

            <!-- 4. Social 2FA Method -->
            <% if (user && (user.googleId || user.githubId || user.microsoftId)) { %>
                <form action="/account/2fa/enable-social" method="POST" style="background: var(--black); padding: 18px; border-radius: 10px; border: 1px solid #333; margin-bottom: 15px;">
                    <input type="hidden" name="returnTo" value="/id-card">
                    <div class="method-header" style="margin-bottom: 12px;">
                        <h3 style="color: var(--white); margin: 0; font-size: 1.15em;"><i class="fas fa-link" style="color: #2ecc71; width: 25px;"></i> Social Verification</h3>
                        <i class="fas fa-info-circle info-icon" data-info="social" title="Learn More"></i>
                    </div>
                    <p style="color: var(--silver); font-size: 0.88em; margin: 0 0 12px 0; line-height: 1.4;">Require an immediate secondary confirmation via your linked provider.</p>
                    
                    <select name="provider" id="social-provider" style="display: none;" required>
                        <% if(user.googleId) { %><option value="google">Google Account</option><% } %>
                        <% if(user.githubId) { %><option value="github">GitHub Account</option><% } %>
                        <% if(user.microsoftId) { %><option value="microsoft">Microsoft Account</option><% } %>
                    </select>
                    
                    <div class="custom-select-wrapper" id="wrapper-social-provider">
                        <div class="custom-select">
                            <span class="selected-text" style="display: flex; align-items: center; gap: 8px;">Select linked account...</span>
                            <i class="fas fa-chevron-down custom-select-arrow"></i>
                        </div>
                        <div class="custom-options">
                            <% if(user.googleId) { %><div class="custom-option" data-value="google"><i class="fab fa-google"></i> Google Account</div><% } %>
                            <% if(user.githubId) { %><div class="custom-option" data-value="github"><i class="fab fa-github"></i> GitHub Account</div><% } %>
                            <% if(user.microsoftId) { %><div class="custom-option" data-value="microsoft"><i class="fab fa-windows" style="color:#00a4ef;"></i> Microsoft Account</div><% } %>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; font-weight: bold; cursor: pointer;">Enable Social 2FA</button>
                </form>
            <% } else { %>
                <div class="method-card disabled">
                    <div class="method-header">
                        <h3><i class="fas fa-link" style="color: var(--silver); width: 25px;"></i> Social Verification</h3>
                    </div>
                    <p>Link a Google, GitHub, or Microsoft account on your profile first to use this method.</p>
                </div>
            <% } %>

            <!-- Cancel Button -->
            <a href="/profile" class="cancel-setup-btn" style="display: block; text-align: center; text-decoration: none;">
                <i class="fas fa-arrow-left"></i> Back to Profile
            </a>
        </div>

        <!-- Hidden TOTP Setup View (Loaded via /account/2fa/generate-totp) -->
        <div id="totp-setup" style="display: none; text-align: center;">
            <h3 style="color: var(--white); margin-bottom: 8px; font-size: 1.4em;">Scan 2FA QR Code</h3>
            <p style="color: var(--silver); font-size: 0.9em; margin-bottom: 15px;">
                1. Open <strong>Google Authenticator</strong>, <strong>Authy</strong>, or <strong>1Password</strong> and scan:
            </p>
            
            <div class="qr-box">
                <img id="qr-img" src="" alt="2FA QR Code" style="width: 200px; height: 200px; display: block;">
            </div>
            
            <p style="color: var(--silver); font-size: 0.85em; margin: 10px 0 6px 0;">
                2. Or enter this manual key if you cannot scan:
            </p>
            
            <div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 20px; background: #222; border: 1px solid #444; border-radius: 8px; padding: 10px; max-width: 100%; overflow: hidden;">
                <strong id="manual-code" style="color: var(--gold); letter-spacing: 1px; user-select: all; font-size: 0.9em; word-break: break-all; flex-grow: 1; text-align: left;">LOADING...</strong>
                <button type="button" id="copy-code-btn" title="Copy to Clipboard" style="background: none; border: none; color: var(--silver); font-size: 1.2em; cursor: pointer; padding: 5px;">
                    <i class="far fa-copy"></i>
                </button>
            </div>

            <form action="/account/2fa/enable" method="POST" style="margin-top: 15px;">
                <input type="hidden" name="method" value="totp">
                <input type="hidden" name="returnTo" value="/id-card">
                <label style="display: block; color: var(--white); font-weight: 600; margin-bottom: 8px; font-size: 0.95em;">
                    Enter the 6-digit code from your authenticator:
                </label>
                <input type="text" name="token" id="totp-token-input" placeholder="000000" maxlength="6" inputmode="numeric" required autocomplete="one-time-code" style="width: 100%; padding: 14px; border-radius: 8px; border: 1px solid var(--gold); background: var(--black); color: var(--gold); text-align: center; font-size: 1.6em; letter-spacing: 8px; margin-bottom: 20px; outline: none; font-family: monospace;">
                
                <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px; font-size: 1.05em; font-weight: bold; cursor: pointer;">
                    <i class="fas fa-check-circle"></i> Verify &amp; Unlock ID Card
                </button>
                <button type="button" id="btn-cancel-totp" class="btn btn-secondary" style="width: 100%; padding: 12px; margin-top: 10px; border: none; background: transparent; color: var(--silver); cursor: pointer;">
                    &larr; Choose Another Option
                </button>
            </form>
        </div>

    </div>
</main>

<!-- ============================================== -->
<!-- INFO MODALS FOR EACH METHOD                    -->
<!-- ============================================== -->
<div id="info-modal-email" class="policy-modal">
    <div class="policy-modal-content" style="background-color: var(--dark-gray); padding: 30px; text-align: center; border-radius: 15px; border-top: 3px solid var(--gold);">
        <i class="fas fa-envelope" style="font-size: 3em; color: var(--gold); margin-bottom: 15px;"></i>
        <h2 style="color: var(--white); margin-bottom: 10px;">Email Authentication</h2>
        <p style="color: var(--silver); line-height: 1.6; margin-bottom: 20px; text-align: left;">Every time you log in, we will send a temporary 6-digit code to your registered email address. This prevents unauthorized access even if your password is compromised.</p>
        <button class="btn btn-primary close-info-modal" style="width: 100%; padding: 10px;">Understood</button>
    </div>
</div>

<div id="info-modal-totp" class="policy-modal">
    <div class="policy-modal-content" style="background-color: var(--dark-gray); padding: 30px; text-align: center; border-radius: 15px; border-top: 3px solid var(--blue);">
        <i class="fas fa-qrcode" style="font-size: 3em; color: var(--blue); margin-bottom: 15px;"></i>
        <h2 style="color: var(--white); margin-bottom: 10px;">Authenticator App (TOTP)</h2>
        <p style="color: var(--silver); line-height: 1.6; margin-bottom: 20px; text-align: left;">Scan the QR code into Google Authenticator or Authy. The app generates time-based 6-digit codes that refresh every 30 seconds. This is the <strong>recommended</strong> method because it works completely offline without network latency.</p>
        <button class="btn btn-primary close-info-modal" style="width: 100%; padding: 10px;">Understood</button>
    </div>
</div>

<div id="info-modal-passkey" class="policy-modal">
    <div class="policy-modal-content" style="background-color: var(--dark-gray); padding: 30px; text-align: center; border-radius: 15px; border-top: 3px solid var(--silver);">
        <i class="fas fa-fingerprint" style="font-size: 3em; color: var(--silver); margin-bottom: 15px;"></i>
        <h2 style="color: var(--white); margin-bottom: 10px;">Passkeys (WebAuthn)</h2>
        <p style="color: var(--silver); line-height: 1.6; margin-bottom: 20px; text-align: left;">Passkeys link a biometric signature (FaceID, TouchID, or Windows Hello PIN) on your device directly to GPL Mods. No codes to remember or type: just verify your biometric identity and you are in!</p>
        <button class="btn btn-primary close-info-modal" style="width: 100%; padding: 10px;">Understood</button>
    </div>
</div>

<div id="info-modal-social" class="policy-modal">
    <div class="policy-modal-content" style="background-color: var(--dark-gray); padding: 30px; text-align: center; border-radius: 15px; border-top: 3px solid #2ecc71;">
        <i class="fas fa-link" style="font-size: 3em; color: #2ecc71; margin-bottom: 15px;"></i>
        <h2 style="color: var(--white); margin-bottom: 10px;">Social Verification</h2>
        <p style="color: var(--silver); line-height: 1.6; margin-bottom: 20px; text-align: left;">Requires an immediate secondary confirmation through your linked Google, GitHub, or Microsoft account to protect your account and ID credentials.</p>
        <button class="btn btn-primary close-info-modal" style="width: 100%; padding: 10px;">Understood</button>
    </div>
</div>

<!-- Accurate Device Error Modal -->
<div id="device-error-modal" class="policy-modal" style="display: none; align-items: center; justify-content: center; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); z-index: 999999; padding: 20px;">
    <div class="policy-modal-content" style="background-color: var(--dark-gray); padding: 30px; text-align: center; border-radius: 16px; border-top: 4px solid var(--red); max-width: 500px; width: 100%; box-shadow: 0 15px 40px rgba(0,0,0,0.8); border: 1px solid rgba(229, 57, 53, 0.4);">
        <div style="width: 65px; height: 65px; border-radius: 50%; background: rgba(229, 57, 53, 0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto 18px auto; border: 2px solid var(--red);">
            <i class="fas fa-mobile-alt" style="font-size: 2em; color: var(--red);"></i>
        </div>
        <h2 id="device-error-title" style="color: var(--white); margin-bottom: 12px; font-size: 1.4em;">Device Verification Issue</h2>
        <p id="device-error-desc" style="color: var(--silver); line-height: 1.6; margin-bottom: 15px; text-align: left; font-size: 0.95em;"></p>
        
        <!-- Accurate Diagnostic Tips -->
        <div id="device-error-troubleshoot" style="background: rgba(0,0,0,0.4); border: 1px solid #333; border-radius: 10px; padding: 14px; margin-bottom: 18px; text-align: left; font-size: 0.85em; color: var(--silver);">
            <strong style="color: var(--gold); display: block; margin-bottom: 6px;"><i class="fas fa-lightbulb"></i> Troubleshooting Steps:</strong>
            <ul id="device-error-tips" style="padding-left: 20px; margin: 0; line-height: 1.5;">
            </ul>
        </div>

        <!-- Technical Detail Accordion -->
        <div style="text-align: left; margin-bottom: 20px;">
            <div id="toggle-tech-details" style="font-size: 0.8em; color: var(--silver); cursor: pointer; display: inline-flex; align-items: center; gap: 5px; text-decoration: underline;">
                <span>Technical Error Details</span> <i class="fas fa-chevron-down" style="font-size: 0.8em;"></i>
            </div>
            <pre id="device-error-tech" style="display: none; background: #0c0c0c; border: 1px solid #222; border-radius: 6px; padding: 10px; font-size: 0.75em; color: #ff8585; overflow-x: auto; margin-top: 8px; white-space: pre-wrap; word-break: break-word;"></pre>
        </div>

        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <button type="button" id="device-error-retry-btn" class="btn btn-primary" style="padding: 10px 22px; border-radius: 8px; font-weight: bold; background: var(--gold); color: var(--black); border: none; cursor: pointer;">
                <i class="fas fa-redo"></i> Try Again
            </button>
            <button type="button" id="device-error-close-btn" class="btn btn-secondary" style="padding: 10px 20px; border-radius: 8px; font-weight: bold; border: 1px solid var(--silver); color: var(--silver); background: transparent; cursor: pointer;">
                Close
            </button>
        </div>
    </div>
</div>

<script src="https://unpkg.com/@simplewebauthn/browser/dist/bundle/index.umd.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const methodSelection = document.getElementById('method-selection');
        const totpSetup = document.getElementById('totp-setup');
        
        // --- 1. Custom Select Dropdown for Social Auth ---
        const wrapper = document.getElementById('wrapper-social-provider');
        const nativeSelect = document.getElementById('social-provider');
        if (wrapper && nativeSelect) {
            const customSelect = wrapper.querySelector('.custom-select');
            const selectedText = wrapper.querySelector('.selected-text');
            const optionsContainer = wrapper.querySelector('.custom-options');

            const firstOption = nativeSelect.options[0]; 
            if (firstOption) {
                nativeSelect.value = firstOption.value;
                const matchCustomOpt = optionsContainer.querySelector(`[data-value="${firstOption.value}"]`);
                if (matchCustomOpt) {
                    selectedText.innerHTML = matchCustomOpt.innerHTML;
                    matchCustomOpt.classList.add('selected');
                }
            }

            customSelect.addEventListener('click', (e) => {
                wrapper.classList.toggle('open');
                e.stopPropagation(); 
            });

            optionsContainer.addEventListener('click', (e) => {
                const optionEl = e.target.closest('.custom-option');
                if (!optionEl) return;
                
                selectedText.innerHTML = optionEl.innerHTML;
                nativeSelect.value = optionEl.getAttribute('data-value');
                
                wrapper.querySelectorAll('.custom-option').forEach(opt => opt.classList.remove('selected'));
                optionEl.classList.add('selected');
                wrapper.classList.remove('open');
            });
            
            document.addEventListener('click', () => wrapper.classList.remove('open'));
        }

        // --- 2. Info Modals ---
        document.querySelectorAll('.info-icon').forEach(icon => {
            icon.addEventListener('click', (e) => {
                e.stopPropagation(); 
                const infoType = icon.getAttribute('data-info');
                const targetModal = document.getElementById(`info-modal-${infoType}`);
                if (targetModal) targetModal.classList.add('active');
            });
        });

        document.querySelectorAll('.close-info-modal').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.policy-modal').forEach(modal => modal.classList.remove('active'));
            });
        });

        // --- 3. TOTP QR Setup Logic ---
        const setupTotpTriggers = [document.getElementById('card-totp'), document.getElementById('btn-setup-totp'), document.getElementById('btn-setup-totp-p')];
        setupTotpTriggers.forEach(el => {
            if(!el) return;
            el.addEventListener('click', async (e) => {
                if (e.target.classList.contains('info-icon')) return;

                methodSelection.style.display = 'none';
                totpSetup.style.display = 'block';

                try {
                    const resp = await fetch('/account/2fa/generate-totp', { method: 'POST' });
                    const data = await resp.json();
                    
                    if (data.success) {
                        document.getElementById('qr-img').src = data.qrCodeUrl;
                        document.getElementById('manual-code').textContent = data.manualCode;
                        setTimeout(() => document.getElementById('totp-token-input')?.focus(), 300);
                    } else {
                        alert(data.error || "Failed to generate QR code. Please try again.");
                        methodSelection.style.display = 'block';
                        totpSetup.style.display = 'none';
                    }
                } catch (err) {
                    console.error("TOTP fetch error:", err);
                    alert("Network error while generating QR code. Please try again.");
                    methodSelection.style.display = 'block';
                    totpSetup.style.display = 'none';
                }
            });
        });

        document.getElementById('btn-cancel-totp')?.addEventListener('click', () => {
            totpSetup.style.display = 'none';
            methodSelection.style.display = 'block';
        });

        // Copy Manual Key Helper
        const copyBtn = document.getElementById('copy-code-btn');
        if (copyBtn) {
            copyBtn.addEventListener('click', async () => {
                const codeToCopy = document.getElementById('manual-code').textContent;
                try {
                    await navigator.clipboard.writeText(codeToCopy);
                    copyBtn.innerHTML = '<i class="fas fa-check" style="color: var(--green);"></i>';
                    setTimeout(() => {
                        copyBtn.innerHTML = '<i class="far fa-copy"></i>';
                    }, 2000);
                } catch (err) {
                    console.error('Failed to copy text: ', err);
                    prompt("Copy your setup key:", codeToCopy);
                }
            });
        }

        // --- 4. Accurate Device Error Popup Helper ---
        const deviceErrorModal = document.getElementById('device-error-modal');
        const deviceErrorCloseBtn = document.getElementById('device-error-close-btn');
        const deviceErrorRetryBtn = document.getElementById('device-error-retry-btn');
        const toggleTechDetails = document.getElementById('toggle-tech-details');
        const deviceErrorTech = document.getElementById('device-error-tech');

        function showDeviceErrorPopup(error) {
            if (!deviceErrorModal) {
                alert(error.message || String(error));
                return;
            }

            const titleEl = document.getElementById('device-error-title');
            const descEl = document.getElementById('device-error-desc');
            const tipsList = document.getElementById('device-error-tips');

            const errName = error.name || '';
            const errMsg = error.message || String(error);
            if (deviceErrorTech) {
                deviceErrorTech.textContent = `[${errName || 'Error'}] ${errMsg}`;
                deviceErrorTech.style.display = 'none';
            }

            let title = 'Device Authentication Issue';
            let desc = 'Your device encountered a problem during biometric passkey verification.';
            let tips = [];

            if (errName === 'NotAllowedError' || errMsg.toLowerCase().includes('not allowed') || errMsg.toLowerCase().includes('timed out') || errMsg.toLowerCase().includes('cancelled') || errMsg.toLowerCase().includes('canceled')) {
                title = 'Biometric Verification Cancelled / Timed Out';
                desc = 'The biometric prompt was closed or timed out before completion on your device.';
                tips = [
                    'Ensure your screen is unlocked and prompt notifications are not blocked by Focus or Do Not Disturb.',
                    'Respond promptly when the Windows Hello (PIN/Fingerprint), TouchID, or FaceID dialog appears.',
                    'Check your browser permissions to ensure "Security keys & biometrics" access is allowed for this site.',
                    'If using a physical YubiKey / USB key, make sure it is inserted firmly and tapped when illuminated.'
                ];
            } else if (errName === 'NotSupportedError' || errMsg.toLowerCase().includes('not supported') || errMsg.toLowerCase().includes('missing')) {
                title = 'Device Biometrics Not Supported';
                desc = 'Your current browser or device operating system does not have hardware support for WebAuthn passkeys.';
                tips = [
                    'Try accessing GPL Mods using Google Chrome, Microsoft Edge, Safari, or Brave with platform biometrics enabled.',
                    'On Windows: Open Windows Settings > Accounts > Sign-in options and make sure Windows Hello (PIN/Fingerprint) is set up.',
                    'On macOS/iOS: Ensure Touch ID or Face ID is enabled for browser autofill & passkeys in System Settings.',
                    'Alternatively, switch to the Authenticator App (TOTP) method which works on every phone and browser.'
                ];
            } else if (errName === 'InvalidStateError' || errMsg.toLowerCase().includes('already registered')) {
                title = 'Passkey Already Linked';
                desc = 'This device or security key has already been registered for your account.';
                tips = [
                    'Your device already holds a valid biometric passkey for GPL Mods.',
                    'You can proceed directly to login using this device.'
                ];
            } else if (errName === 'SecurityError' || errMsg.toLowerCase().includes('insecure') || errMsg.toLowerCase().includes('origin')) {
                title = 'Secure Context Required';
                desc = 'WebAuthn hardware cryptography is only permitted over HTTPS or localhost.';
                tips = [
                    'Ensure your URL starts with https://.',
                    'Disable any aggressive privacy extensions that may be intercepting navigator.credentials calls.'
                ];
            } else if (errMsg.toLowerCase().includes('server') || errMsg.toLowerCase().includes('verify') || errMsg.toLowerCase().includes('failed to save')) {
                title = 'Server Verification Failed';
                desc = errMsg || 'The server could not validate the cryptographic signature returned by your device.';
                tips = [
                    'Verify that your device date and time are synchronized automatically with network time.',
                    'Check your internet connection and try again.'
                ];
            } else {
                title = 'Device Verification Notice';
                desc = errMsg || 'An unexpected response was received from your device authenticator.';
                tips = [
                    'Restart your browser and ensure your device operating system has the latest updates.',
                    'You can always use the Authenticator App (TOTP) option as a reliable alternative.'
                ];
            }

            titleEl.textContent = title;
            descEl.textContent = desc;
            tipsList.innerHTML = tips.map(t => `<li style="margin-bottom: 6px;">${t}</li>`).join('');

            deviceErrorModal.style.display = 'flex';
        }

        if (deviceErrorCloseBtn && deviceErrorModal) {
            deviceErrorCloseBtn.addEventListener('click', () => {
                deviceErrorModal.style.display = 'none';
            });
            deviceErrorModal.addEventListener('click', (e) => {
                if (e.target === deviceErrorModal) deviceErrorModal.style.display = 'none';
            });
        }

        if (toggleTechDetails && deviceErrorTech) {
            toggleTechDetails.addEventListener('click', () => {
                deviceErrorTech.style.display = deviceErrorTech.style.display === 'none' ? 'block' : 'none';
            });
        }

        // --- 5. Passkey (WebAuthn) Setup Trigger ---
        async function runPasskeyRegistration() {
            if (deviceErrorModal) deviceErrorModal.style.display = 'none';

            if (typeof SimpleWebAuthnBrowser === 'undefined') {
                showDeviceErrorPopup(new Error("Passkey browser library is still loading. Please check your internet connection and try again."));
                return;
            }

            const { startRegistration } = SimpleWebAuthnBrowser;
            try {
                const resp = await fetch('/account/2fa/passkey/generate-options');
                if (!resp.ok) {
                    const errData = await resp.json().catch(() => ({}));
                    throw new Error(errData.error || "Passkey route failed to initialize.");
                }
                
                const options = await resp.json();
                const attResp = await startRegistration(options);
                
                const verificationResp = await fetch('/account/2fa/passkey/verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(attResp),
                });
                
                const verification = await verificationResp.json();
                if (verification.success) {
                    window.location.href = verification.redirect || '/id-card?success=Passkey verified! Your ID Card is active.';
                } else {
                    showDeviceErrorPopup(new Error(verification.error || "Failed to save passkey on server."));
                }
            } catch (error) {
                console.error("Passkey Error:", error);
                showDeviceErrorPopup(error);
            }
        }

        if (deviceErrorRetryBtn) {
            deviceErrorRetryBtn.addEventListener('click', () => {
                runPasskeyRegistration();
            });
        }

        const setupPasskeyTriggers = [document.getElementById('card-passkey'), document.getElementById('btn-setup-passkey'), document.getElementById('btn-setup-passkey-p')];
        setupPasskeyTriggers.forEach(el => {
            if(!el) return;
            el.addEventListener('click', (e) => {
                if (e.target.classList.contains('info-icon')) return;
                runPasskeyRegistration();
            });
        });
    });
</script>
