<%- include('../partials/header') %>

<main class="container" style="padding: 50px 20px 70px;">
    <header style="max-width: 760px; margin: 0 auto 35px; text-align: center;">
        <h1 style="color: var(--gold); margin-bottom: 12px;">Software Licenses</h1>
        <p style="color: var(--silver);">Browse the licenses attached to GPL Mods releases.</p>
    </header>

    <% if (licenses.length) { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px;">
            <% licenses.forEach(license => { %>
                <article style="padding: 22px; background: var(--dark-gray); border: 1px solid #333; border-radius: 8px;">
                    <h2 style="color: var(--white); font-size: 1.2rem; margin-bottom: 10px;"><%= license.name %></h2>
                    <p style="color: var(--silver); min-height: 44px; line-height: 1.5;"><%= license.shortDescription || 'License details available in the reader.' %></p>
                    <a href="/licenses/<%= license.slug %>" class="btn btn-primary" style="display: inline-block; margin-top: 14px;">Read License</a>
                </article>
            <% }) %>
        </div>
    <% } else { %>
        <p style="color: var(--silver); text-align: center;">No licenses have been published yet.</p>
    <% } %>
</main>

<%- include('../partials/footer') %>
