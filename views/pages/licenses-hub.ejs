<%-include('../partials/header') %>

    <style>
        .license-card {
            background: linear-gradient(145deg, #16171f 0%, #0e0f14 100%);
            border: 1px solid rgba(255, 215, 0, 0.2);
            border-top: 3px solid var(--gold);
            border-radius: 14px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        }

        .license-card:hover {
            transform: translateY(-4px);
            border-color: var(--gold);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6), 0 0 16px rgba(255, 215, 0, 0.15);
        }

        .license-type-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 215, 0, 0.1);
            border: 1px solid rgba(255, 215, 0, 0.28);
            color: var(--gold);
            font-size: 0.72rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
            width: fit-content;
        }

        .license-card h2 {
            color: var(--white);
            font-size: 1.25rem;
            font-weight: 700;
            margin: 0 0 10px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .license-card p {
            color: var(--silver);
            font-size: 0.9rem;
            line-height: 1.6;
            margin: 0 0 18px 0;
            flex-grow: 1;
        }

        .license-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.88rem;
            text-decoration: none;
            background: var(--gold);
            color: var(--black);
            border: 1px solid var(--gold);
            cursor: pointer;
            transition: all 0.25s ease;
            box-shadow: 0 4px 14px rgba(255, 215, 0, 0.25);
            width: 100%;
            box-sizing: border-box;
        }

        .license-btn:hover {
            background-color: #ffea70;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 215, 0, 0.4);
            color: #000;
        }
    </style>

    <main class="container" style="padding: 50px 20px 70px; max-width: 1100px; margin: 0 auto;">
        <%- include('../partials/go-back-button', { fallback: '/' }) %>
        <header style="max-width: 760px; margin: 0 auto 35px; text-align: center;">
            <div style="display: inline-flex; align-items: center; gap: 6px; background: rgba(255, 215, 0, 0.1); border: 1px solid rgba(255, 215, 0, 0.25); color: var(--gold); font-size: 0.8rem; font-weight: 700; padding: 4px 12px; border-radius: 14px; text-transform: uppercase; margin-bottom: 12px;">
                <i class="fas fa-scale-balanced"></i> Legal &amp; Licensing Directory
            </div>
            <h1 style="color: var(--white); margin: 0 0 12px 0; font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 800;">
                <span class="logo-gold-glow">Software</span> <span class="logo-silver-glow">Licenses</span>
            </h1>
            <p style="color: var(--silver); font-size: 0.98rem; margin: 0; line-height: 1.6;">Browse official open-source licenses, legal DMCA protection frameworks, and compliance policies across GPL Mods applications, plugins, and repository tweaks.</p>
        </header>

        <!-- ======== DMCA & LICENSING COMPREHENSIVE GUIDE ======== -->
        <section style="background: linear-gradient(145deg, rgba(24, 24, 32, 0.95) 0%, rgba(14, 15, 20, 0.95) 100%); border: 1px solid rgba(255, 215, 0, 0.28); border-top: 4px solid var(--gold); border-radius: 16px; padding: 28px 24px; margin-bottom: 40px; box-shadow: 0 12px 35px rgba(0,0,0,0.5);">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
                <div style="width: 42px; height: 42px; border-radius: 50%; background: rgba(255, 215, 0, 0.15); display: flex; align-items: center; justify-content: center; color: var(--gold); font-size: 1.3rem;">
                    <i class="fas fa-shield-halved"></i>
                </div>
                <div>
                    <h2 style="color: var(--white); font-size: 1.35rem; margin: 0; font-weight: 700;">DMCA Protection &amp; License Selection Policy</h2>
                    <span style="color: var(--gold); font-size: 0.82rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Essential Uploader &amp; Distributor Guidelines</span>
                </div>
            </div>

            <p style="color: var(--silver); font-size: 0.92rem; line-height: 1.65; margin: 0 0 20px 0;">
                Attaching a recognized software license to every upload is the fundamental legal shield safeguarding both mod developers and the GPL Mods platform. Under international copyright treaties and the United States Digital Millennium Copyright Act (DMCA), explicit licensing establishes verifiable distribution rights, prevents improper takedowns, and enables instant counter-notification defense.
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 22px;">
                <!-- Card 1: OCOM -->
                <div style="background: rgba(0, 0, 0, 0.45); border: 1px solid rgba(255, 215, 0, 0.2); border-radius: 12px; padding: 18px;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                        <i class="fas fa-shield-alt" style="color: #4caf50; font-size: 1.15rem;"></i>
                        <strong style="color: var(--white); font-size: 1.05rem;">1. OCOM License</strong>
                    </div>
                    <span style="display: inline-block; font-size: 0.72rem; padding: 2px 8px; border-radius: 8px; background: rgba(76, 175, 80, 0.15); color: #81c784; font-weight: 700; margin-bottom: 8px;">Recommended for General Mods</span>
                    <p style="color: #bbb; font-size: 0.84rem; line-height: 1.55; margin: 0;">
                        The Official GPL Mods Community license tailored for Android APKs, iOS IPAs, and Windows modded utilities. Enforces modder attribution, guarantees free access without commercial paywalls, and serves as standard DMCA shield.
                    </p>
                </div>

                <!-- Card 2: Developer OSS -->
                <div style="background: rgba(0, 0, 0, 0.45); border: 1px solid rgba(171, 71, 188, 0.2); border-radius: 12px; padding: 18px;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                        <i class="fas fa-code-branch" style="color: #ab47bc; font-size: 1.15rem;"></i>
                        <strong style="color: var(--white); font-size: 1.05rem;">2. Developer OSS Match</strong>
                    </div>
                    <span style="display: inline-block; font-size: 0.72rem; padding: 2px 8px; border-radius: 8px; background: rgba(171, 71, 188, 0.15); color: #ce93d8; font-weight: 700; margin-bottom: 8px;">Upstream Open-Source Projects</span>
                    <p style="color: #bbb; font-size: 0.84rem; line-height: 1.55; margin: 0;">
                        When compiling or modding open-source projects (e.g. F-Droid tools, emulator frontends), you must preserve and match the original developer's license (Apache 2.0, MIT, AGPLv3, BSD) to guarantee copyleft compliance.
                    </p>
                </div>

                <!-- Card 3: WordPress GPL -->
                <div style="background: rgba(0, 0, 0, 0.45); border: 1px solid rgba(33, 150, 243, 0.2); border-radius: 12px; padding: 18px;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                        <i class="fab fa-wordpress" style="color: #2196f3; font-size: 1.15rem;"></i>
                        <strong style="color: var(--white); font-size: 1.05rem;">3. WordPress GNU GPL</strong>
                    </div>
                    <span style="display: inline-block; font-size: 0.72rem; padding: 2px 8px; border-radius: 8px; background: rgba(33, 150, 243, 0.15); color: #90caf9; font-weight: 700; margin-bottom: 8px;">WordPress Plugins &amp; Themes</span>
                    <p style="color: #bbb; font-size: 0.84rem; line-height: 1.55; margin: 0;">
                        All WordPress themes and plugins are derivative works of WordPress core and are governed by GNU GPLv2/v3. This grants 100% legal freedom to distribute, study, and modify the software without proprietary licensing locks.
                    </p>
                </div>

                <!-- Card 4: Jailbreak Tweaks -->
                <div style="background: rgba(0, 0, 0, 0.45); border: 1px solid rgba(255, 152, 0, 0.2); border-radius: 12px; padding: 18px;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                        <i class="fas fa-apple-whole" style="color: #ff9800; font-size: 1.15rem;"></i>
                        <strong style="color: var(--white); font-size: 1.05rem;">4. Jailbreak (MIT / BSD)</strong>
                    </div>
                    <span style="display: inline-block; font-size: 0.72rem; padding: 2px 8px; border-radius: 8px; background: rgba(255, 152, 0, 0.15); color: #ffcc80; font-weight: 700; margin-bottom: 8px;">Cydia, Sileo &amp; Zebra Tweaks</span>
                    <p style="color: #bbb; font-size: 0.84rem; line-height: 1.55; margin: 0;">
                        Permissive MIT or 3-Clause BSD licenses are standard for iOS jailbreak tweaks and hook libraries (.deb packages), maximizing developer interoperability and ensuring end users are granted uninhibited debugging rights.
                    </p>
                </div>
            </div>

            <!-- Anti-Takedown Checklist -->
            <div style="background: rgba(255, 215, 0, 0.04); border-left: 3px solid var(--gold); padding: 12px 16px; border-radius: 0 8px 8px 0; font-size: 0.85rem; color: var(--silver); line-height: 1.55;">
                <strong style="color: var(--gold);"><i class="fas fa-check-double"></i> Anti-Takedown Verification Checklist:</strong>
                Always verify that your mod upload does not infringe trademarked branding inappropriately, includes correct developer credits, links to valid VirusTotal scan evidence, and adopts one of the four licenses above.
            </div>
        </section>
        <!-- ======================================================= -->

        <% if (licenses.length) { %>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 22px;">
                <% licenses.forEach(license => { %>
                    <article class="license-card">
                        <div>
                            <span class="license-type-badge"><i class="fas fa-certificate"></i> Free Software / GPL</span>
                            <h2><i class="fas fa-file-contract" style="color: var(--gold); font-size: 0.95em;"></i> <%= license.name %></h2>
                            <p><%= license.shortDescription || 'Full legal permissions, terms, conditions, and copyleft requirements.' %></p>
                        </div>
                        <a href="/licenses/<%= license.slug %>" class="license-btn">
                            <span>Read License Document</span> <i class="fas fa-arrow-right" style="font-size: 0.85em;"></i>
                        </a>
                    </article>
                <% }) %>
            </div>
        <% } else { %>
            <div style="text-align: center; padding: 50px 20px; background: rgba(0,0,0,0.3); border-radius: 14px; border: 1px dashed rgba(255,255,255,0.15);">
                <i class="fas fa-book-open" style="font-size: 2.5rem; color: #555; margin-bottom: 14px;"></i>
                <p style="color: var(--silver); margin: 0; font-size: 1rem;">No licenses have been published yet.</p>
            </div>
        <% } %>
    </main>
    <%- include('../partials/video-ad-modal') %>
        <%- include('../partials/footer') %>