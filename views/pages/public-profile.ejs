US|United States
UY|Uruguay
UZ|Uzbekistan
VU|Vanuatu
VE|Venezuela (Bolivarian Republic of)
VN|Viet Nam
VG|Virgin Islands (British)
VI|Virgin Islands (U.S.)
WF|Wallis and Futuna
EH|Western Sahara
YE|Yemen
ZM|Zambia
ZW|Zimbabwe
GLOBAL|Earth
                        `.trim().split('\n').map(line => {
                            const [code, name] = line.split('|');
                            return { code: code.trim(), name: name.trim() };
                        });
                        function emojiForCountry(code) {
                            if (!code || code.length !== 2) return '';
                            return String.fromCodePoint(...code.toUpperCase().split('').map(c => 0x1F1E6 + c.charCodeAt(0) - 65));
                        }
                        const selectedCountry = countries.find(c => c.code === profileUser.country);
                        const countryName = selectedCountry ? selectedCountry.name : profileUser.country;
                        const flagEmoji = profileUser.country === 'GLOBAL' ? '🌍' : (selectedCountry ? emojiForCountry(profileUser.country) : '🌍');
                    %>
                    <div class="stat-item">
                        <div class="stat-number" style="font-size: 1.5em;"><%= flagEmoji %></div>
                        <div class="stat-label">Location:<%= countryName %></div>
                    </div>
                <% } %>

                <div class="stat-item">
                    <div class="stat-number"><%= timeAgo(profileUser.lastSeen) %></div>
                    <div class="stat-label">Last Online</div>
                </div>
            </div>
        </header>

        <section class="profile-content">
            <div class="tabs-nav">
                <button class="tab-button active" data-tab="overview">Overview</button>
                <button class="tab-button" data-tab="uploads">Uploads</button>
                <button class="tab-button" data-tab="community">Community</button>
            </div>

            <!-- Bio Tab -->
            <div id="overview" class="tab-content active">
                <h2>About Me</h2>
                <% if (profileUser.bio) { %>
                    <p>"<%- profileUser.bio.replace(/\n/g, '<br>') %>"</p>
                <% } else { %>
                    <p>This user hasn't written a bio yet. They are a valued member of the GPL Mods community.</p>
                <% } %>
            </div>

            <!-- Uploads Tab -->
            <div id="uploads" class="tab-content">
                <h2 style="border-bottom: 1px solid #333; padding-bottom: 10px; margin-bottom: 20px;">Uploaded Mods</h2>
                <% if (uploads && uploads.length > 0) { %>
                    <section class="mod-grid">
                        <% uploads.forEach(file => { %>
                            <%- include('../partials/mod-card', { file: file, showUploaderInfo: false }) %>
                        <% }) %>
                    </section>
                <% } else { %>
                    <p style="color: var(--silver);"><%= profileUser.username %> hasn't uploaded any mods yet.</p>
                <% } %>
            </div>

            <!-- Community Tab (Followers/Following) -->
            <div id="community" class="tab-content">
                <div style="display: flex; flex-wrap: wrap; gap: 40px;">
                    
                    <!-- Followers List -->
                    <div style="flex: 1; min-width: 250px;">
                        <h2 style="border-bottom: 1px solid #333; padding-bottom: 10px;">Followers (<%= followersList.length %>)</h2>
                        <% if (followersList && followersList.length > 0) { %>
                            <ul style="list-style: none; padding: 0;">
                                <% followersList.forEach(follower => { %>
                                    <li style="margin-bottom: 15px;">
                                        <a href="/users/<%= slugify(follower.username) %>" style="display: flex; align-items: center; gap: 15px; text-decoration: none; color: var(--white); background: var(--dark-gray); padding: 10px; border-radius: 8px; border: 1px solid #333; transition: border-color 0.2s;">
                                            <img src="<%= follower.signedAvatarUrl %>" alt="Avatar" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
                                            <div>
                                                <strong style="display: block;"><%= follower.username %></strong>
                                                <span style="font-size: 0.8em; color: var(--silver);"><%= follower.role %></span>
                                            </div>
                                        </a>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } else { %>
                            <p style="color: var(--silver);">No followers yet.</p>
                        <% } %>
                    </div>

                    <!-- Following List -->
                    <div style="flex: 1; min-width: 250px;">
                        <h2 style="border-bottom: 1px solid #333; padding-bottom: 10px;">Following (<%= followingList.length %>)</h2>
                        <% if (followingList && followingList.length > 0) { %>
                            <ul style="list-style: none; padding: 0;">
                                <% followingList.forEach(followingUser => { %>
                                    <li style="margin-bottom: 15px;">
                                        <a href="/users/<%= slugify(followingUser.username) %>" style="display: flex; align-items: center; gap: 15px; text-decoration: none; color: var(--white); background: var(--dark-gray); padding: 10px; border-radius: 8px; border: 1px solid #333; transition: border-color 0.2s;">
                                            <img src="<%= followingUser.signedAvatarUrl %>" alt="Avatar" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
                                            <div>
                                                <strong style="display: block;"><%= followingUser.username %></strong>
                                                <span style="font-size: 0.8em; color: var(--silver);"><%= followingUser.role %></span>
                                            </div>
                                        </a>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } else { %>
                            <p style="color: var(--silver);">Not following anyone yet.</p>
                        <% } %>
                    </div>

                </div>
            </div>
        </section> 
    </div>
</main>

<script>
    // Tab Functionality
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabContents = document.querySelectorAll('.tab-content');

    tabButtons.forEach(button => {
        button.addEventListener('click', () => {
            const targetTabId = button.getAttribute('data-tab');
            tabButtons.forEach(btn => btn.classList.remove('active'));
            tabContents.forEach(content => content.classList.remove('active'));
            button.classList.add('active');
            document.getElementById(targetTabId).classList.add('active');
        });
    });

    // Interactive Lottie Badge Click Modal
    function showBadgeDetails(el) {
        const title = el.getAttribute('data-badge-title') || 'Profile Badge';
        const desc = el.getAttribute('data-badge-desc') || '';
        const anim = el.getAttribute('data-badge-anim') || '';
        const color = el.getAttribute('data-badge-color') || 'var(--gold)';

        const existing = document.getElementById('lottie-badge-modal');
        if (existing) existing.remove();

        const modalHtml = `
            <div id="lottie-badge-modal" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); z-index: 100000; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(10px); padding: 20px; animation: cardFadeIn 0.25s ease-out;">
                <div style="background: rgba(22, 22, 24, 0.96); border: 1.5px solid ${color}; border-radius: 20px; padding: 32px 28px; max-width: 420px; width: 100%; text-align: center; box-shadow: 0 15px 45px rgba(0,0,0,0.8), 0 0 30px ${color}33; position: relative;">
                    <button onclick="document.getElementById('lottie-badge-modal').remove()" style="position: absolute; top: 14px; right: 16px; background: transparent; border: none; color: var(--silver); font-size: 1.4em; cursor: pointer; line-height: 1;">&times;</button>
                    
                    <div style="display: flex; justify-content: center; margin-bottom: 15px;">
                        <lottie-player src="${anim}" background="transparent" speed="1" style="width: 100px; height: 100px; filter: drop-shadow(0 0 15px ${color});" loop autoplay></lottie-player>
                    </div>

                    <h3 style="color: var(--white); font-size: 1.35em; font-weight: 700; margin: 0 0 8px 0; letter-spacing: 0.5px;">${title}</h3>
                    <p style="color: var(--silver); font-size: 0.95em; line-height: 1.5; margin: 0 0 24px 0;">${desc}</p>
                    
                    <button onclick="document.getElementById('lottie-badge-modal').remove()" class="btn btn-primary" style="background: ${color}; color: #111; border: none; font-weight: 700; padding: 10px 30px; border-radius: 25px; cursor: pointer; transition: transform 0.2s;">
                        Got It
                    </button>
                </div>
            </div>
        `;
        document.body.insertAdjacentHTML('beforeend', modalHtml);

        const modal = document.getElementById('lottie-badge-modal');
        if (modal) {
            modal.addEventListener('click', (e) => {
                if (e.target.id === 'lottie-badge-modal') {
                    e.target.remove();
                }
            });
        }
    }

    // Share Profile Function - UPDATED TO USE NETLIFY GATEWAY
    function shareProfile() {
        // 1. Get the path the user is currently on (e.g., "/users/Admin")
        const currentPath = window.location.pathname;
        
        // 2. Build the Gateway URL! 
        // We combine the Netlify URL with the "?dest=" parameter
        const gatewayShareUrl = `https://gplmods.mytunnel.org/?dest=${currentPath}`;

        if (navigator.share) {
            navigator.share({
                title: '<%= profileUser.username %>\'s Profile on GPL Mods',
                text: 'Check out <%= profileUser.username %> on GPL Mods!',
                url: gatewayShareUrl // <-- Using the Gateway URL here
            }).then(() => console.log('Successful share'))
            .catch((error) => console.log('Error sharing', error));
        } else {
            alert("Profile link copied to clipboard:\n\n" + gatewayShareUrl);
            navigator.clipboard.writeText(gatewayShareUrl);
        }
    }
</script>

<% if (profileUser.cardId || profileUser.cardMessage) { %>
    <!-- Hidden element holding the user's custom message -->
    <div id="card-message-data" data-msg="<%= profileUser.cardMessage || 'Welcome to my profile! Follow me for the best mods.' %>" style="display:none;"></div>
<% } %>

<style>
    @keyframes cardFadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // --- ID CARD QR SCAN POPUP ---
        const urlParams = new URLSearchParams(window.location.search);
        const cardData = document.getElementById('card-message-data');

        if (urlParams.get('ref') === 'card' && cardData) {
            const customMessage = cardData.getAttribute('data-msg') || 'Welcome to my profile!';
            
            // Create a gorgeous full-screen overlay popup
            const popupHtml = `
                <div id="card-welcome-popup" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.92); z-index: 100000; display: flex; flex-direction: column; align-items: center; justify-content: center; backdrop-filter: blur(12px); padding: 20px;">
                    <div style="max-width: 500px; width: 100%; text-align: center; animation: cardFadeIn 0.4s ease-out; background: rgba(20,20,20,0.9); border: 1px solid rgba(255,215,0,0.3); border-radius: 20px; padding: 40px 30px; box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 30px rgba(255,215,0,0.15);">
                        <lottie-player src="<%= cdnUrl %>/animations/verified.json" background="transparent" speed="1" style="width: 150px; height: 150px; margin: 0 auto; filter: drop-shadow(0 0 25px var(--glow-gold));" autoplay></lottie-player>
                        
                        <h2 style="color: var(--white); font-size: 1.8em; margin: 15px 0 10px 0; font-weight: 700;">Verified Credential Scanned</h2>
                        <span style="display: inline-block; background: rgba(255,215,0,0.15); color: var(--gold); border: 1px solid var(--gold); padding: 4px 14px; border-radius: 20px; font-size: 0.8em; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 15px;">
                            <%= profileUser.role %>
                        </span>
                        
                        <p style="color: var(--silver); font-size: 1.1em; line-height: 1.6; margin: 15px 0 25px 0; font-style: italic;">
                            "${customMessage}"
                        </p>
                        
                        <button onclick="document.getElementById('card-welcome-popup').remove()" class="btn btn-primary" style="padding: 12px 35px; font-size: 1.05em; font-weight: bold; border-radius: 8px; background: var(--gold); color: var(--black); border: none; cursor: pointer; transition: transform 0.2s;">
                            View Profile
                        </button>
                    </div>
                </div>
            `;
            
            document.body.insertAdjacentHTML('beforeend', popupHtml);
            
            // Auto close after 8 seconds
            setTimeout(() => {
                const p = document.getElementById('card-welcome-popup');
                if (p) p.remove();
            }, 8000);
        }
    });
</script>

