<%-include('../partials/header') %>
<style>
    /* ======== LOTTIE BADGES & TOOLTIPS ======== */
    .lottie-badge-pill {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.78em;
        font-weight: 600;
        vertical-align: middle;
        cursor: pointer;
        transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.2s ease;
    }
    .lottie-badge-pill:hover {
        transform: translateY(-2px) scale(1.05);
    }
    .lottie-badge-pill lottie-player {
        width: 20px !important;
        height: 20px !important;
        flex-shrink: 0;
        display: inline-block;
        vertical-align: middle;
    }
    .lottie-badge-pill .badge-tooltip {
        visibility: hidden;
        opacity: 0;
        width: 220px;
        max-width: 80vw;
        background: rgba(18, 18, 18, 0.96);
        backdrop-filter: blur(10px);
        color: var(--white);
        text-align: center;
        border-radius: 10px;
        padding: 9px 14px;
        border: 1px solid var(--gold);
        font-size: 0.8em;
        position: absolute;
        z-index: 200;
        bottom: 130%;
        left: 50%;
        transform: translateX(-50%);
        transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.25s ease;
        box-shadow: 0 10px 30px rgba(0,0,0,0.85);
        pointer-events: none;
    }
    .lottie-badge-pill:hover .badge-tooltip,
    .lottie-badge-pill.active .badge-tooltip {
        visibility: visible;
        opacity: 1;
        transform: translateX(-50%) translateY(-4px);
    }
    .lottie-badge-pill .badge-tooltip strong {
        display: block;
        color: var(--gold);
        font-size: 1.05em;
        margin-bottom: 3px;
        font-weight: 700;
    }
    .lottie-badge-pill .badge-tooltip span {
        display: block;
        color: var(--silver);
        font-size: 0.92em;
        line-height: 1.35;
    }
    .lottie-badge-pill .badge-tooltip::after {
        content: "";
        position: absolute;
        top: 100%;
        left: 50%;
        margin-left: -6px;
        border-width: 6px;
        border-style: solid;
        border-color: rgba(18, 18, 18, 0.96) transparent transparent transparent;
    }
    .profile-header lottie-player {
        max-width: 80px;
        max-height: 80px;
    }

    /* ======== ROLE-BASED PROFILE THEMES (CRISP CYBER-METALLIC) ======== */
    .user-role-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 14px;
        border-radius: 24px;
        font-weight: 700;
        font-size: 0.76em;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        transition: all 0.25s ease;
        border: 1px solid transparent;
        box-shadow: inset 0 1px 1.5px rgba(255, 255, 255, 0.15), 0 2px 6px rgba(0, 0, 0, 0.5);
        vertical-align: middle;
    }
    .user-role-badge:hover {
        transform: translateY(-1px);
        filter: brightness(1.1);
    }

    .role-theme-owner {
        color: #ff5252 !important;
        border-color: rgba(244, 67, 54, 0.6) !important;
        background: linear-gradient(135deg, rgba(244, 67, 54, 0.2), rgba(183, 28, 28, 0.15)) !important;
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.18), 0 2px 6px rgba(0, 0, 0, 0.5), 0 0 6px rgba(244, 67, 54, 0.25) !important;
    }
    .role-theme-admin {
        color: var(--gold) !important;
        border-color: rgba(255, 215, 0, 0.6) !important;
        background: linear-gradient(135deg, rgba(255, 215, 0, 0.18), rgba(180, 140, 0, 0.12)) !important;
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.18), 0 2px 6px rgba(0, 0, 0, 0.5), 0 0 6px rgba(255, 215, 0, 0.25) !important;
    }
    .role-theme-support {
        color: #38bdf8 !important;
        border-color: rgba(56, 189, 248, 0.6) !important;
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.18), rgba(14, 116, 144, 0.15)) !important;
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.18), 0 2px 6px rgba(0, 0, 0, 0.5), 0 0 6px rgba(56, 189, 248, 0.25) !important;
    }
    .role-theme-distributor {
        color: #ce93d8 !important;
        border-color: rgba(186, 104, 200, 0.6) !important;
        background: linear-gradient(135deg, rgba(186, 104, 200, 0.18), rgba(123, 31, 162, 0.15)) !important;
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.18), 0 2px 6px rgba(0, 0, 0, 0.5), 0 0 6px rgba(186, 104, 200, 0.25) !important;
    }
    .role-theme-member {
        color: var(--silver) !important;
        border-color: rgba(192, 192, 192, 0.35) !important;
        background: rgba(255, 255, 255, 0.06) !important;
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1), 0 2px 6px rgba(0, 0, 0, 0.4) !important;
    }

    /* Social Links Hover Effect */
    .profile-social-links a {
        transition: transform 0.3s ease, filter 0.3s ease;
        display: inline-block;
    }
    .profile-social-links a:hover {
        transform: translateY(-3px) scale(1.1);
        filter: brightness(1.2);
    }
</style>
<title><%= profileUser.username %> - GPL Mods</title>

<main>
    <div class="container">
        
        <!-- ✅ NEW: Dynamic Back Button -->
        <div class="back-btn-wrapper" style="margin-bottom: 20px;">
            <a href="javascript:history.back()" class="dynamic-back-btn">
                <i class="fas fa-arrow-left"></i> Go Back
            </a>
        </div>

        <% if (typeof isCardRef !== 'undefined' && isCardRef) { %>
            <% const isCardSuspended = profileUser.cardStatus === 'suspended' || (!profileUser.twoFactorEnabled && !profileUser.is2FAEnabled); %>
            <% if (isCardSuspended) { %>
                <div style="background: rgba(229, 57, 53, 0.15); border: 2px solid var(--red); border-radius: 12px; padding: 14px 20px; margin-bottom: 25px; text-align: center; color: #ff8585;">
                    <div style="font-weight: bold; font-size: 1.05em; margin-bottom: 4px;">
                        <i class="fas fa-exclamation-triangle" style="color: var(--red); margin-right: 6px;"></i> Verified ID Card Suspended
                    </div>
                    <p style="margin: 0; font-size: 0.9em; color: var(--silver);">
                        This creator's ID card verification is currently <strong>suspended</strong> because 2-Factor Authentication was disabled.
                    </p>
                </div>
            <% } else { %>
                <div style="background: rgba(255, 215, 0, 0.1); border: 1px solid var(--gold); border-radius: 12px; padding: 14px 20px; margin-bottom: 25px; text-align: center; color: var(--gold);">
                    <div style="font-weight: bold; font-size: 1.05em; margin-bottom: 4px;">
                        <i class="fas fa-id-badge" style="margin-right: 6px;"></i> Official Verified Cardholder
                    </div>
                    <p style="margin: 0; font-size: 0.9em; color: var(--silver);">
                        <%= profileUser.cardMessage || 'Welcome to my official distributor page! Follow me for the best mods.' %>
                    </p>
                </div>
            <% } %>
        <% } %>

        <%
            // Resolve Role UI Theme & Defaults
            const roleThemeMap = {
                owner: { 
                    class: 'role-theme-owner', 
                    color: '#f44336', 
                    label: 'Owner & Founder', 
                    icon: 'fa-crown'
                },
                admin: { 
                    class: 'role-theme-admin', 
                    color: '#ffd700', 
                    label: 'Administrator', 
                    icon: 'fa-shield-alt'
                },
                support: { 
                    class: 'role-theme-support', 
                    color: '#00b0ff', 
                    label: 'Support Team', 
                    icon: 'fa-headset'
                },
                distributor: { 
                    class: 'role-theme-distributor', 
                    color: '#ba68c8', 
                    label: 'Licensed Mod Distributor', 
                    icon: 'fa-certificate'
                },
                member: { 
                    class: 'role-theme-member', 
                    color: '#c0c0c0', 
                    label: 'Member', 
                    icon: 'fa-user'
                }
            };
            const currentRoleTheme = roleThemeMap[profileUser.role] || roleThemeMap.member;

            // Collect unified profile badges (Card Verified badge + Admin-assigned Lottie badges)
            let unifiedBadges = [];

            // 1. Check Card Verified Badge (if card exists and showCardVerifiedBadge !== false)
            const showCard = (profileUser.showCardVerifiedBadge !== false) && profileUser.cardId;
            if (showCard) {
                const isCardSuspended = profileUser.cardStatus === 'suspended' || (!profileUser.twoFactorEnabled && !profileUser.is2FAEnabled);
                unifiedBadges.push({
                    type: 'card',
                    order: typeof profileUser.cardVerifiedBadgeOrder === 'number' ? profileUser.cardVerifiedBadgeOrder : 1,
                    isSuspended: isCardSuspended,
                    role: profileUser.role
                });
            }

            // 2. Collect Profile Lottie Badges (max 3)
            if (Array.isArray(profileUser.profileLottieBadges) && profileUser.profileLottieBadges.length > 0) {
                profileUser.profileLottieBadges.forEach((b, idx) => {
                    if (b) {
                        let anim = (b.animation === 'custom' && b.customAnimation) ? b.customAnimation : (b.animation || 'verified.json');
                        if (anim) {
                            unifiedBadges.push({
                                type: 'lottie',
                                order: typeof b.order === 'number' ? b.order : (idx + 2),
                                animation: anim,
                                title: b.title || 'Special Badge',
                                description: b.description || 'Verified GPL Mods Achievement',
                                color: b.color || currentRoleTheme.color || 'var(--gold)'
                            });
                        }
                    }
                });
            }

            // Sort all badges by order ascending
            unifiedBadges.sort((a, b) => (a.order || 0) - (b.order || 0));
        %>

        <header class="profile-header">
            <!-- Avatar with Dynamic Role & Rank Glow -->
            <div class="avatar-container <%= currentRoleTheme.class %>" style="position: relative; display: inline-block; margin-bottom: 5px;">
                <img src="<%= profileUser.signedAvatarUrl %>" 
                     alt="<%= profileUser.username %>'s Avatar" 
                     class="profile-avatar <%= currentRoleTheme.class %>"
                     style="border-color: <%= currentRoleTheme.color %>; 
                            box-shadow: 0 0 15px <%= currentRoleTheme.color %>40;
                            width: 150px; height: 150px; border-radius: 50%; border-width: 3px; border-style: solid; object-fit: cover;">

                <button class="share-btn" onclick="shareProfile()" title="Share Profile" style="position: absolute; bottom: 5px; right: 5px; background: var(--gold); border: none; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.3); transition: transform 0.2s; z-index: 10;">
                    <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; fill: var(--black);"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92z"/></svg>
                </button>
            </div>

            <!-- Rank Lottie Animation -->
            <% if (profileUser.forumRank && profileUser.forumRank.lottie) { %>
                <div style="display: flex; justify-content: center; align-items: center; margin-bottom: 5px;">
                    <lottie-player src="<%= cdnUrl %>/animations/<%= profileUser.forumRank.lottie %>" background="transparent" speed="1" style="width: 70px; height: 70px; filter: drop-shadow(0 0 8px <%= profileUser.forumRank.color %>);" loop autoplay></lottie-player>
                </div>
            <% } %>

            <!-- ======== USERNAME & ROLE BADGE ======== -->
            <div style="display: flex; justify-content: center; align-items: center; gap: 10px; margin-bottom: 8px; flex-wrap: wrap;">
                <h1 class="notranslate" style="margin: 0; font-weight: 700; font-size: 2em; letter-spacing: 0.5px;"><%= profileUser.username %></h1>
                <div class="user-role-badge <%= currentRoleTheme.class %>">
                    <i class="fas <%= currentRoleTheme.icon %>"></i>
                    <span><%= currentRoleTheme.label %></span>
                </div>
            </div>
            
            <!-- Rank & Points -->
            <p style="color: <%= profileUser.forumRank ? profileUser.forumRank.color : 'var(--silver)' %>; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; font-size: 0.85em; margin-bottom: 14px; text-shadow: 0 0 6px <%= profileUser.forumRank ? profileUser.forumRank.color : 'transparent' %>;">
                <%= profileUser.forumRank ? profileUser.forumRank.name : 'Novice' %> (<i class="fas fa-star" style="font-size: 0.9em;"></i> <%= profileUser.forumPoints || 0 %> pts)
            </p>

            <!-- ======== BADGES CONTAINER (DYNAMIC ORDERING & VERIFIED BADGES) ======== -->
            <% if (unifiedBadges.length > 0) { %>
                <div class="user-badges-container" style="margin-bottom: 18px; display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap;">
                    <% unifiedBadges.forEach(badge => { %>
                        <% if (badge.type === 'card') { %>
                            <% if (badge.isSuspended) { %>
                                <span style="display: inline-flex; align-items: center; gap: 6px; background: rgba(229,57,53,0.15); color: #ff6b6b; border: 1px solid var(--red); font-size: 0.78em; padding: 4px 12px; border-radius: 20px; font-weight: 600; vertical-align: middle;">
                                    <i class="fas fa-ban"></i> Card Suspended
                                </span>
                            <% } else { %>
                                <span class="user-card-verified-badge" style="display: inline-flex; align-items: center; gap: 6px; background: <%= badge.role === 'distributor' ? 'linear-gradient(135deg, rgba(186, 104, 200, 0.2), rgba(255, 215, 0, 0.15))' : 'rgba(255,215,0,0.15)' %>; color: <%= badge.role === 'distributor' ? '#ffd700' : 'var(--gold)' %>; border: 1px solid <%= badge.role === 'distributor' ? '#ba68c8' : 'var(--gold)' %>; font-size: 0.78em; padding: 4px 12px; border-radius: 20px; font-weight: 600; vertical-align: middle; box-shadow: 0 0 6px <%= badge.role === 'distributor' ? 'rgba(186, 104, 200, 0.3)' : 'rgba(255, 215, 0, 0.2)' %>;" title="<%= badge.role === 'distributor' ? 'Official Verified & Licensed Mod Distributor on GPL Mods' : 'Official Verified GPL Mods Cardholder' %>">
                                    <i class="fas fa-id-card" style="color: <%= badge.role === 'distributor' ? '#ba68c8' : 'var(--gold)' %>;"></i> 
                                    <%= badge.role === 'distributor' ? 'Verified License Distributor' : 'Card Verified' %>
                                </span>
                            <% } %>
                        <% } else if (badge.type === 'lottie') { 
                            const animSrc = badge.animation.startsWith('http') ? badge.animation : (cdnUrl + '/animations/' + badge.animation);
                        %>
                            <span class="lottie-badge-pill" 
                                  data-badge-title="<%= badge.title %>"
                                  data-badge-desc="<%= badge.description %>"
                                  data-badge-anim="<%= animSrc %>"
                                  data-badge-color="<%= badge.color %>"
                                  onclick="showBadgeDetails(this)"
                                  title="<%= badge.description %>"
                                  style="background: <%= badge.color %>18; border: 1px solid <%= badge.color %>; color: <%= badge.color %>; box-shadow: 0 0 6px <%= badge.color %>25;">
                                <lottie-player src="<%= animSrc %>" background="transparent" speed="1" loop autoplay></lottie-player>
                                <span><%= badge.title %></span>
                                <div class="badge-tooltip">
                                    <strong><%= badge.title %></strong>
                                    <span><%= badge.description %></span>
                                </div>
                            </span>
                        <% } %>
                    <% }); %>
                </div>
            <% } %>
            
            <!-- ✅ NEW: SOCIAL LINKS MOVED TO HEADER -->
            <% if (profileUser.role === 'admin' || profileUser.role === 'distributor') { %>
                <div class="profile-social-links" style="display: flex; justify-content: center; gap: 20px; font-size: 1.8em; margin-bottom: 25px;">
                    <% if (profileUser.socialLinks?.telegram) { %>
                        <a href="<%= profileUser.socialLinks.telegram %>" target="_blank" style="color: #0088cc;"><i class="fab fa-telegram-plane"></i></a>
                    <% } %>
                    <% if (profileUser.socialLinks?.discord) { %>
                        <a href="<%= profileUser.socialLinks.discord %>" target="_blank" style="color: #5865F2;"><i class="fab fa-discord"></i></a>
                    <% } %>
                    <% if (profileUser.socialLinks?.website) { %>
                        <a href="<%= profileUser.socialLinks.website %>" target="_blank" style="color: var(--silver);"><i class="fas fa-globe"></i></a>
                    <% } %>
                    <% if (profileUser.socialLinks?.youtube) { %>
                        <a href="<%= profileUser.socialLinks.youtube %>" target="_blank" style="color: #FF0000;"><i class="fab fa-youtube"></i></a>
                    <% } %>
                </div>
            <% } %>

            <!-- ======== FOLLOW BUTTON ======== -->
            <% if (user && user._id.toString() !== profileUser._id.toString()) { %>
                <form action="/users/<%= profileUser._id %>/follow" method="POST" style="margin-bottom: 25px;">
                    <% if (isFollowing) { %>
                        <button type="submit" class="btn btn-secondary" style="border-color: var(--silver); color: var(--silver);">Unfollow</button>
                    <% } else { %>
                        <button type="submit" class="btn btn-primary" style="box-shadow: 0 0 10px var(--glow-gold);">Follow</button>
                    <% } %>
                </form>
            <% } else if (!user) { %>
                <a href="/login" class="btn" style="margin-bottom: 25px; display: inline-block; background: transparent; border: 2px solid var(--silver); color: var(--silver); padding: 10px 25px; border-radius: 20px;">Login to Follow</a>
            <% } %>

            <!-- ======== STATS GRID ======== -->
            <div class="profile-stats">
                <div class="stat-item">
                    <div class="stat-number"><%= uploads.length %></div>
                    <div class="stat-label">Uploads</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number"><%= profileUser.followers.length %></div>
                    <div class="stat-label">Followers</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number"><%= profileUser.following.length %></div>
                    <div class="stat-label">Following</div>
                </div>
                
                <!-- ✅ NEW: COUNTRY MOVED TO STATS WITH NAME -->
                <% if (profileUser.country) {
