<%- include('../partials/header') %>

    <style>
        .payment-result-container {
            min-height: 75vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
        }

        .payment-card-failure {
            background: linear-gradient(145deg, rgba(26, 26, 26, 0.95), rgba(18, 18, 18, 0.98));
            border: 1px solid rgba(231, 76, 60, 0.35);
            border-radius: 20px;
            box-shadow: 0 15px 45px rgba(0, 0, 0, 0.7), 0 0 35px rgba(231, 76, 60, 0.15);
            max-width: 650px;
            width: 100%;
            padding: 45px 35px;
            text-align: center;
            position: relative;
            overflow: hidden;
            animation: fadeInScale 0.4s ease-out;
        }

        .payment-card-failure::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, #e74c3c, #c0392b, #f39c12);
        }

        @keyframes fadeInScale {
            from {
                opacity: 0;
                transform: scale(0.96) translateY(15px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .status-badge-wrapper {
            position: relative;
            width: 95px;
            height: 95px;
            margin: 0 auto 25px auto;
        }

        .status-badge-error {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: rgba(231, 76, 60, 0.12);
            border: 2.5px solid #e74c3c;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.8rem;
            color: #e74c3c;
            box-shadow: 0 0 25px rgba(231, 76, 60, 0.35);
        }

        .payment-card-failure h1 {
            font-size: 2.1rem;
            color: var(--white);
            font-weight: 700;
            margin-bottom: 12px;
            letter-spacing: -0.5px;
        }

        .payment-card-failure .sub-message {
            color: var(--silver);
            font-size: 1.05rem;
            line-height: 1.6;
            margin-bottom: 25px;
            max-width: 520px;
            margin-left: auto;
            margin-right: auto;
        }

        .refund-guarantee-note {
            background: rgba(241, 196, 15, 0.1);
            border: 1px solid rgba(241, 196, 15, 0.3);
            border-radius: 10px;
            padding: 14px 18px;
            margin-bottom: 25px;
            text-align: left;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            font-size: 0.92rem;
            color: #f1c40f;
            line-height: 1.5;
        }

        .refund-guarantee-note i {
            font-size: 1.2rem;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .receipt-box {
            background: rgba(0, 0, 0, 0.45);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 22px 25px;
            margin-bottom: 30px;
            text-align: left;
        }

        .receipt-title {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--silver);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 8px;
        }

        .receipt-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 9px 0;
            font-size: 0.95rem;
            border-bottom: 1px dashed rgba(255, 255, 255, 0.06);
        }

        .receipt-row:last-child {
            border-bottom: none;
        }

        .receipt-label {
            color: #999;
        }

        .receipt-value {
            color: var(--white);
            font-weight: 600;
            word-break: break-all;
            text-align: right;
        }

        .status-pill-failed {
            background: rgba(231, 76, 60, 0.2);
            color: #e74c3c;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 0.82rem;
            font-weight: 700;
            border: 1px solid rgba(231, 76, 60, 0.4);
            display: inline-block;
        }

        .tips-box {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 30px;
            text-align: left;
            font-size: 0.9rem;
            color: #aaa;
        }

        .tips-box h4 {
            color: var(--white);
            margin-bottom: 8px;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .tips-box ul {
            margin: 0;
            padding-left: 20px;
            line-height: 1.6;
        }

        .btn-group-actions {
            display: flex;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn-result {
            padding: 13px 26px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.98rem;
            text-decoration: none;
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            cursor: pointer;
            border: none;
        }

        .btn-result-primary {
            background: #e74c3c;
            color: var(--white);
            box-shadow: 0 0 18px rgba(231, 76, 60, 0.4);
        }

        .btn-result-primary:hover {
            background: #c0392b;
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(231, 76, 60, 0.6);
        }

        .btn-result-secondary {
            background: rgba(255, 255, 255, 0.07);
            color: var(--white);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .btn-result-secondary:hover {
            background: rgba(255, 255, 255, 0.14);
            border-color: var(--gold);
            color: var(--gold);
            transform: translateY(-2px);
        }

        /* Cancellation Survey Styles */
        .cancellation-survey-card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 215, 0, 0.25);
            border-radius: 16px;
            padding: 24px 20px;
            margin-bottom: 30px;
            text-align: left;
            position: relative;
        }

        .survey-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--gold);
            background: rgba(255, 215, 0, 0.12);
            border: 1px solid rgba(255, 215, 0, 0.3);
            border-radius: 20px;
            padding: 3px 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 10px;
        }

        .cancellation-survey-card h3 {
            color: var(--white);
            font-size: 1.25rem;
            margin-bottom: 6px;
            font-weight: 700;
        }

        .survey-subtitle {
            color: var(--silver);
            font-size: 0.88rem;
            line-height: 1.5;
            margin-bottom: 18px;
        }

        .survey-options {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .survey-label {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            padding: 11px 15px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 0.93rem;
            color: #ddd;
        }

        .survey-label:hover {
            border-color: rgba(255, 215, 0, 0.4);
            background: rgba(255, 215, 0, 0.05);
            color: var(--white);
        }

        .survey-label input[type="radio"] {
            accent-color: var(--gold);
            width: 17px;
            height: 17px;
            cursor: pointer;
            margin: 0;
        }

        .survey-label .reason-text {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 500;
        }

        .btn-survey-submit {
            background: linear-gradient(135deg, var(--gold), #f39c12);
            color: #000;
            border: none;
            border-radius: 8px;
            padding: 10px 22px;
            font-weight: 700;
            font-size: 0.92rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.25s ease;
        }

        .btn-survey-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(255, 215, 0, 0.4);
        }

        .btn-survey-submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }
    </style>

    <main class="payment-result-container">
        <div class="payment-card-failure">
            <div class="status-badge-wrapper">
                <div class="status-badge-error">
                    <i class="fas fa-times"></i>
                </div>
            </div>

            <h1>Payment Incomplete</h1>
            <p class="sub-message">
                Your transaction could not be completed or was cancelled. Please don't worry — your account has not been
                charged for this attempt.
            </p>

            <div class="refund-guarantee-note">
                <i class="fas fa-shield-alt"></i>
                <div>
                    <strong>Auto-Reversal Guarantee:</strong> If money was debited from your bank or card, your bank's
                    clearing system will automatically reverse and refund the full amount within 3 to 5 business days.
                </div>
            </div>

            <div class="receipt-box">
                <div class="receipt-title">
                    <span>Transaction Details</span>
                    <span class="status-pill-failed"><i class="fas fa-times-circle"></i>
                        <%= status ? status.toUpperCase() : 'FAILED' %>
                    </span>
                </div>

                <% if (orderId) { %>
                    <div class="receipt-row">
                        <span class="receipt-label">Order Reference ID:</span>
                        <span class="receipt-value">
                            <%= orderId %>
                        </span>
                    </div>
                    <% } %>

                        <div class="receipt-row">
                            <span class="receipt-label">Reason / Feedback:</span>
                            <span class="receipt-value" style="color: #e74c3c;">
                                <%= reason || 'Payment cancelled, declined, or timed out' %>
                            </span>
                        </div>

                        <% if (amount) { %>
                            <div class="receipt-row">
                                <span class="receipt-label">Attempted Amount:</span>
                                <span class="receipt-value">
                                    <%= currency || 'INR' %>
                                        <%= amount %>
                                </span>
                            </div>
                            <% } %>

                                <div class="receipt-row">
                                    <span class="receipt-label">Payment Gateway:</span>
                                    <span class="receipt-value">Cashfree Payments</span>
                                </div>
            </div>

            <!-- Cancellation Feedback Survey: "Why did you cancel?" -->
            <div class="cancellation-survey-card" id="cancelSurveyBox">
                <div class="survey-badge"><i class="fas fa-question-circle"></i> Quick Feedback</div>
                <h3>Why did you cancel your purchase?</h3>
                <p class="survey-subtitle">Your answer helps us improve pricing, features, and payment methods for everyone.</p>

                <form id="cancelSurveyForm" onsubmit="submitCancelSurvey(event);">
                    <div class="survey-options">
                        <label class="survey-label">
                            <input type="radio" name="cancel_reason" value="Don't want to purchase it" required onchange="toggleOtherInput(false);">
                            <span class="reason-text"><i class="fas fa-ban" style="color: #e74c3c;"></i> Don't want to purchase it</span>
                        </label>

                        <label class="survey-label">
                            <input type="radio" name="cancel_reason" value="Don't find payment method I need" onchange="toggleOtherInput(false);">
                            <span class="reason-text"><i class="fas fa-credit-card" style="color: var(--gold);"></i> Don't find payment method I need</span>
                        </label>

                        <label class="survey-label">
                            <input type="radio" name="cancel_reason" value="Click by mistake" onchange="toggleOtherInput(false);">
                            <span class="reason-text"><i class="fas fa-mouse-pointer" style="color: #3498db;"></i> Click by mistake</span>
                        </label>

                        <label class="survey-label">
                            <input type="radio" name="cancel_reason" value="Network issue" onchange="toggleOtherInput(false);">
                            <span class="reason-text"><i class="fas fa-wifi" style="color: #e67e22;"></i> Network issue</span>
                        </label>

                        <label class="survey-label">
                            <input type="radio" name="cancel_reason" value="Other" onchange="toggleOtherInput(true);">
                            <span class="reason-text"><i class="fas fa-comment-dots" style="color: #2ecc71;"></i> Etc / Other reason</span>
                        </label>
                    </div>

                    <div id="other-notes-wrapper" style="display: none; margin-top: 12px;">
                        <textarea id="other-notes-input" placeholder="Tell us what payment method you needed, or why you cancelled (optional)..." rows="2" maxlength="300" style="width: 100%; box-sizing: border-box; background: rgba(0,0,0,0.5); border: 1px solid #444; border-radius: 8px; color: #fff; padding: 10px; font-family: inherit; resize: vertical; outline: none;"></textarea>
                    </div>

                    <div style="margin-top: 18px; display: flex; align-items: center; justify-content: flex-start; gap: 12px;">
                        <button type="submit" class="btn-survey-submit" id="btn-survey-submit">
                            <i class="fas fa-paper-plane"></i> Submit Feedback
                        </button>
                    </div>
                </form>

                <div id="survey-success-state" style="display: none; padding: 15px 10px; text-align: center;">
                    <i class="fas fa-check-circle" style="font-size: 2rem; color: #2ecc71; margin-bottom: 6px;"></i>
                    <h4 style="color: #fff; margin-bottom: 4px;">Thank you for your feedback!</h4>
                    <p style="color: var(--silver); font-size: 0.88rem; margin: 0;">Your input helps us improve checkout and payment options on GPLMods.</p>
                </div>
            </div>

            <div class="tips-box">
                <h4><i class="fas fa-lightbulb" style="color: var(--gold);"></i> Common Fixes:</h4>
                <ul>
                    <li>Verify your card has online and e-commerce transactions enabled.</li>
                    <li>Try completing the transaction using <strong>UPI (Google Pay, PhonePe, Paytm)</strong> or
                        Netbanking.</li>
                    <li>Ensure you have adequate balance and your bank's OTP server is responding.</li>
                </ul>
            </div>

            <div class="btn-group-actions">
                <% if (type==='membership' ) { %>
                    <a href="/membership" class="btn-result btn-result-primary">
                        <i class="fas fa-redo"></i> Retry Membership Purchase
                    </a>
                    <% } else { %>
                        <a href="/donate" class="btn-result btn-result-primary">
                            <i class="fas fa-redo"></i> Retry Donation
                        </a>
                        <% } %>
                            <a href="/support" class="btn-result btn-result-secondary">
                                <i class="fas fa-headset"></i> Contact Support
                            </a>
                            <a href="/" class="btn-result btn-result-secondary">
                                <i class="fas fa-home"></i> Return Home
                            </a>
            </div>
        </div>
    </main>

    <script>
        function toggleOtherInput(show) {
            const wrapper = document.getElementById('other-notes-wrapper');
            if (wrapper) wrapper.style.display = show ? 'block' : 'none';
        }

        async function submitCancelSurvey(e) {
            e.preventDefault();
            const submitBtn = document.getElementById('btn-survey-submit');
            const selectedReason = document.querySelector('input[name="cancel_reason"]:checked');
            if (!selectedReason) return;

            const reasonVal = selectedReason.value;
            const notesVal = document.getElementById('other-notes-input') ? document.getElementById('other-notes-input').value.trim() : '';

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';
            }

            try {
                await fetch('/api/payment/cancel-feedback', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderId: "<%= orderId || '' %>",
                        type: "<%= type || 'membership' %>",
                        reason: reasonVal,
                        notes: notesVal
                    })
                });

                document.getElementById('cancelSurveyForm').style.display = 'none';
                document.getElementById('survey-success-state').style.display = 'block';
            } catch (err) {
                console.error('[Feedback Submit Error]:', err);
                document.getElementById('cancelSurveyForm').style.display = 'none';
                document.getElementById('survey-success-state').style.display = 'block';
            }
        }
    </script>

    <%- include('../partials/footer') %>